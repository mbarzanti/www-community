CREATE TABLE TEST 

(

COL1 INTEGER NOT NULL 

COL2 NVARCHAR(10) NULL 

CONSTRAINT  TEST_PK PRIMARY KEY (COL1)

) 

DISTRIBUTE ON RANDOM;



Derised Format:



CREATE TABLE TEST 

(

COL1 INTEGER NOT NULL 

COL2 NVARCHAR(10) NULL 

) 

DISTRIBUTE ON RANDOM;



ALTER TABLE TEST ADD CONSTRAINT  TEST_PK PRIMARY KEY (COL1);