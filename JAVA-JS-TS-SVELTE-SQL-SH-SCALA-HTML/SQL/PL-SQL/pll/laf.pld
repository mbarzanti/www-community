

--------------------------------------------------------------
--                                                          --
--  Procedure called by the When-Custom-Item-Event trigger  --
--  of the DrawLAF Java Bean                                --
--                                                          --
--------------------------------------------------------------
PROCEDURE LAF_New_Item_Event
  (
     PC$BeanName       Varchar2   -- DrawLAF bean area name
    ,PC$Item_Object    Varchar2   -- object type
    ,PC$Item_Name      Varchar2   -- object name
    ,PC$Item_Type      Varchar2   -- event type
    ,PC$Item_Value     Varchar2   -- event value
    ,PC$MouseXY        Varchar2   default null -- event mouse location
    ,PC$MouseButton    Varchar2   default null -- event mouse button                       
  )
IS
  LC$Value   Varchar2(1000);
BEGIN
  LC$Value := 'Obj:' || PC$Item_Object || '  Name:' || PC$Item_Name || '  Type:' 
                     || PC$Item_Type   || '  val:' || PC$Item_Value ;  
                     
  
  /* 
  -- use case sample --
  If PC$Item_Object  = 'textfield'  And
  	 PC$Item_name    = 'textfield1' And  	 
  	 PC$Item_Type    = 'focus'      And
  	 PC$Item_Value   = 'lost'       Then
  	  -- your code here
  	  null ;
  End if ;	  
  */

  
END;


PACKAGE PKG_EXPORT IS

	--------------------------------------------------------
	--  Methods to export the Forms module block content  --
	--  to a HTML file                                    --
	--------------------------------------------------------
	PROCEDURE Set_Style
	(
	   PC$Style     in varchar2
	) ;	
		
	PROCEDURE Export_Html
	(
	   PC$Bean          in varchar2              -- DrawLAF Bean Area name
	  ,PC$Title         in varchar2 default null -- doc title
	  ,PC$TitleClass    in varchar2 default null -- doc title style class
	  ,PC$SubTitle      in varchar2 default null -- doc subtitle
	  ,PC$SubTitleClass in varchar2 default null -- doc subtitle style class
	  ,PC$TableClass    in varchar2 default null -- doc table class
	  ,PC$ExcludeList   in varchar2 default null -- exluded block list	  
	) ;
	
	FUNCTION Get_User_TempDir
	Return varchar2 ;
	
	FUNCTION Get_FileName
	Return varchar2 ;
	
	FUNCTION Get_Full_FileName
	Return varchar2 ;	
	  
END;

PACKAGE BODY PKG_EXPORT IS
  	
  GC$Line     varchar2(32767);
  GC$THead    varchar2(10000);
  GC$Bean     varchar2(61);
  GC$Header   varchar2(4000) := '<!DOCTYPE html><html>';
  GC$Style    varchar2(4000);
  GC$TempDir  varchar2(256);
  GC$FileName varchar2(256);

	-----------------------------------
	--  set the user temp directory  --
	-----------------------------------
	PROCEDURE Set_User_TempDir
	Is
  Begin
     -- set the doc header --
     GC$TempDir := Get_Custom_Property( GC$Bean, 1, 'EXPORT_GET_TEMP_DIR' );	
  End Set_User_TempDir;
  
	---------------------------------------
	--  returns the user temp directory  --
	---------------------------------------
	FUNCTION Get_User_TempDir
	Return varchar2
	Is
  Begin
     If GC$TempDir is Null Then
     	 Set_User_TempDir;
     End if;
     return GC$TempDir ;
  End Get_User_TempDir; 
  
	---------------------------------
	--  returns the HTML filename  --
	---------------------------------
	FUNCTION Get_FileName
	Return varchar2
	Is
  Begin
     return GC$FileName ;
  End Get_FileName;  
  
	FUNCTION Get_Full_FileName
	Return varchar2
	Is
  Begin
     return GC$TempDir || GC$FileName ;
  End Get_Full_FileName;    

  ---------------------------------------------------------------	
  
	------------------------------------
	--  set the HTML result filename  --
	------------------------------------
	PROCEDURE Set_Filename
	Is
	  LC$Filename  varchar2(256);
  Begin
     GC$FileName := Get_Application_Property (CURRENT_FORM_NAME)
                 || '.html' ;
     LC$Filename := Get_User_TempDir || GC$FileName ;
     -- set the html filename --
     Set_Custom_Property( GC$Bean, 1, 'EXPORT_SET_FILENAME', LC$Filename );	  
  End Set_Filename;  

  ---------------------------------------------------------------	  
  
	-------------------------------
	--  begin the HTML document  --
	-------------------------------
	PROCEDURE Open_Doc
	(
		  PC$Title        in varchar2  default null
		 ,PC$TitleClass   in varchar2  default null
		 ,PC$Comment      in varchar2  default null
		 ,PC$CommentClass in varchar2  default null
	)
	Is
  Begin
     -- get the user temp directory --
     Set_User_TempDir;
     -- set the doc header --
     Set_Custom_Property( GC$Bean, 1, 'EXPORT_PUT_LINE', GC$Header );	  
     -- set the doc style --
     If GC$Style is not null Then                                  
     	  Set_Custom_Property( GC$Bean, 1, 'EXPORT_PUT_LINE', '<head><style>' || GC$Style || '</style></head>');	  
     End if ;	
     -- set the doc body tag --
     Set_Custom_Property( GC$Bean, 1, 'EXPORT_PUT_LINE', '<body>' );
     -- general title --
     If PC$Title is not null then
     	  If PC$TitleClass is not null then
     	    Set_Custom_Property( GC$Bean, 1, 'EXPORT_PUT_LINE', '<p class="' || PC$TitleClass || '">'
     	                                                         || PC$Title || '</p>' );	
     	  Else	
     	    Set_Custom_Property( GC$Bean, 1, 'EXPORT_PUT_LINE', '<h1>' || PC$Title || '</h1>' );
     	  End if ;
     End if ;
     -- general comment --
     If PC$Comment is not null then
     	  If PC$CommentClass is not null then
     	  	 Set_Custom_Property( GC$Bean, 1, 'EXPORT_PUT_LINE', '<p class="' || PC$CommentClass || '">'
     	                                                         || PC$Comment || '</p>' );	
     	  Else
     	     Set_Custom_Property( GC$Bean, 1, 'EXPORT_PUT_LINE', '<h3>' || PC$Comment || '</h3>' );
     	  End if ;
     End if ;	     
     Synchronize;	  
  End Open_Doc;  

  ---------------------------------------------------------------		
  
	-------------------------------
	--  close the HTML document  --
	-------------------------------
	PROCEDURE Close_Doc
  Is
  Begin
     Set_Custom_Property( GC$Bean, 1, 'EXPORT_PUT_LINE', '</body></html>' );	  
  End Close_Doc;    

  ---------------------------------------------------------------		
  
	-----------------------------------
	--  set the document stylesheet  --
	-----------------------------------
	PROCEDURE Set_Style
	(
	   PC$Style     in varchar2
	)Is
  Begin
     GC$Header := '<!DOCTYPE html><html>';
     GC$Style := PC$Style ;
  End Set_Style;   
  
  ------------------------------
  --  add cell to HTML Table  --
  ------------------------------
  PROCEDURE Add_Table_Cell
  (
     PC$Cell   in Varchar2
    ,PC$Class  in Varchar2 default null    
    ,PC$Justif in varchar2 default null
  )
  Is
   LC$Justif  varchar2(30) := ' align="left"';
  Begin
  	If PC$Justif in ('END','RIGHT') Then
  		 LC$Justif := ' align="right"' ;    
  	ElsIf PC$Justif = 'CENTER' Then
  	   LC$Justif := ' align="center"' ;    	 
  	End if ;
  	If PC$Class is not null Then
  	  GC$Line := GC$Line || '<td class="' || PC$Class || '"' || LC$Justif || '>' || PC$Cell || '</td>';
  	Else
  	  GC$Line := GC$Line || '<td' || LC$Justif || '>' || PC$Cell || '</td>';  		
  	End if ;	
  End Add_Table_Cell;
  
  ---------------------------------------------------------------		
     
  ---------------------------
  --  add a HTML Table row --
  ---------------------------
  PROCEDURE Add_Table_Row
  (
     PC$Line  in Varchar2
    ,PC$Class in Varchar2 default null     
  )
  Is
    LC$Line  varchar2(32767);  
  Begin
  	If PC$Class is not null Then
  	  LC$Line := '<tr class="' || PC$Class || '">' || PC$Line || '</tr>';
  	Else
  	  LC$Line := '<tr>' || PC$Line || '</tr>';	
  	End if ;  	
  	Set_Custom_Property( GC$Bean, 1, 'EXPORT_PUT_LINE', LC$Line );
  End Add_Table_Row;
  
  ---------------------------------------------------------------		
  
  ---------------------------
  --  create a HTML Table  --
  ---------------------------
  PROCEDURE Add_Table_Header
  (
     PC$Line  in Varchar2
  )
  Is
  Begin
  	GC$THead := GC$THead ||  '<th>' || PC$Line || '</th>';	
  End Add_Table_Header;
  
  ---------------------------------------------------------------		  
     
  ---------------------------
  --  Begin  a HTML Table  --
  ---------------------------
  PROCEDURE Start_Table
  (
      PC$Title in varchar2 default null
     ,PC$Class in Varchar2 default null     
  )  
  Is
    LC$Line  varchar2(1000);
  Begin
  	If PC$Class is not null Then
  	  LC$Line := '<p><table id="' || PC$Class || '" border="0">';
  	Else
  		LC$Line := '<p><table border="0">';
  	End if;
  	If PC$Title is not null then
  		LC$Line := LC$Line || '<caption>' || PC$Title || '</caption>';
  	End if ;	
  	Set_Custom_Property( GC$Bean, 1, 'EXPORT_PUT_LINE', LC$Line );
  	Synchronize;
  End Start_Table;
  ---------------------------------------------------------------		
     
  ---------------------------
  --  Close  a HTML Table  --
  ---------------------------
  PROCEDURE Close_Table
  Is
  Begin
  	Set_Custom_Property( GC$Bean, 1, 'EXPORT_PUT_LINE', '</table></p>' );
  End Close_Table;  
  
  ---------------------------------------------------------------		
  
  ---------------------------
  --  set the HTML header  --
  ---------------------------
  PROCEDURE Set_Header
  (
     PC$Header in Varchar2
  )   
  Is
  Begin
  	GC$Header := PC$Header ;
  End Set_Header;
  
  ---------------------------------------------------------------		
  
    
  ----------------------------------------
  --  Export the module content in HTML --
  ----------------------------------------	
	PROCEDURE Export_Html
	(
	   PC$Bean          in varchar2
	  ,PC$Title         in varchar2 default null
	  ,PC$TitleClass    in varchar2 default null
	  ,PC$SubTitle      in varchar2 default null
	  ,PC$SubTitleClass in varchar2 default null
	  ,PC$TableClass    in varchar2 default null
	  ,PC$ExcludeList   in varchar2 default null	  
	)
	Is
		LC$Block     varchar2(60);
		LC$item      varchar2(61); -- current item
		LC$itemdeb   varchar2(61); -- first item
		LC$Type			 varchar2(20); -- item type
		LC$CurItem   varchar2(61) := Name_In('System.Cursor_Item');
		LC$Prompt    varchar2(600);
		LC$Exclude   varchar2(500) := ',WEBUTIL,LAF_BLOCK,';
		LC$Justif    varchar2(30); -- item justification
		LN$NbRec		 pls_integer := 0 ;  -- number of records (to know if the block is multi-records)
		LN$CurRec		 pls_integer := 0 ; 	
		LN$i         pls_integer := 0;
		LB$Header    boolean := false;
		LB$Name      varchar2(60);
	Begin
    GC$Bean := PC$Bean;
    If PC$ExcludeList is not null then
    	 LC$Exclude := ',WEBUTIL,LAF_BLOCK,' || Upper(PC$ExcludeList) || ',' ;
    End if ;	 
    -- open the HTML document --
    Open_Doc(PC$Title,PC$TitleClass,PC$SubTitle,PC$SubTitleClass);
    LC$Block := get_form_property( Name_In('System.Current_Form'), FIRST_BLOCK ) ;    
    Loop -- For each block of the form			
      LN$NbRec := get_block_property(LC$Block, RECORDS_DISPLAYED) ;
      LB$Name := Get_Block_Property(LC$Block, QUERY_DATA_SOURCE_NAME);
      -- check if block not in exclude list --
      If Nvl(Instr(LC$Exclude,','||LC$Block||','),0) = 0 Then
		    -- find the current block visible items  --
			  Go_Block(LC$Block);
			  LN$i := 0;
        GC$Line := '';
        GC$THead := '';
        LB$Header := false;
			  LN$CurRec := Get_Block_Property( LC$Block, CURRENT_RECORD);
			  First_Record;
			  Loop -- loop through records
				  If Mod(LN$i,2) = 0 Then
				    GC$Line := '<tr>';
				  Else
				  	GC$Line := '<tr class="alt">';
				  End if ;
				  LC$itemdeb := get_block_property(LC$Block, FIRST_ITEM) ;
			    LC$item := LC$Block || '.' || LC$itemdeb ;
				  While LC$itemdeb is not null loop -- For each item
		  			-- visible item ? --
					  IF  Get_Item_Property(LC$Item , VISIBLE) = 'TRUE' 
					  And Get_Item_Property(LC$Item , ITEM_CANVAS ) is not null	Then
						   LC$Type := Get_Item_Property(LC$Item , ITEM_TYPE) ;
						   IF LC$Type Not in ('BUTTON','CHART ITEM','USER AREA','BEAN AREA','IMAGE') Then	
						   	 	If LN$i = 0 Then
						   	 		 Start_Table(LC$Block,PC$TableClass);
						   	 	End if ;
						   	 	LC$Justif := 'LEFT';
						   	 	If LC$Type in ('TEXT ITEM','DISPLAY ITEM') Then
						   	 		 If Get_Item_Property(LC$Item , DATATYPE) like '%DATE%' Then
						   	 		 	 LC$Justif := 'CENTER';
						   	 		 ElsIf Get_Item_Property(LC$Item , DATATYPE) in ('INT','RINT','NUMBER','RNUMBER') Then
						   	 		 	 LC$Justif := 'RIGHT';
						   	 		 End if ;	
						   	 	End if ;	
						   	 	Add_Table_Cell(PC$Cell=>Name_In(LC$Item), PC$Justif=>LC$Justif);
						   	 	If not LB$Header Then
						   	 	  LC$Prompt := Get_Item_Property(LC$Item , PROMPT_TEXT);
						   	 	  If Nvl(LC$Prompt,' ') = ' ' Then
						   	 	  	Set_Custom_Property(GC$Bean, 1, 'POINT_TEXT_LABEL', LC$Item);
                      LC$Prompt := Nvl(Get_Custom_Property(GC$Bean, 1, 'GET_TEXT_LABEL'),' ');
						   	 	  End if ;
						   	 	  Add_Table_Header(LC$Prompt);
						   	 	End if ;
						   	 	LN$i := LN$i + 1 ;
						   End if;
					  END IF;
					  LC$itemdeb := Get_Item_Property(LC$item, NEXTITEM );
					  LC$item := LC$Block || '.' || LC$itemdeb ;
				  End loop ;
				  GC$Line := GC$Line || '</tr>';
				  If Not LB$Header And LN$i > 0 Then
				  	-- export table header --
				  	GC$THead := '<tr>' || GC$THead || '</tr>';
				  	Set_Custom_Property( GC$Bean, 1, 'EXPORT_PUT_LINE', GC$THead );
				  End if ;
				  LB$Header := true;
				  -- export table row --
				  If LN$i > 0 Then
				     Set_Custom_Property( GC$Bean, 1, 'EXPORT_PUT_LINE', GC$Line );
				  End if ;
			    exit when Name_In('SYSTEM.LAST_RECORD') = 'TRUE';
			    Next_Record;
			  End loop ;
			  Go_Record(LN$CurRec);
			  If LN$i > 0 Then
			     Close_Table;
			  End if ;
		  End if;
	    -- get next block --
	    LC$Block := get_block_property( LC$Block, NEXTBLOCK ) ;
	
	  exit when LC$Block is null ;
	
  End loop ;		
	-- close the HTML document --
	Close_Doc;
	Set_Filename;
	Go_Item(LC$CurItem);
	
  Exception
     When Others Then
        Go_Item(LC$CurItem);
        raise;   	
	End Export_Html;	
		
  ---------------------------------------------------------------		

	
-- example of simple stylesheet content --
BEGIN
    	GC$Style := '#lafprint
{
font-family:"Trebuchet MS", Arial, Helvetica, sans-serif;
#width:100%;
border-collapse:collapse;
}
#lafprint td, #lafprint th
{
font-size:1em;
border:1px solid #98bf21;
padding:3px 7px 2px 7px;
}
#lafprint th 
{
font-size:1.1em;
text-align:center;
padding-top:5px;
padding-bottom:4px;
background-color:#A7C942;
color:#ffffff;
}
#lafprint tr.alt td 
{
color:#000000;
background-color:#EAF2D3;
}
.title
{
font-family:"Trebuchet MS", Arial, Helvetica, sans-serif;
font-size:20px;
}
.stitle
{
font-family:"Trebuchet MS", Arial, Helvetica, sans-serif;
font-size:16px;
}';
END;


PACKAGE PKG_LAF_LOV IS
	
	-----------------------
	--  display the LOV  --
	-----------------------
	PROCEDURE Show_LOV
	(
	   PC$LOV_Name  IN Varchar2
	  ,PC$LOV_Form  IN Varchar2 
	  ,PC$BeanName  IN Varchar2
	  ,PN$LOV_X_Pos IN Pls_Integer  DEFAULT NULL
	  ,PN$LOV_Y_Pos IN Pls_Integer  DEFAULT NULL  
	  ,PC$Filter    IN Varchar2     DEFAULT NULL
	  ,PB$Sortable  IN Boolean      DEFAULT TRUE
	);
	
	--------------------
	--  get the rows  --
	--------------------
	FUNCTION Get_Rows
	(
	   PC$LOV_Name     IN Varchar2
	  ,PC$LOV_Form     IN Varchar2 
	  ,PN$NumPage      IN Pls_Integer
	  ,PC$SearchValue  IN Varchar2     DEFAULT NULL
	) RETURN PLS_INTEGER ;	
	
	
	-----------------------
	--  returned values  --
	-----------------------
	Procedure Set_Return_Values 
	          ( 
	             PC$LOV_Name  In Varchar2
	            ,PC$LOV_Form  In Varchar2 
	            ,PC$Line      In Varchar2 
	          ) ;
	          
	Procedure Check_Value
	          (
	             PC$LOV_Name  In  Varchar2
	            ,PC$LOV_Form  In  Varchar2 
	            ,PC$LOV_Col   In  Varchar2
	            ,PC$Value     In  Varchar2 
	          ) ;	            

	  
END;


PACKAGE BODY PKG_LAF_LOV IS
  
  GC$Sep        Varchar2(1) := '^' ;
	
	----------------------------------
	--  Display the database table  --
	----------------------------------
	PROCEDURE Show_LOV
	(
	   PC$LOV_Name  IN Varchar2
	  ,PC$LOV_Form  IN Varchar2 
	  ,PC$BeanName  IN Varchar2  
	  ,PN$LOV_X_Pos IN Pls_Integer  DEFAULT NULL
	  ,PN$LOV_Y_Pos IN Pls_Integer  DEFAULT NULL
	  ,PC$Filter    IN Varchar2     DEFAULT NULL  	  
	  ,PB$Sortable  IN Boolean      DEFAULT TRUE
	) 
	IS
  	LN$NbCols     Pls_integer ; 
	  LN$NbRows     Pls_integer ;
	  LC$Head       Varchar2(10000);
	  LC$Type       Varchar2(10000);
	  LN$MaxWidth   Pls_integer ;
	  LC$Prompt     Varchar2(512);
	  LC$Title      Varchar2(512);
	  LC$Bounds     Varchar2(100);
	  LC$Query      Varchar2(10000);
	  LC$ColSearch  Varchar2(100);
	  LC$Button1    Varchar2(100);
	  LC$Button2    Varchar2(100);    
	  LC$Validation Varchar2(1);
	  LC$Scheme     Varchar2(100);
	  LN$Paging     Pls_Integer ;
	  LC$Line       Varchar2(32600) ;
	  LC$Code       Varchar2(4000);
	  LC$Location   Varchar2(10) := '' ;
	  LN$Pages      Pls_Integer := 1 ;
	  LC$Search     Varchar2(1000) ;
	  LN$TWidths    PKG_DB_LAF_LOV.TYP_TAB_LOV_COL_WIDTH ;
	  LN$Ret        Pls_Integer;	  
	Begin  
  
  -- tune date format --
  If Get_Application_Property(PLSQL_DATE_FORMAT) Is Not Null Then
  	 Forms_Ddl('ALTER SESSION SET NLS_DATE_FORMAT = ''' || Get_Application_Property(PLSQL_DATE_FORMAT) || '''');  	
  	 Set_Application_Property(PLSQL_DATE_FORMAT, Get_Application_Property(PLSQL_DATE_FORMAT)) ;
  	 Set_Application_Property(BUILTIN_DATE_FORMAT, Get_Application_Property(PLSQL_DATE_FORMAT)) ;
  End if ;
  
  If PC$Filter Is Not Null Then
	   PKG_DB_LAF_LOV.Set_LOV_Property
		 (
		    PC$LOV_Name
		   ,PC$LOV_Form
		   ,'LOV_FILTER'
		   ,PC$Filter
		 );
		 PKG_DB_LAF_LOV.Build_LOV_Where_Clause(PC$LOV_Name, PC$LOV_Form, PC$Filter);
	End if ;

	LC$Code :=  PKG_DB_LAF_LOV.Prepare_LOV
	(
	   PC$LOV_Name
	  ,PC$LOV_Form 
	  ,LN$NbCols
	  ,LN$NbRows
	  ,LC$Head
	  ,LC$Type
	  ,LN$MaxWidth
	  ,LC$Prompt
	  ,LC$Title
	  ,LC$Bounds
	  ,LC$Query
	  ,LC$ColSearch
	  ,LC$Validation
	  ,LC$Scheme
	  ,LN$Paging
	  ,LN$Pages
	  ,LC$Button1
	  ,LC$Button2
	) ;
	If LC$Code = 'OK' Then
	    If PKG_DB_LAF_LOV.Open_Cursor( LC$Query, LN$Paging, 1, LC$Search ) > -1 Then
	    Clear_Message;
	    message('Loading LOV: ' || PC$LOV_Name, no_acknowledge);
	    Clear_Message;
	    -- Init the LOV --
	    Set_Custom_Property( PC$BeanName, 1, 'INIT_LOV', PC$LOV_Form || '.' || PC$LOV_Name ) ;
	    Synchronize;
	    -- Set the number of pages --
	    Set_Custom_Property( PC$BeanName, 1, 'SET_LOV_NB_PAGES', LTrim(To_Char(LN$Pages)) ) ;
	    -- Set the maximum column width property --
	    Set_Custom_Property( PC$BeanName, 1, 'SET_LOV_MAX_COL_WIDTH', LTrim(To_Char(LN$MaxWidth)) ) ;
	    -- Set the data separator's character --
	    Set_Custom_Property( PC$BeanName, 1, 'SET_LOV_SEPARATOR', PKG_DB_LAF_LOV.GetSeparator ) ;
	    -- Set the search label --
	    Set_Custom_Property( PC$BeanName, 1, 'SET_LOV_SEARCH_LABEL', PKG_DB_LAF_LOV.GetSearchLabel ) ;
	    -- Set the array dimensions --
	    Set_Custom_Property( PC$BeanName, 1, 'SET_LOV_ARRAY_SIZE', to_char(LN$Nbcols)||','||to_char(LN$Nbrows) ) ;
	    -- Set the hearders' columns
	    Set_Custom_Property( PC$BeanName, 1, 'SET_LOV_HEADER', LC$Head ) ;  
	    -- Set the hearders' columns
	    Set_Custom_Property( PC$BeanName, 1, 'SET_LOV_COLS_TYPE', LC$Type ) ;
	    
	    If PC$Filter Is Not Null Then
	    	Set_Custom_Property( PC$BeanName, 1, 'SET_LOV_FILTER', PC$Filter ) ;
	    Else
	    	Set_Custom_Property( PC$BeanName, 1, 'SET_LOV_FILTER', '{NULL}' ) ;
	    End if ;	
	    
	    -- set LOV column width --
	    LN$TWidths := PKG_DB_LAF_LOV.Get_Lov_Col_Width(PC$LOV_Name ,PC$LOV_Form ) ;
	    If LN$TWidths.Count() > 0 Then 
	    	 For i IN 1 .. LN$TWidths.Count() Loop
	    	 	  If LN$TWidths(i).WIDTH > -1 Then
	             Set_Custom_Property( PC$BeanName, 1, 'SET_LOV_CELL_PROPERTY'
	               ,LN$TWidths(i).LOV_COLUMN || '|WIDTH|' || Ltrim(To_Char(LN$TWidths(i).WIDTH)));
	    	 	  End if ;
	    	 	  If LN$TWidths(i).MIN_WIDTH > -1 Then
	             Set_Custom_Property( PC$BeanName, 1, 'SET_LOV_CELL_PROPERTY'
	               ,LN$TWidths(i).LOV_COLUMN || '|MIN_WIDTH|' || Ltrim(To_Char(LN$TWidths(i).MIN_WIDTH)));
	    	 	  End if ;   
	    	 	  If LN$TWidths(i).MAX_WIDTH > -1 Then
	             Set_Custom_Property( PC$BeanName, 1, 'SET_LOV_CELL_PROPERTY'
	               ,LN$TWidths(i).LOV_COLUMN || '|MAX_WIDTH|' || Ltrim(To_Char(LN$TWidths(i).MAX_WIDTH)));
	          End if ;   	    	 	  
	       End loop ;
	    End if ;
	    	    

	    If LC$Scheme Is Not Null Then
	    	Set_Custom_Property( PC$BeanName, 1, 'SET_LOV_SCHEME', LC$Scheme ) ;
	    End if ;
      
	    If LC$Bounds Is Not Null Then
	    	Set_Custom_Property( PC$BeanName, 1, 'SET_LOV_BOUNDS', LC$Bounds ) ;
	    End if ;

	    If LC$Title Is Not Null Then
	    	Set_Custom_Property( PC$BeanName, 1, 'SET_LOV_TITLE', LC$Title ) ;
	    End if ;
	    
	    If LC$Prompt Is Not Null Then
	    	Set_Custom_Property( PC$BeanName, 1, 'SET_LOV_PROMPT', LC$Prompt ) ;
	    End if ;
	    
	    If LC$ColSearch Is Not Null Then
	    	Set_Custom_Property( PC$BeanName, 1, 'SET_LOV_COL_SEARCH', LC$ColSearch ) ;
	    End if ;
	    
	    If LC$Button1 Is Not Null And LC$Button2 Is Not Null Then
	    	If Substr(LC$Button1,1,1)= '(' and Substr(LC$Button1, Length(LC$Button1)) = ')' Then
	    		 LC$Button1 := Replace( Replace( LC$Button1, '(', ''), ')', '' ) ;
	    		 LC$Button2 := Replace( Replace( LC$Button2, '(', ''), ')', '' ) ;
	    		 Set_Custom_Property( PC$BeanName, 1, 'SET_LOV_BUTTON_ICONS', LC$Button1 || ',' || LC$Button2 ) ;
	    	Else	
	    	   Set_Custom_Property( PC$BeanName, 1, 'SET_LOV_BUTTON_LABELS', LC$Button1 || ',' || LC$Button2 ) ;
	    	End if ;
	    End if ;	
			 
	    -- get the lines --
	    Loop
		    LC$Line := PKG_DB_LAF_LOV.Fetch_Cursor ;
		    Exit When LC$Line Is Null ;
		    Set_Custom_Property( PC$BeanName, 1, 'SET_LOV_DATA', LC$Line ) ;
	    End loop ;	
	    -- Close the Cursor --
	    PKG_DB_LAF_LOV.Close_Cursor ;

	    -- Show the LOV --
	    If PN$LOV_X_Pos Is Not Null And PN$LOV_Y_Pos Is Not Null Then
	    	 LC$Location := ',' || Ltrim( To_Char( PN$LOV_X_Pos ) ) 
	    	             || ',' || Ltrim( To_Char( PN$LOV_Y_Pos ) )  ;
	    End if ;
	    Set_Custom_Property( PC$BeanName, 1, 'SHOW_LOV', LC$Location ) ;
	    
	    If not PB$Sortable then
	    	Set_Custom_Property( PC$BeanName, 1, 'SET_LOV_SORTABLE', 'false' ) ;
	    End if;
		 	  
	  End if ;	
	
	Else
 	   PKG_LOOK_AND_FEEL.ShowError(LC$Code);
  	 Synchronize ;		 	  			 	
	End if ;	
	

	End Show_LOV;
	
	
	----------------------------------------
	--  get the rows from the given page  --
	----------------------------------------
	FUNCTION Get_Rows
	(
	   PC$LOV_Name     IN Varchar2
	  ,PC$LOV_Form     IN Varchar2 
	  ,PN$NumPage      IN Pls_Integer
	  ,PC$SearchValue  IN Varchar2     DEFAULT NULL
	) RETURN PLS_INTEGER 
	Is
	  LC$Query      Varchar2(10000);
	  LC$Search     Varchar2(1000);
	  LC$BeanName   Varchar2(100) ;
	  LC$Line       Varchar2(32600) ;
	  LN$Paging     Pls_Integer ;
	  LN$Return     Pls_Integer := -1 ;
	Begin
		
		LC$Query := PKG_DB_LAF_LOV.Get_LOV_Property(PC$LOV_Name, PC$LOV_Form, 'LOV_SELECT');
		If LC$Query Is Not Null Then
			 If PC$SearchValue Is Not Null Then
			   PKG_DB_LAF_LOV.Build_LOV_Where_Clause(PC$LOV_Name, PC$LOV_Form, PC$SearchValue);
			 End if ;
			 LC$Search   := PKG_DB_LAF_LOV.Get_LOV_Property(PC$LOV_Name, PC$LOV_Form, 'LOV_WHERE_CLAUSE') ;
			 LN$Paging   := PKG_DB_LAF_LOV.Get_LOV_Property(PC$LOV_Name, PC$LOV_Form, 'LOV_PAGING') ;
			 LC$BeanName := PKG_DB_LAF_LOV.Get_LOV_Property(PC$LOV_Name, PC$LOV_Form, 'LOV_BEAN_NAME') ;
			 If LN$Paging Is Not Null Then
			 	  LN$Return := PKG_DB_LAF_LOV.Open_Cursor( LC$Query, LN$Paging, PN$NumPage, LC$Search ) ;
			 	  If LN$Return > -1 Then
             Set_Custom_Property( LC$BeanName, 1, 'SET_LOV_NUM_ROWS', LN$Return ) ;
             -- get the lines --
             Loop
                LC$Line := PKG_DB_LAF_LOV.Fetch_Cursor ;
                Exit When LC$Line Is Null ;
                Set_Custom_Property( LC$BeanName, 1, 'SET_LOV_DATA', LC$Line ) ;
             End loop ;	
             -- Close the Cursor --
             PKG_DB_LAF_LOV.Close_Cursor ;
             --Message('.',no_acknowledge);             
             Set_Custom_Property( LC$BeanName, 1, 'SET_LOV_REFRESH', PN$NumPage ) ;             
             Synchronize;
			 	  End if ;	
			 End if ;	
		End if ;	
		
		Return  LN$Return ;
	Exception
	  When Others Then
	    Return -1 ;		
	End Get_Rows;
	
		

	-----------------------
	--  returned values  --
	-----------------------
	Procedure Set_Return_Values
	          ( 
	             PC$LOV_Name  In Varchar2
	            ,PC$LOV_Form  In Varchar2 
	            ,PC$Line      In Varchar2 
	          ) 	
	Is
	  LB$Found   Boolean := false ;
	  LN$Pos     Pls_Integer := 1 ;
	  LC$Value   Varchar2(32000) ;
	  LC$ColName Varchar2(100);
	  LC$Null    Varchar2(1) := null ;
	  LN$Rec     Pls_Integer ;
	  RecMap     PKG_DB_LAF_LOV.TYP_TAB_LOV_MAPPING ;
	Begin
		
	  LN$Rec := PKG_DB_LAF_LOV.Get_LOV_Indice( PC$LOV_Name, PC$LOV_Form ) ;
		 
	  If LN$Rec > 0 Then
		 	  
	  	RecMap := PKG_DB_LAF_LOV.Get_LOV_Mapping(LN$Rec);
		 	  
		  LN$Pos := 1 ;
		  Loop
  		  LC$Value := PKG_LOOK_AND_FEEL.Split( PC$Line, LN$Pos, '^' ) ;
		    Exit when LC$Value Is Null ;

		    If RecMap.exists(LN$Pos) Then
			    LC$ColName := Lower( Substr( LC$Value, 1, Length(RecMap(LN$Pos).LOV_COLUMN)) ) ;
			    If LC$ColName = Lower( RecMap(LN$Pos).LOV_COLUMN ) Then
	 		      -- item found, copy the value --
			      LC$Value := Substr( LC$Value, Length(RecMap(LN$Pos).LOV_COLUMN) + 1 ) ;
	          If LC$Value != 'null' Then  
				      -- return item 1 --
				      If RecMap(LN$Pos).LOV_ITEM1 is Not Null Then
		                	 Copy(LC$Value, RecMap(LN$Pos).LOV_ITEM1 )  ;
				      End if ;
				      -- return item 2 --
				      If RecMap(LN$Pos).LOV_ITEM2 is Not Null Then
		                	 Copy(LC$Value, RecMap(LN$Pos).LOV_ITEM2 )  ;
				      End if ;
		          -- return item 3 --
		          If RecMap(LN$Pos).LOV_ITEM3 is Not Null Then
		           	 Copy(LC$Value, RecMap(LN$Pos).LOV_ITEM3 )  ;
		          End if ;	                
	          End if ;
			    End if ;
		    End if ;
		    LN$Pos := LN$Pos + 1 ;
		  End loop;		 	  

	  Else
		-- LOV not found --
		PKG_LOOK_AND_FEEL.ShowError('LAF LOV Mapping: '|| PC$LOV_Form || '.' || PC$LOV_Name || ' : LOV not found');
		Synchronize ;		 	  	        	
	  End if ;	

  End Set_Return_Values ;		
	
	--------------------------------------
	--  check value for LOV validation  --
	--------------------------------------
	Procedure Check_Value
	          (
	             PC$LOV_Name  In  Varchar2
	            ,PC$LOV_Form  In  Varchar2
	            ,PC$LOV_Col   In  Varchar2	  
	            ,PC$Value     In  Varchar2 
	          )
	Is 
	  LN$Result    pls_integer ;
	  LC$BeanName  Varchar2(100); 
	  LC$ErrMsg    Varchar2(4000) ;
	Begin
		LN$Result := PKG_DB_LAF_LOV.Check_Value( PC$LOV_Name, PC$LOV_Form, PC$LOV_Col, PC$Value, LC$ErrMsg );
		If LN$Result = 0 Then
			  LC$BeanName := PKG_DB_LAF_LOV.Get_LOV_Property(PC$LOV_Name, PC$LOV_Form, 'LOV_BEAN_NAME'); 
			  PKG_LAF_LOV.Show_Lov(PC$LOV_Name, PC$LOV_Form, LC$BeanName);
		ElsIf LN$Result = -1 Then
 	       PKG_LOOK_AND_FEEL.ShowError(LC$ErrMsg);
  		   Synchronize ;		 	  	        				
		End if ;	  
	End ;	                      

	  
END PKG_LAF_LOV;


PACKAGE PKG_LAF_ROBOT IS
 
  GB$Continue   Boolean  := true ;
  
  PROCEDURE LAF_Robot 
  (
     PC$LAF_BEAN     IN  VARCHAR2
    ,PC$Function     IN  VARCHAR2
    ,PC$Params       IN  VARCHAR2
  );
  
  Procedure Get_Block_Bounds
  (
     PC$BlockName  IN Varchar2
    ,PC$X         OUT Varchar2
    ,PC$Y         OUT Varchar2
    ,PC$W         OUT Varchar2
    ,PC$H         OUT Varchar2            
  );  
  
END;


PACKAGE BODY PKG_LAF_ROBOT IS
  
----------------------------------------------
--                                          --
--  procedure that interprets Robot orders  --
--                                          --
----------------------------------------------
PROCEDURE LAF_Robot 
  (
     PC$LAF_BEAN     IN  VARCHAR2
    ,PC$Function     IN  VARCHAR2
    ,PC$Params       IN  VARCHAR2
  )
IS
 LC$Pm1    Varchar2(10000);
 LC$Pm2    Varchar2(10000);
 LC$Pm3    Varchar2(10000);
 LC$Pm4    Varchar2(10000);
 LC$Pm5    Varchar2(10000);
 LC$Pm6    Varchar2(10000);  
BEGIN
	
	If Not GB$Continue Then Return; End if ;
	
	-- split the parameters --
	If PC$Params Is Not Null Then
		 LC$Pm1 := PKG_LOOK_AND_FEEL.Split(PC$Params, 1, '^');
		 LC$Pm2 := PKG_LOOK_AND_FEEL.Split(PC$Params, 2, '^');
		 LC$Pm3 := PKG_LOOK_AND_FEEL.Split(PC$Params, 3, '^');
		 LC$Pm4 := PKG_LOOK_AND_FEEL.Split(PC$Params, 4, '^');
		 LC$Pm5 := PKG_LOOK_AND_FEEL.Split(PC$Params, 5, '^');
		 LC$Pm6 := PKG_LOOK_AND_FEEL.Split(PC$Params, 6, '^');		 		 		 
	End if ;
  
	-- apply the built-in --
	If upper(PC$Function) = 'GO_ITEM()' Then
		 Go_Item(LC$Pm1);
	ElsIf upper(PC$Function) = 'GO_BLOCK()' Then
		 Go_Block(LC$Pm1);
	ElsIf upper(PC$Function) = 'GO_RECORD()' Then
		 Go_Record(LC$Pm1);		 
	ElsIf upper(PC$Function) = 'KEY-DOWN' Then
		 Go_Block(LC$Pm1);
	ElsIf upper(PC$Function) = 'KEY-UP' Then
		 Go_Block(LC$Pm1);
	ElsIf upper(PC$Function) = 'KEY-CLRBLK' Then
		 Do_Key('CLEAR_BLOCK');	
	ElsIf upper(PC$Function) = 'KEY-CLRFRM' Then
		 Do_Key('CLEAR_FORM');		
	ElsIf upper(PC$Function) = 'KEY-CLRREC' Then
		 Do_Key('CLEAR_RECORD');		
	ElsIf upper(PC$Function) = 'KEY-COMMIT' Then
		 Do_Key('COMMIT_FORM');		
	ElsIf upper(PC$Function) = 'KEY-CQUERY' Then
		 Do_Key('COUNT_QUERY');		
	ElsIf upper(PC$Function) = 'KEY-CREREC' Then
		 Do_Key('CREATE_RECORD');		
	ElsIf upper(PC$Function) = 'KEY-DELREC' Then
		 Do_Key('DELETE_RECORD');		
	ElsIf upper(PC$Function) = 'KEY-DOWN' Then
		 Do_Key('DOWN');		
	ElsIf upper(PC$Function) = 'KEY-DUP-ITEM' Then
		 Do_Key('DUPLICATE_ITEM');		
	ElsIf upper(PC$Function) = 'KEY-DUPREC' Then
		 Do_Key('DUPLICATE_RECORD');		
	ElsIf upper(PC$Function) = 'KEY-EDIT' Then
		 Do_Key('EDIT_TEXTITEM');		
	ElsIf upper(PC$Function) = 'KEY-ENTQRY' Then
		 Do_Key('ENTER_QUERY');		
	ElsIf upper(PC$Function) = 'KEY-EXEQRY' Then
		 Do_Key('EXECUTE_QUERY');		
	ElsIf upper(PC$Function) = 'KEY-EXIT' Then
		 Do_Key('EXIT_FORM');		
	ElsIf upper(PC$Function) = 'KEY-HELP' Then
		 Do_Key('HELP');		
	ElsIf upper(PC$Function) = 'KEY-LISTVAL' Then
		 Do_Key('LIST_VALUES');		
	ElsIf upper(PC$Function) = 'KEY-NXTBLK' Then
		 Do_Key('NEXT_BLOCK');		
	ElsIf upper(PC$Function) = 'KEY-NXT-ITEM' Then
		 Do_Key('NEXT_ITEM');		
	ElsIf upper(PC$Function) = 'KEY-NXTKEY' Then
		 Do_Key('NEXT_KEY');		
	ElsIf upper(PC$Function) = 'KEY-NXTREC' Then
		 Do_Key('NEXT_RECORD');		
	ElsIf upper(PC$Function) = 'KEY-NXTSET' Then
		 Do_Key('NEXT_SET');		
	ElsIf upper(PC$Function) = 'KEY-PRINT' Then
		 Do_Key('PRINT');		
	ElsIf upper(PC$Function) = 'KEY-PRVBLK' Then
		 Do_Key('PREVIOUS_BLOCK');		
	ElsIf upper(PC$Function) = 'KEY-PRV-ITEM' Then
		 Do_Key('PREVIOUS_ITEM');		
	ElsIf upper(PC$Function) = 'KEY-PRVREC' Then
		 Do_Key('PREVIOUS_RECORD');		
	ElsIf upper(PC$Function) = 'KEY-SCRDOWN' Then
		 Do_Key('SCROLL_DOWN');		
	ElsIf upper(PC$Function) = 'KEY-SCRUP' Then
		 Do_Key('SCROLL_UP');		
	ElsIf upper(PC$Function) = 'KEY-UP' Then
		 Do_Key('UP');		
	ElsIf upper(PC$Function) = 'KEY-UPDREC' Then
		 Do_Key('LOCK_RECORD');	
	ElsIf upper(PC$Function) = 'FIRST_RECORD' Then
		 First_Record;		 
	ElsIf upper(PC$Function) = 'LAST_RECORD' Then
		 Last_Record;
	ElsIf upper(PC$Function) = 'DO_KEY' Then
		 Do_Key(LC$Pm1);		 
	ElsIf upper(PC$Function) = 'MOUSE_MOVE_TO()' Then
		 Declare
		 	 LC$Window  Varchar2(60) := Get_View_Property( Get_Item_property(PC$LAF_BEAN, ITEM_CANVAS), WINDOW_NAME) ;
		 	 LN$WX  Number := PKG_TOOLS.To_Pixel(Get_Window_Property(LC$Window, X_POS)) ;
		 	 LN$WY  Number := PKG_TOOLS.To_Pixel(Get_Window_Property(LC$Window, Y_POS)) ;
		 	 LN$X   Number := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Pm1, X_POS)) ;
		 	 LN$Y   Number := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Pm1, Y_POS)) ;
		 	 LN$W   Number := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Pm1, WIDTH)) ;
		 	 LN$H   Number := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Pm1, HEIGHT)) ;	
		 Begin
		 	 LN$X := LN$WX + LN$X + ( Round(LN$W / 2) );
		 	 LN$Y := LN$WY + LN$Y + ( Round(LN$H / 2) );
		 	 Set_Custom_Property( PC$LAF_BEAN, 1, 'SET_ROBOT_INFOS', 
		 	         LC$Pm1 || ',MOUSEMOVE,' || LN$X || ',' || LN$Y 
		 	      ) ;
		 End;	
	ElsIf upper(PC$Function) = 'MOUSE_MOVE_TO_XY()' Then
		 	 Set_Custom_Property( PC$LAF_BEAN, 1, 'SET_ROBOT_STEP', 
		 	         'mousemove,' || LC$Pm1 
		 	      ) ;		 	
	ElsIf upper(PC$Function) = 'BUBBLE_PROPERTIES()' Then
		 Set_Custom_Property(PC$LAF_BEAN, 1, 'SET_ROBOT_BUBBLE_PROPERTIES', 
		          LC$Pm1 || ',' || LC$Pm2 || ',' 
		       || LC$Pm3 || ',' || LC$Pm4 
		       || LC$Pm5  );
	ElsIf upper(PC$Function) = 'BUBBLE()' Then
		 Set_Custom_Property(PC$LAF_BEAN, 1, 'SET_ROBOT_BUBBLE', 
		          LC$Pm1 || ',' || LC$Pm2 || ',' 
		       || LC$Pm3 || ',' || LC$Pm4 
		       || LC$Pm5 || ',' || LC$Pm6  );
	ElsIf upper(PC$Function) = 'SHAPE_PROPERTIES()' Then
		 Set_Custom_Property(PC$LAF_BEAN, 1, 'SET_ROBOT_SHAPE_PROPERTIES', 
		          LC$Pm1 || ',' || LC$Pm2 || ',' 
		       || LC$Pm3 || ',' || LC$Pm4 
		       || LC$Pm5  );
	ElsIf upper(PC$Function) = 'TEXT_PROPERTIES()' Then
		 Set_Custom_Property(PC$LAF_BEAN, 1, 'SET_ROBOT_TEXT_PROPERTIES', 
		          LC$Pm1 || ',' || LC$Pm2 || ',' 
		       || LC$Pm3 || ',' || LC$Pm4 
		       || LC$Pm5  );		       
	ElsIf upper(PC$Function) = 'SHAPE()' Then
		 Set_Custom_Property(PC$LAF_BEAN, 1, 'SET_ROBOT_SHAPE', '0,' || Replace(LC$Pm1,'<br>',CHR(10)) );
	ElsIf upper(PC$Function) = 'SHAPE_AROUND()' Then
		 Declare
		 	 LC$Window  Varchar2(60) := Get_View_Property( Get_Item_property(PC$LAF_BEAN, ITEM_CANVAS), WINDOW_NAME) ;
		 	 LN$WX     Number := PKG_TOOLS.To_Pixel(Get_Window_Property(LC$Window, X_POS)) ;
		 	 LN$WY     Number := PKG_TOOLS.To_Pixel(Get_Window_Property(LC$Window, Y_POS)) ;
		 	 LN$X      Number ;
		 	 LN$Y      Number ;
		 	 LN$W      Number ;
		 	 LN$H      Number ;
		 	 LC$Type   Varchar2(100);
		 	 LC$Item   Varchar2(61);
		 	 LC$Delay  Varchar2(100);
		 	 LC$Shape  Varchar2(100);
		 	 LC$Size   Varchar2(100);
		 	 LC$Width  Varchar2(100);
		 	 LC$Height Varchar2(100);
		 	 LC$Block  Varchar2(100);
		 	 LN$NbRec  Pls_Integer := 0;
		 	 LN$Top    Pls_Integer := 0;
		 	 LN$Rec    Pls_Integer := 0;
		 	 LN$Disp   Pls_Integer := 0;
		 Begin
		 	 LC$Type  := PKG_LOOK_AND_FEEL.Split(LC$Pm1, 1, ',');
		 	 LC$Item  := PKG_LOOK_AND_FEEL.Split(LC$Pm1, 2, ',');
		 	 LC$Delay := PKG_LOOK_AND_FEEL.Split(LC$Pm1, 3, ',');
		 	 LC$Shape := PKG_LOOK_AND_FEEL.Split(LC$Pm1, 4, ',');
		 	 LC$Size  := PKG_LOOK_AND_FEEL.Split(LC$Pm1, 5, ',');
		 	 
       LC$Block := Substr(LC$Item, 1, Instr(LC$Item,'.') - 1 ) ;
       If LC$Block Is Not Null Then
         LN$NbRec := Get_Block_Property(LC$Block, RECORDS_DISPLAYED);
         LN$Top   := Get_Block_Property(LC$Block, TOP_RECORD);
         LN$Rec   := Get_Block_Property(LC$Block, CURRENT_RECORD);
         LN$Disp  := (Nvl(LN$Rec,1) - Nvl(LN$Top,1)) + 1 ;
       End if ;
		 	 
		 	 If lower(LC$Shape) NOT IN ('rectangle','roundrectangle','blink_rectangle','blink_roundrectangle') Then
		 	 	  Return ;
		 	 End if ;	  

		 	 If Upper(LC$Type) = 'ITEM' Then
		 	   LN$X   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, X_POS)) ;
		 	   LN$Y   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, Y_POS)) ;
		 	   LN$W   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, WIDTH)) ;
		 	   LN$H   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, HEIGHT));			 	 	
		 	 ElsIf Upper(LC$Type) = 'BLOCK' Then
  		 	 Get_Block_Bounds(LC$Item, LN$X, LN$Y, LN$W, LN$H);
		 	 ElsIf Upper(LC$Type) = 'WINDOW' Then
		 	   LN$X   := PKG_TOOLS.To_Pixel(Get_Window_Property(LC$Window, X_POS)) ;
		 	   LN$Y   := PKG_TOOLS.To_Pixel(Get_Window_Property(LC$Window, Y_POS)) ;			 	 	
		 	   LN$W   := PKG_TOOLS.To_Pixel(Get_Window_Property(LC$Window, WIDTH)) ;
		 	   LN$H   := PKG_TOOLS.To_Pixel(Get_Window_Property(LC$Window, HEIGHT)) ;			 	 	
		 	 End if ;	

		 	 If Upper(LC$Type) = 'WINDOW' Then
		 	   LN$X := LN$WX + LN$X ;
		 	   LN$Y := LN$WY + LN$Y ;
		 	   LC$Width  := LN$W - 2 ;
		 	   LC$Height := LN$H - 2 ;		 	 	
		 	 Else	
		 	   LN$X := LN$WX + LN$X ;
		 	   LN$Y := LN$WY + LN$Y ;
		 	   LC$Width  := LN$W ;
		 	   LC$Height := LN$H ;
		 	   If LN$Disp > 1 Then
		 	   	  LN$Y := LN$Y + ((LN$Disp-1) * LN$H) ;
		 	   End if ;	
		 	 End if ;
		   
			 Set_Custom_Property(PC$LAF_BEAN, 1, 'SET_ROBOT_SHAPE', 
			          '1,' || LC$Delay || ',' || LC$Shape
			       || ',' || LC$Size
			       || ',' || LN$X || ',' || LN$Y
			       || ',' || LC$Width || ',' || LC$Height ) ;
		 End;			
	ElsIf upper(PC$Function) = 'ARROW_TO_ITEM()' Then
		 Declare
		 	 LC$Window  Varchar2(60) := Get_View_Property( Get_Item_property(PC$LAF_BEAN, ITEM_CANVAS), WINDOW_NAME) ;
		 	 LN$WX     Number := PKG_TOOLS.To_Pixel(Get_Window_Property(LC$Window, X_POS)) ;
		 	 LN$WY     Number := PKG_TOOLS.To_Pixel(Get_Window_Property(LC$Window, Y_POS)) ;
		 	 LN$X1     Number ;
		 	 LN$Y1     Number ;
		 	 LN$X2     Number ;
		 	 LN$Y2     Number ;		 	 
		 	 LN$W      Number ;
		 	 LN$H      Number ;
		 	 LC$Type   Varchar2(100);
		 	 LC$Item   Varchar2(61);
		 	 LC$Delay  Varchar2(100);
		 	 LC$Shape  Varchar2(100);
		 	 LN$Size   Number;
		 	 LC$Width  Varchar2(100);
		 	 LC$Height Varchar2(100);
		 	 LC$From   Varchar2(100);
		 	 LC$To     Varchar2(100);
		 	 LC$Gap    Varchar2(100);
		 Begin
		 	 LC$Delay := PKG_LOOK_AND_FEEL.Split(LC$Pm1, 1, ',');
		 	 LC$Width := PKG_LOOK_AND_FEEL.Split(LC$Pm1, 2, ',');
		 	 LC$Item  := PKG_LOOK_AND_FEEL.Split(LC$Pm1, 3, ',');
		 	 LC$Gap   := PKG_LOOK_AND_FEEL.Split(LC$Pm1, 4, ',');
		 	 LC$To    := PKG_LOOK_AND_FEEL.Split(LC$Pm1, 5, ',');
		   LN$Size  := PKG_LOOK_AND_FEEL.Split(LC$Pm1, 6, ',');
		   LC$From  := PKG_LOOK_AND_FEEL.Split(LC$Pm1, 7, ',');
		 	 
		 	 
		 	 LN$W    := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, WIDTH)) ;
		 	 LN$H    := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, HEIGHT));			 	 	
		 	 
		 	 -- arrow points to --
		 	 If Upper(LC$To) = 'N' Then 
		 	   If Upper(LC$Gap) = 'E' Then
		 	     LN$X1   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, X_POS)) ;
		 	     LN$Y1   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, Y_POS)) ;
		 	     LN$X1   := Round( LN$X1 + ( LN$W / 2 ) ) ;
		 	     LN$Y1   := LN$Y1 - 5 ;
		 	   Else                     
		 	     LN$X1   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, X_POS)) ;
		 	     LN$Y1   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, Y_POS)) ;
		 	     LN$X1   := Round( LN$X1 + ( LN$W / 2 ) ) ;
		 	     LN$Y1   := LN$Y1 + 5 ;
		 	   End if ;
		 	 ElsIf Upper(LC$To) = 'NE' Then 
		 	   If Upper(LC$Gap) = 'E' Then
		 	     LN$X1   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, X_POS)) ;
		 	     LN$Y1   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, Y_POS)) ;
		 	     LN$X1   := LN$X1 - 5 ;
		 	     LN$Y1   := LN$Y1 - 5 ;
		 	   Else                     
		 	     LN$X1   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, X_POS)) ;
		 	     LN$Y1   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, Y_POS)) ;
		 	     LN$X1   := LN$X1 + 5 ;
		 	     LN$Y1   := LN$Y1 + 5 ;
		 	   End if ;		 	   
		 	 ElsIf Upper(LC$To) = 'E' Then 
		 	   If Upper(LC$Gap) = 'E' Then
		 	     LN$X1   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, X_POS)) ;
		 	     LN$Y1   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, Y_POS)) ;
		 	     LN$X1   := LN$X1 - 5 ;
		 	     LN$Y1   := Round( LN$Y1 + ( LN$H / 2 ) ) ;
		 	   Else                     
		 	     LN$X1   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, X_POS)) ;
		 	     LN$Y1   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, Y_POS)) ;
		 	     LN$X1   := LN$X1 + 5 ;
		 	     LN$Y1   := Round( LN$Y1 + ( LN$H / 2 ) ) ;
		 	   End if ;
		 	 ElsIf Upper(LC$To) = 'SE' Then 
		 	   If Upper(LC$Gap) = 'E' Then
		 	     LN$X1   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, X_POS)) ;
		 	     LN$Y1   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, Y_POS)) ;
		 	     LN$X1   := LN$X1 - 5 ;
		 	     LN$Y1   := LN$Y1 +  LN$H ;
		 	   Else                     
		 	     LN$X1   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, X_POS)) ;
		 	     LN$Y1   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, Y_POS)) ;
		 	     LN$X1   := LN$X1 + 5 ;
		 	     LN$Y1   := LN$Y1 +  LN$H - 5;
		 	   End if ;		 	   		 	   		 	   
		 	 ElsIf Upper(LC$To) = 'S' Then 
		 	   If Upper(LC$Gap) = 'E' Then
		 	     LN$X1   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, X_POS)) ;
		 	     LN$Y1   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, Y_POS)) ;
		 	     LN$X1   := Round( LN$X1 + ( LN$W / 2 ) ) ;
		 	     LN$Y1   := LN$Y1 + LN$H + 5 ;
		 	   Else                     
		 	     LN$X1   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, X_POS)) ;
		 	     LN$Y1   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, Y_POS)) ;
		 	     LN$X1   := Round( LN$X1 + ( LN$W / 2 ) ) ;
		 	     LN$Y1   := LN$Y1 + LN$H - 5 ;
		 	   End if ;
		 	 ElsIf Upper(LC$To) = 'SW' Then 
		 	   If Upper(LC$Gap) = 'E' Then
		 	     LN$X1   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, X_POS)) ;
		 	     LN$Y1   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, Y_POS)) ;
		 	     LN$X1   := LN$X1 +  LN$W + 5 ;
		 	     LN$Y1   := LN$Y1 + LN$H + 5 ;
		 	   Else                     
		 	     LN$X1   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, X_POS)) ;
		 	     LN$Y1   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, Y_POS)) ;
		 	     LN$X1   := LN$X1 +  LN$W - 5 ;
		 	     LN$Y1   := LN$Y1 + LN$H - 5 ;
		 	   End if ;
		 	 ElsIf Upper(LC$To) = 'W' Then 
		 	   If Upper(LC$Gap) = 'E' Then
		 	     LN$X1   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, X_POS)) ;
		 	     LN$Y1   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, Y_POS)) ;
		 	     LN$X1   := LN$X1 + LN$W + 5 ;
		 	     LN$Y1   := LN$Y1 + Round(LN$H / 2) ;
		 	   Else                     
		 	     LN$X1   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, X_POS)) ;
		 	     LN$Y1   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, Y_POS)) ;
		 	     LN$X1   := LN$X1 + LN$W - 5 ;
		 	     LN$Y1   := LN$Y1 + Round(LN$H / 2) ;
		 	   End if ;
		 	 ElsIf Upper(LC$To) = 'NW' Then 
		 	   If Upper(LC$Gap) = 'E' Then
		 	     LN$X1   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, X_POS)) ;
		 	     LN$Y1   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, Y_POS)) ;
		 	     LN$X1   := LN$X1 + LN$W + 5 ;
		 	     LN$Y1   := LN$Y1 - 5 ;
		 	   Else                     
		 	     LN$X1   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, X_POS)) ;
		 	     LN$Y1   := PKG_TOOLS.To_Pixel(Get_Item_Property(LC$Item, Y_POS)) ;
		 	     LN$X1   := LN$X1 + LN$W - 5 ;
		 	     LN$Y1   := LN$Y1 + 5 ;
		 	   End if ;		 	   
		 	 End if ;
		 	 
		 	 -- arrow comes from --
		 	 If Upper(LC$From) = 'N' Then 
		 	   LN$X2  := LN$X1 ;
		 	   LN$Y2  := LN$Y1 - LN$Size ;
		 	 ElsIf Upper(LC$From) = 'NE' Then 
		 	   LN$X2  := LN$X1 - (LN$Size - Round(LN$Size/3));
		 	   LN$Y2  := LN$Y1 - (LN$Size - Round(LN$Size/3)) ;
		 	 ElsIf Upper(LC$From) = 'E' Then 
		 	   LN$X2  := LN$X1 - LN$Size;
		 	   LN$Y2  := LN$Y1 ;
		 	 ElsIf Upper(LC$From) = 'SE' Then 
		 	   LN$X2  := LN$X1 - (LN$Size - Round(LN$Size/3));
		 	   LN$Y2  := LN$Y1 + (LN$Size - Round(LN$Size/3)); 
		 	 ElsIf Upper(LC$From) = 'S' Then 
		 	   LN$X2  := LN$X1 ;
		 	   LN$Y2  := LN$Y1 + LN$Size ;
		 	 ElsIf Upper(LC$From) = 'SW' Then 
		 	   LN$X2  := LN$X1 + (LN$Size - Round(LN$Size/3)) ;
		 	   LN$Y2  := LN$Y1 + (LN$Size - Round(LN$Size/3)) ;
		 	 ElsIf Upper(LC$From) = 'W' Then 
		 	   LN$X2  := LN$X1 + LN$Size ;
		 	   LN$Y2  := LN$Y1 ;
		 	 ElsIf Upper(LC$From) = 'NW' Then 
		 	   LN$X2  := LN$X1 + (LN$Size - Round(LN$Size/3)) ;
		 	   LN$Y2  := LN$Y1 - (LN$Size - Round(LN$Size/3)) ;		 	   
		 	 End if ;		 	 

		   
			 Set_Custom_Property(PC$LAF_BEAN, 1, 'SET_ROBOT_SHAPE', 
			          '1,' || LC$Delay || ',arrow'
			       || ',' || LC$Width
			       || ',' || LN$X2 || ',' || LN$Y2
			       || ',' || LN$X1 || ',' || LN$Y1 ) ;
		 End;			
	End if ;
	
	Synchronize;
  
	Exception
		When Others then
		  Declare
        LN$errcod NUMBER := ERROR_CODE;
        LC$errtyp VARCHAR2(3) := ERROR_TYPE;
        LC$errtxt VARCHAR2(80) := ERROR_TEXT; 
		  Begin
		  	Set_Custom_Property(PC$LAF_BEAN, 1, 'SET_ROBOT_ABORT_SCRIPT', '' ); 
		  	Clear_Message ;
		  	Message(LC$errtyp||'-'||to_char(LN$errcod)||': '||LC$errtxt, no_acknowledge);
		  	Synchronize;
		  	Raise form_trigger_failure;
		  End;	
END LAF_Robot;  

  
  --------------------------------------------
  --                                        --
  --  procedure that gets a block bounds    --
  --                                        --
  ----------------------------------------------  
  Procedure Get_Block_Bounds
  (
     PC$BlockName  IN Varchar2
    ,PC$X         OUT Varchar2
    ,PC$Y         OUT Varchar2
    ,PC$W         OUT Varchar2
    ,PC$H         OUT Varchar2            
  )
  Is
    LN$MinX     Number := 10000;
    LN$MinY     Number := 10000;
    LN$MaxX     Number := 0;
    LN$MaxY     Number := 0;
    LN$Lines    Pls_Integer := 1 ;    
    LC$Item     Varchar2(100);
    blkID       Block;
  Begin
  	
  	blkId := Find_Block(PC$BlockName);
  	If Not ID_NULL(blkId) Then
  	  
  	  LN$Lines := Get_Block_Property(blkId, RECORDS_DISPLAYED);
  	  LC$Item := Get_Block_Property(blkId, FIRST_ITEM );
  	  
  	  While LC$Item Is Not Null Loop
  	  	 If Get_Item_Property( LC$Item, VISIBLE) = 'TRUE' Then
  	  	 	  If Get_Item_Property( LC$Item, X_POS) < LN$MinX Then
  	  	 	  	 LN$MinX := Get_Item_Property( LC$Item, X_POS) ;
  	  	 	  End if ;	
  	  	 	  If Get_Item_Property( LC$Item, Y_POS) < LN$MinY Then
  	  	 	  	 LN$MinY := Get_Item_Property( LC$Item, Y_POS) ;
  	  	 	  End if ;
  	  	 	  If Get_Item_Property( LC$Item, X_POS) +  Get_Item_Property( LC$Item, WIDTH) > LN$MaxX Then
  	  	 	  	 LN$MaxX := Get_Item_Property( LC$Item, X_POS) +  Get_Item_Property( LC$Item, WIDTH) ;
  	  	 	  End if ;	
  	  	 	  If Get_Item_Property( LC$Item, Y_POS) +  Get_Item_Property( LC$Item, HEIGHT) > LN$MaxY Then
  	  	 	  	 LN$MaxY := Get_Item_Property( LC$Item, Y_POS) +  Get_Item_Property( LC$Item, HEIGHT) ;
  	  	 	  End if ;	
  	  	 End if ;	
  	  	 LC$Item := Get_Item_Property( LC$Item, NEXTITEM);
  	  End loop ;

  	  PC$W  := Trunc(PKG_TOOLS.To_Pixel(LN$MaxX - LN$MinX) + 4) ;
  	  PC$H  := Trunc(PKG_TOOLS.To_Pixel(((LN$MaxY - LN$MinY) * LN$Lines)) + 4) ;
  	  If LN$MinX > 2 Then LN$MinX := LN$MinX - 2; End if ;
  	  If LN$MinY > 2 Then LN$MinY := LN$MinY - 2; End if ;  	  
  	  PC$X  := Trunc(PKG_TOOLS.To_Pixel(LN$MinX)) ;
  	  PC$Y  := Trunc(PKG_TOOLS.To_Pixel(LN$MinY)) ;  	  
  	  
  	End if ;
  	
  	
  End Get_Block_Bounds;
  
  
END;


PACKAGE PKG_LOB IS
  Function Read_Lob 
  (
     PC$Type   IN     VARCHAR2
    ,PC$Item   IN     VARCHAR2
    ,PN$Record IN     PLS_INTEGER
    ,PC$Query  IN     VARCHAR2
    ,PC$Msg    IN OUT VARCHAR2
  ) Return Boolean ;
  
  Function Write_Lob 
  (
     PC$Type   IN     VARCHAR2
    ,PC$Item   IN     VARCHAR2    
    ,PN$Record IN     PLS_INTEGER
    ,PC$Query  IN     VARCHAR2
    ,PC$Msg    IN OUT VARCHAR2
  ) Return Boolean ;
  
  Function Read_Lob_Table 
  (
     PC$Table  IN     VARCHAR2     
    ,PC$Type   IN     VARCHAR2
    ,PC$Bean   IN     VARCHAR2         
    ,PC$Row    IN     VARCHAR2
    ,PC$Cell   IN     VARCHAR2
    ,PC$Query  IN     VARCHAR2
    ,PC$Msg    IN OUT VARCHAR2
  ) Return Boolean ;
  
  Function Write_Lob_Table 
  (
     PC$Table  IN     VARCHAR2
    ,PC$Type   IN     VARCHAR2
    ,PC$Bean   IN     VARCHAR2    
    ,PC$Query  IN     VARCHAR2
    ,PC$Msg    IN OUT VARCHAR2
  ) Return Boolean ; 
  
  PROCEDURE Load_Video_From_Base 
	(
		PC$Bean        IN Varchar2,
		PC$WhereClause IN Varchar2,
		PC$Name        IN Varchar2
	);
  
END;


PACKAGE BODY PKG_LOB IS
  
  -----------------------------------------
  --  Read a CLOB/NCLOB database column  --
  -----------------------------------------
  Function Read_Lob 
  (
     PC$Type   IN     VARCHAR2
    ,PC$Item   IN     VARCHAR2         
    ,PN$Record IN     PLS_INTEGER
    ,PC$Query  IN     VARCHAR2
    ,PC$Msg    IN OUT VARCHAR2
  ) Return Boolean
  Is
	  LN$Length  pls_integer ;
    LC$Chunk   Varchar2(32767) ;
    LC$Req     Varchar2(1024);  
    LB$Ok      Boolean ;
    LN$i       pls_integer := 1;
  Begin
	  
	  Set_Custom_Property(PC$Item,PN$Record, 'BIG_CLEAR','');
	  
	  ---------------------------------------
	  --  select the database CLOB column  --
	  ---------------------------------------
	  If Upper(PC$Type) = 'CLOB' Then
	  	 LB$Ok := pkg_laf.select_clob(PC$Query) ;
	  ElsIf Upper(PC$Type) = 'NCLOB' Then	    
	  	 LB$Ok := pkg_laf.select_nclob(PC$Query) ;
	  Else
	  	 PC$Msg := 'Type must be CLOB or NCLOB';
	  	 Return false ;
	  End if ;	
	  	
	  If LB$Ok then
	    Loop
	      -------------------------
	      --  get the chunks...  --
	      -------------------------
	      If Upper(PC$Type) = 'CLOB' Then
	        LC$Chunk := pkg_laf.get_chunk ;
	      Else                           
	        LC$Chunk := pkg_laf.get_nchunk ;	
	      End if ;	
	      Exit when LC$Chunk is null ;
	      --------------------------------------
	      --  ... then send them to the Bean  --
	      --------------------------------------
	      Set_Custom_Property(PC$Item,PN$Record, 'BIG_ADD_TEXT',LC$Chunk);
	      If Mod(LN$i, 10000) = 0 Then
	      	  Synchronize;
	      End if ;
	      LN$i := LN$i + 1;
	    End loop ;
	    ---------------------------------
	    --  display the complete text  --
	    ---------------------------------
	    Set_Custom_Property(PC$Item,PN$Record, 'BIG_SHOW','');

	  Else
	    PC$Msg := 'Unable to select LOB column' ;  	
	    Return false ;
	  End if ;
	
	 	Return true ;
	 	
	Exception
	  	When Others Then
	      PC$Msg := SQLERRM ;
	      Return false ;  	
  End Read_Lob;	
  
  
  ------------------------------------------
  --  Write a CLOB/NCLOB database column  --
  ------------------------------------------
  Function Write_Lob 
  (
     PC$Type   IN     VARCHAR2
    ,PC$Item   IN     VARCHAR2    
    ,PN$Record IN     PLS_INTEGER
    ,PC$Query  IN     VARCHAR2
    ,PC$Msg    IN OUT VARCHAR2
  ) Return Boolean
  Is
	  LN$Length  pls_integer ;
    LC$Chunk  Varchar2(32767) ;
    LC$Req    Varchar2(1024);    
  Begin
  	
		--------------------------------
		--  set the UPDATE SQL order  --
		--------------------------------
		-- sample UPDATE order is :  'Update TEST_CLOB Set TEXT = :1 Where ID=1' ;
		
		-------------------------------------
		--  Init the transfer for a NCLOB  --
		-------------------------------------
		pkg_laf.Init_Transfer_lob ( PC$Type );
		Loop 
		  LC$Chunk := Get_Custom_Property(PC$Item,PN$Record,'BIG_GET_TEXT') ;
		  Exit When  LC$Chunk Is Null ;
		  ---------------------------------------
	    --  Send the chunks to the database  --
	    ---------------------------------------
	    If Upper(PC$Type) = 'CLOB' Then
	      pkg_laf.Set_Chunk ( LC$Chunk ) ;
	    Else                            
	    	pkg_laf.Set_NChunk ( LC$Chunk ) ;
	    End if ;	
		End loop;
		---------------------------------------------
		--  Update the CLOB/NCLOB database column  --
		---------------------------------------------
		PC$Msg :=  pkg_laf.Transfer( PC$Query, PC$Type ) ;  	
		If PC$Msg = 'OK' Then
	     Return True ;
		Else
			 Return false ;
		End if ;		
  	
	Exception
	  	When Others Then
	      PC$Msg := SQLERRM ;
	      Return false ;  	
  End Write_Lob;	
    
  
  -----------------------------------------
  --  Read a CLOB/NCLOB database column  --
  -----------------------------------------
  Function Read_Lob_Table 
  (
     PC$Table  IN     VARCHAR2     
    ,PC$Type   IN     VARCHAR2
    ,PC$Bean   IN     VARCHAR2         
    ,PC$Row    IN     VARCHAR2
    ,PC$Cell   IN     VARCHAR2
    ,PC$Query  IN     VARCHAR2
    ,PC$Msg    IN OUT VARCHAR2
  ) Return Boolean
  Is
	  LN$Length  pls_integer ;
    LC$Chunk   Varchar2(32767) ;
    LC$Req     Varchar2(1024);  
    LB$Ok      Boolean ;
    LN$i       pls_integer := 1;
  Begin
	  
	  ---------------------------------------
	  --  select the database CLOB column  --
	  ---------------------------------------
	  If Upper(PC$Type) = 'CLOB' Then
	  	 LB$Ok := pkg_laf.select_clob(PC$Query) ;
	  ElsIf Upper(PC$Type) = 'NCLOB' Then	    
	  	 LB$Ok := pkg_laf.select_nclob(PC$Query) ;
	  Else
	  	 PC$Msg := 'Type must be CLOB or NCLOB';
	  	 Return false ;
	  End if ;	
	  	
	  If LB$Ok then
	    
	    Set_Custom_Property(PC$Bean,1,'SET_TB_ADD_TEXT', PC$Table || '|[^START-TEXT^]');
	    	  
	    Loop
	      -------------------------
	      --  get the chunks...  --
	      -------------------------
	      If Upper(PC$Type) = 'CLOB' Then
	        LC$Chunk := pkg_laf.get_chunk ;
	      Else                           
	        LC$Chunk := pkg_laf.get_nchunk ;	
	      End if ;	
	      Exit when LC$Chunk is null ;
	      --------------------------------------
	      --  ... then send them to the Bean  --
	      --------------------------------------
	      Set_Custom_Property(PC$Bean,1,'SET_TB_ADD_TEXT',PC$Table || '|' || LC$Chunk);
	      If Mod(LN$i, 10000) = 0 Then
	      	  Synchronize;
	      End if ;
	      LN$i := LN$i + 1;
	    End loop ;
	    ---------------------------------
	    --  display the complete text  --
	    ---------------------------------
	    Set_Custom_Property(PC$Bean,1,'SET_TB_ADD_TEXT',PC$Table || '|[^END-TEXT^],' || PC$Row || ',' || PC$Cell);

	  Else
	    PC$Msg := 'Unable to select LOB column' ;  	
	    Return false ;
	  End if ;
	
	 	Return true ;
	 	
	Exception
	  	When Others Then
	      PC$Msg := SQLERRM ;
	      Return false ;  	
  End Read_Lob_Table;	
  
  
  ------------------------------------------
  --  Write a CLOB/NCLOB database column  --
  ------------------------------------------
  Function Write_Lob_Table 
  (
     PC$Table  IN     VARCHAR2
    ,PC$Type   IN     VARCHAR2
    ,PC$Bean   IN     VARCHAR2    
    ,PC$Query  IN     VARCHAR2
    ,PC$Msg    IN OUT VARCHAR2
  ) Return Boolean
  Is
	  LN$Length  pls_integer ;
    LC$Chunk   Varchar2(32767) ;
    LC$Req     Varchar2(1024);    
  Begin
		--------------------------------
		--  set the UPDATE SQL order  --
		--------------------------------
		-- sample UPDATE order is :  'Update TEST_CLOB Set TEXT = :1 Where ID=1' ;

		-------------------------------------
		--  Init the transfer for a NCLOB  --
		-------------------------------------
		pkg_laf.Init_Transfer_lob ( PC$Type );
		Loop 
		  LC$Chunk := Get_Custom_Property(PC$Bean,1, 'GET_TB_TEXT') ;
		  Exit When  LC$Chunk Is Null ;

		  ---------------------------------------
	    --  Send the chunks to the database  --
	    ---------------------------------------
	    If Upper(PC$Type) = 'CLOB' Then
	      pkg_laf.Set_Chunk ( LC$Chunk ) ;
	    Else                            
	    	pkg_laf.Set_NChunk ( LC$Chunk ) ;
	    End if ;	
		End loop;
		---------------------------------------------
		--  Update the CLOB/NCLOB database column  --
		---------------------------------------------
		PC$Msg :=  pkg_laf.Transfer( PC$Query, PC$Type ) ;  	

		If PC$Msg = 'OK' Then
	     Return True ;
		Else
			 Return false ;
		End if ;		
  	
	Exception
	  	When Others Then
	      PC$Msg := SQLERRM ;
	      Return false ;  	
  End Write_Lob_Table;	
    
  ------------------------------------------------
  --  Read a video from a BLOB database column  --
  ------------------------------------------------
	PROCEDURE Load_Video_From_Base 
	(
		PC$Bean        IN Varchar2,
		PC$WhereClause IN Varchar2,
		PC$Name        IN Varchar2
	)
	IS
		LB$Ok boolean ;
		LC$Video Varchar2(32767) ;
	BEGIN
		--
		-- Read a BLOB content from the database
		--
		-- Select the Blob column --
		If PKG_LAF.Select_Blob(PC$WhereClause) Then
			Loop
				-- Get the video chunks from the database --
				LC$Video := PKG_LAF.Get_B64_Chunk ;
				If LC$Video Is Not Null Then
					-- Send the chunks to the Java Bean --
					Set_Custom_Property( PC$Bean, 1, 'QUICKT_SET_MOVIE_BASE', LC$Video ) ;
				Else
					-- End the sending process --
					LC$Video := '[END_VIDEO]|' || PC$Name ;
					Set_Custom_Property( PC$Bean, 1, 'QUICKT_SET_MOVIE_BASE', LC$Video );
					Exit ;
				End if ;
			End loop ;
		End if ;
	END;    
  
END;


PACKAGE PKG_LOOK_AND_FEEL IS
  
  -------------
  --  Types  --
  -------------
  Type     TYP_TAB_STRINGS is table of Varchar2(4000) index by BINARY_INTEGER ;
  Type     TYP_TAG is Record
  (
     TagName   Varchar2(128),
     TagValue  Varchar2(4000)
  );
  Type     TYP_TAB_TAG is table of TYP_TAG index by Binary_Integer ;
  Type     TYP_CSS is Record
  (
     Section   Varchar2(128),
     SectType  Varchar2(60),
     Tags      TYP_TAB_TAG
  );
  
  Type    TYP_TAB_CSS is Table of TYP_CSS index by Binary_Integer ;
  
  -- Table of CSS tags --
  TabTags  TYP_TAB_CSS ;
  
  -- Table of blocks --
  Type    TYP_TAB_CHAR is table of Varchar2(100) index by Binary_Integer ;
  
  Type    TYP_REC_VA_ATTR is Record
  (
     name     Varchar2(30),
     font     Varchar2(100),
     fsize    Pls_integer,
     weight   Pls_integer,
     style    Pls_integer,
     BackCol  Varchar2(100),
     ForeCol  Varchar2(100)
  ) ;
  
  Type    TYP_REC_BLK is Record 
  ( 
     pos      Pls_Integer, 
     blk_name Varchar2(100), 
     cvs_name Varchar2(100), -- AJE
     va_odd   Varchar2(50),  -- added in V 1.4
     va_even  Varchar2(50),  -- added in V 1.4
     items    TYP_TAB_CHAR,
     prompts  TYP_TAB_CHAR,
     Cur_Attr TYP_REC_VA_ATTR     
  ) ;
  Type    TYP_TAB_BLKS is table of TYP_REC_BLK index by Binary_Integer ;
  GT$Blocks     TYP_TAB_BLKS ; 
  
  -- Item properties --
  Type TYP_REC_ITEMS_PROPS is Record
  (
     font     varchar2(50)
    ,fweight  varchar2(50)
    ,fsize    varchar2(50)
    ,fgColor  varchar2(50)
    ,bgColor  varchar2(50)
  );
  Type TYP_REC_ITEMS is record
  (
     name     varchar2(50)
    ,props    TYP_REC_ITEMS_PROPS
  );
  Type TAB_TYP_REC_ITEMS is table of TYP_REC_ITEMS index by binary_integer ;
  tab_items TAB_TYP_REC_ITEMS;
  -----------------------
    
  GB$Css_Open   Boolean := false ;
    
  --  Functions  --    
  Procedure  Paint_Canevas
  ( 
    PC$Class       IN Varchar2,
    PC$BeanName    IN Varchar2
  ) ;
  
  Procedure  Paint_Block
  ( 
    PC$Block       IN Varchar2,
    PC$BeanName    IN Varchar2,
    PC$VA_Name     IN Varchar2,        
    PC$HeadClass   IN Varchar2,
    PC$BodyClass   IN Varchar2,
    PC$TitleClass  IN Varchar2 Default Null,
    PC$Title       IN Varchar2 Default Null,
    PB$ScrollBar   IN Boolean  Default True,
    PB$SortBlock   IN Boolean  Default Null
  ) ;
  
  Procedure  Set_GUI_Properties
  ( 
    PC$Class       IN Varchar2,
    PC$BeanName    IN Varchar2
  ) ;
  
  Function   Open_CSS( PC$Filename IN Varchar2 )
  Return Boolean ;
  
  Function   Write_CSS ( PC$Filename IN Varchar2 )
  Return Boolean ;
  
  Function   Get_Tag_Value
  ( 
    PC$Section  IN Varchar2,
    PC$TagName  IN Varchar2,
    PC$Default  IN Varchar2 Default 'none'
  ) Return Varchar2 ;
  
  Function Get_Tag_All_Values
  ( 
    PC$Section  IN Varchar2,
    PC$TagName  IN Varchar2 
  ) Return TYP_TAB_STRINGS ;  
  
  Procedure Set_Tag_Value
  ( 
    PC$Section  IN Varchar2,
    PC$TagName  IN Varchar2,
    PC$TagValue IN Varchar2 
  );
  
  Procedure Add_Tag_Value
  ( 
    PC$Section  IN Varchar2,
    PC$TagName  IN Varchar2,
    PC$TagValue IN Varchar2 
  );  
  
  Procedure Remove_Tag_Value
  ( 
    PC$Section  IN Varchar2,
    PC$TagName  IN Varchar2
  );  
  
  Function   Is_Tag_Exists
  ( 
    PC$TagName  IN Varchar2
  ) Return Boolean ;  
  
  Function   Get_Tag_Table Return TYP_TAB_CSS ;
  
  Function   Get_Section_Tags(PC$Section IN Varchar2) Return TYP_TAB_TAG ;
  
  Procedure  Set_Section_Tags
  ( 
    PC$Section IN Varchar2,
    PT$TTags   IN TYP_TAB_TAG
   ) ;
  
  Procedure  Print_Tags( PC$Section IN Varchar2 DEFAULT '*ALL*' ) ;
  
  Function   IsBlockEmbeded( PC$Block  IN Varchar2 )
  Return Pls_Integer ;
  
  Procedure ShowError( PC$Message IN Varchar2 ) ;
  
  Procedure Fill_table
  ( 
    PC$Type  IN Varchar2 DEFAULT 'ODD',
    PB$Start IN Boolean DEFAULT TRUE 
   ) ;
   
  Procedure LAF_Execute_Query ; 
  
	Function Split
	(
	   PC$Chaine IN VARCHAR2,         -- input string
	   PN$Pos IN PLS_INTEGER,         -- token number
	   PC$Sep IN VARCHAR2 DEFAULT ',' -- separator character
	) Return Varchar2 ;  
	
	Function Split
	(
	   PC$Chaine IN CLOB,         -- input string
	   PN$Pos IN PLS_INTEGER,         -- token number
	   PC$Sep IN VARCHAR2 DEFAULT ',' -- separator character
	) Return Varchar2 ;  	
	
	  Procedure To_String_Collection
  ( 
     LC$String      IN Varchar2,
     PT$StringTable IN OUT NOCOPY TYP_TAB_STRINGS 
   );
   
  PROCEDURE Read_Image
  (
    PC$Bean      IN VARCHAR2,
    PC$Image     IN VARCHAR2,
    PC$Clause    IN VARCHAR2
  );
  
  PROCEDURE Write_Image
  (
    PC$Bean      IN VARCHAR2,
    PC$Image     IN VARCHAR2,
    PC$Table     IN VARCHAR2,
    PC$Column    IN VARCHAR2,
    PC$Clause    IN VARCHAR2
  );  
  
  
  PROCEDURE Set_All_Items_Properties ;  
  
  
END;


PACKAGE BODY PKG_LOOK_AND_FEEL IS
    
  
  ------------------------------------
  --  paint the given bean canevas  --
  ------------------------------------
  Procedure  Paint_Canevas
  ( 
    PC$Class       IN Varchar2,     -- Canevas CSS class name
    PC$BeanName    IN Varchar2      -- associated bean area
  ) Is
    LC$Gradient  Varchar2(30);
    LC$Direction Varchar2(30);
    LC$HCycle    Varchar2(30);
    LC$VCycle    Varchar2(30);
    LC$Image     Varchar2(128);
    LC$Motif     Varchar2(128);
    LN$Cpt       Pls_Integer := 1;
    TabProps     TYP_TAB_STRINGS ;
  Begin
  	 PKG_TABLE.Set_Bean_Name(PC$BeanName);
  	 -- css file open ? --
  	 If Not GB$Css_Open Then Return; End if ;
  	 -- tag section exists ? --
  	 If Not Is_Tag_Exists(PC$Class) Then 
  	 	  Set_Custom_Property(PC$BeanName, 1,'DISPLAY_MESSAGE',
  		     '0,0,400,180,/LAFhelp.gif,L&F Opening CSS file,' || PC$Class || ' : CSS section not found');
  	 End if ;

  	 LC$Gradient  := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'gradient-colors','none') ;
  	 LC$Direction := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'gradient-direction','none') ;
  	 If LC$Gradient <> 'none' Then
  	   LC$HCycle   := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'gradient-hcycle','0') ;
  	   LC$VCycle   := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'gradient-vcycle','0') ;
  	   If LC$Direction <> 'none' Then
  	   	  Set_Custom_Property( PC$BeanName, 1, 'SET_GRADIENT_DIRECTION', LC$Direction);
  	   End if ;
  	   Set_Custom_Property( PC$BeanName, 1, 'SET_GRADIENT_COLORS', LC$Gradient);
  	   If LC$HCycle <> '0' Then
          Set_Custom_Property( PC$BeanName, 1, 'SET_H_CYCLE', LC$HCycle ) ;
  	   End if ;
  	   If LC$VCycle <> '0' Then
          Set_Custom_Property( PC$BeanName, 1, 'SET_V_CYCLE', LC$VCycle ) ;
        End if ;  	   
  	 End if ;
  	 -- linear gradients ----------------------
  	 -- feature added in v 1.3 January 2009  --
  	 ------------------------------------------
  	 TabProps := PKG_Look_And_Feel.Get_Tag_All_Values(PC$Class,'gradient-linear') ;
  	 If TabProps.Count() > 0 Then
  	 	  For i IN TabProps.First .. TabProps.Last Loop
  	 	  	 Set_Custom_Property( PC$BeanName, 1, 'ADD_LINEAR_GRADIENT', TabProps(i) ) ;
  	 	  End Loop;	 
  	 End if ;  	 
  	 -- Background images ? --
  	 TabProps := PKG_Look_And_Feel.Get_Tag_All_Values(PC$Class,'image') ;
  	 If TabProps.Count() > 0 Then
  	 	  LN$Cpt := 1 ;
  	 	  For i IN TabProps.First .. TabProps.Last Loop  	 
  	 	     Set_Custom_Property( PC$BeanName, 1, 'ADD_IMAGE', LN$Cpt || ',' || TabProps(i) ) ;
  	 	     LN$Cpt := LN$Cpt + 1 ;
  	 	  End Loop;	 
  	 End if ;  	 
  	 -- Motif ? --
  	 LC$Motif := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'texture-paint','none') ;
  	 If LC$Motif <> 'none' Then
  	 	 Set_Custom_Property( PC$BeanName, 1, 'SET_MOTIF', LC$Motif);
  	 End if ;	  	 
  End Paint_Canevas ;
  
  
  -------------------------------------------------------
  --  decorate a multi-record block table              --
  --                                                   --
  --  tuned by    : John Vander Heyden (November 2007) --
  --  modified by : Francois Degrelle (June 2008)      --
  --                bug correction when block title    --
  --                is not provided                    --
  --  modified by : Francois Degrelle (October 2008)   --  
  --                bug correction when item prompt    --
  --                is split on two lines              --
  --  modified by : Albert Ellen (February 2009)       --
  --                modification allowing to paint     --
  --                correctly spread table blocks      --
  --  modified by : Francois Degrelle (May 2009)       --
  --                modification allowing to paint     --
  --                both ODD and EVEN lines, and also  --  
  --                read the corresponding Visual      --
  --                Attribute names from the CSS       --
  --  modified by : BUI Thanh Hoang (November 2010)    --
  --                                                   --
  -------------------------------------------------------
  Procedure  Paint_Block
  ( 
    PC$Block       IN Varchar2,               -- the block name to decorate
    PC$BeanName    IN Varchar2,               -- the associated bean area
    PC$VA_Name     IN Varchar2,               -- the visual attribute associated    
    PC$HeadClass   IN Varchar2,               -- the table header CSS class name
    PC$BodyClass   IN Varchar2,               -- the table body CSS class name
    PC$TitleClass  IN Varchar2 Default Null,  -- the table title CSS class name
    PC$Title       IN Varchar2 Default Null,  -- the block title
    PB$ScrollBar   IN Boolean  Default True,  -- scrollbar exists on block true/false
    PB$SortBlock   IN Boolean  Default Null   -- end-user can sort the block with mouse
  ) Is
  LC$Block       Varchar2(30) := PC$Block ;
  LC$Canvas      Varchar2(30) := Get_Item_Property(PC$BeanName, ITEM_CANVAS); 
  LC$Item        Varchar2(61) := Get_Block_Property( LC$Block, FIRST_ITEM ) ;
  LN$Nbre        Pls_Integer  := Get_Block_Property( LC$Block, RECORDS_DISPLAYED );
  LN$Width       Number := 0 ;
  LN$Height      Number := 0 ;
  LN$HeadHeight  Number := 0 ;
  LN$PosX        Number := 99999 ;
  LN$XPos        Number := 0 ;
  LN$EndX        Number := 0 ;  
  LN$PosY        Number := 0 ;
  LN$W           Number := 0 ;
  LN$H           Number := 0 ;
  LN$X1          Number := 0 ;
  LN$Y1          Number := 0 ;    
  LN$X2          Number := 0 ;    
  LN$Y2          Number := 0 ;
  LN$HX1         Number := 0 ;
  LN$HY1         Number := 0 ;    
  LN$HX2         Number := 0 ;    
  LN$HY2         Number := 0 ;  
  LC$Prop        Varchar2(512) ;
  LC$Va          Varchar2(50);
  LN$Dec         Number := 0 ;
  LN$TextXPos    Number ;
  LN$TmpVal      Number ;
  LN$FrameWidth  Number;
  Type         TYP_REC is record
  (
    prompt  Varchar2(256),
    posX    Number,
    posY    Number,
    pend    Number,
    iname   Varchar2(61)
  );
  Type             TYP_TAB_REC is table of TYP_REC index by binary_integer ;
  Texts            TYP_TAB_REC ;
  LN$Indice        Pls_integer := 0 ;
  LN$Index         Pls_Integer := 1 ;   
  -- texts --
  LB$Double        Boolean      := false ;
  LC$Gradient      Varchar2(30);
  LC$TextOffset    Varchar2(30) := '0';
  LC$TextAlign     Varchar2(30) := 'left';
  LC$OddBack       Varchar2(30) := '' ;
  LC$EvenBack      Varchar2(30) := '' ;
  LC$OddFore       Varchar2(30) := '' ;
  LC$EvenFore      Varchar2(30) := '' ;  
  LC$FontFamily    Varchar2(30) := '' ;
  LC$FontWeight    Varchar2(30) := '' ;
  LC$FontSize      Varchar2(30) := '' ;
  LC$FrameColor    Varchar2(30) := '' ;
  LC$ShadeColor    Varchar2(30) := '' ;
  LC$OutLineColor  Varchar2(30) := '' ;
  LC$Transparency  Varchar2(30) := '' ;
  LC$OutWidth      Varchar2(30) := '' ;
  LC$Rotation      Varchar2(30) := '' ;
  LC$FrameMotif    Varchar2(128) ;
  LC$TextMotif     Varchar2(128) ;
  LC$Direction     Varchar2(30); 
  LC$Round         Varchar2(30);
  LN$DecH          Pls_Integer := 0 ;
  LN$DecB          Pls_Integer := 0 ;
  LN$SPoint        Pls_integer := 0 ;
  LN$End           Number ;
  lig              Pls_integer := 1 ;
  LN$NbLigs        Pls_integer := 0 ;
  LN$MaxLigs       Pls_integer := 1 ;
  VA_Name          Varchar2(256) ;
  VA_Font          Varchar2(256) ;
  VA_Size          Varchar2(256) ;
  VA_Weight        Varchar2(256) ;
  VA_Style         Varchar2(256) ;  
  VA_BackCol       Varchar2(256) ;
  VA_ForeCol       Varchar2(256) ;
  LC$VA_ODD        Varchar2(50) ;
  LC$VA_EVEN       Varchar2(50) ;  
  id_va            VISUALATTRIBUTE ; 
  LB$SortBlock     Boolean := PB$SortBlock ;
  LC$CanSortBlock  Varchar2(30) := '';
  LC$SortIconNext  Varchar2(256);
  LC$SortIconPrev  Varchar2(256);

BEGIN

  PKG_TABLE.Set_Bean_Name(PC$BeanName);
  
  -- if single line block, do nothing --
  If LN$Nbre < 2 Then Return ; End if ;
  
  -- css file open ? --
  If Not GB$Css_Open Then Return; End if ;

  -- tag sections exists ? --
  If Not Is_Tag_Exists(PC$HeadClass) Then
     Set_Custom_Property(PC$BeanName, 1,'DISPLAY_MESSAGE',
  	    '0,0,400,180,/LAFhelp.gif,L&F Opening CSS file,' || PC$HeadClass || ' : CSS section not found'); 
  End if ;
  If Not Is_Tag_Exists(PC$BodyClass) Then
     Set_Custom_Property(PC$BeanName, 1,'DISPLAY_MESSAGE',
  	    '0,0,400,180,/LAFhelp.gif,L&F Opening CSS file,' || PC$BodyClass || ' : CSS section not found');
  End if ;  	
  If PC$TitleClass Is Not Null And Not Is_Tag_Exists(PC$TitleClass) Then
     Set_Custom_Property(PC$BeanName, 1,'DISPLAY_MESSAGE',
  	    '0,0,400,180,/LAFhelp.gif,L&F Opening CSS file,' || PC$TitleClass || ' : CSS section not found');
  End if ;  	

  -- store the block name in the table --
  If GT$Blocks.count > 0 Then 
  	-- block does exist ? --
  	For i In 1 .. GT$Blocks.count Loop
  		 If  GT$Blocks(i).blk_name = PC$Block  -- AJE
  		 And GT$Blocks(i).cvs_name = LC$Canvas Then -- AJE : is required for block partly on main canvas and partly on spreadtable canvas
          -- reset the prompts --
  		 	  For j In GT$Blocks(i).Items.First .. GT$Blocks(i).Items.Last Loop
  		 	  	 Set_Item_Property( GT$Blocks(i).items(j), PROMPT_TEXT,GT$Blocks(i).prompts(j) ) ;
  		 	  End loop ;
  		 	  GT$Blocks.delete(i) ;
  		 	  LN$Index := i - 1 ;
  		 	  Exit ;
  		 End if ;
  		 LN$Index := i ;
  	End loop ;
  	LN$Index  := LN$Index + 1 ;
  End if ;
  -- Block inscription --
  GT$Blocks(LN$Index).pos := LN$Index ;
  GT$Blocks(LN$Index).blk_name := PC$Block ;
  GT$Blocks(LN$Index).cvs_name := LC$Canvas; -- AJE : is required for block partly on main canvas and partly on spreadtable canvas

  -- Visual Attribute for ODD lines --
  LC$VA_ODD := PKG_Look_And_Feel.Get_Tag_Value(PC$BodyClass,'va-odd','none') ;
  If LC$VA_ODD <> 'none' Then 
  	-- Visual Attribute exists in the module ? --
  	id_va := Find_VA(LC$VA_ODD);
  	If ID_NULL(id_va) Then
  	 Set_Custom_Property(PC$BeanName, 1,'DISPLAY_MESSAGE',
  	   '0,0,400,180,/LAFhelp.gif,L&F Paint_Block ODD lines,Visual Attribute Name : ' || LC$VA_ODD || ' does not exist in the Forms module');
  	 LC$VA_ODD := 'none' ;  
  	Else   
  	  GT$Blocks(LN$Index).va_odd := LC$VA_ODD ; 
  	End if ;  
  End if ;  

  -- Visual Attribute for EVEN lines --
  LC$VA_EVEN := PKG_Look_And_Feel.Get_Tag_Value(PC$BodyClass,'va-even','none') ;  
  If LC$VA_EVEN <> 'none' Then 
  	-- Visual Attribute exists in the module ? --
  	id_va := Find_VA(LC$VA_EVEN);
  	If ID_NULL(id_va) Then
  	 Set_Custom_Property(PC$BeanName, 1,'DISPLAY_MESSAGE',
  	   '0,0,400,180,/LAFhelp.gif,L&F Paint_Block EVEN lines,Visual Attribute Name: ' || LC$VA_EVEN || ' does not exist in the Forms module');
     LC$VA_EVEN := 'none' ;    	   
  	Else   
  	  GT$Blocks(LN$Index).va_even := LC$VA_EVEN ; 
  	End if ;  
  End if ;  
  
  -- Keep the old behaviour if none of new tags are given --
  If LC$VA_ODD = 'none' And LC$VA_EVEN = 'none' And PC$VA_Name Is not Null Then
  	 LC$VA_ODD := PC$VA_Name ; 
  	 GT$Blocks(LN$Index).va_odd := PC$VA_Name ; 
  End if ;	

  LC$TextOffset := PKG_Look_And_Feel.Get_Tag_Value(PC$HeadClass,'text-align-offset','0') ;
  LC$TextAlign  := PKG_Look_And_Feel.Get_Tag_Value(PC$HeadClass,'text-align','left') ;
  LC$FontFamily := PKG_Look_And_Feel.Get_Tag_Value(PC$BodyClass,'font-family','Arial') ;
  LC$FontWeight := PKG_Look_And_Feel.Get_Tag_Value(PC$BodyClass,'font-weight','bold') ;
  LC$FontSize   := PKG_Look_And_Feel.Get_Tag_Value(PC$BodyClass,'font-size','12') ;
  LN$FrameWidth := PKG_Look_And_Feel.Get_Tag_Value(PC$BodyClass,'frame-width','1') ;

  -- ODD lines visual attribute --  
  LC$OddBack    := PKG_Look_And_Feel.Get_Tag_Value(PC$BodyClass,'odd-background-color','none') ;
  If LC$OddBack <> 'none' And LC$VA_ODD <> 'none' Then
  	 Set_VA_Property(LC$VA_ODD, BACKGROUND_COLOR, LC$OddBack);
  End if ;
  LC$OddFore    := PKG_Look_And_Feel.Get_Tag_Value(PC$BodyClass,'odd-foreground-color','none') ;
  If LC$OddFore <> 'none'  And LC$VA_ODD <> 'none' Then
  	 Set_VA_Property(LC$VA_ODD, FOREGROUND_COLOR, LC$OddFore);
  End if ;

  -- EVEN lines visual attribute --  
  LC$EvenBack    := PKG_Look_And_Feel.Get_Tag_Value(PC$BodyClass,'even-background-color','none') ;
  If LC$EvenBack <> 'none' And LC$VA_EVEN <> 'none' Then
  	 Set_VA_Property(LC$VA_EVEN, BACKGROUND_COLOR, LC$EvenBack);
  End if ;
  LC$EvenFore    := PKG_Look_And_Feel.Get_Tag_Value(PC$BodyClass,'even-foreground-color','none') ;
  If LC$EvenFore <> 'none'  And LC$VA_EVEN <> 'none' Then
  	 Set_VA_Property(LC$VA_EVEN, FOREGROUND_COLOR, LC$EvenFore);
  End if ;

  -- decalage with rounded borders --
  LC$Round  := PKG_Look_And_Feel.Get_Tag_Value(PC$HeadClass,'frame-rounded-border','0') ;
  If LC$Round > 25 Then LC$Round := '25'; End if ;
  If LC$Round > 4 Then
     LN$DecH := Round( LC$Round / 3) ;
  End if ;
  LC$Round  := PKG_Look_And_Feel.Get_Tag_Value(PC$BodyClass,'frame-rounded-border','0') ;
  If LC$Round > 4 Then
     LN$DecB := Round( LC$Round / 3) ;
  End if ;

  -- loop on each visible item --
  While LC$Item is not null and LC$Item <> 'ROWID' Loop
    LC$Item := LC$Block || '.' || LC$Item ;
    
    If Get_Item_Property( LC$Item, VISIBLE ) = 'TRUE' and
      Get_Item_Property( LC$Item, ITEM_CANVAS ) Is Not Null And
      Get_Item_Property( LC$Item, WIDTH ) > 0 And -- AJE : Don't decorate Zero-length items
      Get_Item_Property( LC$Item, ITEM_CANVAS ) = LC$Canvas and -- AJE : is required for blocks partly on main canvas and partly on spreadtable canvas
      Get_Item_Property( LC$Item, RECORDS_DISPLAYED) > 1 Then -- AJE : required for overflow areas showing single items in a multi-row block.
       LN$Indice := LN$Indice + 1 ;
       LN$W    := PKG_TOOLS.To_Pixel(Get_Item_Property( LC$Item, WIDTH )) ;
       LN$PosY := PKG_TOOLS.To_Pixel(Get_Item_Property( LC$Item, Y_POS )) ; 
       LN$XPos := PKG_TOOLS.To_Pixel(Get_Item_Property( LC$Item, X_POS )) ;

       If LN$XPos = 0 Then -- AJE create space for border
              LN$XPos := LN$FrameWidth ;
       End if;
       
       If LN$Indice = 1 Then 
       	  LN$SPoint := LN$XPos; 
       Else
       	 If LN$XPos < Texts(LN$Indice-1).pend + LN$FrameWidth + 1 Then
       	 	 LN$Dec := LN$Dec + LN$FrameWidth + 1 ;
       	 	 LN$XPos := Texts(LN$Indice-1).pend + LN$FrameWidth + 1 ;
       	 	 Set_Item_Property( LC$Item, X_POS, PKG_TOOLS.To_Current_Coord(LN$XPos) ) ;
           If LN$FrameWidth > 1 Then
       	     Set_Item_Property( LC$Item, WIDTH, PKG_TOOLS.To_Current_Coord(LN$W - (LN$FrameWidth - 1)) ) ;
           End if ;	       	 	 
       	 End if ;
       End if ;       
       
       If PKG_TOOLS.To_Pixel(Get_Item_Property( LC$Item, HEIGHT )) > LN$H Then
          LN$H := PKG_TOOLS.To_Pixel(Get_Item_Property( LC$Item, HEIGHT )) ;
       End if ;
       LN$Width := LN$Width + LN$W ;
       If LN$XPos < LN$PosX Then
          LN$PosX := LN$XPos ;
       End if ;

       If LN$XPos + LN$W > LN$EndX Then
          LN$EndX := LN$XPos + LN$W;
       End if ;

       Texts(LN$Indice).prompt := Nvl(Get_Item_Property( LC$Item, PROMPT_TEXT ),' ') ;
       Texts(LN$Indice).posX   := LN$XPos ;
       Texts(LN$Indice).posY   := LN$PosY - 10 ;
       Texts(LN$Indice).pend   := LN$XPos - 1 + LN$W ;
       Texts(LN$Indice).iname  := LC$Item ;

       GT$Blocks(LN$Index).items(LN$Indice) := LC$Item ;
       GT$Blocks(LN$Index).prompts(LN$Indice) := Texts(LN$Indice).prompt ;
       If Instr(Texts(LN$Indice).prompt, CHR(10)) > 0 then 
       	 LB$Double := true ;
       	 LN$NbLigs := 1 + ((LENGTH(Texts(LN$Indice).prompt) - LENGTH(REPLACE(Texts(LN$Indice).prompt,CHR(10),NULL)) ) / NVL(LENGTH(CHR(10)),1)) ;
       	 If LN$NbLigs > LN$MaxLigs Then LN$MaxLigs := LN$NbLigs ; End if ;
       End if ;	 
       -- erase the original prompt --
       Set_Item_Property( LC$Item, PROMPT_TEXT, ' ' ) ;              

    End if ;
    LC$Item := Get_Item_Property( LC$Item, NEXTITEM ) ;

  End loop ;
  
  -- Scrollbar --
  If PB$ScrollBar Then
     Set_Block_Property
     (
        PC$Block,
        BLOCKSCROLLBAR_X_POS,
        PKG_TOOLS.To_Current_Coord(LN$EndX + 8 + LN$FrameWidth)
     );  	
  End if ;
  LN$Width := LN$EndX - LN$PosX ; 
  LN$Height := LN$H * LN$Nbre ;
  LN$X1 := LN$PosX - 1 ;
  LN$Y1 := LN$PosY - 2 ;
  LN$X2 := LN$Width + 2 ;
  LN$Y2 := LN$Height + 2 ;

  -- Font settings --
  If LC$FontFamily <> 'none' Then
  	 For i In Texts.First .. Texts.Last Loop
  	   Set_Item_Property(Texts(i).iname, FONT_NAME, LC$FontFamily);
  	 End loop ;
  End if ;    
  If LC$FontSize <> 'none' Then
  	 For i In Texts.First .. Texts.Last Loop
  	   Set_Item_Property(Texts(i).iname, FONT_SIZE, LC$FontSize*100);
  	 End loop ;
  End if ;
	     
  ---------------------------
  --  set the block title  --
  ---------------------------
Declare
	  LC$Gradient   Varchar2(30);
	  LC$Font       Varchar2(30);
	  LC$Size       Varchar2(30);
	  LC$Weight     Varchar2(30);
	  LC$Transp     Varchar2(30);
	  LC$LTransp    Varchar2(30);
	  LC$STransp    Varchar2(30);
	  LC$Prop       Varchar2(512);
	  LC$LineWidth  Varchar2(30);
	  LC$Color      Varchar2(30);
	  LC$Align      Varchar2(30);  	 	  
	  LC$Cap        Varchar2(30);
	  LC$Join       Varchar2(30);
	  LC$Dash       Varchar2(30);
	  LC$Image      Varchar2(100);
	  LC$TextScale  Varchar2(100);
	  LN$Width1     Pls_Integer;
	  LN$X          Pls_Integer;
	  LN$Y          Pls_Integer;
	  LN$Dec        Pls_Integer;
 Begin
   -- Title --
   LC$Gradient := PKG_Look_And_Feel.Get_Tag_Value(PC$TitleClass,'text-gradient','none') ;
   If LC$Gradient = 'none' Then
		LC$Gradient := PKG_Look_And_Feel.Get_Tag_Value(PC$TitleClass,'text-color','none') ;
   Else
		Set_Custom_Property( PC$BeanName, 1, 'SET_GRADIENT_TEXT', LC$Gradient);
		LC$Gradient := 'G' ;
   End if ;
		
   LC$Transp       := PKG_Look_And_Feel.Get_Tag_Value(PC$TitleClass,'text-transparency','1') ;
   LC$LTransp      := PKG_Look_And_Feel.Get_Tag_Value(PC$TitleClass,'line-transparency','1') ;
   LC$STransp      := PKG_Look_And_Feel.Get_Tag_Value(PC$TitleClass,'shadow-line-transparency','1') ;       
   LC$Font         := PKG_Look_And_Feel.Get_Tag_Value(PC$TitleClass,'font-family','Arial') ;
   LC$Size         := PKG_Look_And_Feel.Get_Tag_Value(PC$TitleClass,'font-size','8') ;
   LC$Weight       := PKG_Look_And_Feel.Get_Tag_Value(PC$TitleClass,'font-weight','plain') ;
   LC$Round        := PKG_Look_And_Feel.Get_Tag_Value(PC$HeadClass,'frame-rounded-border','0') ;
   LC$OutLineColor := PKG_Look_And_Feel.Get_Tag_Value(PC$TitleClass,'text-outline-color','-') ;
   LC$OutWidth     := PKG_Look_And_Feel.Get_Tag_Value(PC$TitleClass,'text-outline-width','-') ;
   LC$Rotation     := PKG_Look_And_Feel.Get_Tag_Value(PC$TitleClass,'text-rotation','-') ;
   LC$Image        := PKG_Look_And_Feel.Get_Tag_Value(PC$TitleClass,'text-image','-') ;                            
   LC$TextMotif    := PKG_Look_And_Feel.Get_Tag_Value(PC$TitleClass,'text-motif','-') ;
   LC$TextScale    := PKG_Look_And_Feel.Get_Tag_Value(PC$TitleClass,'text-scale','-') ;

   -- alignment --
   LC$Align := PKG_Look_And_Feel.Get_Tag_Value(PC$TitleClass,'text-align','left') ;
	 LN$X  := LN$PosX + 2 ;
   Set_Custom_Property( PC$BeanName, 1, 'SET_TEXT', 
						Replace(PC$Title,',',';') || ',' || 
						LC$Font || ',' || 
						LC$Weight || ',' || 
						LC$Size
					  );
   LN$Width1 := Get_Custom_Property( PC$BeanName, 1, 'GET_TEXT_WIDTH');
   LN$HeadHeight := 4 + Get_Custom_Property( PC$BeanName, 1, 'GET_TEXT_HEIGHT');

   LN$Y  := LN$PosY - LN$HeadHeight - 10 + PKG_Look_And_Feel.Get_Tag_Value(PC$TitleClass,'title-head-offset','0') ;
   LN$Y := LN$Y - LN$DecH - LN$DecB ;

   If LN$MaxLigs > 1 Then 
		LN$Y := LN$Y - ((LN$HeadHeight-8)*(LN$MaxLigs-1)) ;
   End if ; 	   
   
   If PC$TitleClass is not Null and PC$Title is not Null Then
	
	   If lower(LC$Align) = 'center' Then
		  LN$X := LN$PosX + ( LN$Width / 2 ) - ( LN$Width1 / 2 ) ;
	   ElsIf lower(LC$Align) = 'right' Then
		  LN$X := LN$PosX + LN$Width -  LN$Width1 - 8 ;
	   End if ;	
	   If Lower(LC$TextScale) = 'box' Then
		  LC$TextScale := LC$TextScale || '=' 
		  || (LN$Width-8) || '-' 
		  || Get_Custom_Property( PC$BeanName, 1, 'GET_TEXT_HEIGHT');
	   ElsIf Lower(LC$TextScale) = 'justify' Then
		  LC$TextScale := LC$TextScale || '=' || LN$Width ;
	   End if ;	  	   
	   LC$Prop := '1,' 
		  || PC$Title || ',' 
		  || To_Char(LN$X) || ','
		  || To_Char(LN$Y) || ','
		  || LC$Font || ','
		  || LC$Weight || ','          
		  || LC$Size || ','
		  || LC$Gradient || ','
		  || LC$Transp || ','
		  || LC$OutLineColor || ','
		  || LC$OutWidth || ','
		  || LC$Rotation || ','
		  || LC$Image || ','
		  || LC$TextMotif || ','          
		  || LC$TextScale ;

	   Set_Custom_Property( PC$BeanName, 1, 'ADD_TEXT', LC$Prop ) ;
	   
	   -- Shadow line --
	   LN$X  := LN$PosX + 2 ;
	   LC$Cap  := PKG_Look_And_Feel.Get_Tag_Value(PC$TitleClass,'line-cap','SQUARE') ;
	   LC$Join := PKG_Look_And_Feel.Get_Tag_Value(PC$TitleClass,'line-join','MITER') ;
	   LC$Dash := PKG_Look_And_Feel.Get_Tag_Value(PC$TitleClass,'line-dash','0,0') ;
	   LC$LineWidth := PKG_Look_And_Feel.Get_Tag_Value(PC$TitleClass,'line-width','1') ;
	   LN$Dec := LC$LineWidth/2 ;
	   If LN$Dec < 1 Then LN$Dec := 1 ; End if ;
	   LC$Color     := PKG_Look_And_Feel.Get_Tag_Value(PC$TitleClass,'shadow-line-color','none') ;
	   If LC$Color <> 'none' Then
		  LN$Y  := LN$PosY - LN$HeadHeight + PKG_Look_And_Feel.Get_Tag_Value(PC$TitleClass,'title-head-offset','0') ;
		  If LN$MaxLigs > 1 Then
				LN$Y := LN$Y - ((LN$HeadHeight-8)*(LN$MaxLigs-1)) ;
		  End if ;	
		  LC$Prop := '1,'
			 || To_Char(LN$X+LN$Dec) || ','
			 || To_Char(LN$Y-LN$DecH-LN$DecB+LN$Dec) || ','
			 || To_Char(LN$X+LN$Width-8) || ','
			 || To_Char(LN$Y-LN$DecH-LN$DecB+LN$Dec) || ','
			 || LC$LineWidth || ','
			 || LC$Color     || ','
			 || LC$STransp   || ','
			 || LC$Cap       || ','
			 || LC$Join      || ','
			 || LC$Dash  ;
		  Set_Custom_Property( PC$BeanName, 1, 'ADD_LINE', LC$Prop ) ;
	   End if ;
	   
	   -- Main line --
	   LC$Color     := PKG_Look_And_Feel.Get_Tag_Value(PC$TitleClass,'line-color','none') ;
	   If LC$Color <> 'none' Then
		  LN$Y  := LN$PosY - LN$HeadHeight + PKG_Look_And_Feel.Get_Tag_Value(PC$TitleClass,'title-head-offset','0') ;
		  If LN$MaxLigs > 1 Then
			LN$Y := LN$Y - ((LN$HeadHeight-8)*(LN$MaxLigs-1)) ;
		  End if ;	  	   	  
		  LC$Prop := '1,'
			 || To_Char(LN$X) || ','
			 || To_Char(LN$Y-LN$DecH-LN$DecB) || ','
			 || To_Char(LN$X+LN$Width-8) || ','
			 || To_Char(LN$Y-LN$DecH-LN$DecB) || ','
			 || LC$LineWidth || ','
			 || LC$Color     || ','
			 || LC$LTransp   || ','
			 || LC$Cap       || ','
			 || LC$Join      || ','
			 || LC$Dash  ;
		  Set_Custom_Property( PC$BeanName, 1, 'ADD_LINE', LC$Prop ) ;
	   End if ;  
	End if ;
 End ;
  
  ----------------------------
  --  set the table header  --
  ----------------------------
  LN$HX1 := LN$PosX - 1 ;
  LN$HY1 := LN$PosY - LN$HeadHeight - 5;
  LN$HX2 := LN$Width + 2 ;
  LN$HY2 := LN$HeadHeight + 2;
  LC$ShadeColor   := PKG_Look_And_Feel.Get_Tag_Value(PC$HeadClass,'shade-color','-')  ; 
  LC$Gradient     := PKG_Look_And_Feel.Get_Tag_Value(PC$HeadClass,'frame-gradient','-,-') ;
  LC$Direction    := PKG_Look_And_Feel.Get_Tag_Value(PC$HeadClass,'frame-gradient-direction','lefttoright') ;
  LC$Round        := PKG_Look_And_Feel.Get_Tag_Value(PC$HeadClass,'frame-rounded-border','0') ;
  LC$OutLineColor := PKG_Look_And_Feel.Get_Tag_Value(PC$HeadClass,'text-outline-color','-') ;
  LC$OutWidth     := PKG_Look_And_Feel.Get_Tag_Value(PC$HeadClass,'text-outline-width','-') ;
  LC$Rotation     := PKG_Look_And_Feel.Get_Tag_Value(PC$HeadClass,'text-rotation','-') ;
  LC$TextMotif    := PKG_Look_And_Feel.Get_Tag_Value(PC$HeadClass,'text-motif','-') ;
  LC$FrameMotif   := PKG_Look_And_Feel.Get_Tag_Value(PC$HeadClass,'frame-motif','-') ;
  If LN$MaxLigs > 1 Then 
  	if PC$Title is Null then
	  	LN$HY1 := LN$HY1 - ((LN$HeadHeight-8)*LN$MaxLigs);
	  	LN$HY2 := LN$HY2 + ((LN$HeadHeight-8)*LN$MaxLigs); 
  	else
	  	LN$HY1 := LN$HY1 - ((LN$HeadHeight-8)*(LN$MaxLigs-1));
	  	LN$HY2 := LN$HY2 + ((LN$HeadHeight-8)*(LN$MaxLigs-1));   		
  	end if;	
  End if ;  	   
  
	if PC$Title is Null then
	  LN$HY1 := LN$HY1 - (4*LN$MaxLigs) ;
	  LN$HY2 := LN$HY2 + (4*LN$MaxLigs) ;
	end if;    
 
  LC$Prop := '1,' 
     || To_Char(LN$HX1-LN$DecH) || ',' || To_char(LN$HY1-LN$DecH-LN$DecB) || ',' 
     || To_Char(LN$HX2+(LN$DecH*2)) || ',' || To_Char(LN$HY2+(LN$DecH*2)-LN$DecB) || ','   
     || PKG_Look_And_Feel.Get_Tag_Value(PC$HeadClass,'frame-width','1') || ',' 
     || PKG_Look_And_Feel.Get_Tag_Value(PC$HeadClass,'frame-color','-') || ',' 
     || PKG_Look_And_Feel.Get_Tag_Value(PC$HeadClass,'transparency','1') || ',' 
     || PKG_Look_And_Feel.Get_Tag_Value(PC$HeadClass,'inside-color','-') || ','
     || LC$ShadeColor || ','  
     || LC$Gradient || ','       
     || LC$Direction || ','             	
     || LC$Round ;
  If LC$FrameMotif <> '-' Then
  	 LC$Prop := LC$Prop || ',' || LC$FrameMotif ;
  End if ;	                           

  Set_Custom_Property( PC$BeanName, 1, 'ADD_RECT', LC$Prop ) ;
  ---------------------------
  --  set the table frame  --
  ---------------------------
  LC$ShadeColor := PKG_Look_And_Feel.Get_Tag_Value(PC$BodyClass,'shade-color','-')  ; 
  LC$Gradient   := PKG_Look_And_Feel.Get_Tag_Value(PC$BodyClass,'frame-gradient','-,-') ;
  LC$Direction  := PKG_Look_And_Feel.Get_Tag_Value(PC$BodyClass,'frame-gradient-direction','lefttoright') ;
  LC$Round      := PKG_Look_And_Feel.Get_Tag_Value(PC$BodyClass,'frame-rounded-border','0') ;

  LC$Prop := '2,' 
     || To_Char(LN$X1-LN$DecB) || ',' || To_char(LN$Y1-LN$DecB) || ',' 
     || To_Char(LN$X2+(LN$DecB*2)) || ',' || To_Char(LN$Y2+(LN$DecB*2)) || ','  
     || PKG_Look_And_Feel.Get_Tag_Value(PC$BodyClass,'frame-width','1') || ',' 
     || PKG_Look_And_Feel.Get_Tag_Value(PC$BodyClass,'frame-color','-') || ',' 
     || PKG_Look_And_Feel.Get_Tag_Value(PC$BodyClass,'transparency','1')|| ','
     || PKG_Look_And_Feel.Get_Tag_Value(PC$BodyClass,'inside-color','-') || ','
     || LC$ShadeColor || ','  
     || LC$Gradient || ','       
     || LC$Direction || ','             	
     || LC$Round ;                       

  Set_Custom_Property( PC$BeanName, 1, 'ADD_RECT', LC$Prop ) ;
  -----------------------------
  --  set the header titles  --
  -----------------------------
  LC$Gradient   := PKG_Look_And_Feel.Get_Tag_Value(PC$HeadClass,'font-gradient','none') ;
  If LC$Gradient <> 'none' Then
     Set_Custom_Property( PC$BeanName, 1, 'SET_GRADIENT_TEXT', LC$Gradient );
     LC$Gradient := 'G' ;
  Else
  	 LC$Gradient := PKG_Look_And_Feel.Get_Tag_Value(PC$HeadClass,'font-color','r0g0b0') ;
  End if ;
  
  LC$FontFamily   := PKG_Look_And_Feel.Get_Tag_Value(PC$HeadClass,'font-family','Arial') ;
  LC$FontWeight   := PKG_Look_And_Feel.Get_Tag_Value(PC$HeadClass,'font-weight','plain') ;
  LC$FontSize     := PKG_Look_And_Feel.Get_Tag_Value(PC$HeadClass,'font-size','8') ;
  LC$FrameColor   := PKG_Look_And_Feel.Get_Tag_Value(PC$HeadClass,'frame-color','r0g0b0') ;
  LC$Transparency := PKG_Look_And_Feel.Get_Tag_Value(PC$HeadClass,'transparency','1') ;
  
	------------------------------------------------------------
	--   Draw label for header *** @author : BUI Thanh Hoang  --
	------------------------------------------------------------
	LC$CanSortBlock := PKG_Look_And_Feel.Get_Tag_Value(PC$HeadClass,'sort-allowed','false') ;
	If LB$SortBlock Is Null Then
		 If Lower(LC$CanSortBlock) = 'true' Then 
		 	  LB$SortBlock := true ; 
		 Else
		 	  LB$SortBlock := false ; 
		 End if ;
	End if ;	
	-- special given icon file names --  	 
	LC$SortIconNext := PKG_Look_And_Feel.Get_Tag_Value(PC$HeadClass,'sort-icon-next','-') ;
	LC$SortIconPrev := PKG_Look_And_Feel.Get_Tag_Value(PC$HeadClass,'sort-icon-prev','-') ;
	If LC$SortIconNext != '-' And LC$SortIconPrev != '-' Then
		 Set_Custom_Property( PC$BeanName, 1, 'IMG_HEADER_ICONS', LC$SortIconNext || ',' || LC$SortIconPrev);
	End if ;	  
  
  For i In Texts.First .. Texts.Last loop

     Set_Custom_Property( PC$BeanName, 1, 'SET_TEXT', 
                       Replace(Texts(i).prompt,',',';') || ',' || 
                       LC$FontFamily || ',' || 
                       LC$FontWeight || ',' || 
                       LC$FontSize
  	   	             );
     LN$TmpVal := Get_Custom_Property( PC$BeanName, 1, 'GET_TEXT_WIDTH');
     LN$TextXPos := Texts(i).posX + LC$TextOffset ;
     LN$NbLigs := 1 + ((LENGTH(Texts(i).prompt) - LENGTH(REPLACE(Texts(i).prompt,CHR(10),NULL)) ) / NVL(LENGTH(CHR(10)),1)) ;
     If Lower(LC$TextAlign) = 'center' Then
  	    LN$TextXPos := Round(Texts(i).posX + ((Texts(i).pend - Texts(i).posX) / 2)
  	                 - (LN$TmpVal / 2 )) ;
  	    LN$End := To_Char(Texts(i).posX + LC$TextOffset + Texts(i).pend) ;             
     ElsIf Lower(LC$TextAlign) = 'right' Then
  	    LN$TextXPos := Round(Texts(i).pend - LN$TmpVal - LC$TextOffset) ;
  	    LN$End := To_Char(Texts(i).posX - LC$TextOffset + Texts(i).pend) ;             
     End if ;
  
  	 If Lower(LC$TextAlign) != 'left' And LN$NbLigs > 1 Then
  	   LC$Prop := To_Char(i) || ',' || Texts(i).iname || '^' || Texts(i).prompt || ','
  	         || LC$TextAlign || ','
  	         || To_Char(Texts(i).posX) || ',' || LN$End || ','
  	         || To_Char(Texts(i).posY-LN$DecB) || ','
  	         || LC$FontFamily || ','
  	         || LC$FontWeight || ','
  	         || LC$FontSize || ','
 	 	         || LC$Gradient || ','
             || LC$Transparency ; --|| ','
             /*
             || LC$OutLineColor || ','
             || LC$OutWidth || ','
             || LC$Rotation || ','
             || LC$TextMotif ; 	 	           	 	
             */
       Set_Custom_Property( PC$BeanName, 1, 'ADD_TEXT2', LC$Prop ) ;      
  	 Else	
  	   LC$Prop := To_Char(i) || ',' || Texts(i).iname || '^' || Texts(i).prompt || ','
  	         || To_Char(LN$TextXPos) || ',' || To_Char(Texts(i).posY-LN$DecB) || ','
  	         || LC$FontFamily || ','
  	         || LC$FontWeight || ','
  	         || LC$FontSize || ','
 	 	         || LC$Gradient || ','
             || LC$Transparency || ','
             || LC$OutLineColor || ','
             || LC$OutWidth || ','
             || LC$Rotation || ','
             || LC$TextMotif ; 	 	         
       Set_Custom_Property( PC$BeanName, 1, 'ADD_TEXT', LC$Prop ) ;
     End if ;        

  	 ------------------------------------------------------------
  	 --   Draw label for header *** @author : BUI Thanh Hoang  --
  	 ------------------------------------------------------------
  	 -- block can be sorted ? --
  	 If LB$SortBlock Then
	  	 Declare
	  	 		hPosX					Pls_Integer;
	  	 	  hPosY					Pls_Integer;
	  	 	  hWidth				Pls_Integer;
	  	 	  hHeight				Pls_Integer;
	  	 	  hCol					Varchar2(100);
	  	 Begin	
		  	 If   Get_Item_Property(Texts(i).iname, ITEM_TYPE) <> 'BUTTON'
		  	 And 	Get_Item_Property(Texts(i).iname, COLUMN_NAME) Is Not Null Then
			  	 hPosX		:= Texts(i).posX;
			  	 hPosY		:= LN$HY1-LN$DecH-LN$DecB;
			  	 hWidth 	:= Texts(i).pend - Texts(i).posX;
			  	 hHeight	:= LN$HY2+(LN$DecH*2)-LN$DecB;
			  	 hCol			:= Texts(i).iname;
			  	 
			  	 LC$Prop 	:= To_Char(hPosX) || ',' || To_Char(hPosY) || ',' || To_Char(hWidth) || ',' 
			  	 					|| To_Char(hHeight) || ',' || hCol || ',' || PC$Block;
			  	  
			  	 set_custom_property( PC$BeanName, 1, 'IMG_HEADER', LC$Prop);
		  	 End if ;
	  	 End;
  	 End if ;
  	 ------------------------------------------------------
  	   	 
  	 If i < Texts.Last Then
        LC$Prop := '1,' 
                || To_Char(Texts(i).pend+1) || ','
                || To_Char(LN$HY1-(LN$DecB*2)) || ','
                || To_Char(Texts(i).pend+1) || ','
                || To_Char(LN$HY1 + LN$HY2 + LN$Y2+LN$DecB) || ','
                || LN$FrameWidth || ',' || LC$FrameColor || ',1' ;
        Set_Custom_Property( PC$BeanName, 1, 'ADD_LINE', LC$Prop ) ;  	 	
  	 End if ;
  End loop ;
  Synchronize ;

  	 --------------------------------------------------
  	 --  Current Record Visual attribute properties  --
  	 --------------------------------------------------
  	 -- VA name --	 
  	 VA_Name    := PKG_Look_And_Feel.Get_Tag_Value(PC$BodyClass,'va-name','none')  ;
  	 -- Does the Visual Attribute exist ? --
  	 If VA_Name <> 'none' Then
  	   id_va := Find_VA(VA_NAME);
  	   If ID_NULL(id_va) Then
  		   Set_Custom_Property(PC$BeanName, 1,'DISPLAY_MESSAGE',
  		     '0,0,400,180,/LAFhelp.gif,L&F Current Record Attribute,Visual Attribute Name:' || VA_Name || ' does not exist in the Forms module');  	   
  	   Else
  	     -- read other parameters --
  	     VA_Font    := PKG_Look_And_Feel.Get_Tag_Value(PC$BodyClass,'va-font-family','-')  ;  
  	     VA_Size    := PKG_Look_And_Feel.Get_Tag_Value(PC$BodyClass,'va-font-size','-')  ;  
  	     VA_Weight  := PKG_Look_And_Feel.Get_Tag_Value(PC$BodyClass,'va-font-weight','-')  ;
  	     VA_Style   := PKG_Look_And_Feel.Get_Tag_Value(PC$BodyClass,'va-font-style','-')  ;    
  	     VA_BackCol := PKG_Look_And_Feel.Get_Tag_Value(PC$BodyClass,'va-background','-')  ;  
  	     VA_ForeCol := PKG_Look_And_Feel.Get_Tag_Value(PC$BodyClass,'va-foreground','-')  ;  
  	   	 -- Store parameters for that block --
  	   	 GT$Blocks(LN$Index).Cur_Attr.name    := VA_Name ;
  	   	 GT$Blocks(LN$Index).Cur_Attr.font    := VA_Font ;
  	   	 If VA_Size <> '-' Then
  	   	   Begin
  	   	    GT$Blocks(LN$Index).Cur_Attr.fsize   := To_Number(VA_Size) ;
  	   	   Exception
  	   	 	    When others Then
  		        GT$Blocks(LN$Index).Cur_Attr.fsize   := -1 ;
  		        Set_Custom_Property(PC$BeanName, 1,'DISPLAY_MESSAGE',
  		         '0,0,400,180,/LAFhelp.gif,L&F Current Record Attribute,Visual Attribute, bad size given:' || VA_Size);
  	   	   End;	
  	   End if ;
  	   	 If VA_Style <> '-' Then
  	   	   If    Upper(VA_Style) = 'PLAIN' Then GT$Blocks(LN$Index).Cur_Attr.style := FONT_PLAIN ;
  	   	   ElsIf Upper(VA_Style) = 'ITALIC' Then GT$Blocks(LN$Index).Cur_Attr.style := FONT_ITALIC ;
  	   	   ElsIf Upper(VA_Style) = 'UNDERLINE' Then GT$Blocks(LN$Index).Cur_Attr.style := FONT_UNDERLINE ;	
  	   	   ElsIf Upper(VA_Style) = 'OUTLINE' Then GT$Blocks(LN$Index).Cur_Attr.style := FONT_OUTLINE ;
  	   	   ElsIf Upper(VA_Style) = 'ITALIC' Then GT$Blocks(LN$Index).Cur_Attr.style := FONT_ITALIC ;		
  	   	   Else GT$Blocks(LN$Index).Cur_Attr.style   := -1 ;
  	   	   End if ;	
  	   	 End if ;
  	   	 If VA_Weight <> '-' Then
  	   	   If    Upper(VA_Weight) = 'MEDIUM' Then GT$Blocks(LN$Index).Cur_Attr.weight := FONT_MEDIUM ;
  	   	   ElsIf Upper(VA_Weight) = 'LIGHT' Then GT$Blocks(LN$Index).Cur_Attr.weight := FONT_LIGHT ;
  	   	   ElsIf Upper(VA_Weight) = 'BOLD' Then GT$Blocks(LN$Index).Cur_Attr.weight := FONT_BOLD ;
  	   	   ElsIf Upper(VA_Weight) = 'ULTRABOLD' Then GT$Blocks(LN$Index).Cur_Attr.weight := FONT_ULTRABOLD ;  	   	   	
  	   	   Else GT$Blocks(LN$Index).Cur_Attr.weight   := -1 ;
  	   	   End if ;	
  	   	 End if ;
  	   	 GT$Blocks(LN$Index).Cur_Attr.BackCol := VA_BackCol ;
  	   	 GT$Blocks(LN$Index).Cur_Attr.ForeCol := VA_ForeCol ;
  		 End if ;   
  	/*
  	Else
  		Set_Custom_Property(PC$BeanName, 1,'DISPLAY_MESSAGE',
  		    '0,0,400,180,/LAFhelp.gif,L&F Current Record Attribute,Visual Attribute Name not given');
  	*/	    
  	End if ;	

  
  End Paint_Block ;
  
  ---------------------------------------------------------------------------------
  
  -------------------------------
  --  Set the GUI  properties  --
  -------------------------------  
  Procedure  Set_GUI_Properties
  ( 
    PC$Class       IN Varchar2,
    PC$BeanName    IN Varchar2
  )
  Is
    LC$Value     Varchar2(4000);
    LC$Element   Varchar2(30);
    LN$I         Pls_Integer := 1 ;
    LB$Elements  Boolean := false ;
    LB$Menu      Boolean := false ;
    LB$Window    Boolean := false ;
    LB$Status    Boolean := false ;
    LB$Scheme    Boolean := false ;
    LC$Scheme    Varchar2(1000);
    LN$Cpt       Pls_Integer := 1;    
    LN$Items     Pls_Integer := 0;
    TabProps     TYP_TAB_STRINGS ;    
  Begin
  	 PKG_TABLE.Set_Bean_Name(PC$BeanName);
  	 
  	 -- css file open ? --
  	 If Not GB$Css_Open Then Return; End if ;
  	 -- tag section exists ? --
  	 If Not Is_Tag_Exists(PC$Class) Then 
        Set_Custom_Property(PC$BeanName, 1,'DISPLAY_MESSAGE',
  	      '0,0,400,180,/LAFhelp.gif,L&F Opening CSS file,' || PC$Class || ' : CSS section not found');
  	 End if ;	 
  	 ---------------------------
  	 --  Read the properties  --
  	 ---------------------------
  	 -- Scheme --
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'scheme','none')  ;
  	 If LC$Value <> 'none' Then
  	 	  Set_Custom_Property( PC$BeanName, 1, 'SET_SCHEME', LC$Value ) ;
  	 End if ;  	 
  	 -- Scheme colors --
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'scheme-current-color','none')  ;
  	 If LC$Value <> 'none' Then
  	 	  If LC$Scheme Is Not Null Then LC$Scheme := LC$Scheme || ',' ; End if ;
  	 	  LC$Scheme := LC$Scheme || 'color=' || LC$Value ;
  	 	  LB$Scheme := true ;
  	 End if ;
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'scheme-current-color-light','none')  ;
  	 If LC$Value <> 'none' Then
  	 	  If LC$Scheme Is Not Null Then LC$Scheme := LC$Scheme || ',' ; End if ;
  	 	  LC$Scheme := LC$Scheme || 'color_light=' || LC$Value ;
  	 	  LB$Scheme := true ;
  	 End if ;  	   	 
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'scheme-focus-color','none')  ;
  	 If LC$Value <> 'none' Then
  	 	  If LC$Scheme Is Not Null Then LC$Scheme := LC$Scheme || ',' ; End if ;
  	 	  LC$Scheme := LC$Scheme || 'focus=' || LC$Value ;
  	 	  LB$Scheme := true ;
  	 End if ;  	   	 
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'scheme-select-color','none')  ;
  	 If LC$Value <> 'none' Then
  	 	  If LC$Scheme Is Not Null Then LC$Scheme := LC$Scheme || ',' ; End if ;
  	 	  LC$Scheme := LC$Scheme || 'select=' || LC$Value ;
  	 	  LB$Scheme := true ;
  	 End if ;  	   	 
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'scheme-disable-color','none')  ;
  	 If LC$Value <> 'none' Then
  	 	  If LC$Scheme Is Not Null Then LC$Scheme := LC$Scheme || ',' ; End if ;
  	 	  LC$Scheme := LC$Scheme || 'disable=' || LC$Value ;
  	 	  LB$Scheme := true ;
  	 End if ;
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'scheme-listselection-color','none')  ;
  	 If LC$Value <> 'none' Then
  	 	  If LC$Scheme Is Not Null Then LC$Scheme := LC$Scheme || ',' ; End if ;
  	 	  LC$Scheme := LC$Scheme || 'listselect=' || LC$Value ;
  	 	  LB$Scheme := true ;
  	 End if ;
  	 If LB$Scheme Then
  	 	  Set_Custom_Property( PC$BeanName, 1, 'SET_SCHEME_COLORS', LC$Scheme ) ;
  	 End if ;	
  	 -- Swing Lists ? --
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'enhanced-lists','none')  ; 
  	 If LC$Value <> 'none' Then
  	 	  Set_Custom_Property( PC$BeanName, 1, 'SET_ENHANCED_POPLISTS', LC$Value ) ;
  	 End if ;  	 
  	 -- Multi selection ? --
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'tlist-multi-selection','none')  ; 
  	 If LC$Value <> 'none' Then
  	 	  Set_Custom_Property( PC$BeanName, 1, 'SET_MULTI_SELECTION', LC$Value ) ;
  	 End if ;  	
  	 -- buttons focus mark --
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'button-focus-mark','none')  ; 
  	 If LC$Value <> 'none' Then
  	 	  Set_Custom_Property( PC$BeanName, 1, 'SET_BUTTONS_FOCUS_MARK', LC$Value ) ;
  	 End if ;  	  	 
  	 -- TList orientation --
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'tlist-orientation','none')  ; 
  	 If LC$Value <> 'none' Then
  	 	  Set_Custom_Property( PC$BeanName, 1, 'SET_LIST_ORIENTATION', LC$Value ) ;
  	 End if ;  	  	
  	 -- TList sort --
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'tlist-sorted','none')  ; 
  	 If LC$Value <> 'none' Then
  	 	  Set_Custom_Property( PC$BeanName, 1, 'SET_SORTED_LIST', LC$Value ) ;
  	 End if ;  	  	   	 
  	 -- poplist time key selection --
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'poplist-settimekeyselect','none')  ;  
  	 If LC$Value <> 'none' Then
  	 	  Set_Custom_Property( PC$BeanName, 1, 'SET_TIME_KEY_SELECT', LC$Value ) ;
  	 End if ;
  	 -- scheme uses light colors --
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'light-color-scheme','none')  ;  
  	 If Upper(LC$Value) = 'TRUE' Then
  	 	  Set_Custom_Property( PC$BeanName, 1, 'SET_APPLY_SCHEME', 'light,true' ) ;
  	 End if ;
  	 -- menu-use-scheme color --
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'menu-use-scheme','none')  ;  
  	 If Upper(LC$Value) = 'TRUE' Then
  	 	  LB$Menu := true ;
  	 	  Set_Custom_Property( PC$BeanName, 1, 'SET_APPLY_SCHEME', 'menu,true' ) ;
  	 End if ;
  	 -- window-use-scheme color --
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'window-use-scheme','none')  ;  
  	 If Upper(LC$Value) = 'TRUE' Then
  	 	  LB$Window := true ;
  	 	  Set_Custom_Property( PC$BeanName, 1, 'SET_APPLY_SCHEME', 'window,true' ) ;
  	 End if ;  	 
  	 -- status-use-scheme color --
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'status-use-scheme','none')  ;  
  	 If Upper(LC$Value) = 'TRUE' Then
  	 	  LB$Status := true ;
  	 	  Set_Custom_Property( PC$BeanName, 1, 'SET_APPLY_SCHEME', 'status,true' ) ;
  	 End if ;
  	 -- dialog-use-scheme color --
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'dialog-use-scheme','none')  ;  
  	 If Upper(LC$Value) = 'TRUE' Then
  	 	  Set_Custom_Property( PC$BeanName, 1, 'SET_APPLY_SCHEME', 'dialog,true' ) ;
  	 End if ;
  	 -- dialog font --
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'dialog-font','none')  ;  
  	 If LC$Value <> 'none' Then
  	 	  Set_Custom_Property( PC$BeanName, 1, 'SET_DIALOG_PROPS', LC$Value ) ;
  	 End if ;  	 
  	 -- item focus background --
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'item-focus-background','none')  ;  
  	 If LC$Value <> 'none' Then
  	 	  Set_Custom_Property( PC$BeanName, 1, 'SET_FOCUS_BACKGROUND', LC$Value ) ;
  	 End if ;  	 
  	 -- CheckBox background color --
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'checkbox-background-color','none')  ; 
  	 If LC$Value <> 'none' Then
  	 	  Set_Custom_Property( PC$BeanName, 1, 'SET_CBOX_BG_COLOR', LC$Value ) ;
  	 End if ;
  	 -- Texture Paints --
  	 TabProps := PKG_Look_And_Feel.Get_Tag_All_Values(PC$Class,'texture-paint') ;
  	 If TabProps.Count() > 0 Then
  	 	  LN$Cpt := 1 ;
  	 	  For i IN TabProps.First .. TabProps.Last Loop  	 
  	 	     Set_Custom_Property( PC$BeanName, 1, 'ADD_TEXTUREPAINT', TabProps(i) ) ;
  	 	  End Loop;	 
  	 End if ;  	 
  	 
  	 -------------------------
  	 --  Frames properties  --
  	 -------------------------
  	 -- frame-use-scheme color --
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'frame-use-scheme','none')  ;  
  	 If Upper(LC$Value)= 'TRUE' Then
  	 	  Set_Custom_Property( PC$BeanName, 1, 'SET_APPLY_SCHEME', 'frame,'|| LC$Value ) ;
  	 End if ;  	   	 
  	 -- frame font --
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'frame-font','none')  ;  
  	 If LC$Value <> 'none' Then
  	 	  Set_Custom_Property( PC$BeanName, 1, 'SET_FRAME_PROPERTY', 'font:' ||LC$Value ) ;
  	 End if ;  	   	 
  	 -- frame colors --
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'frame-colors','none')  ;  
  	 If LC$Value <> 'none' Then
  	 	  Set_Custom_Property( PC$BeanName, 1, 'SET_FRAME_PROPERTY', 'colors:' ||LC$Value ) ;
  	 End if ;
  	 -- title colors --
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'frame-title-colors','none')  ;  
  	 If LC$Value <> 'none' Then
  	 	  Set_Custom_Property( PC$BeanName, 1, 'SET_FRAME_PROPERTY', 'title-colors:' ||LC$Value ) ;
  	 End if ;  	   	 
  	 -- title position --
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'frame-title-position','none')  ;  
  	 If LC$Value <> 'none' Then
  	 	  Set_Custom_Property( PC$BeanName, 1, 'SET_FRAME_PROPERTY', 'position:' ||LC$Value ) ;
  	 End if ; 
  	 -- frame background colors --
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'frame-background-colors','none')  ;  
  	 If LC$Value <> 'none' Then
  	 	  Set_Custom_Property( PC$BeanName, 1, 'SET_FRAME_PROPERTY', 'background:' ||LC$Value ) ;
  	 End if ;
  	 -- frame opaque --
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'frame-opaque','none')  ;  
  	 If LC$Value <> 'none' Then
  	 	  Set_Custom_Property( PC$BeanName, 1, 'SET_FRAME_PROPERTY', 'opaque:' ||LC$Value ) ;
  	 End if ;  	 
  	 -- frame gradient orientation --
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'frame-gradient-orientation','none')  ;  
  	 If LC$Value <> 'none' Then
  	 	  Set_Custom_Property( PC$BeanName, 1, 'SET_FRAME_PROPERTY', 'gradient-orientation:' ||LC$Value ) ;
  	 End if ;  	 
  	 -- frame round border --
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'frame-round-border','none')  ;  
  	 If LC$Value <> 'none' Then
  	 	  Set_Custom_Property( PC$BeanName, 1, 'SET_FRAME_PROPERTY', 'round:' ||LC$Value ) ;
  	 End if ;
  	 
  	 ----------------------
  	 --  Tab properties  --
  	 ----------------------
  	 -- tab-use-scheme color --
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'tab-use-scheme','none')  ;  
  	 If LC$Value <> 'none' Then
  	 	  Set_Custom_Property( PC$BeanName, 1, 'SET_APPLY_SCHEME', 'tab,' || LC$Value ) ;
  	 End if ;
  	 -- tab colors --
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'tab-colors','none')  ;  
  	 If LC$Value <> 'none' Then
  	 	  Set_Custom_Property( PC$BeanName, 1, 'SET_TAB_COLORS', LC$Value ) ;
  	 End if ;  	 
  	 -- selected tab colors --
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'tab-selected-colors','none')  ;  
  	 If LC$Value <> 'none' Then
  	 	  Set_Custom_Property( PC$BeanName, 1, 'SET_TAB_SELECTED_COLORS', LC$Value ) ;
  	 End if ;  	 
  	 -- tab font --
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'tab-font','none')  ;  
  	 If LC$Value <> 'none' Then
  	 	  Set_Custom_Property( PC$BeanName, 1, 'SET_TAB_FONT', LC$Value ) ;
  	 End if ;  	  
  	 
  	 --------------------------------
  	 --  multi-selection since 1.7 --
  	 --------------------------------  	 
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'multi-select','none')  ;  
  	 If LC$Value <> 'none' Then
  	 	  PKG_Multiselect.set_multiselect_properties( LC$Value ) ;
  	 End if ;
  	 LC$Value := PKG_Look_And_Feel.Get_Tag_Value(PC$Class,'multi-select-modifier','-')  ;  
  	 PKG_Multiselect.set_modifier( LC$Value ) ;
  	 
  	 ------------------------
  	 -- element decoration --
  	 ------------------------
  	 tab_items.delete ;
  
     TabProps := PKG_Look_And_Feel.Get_Tag_All_Values(PC$Class,'element') ;
  	 If TabProps.Count() > 0 Then
  	 	 For i IN TabProps.First .. TabProps.Last Loop
			 	   If (TabProps(i) Like 'menu%'   And LB$Menu )
			 	   Or (TabProps(i) Like 'window%' And LB$Window )
			 	   Or (TabProps(i) Like 'status%' And LB$Status ) Then
			 	      Null ;
			 	   Else    
			 	     LB$Elements := true ;
			 	     LN$Items := LN$Items + 1 ;
			 	     declare
			 	     	 typ  varchar2(50);
			 	     	 tr   TYP_REC_ITEMS_PROPS ;
			 	     	 tri  TYP_REC_ITEMS ;
			 	     begin
			 	     	 tr.font    := Nvl(split(TabProps(i),2),'-');
			 	     	 tr.fweight := Nvl(split(TabProps(i),3),'-');
			 	     	 tr.fsize   := Nvl(split(TabProps(i),4),'-');
			 	     	 tr.fgColor := Nvl(split(TabProps(i),5),'-');
			 	     	 tr.bgColor := Nvl(split(TabProps(i),6),'-');
			 	     	 typ        := split(TabProps(i),1);
			 	     	 if upper(typ) in ('TEXTFIELD','TEXTAREA') Then
			 	     	   tri.name   := 'TEXT ITEM';
			 	     	 elsif upper(typ) = 'BUTTON' Then
			 	     	   tri.name   := 'BUTTON';
			 	     	 elsif upper(typ) = 'CHECKBOX' Then
			 	     	   tri.name   := 'CHECKBOX';	 	     	 	
			 	     	 elsif upper(typ) = 'RADIOB' Then
			 	     	   Set_Custom_Property( PC$BeanName, 1, 'SET_GUI_PROPERTIES', TabProps(i) ) ;
			 	     	 elsif upper(typ) IN ('WINDOW','MENUBAR','MENUOPTION','STATUS') Then
			 	     	   Set_Custom_Property( PC$BeanName, 1, 'SET_GUI_PROPERTIES', TabProps(i) ) ;			 	     	   
			 	     	 elsif upper(typ) = 'TREE' Then
			 	     	   tri.name   := 'HIERARCHICAL TREE';	 	     	 	
			 	     	 elsif upper(typ) in ('LIST','POPLIST','TLIST') Then
			 	     	   tri.name   := 'LIST';
			 	     	 elsif upper(typ) = 'DISPLAY' Then
			 	     	   tri.name   := 'DISPLAY ITEM';
			 	     	 elsif upper(typ) = 'PROMPT' Then
			 	     	   tri.name   := 'PROMPT';	 	     	   
			 	     	 end if ;  
			 	     	 tri.props  := tr ;
			 	     	 tab_items(LN$Items) := tri ;
			 	     end;	
			 	   End if ;
  	   End loop ;
  	 End if ;
  	 
  	 If LB$Elements 
  	 Or LB$Menu
  	 Or LB$Window
  	 Or LB$Status
     Then
  	 	 Set_Custom_Property( PC$BeanName, 1, 'DRAW_GUI_ELEMENTS', '' ) ;
  	 End if ;
  	 
  	 If LB$Elements Then
  	 	 Set_All_Items_Properties ;
  	 End if ;	  	 
  	 
  End Set_GUI_Properties ;
    
  ---------------------------------------------------------------------------------

  --------------------------------------
  -- returns tab_items PL/SQL indice  --
  --------------------------------------
  Function Find_Object_Indice
  (
    PC$Name  In Varchar2
  )
  return pls_integer
  Is
    n pls_integer := 0 ;
  Begin
  	if tab_items.count > 0 then
  		for i in tab_items.first .. tab_items.last loop
  			if upper(tab_items(i).name) = upper(PC$Name) then
  				n := i ;
  				exit ;
  			end if ;	
  		end loop;	
  	end if ;
  	return n ;
  End Find_Object_Indice;	
  
  -----------------------------
  --  set one item property  --
  -----------------------------
  Procedure Set_ItemProperty 
  (
     PC$Item    In Varchar2
    ,PN$Indice In Pls_integer
  )
  Is
  Begin
    if tab_items(PN$indice).props.font != '-' then
    	 Set_Item_property( PC$Item, FONT_NAME, tab_items(PN$indice).props.font );
    end if ;
    if tab_items(PN$indice).props.fweight != '-' then
    	 if tab_items(PN$indice).props.fweight IN ('p','pi') then
    	   Set_Item_property( PC$Item, FONT_WEIGHT, FONT_PLAIN );
    	 elsif tab_items(PN$indice).props.fweight IN ('b','bi') then
    	   Set_Item_property( PC$Item, FONT_WEIGHT, FONT_BOLD );          	   
    	 end if;   
    	 if tab_items(PN$indice).props.fweight IN ('i','bi','pi') then
    	   Set_Item_property( PC$Item, FONT_STYLE, FONT_ITALIC );
    	 end if;            	 
    end if ;
    if tab_items(PN$indice).props.fsize != '-' then
    	 Set_Item_property( PC$Item, FONT_SIZE, tab_items(PN$indice).props.fsize * 100 );
    end if ;
    if tab_items(PN$indice).props.fgcolor != '-' then
    	 Set_Item_property( PC$Item, FOREGROUND_COLOR, tab_items(PN$indice).props.fgcolor );
    end if ;
    if tab_items(PN$indice).props.bgcolor != '-' then
    	 Set_Item_property( PC$Item, BACKGROUND_COLOR, tab_items(PN$indice).props.bgcolor );
    end if ;            	
  End Set_ItemProperty;  	

	--------------------------------
	--  set some item properties  --
	--------------------------------
	PROCEDURE Set_All_Items_Properties IS
	  LC$blockDeb   varchar2(60); -- start block
	  LC$block      varchar2(60); -- current block name
	  LC$item       varchar2(60); -- current item
	  LC$Type       varchar2(20); -- item type
	  LC$itemdeb    varchar2(60); -- first item
	  LC$canvas     varchar2(60); -- current canvas name
	  LN$indice     pls_integer ;
	  LN$indiceP    pls_integer ;	
	  
	BEGIN
	
	  LC$BlockDeb := get_form_property( NAME_IN('System.Current_Form'), FIRST_BLOCK ) ;
	  LC$Block := LC$BlockDeb ;
	   
	  Loop -- For each block of the form
	
	  LC$itemdeb := get_block_property(LC$BLOCK, FIRST_ITEM) ;
	  LC$item := LC$BLOCK || '.' || LC$itemdeb ;
	  LN$indiceP := Find_Object_Indice('PROMPT');
	  
	  While LC$itemdeb is not null loop -- For each item
	
	    -- item on canvas ? --
	    LC$Canvas := GET_ITEM_PROPERTY(LC$Item , ITEM_CANVAS ) ;
	    IF LC$Canvas is not null Then
		    LC$Type := GET_ITEM_PROPERTY(LC$Item , ITEM_TYPE) ;
		    LN$indice := Find_Object_Indice(LC$Type);
		    IF LC$Type = 'TEXT ITEM' Then
						if GET_ITEM_PROPERTY(LC$Item , MULTI_LINE) = 'TRUE' then
						  LN$indice := Find_Object_Indice('TEXTAREA');
						else
							LN$indice := Find_Object_Indice('TEXTFIELD');
						end if ;	
						if LN$indice > 0 then
		          Set_ItemProperty(LC$Item, LN$Indice);
						end if ;
		    ElsIF LC$Type IN ('BUTTON','LIST','HIERARCHICAL TREE','CHECKBOX','RADIO GROUP','DISPLAY ITEM') Then
						if LN$indice > 0 then
		          Set_ItemProperty(LC$Item, LN$Indice);
						end if ;
		    End if ;		
		    
		    -- prompts ? --
				If LN$indiceP > 0 and LC$Type != 'BUTTON' then
	        if tab_items(LN$indiceP).props.font != '-' then
	        	 Set_Item_property( LC$Item, PROMPT_FONT_NAME, tab_items(LN$indiceP).props.font );
	        end if ;
	        if tab_items(LN$indiceP).props.fweight != '-' then
	        	 if tab_items(LN$indiceP).props.fweight IN ('p','pi') then
	        	   Set_Item_property( LC$Item, PROMPT_FONT_WEIGHT, FONT_PLAIN );
	        	 elsif tab_items(LN$indiceP).props.fweight IN ('b','bi') then
	        	   Set_Item_property( LC$Item, PROMPT_FONT_WEIGHT, FONT_BOLD );          	   
	        	 end if;   
	        	 if tab_items(LN$indiceP).props.fweight IN ('i','bi','pi') then
	        	   Set_Item_property( LC$Item, PROMPT_FONT_STYLE, FONT_ITALIC );
	        	 end if;            	 
	        end if ;
	        if tab_items(LN$indiceP).props.fsize != '-' then
	        	 Set_Item_property( LC$Item, PROMPT_FONT_SIZE, tab_items(LN$indiceP).props.fsize * 100 );
	        end if ;
	        if tab_items(LN$indiceP).props.fgcolor != '-' then
	        	 Set_Item_property( LC$Item, PROMPT_FOREGROUND_COLOR, tab_items(LN$indiceP).props.fgcolor );
	        end if ;
	        if tab_items(LN$indiceP).props.bgcolor != '-' then
	        	 Set_Item_property( LC$Item, PROMPT_BACKGROUND_COLOR, tab_items(LN$indiceP).props.bgcolor );
	        end if ;          
				End if ;	    
	    End if ; -- canvas is not null    
	    
	    LC$itemdeb := get_item_property(LC$item, NEXTITEM );
	    LC$item := LC$BLOCK || '.' || LC$itemdeb ;
	
	  End loop ;
	   
		LC$Block := get_block_property( LC$Block, NEXTBLOCK ) ; -- next block
		
		Exit when LC$Block is null ;
		
		End loop ;
	  
	END Set_All_Items_Properties;
	
	
  ---------------------------------
  --  Open and read a .CSS file  --
  ---------------------------------
  Function   Open_CSS ( PC$Filename IN Varchar2 ) -- CSS file name
  Return Boolean
  Is
    LF$File     TEXT_IO.File_Type ;
    LC$Line     Varchar2(4000) ;
    LC$Section  Varchar2(128) ;
    LC$Type     Varchar2(60) ;
    LB$Deb      Boolean := true ;
    LB$End      Boolean := false ;
    TTags       TYP_TAB_TAG ;
    LN$Sec      Pls_Integer := 0 ;
    LN$i        Pls_Integer := 0 ;
    LN$Pos      Pls_Integer := 0 ;
  Begin
  	If PC$Filename Is Null Then
       ShowError('CSS filename not given' ) ;
  		 Return False ;
  	End if ;
  	LF$File := Text_Io.FOpen( PC$FileName, 'R' ) ;
  	If Not Text_Io.Is_Open( LF$File ) Then
       ShowError(PC$Filename || ' : CSS file not found' ) ;
  		 Return false ;
  	End if ;
  	-- delete PL/SQL table --
  	TabTags.delete ;
  	
  	-- read the sections  --
  	Begin
  		Loop
  			Text_Io.Get_Line( LF$File, LC$Line ) ;
  			LC$Line := Replace( Replace( LC$Line, CHR(10), '' ), CHR(9), '' ) ;
  			LC$Line := Replace( LC$Line, CHR(13), '' ); -- LINUX (Thanks to Tobias)
  			LC$Line := Ltrim( Rtrim( LC$Line ) ) ;
  			If Length( LC$Line ) > 0 And Substr( LC$Line, 1, 2 ) <> '/*' Then
  				 If LB$Deb Then
  				 	  -- tag section name --
  				 	  LC$Section := Ltrim( Rtrim( Substr( LC$Line, 1, Instr( LC$Line, '{' ) -1 ))) ;
  				 	  LC$Type := '' ;
  				 	  LB$Deb := false ;
  				 	  LN$Sec := LN$Sec + 1 ;
  				 Else
  				 	  -- tag content --
  				 	  LN$Pos := Instr( LC$Line, ':' ) ;
  				 	  If LN$Pos > 0 Then
  				 	    LN$i := LN$i + 1 ;
  				 	    TTags(LN$i).TagName := Substr(LC$Line, 1, LN$Pos - 1 ) ;
  				 	    TTags(LN$i).TagValue := Replace(Ltrim(Rtrim(Substr(LC$Line, LN$Pos + 1, 4000 ))), ';', '') ; 
  				 	    If Lower(TTags(LN$i).TagName) = 'type' Then
  				 	    	  LC$Type := TTags(LN$i).TagValue ; 
  				 	    End if ;
  				 	  End if ;
  				 End if ;
  				 -- end section ? --
  				 If Instr( LC$Line, '}' ) > 0 Then
  				 	  TabTags(LN$Sec).Section  := LC$Section ;
  				 	  TabTags(LN$Sec).SectType := LC$Type ;
  				 	  TabTags(LN$Sec).Tags := TTags ;
  				 	  TTags.Delete ;
  				    LB$Deb := true ;
  				    LN$i := 0 ;
  				 End if ;
  			End if ;	 
  		End loop ;
  		Text_Io.FClose( LF$File ) ;
  		-- css file read --
  		GB$Css_Open := true ;

  		Return True ;
  		
  	Exception
  		When no_data_found Then
  		  Text_Io.FClose( LF$File ) ;
  		  GB$Css_Open := true ;
  		  Return True ;
  		When Others Then
  		 GB$Css_Open := false ;
  		 return False ;
  	End ;
  	Null ;
  Exception
  		When Others Then
  		 GB$Css_Open := false ;
  		 return False ;  	
  End Open_CSS ;
  
  
  ------------------------------------------------------------------------------------

  ---------------------------------------------------------------------------------
  
  -------------------------
  --  Write a .CSS file  --
  -------------------------
  Function   Write_CSS ( PC$Filename IN Varchar2 ) -- CSS file name
  Return Boolean
  Is
    LF$File     TEXT_IO.File_Type ;
    LC$Line     Varchar2(4000) ;
    LC$Section  Varchar2(128) ;
    LC$Value    Varchar2(2000) ;
  Begin
  	If PC$Filename Is Null Then
  		 Return False ;
  	End if ;
  	LF$File := Text_Io.FOpen( PC$FileName, 'W' ) ;
  	If Not Text_Io.Is_Open( LF$File ) Then
  		 Return false ;
  	End if ;
    -- write header --
    LC$Value := '/*--' || Rpad('-',80,'-') || '*/' ;
    Text_Io.Put_Line( LF$File, LC$Value ) ;
    LC$Value := '/*  ' || Rpad(PC$Filename,80,' ') || '*/' ;
    Text_Io.Put_Line( LF$File, LC$Value ) ;    
    LC$Value := '/*--' || Rpad('-',80,'-') || '*/' ;
    Text_Io.Put_Line( LF$File, LC$Value ) ;
    LC$Value := '/*  ' || Rpad('CSS file for Forms Look and Feel',80,' ') || '*/' ;
    Text_Io.Put_Line( LF$File, LC$Value ) ;
    -- if database connection, write the date --
    Begin
      LC$Section := 'Last update : ' || To_Char(Sysdate,'DD Mon YYYY HH24:MI') ; 
      LC$Value := '/*  ' || Rpad(LC$Section,80,' ') || '*/' ;
      Text_Io.Put_Line( LF$File, LC$Value ) ;
    Exception
    	When Others Then
    	  Null;
    End ;
    LC$Value := '/*--' || Rpad('-',80,'-') || '*/' ;
    Text_Io.Put_Line( LF$File, LC$Value ) ;
  	
  	-- write the sections  --
  	For i In TabTags.First .. TabTags.Last Loop
	      -- section name --
	      Text_Io.Put_Line( LF$File, TabTags(i).Section || ' {' ) ;
	 	    -- tags --
	 	    For j In TabTags(i).Tags.First .. TabTags(i).Tags.Last Loop
	 	  	  If TabTags(i).Tags.Exists(j) Then
	 	  	    LC$Line := '     ' || TabTags(i).Tags(j).TagName || ':' || TabTags(i).Tags(j).TagValue  ;
	 	  	    Text_Io.Put_Line( LF$File, LC$Line ) ;
	 	  	  End if ;
	 	    End loop ;
	 	    Text_Io.Put_Line( LF$File, '      }' ) ;
  	End loop ;
    Text_Io.FClose(LF$File);
  	return true ;  	
  	
  Exception
    When Others Then
      Text_Io.FClose(LF$File);
      return false ;		
  End Write_CSS ;
  
  
  ------------------------------------------------------------------------------------


  ---------------------------
  --  Get the tags' table  --
  ---------------------------
  Function Get_Tag_Table Return TYP_TAB_CSS
  Is
  Begin
  	Return TabTags ;
  End ;

  ------------------------------------------------------------------------------------

  ------------------------------------
  --  Overload an existing section  --
  ------------------------------------
  Procedure  Set_Section_Tags
  ( 
    PC$Section IN Varchar2,
    PT$TTags   IN TYP_TAB_TAG
   )
   Is
   Begin
  	For i In TabTags.First .. TabTags.Last Loop
  		 If TabTags(i).Section = PC$Section Then
  		 	  TabTags(i).Tags := PT$TTags ;
  		 End if ;
    End loop ;
   End Set_Section_Tags ;


  ------------------------------------------------------------------------------------
   
   
  ------------------------------------
  --  get all tags for one section  --
  ------------------------------------
  Function Get_Section_Tags
  (
    PC$Section IN Varchar2
  ) Return TYP_TAB_TAG
  Is
    tt TYP_TAB_TAG ;
  Begin
  	For i In TabTags.First .. TabTags.Last Loop
  		 If TabTags(i).Section = PC$Section Then
  		 	  Return TabTags(i).Tags ;
  		 End if ;
    End loop ;
    Return tt ;
  End Get_Section_Tags;


  ------------------------------------------------------------------------------------

  
  -----------------------
  --  Get a tag value  --
  -----------------------
  Function Get_Tag_Value
  ( 
    PC$Section  IN Varchar2,                 -- CSS section name
    PC$TagName  IN Varchar2,                 -- tage name in the section
    PC$Default  IN Varchar2 Default 'none'   -- default value returned
  ) Return Varchar2 
  Is
  Begin
  	For i In TabTags.First .. TabTags.Last Loop
  		 If TabTags(i).Section = PC$Section Then
  		 	  For j In TabTags(i).Tags.First .. TabTags(i).Tags.Last Loop
  		 	  	 If TabTags(i).Tags.Exists(j) Then
  		 	  	   If TabTags(i).Tags(j).TagName = PC$TagName Then
  		 	  	 	   Return TabTags(i).Tags(j).TagValue ;
  		 	  	   End if ; 
  		 	  	 End if ;
  		 	  End loop ;
  		 End if ;
  	End loop ;
  	Return PC$Default ;
  End Get_Tag_Value ;
  
  
  ------------------------------------------------------------------------------------
  
  ------------------------------
  --  Get several tag values  --
  ------------------------------
  Function Get_Tag_All_Values
  ( 
    PC$Section  IN Varchar2,   -- CSS section name
    PC$TagName  IN Varchar2    -- tage name in the section
  ) Return TYP_TAB_STRINGS 
  Is
    tabResult   TYP_TAB_STRINGS ;
    LN$Cpt      PLS_INTEGER := 0 ;
  Begin
  	For i In TabTags.First .. TabTags.Last Loop
  		 If TabTags(i).Section = PC$Section Then
  		 	  For j In TabTags(i).Tags.First .. TabTags(i).Tags.Last Loop
  		 	  	 If TabTags(i).Tags.Exists(j) Then
  		 	  	   If TabTags(i).Tags(j).TagName = PC$TagName Then
  		 	  	 	   LN$Cpt := LN$Cpt + 1 ;
  		 	  	 	   tabResult(LN$Cpt) := TabTags(i).Tags(j).TagValue ;
  		 	  	   End if ; 
  		 	  	 End if ;
  		 	  End loop ;
  		 End if ;
  	End loop ;
  	Return tabResult ;
  End Get_Tag_All_Values ;
  

  ------------------------------------------------------------------------------------
  
  -----------------------
  --  Set a tag value  --
  -----------------------
  Procedure Set_Tag_Value
  ( 
    PC$Section  IN Varchar2,                 -- CSS section name
    PC$TagName  IN Varchar2,                 -- tag name in the section
    PC$TagValue IN Varchar2                  -- tag value
  )
  Is
  Begin
  	For i In TabTags.First .. TabTags.Last Loop
  		 If TabTags(i).Section = PC$Section Then
  		 	  For j In TabTags(i).Tags.First .. TabTags(i).Tags.Last Loop
  		 	  	 If TabTags(i).Tags.Exists(j) Then
  		 	  	   If TabTags(i).Tags(j).TagName = PC$TagName Then
  		 	  	 	   TabTags(i).Tags(j).TagValue := PC$TagValue;
  		 	  	 	   return ;
  		 	  	   End if ; 
  		 	  	 End if ;
  		 	  End loop ;
  		 End if ;
  		 -- tag not found, add it --
  		 Add_Tag_Value( PC$Section, PC$TagName, PC$TagValue ) ;
  	End loop ;
  End Set_Tag_Value ;
  
  ------------------------------------------------------------------------------------
  
  -----------------------
  --  Add a tag value  --
  -----------------------
  Procedure Add_Tag_Value
  ( 
    PC$Section  IN Varchar2,                 -- CSS section name
    PC$TagName  IN Varchar2,                 -- tag name in the section
    PC$TagValue IN Varchar2                  -- tag value
  )
  Is
    iPos   pls_integer ;
  Begin
  	For i In TabTags.First .. TabTags.Last Loop
  		 If TabTags(i).Section = PC$Section Then
  		 	  For j In TabTags(i).Tags.First .. TabTags(i).Tags.Last Loop
  		 	  	 If TabTags(i).Tags.Exists(j) Then
  		 	  	   If TabTags(i).Tags(j).TagName = PC$TagName Then
  		 	  	 	   TabTags(i).Tags(j).TagValue := PC$TagValue;
  		 	  	 	   return ;
  		 	  	   End if ; 
  		 	  	 End if ;
  		 	  End loop ;
          -- not found in the section --
          iPos := TabTags(i).Tags.Last + 1 ;
          TabTags(i).Tags(iPos).TagName  := PC$TagName;
          TabTags(i).Tags(iPos).TagValue := PC$TagValue;
  		 End if ;
  	End loop ;
  End Add_Tag_Value ;
  

  ------------------------------------------------------------------------------------
  
  --------------------------
  --  Remove a tag value  --
  --------------------------
  Procedure Remove_Tag_Value
  ( 
    PC$Section  IN Varchar2,                 -- CSS section name
    PC$TagName  IN Varchar2                  -- tag name in the section
  )
  Is
  Begin
  	For i In TabTags.First .. TabTags.Last Loop
  		 If TabTags(i).Section = PC$Section Then
  		 	  For j In TabTags(i).Tags.First .. TabTags(i).Tags.Last Loop
  		 	  	 If TabTags(i).Tags.Exists(j) Then
  		 	  	   If TabTags(i).Tags(j).TagName = PC$TagName Then
  		 	  	 	    TabTags(i).Tags.delete(j) ;
  		 	  	 	    return ;
  		 	  	   End if ; 
  		 	  	 End if ;
  		 	  End loop ;
  		 End if ;
  	End loop ;
  Exception
  		When others Then
  		  null;
  End Remove_Tag_Value ;
  
  ------------------------------------------------------------------------------------
  
  -----------------------------------------------------
  --  test if a tag section exists in the .CSS file  --
  -----------------------------------------------------
  Function Is_Tag_Exists
  ( 
    PC$TagName  IN Varchar2   -- CSS section searched
  ) Return Boolean
  Is
  Begin
  	For i In TabTags.First .. TabTags.Last Loop
  		 If TabTags(i).Section = PC$TagName Then
  		 	  Return True ;
  		 End if ;
  	End loop ;
  	Return False ;
  End Is_Tag_Exists ;
  
  
  ------------------------------------------------------------------------------------
  Procedure  Print_Tags( PC$Section IN Varchar2 DEFAULT '*ALL*' )
  Is
  Begin
  	If TabTags.Count = 0 Then Return ; End if ;
  	
  	For i In TabTags.First .. TabTags.Last Loop
  	  If PC$Section = '*ALL*' Then
  	  	 --F_Trace('Section:'  || TabTags(i).Section, 'T');
  	  	 For j In TabTags(i).Tags.First .. TabTags(i).Tags.Last Loop
  	  	 	  --F_Trace('Tag=' ||TabTags(i).Tags(j).TagName || ' value=' || TabTags(i).Tags(j).TagValue, 'T');
  	  	 	  null;
  	  	 End loop ;
  	  End if ;
  	End loop ;
  End  ;


  ------------------------------------------------------------------------------------
  Function IsBlockEmbeded( PC$Block  IN Varchar2 )
  Return Pls_Integer
  --  return the block number in the pl/sql table --
  Is
  Begin
  	If GT$Blocks.count > 0 Then
  		 For i In 1 .. GT$Blocks.count Loop
  		 	 If GT$Blocks(i).blk_name = PC$Block Then
  		 	 	  Return i ;
  		 	 End if ;
  		 End loop ;
  	End if ;
  	Return 0 ;
  End IsBlockEmbeded ;
  

  ------------------------------------------------------------------------------------
  Procedure ShowError( PC$Message IN Varchar2 )
  Is
    LN$But Pls_Integer ;
    al_id  ALERT;
  Begin
  	al_id := Find_Alert('LAF_AL_ERROR');
  	If Not ID_NULL(al_id) Then
  	  Set_Alert_Property( 'LAF_AL_ERROR', ALERT_MESSAGE_TEXT, PC$Message ) ;
  	  LN$But := Show_Alert( 'LAF_AL_ERROR' ) ;
  	Else
  		Message('L&F error: ' || PC$Message);
    End if ;		
  End ShowError;
  

  ------------------------------------------------------------------------------------
  
  -----------------------------------------------------------
  --  handle the Post-Query/WNRI/Post-Record  trigger      --
  --  modified by : Francois Degrelle (April 2009)         --
  --                POST-RECORD added to take into account --
  --                the current record attribute           --
  -----------------------------------------------------------
  Procedure Fill_Table( PC$Type  IN Varchar2 DEFAULT 'ODD', PB$Start IN Boolean default TRUE )
  Is
		LN$Rec  pls_integer := Get_Block_Property( Name_In('system.trigger_block'), current_record ) ;
		LN$Blk  Pls_Integer := PKG_LOOK_AND_FEEL.IsBlockEmbeded(Name_In('system.trigger_block')) ;
		PC$Block varchar2(100) := Name_In('system.trigger_block');  -- AJE : is required for block partly on main canvas and partly on spreadtable canvas
		LC$Va    varchar2(100) := Get_Block_Property( Name_In('system.trigger_block'), current_record_attribute ) ;
		LC$RStat varchar2(20) := Name_In('SYSTEM.RECORD_STATUS');
	Begin
  	Default_Value('FALSE','GLOBAL.LAF_QUERY_TIME');
  	If GT$Blocks.count > 0 Then  -- AJE : is required for block partly on main canvas and partly on spreadtable canvas
  		 For i In 1 .. GT$Blocks.count Loop  -- AJE : is required for block partly on main canvas and partly on spreadtable canvas
  		 	 If GT$Blocks(i).blk_name = PC$Block Then  -- AJE : is required for block partly on main canvas and partly on spreadtable canvas
            If GT$Blocks(i).Cur_Attr.name <> '-' Then
  	   	      LC$Va := GT$Blocks(i).Cur_Attr.name ; 
  	   	      If GT$Blocks(i).Cur_Attr.font <> '-'    Then Set_VA_Property(LC$Va, FONT_NAME, GT$Blocks(i).Cur_Attr.font); End if ;
  	   	      If GT$Blocks(i).Cur_Attr.fsize > -1     Then Set_VA_Property(LC$Va, FONT_SIZE, GT$Blocks(i).Cur_Attr.fsize * 100); End if ;
  	   	      If GT$Blocks(i).Cur_Attr.Weight > -1    Then Set_VA_Property(LC$Va, FONT_WEIGHT, GT$Blocks(i).Cur_Attr.Weight); End if ;
  	   	      If GT$Blocks(i).Cur_Attr.style  > -1    Then Set_VA_Property(LC$Va, FONT_STYLE, GT$Blocks(i).Cur_Attr.Style); End if ;
  	   	      If GT$Blocks(i).Cur_Attr.BackCol <> '-' Then Set_VA_Property(LC$Va, BACKGROUND_COLOR, GT$Blocks(i).Cur_Attr.BackCol); End if ;
  	   	      If GT$Blocks(i).Cur_Attr.ForeCol <> '-' Then Set_VA_Property(LC$Va, FOREGROUND_COLOR, GT$Blocks(i).Cur_Attr.ForeCol); End if ;
  	   	      Set_Block_Property(Name_In('system.trigger_block'), current_record_attribute, LC$Va );
  	   	    Else
  		 	 	    If LC$Va Is Null or LC$Va = 'DEFAULT' Then
  		 	 	  	  LC$Va := Get_Form_Property( Name_In('System.Current_Form'), current_record_attribute ) ;
  		 	 	    End if ;
  		 	 	    If LC$Va = 'DEFAULT' Then LC$Va := null ; End if ;
  		 	 	  End if ;
  		 	 	  LN$Blk := i ;  -- AJE : is required for block partly on main canvas and partly on spreadtable canvas
						If LN$Blk > 0 And 
							  (  PKG_LOOK_AND_FEEL.GT$Blocks(LN$Blk).va_odd is not null
							  or PKG_LOOK_AND_FEEL.GT$Blocks(LN$Blk).va_even is not null) Then
					    For i In PKG_LOOK_AND_FEEL.GT$Blocks(LN$Blk).items.First .. PKG_LOOK_AND_FEEL.GT$Blocks(LN$Blk).items.Last Loop
							  -- Is record selected ?
							  If PKG_MULTISELECT.Get_State(LN$Rec) = 1 then							    	
  							  Set_Item_Instance_Property
							    (
  							    PKG_LOOK_AND_FEEL.GT$Blocks(LN$Blk).items(i), 
							      current_record, 
							      VISUAL_ATTRIBUTE, 
							      PKG_MULTISELECT.va_name
							     );							    
							  Else
								  -- Current record attribute ? --
								  If LC$Va Is Not Null and Name_In('GLOBAL.LAF_QUERY_TIME') = 'FALSE' and PB$Start Then	
								    Set_Item_Instance_Property
								    (
								      PKG_LOOK_AND_FEEL.GT$Blocks(LN$Blk).items(i), 
								      current_record, 
								      VISUAL_ATTRIBUTE, 
								      LC$Va
								     );
								  Else   							  	
								    If Mod(LN$Rec,2) = 0 And
								    	PKG_LOOK_AND_FEEL.GT$Blocks(LN$Blk).va_odd is not null Then
	  							    Set_Item_Instance_Property
								      (
	  							      PKG_LOOK_AND_FEEL.GT$Blocks(LN$Blk).items(i), 
								        current_record, 
								        VISUAL_ATTRIBUTE, 
								        PKG_LOOK_AND_FEEL.GT$Blocks(LN$Blk).va_odd
								       );
								    ElsIf Mod(LN$Rec,2) <> 0 And
								    	PKG_LOOK_AND_FEEL.GT$Blocks(LN$Blk).va_even is not null Then	
	  							    Set_Item_Instance_Property
								      (
	  							      PKG_LOOK_AND_FEEL.GT$Blocks(LN$Blk).items(i), 
								        current_record, 
								        VISUAL_ATTRIBUTE, 
								        PKG_LOOK_AND_FEEL.GT$Blocks(LN$Blk).va_even
								       );
								    Else 
	  							    Set_Item_Instance_Property
								      (
	  							      PKG_LOOK_AND_FEEL.GT$Blocks(LN$Blk).items(i), 
								        current_record, 
								        VISUAL_ATTRIBUTE, 
								        ''
								       );
								    End if ;			  
								  End if ;
							  End if ;
							End loop ;
						End if ;
  		 	 End if ;  -- AJE : is required for block partly on main canvas and partly on spreadtable canvas
  		 End loop ;  -- AJE : is required for block partly on main canvas and partly on spreadtable canvas
  	End if ;  -- AJE : is required for block partly on main canvas and partly on spreadtable canvas
		Null ;
	End Fill_Table;  

  ------------------------------------------------------------------------------------
  Procedure LAF_Execute_Query
  Is
  Begin
    Default_Value('FALSE','GLOBAL.LAF_QUERY_TIME'); 
    Copy('TRUE', 'GLOBAL.LAF_QUERY_TIME' );
      execute_query;
    Copy('FALSE', 'GLOBAL.LAF_QUERY_TIME' );
  End;  

	-------------------------------------------------
  -- convert a delimited string to a collection  --
  -------------------------------------------------
  Procedure To_String_Collection
  ( 
     LC$String      IN Varchar2,
     PT$StringTable IN OUT NOCOPY TYP_TAB_STRINGS 
   )
  Is
    i       pls_integer := 1 ;
    LC$Tok  Varchar2(2000) ;
  Begin
	  Loop
		  LC$Tok := PKG_LOOK_AND_FEEL.Split( LC$String, i ) ;
		  exit when  LC$Tok IS NULL ;
		  PT$StringTable(i) := LC$Tok ;
		  i := i + 1 ;		
	  End loop ;  	
  End To_String_Collection ;
  

	--------------------------
  --  get a string token  --
  --  varchar2 version    --
  --------------------------
	Function Split
	(
	   PC$Chaine IN VARCHAR2,         -- input string
	   PN$Pos IN PLS_INTEGER,         -- token number
	   PC$Sep IN VARCHAR2 DEFAULT ',' -- separator character
	)
	RETURN VARCHAR2
	IS
	  LC$Chaine VARCHAR2(32767) := PC$Sep || PC$Chaine ;
	  LI$I      PLS_INTEGER ;
	  LI$I2     PLS_INTEGER ;
	BEGIN
	  LI$I := INSTR( LC$Chaine, PC$Sep, 1, PN$Pos ) ;
	  IF LI$I > 0 THEN
	    LI$I2 := INSTR( LC$Chaine, PC$Sep, 1, PN$Pos + 1) ;
	    IF LI$I2 = 0 THEN LI$I2 := LENGTH( LC$Chaine ) + 1 ; END IF ;
	    RETURN( SUBSTR( LC$Chaine, LI$I+1, LI$I2 - LI$I-1 ) ) ;
	  ELSE
	    RETURN NULL ;
	  END IF ;
	END Split;
	
	--------------------------
  --  get a string token  --
  --  CLOB version        --
  --------------------------
	Function Split
	(
	   PC$Chaine IN CLOB,             -- input string
	   PN$Pos IN PLS_INTEGER,         -- token number
	   PC$Sep IN VARCHAR2 DEFAULT ',' -- separator character
	)
	RETURN VARCHAR2
	IS
	  LC$Chaine CLOB := PC$Sep || PC$Chaine ;
	  LI$I      PLS_INTEGER ;
	  LI$I2     PLS_INTEGER ;
	BEGIN
	  LI$I := DBMS_LOB.INSTR( LC$Chaine, PC$Sep, 1, PN$Pos ) ;
	  IF LI$I > 0 THEN
	    LI$I2 := DBMS_LOB.INSTR( LC$Chaine, PC$Sep, 1, PN$Pos + 1) ;
	    IF LI$I2 = 0 THEN LI$I2 := DBMS_LOB.GETLENGTH( LC$Chaine ) + 1 ; END IF ;
	    RETURN( DBMS_LOB.SUBSTR( LC$Chaine, LI$I2 - LI$I-1, LI$I+1 ) ) ;
	  ELSE
	    RETURN NULL ;
	  END IF ;
	END Split;	

  ------------------------------------------------------------------------------------

	---------------------------------------
	--  read an image from the database  --
	---------------------------------------
	PROCEDURE Read_Image 
  (
    PC$Bean      IN VARCHAR2,
    PC$Image     IN VARCHAR2,
    PC$Clause    IN VARCHAR2
  )	
	IS
	  LB$Ok      boolean ;
	  LC$Image   Varchar2(32767) ;
	  LC$Clause  Varchar2(4000) ;
	BEGIN
		
		--LC$Clause := 'Select PHOTO_JAVA From PHOTOS Where IDENTIFIANT = ' || :PHOTOS.IDENTIFIANT ;
		-- Select the Blob column --
		If Pkg_LAF.Select_Blob(PC$Clause) Then
			 Loop
			   -- Get the image chunks from the database --
			   LC$Image := Pkg_LAF.Get_B64_Chunk ;
			   If LC$Image Is Not Null Then
			     -- Send the chunks to the Java Bean --
			     Set_Custom_Property( PC$Bean, 1, 'IMG_READIMGBASE', PC$Image || ',' || LC$Image ) ;
			   Else
			   	 -- End the sending process --
			   	 Set_Custom_Property( PC$Bean, 1, 'IMG_READIMGBASE', PC$Image || ',' || '[END_IMAGE]' ) ;
			   	 Exit ;
			   End if ;	
			 End loop ;
		End if ;	
		  
	END;
	
	--------------------------------------
	--  write an image in the database  --
	--------------------------------------	
	PROCEDURE Write_Image 
	(
    PC$Bean      IN VARCHAR2,
    PC$Image     IN VARCHAR2,
    PC$Table     IN VARCHAR2,
    PC$Column    IN VARCHAR2,    
    PC$Clause    IN VARCHAR2
  )
	IS
	    LC$Req  Varchar2(32000);
	    LN$Cpt  Pls_integer := 0 ;
	    LC$Res  Varchar2(2000) ;
	BEGIN
	    --
	    -- Save the image to the database
	    --
	    Set_Custom_Property( PC$Bean, 1, 'IMG_SET_INDICE', PC$Image ) ;
	    
	    Loop
	    	 -- Get the image chunk from the Java Bean --
	    	 LC$Req := Get_Custom_Property(PC$Bean,1,'IMG_GET_IMAGE');
	    	 Exit When LC$Req is null ;
	    	 LN$Cpt := LN$Cpt + 1 ;
	    	 If Ln$Cpt = 1 Then
	    	 	  Pkg_LAF.Init_Transfer ;
	    	 End if ;	  
	    	 -- Send the image chunks to the Database --
	    	 Pkg_LAF.Set_B64_Chunk(LC$Req);
	    End loop;
	    If LN$Cpt > 0 Then
	      -- Update the Blob column with the new content --
	      LC$Res := Pkg_LAF.Save_Blob(PC$Table, PC$Column, PC$Clause );
	    End if ;
	END;


  
END;


PACKAGE pkg_multiselect IS
  Type TAB_REC is table of pls_integer index by binary_integer;
  Type TAB_SEL is table of pls_integer index by binary_integer;
  Type REC_REC is record( name Varchar2(61), tab TAB_REC );
  Type REC_CHK is record( name Varchar2(61), tab TAB_SEL );
  Type TAB_REC_REC is table of REC_REC index by binary_integer;
  Type TAB_REC_CHK is table of REC_CHK index by binary_integer;
  
  procedure clear;
  procedure clear_all_blocks;
  function  get_state( numrec in pls_integer ) return pls_integer ;
  procedure set_state( numrec in pls_integer, value in pls_integer ) ;
  procedure change_state( numrec in pls_integer ) ;
  function  get_checked_list (blockname in varchar2 default null)  return TAB_SEL ;
  procedure set_visual_attribute_name ( vaname in varchar2);
  procedure set_select_visual_attributes
  (
     fontname   in varchar2 default null
    ,fontweight in varchar2 default null     
    ,fontsize   in varchar2 default null
    ,foreground in varchar2 default null
    ,background in varchar2 default null    
  );
  procedure set_multiselect_properties (props in varchar2);  
  procedure set_modifier(mdf in varchar2);
  procedure create_record(numrec in pls_integer);
  procedure delete_record(numrec in pls_integer);
  
  va_name varchar2(40) := 'VA_LAF_MTSELECT' ;
  tabrec  TAB_REC_REC;
    
END;

PACKAGE BODY pkg_multiselect IS

  modifier varchar2(20) := '-' ;
  
	------------------------------------------
	-- colorize the current selected record --
	------------------------------------------
	procedure color_select_record 
	(
	   blockname in varchar2
	  ,numrec in pls_integer 
	  ,color in boolean
	 )
	is
	  LC$item     varchar2(60);
	  LC$itemdeb  varchar2(60);
	  LN$len      pls_integer ;
	begin
	
	  if va_name is null then
	  	 return ;
	  end if ;	 	 
	  
	  -- get the first item of the block --
	  LC$itemdeb := Get_Block_Property(blockname, FIRST_ITEM) ;
	  LC$item := blockname || '.' || LC$itemdeb ;
	 
	  -- For every item of the current block --
	  while LC$itemdeb is not null Loop
	
	    if Get_Item_Property(LC$Item , ITEM_TYPE) NOT IN ('BUTTON','RADIO GROUP','DISPLAY ITEM') Then
	     
	       if Get_Item_Property(LC$Item , VISIBLE ) = 'TRUE' Then
	          if color then
	            Set_Item_Instance_Property(LC$item, numrec, VISUAL_ATTRIBUTE, va_name);
	          else                                                          
	          	Set_Item_Instance_Property(LC$item, numrec, VISUAL_ATTRIBUTE, '');
	          end if ;	
	       end if ;
	   
	    end if ;
	
	    -- next item --
	    LC$itemdeb := Get_Item_Property( LC$item, NEXTITEM );
	    LC$item := blockname || '.' || LC$itemdeb ;
	
	  end loop ;
	 
	end color_select_record;

  ------------------------------
  -- find the record in table --
  ------------------------------
  function find_record(vname in varchar2)
  return pls_integer
  is
   r pls_integer := 0;
  begin
  	if tabrec.count > 0 then
  		 for i in tabrec.first .. tabrec.last loop
  		 	  if tabrec.exists(i) then
  		 	    if upper(tabrec(i).name) = upper(vname) then
  		 	  	  r := i ;
  		 	  	  exit ;
  		 	    end if ;	
  		 	  end if ;
  		 end loop;	
  	end if ;
  	return r;
  exception
    when others then
      return 0;		
  end find_record;

  -------------------------
  --  get total records  --
  -------------------------
  function get_total_records(vname in varchar2)
  return pls_integer
  is
   r pls_integer := 0;
  begin
  	if tabrec.count > 0 then
  		 for i in tabrec.first .. tabrec.last loop
  		 	  if tabrec.exists(i) then
  		 	    if upper(tabrec(i).name) = upper(vname) then
  		 	  	  r := tabrec(i).tab.count ;
  		 	  	  exit ;
  		 	    end if ;	
  		 	  end if ;
  		 end loop;	
  	end if ;
  	return r;
  end get_total_records;
  
  ----------------------
  --  add new record  --
  ----------------------
  procedure add_record(vname in varchar2,numrec in pls_integer)
  is
   r pls_integer := 0;
  begin
  	if tabrec.count > 0 then
  		 for i in tabrec.first .. tabrec.last loop
  		 	  if tabrec.exists(i) then
  		 	    if upper(tabrec(i).name) = upper(vname) then
  		 	  	  r := tabrec(i).tab.count ;
  		 	  	  if numrec > r then
  		 	  	  	 -- add at end --
  		 	  	     set_state(numrec, 0);
  		 	  	  else
  		 	  	  	 -- shift records --
  		 	  	  	 for j in reverse numrec .. r loop
  		 	  	  	 	 tabrec(i).tab(j+1) := tabrec(i).tab(j);
  		 	  	  	 end loop;	
  		 	  	  	 tabrec(i).tab(numrec) := 0 ;
  		 	  	  end if;	 
  		 	  	  return ;
  		 	    end if ;	
  		 	  end if ;
  		 end loop;	
  	end if ;
  end add_record;  
  
  ---------------------
  --  delete record  --
  ---------------------
  procedure delete_record(vname in varchar2,numrec in pls_integer)
  is
   r pls_integer := 0;
  begin
  	if tabrec.count > 0 then
  		 for i in tabrec.first .. tabrec.last loop
  		 	  if tabrec.exists(i) then
  		 	    if upper(tabrec(i).name) = upper(vname) then
  		 	  	  r := tabrec(i).tab.count ;
  		 	  	  if r = 0 then return; end if ;
  		 	  	  if numrec = r then
  		 	  	  	 -- delete from end --
  		 	  	     tabrec(i).tab.delete(numrec);
  		 	  	  else
  		 	  	  	 -- shift records --
  		 	  	  	 for j in numrec .. (r-1) loop
  		 	  	  	 	 tabrec(i).tab(j) := tabrec(i).tab(j+1);
  		 	  	  	 end loop;	
  		 	  	  	 tabrec(i).tab.delete(r);
  		 	  	  end if;	 
  		 	  	  return ;
  		 	    end if ;	
  		 	  end if ;
  		 end loop;	
  	end if ;
  end delete_record;  
    
  --------------------------
  -- clear the collection --
  --------------------------
  procedure clear
  Is
    r pls_integer := 0;
    n varchar2(100) := name_in('system.current_form') || '.' || Name_in('system.cursor_block');
  Begin
  	r := find_record(n);
  	if r > 0 then
  	  tabrec(r).tab.delete;
  	end if ;
  End clear;
  
  -----------------------------
  -- clear all form's blocks --
  -----------------------------
  procedure clear_all_blocks
  Is
    r pls_integer := 0;
    n varchar2(100);
  Begin
  	if tabrec.count > 0 then
  	  for i in tabrec.first .. tabrec.last loop
  	    r := instr( tabrec(i).name, '.' ) ;
  	    n := upper(substr(tabrec(i).name, 1, r-1));
  	    if n = upper(name_in('system.current_form')) then
  	      tabrec.delete(i);
  	    end if ;  
  	  end loop;  
  	end if ;
  End clear_all_blocks;  
  
  ------------------------------
  -- get the NUMREC value 0/1 --
  ------------------------------
  function  get_state( numrec in pls_integer ) 
  return pls_integer
  is 
    r pls_integer := 0;  
    n varchar2(100) := name_in('system.current_form') || '.' || Name_in('system.cursor_block');    
  begin
  	r := find_record(n);   
  	if r > 0 then  	
  	  if tabrec(r).tab.exists(numrec) then
  	    return tabrec(r).tab(numrec);
  	  end if ;
  	end if ;  
  	return 0 ;
  end get_state;
  
  --------------------------
  -- set the NUMREC value --
  --------------------------
  procedure set_state( numrec in pls_integer, value in pls_integer )
  is
    r pls_integer := 0;
    n varchar2(100) := name_in('system.current_form') || '.' || Name_in('system.cursor_block');
  begin
  	r := find_record(n);
  	if r > 0 then  	  	
  	  tabrec(r).tab(numrec) := value ;
  	else
  		r := tabrec.count + 1;
  		tabrec(r).name := n ;
  		tabrec(r).tab(numrec) := value ;
  	end if ;
  end set_state;
  
  -----------------------------
  -- change the NUMREC value --
  -----------------------------
  procedure change_state( numrec in pls_integer )
  is
    r pls_integer := 0;   
    n varchar2(100) := name_in('system.current_form') || '.' || Name_in('system.cursor_block');     
    m varchar2(50) := Nvl(lower(name_in('SYSTEM.MOUSE_BUTTON_MODIFIERS')),'-');
  begin
    -- valid keyboard modifier ? --
  	if m != modifier then
  		 return ;
  	end if ;	 
  	
  	r := find_record(n);
  	if r > 0 then  	  	
  	  if tabrec(r).tab(numrec) = 0 then
  		  tabrec(r).tab(numrec) := 1 ;
  		  color_select_record (Name_in('system.cursor_block'), numrec, true);
  	  else
  		  tabrec(r).tab(numrec) := 0 ;
  		  color_select_record (Name_in('system.cursor_block'), numrec, false);
  	  end if ;	 
  	else
  	  message('not found: '|| n, no_acknowledge);
  	end if ;
  end change_state;  
  
  -----------------------------------
  --  get the checked records list --
  -----------------------------------
  function get_checked_list(blockname in varchar2 default null)
  return TAB_SEL
  is
    tb TAB_SEL ;    
    j pls_integer := 0 ;
    r pls_integer := 0;        
    n varchar2(100) ;
  begin
  	if blockname is not null then
  		 n := name_in('system.current_form') || '.' || blockname ;
  	else
  		 n := name_in('system.current_form') || '.' || Name_in('system.cursor_block');    
  	end if ;	
  	r := find_record(n);
  	if r > 0 then  	  	
  	  if tabrec(r).tab.count > 0 Then
  		  for i IN tabrec(r).tab.first .. tabrec(r).tab.last loop
  			  if tabrec(r).tab(i) = 1 Then
  				  j := j + 1 ;
  				  tb(j) := i ;
  			  end if ;	
  		  end loop;	
  	  end if ;
  	else
  	  message('not found: '|| n, no_acknowledge);
  	end if ;
  	return tb ;
  end get_checked_list;
  
  -----------------------------------
  -- set the visual attribute name --
  -----------------------------------
  procedure set_visual_attribute_name ( vaname in varchar2)
  is
    va VisualAttribute;
  begin
  	va := find_va(vaname);
  	if Id_Null(va) then 
  		va_name := null ;
  	else
      va_name := vaname ;  		
  	end if;  	
  	
  end set_visual_attribute_name;	
  	
  ----------------------------------
  -- set the selected record's    --
  -- visual attribute properties  --
  ----------------------------------
  procedure set_select_visual_attributes
  (
     fontname   in varchar2 default null
    ,fontweight in varchar2 default null     
    ,fontsize   in varchar2 default null
    ,foreground in varchar2 default null
    ,background in varchar2 default null    
  )
  is
    va VisualAttribute;
    weight  varchar2(10);
    style   varchar2(10);
  begin
  	va := find_va(va_name);
  	if Id_Null(va) then 
  		va_name := null ;
  		return; 
  	end if;
  	
  	if fontname is not null then
  		set_va_property(va, FONT_NAME, fontname);
  	end if ;
  	if fontsize is not null then          
  		set_va_property(va, FONT_SIZE, to_number(fontsize)* 100);
  	end if ;	
  	if fontweight is not null then          
  		if upper(fontweight) like '%P%' then
  		  set_va_property(va, FONT_WEIGHT, FONT_PLAIN);  		
  		elsif upper(fontweight) like '%B%' then            
  		  set_va_property(va, FONT_WEIGHT, FONT_BOLD);  		
  		end if ;
  		if upper(fontweight) like '%I%' then
  		  set_va_property(va, FONT_STYLE, FONT_ITALIC);  		
  		end if ;    			  		
  	end if ;
  	if background is not null then          
  		set_va_property(va, BACKGROUND_COLOR, background);  		
  	end if ;	
  	if foreground is not null then          
  		set_va_property(va, FOREGROUND_COLOR, foreground);  		
  	end if ;	  	
  end set_select_visual_attributes;
  
  --------------------------------------
  --  set all multiselect properties  --
  --------------------------------------
  procedure set_multiselect_properties (props in varchar2)
  is
    va_name     varchar2(50);
    font_name   varchar2(50);
    font_size   varchar2(10);
    font_weight varchar2(10);
    fg_color    varchar2(20);
    bg_color    varchar2(20);
  begin
  	va_name     := PKG_Look_And_Feel.split( props, 1);
  	if nvl(va_name,'-')  != '-' then
  		 set_visual_attribute_name( va_name ) ;
  	end if ;

  	font_weight  := PKG_Look_And_Feel.split( props, 3);
  	if Upper(font_weight) = 'B' then
  		font_weight := FONT_BOLD ;
  	elsif Upper(font_weight) = 'P' then
  		font_weight := FONT_PLAIN ;  		
  	end if ;	

  	set_select_visual_attributes
  	(
  	  replace(PKG_Look_And_Feel.split( props, 2), '-', null),
  	  replace(font_weight, '-', null),  	  
  	  replace(PKG_Look_And_Feel.split( props, 4), '-', null),
  	  replace(PKG_Look_And_Feel.split( props, 5), '-', null),
  	  replace(PKG_Look_And_Feel.split( props, 6), '-', null)  	  
  	);
  		
  end set_multiselect_properties;	
  
  procedure set_modifier(mdf in varchar2)
  is
  begin
  	if lower(mdf) = 'shift' then
  		modifier := 'shift+' ;
  	elsif lower(mdf) = 'shift+ctrl' then
  		modifier := 'shift+control+' ;
  	elsif lower(mdf) = 'alt' then
  		modifier := 'alt+' ;  		
  	elsif lower(mdf) = 'ctrl' then
  		modifier := 'control+' ;
  	end if ;	  		  		
  end set_modifier;	

  -----------------------
  --  insert a record  --
  -----------------------
  procedure create_record(numrec in pls_integer)
  is
     vname varchar2(100) := name_in('system.current_form') || '.' || Name_in('system.cursor_block');
  begin
  	add_record(vname,numrec) ;
  end create_record;
  
  -----------------------
  --  delete a record  --
  -----------------------
  procedure delete_record(numrec in pls_integer)
     is
     vname varchar2(100) := name_in('system.current_form') || '.' || Name_in('system.cursor_block');
  begin
  	delete_record(vname,numrec) ;
  end delete_record;
  
  
END pkg_multiselect;


PACKAGE PKG_TABLE IS
  
  Type COLS_TAB is record
  (
  	 COLNAME	Varchar2(30)
  	,COLTYPE	Varchar2(20)
  );
  Type TAB_COLS_TAB is table of COLS_TAB index by PLS_INTEGER;
  
  Type TYP_TAB_CHAR Is table of Varchar2(1000) index by BINARY_INTEGER ;
  TabCols    TYP_TAB_CHAR ;  
  
  Type REC_TAB is record
  (
  	 TTITLE	Varchar2(256)
  	,TBEAN	Varchar2(60)
  	,TTABLE	Varchar2(60)  
  	,TQUERY	Varchar2(2000)
  	,TWHERE	Varchar2(2000)
  	,TORDER	Varchar2(2000)  
  	,TPAGESIZE	Pls_integer    default 100
  	,TCURRENTPAGE	Pls_integer  default 1
  	,TUPDATE	Varchar2(10)     default 'true'
  	,TINSERT	Varchar2(10)     default 'true'
  	,TDELETE	Varchar2(10)     default 'true'
  	,TPOSX	Pls_Integer        default 1
  	,TPOSY	Pls_Integer        default 1
  	,TWIDTH	Pls_Integer        default 400
  	,THEIGHT	Pls_Integer      default 200
  	,TDECSEP	Varchar2(2)      default '.,'
  	,TDATEFORMAT	Varchar2(60) default 'dd/MM/yyyy'
  	,TNUMFORMAT	Varchar2(60)   default '#0.00'
  	,TINTFORMAT	Varchar2(60)   default '##########'
  	,TBACKGROUND	Varchar2(20)
  	,TCURRENT	Varchar2(100)
  	,TCOLSMAXWIDTH	Varchar2(20)
  	,TCELLPROP	Varchar2(32767)
  	,TCELLVALUE	Varchar2(32767)
  	,TCURCELLVALUE	Varchar2(32767)
  	,TROWPROP	Varchar2(1000)
  	,TTOTALLINE	Varchar2(10000)
  	,TTOTALLINELABELS	Varchar2(10000)
  	,TFILTER	Varchar2(1000)
  	,THEADFG	Varchar2(20)
  	,THEADBG	Varchar2(20)
  	,THEADHEIGHT	Varchar2(20)
  	,TTOTALHEADHEIGHT	Varchar2(20)
  	,TDATAFG	Varchar2(20)
  	,TDATABG	Varchar2(20)
  	,TTABLEBG	Varchar2(20)
  	,TGRIDFG	Varchar2(20)
  	,TCELLPOS	Varchar2(20)
  	,TROWPOS	Varchar2(20)
  	,TSEPARATOR	Varchar2(20)
  	,TIMAGESIZE	Varchar2(20)
  	,TREORDER	Varchar2(20)
  	,TRESIZE	Varchar2(20)
  	,TBORDER	Varchar2(100)
  	,TSELECTBACK	Varchar2(20)
  	,TSELECTFORE	Varchar2(20)
  	,TLOCALE	Varchar2(100)
  	,TVLINE	Varchar2(20)
  	,THLINE	Varchar2(20)
  	,TRESIZEMODE	Varchar2(20)
  	,TVISIBLEROWS	Varchar2(20)
  	,TVISIBLE	Varchar2(20)
  	,TEXTEND	Varchar2(20)  default 'false'
  	,TBEANLOG	Varchar2(20)  default 'false'	 	  	
  	,TTRACE	Varchar2(20)  default 'false'	 	
  	,TCOLUMNS TAB_COLS_TAB
  	,TCHECKBOX TYP_TAB_CHAR
  );
  Type TAB_REC_TAB is table of REC_TAB index by VARCHAR2(60);
  
	PROCEDURE Init_table
	(
	   PC$TableName  IN Varchar2
	  ,PC$Bean       IN Varchar2
	  ,PC$Table      IN Varchar2	  
	  ,PC$Title      IN Varchar2	  
	  ,PC$Query      IN Varchar2
	  ,PC$Where      IN Varchar2	  
	  ,PC$Order      IN Varchar2	  
	  ,PN$PageSize   IN PLS_INTEGER
	  ,PC$Update     IN Varchar2     default 'true'
	  ,PC$Insert     IN Varchar2     default 'true'
	  ,PC$Delete     IN Varchar2     default 'true'	  	  
  	,PI$PosX       IN Pls_Integer  default 1
  	,PI$PosY       IN Pls_Integer  default 1
  	,PI$Width      IN Pls_Integer  default 400
  	,PI$Height     IN Pls_Integer  default 200
  	,PC$DecSep     IN Varchar2     default '.,'
  	,PC$DateFormat IN Varchar2     default 'dd/MM/yyyy'
  	,PC$NumFormat  IN Varchar2     default '#0.00'
  	,PC$IntFormat  IN Varchar2     default '##########'	  
  	,PC$Trace      IN Varchar2     default 'false'
  	,PC$BeanLog    IN Varchar2     default 'false'  	
	);  
  
	FUNCTION Display_table
	(
	   PC$TableName IN Varchar2
	  ,PN$PageNum   IN PLS_INTEGER 
	  ,PB$Init      IN boolean default true	  
	) Return PLS_INTEGER;
	
	FUNCTION Update_table
	(  
	   PC$TableName IN Varchar2
	  ,PC$Rows      IN Varchar2
	  ,PB$Silent    IN Boolean default true	  
	) Return PLS_INTEGER;
	
	FUNCTION Insert_table
	(  
	   PC$TableName IN Varchar2
	  ,PC$Rows      IN Varchar2
	  ,PB$Silent    IN Boolean default true
	) Return PLS_INTEGER;
	
	FUNCTION Delete_table
	(  
	   PC$TableName IN Varchar2
	  ,PC$Rows      IN Varchar2
	  ,PB$Silent    IN Boolean default true	  
	) Return PLS_INTEGER;
	
	FUNCTION Proceed_DML_table
	(  
	   PC$TableName IN Varchar2
	  ,PB$Silent    IN Boolean default true
	) Return PLS_INTEGER;
	
	FUNCTION Ask_Proceed_DML_table
	(  
	   PC$TableName IN Varchar2
	) RETURN Boolean;	
	
	PROCEDURE Set_Bean_Name
	(  
	  PC$Bean      IN Varchar2	
	);	
		
	PROCEDURE Set_Property
	(  
	  PC$TableName IN Varchar2,
	  PC$Props     IN Varchar2 
	);
	
	PROCEDURE Display_Cell_Value
	(  
	   PC$TableName IN Varchar2
	  ,PN$Row       IN Pls_integer
	  ,PN$Cell      IN Pls_integer	  
	);
	
	PROCEDURE Display_Row_Value
	(  
	   PC$TableName IN Varchar2
	  ,PN$Row       IN Pls_integer
	);
	
	PROCEDURE Write_Image 
	(
     PC$TableName IN Varchar2
    ,PC$Table     IN VARCHAR2
    ,PC$Column    IN VARCHAR2
    ,PC$Clause    IN VARCHAR2
    ,PN$Row       IN PLS_INTEGER
    ,PN$Cell      IN PLS_INTEGER 
    ,PB$Silent    IN Boolean default true	       
  );
  
	PROCEDURE Update_CLOB
	(
     PC$TableName IN Varchar2
    ,PC$Bean      IN VARCHAR2
    ,PC$Query     IN VARCHAR2
    ,PN$Row       IN PLS_INTEGER
    ,PN$Cell      IN PLS_INTEGER
    ,PB$Silent    IN Boolean default true	       
  );  
  	
	FUNCTION Get_Property
	(  
	  PC$TableName IN Varchar2,
	  PC$Prop      IN Varchar2,
	  PC$Prop2     IN Varchar2  default null
	) Return Varchar2;
	
	FUNCTION Get_Column_Type
	(
	   PT$Cols    IN TAB_COLS_TAB
	  ,PC$ColName IN Varchar2 
	)
	Return varchar2;
		
	FUNCTION Split
	(
	   PC$Chaine IN VARCHAR2,         -- input string
	   PN$Pos IN PLS_INTEGER,         -- token number
	   PC$Sep IN VARCHAR2 DEFAULT ',' -- separator character
	)
	RETURN VARCHAR2 ;
  
END;

PACKAGE BODY PKG_TABLE IS
  
  GC$Sep        Varchar2(1) := '^' ;
  GT$Tables     TAB_REC_TAB ;
  GC$Bean       Varchar2(60);
  GC$EndSplit  Varchar2(20) := '^-END-STRING-^' ;
  
	FUNCTION Split
	(
	   PC$Chaine IN VARCHAR2,         -- input string
	   PN$Pos IN PLS_INTEGER,         -- token number
	   PC$Sep IN VARCHAR2 DEFAULT ',' -- separator character
	)
	RETURN VARCHAR2
	IS
	  LC$Chaine VARCHAR2(32767) := PC$Sep || PC$Chaine ;
	  LI$I      PLS_INTEGER ;
	  LI$I2     PLS_INTEGER ;
	  LC$Val    VARCHAR2(4000);
	BEGIN
	  LI$I := INSTR( LC$Chaine, PC$Sep, 1, PN$Pos ) ;
	  IF LI$I > 0 THEN
	    LI$I2 := INSTR( LC$Chaine, PC$Sep, 1, PN$Pos + 1) ;
	    IF LI$I2 = 0 THEN LI$I2 := LENGTH( LC$Chaine ) + 1 ; END IF ;
	    LC$Val :=  SUBSTR( LC$Chaine, LI$I+1, LI$I2 - LI$I-1 );
	    If LC$Val is null Then
	    	 Return NULL ;
	    End if ;	 
	    RETURN( LC$Val ) ;
	  ELSE
	    RETURN GC$EndSplit ;
	  END IF ;
	END Split;
		
	-----------------------
	--  trace procedure  --
	-----------------------
	PROCEDURE Trace_Message
	( 
	   PC$TableName IN Varchar2
	  ,LC$Title     IN Varchar2
	  ,LC$Msg       IN Varchar2 
	)
	Is
	  LC$Name   Varchar2(60) := upper(PC$TableName);	
	  LN$Height pls_integer := 180 ;
	Begin
		 If Length(LC$Msg) > 1000 Then LN$Height := 450;
		 ElsIf Length(LC$Msg) > 500 Then LN$Height := 350;
		 ElsIf Length(LC$Msg) > 200 Then LN$Height := 250;	
		 End if ;
		 If GT$Tables.exists(LC$Name) 
		 And Lower(GT$Tables(LC$Name).TTRACE) = 'true' Then
			 Set_Custom_Property(GT$Tables(LC$Name).TBean, 1,'DISPLAY_MESSAGE','0,0,500,'
			 || LN$Height || ',-,' || LC$Title || ',' || LC$Msg);		 
			 Return;
		 End if ;	 
	End;
	
	-----------------------
	--  error procedure  --
	-----------------------
	PROCEDURE Trace_Error
	( 
	   LC$Title     IN Varchar2
	  ,LC$Msg       IN Varchar2 
	)
	Is
	  LN$Height pls_integer := 180 ;
	Begin
		 If Length(LC$Msg) > 1000 Then LN$Height := 450;
		 ElsIf Length(LC$Msg) > 500 Then LN$Height := 350;
		 ElsIf Length(LC$Msg) > 200 Then LN$Height := 250;	
		 End if ;	 
		 If GC$Bean Is not null Then
			 Set_Custom_Property(GC$Bean, 1,'DISPLAY_MESSAGE','0,0,500,'
			   || LN$Height || ',-,' || LC$Title || ',' || LC$Msg);
		 Else
		   message(LC$Title || ' ' || LC$Msg, acknowledge );
		 End if ;
	End;		
	
	----------------------------------
	--  Write all images for a row  --
	----------------------------------
	PROCEDURE Write_Images
	(
	   PC$TableName IN Varchar2
	  ,PN$Row       IN Pls_integer
	  ,PC$Rowid     IN Varchar2 
    ,PB$Silent    IN Boolean default true	   	  
	)
	Is
     LC$Name   Varchar2(60) := upper(PC$TableName);		
	Begin
		If GT$Tables(LC$Name).TCOLUMNS.count > 0 Then
			For i in 1 .. GT$Tables(LC$Name).TCOLUMNS.count Loop
				  If Upper(GT$Tables(LC$Name).TCOLUMNS(i).COLTYPE) = 'IMAGE' Then
						Write_Image 
						( 
							PC$TableName,
							GT$Tables(LC$Name).TTable,
							GT$Tables(LC$Name).TCOLUMNS(i).COLNAME,
							'ROWID=''' || PC$Rowid || '''',
							PN$Row,
							i-1, 
							PB$Silent
						);
				  End if ; 
			End loop;	 
		End if ;
	Exception
  	When OTHERS Then
     	trace_error('Write_Images','Error:' || SQLERRM); 		
     	raise form_trigger_failure;
	End Write_Images ;		

	
	---------------------------------
	--  Write all CLOBs for a row  --
	---------------------------------
	PROCEDURE Update_CLOBs
	(
	   PC$TableName IN Varchar2
	  ,PN$Row       IN Pls_integer
	  ,PC$Rowid     IN Varchar2 
    ,PB$Silent    IN Boolean default true	   	  
	)
	Is
     LC$Name   Varchar2(60) := upper(PC$TableName);		
     LC$Query  Varchar2(2000);
	Begin
		If GT$Tables(LC$Name).TCOLUMNS.count > 0 Then
			For i in 1 .. GT$Tables(LC$Name).TCOLUMNS.count Loop
				  If Upper(GT$Tables(LC$Name).TCOLUMNS(i).COLTYPE) = 'CLOB' Then
						LC$Query := 'UPDATE ' || GT$Tables(LC$Name).TTable
						  || ' SET ' || GT$Tables(LC$Name).TCOLUMNS(i).COLNAME || ' =:1 '
						  || ' WHERE ROWID=''' || PC$Rowid || '''';
						Update_CLOB(PC$TableName,GT$Tables(LC$Name).TBean,LC$Query ,PN$Row+1 ,i ,PB$Silent ) ;
				  End if ; 
			End loop;	 
		End if ;
	Exception
  	When OTHERS Then
     	trace_error('Update_CLOBs','Error:' || SQLERRM); 		
     	raise form_trigger_failure;
	End Update_CLOBs ;		
	
	-------------------------
	--  table declaration  --
	-------------------------
	PROCEDURE Init_table
	(
	   PC$TableName  IN Varchar2
	  ,PC$Bean       IN Varchar2
	  ,PC$Table      IN Varchar2	  
	  ,PC$Title      IN Varchar2	  
	  ,PC$Query      IN Varchar2
	  ,PC$Where      IN Varchar2	  
	  ,PC$Order      IN Varchar2	  
	  ,PN$PageSize   IN PLS_INTEGER
	  ,PC$Update     IN Varchar2     default 'true'
	  ,PC$Insert     IN Varchar2     default 'true'
	  ,PC$Delete     IN Varchar2     default 'true'
  	,PI$PosX       IN Pls_Integer  default 1
  	,PI$PosY       IN Pls_Integer  default 1
  	,PI$Width      IN Pls_Integer  default 400
  	,PI$Height     IN Pls_Integer  default 200
  	,PC$DecSep     IN Varchar2     default '.,'
  	,PC$DateFormat IN Varchar2     default 'dd/MM/yyyy'
  	,PC$NumFormat  IN Varchar2     default '#0.00'
  	,PC$IntFormat  IN Varchar2     default '##########'
  	,PC$Trace      IN Varchar2     default 'false'  	
  	,PC$BeanLog    IN Varchar2     default 'false'  	
	)
	Is
	  LC$Name      Varchar2(60) := upper(PC$TableName);
	Begin
		PKG_TABLE.Set_Bean_Name(PC$Bean);
		-- table already exist ? --
		If GT$Tables.exists(LC$Name) Then
			 Set_Custom_Property(PC$Bean, 1,'DISPLAY_MESSAGE','0,0,400,110,-,Dynamic Table-block,' 
			 	|| 'Table:' || PC$TableName || ' already declared');
			 return;
		End if ;
		GT$Tables(LC$Name).TBean        := PC$Bean ;
		GT$Tables(LC$Name).TBeanLog     := PC$BeanLog ;
		PKG_Table.Set_Property(PC$TableName, 'LOG=' ||PC$BeanLog);
		GT$Tables(LC$Name).TTable       := PC$Table ;
		GT$Tables(LC$Name).TTitle       := PC$Title ;
		GT$Tables(LC$Name).TQuery       := PC$Query ;
		GT$Tables(LC$Name).TWhere       := PC$Where ;
		GT$Tables(LC$Name).TOrder       := PC$Order ;
		If PN$PageSize = -1 Or PN$PageSize >= 10 Then
		  GT$Tables(LC$Name).TPageSize    := PN$PageSize ;
		Else
			GT$Tables(LC$Name).TPageSize := 100 ;
		End if ;
		GT$Tables(LC$Name).TCurrentPage := 1 ;
  	GT$Tables(LC$Name).TUpdate      := PC$Update ;
  	GT$Tables(LC$Name).TPosX        := PI$PosX ;
  	GT$Tables(LC$Name).TPosY        := PI$PosY ;
  	GT$Tables(LC$Name).TWidth       := PI$Width ;
  	GT$Tables(LC$Name).THeight      := PI$Height ;
  	GT$Tables(LC$Name).TDecSep      := PC$DecSep ;
  	GT$Tables(LC$Name).TDateFormat  := PC$DateFormat ;
  	GT$Tables(LC$Name).TNumFormat   := PC$NumFormat ;
  	GT$Tables(LC$Name).TIntFormat   := PC$IntFormat ;
  	GT$Tables(LC$Name).TTrace       := PC$Trace ;
    
    Set_Custom_Property( PC$Bean, 1, 'TB_NEW', LC$Name ) ;
		PKG_Table.Set_Property(PC$TableName, 'Bounds='
		  || PI$PosX || ',' || PI$PosY || ',' || PI$Width || ',' || PI$Height );
		PKG_Table.Set_Property(PC$TableName, 'Current=' ||PC$TableName);
		PKG_Table.Set_Property(PC$TableName, 'DecSep=' || PC$DecSep);
		PKG_Table.Set_Property(PC$TableName, 'DateFormat=' || PC$DateFormat);
		PKG_Table.Set_Property(PC$TableName, 'NumFormat=' || PC$NumFormat);
		PKG_Table.Set_Property(PC$TableName, 'IntFormat=' || PC$IntFormat);
		PKG_Table.Set_Property(PC$TableName, 'UPDATE=' || PC$Update);
		PKG_Table.Set_Property(PC$TableName, 'PAGESIZE=' || GT$Tables(LC$Name).TPageSize);
    	
	End Init_table;	
	
	----------------------------------------
	--  proceed all table DML operations  -- 
	--  only if PAGESIZE > -1             --
	----------------------------------------	
	FUNCTION Ask_Proceed_DML_table
	(  
	   PC$TableName IN Varchar2
	) RETURN Boolean	
	Is
	  LC$Name Varchar2(60) := upper(PC$TableName);  
	  LN$i    Pls_Integer;
	  LB$Ret  Boolean := false;
	Begin  
		-- table defined ? --
		If Not GT$Tables.exists(LC$Name) Then
			 trace_error('Ask_Proceed_DML_table()','Table:' || PC$TableName || ' not declared'); 
		End if ;
		If GT$Tables(LC$Name).TPageSize > -1 Then
			 LN$i := Proceed_DML_table(PC$TableName, true);
			 LB$Ret := true;
		Else
			 LB$Ret := false;
		End if ;	
		Return LB$Ret ;
	End Ask_Proceed_DML_table;
	
	----------------------------------------
	--  proceed all table DML operations  --
	----------------------------------------
	FUNCTION Proceed_DML_table
	(  
	   PC$TableName IN Varchar2
	  ,PB$Silent    IN Boolean default true	   
	) Return PLS_INTEGER
	Is
	LC$Rows    Varchar2(32000) ;
	LN$Insert  pls_integer ;
	LN$Update  pls_integer ;
	LN$Delete  pls_integer ;
	LN$Rows    pls_integer := 0 ;
	Begin	
	  -- Deletes --
	  LN$Delete := PKG_Table.Get_Property(PC$TableName,'COUNT_DELETE');
	  If Not PB$Silent Then trace_message(PC$TableName,'Proceed_DML_table()',LN$Delete || ' rows to delete');end if;
	  If LN$Delete > 0 Then
		  LC$Rows := PKG_TABLE.Get_Property(PC$TableName, 'ROWS_DELETED');
		  LN$Delete := PKG_TABLE.Delete_table(PC$TableName, LC$Rows, PB$Silent);
	  End if ;  
	  -- updates --
	  LN$Update := PKG_Table.Get_Property(PC$TableName,'COUNT_UPDATE');
	  If Not PB$Silent Then trace_message(PC$TableName,'Proceed_DML_table()',LN$Update || ' rows to update');end if;
	  If LN$Update > 0 Then
		  LC$Rows := PKG_TABLE.Get_Property(PC$TableName, 'ROWS_CHANGED');
		  LN$Update := PKG_TABLE.Update_table(PC$TableName, LC$Rows, PB$Silent);
	  End if ;
	  -- Inserts --  
	  LN$Insert := PKG_Table.Get_Property(PC$TableName,'COUNT_INSERT');
	  If Not PB$Silent Then trace_message(PC$TableName,'Proceed_DML_table()',LN$Insert || ' rows to insert');end if;
	  If LN$Insert > 0 Then
		  LC$Rows := PKG_TABLE.Get_Property(PC$TableName, 'ROWS_INSERTED');
		  LN$Insert := PKG_TABLE.Insert_table(PC$TableName, LC$Rows, PB$Silent);
	  End if ;  
	  return LN$Delete + LN$Update + LN$Insert ;	
	End Proceed_DML_table;	
	
	-----------------------------------
	--  update the underlying table  --
	-----------------------------------
	FUNCTION Update_table
	(  
	   PC$TableName IN Varchar2
	  ,PC$Rows      IN Varchar2
	  ,PB$Silent    IN Boolean default true	  	  
	) Return PLS_INTEGER
	IS
	  iNbrows       Pls_integer := 0 ;
	  LC$Line       Varchar2(32767) ;
	  LC$Head       Varchar2(4000) ;  
	  c             NUMBER;
	  d             NUMBER;
	  col_cnt       PLS_INTEGER;
	  rec_tab       dbms_sql.desc_tab;
	  v             VARCHAR2(4000) ;
	  col_num       NUMBER;  
	  source_cursor INTEGER;
	  result        INTEGER;  
	  LC$Query      Varchar2(10000) ;
	  LC$Value      Varchar2(256);
	  LC$Rowid      Varchar2(256);
	  LC$RowNum     Varchar2(20);
	  LC$Row        Varchar2(4000);
	  LN$Count      PLs_Integer ;
	  LC$Null       Varchar2(1) := NULL ;
	  i             Pls_Integer := 1 ;
	  j             Pls_Integer := 1 ;
	  T$Vals        PKG_TABLE.TYP_TAB_CHAR ;
	  LC$Name       Varchar2(60) := upper(PC$TableName);  
	Begin  
		-- table defined ? --
		If Not GT$Tables.exists(LC$Name) Then
			 Set_Custom_Property(GC$Bean, 1,'DISPLAY_MESSAGE','0,0,400,110,-,Dynamic Table-block,' 
			 	|| 'Table:' || PC$TableName || ' not declared');
			 return 0 ;
		End if ;
		
		-- table updatable ? --
		If Lower(GT$Tables(LC$Name).TUPDATE) != 'true' Then
			 Set_Custom_Property(GT$Tables(LC$Name).TBean, 1,'DISPLAY_MESSAGE','0,0,400,110,-,Dynamic Table-block,' 
			 	|| 'Table:' || PC$TableName || ' not updatable');	
			 	return 0 ;		
		End if ;	
	
    --
    -- Build the UPDATE order --
    --
    LC$Query := 'UPDATE ' || PC$TableName || ' set ' ;
    If GT$Tables(LC$Name).TCOLUMNS.Count > 0 Then 
      j := 1 ;
      For i IN 2 .. GT$Tables(LC$Name).TCOLUMNS.Last Loop
    	  If UPPER(GT$Tables(LC$Name).TCOLUMNS(i).COLNAME) != 'ROW_NUM' 
    	  And GT$Tables(LC$Name).TCOLUMNS(i).COLTYPE Not IN ('IMAGE','CLOB') Then
	    	  j := j + 1 ;
	    	  If i > 2 Then LC$Query := LC$Query || ',' ; End if ;
	    	  LC$Query := LC$Query || GT$Tables(LC$Name).TCOLUMNS(i).COLNAME || '= :' || Ltrim(To_Char(j)) ;
    	  End if ;
      End loop;	
      LC$Query := LC$Query || ' WHERE ROWID = :0' ;
    End if ;
    If Not PB$Silent Then trace_message(PC$TableName,'Update_Table()',LC$Query); End if ;
    LN$Count := 0 ;
    
    source_cursor := DBMS_SQL.OPEN_CURSOR;
    DBMS_SQL.PARSE(source_cursor,LC$Query,1);
    -- scan all rows to update --
    Loop
    	LC$Value := Split(PC$Rows,i);
    	Exit when LC$Value = GC$EndSplit ;
    	i := i + 1 ;
      -- trace --
      If Not PB$Silent Then trace_message(PC$TableName,'Update_Table()','Update row:'|| LC$Value); End if ;
    	PKG_Table.Set_Property(PC$TableName, 'ROWIDPOS=' || LC$Value);
    	If PKG_Table.Get_Property(PC$TableName, 'IDENTIFIED_ROW') = 'true' Then
	      LC$RowNum := PKG_Table.Get_Property(PC$TableName, 'CURRENT_ROW') ;
	      LC$Line := PKG_Table.Get_Property(PC$TableName, 'ROWVAL') ;
	      If Not PB$Silent Then trace_message(PC$TableName,'Update_Table()','row:'|| LC$Line); End if;	    	
	      If LC$Line is not null Then
	      	 T$Vals.Delete ;
	      	 --
	      	 -- get the column values --
	      	 --
	      	 j := 1 ;
	      	 Loop
	      	 	 LC$Row := Split( LC$Line, j, GC$Sep ) ;
	      	 	 Exit when LC$Row = GC$EndSplit ;
	      	 	 T$Vals(j) := LC$Row ;
	      	 	 j := j + 1 ;
	      	 End loop ;	
	      	 -- bind all variables --
	      	 If T$Vals.Count > 0 Then
	      	 	  LC$Rowid := T$Vals(1);
	      	 	  For k in 2 .. T$Vals.Last Loop
                 If Not PB$Silent Then trace_message(PC$TableName,'Update_Table()','bind(' ||k||')='||Trim(T$Vals(k))); End if;
                 DBMS_SQL.BIND_VARIABLE(source_cursor,':' || Ltrim(To_Char(k)),Trim(T$Vals(k))); 
	      	 	  End loop;	
	      	 	  If Not PB$Silent Then trace_message(PC$TableName,'Update_Table()','bind(ROWID)='||Trim(T$Vals(1)));End if;
	      	 	  DBMS_SQL.BIND_VARIABLE(source_cursor,':0',T$Vals(1));
	      	 	  -- execute update --
	      	 	  If Not PB$Silent Then trace_message(PC$TableName,'Update_Table()','execute update');end if;
	      	 	  iNbrows := DBMS_SQL.EXECUTE(source_cursor);
	      	 	  If Not PB$Silent Then trace_message(PC$TableName,'Update_Table()','set update done');end if;
	      	 	  LN$Count := LN$Count + iNbrows ;
	      	 End if ;	
	      End if ;
    	End if ;
	    -- save images --
	    If Not PB$Silent Then
	      trace_message(PC$TableName,'Update_Table()','Save Images and CLOBs'); 
	    End if ;
	    Write_Images( PC$TableName ,LC$RowNum ,LC$Rowid, PB$Silent ); 
	    -- save CLOBs  --
	    Update_CLOBs( PC$TableName ,LC$RowNum ,LC$Rowid, PB$Silent ); 
	    If LC$Line is not null Then
	    	PKG_Table.Set_Property(PC$TableName, 'UPDATE_DONE=' || T$Vals(1));
	    End if ;
    End loop ;
    DBMS_SQL.CLOSE_CURSOR(source_cursor);
    If Not PB$Silent Then 
      trace_message(PC$TableName,'Update_Table()','Number of rows updated: ' || LN$Count);
    End if;
    return LN$Count ;
	
	EXCEPTION
  When OTHERS Then
     trace_error('Update_Table()','Error:' || SQLERRM); 
     return 0;
	End Update_table;
	
	-----------------------------------
	--  insert the underlying table  --
	-----------------------------------
	FUNCTION Insert_table
	(  
	   PC$TableName IN Varchar2
	  ,PC$Rows      IN Varchar2
	  ,PB$Silent    IN Boolean default true	  	  
	) Return PLS_INTEGER
	IS
	  iNbrows       Pls_integer := 0 ;
	  LC$Line       Varchar2(32767) ;
	  LC$Head       Varchar2(4000) ;  
	  c             NUMBER;
	  d             NUMBER;
	  col_cnt       PLS_INTEGER;
	  rec_tab       dbms_sql.desc_tab;
	  v             VARCHAR2(4000) ;
	  col_num       NUMBER;  
	  source_cursor INTEGER;
	  result        INTEGER;  
	  LC$Query      Varchar2(10000) ;
	  LC$Value      Varchar2(256);
	  LC$Row        Varchar2(4000);
	  LC$Rowid      Varchar2(256);
	  LC$RowNum     Varchar2(20);	  
	  LR$Rowid      rowid ;
	  LN$Count      PLs_Integer ;
	  LC$Null       Varchar2(1) := NULL ;
	  i             Pls_Integer := 1 ;
	  j             Pls_Integer := 1 ;
	  T$Vals        PKG_TABLE.TYP_TAB_CHAR ;
	  LC$Name       Varchar2(60) := upper(PC$TableName);  
	Begin  
		-- table defined ? --
		If Not GT$Tables.exists(LC$Name) Then
			 Set_Custom_Property(GC$Bean, 1,'DISPLAY_MESSAGE','0,0,400,110,-,Dynamic Table-block,' 
			 	|| 'Table:' || PC$TableName || ' not declared');
			 return 0;
		End if ;
		
		-- table insertable ? --
		If Lower(GT$Tables(LC$Name).TINSERT) != 'true' Then
			 Set_Custom_Property(GT$Tables(LC$Name).TBean, 1,'DISPLAY_MESSAGE','0,0,400,110,-,Dynamic Table-block,' 
			 	|| 'Table:' || PC$TableName || ' not insertable');	
			 	return 0;		
		End if ;	
	
    --
    -- Build the INSERT order --
    --
    LC$Query := 'INSERT INTO ' || PC$TableName || ' (' ;
    If GT$Tables(LC$Name).TCOLUMNS.Count > 0 Then 
      j := 0 ;
      For i IN 2 .. GT$Tables(LC$Name).TCOLUMNS.Last Loop
    	  If UPPER(GT$Tables(LC$Name).TCOLUMNS(i).COLNAME) != 'ROW_NUM'
    	  And GT$Tables(LC$Name).TCOLUMNS(i).COLTYPE Not IN ('IMAGE','CLOB') Then
	    	  If i > 2 Then LC$Query := LC$Query || ',' ; End if ;
	    	  LC$Query := LC$Query || GT$Tables(LC$Name).TCOLUMNS(i).COLNAME ;
    	  End if ;
      End loop;	
      LC$Query := LC$Query || ') VALUES( ' ;
      For i in 2 .. GT$Tables(LC$Name).TCOLUMNS.Count Loop
      	If UPPER(GT$Tables(LC$Name).TCOLUMNS(i).COLNAME) != 'ROW_NUM'
      	And GT$Tables(LC$Name).TCOLUMNS(i).COLTYPE != 'IMAGE' Then		
	      	j := j + 1 ;
	      	If i > 2 Then LC$Query := LC$Query || ',' ; End if ;
	      	LC$Query := LC$Query || ':' || j;--(i-1);
      	End if ;
      End loop;	
      LC$Query := LC$Query || ') RETURNING ROWID into :ret_rowid' ;
    End if ;
    If Not PB$Silent Then trace_message(PC$TableName,'Insert_Table()',LC$Query);end if;
    LN$Count := 0 ;
    
    source_cursor := DBMS_SQL.OPEN_CURSOR;
    DBMS_SQL.PARSE(source_cursor,LC$Query,1);
    If Not PB$Silent Then trace_message(PC$TableName,'Insert_Table()','parse OK');end if;
    -- scan all rows to insert --
    Loop
    	LC$Value := Split(PC$Rows,i);
    	Exit when LC$Value = GC$EndSplit ;
    	i := i + 1 ;

    	PKG_Table.Set_Property(PC$TableName, 'ROWPOS=' || LC$Value);
    	If PKG_Table.Get_Property(PC$TableName, 'IDENTIFIED_ROW') = 'true' Then
	      LC$RowNum := LC$Value;
	      LC$Line := PKG_Table.Get_Property(PC$TableName, 'ROWVAL') ;
	      If Not PB$Silent Then trace_message(PC$TableName,'Insert_Table()','row:'|| LC$Line);end if;
	      If LC$Line is not null Then
	      	 T$Vals.Delete ;
	      	 --
	      	 -- get the column values --
	      	 --
	      	 j := 1 ;
	      	 Loop
	      	 	 LC$Row := Split( LC$Line, j, GC$Sep ) ;
	      	 	 Exit when LC$Row = GC$EndSplit ;
	      	 	 T$Vals(j) := LC$Row ;
	      	 	 j := j + 1 ;	      	 	 	      	 	 
	      	 End loop ;	
	      	 -- bind all variables --
	      	 If T$Vals.Count > 0 Then
	      	 	  j := 0 ;
	      	 	  For k in 2 .. T$Vals.Last Loop
	                 j := j + 1 ;
	                 If Not PB$Silent Then trace_message(PC$TableName,'Insert_Table()','bind(' ||j||')='||Trim(T$Vals(k)));end if;
	                 DBMS_SQL.BIND_VARIABLE(source_cursor,':' || Ltrim(To_Char(j)),Trim(T$Vals(k)));  	 	  	
	      	 	  End loop;
	      	 	  DBMS_SQL.BIND_VARIABLE_ROWID(source_cursor,':ret_rowid' ,LR$Rowid);  	 	  	
	      	 	  -- execute insert --
	      	 	  If Not PB$Silent Then trace_message(PC$TableName,'Insert_Table()','execute insert');end if;
	      	 	  iNbrows := DBMS_SQL.EXECUTE(source_cursor);
	      	 	  If Not PB$Silent Then trace_message(PC$TableName,'Insert_Table()','get ROWID');end if;
	      	 	  DBMS_SQL.VARIABLE_VALUE_ROWID(source_cursor, 'ret_rowid', LR$Rowid);
	      	 	  If Not PB$Silent Then trace_message(PC$TableName,'Insert_Table()','ROWID:' || LR$Rowid);end if;
	      	 	  LN$Count := LN$Count + iNbrows ;
	      	 	  LC$Rowid := LR$Rowid;
					    -- save images --
					    If Not PB$Silent then 
					       trace_message(PC$TableName,'Insert_Table()','Save Images and CLOBs'); 
					    End if ;
					    --  save images --
					    Write_Images( PC$TableName ,LC$RowNum ,LC$Rowid, PB$Silent );        		      	 	  
					    -- save CLOBs  --
	            Update_CLOBs( PC$TableName ,LC$RowNum ,LC$Rowid, PB$Silent ); 
	            PKG_Table.Set_Property(PC$TableName, 'INSERT_DONE=' || LR$Rowid);
	      	 End if ;	
	      End if ;
      End if;
    End loop ;
    DBMS_SQL.CLOSE_CURSOR(source_cursor);
    If Not PB$Silent Then 
      trace_message(PC$TableName,'Insert_Table()','Number of rows inserted: ' || LN$Count);  
    End if;
    Return LN$Count ;
	
	EXCEPTION
  When OTHERS Then
     trace_error('Insert_Table()','Error:' || SQLERRM); 
     return 0;
	End Insert_table;	
	
	-----------------------------------
	--  delete the underlying table  --
	-----------------------------------
	FUNCTION Delete_table
	(  
	   PC$TableName IN Varchar2
	  ,PC$Rows      IN Varchar2
	  ,PB$Silent    IN Boolean default true	  	  
	) Return PLS_INTEGER
	IS
	  iNbrows       Pls_integer := 0 ;
	  LC$Line       Varchar2(32767) ;
	  LC$Head       Varchar2(4000) ;  
	  c             NUMBER;
	  d             NUMBER;
	  col_cnt       PLS_INTEGER;
	  rec_tab       dbms_sql.desc_tab;
	  v             VARCHAR2(4000) ;
	  col_num       NUMBER;  
	  source_cursor INTEGER;
	  result        INTEGER;  
	  LC$Query      Varchar2(10000) ;
	  LC$Value      Varchar2(256);
	  LC$Row        Varchar2(4000);
	  LN$Count      PLs_Integer ;
	  LC$Null       Varchar2(1) := NULL ;
	  i             Pls_Integer := 1 ;
	  j             Pls_Integer := 1 ;
	  T$Vals        PKG_TABLE.TYP_TAB_CHAR ;
	  LC$Name       Varchar2(60) := upper(PC$TableName);  
	Begin  
		-- table defined ? --
		If Not GT$Tables.exists(LC$Name) Then
			 Set_Custom_Property(GC$Bean, 1,'DISPLAY_MESSAGE','0,0,400,110,-,Dynamic Table-block,' 
			 	|| 'Table:' || PC$TableName || ' not declared');
			 return 0;
		End if ;
		
		-- table updatable ? --
		If Lower(GT$Tables(LC$Name).TDELETE) != 'true' Then
			 Set_Custom_Property(GT$Tables(LC$Name).TBean, 1,'DISPLAY_MESSAGE','0,0,400,110,-,Dynamic Table-block,' 
			 	|| 'Table:' || PC$TableName || ' not deletable');	
			 	return 0;		
		End if ;	
	
    If Not PB$Silent Then 
      trace_message(PC$TableName,'Delete_Table()','rows to delete: ' || PC$Rows);
    End if;
    --
    -- Build the DELETE order --
    --
    LC$Query := 'DELETE ' || PC$TableName || ' WHERE ROWID = :1 ' ;
    If Not PB$Silent Then trace_message(PC$TableName,'Delete_Table()',LC$Query);end if;
    LN$Count := 0 ;
    
    source_cursor := DBMS_SQL.OPEN_CURSOR;
    DBMS_SQL.PARSE(source_cursor,LC$Query,1);
    -- scan all rows to delete --
    Loop
    	LC$Value := Split(PC$Rows,i);
    	Exit when LC$Value = GC$EndSplit ;
    	i := i + 1 ;
      -- trace --
      If Not PB$Silent Then trace_message(PC$TableName,'Delete_Table()','Delete row:'|| LC$Value);end if;
  	  -- bind all variables --
	 	  DBMS_SQL.BIND_VARIABLE(source_cursor,':1',LC$Value);
	 	  -- execute delete --
	 	  If Not PB$Silent Then trace_message(PC$TableName,'Delete_Table()','execute delete');end if;
	 	  iNbrows := DBMS_SQL.EXECUTE(source_cursor);
	 	  PKG_Table.Set_Property(PC$TableName, 'DELETE_DONE=' || LC$Value);
	 	  LN$Count := LN$Count + iNbrows ;
    End loop ;
    If Not PB$Silent Then 
      trace_message(PC$TableName,'Delete_Table()','Number of rows deleted: ' || LN$Count);
    End if;
    DBMS_SQL.CLOSE_CURSOR(source_cursor);
    return LN$Count ;
	
	EXCEPTION
  When OTHERS Then
     trace_error('Delete_Table()','Error:' || SQLERRM); 
     return 0 ;
	End Delete_table;
	
	----------------------------------
	--  Display the database table  --
	----------------------------------
	FUNCTION Display_table 
	(
	   PC$TableName IN Varchar2
	  ,PN$PageNum   IN PLS_INTEGER
	  ,PB$Init      IN boolean default true
	) Return PLS_INTEGER
	IS
	  LC$Name       Varchar2(60) := upper(PC$TableName);
	  iNbcols       Pls_integer := 0 ;
	  iNbrows       Pls_integer := 0 ;
	  LC$Line       Varchar2(32767) ;
	  LC$Head       Varchar2(4000) ;
	  LC$Type       Varchar2(4000) ;    
	  c             NUMBER;
	  d             NUMBER;
	  col_cnt       PLS_INTEGER;
	  rec_tab       dbms_sql.desc_tab;
	  v             VARCHAR2(4000) ;
	  col_num       NUMBER;  
	  source_cursor INTEGER;
	  result        INTEGER;  
	  LC$Query      Varchar2(1000) ;
	  LC$Count      Varchar2(1000) ;
	  LC$Where      Varchar2(1024) ;
	  LC$Order      Varchar2(1024) ;
	  LC$Msg        Varchar2(4000);
	  LC$Rowid      Varchar2(100) ;
	  LB$Rowid      Boolean := false ;
	  LB$Ok         Boolean;
	  LC$Image      Varchar2(32767) ;
	  LI$Start      pls_integer := 1 ;
	  LI$End        pls_integer := 1000000000 ;
	  tcols         TAB_COLS_TAB;
	    
	Begin  

		-- table defined ? --
		If Not GT$Tables.exists(LC$Name) Then
			 Set_Custom_Property(GT$Tables(LC$Name).TBean, 1,'DISPLAY_MESSAGE','0,0,400,110,-,Dynamic Table-block,' 
			 	|| 'Table:' || PC$TableName || ' not declared');
			 return 0;
		End if ;
		
		IF GT$Tables(LC$Name).TPageSize > -1 THEN
       LI$Start := (GT$Tables(LC$Name).TPageSize * (PN$PageNum - 1)) + 1 ;
       LI$End   := GT$Tables(LC$Name).TPageSize * PN$PageNum ;
    END IF ;
		 	
    If GT$Tables(LC$Name).TQuery is not null Then
    	c := Instr(Upper(GT$Tables(LC$Name).TQuery),' FROM ');
    	If c > 0 then
    		 LC$Query := Substr(GT$Tables(LC$Name).TQuery,1, c-1)
    		          || ',row_number() over (ORDER BY rowid) AS row_num '
    		          || Substr(GT$Tables(LC$Name).TQuery, c );
    	End if ;      
    ElsIf GT$Tables(LC$Name).TTable is not null Then
      LC$Query := 'SELECT t.ROWID, t.* ,row_number() over (ORDER BY rowid) AS row_num FROM ' || GT$Tables(LC$Name).TTable || ' t ' ;
    Else
			 Set_Custom_Property(GT$Tables(LC$Name).TBean, 1,'DISPLAY_MESSAGE','0,0,400,110,-,Dynamic Table-block,' 
			 	|| 'Table:' || PC$TableName || ': TABLE or QUERY must be NON-NULL');    	
			 raise form_trigger_failure;	
    End if ;
    
    If GT$Tables(LC$Name).TWhere is not null Then
    	LC$Where := Replace(Replace(Replace(GT$Tables(LC$Name).TWhere,'where',''),'WHERE',''), 'Where','') ;
    	LC$Query := LC$Query || ' WHERE ' || LC$Where ;
    End if ;
    
    If GT$Tables(LC$Name).TOrder is not null Then
    	LC$Order := Replace(Replace(Replace(GT$Tables(LC$Name).TOrder,'order by',''),'ORDER BY',''), 'Order by','') ;
    	LC$Query := LC$Query || ' ORDER BY ' || LC$Order ;
    End if ;
    
		LC$Query := 'SELECT * FROM ( SELECT subreq.* FROM ( ' 
		|| LC$Query 
		|| ') subreq  WHERE row_num <= ' || LI$End || ') WHERE row_num >= ' || LI$Start ;
	
		LC$Count := 'SELECT COUNT(*) FROM ( SELECT subreq.* FROM ( ' 
		|| LC$Query 
		|| ') subreq  WHERE row_num <= ' || LI$End || ') WHERE row_num >= ' || LI$Start ;	    
           
    tcols.delete;
    
    -- Count the rows --
    source_cursor := dbms_sql.open_cursor;
    dbms_sql.parse(source_cursor,  LC$Count, 1);
    dbms_sql.DEFINE_COLUMN(source_cursor, 1, v,4000);
    result := dbms_sql.EXECUTE(source_cursor);
    IF dbms_sql.FETCH_ROWS(source_cursor)>0 THEN
         dbms_sql.COLUMN_VALUE(source_cursor, 1, v);
         iNbrows := v ;
    END IF;
    dbms_sql.close_cursor(source_cursor);

    -- retrieve the columns of the query --
    c := dbms_sql.open_cursor;

    dbms_sql.parse(c, LC$Query , 1);

    d := dbms_sql.EXECUTE(c);

    dbms_sql.describe_columns(c, col_cnt, rec_tab);

    iNbcols := 0 ;

    PKG_TABLE.TabCols.Delete ;
    
    d := 1 ;
    FOR i IN rec_tab.first .. rec_tab.last LOOP
      -- CLOB -> 112
      -- BLOB -> 113
      If rec_tab(i).col_type in (1,2,11,12,96,112,113) 
      	And Upper(rec_tab(i).col_name) != 'ROW_NUM' Then
        
        tcols(d).COLNAME := rec_tab(i).col_name;
        If d > 1 Then 
        	  LC$Head := LC$Head || GC$Sep ;
        	  LC$Type := LC$Type || GC$Sep ;  
        End if ;
        If rec_tab(i).col_type = 2 Then
        	 If rec_tab(i).col_scale = 0 Then
        	   LC$Type := LC$Type || 'INTEGER' ;
        	   tcols(d).COLTYPE := 'INTEGER' ;  
        	 Else
        	   LC$Type := LC$Type || 'NUMBER' ;
        	   tcols(d).COLTYPE := 'NUMBER' ;  
           End if ;	 
        ElsIf rec_tab(i).col_type = 12 Then
        	 LC$Type := LC$Type || 'DATE' ;
        	 tcols(d).COLTYPE := 'DATE' ;  
        ElsIf rec_tab(i).col_type = 112 Then
        	 LC$Type := LC$Type || 'CLOB' ;
        	 tcols(d).COLTYPE := 'CLOB' ;  
        ElsIf rec_tab(i).col_type = 113 Then
        	 LC$Type := LC$Type || 'IMAGE' ;
        	 tcols(d).COLTYPE := 'IMAGE' ;  
        Else
        	LC$Type := LC$Type || 'CHAR' ;
        	tcols(d).COLTYPE := 'CHAR' ;  
        End if ;	
        if d > 1 Then LC$Head := LC$Head || GC$Sep ; End if ;
        LC$Head := LC$Head || rec_tab(i).col_name ;

        d := d + 1 ; 
        iNbcols := iNbcols + 1 ;
        If upper(rec_tab(i).col_name) = 'ROWID' Then
        	 LB$Rowid := true ;
        End if ;	 
      --Else
				--message(rec_tab(i).col_name || ':' || rec_tab(i).col_type);              	
      End if ;
    END LOOP ;

    dbms_sql.close_cursor(c);
    GT$Tables(LC$Name).TCOLUMNS := tcols ;
    

    -- Init all variables --
    If PB$Init Then
	    PKG_Table.Set_Property(PC$TableName, 'INIT');
    Else
    	PKG_Table.Set_Property(PC$TableName, 'CLEAR_REFRESH');
    End if ;
    If Not LB$Rowid Then
    	PKG_Table.Set_Property(PC$TableName, 'ROWID=false');
    End if ;	
    -- Set the data separator's character --
    PKG_Table.Set_Property(PC$TableName, 'SEPARATOR=' || GC$Sep);
	  -- Set the array dimensions --
	  PKG_Table.Set_Property(PC$TableName, 'ARRAYSIZE=' || to_char(iNbcols)||','||to_char(iNbrows));
    -- Set the hearders' columns
    PKG_Table.Set_Property(PC$TableName, 'HEADER=' || LC$Head);
    -- Set the hearders' columns
    PKG_Table.Set_Property(PC$TableName, 'COLSTYPE=' || LC$Type );
    -- Set the checkbox property --
    If GT$Tables(LC$Name).TCHECKBOX.Count > 0 Then
    	For i in 1 .. GT$Tables(LC$Name).TCHECKBOX.Count Loop
          PKG_Table.Set_Property(PC$TableName, 'CELLPROP=' || GT$Tables(LC$Name).TCHECKBOX(i));
    	End loop;
    End if ;

    --------------------
    --  Get the data  --
    --------------------
    source_cursor := dbms_sql.open_cursor;
    dbms_sql.parse(source_cursor,  LC$Query, 1);
    -- Define the columns --
    FOR i IN 1 .. rec_tab.last LOOP
      If rec_tab(i).col_type in (1,2,11,12,96) Then
        dbms_sql.DEFINE_COLUMN(source_cursor, i, v,4000);
      End if ;
    END LOOP ;
    result := dbms_sql.EXECUTE(source_cursor);
    -- Fetch the rows from the source query  --
    iNbRows := 0 ;
    LOOP
      IF dbms_sql.FETCH_ROWS(source_cursor)>0 THEN
        ----------------------------------
        -- get column values of the row --
        ----------------------------------
        LC$Line := '' ;
        iNbrows := iNbrows + 1 ;
        d := 1 ;
        FOR i IN 1.. rec_tab.last LOOP
          If Upper(rec_tab(i).col_name) != 'ROW_NUM' Then
          If rec_tab(i).col_type in (1,2,11,12,96,112,113) Then
            If rec_tab(i).col_type in (1,2,11,12,96) Then
              dbms_sql.COLUMN_VALUE(source_cursor, i, v);
            Else
            	v := null ;
            End if ;	
            If d > 1 Then LC$Line := LC$Line || GC$Sep ; End if ;	            
            If rec_tab(i).col_type = 11 Then 
            	 LC$Rowid := v ; 
            End if ;
            LC$Line := LC$Line || Nvl(v,' ') ;	            	
          End if ;
          If rec_tab(i).col_type = 112 Then
          	  --------------------
          	  -- send the CLOB  --
          	  --------------------
          	  LC$Query := 'SELECT ' || rec_tab(i).col_name || ' FROM ' || GT$Tables(LC$Name).TTable
          	    || ' Where ROWID=''' || LC$Rowid || '''';
          	  LB$Ok := PKG_LOB.Read_Lob_Table (PC$TableName,'CLOB' ,GT$Tables(LC$Name).TBean ,iNbRows ,d ,LC$Query ,LC$Msg );          	    
          End if ;	          
          If rec_tab(i).col_type = 113 Then
          	  --------------------
          	  -- send the image --
          	  --------------------
          	  LC$Query := 'Select ' || rec_tab(i).col_name || ' FROM ' || GT$Tables(LC$Name).TTable
          	    || ' Where ROWID=''' || LC$Rowid || '''';
							--trace_error('Display_Table()',LC$Query); 
							If PKG_LAF.Select_Blob(LC$Query) Then
								 PKG_Table.Set_Property(PC$TableName, 'SET_IMAGE=[INDEX_IMAGE],'|| iNbRows || ',' || d);
								 Loop
								   LC$Image := PKG_LAF.Get_B64_Chunk ;
								   If LC$Image Is Not Null Then
								     PKG_Table.Set_Property(PC$TableName, 'SET_IMAGE=' || LC$Image);
								   Else
								   	 PKG_Table.Set_Property(PC$TableName, 'SET_IMAGE=[END_IMAGE]');
								   	 Exit ;
								   End if ;	
								 End loop ;
								 synchronize;
							Else
								 	trace_error('Display_Table()','Error select image:' || LC$Query); 
							End if ;	          	    
          End if ;	
          d := d + 1 ;
          End if ;
        END LOOP ;
       
        PKG_Table.Set_Property(PC$TableName, 'SET_DATA=' || LC$Line);

      ELSE
        -- No more rows --
        EXIT;
      END IF;
    END LOOP;

    dbms_sql.close_cursor(source_cursor);
    
    synchronize;
    
    Return iNbrows;

  Exception
    	When others then
    	trace_error('Display_Table()','Error:' || SQLERRM); 
    	raise form_trigger_failure;
    	return 0;
	End Display_table;
	
	-------------------------------------
	--  set one or several properties  --
	-------------------------------------
	PROCEDURE Set_Property
	(  
	  PC$TableName IN Varchar2,
	  PC$Props     IN Varchar2
	)Is
	  LC$Tok   Varchar2(32767);
	  i        pls_integer := 1 ;
	  j        pls_integer := 1 ;
	  LN$pos   pls_integer ;
	  LC$Prop  Varchar2(32767);
	  LC$Val   Varchar2(32767);
	  LC$Val2  Varchar2(200);
	  LC$Name  Varchar2(60) := upper(PC$TableName);
	  LB$B     boolean;
	  
	Begin
		
		-- table defined ? --
		If Not GT$Tables.exists(LC$Name) And Upper(PC$Props) not like 'REMOVE%' Then
			 trace_error('Set_Property()','Table:' || PC$TableName || ' not declared');
			 return;
		End if ;

		Loop

			  If Upper(Substr(PC$Props,1,10)) = 'SET_IMAGE=' Then
			  	 LC$Prop := 'SET_IMAGE';
			  	 LC$Val := Substr( PC$Props, 11, 32767);
			  Else	  
				  LC$Tok := Split( PC$Props, i, '|' );
				  exit when LC$Tok = GC$EndSplit;
				  LN$pos := instr( LC$Tok, '=' );
				  If LN$pos > 0 Then
				 	  LC$Prop := Substr( LC$Tok, 1, LN$Pos-1 ) ;
				 	  LC$Val := Substr( LC$Tok, LN$Pos+1 ) ;
				  Else
				 	  LC$Prop := LC$Tok ;
				  End if ;	  
			  End if ;

				If Upper(LC$Prop) = 'TITLE' Then
					GT$Tables(LC$Name).TTitle := LC$Val ;  
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_TITLE', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'TITLE_ALIGN' Then
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_TITLE_ALIGN', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'TITLE_COLORS' Then
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_TITLE_COLORS', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'TITLE_FONT' Then
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_TITLE_FONT', LC$Name || '|' || LC$Val );										
				ElsIf Upper(LC$Prop) = 'TITLE_SHOW' Then
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_SHOW_TITLE', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'TOTAL_COLORS' Then
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_TOTAL_COLORS', LC$Name || '|' || LC$Val );					
				ElsIf Upper(LC$Prop) = 'BEAN' Then
					GT$Tables(LC$Name).TBean := LC$Val ;      
				ElsIf Upper(LC$Prop) = 'TABLE' Then      
					GT$Tables(LC$Name).TTable := LC$Val ;      
				ElsIf Upper(LC$Prop) = 'QUERY' Then      
					GT$Tables(LC$Name).TQuery := LC$Val ;      
				ElsIf Upper(LC$Prop) = 'WHERE' Then      
					GT$Tables(LC$Name).TWhere := LC$Val ;
				ElsIf Upper(LC$Prop) = 'XPOS' Then
					GT$Tables(LC$Name).TPosX := LC$Val ;      
				ElsIf Upper(LC$Prop) = 'YPOS' Then      
					GT$Tables(LC$Name).TPosY := LC$Val ;      
				ElsIf Upper(LC$Prop) = 'WIDTH' Then      
					GT$Tables(LC$Name).TWidth := LC$Val ;      
				ElsIf Upper(LC$Prop) = 'HEIGHT' Then      
					GT$Tables(LC$Name).THeight := LC$Val ; 
				ElsIf Upper(LC$Prop) = 'ORDER' Then      
					GT$Tables(LC$Name).TOrder := LC$Val ;      
				ElsIf Upper(LC$Prop) = 'PAGESIZE' Then   
					GT$Tables(LC$Name).TPageSize := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_PAGE_SIZE', LC$Name || '|' || LC$Val );          
				ElsIf Upper(LC$Prop) = 'PAGE_REFRESH' Then   					
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_REFRESH', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'CURRENTPAGE' Then
					GT$Tables(LC$Name).TCurrentPage := LC$Val ;      
				ElsIf Upper(LC$Prop) = 'UPDATE' Then     
					GT$Tables(LC$Name).TUpdate := LC$Val;  
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_UPDATE', LC$Name || '|' || LC$Val );    
				ElsIf Upper(LC$Prop) = 'SET_DATA' Then     
          Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_DATA', LC$Name || '|' ||LC$Val ) ;					
				ElsIf Upper(LC$Prop) = 'SET_IMAGE' Then     
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_IMAGE', LC$Name || '|' ||LC$Val ) ;
					Exit;
				ElsIf Upper(LC$Prop) = 'LOCATE_IMAGE' Then     
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_IMAGE_TO_READ', LC$Name || '|' ||LC$Val ) ;
				ElsIf Upper(LC$Prop) = 'INSERT' Then     
					GT$Tables(LC$Name).TInsert := LC$Val ; 
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_INSERT', LC$Name || '|' || LC$Val );     
				ElsIf Upper(LC$Prop) = 'DELETE' Then     
					GT$Tables(LC$Name).TDelete := LC$Val ; 
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_DELETE', LC$Name || '|' || LC$Val );     
				ElsIf Upper(LC$Prop) = 'BOUNDS' Then     
					j := 1 ;
					Loop
						LC$Val2 := Split( LC$Val, j, ',');
						exit when LC$Val2 = GC$EndSplit ;
						If    j = 1 Then GT$Tables(LC$Name).TPosX := LC$Val2 ;
						elsIf j = 2 Then GT$Tables(LC$Name).TPosY := LC$Val2 ;
						elsIf j = 3 Then GT$Tables(LC$Name).TWidth := LC$Val2 ;
						elsIf j = 4 Then GT$Tables(LC$Name).THeight := LC$Val2 ;
						End if ;
						j := j + 1 ;
					End loop;
					If j = 5 Then
						Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_BOUNDS', LC$Name  
							|| '|'  || GT$Tables(LC$Name).TPosX
							|| ','  || GT$Tables(LC$Name).TPosY
							|| ','  || GT$Tables(LC$Name).TWidth
							|| ','  || GT$Tables(LC$Name).THeight																							
						) ;
					End if ;
				ElsIf Upper(LC$Prop) = 'DECSEP' Then     
					GT$Tables(LC$Name).TDecSep := LC$Val ;   
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_DECIMAL_SEPARATORS', LC$Name || '|' || LC$Val );   
				ElsIf Upper(LC$Prop) = 'DATEFORMAT' Then 
					GT$Tables(LC$Name).TDateFormat := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_DATE_FORMAT', LC$Name || '|' || LC$Val );         
				ElsIf Upper(LC$Prop) = 'NUMFORMAT' Then  
					GT$Tables(LC$Name).TNumFormat := LC$Val ;  
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_NUM_FORMAT', LC$Name || '|' || LC$Val );             
				ElsIf Upper(LC$Prop) = 'INTFORMAT' Then  
					GT$Tables(LC$Name).TIntFormat := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_INT_FORMAT', LC$Name || '|' || LC$Val );         
				ElsIf Upper(LC$Prop) = 'BACKGROUND' Then  
					GT$Tables(LC$Name).TBACKGROUND := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_BACKGROUND', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'CURRENT' Then  
					GT$Tables(LC$Name).TCURRENT := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_CURRENT', LC$Val );
				ElsIf Upper(LC$Prop) = 'COLSMAXWIDTH' Then  
					GT$Tables(LC$Name).TCOLSMAXWIDTH := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_COLS_MAX_WIDTH', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'CELLPROP' Then  
					GT$Tables(LC$Name).TCELLPROP := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_CELL_PROPERTY', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'CELLINSTPROP' Then  
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_CELL_INST_PROPERTY', LC$Name || '|' || LC$Val );					
				ElsIf Upper(LC$Prop) = 'CELLVALUE' Then  
					GT$Tables(LC$Name).TCELLVALUE := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_CELL_VALUE', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'CURCELLVALUE' Then  
					GT$Tables(LC$Name).TCURCELLVALUE := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_CURRENT_CELL_VALUE', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'ROWPROP' Then  
					GT$Tables(LC$Name).TROWPROP := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_ROW_PROPERTY', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'TOTALLINE' Then  
					GT$Tables(LC$Name).TTOTALLINE := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_TOTAL_LINE', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'TOTALLINELABELS' Then  
					GT$Tables(LC$Name).TTOTALLINELABELS := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_TOTAL_LINE_LABELS', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'FILTER' Then  
					GT$Tables(LC$Name).TFILTER := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_FILTER', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'HEADFG' Then  
					GT$Tables(LC$Name).THEADFG := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_HEADFG', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'HEADBG' Then  
					GT$Tables(LC$Name).THEADBG := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_HEADBG', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'HEADHEIGHT' Then  
					GT$Tables(LC$Name).THEADHEIGHT := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_HEADER_HEIGHT', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'TOTALHEADHEIGHT' Then  
					GT$Tables(LC$Name).TTOTALHEADHEIGHT := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_TOTAL_HEADER_HEIGHT', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'DATAFG' Then  
					GT$Tables(LC$Name).TDATAFG := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_DATAFG', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'DATABG' Then  
					GT$Tables(LC$Name).TDATABG := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_DATABG', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'TABLEBG' Then  
					GT$Tables(LC$Name).TTABLEBG := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_TABLEBG', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'GRIDFG' Then  
					GT$Tables(LC$Name).TGRIDFG := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_GRIDFG', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'CELLPOS' Then  
					GT$Tables(LC$Name).TCELLPOS := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_CELLPOS', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'CELLCURRENTPOS' Then  
					GT$Tables(LC$Name).TCELLPOS := LC$Val ;					
				ElsIf Upper(LC$Prop) = 'ROWPOS' Then  
					GT$Tables(LC$Name).TROWPOS := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_ROWPOS', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'ROWCURRENTPOS' Then  
					GT$Tables(LC$Name).TROWPOS := LC$Val ;					
				ElsIf Upper(LC$Prop) = 'ROWIDPOS' Then  
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_ROWIDPOS', LC$Name || '|' || LC$Val );					
				ElsIf Upper(LC$Prop) = 'SEPARATOR' Then  
					GT$Tables(LC$Name).TSEPARATOR := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_SEPARATOR', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'IMAGESIZE' Then  
					GT$Tables(LC$Name).TIMAGESIZE := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_IMAGE_SIZE', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'REORDER' Then  
					GT$Tables(LC$Name).TREORDER := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_REORDER_COLUMNS', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'RESIZE' Then  
					GT$Tables(LC$Name).TRESIZE := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_RESIZE_COLUMNS', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'BORDER' Then  
					GT$Tables(LC$Name).TBORDER := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_BORDER', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'PANELBORDER' Then  
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_PANEL_BORDER', LC$Name || '|' || LC$Val );					
				ElsIf Upper(LC$Prop) = 'SELECTBACK' Then  
					GT$Tables(LC$Name).TSELECTBACK := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_SELECTION_BACKGROUND', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'SELECTFORE' Then  
					GT$Tables(LC$Name).TSELECTFORE := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_SELECTION_FOREGROUND', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'LOCALE' Then  
					GT$Tables(LC$Name).TLOCALE := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_LOCALE', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'VLINE' Then  
					GT$Tables(LC$Name).TVLINE := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_VERTICAL_LINE', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'HLINE' Then  
					GT$Tables(LC$Name).THLINE := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_HORIZONTAL_LINE', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'RESIZEMODE' Then  
					GT$Tables(LC$Name).TRESIZEMODE := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_RESIZE_MODE', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'TRACE' Then  
					GT$Tables(LC$Name).TTRACE := LC$Val ;	
				ElsIf Upper(LC$Prop) = 'VISIBLEROWS' Then  
					GT$Tables(LC$Name).TVISIBLEROWS := LC$Val ;	
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_VISIBLE_ROWS', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'ARRAYSIZE' Then  
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_ARRAYSIZE', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'HEADER' Then  
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_HEADER', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'COLSTYPE' Then  
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_COLS_TYPE', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'INIT' Then  						
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'TB_INIT', LC$Name ) ;
				ElsIf Upper(LC$Prop) = 'CLEAR_REFRESH' Then  						
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'TB_CLEAR_REFRESH', LC$Name ) ;					
				ElsIf Upper(LC$Prop) = 'VISIBLE' Then  
					GT$Tables(LC$Name).TVISIBLE := LC$Val ;
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_VISIBLE', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'ROWID' Then  
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_ROWID', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'INSERT_DONE' Then  
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_INSERT_DONE', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'UPDATE_DONE' Then  
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_UPDATE_DONE', LC$Name || '|' || LC$Val );					
				ElsIf Upper(LC$Prop) = 'DELETE_DONE' Then  
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_DELETE_DONE', LC$Name || '|' || LC$Val );																				
				ElsIf Upper(LC$Prop) = 'REMOVE' Then  
					If GT$Tables.Exists(LC$Name) Then
						Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'TB_REMOVE', LC$Name );						
						GT$Tables.Delete(LC$Name) ;
					End if ;										
				ElsIf Upper(LC$Prop) = 'LOG' Then  
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_LOG', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'EXTEND_EDITOR' Then  
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_EDIT_EXTEND', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'EDITOR_LABELS' Then  
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_EDITOR_LABELS', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'FIND_LABELS' Then  
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_FIND_LABELS', LC$Name || '|' || LC$Val );	
				ElsIf Upper(LC$Prop) = 'FOCUS' Then  
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_FOCUS', LC$Name || '|' || LC$Val );					
				ElsIf Upper(LC$Prop) = 'ADD_ROW' Then  
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_INSERT_ROW', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'DEL_ROW' Then  
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_DELETE_ROW', LC$Name || '|' || LC$Val );            										
				ElsIf Upper(LC$Prop) = 'EXTEND' Then  
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_EXTEND', LC$Name || '|' || LC$Val );					
				ElsIf Upper(LC$Prop) = 'SHOW' Then  
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'TB_SHOW', LC$Name || '|' || LC$Val );
				ElsIf Upper(LC$Prop) = 'CHECKBOX' Then  
					j := GT$Tables(LC$Name).TCHECKBOX.Count + 1 ; 
					GT$Tables(LC$Name).TCHECKBOX(j) := LC$Val ;
				ElsIf Upper(LC$Prop) = 'ALERT_STRINGS' Then  
					Set_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'SET_TB_ALERT_STRINGS', LC$Name || '|' || LC$Val );					
				Else
					 trace_error('Set_Property()','Table:' || LC$Name || ' Unknown property: ' || PC$Props);
				 	 raise form_trigger_failure;
				End if;
			 i := i + 1 ;
		End loop;
	End Set_Property;
	
	----------------------------
	--  get a table property  --
	----------------------------
	FUNCTION Get_Property
	(  
	  PC$TableName IN Varchar2,
	  PC$Prop      IN Varchar2,
	  PC$Prop2     IN Varchar2  default null
	) Return Varchar2
	Is
		LC$Name  Varchar2(60) := upper(PC$TableName);	
	Begin
		-- table defined ? --
		If Not GT$Tables.exists(LC$Name) Then
				 trace_error('Get_Property()','Table:' || PC$TableName || ' not declared');
			   return null;
		End if ;

		If Upper(PC$Prop) = 'TITLE' Then
			Return GT$Tables(LC$Name).TTitle ;
		ElsIf Upper(PC$Prop) = 'BEAN' Then
			Return GT$Tables(LC$Name).TBean ;
		ElsIf Upper(PC$Prop) = 'TABLE' Then      
			Return GT$Tables(LC$Name).TTable ;
		ElsIf Upper(PC$Prop) = 'QUERY' Then      
			Return GT$Tables(LC$Name).TQuery ;
		ElsIf Upper(PC$Prop) = 'WHERE' Then      
			Return GT$Tables(LC$Name).TWhere ;
		ElsIf Upper(PC$Prop) = 'XPOS' Then
			Return GT$Tables(LC$Name).TPosX ;
		ElsIf Upper(PC$Prop) = 'YPOS' Then      
			Return GT$Tables(LC$Name).TPosY ;
		ElsIf Upper(PC$Prop) = 'WIDTH' Then      
			Return GT$Tables(LC$Name).TWidth;
		ElsIf Upper(PC$Prop) = 'HEIGHT' Then      
			Return GT$Tables(LC$Name).THeight ;
		ElsIf Upper(PC$Prop) = 'ORDER' Then      
			Return GT$Tables(LC$Name).TOrder ;
		ElsIf Upper(PC$Prop) = 'PAGESIZE' Then   
			Return GT$Tables(LC$Name).TPageSize;
		ElsIf Upper(PC$Prop) = 'CURRENTPAGE' Then
			Return GT$Tables(LC$Name).TCurrentPage ;      
		ElsIf Upper(PC$Prop) = 'UPDATE' Then     
			Return GT$Tables(LC$Name).TUpdate;      
		ElsIf Upper(PC$Prop) = 'INSERT' Then     
			Return GT$Tables(LC$Name).TInsert;      
		ElsIf Upper(PC$Prop) = 'DELETE' Then     
			Return GT$Tables(LC$Name).TDelete;      
		ElsIf Upper(PC$Prop) = 'BOUNDS' Then     
			Return GT$Tables(LC$Name).TPosX || ',' || GT$Tables(LC$Name).TPosY || ',' || GT$Tables(LC$Name).TWidth || ',' || GT$Tables(LC$Name).THeight ;
		ElsIf Upper(PC$Prop) = 'DECSEP' Then     
			Return GT$Tables(LC$Name).TDecSep;      
		ElsIf Upper(PC$Prop) = 'DATEFORMAT' Then 
			Return GT$Tables(LC$Name).TDateFormat;      
		ElsIf Upper(PC$Prop) = 'NUMFORMAT' Then  
			Return GT$Tables(LC$Name).TNumFormat;      
		ElsIf Upper(PC$Prop) = 'INTFORMAT' Then  
			Return GT$Tables(LC$Name).TIntFormat;
		ElsIf Upper(PC$Prop) = 'BACKGROUND' Then  
			Return GT$Tables(LC$Name).TBackground;
		ElsIf Upper(PC$Prop) = 'CURRENT' Then  
			Return GT$Tables(LC$Name).TCurrent;
		ElsIf Upper(PC$Prop) = 'COLSMAXWIDTH' Then  
			Return GT$Tables(LC$Name).TCOLSMAXWIDTH ;
		ElsIf Upper(PC$Prop) = 'CELLPROP' Then  
			Return GT$Tables(LC$Name).TCELLPROP ;
		ElsIf Upper(PC$Prop) = 'CELLVALUE' Then  
			Return GT$Tables(LC$Name).TCELLVALUE ;
		ElsIf Upper(PC$Prop) = 'CURCELLVALUE' Then  
			Return GT$Tables(LC$Name).TCURCELLVALUE ;
		ElsIf Upper(PC$Prop) = 'ROWPROP' Then  
			Return GT$Tables(LC$Name).TROWPROP ;
		ElsIf Upper(PC$Prop) = 'TOTALLINE' Then  
			Return GT$Tables(LC$Name).TTOTALLINE ;
		ElsIf Upper(PC$Prop) = 'TOTALLINELABELS' Then  
			Return GT$Tables(LC$Name).TTOTALLINELABELS ;
		ElsIf Upper(PC$Prop) = 'FILTER' Then  
			Return GT$Tables(LC$Name).TFILTER ;
		ElsIf Upper(PC$Prop) = 'HEADFG' Then  
			Return GT$Tables(LC$Name).THEADFG ;
		ElsIf Upper(PC$Prop) = 'HEADBG' Then  
			Return GT$Tables(LC$Name).THEADBG ;
		ElsIf Upper(PC$Prop) = 'HEADHEIGHT' Then  
			Return GT$Tables(LC$Name).THEADHEIGHT ;
		ElsIf Upper(PC$Prop) = 'TOTALHEADHEIGHT' Then  
			Return GT$Tables(LC$Name).TTOTALHEADHEIGHT ;
		ElsIf Upper(PC$Prop) = 'DATAFG' Then  
			Return GT$Tables(LC$Name).TDATAFG ;
		ElsIf Upper(PC$Prop) = 'DATABG' Then  
			Return GT$Tables(LC$Name).TDATABG ;
		ElsIf Upper(PC$Prop) = 'TABLEBG' Then  
			Return GT$Tables(LC$Name).TTABLEBG ;
		ElsIf Upper(PC$Prop) = 'GRIDFG' Then  
			Return GT$Tables(LC$Name).TGRIDFG ;
		ElsIf Upper(PC$Prop) = 'CELLPOS' Then  
			Return GT$Tables(LC$Name).TCELLPOS ;
		ElsIf Upper(PC$Prop) = 'ROWPOS' Then  
			Return GT$Tables(LC$Name).TROWPOS ;
		ElsIf Upper(PC$Prop) = 'SEPARATOR' Then  
			Return GT$Tables(LC$Name).TSEPARATOR ;
		ElsIf Upper(PC$Prop) = 'IMAGESIZE' Then  
			Return GT$Tables(LC$Name).TIMAGESIZE ;
		ElsIf Upper(PC$Prop) = 'REORDER' Then  
			Return GT$Tables(LC$Name).TREORDER ;
		ElsIf Upper(PC$Prop) = 'RESIZE' Then  
			Return GT$Tables(LC$Name).TRESIZE ;
		ElsIf Upper(PC$Prop) = 'BORDER' Then  
			Return GT$Tables(LC$Name).TBORDER ;
		ElsIf Upper(PC$Prop) = 'SELECTBACK' Then  
			Return GT$Tables(LC$Name).TSELECTBACK ;
		ElsIf Upper(PC$Prop) = 'SELECTFORE' Then  
			Return GT$Tables(LC$Name).TSELECTFORE ;
		ElsIf Upper(PC$Prop) = 'LOCALE' Then  
			Return GT$Tables(LC$Name).TLOCALE ;
		ElsIf Upper(PC$Prop) = 'VLINE' Then  
			Return GT$Tables(LC$Name).TVLINE ;
		ElsIf Upper(PC$Prop) = 'HLINE' Then  
			Return GT$Tables(LC$Name).THLINE ;
		ElsIf Upper(PC$Prop) = 'RESIZEMODE' Then  
			Return GT$Tables(LC$Name).TRESIZEMODE ;
		ElsIf Upper(PC$Prop) = 'VISIBLEROWS' Then  
			Return GT$Tables(LC$Name).TVISIBLEROWS ;
		ElsIf Upper(PC$Prop) = 'VISIBLE' Then  
			Return GT$Tables(LC$Name).TVISIBLE ;
		ElsIf Upper(PC$Prop) = 'EXTEND' Then  
			Return GT$Tables(LC$Name).TEXTEND ;
		ElsIf Upper(PC$Prop) = 'TRACE' Then  
			Return GT$Tables(LC$Name).TTRACE ;
		ElsIf Upper(PC$Prop) = 'LOG' Then  
			Return GT$Tables(LC$Name).TBEANLOG ;									
		ElsIf Upper(PC$Prop) = 'ROWVAL' Then  			
      Return Get_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'GET_TB_ROWVAL');
    ElsIf Upper(PC$Prop) = 'CELLVAL' Then  			
      Return Get_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'GET_TB_CELLVAL');			
		ElsIf Upper(PC$Prop) = 'COUNT_INSERT' Then  
			Return Get_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'GET_TB_COUNT_INSERT');
		ElsIf Upper(PC$Prop) = 'COUNT_UPDATE' Then  
			Return Get_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'GET_TB_COUNT_UPDATE');
		ElsIf Upper(PC$Prop) = 'COUNT_DELETE' Then  
			Return Get_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'GET_TB_COUNT_DELETE');
		ElsIf Upper(PC$Prop) = 'COUNT_CHANGES' Then  
			Return Get_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'GET_TB_COUNT_CHANGES');
		ElsIf Upper(PC$Prop) = 'ROWS_CHANGED' Then  
			Return Get_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'GET_TB_ROWS_CHANGED');
		ElsIf Upper(PC$Prop) = 'ROWS_INSERTED' Then  
			Return Get_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'GET_TB_ROWS_INSERTED');
		ElsIf Upper(PC$Prop) = 'ROWS_DELETED' Then  
			Return Get_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'GET_TB_ROWS_DELETED');						
		ElsIf Upper(PC$Prop) = 'IDENTIFIED_ROW' Then  
			Return Get_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'GET_TB_IDENTIFIED_ROW');
		ElsIf Upper(PC$Prop) = 'GET_IMAGE_CONTENT' Then  
			Return Get_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'GET_TB_IMAGE_CONTENT');
		ElsIf Upper(PC$Prop) = 'CURRENT_ROW' Then  
			Return Get_Custom_Property( GT$Tables(LC$Name).TBean, 1, 'GET_TB_CURRENT_ROW');			
		ElsIf Upper(PC$Prop) = 'COLUMN_TYPE' Then  			
		  Return Get_Column_Type(GT$Tables(LC$Name).TCOLUMNS, PC$Prop2);
		Else
			 trace_error('Get_Property()','Table:' || PC$TableName || 'Set_Property() Unknown property: ' || PC$Prop);		
			raise form_trigger_failure;
		End if;
					
			return null;
		
	End Get_Property;	
	
	-----------------------------------
	--  Display the value of a cell  --
	-----------------------------------
	PROCEDURE Display_Cell_Value
	(  
	   PC$TableName IN Varchar2
	  ,PN$Row       IN Pls_integer
	  ,PN$Cell      IN Pls_integer	  
	)Is
		LC$Name  Varchar2(60) := upper(PC$TableName);	
		LC$Value Varchar2(32767);
	Begin
		-- table defined ? --
		If Not GT$Tables.exists(LC$Name) Then
				 trace_error('Display_Cell_Value()','Table:' || PC$TableName || ' not declared');
			   return ;
		End if ;
		If PN$Row < 1 Or PN$Cell < 1 Then
				 trace_error('Display_Cell_Value()','Table:' || PC$TableName || ' Row and Cell must be greater than 0');
			   return ;
		End if ;		
		If Upper(GT$Tables(LC$Name).TCOLUMNS(PN$Cell).COLTYPE) = 'IMAGE' Then
			 LC$Value := '[IMAGE]';
		ElsIf Upper(GT$Tables(LC$Name).TCOLUMNS(PN$Cell).COLTYPE) = 'CLOB' Then
			 LC$Value := '[CLOB]';			 
		Else	
			PKG_Table.Set_Property(PC$TableName, 'CELLPOS='||PN$Row || ',' || Ltrim(To_Char(PN$Cell))); 
			LC$Value := PKG_Table.Get_Property(PC$TableName, 'CELLVAL') ;
		End if ;
		trace_error('Display_Cell_Value()','Table:' || PC$TableName 
		     || ' cell(' || PN$Row || ',' || PN$Cell || ')=' || LC$Value);
	End;
	
	----------------------------------
	--  Display the value of a row  --
	----------------------------------
	PROCEDURE Display_Row_Value
	(  
	   PC$TableName IN Varchar2
	  ,PN$Row       IN Pls_integer
	)Is
		LC$Name  Varchar2(60) := upper(PC$TableName);
		LC$Value Varchar2(32767);
		LC$Val2  Varchar2(32767);		
		LC$Tok   Varchar2(32767);		
		j        Pls_integer := 0;
	Begin
		-- table defined ? --
		If Not GT$Tables.exists(LC$Name) Then
				 trace_error('Display_Row_Value()','Table:' || PC$TableName || ' not declared');
			   return;
		End if ;
		If PN$Row < 1 Then
				 trace_error('Display_Row_Value()','Table:' || PC$TableName || ' Row must be greater than 0');
			   return ;
		End if ;		
		PKG_Table.Set_Property(PC$TableName, 'ROWPOS='||PN$Row); 
		LC$Value := PKG_Table.Get_Property(PC$TableName, 'ROWVAL') ;
		If GT$Tables(LC$Name).TCOLUMNS.count > 0 Then
			For i in 1 .. GT$Tables(LC$Name).TCOLUMNS.count Loop
				  If Upper(GT$Tables(LC$Name).TCOLUMNS(i).COLTYPE) = 'IMAGE' Then
					  LC$Val2 := LC$Val2 || GT$Tables(LC$Name).TCOLUMNS(i).COLNAME 
					   || ': [IMAGE]' || chr(10);
					ElsIf Upper(GT$Tables(LC$Name).TCOLUMNS(i).COLTYPE) = 'CLOB' Then
					  LC$Val2 := LC$Val2 || GT$Tables(LC$Name).TCOLUMNS(i).COLNAME 
					   || ': [CLOB]' || chr(10);		
				  Else	
					  j := j + 1 ;
					  LC$Val2 := LC$Val2 || GT$Tables(LC$Name).TCOLUMNS(i).COLNAME 
					   || ':' || Nvl(Replace(Split( LC$Value, j, GC$Sep ),GC$EndSplit,'null'),'null') || chr(10);
				  End if ; 
			End loop;	 
		End if ;	
		trace_error('Display_Row_Value()','Table:' || PC$TableName || ' row(' || PN$Row || ')' || chr(10) || LC$Val2);				
	End;	
	
	-----------------------------------------
	--  Write an image to a database BLOB  --
	-----------------------------------------
	PROCEDURE Write_Image 
	(
     PC$TableName IN Varchar2
    ,PC$Table     IN VARCHAR2
    ,PC$Column    IN VARCHAR2
    ,PC$Clause    IN VARCHAR2
    ,PN$Row       IN PLS_INTEGER
    ,PN$Cell      IN PLS_INTEGER
    ,PB$Silent    IN Boolean default true	       
  )
  IS
	    LC$Req  Varchar2(32000);
	    LN$Cpt  Pls_integer := 0 ;
	    LC$Res  Varchar2(2000) ;
	    LN$Read Pls_integer := 0 ;
	BEGIN
	    --
	    -- Save the image to the database
	    --
	    PKG_Table.Set_Property(PC$TableName, 'LOCATE_IMAGE='|| PN$Row || ',' || PN$Cell);
	    If PKG_Table.Get_Property(PC$TableName, 'IDENTIFIED_ROW') = 'true' Then	    	
		    Loop
		    	 -- Get the image chunk from the Java Bean --
		    	 LC$Req := PKG_Table.Get_Property(PC$TableName, 'GET_IMAGE_CONTENT');
		    	 Exit When LC$Req is null ;
		    	 LN$Cpt := LN$Cpt + 1 ;
		    	 LN$Read := LN$Read + Length(LC$Req);
		    	 If Ln$Cpt = 1 Then
		    	 	  Pkg_LAF.Init_Transfer ;
		    	 End if ;	  
		    	 -- Send the image chunks to the Database --
		    	 Pkg_LAF.Set_B64_Chunk(LC$Req);
		    End loop;
		    If Not PB$Silent Then 
			      trace_message(PC$TableName,'Write_Image()','Table:' || PC$TableName 
			      || ' chunks read:' || LN$Cpt );
		    End if ;		    
		    If LN$Cpt > 0 Then
		      -- Update the Blob column with the new content --
		      LC$Res := Pkg_LAF.Save_Blob(PC$Table, PC$Column, PC$Clause );
		      If Not PB$Silent Then 
			      trace_message(PC$TableName,'Write_Image()','Table:' || PC$TableName 
			      || ' image saved to ' || PC$Table || '.' || PC$Column || ' with (' || PC$Clause || ') '
			      || LC$Res );
		      End if ;
		    Else
		    	LC$Req := 'UPDATE ' || PC$Table || ' SET ' || PC$Column || ' =EMPTY_BLOB() WHERE '
		    	       || PC$Clause;
		      If Not PB$Silent Then 
			      trace_message(PC$TableName,'Write_Image()','Table:' || PC$TableName 
			      || ' : ' || LC$Req );
		      End if ;
		    	forms_ddl(LC$Req);
		    End if ;
		  Else
		    	If Not PB$Silent Then 
		    	  trace_message(PC$TableName,'Write_Image()','Table:' || PC$TableName || ' unable to localize image at row(' || PN$Row || ',' || PN$Cell || ')' );				
		    	End if ;
	    End if ; 
	Exception
  	When OTHERS Then
     	trace_error('Write_Image','Error:' || SQLERRM); 		
     	raise form_trigger_failure;
	END Write_Image;
	
	------------------------------
	--  Update a database CLOB  --
	------------------------------
	PROCEDURE Update_CLOB
	(
     PC$TableName IN Varchar2
    ,PC$Bean      IN VARCHAR2
    ,PC$Query     IN VARCHAR2
    ,PN$Row       IN PLS_INTEGER
    ,PN$Cell      IN PLS_INTEGER
    ,PB$Silent    IN Boolean default true	       
  )
  IS
	    LC$Qry  Varchar2(32000);
	    LN$Cpt  Pls_integer := 0 ;
	    LC$Msg  Varchar2(2000) ;
	    LN$Read Pls_integer := 0 ;
	    LB$Ok   Boolean;
	BEGIN
	    --
	    -- Save the CLOB to the database
	    --
	    PKG_Table.Set_Property(PC$TableName, 'CELLPOS='||PN$Row || ',' || Ltrim(To_Char(PN$Cell))); 
			LB$Ok := PKG_LOB.Write_Lob_Table(PC$TableName, 'CLOB', PC$Bean, PC$Query, LC$Msg);
		  If Not LB$Ok Then
		    	If Not PB$Silent Then 
		    	  trace_message(PC$TableName,'Update_CLOB()','Table:' || PC$TableName || ' error:' || LC$Msg );				
		    	End if ;
	    End if ; 
	END Update_CLOB;
	
	-----------------------------
	--  returns a column type  --
	-----------------------------
	FUNCTION Get_Column_Type
	(
	   PT$Cols    IN TAB_COLS_TAB
	  ,PC$ColName IN Varchar2 
	)
	Return varchar2
	Is
	Begin
		If PT$Cols.count > 0 Then
			For i IN 1 .. PT$Cols.count Loop
				 If Upper(PT$Cols(i).COLNAME) = Upper(PC$ColName) Then
				 	  return PT$Cols(i).COLTYPE;
				 End if ; 
			End loop;	
		End if ;
		return null;
	end Get_Column_Type;
	
	
	---------------------------
	--  set a LAF Bean name  --
	---------------------------
	PROCEDURE Set_Bean_Name
	(  
	  PC$Bean  IN Varchar2	
	)
	Is
	Begin
	  If GC$Bean is null and PC$Bean is not null Then
	  	 GC$Bean := PC$Bean ;
	  End if ;
	End;
	
END;

PACKAGE PKG_TOOLS IS
  
  -- return pixels from any coordinate system --
  Function To_Pixel( PN$Coord1  In Number )
  Return Pls_Integer ;
  
  Function To_Current_Coord( PN$Coord1  In Number )
  Return Number ;  
  
  Function To_Pixel
    ( 
       PN$Coord1     In Number,
       PN$Coord2     In Number,
       PC$Separator  In Varchar2 Default '|'
     )
  Return Varchar2 ;
  
  Function To_Current_Coord
    ( 
       PN$Coord1     In Number,
       PN$Coord2     In Number,
       PC$Separator  In Varchar2 Default '|'
     )
  Return Varchar2 ;  
  
  Procedure Show_In_Rect 
	( 
	   PC$Item  in varchar2
	  ,PC$Strip in varchar2
	  ,PC$Bean  in varchar2
	);
	
	PROCEDURE init_laf_blocks
	(
	   PC$Blk1   in varchar2 default null
	  ,PC$Blk2   in varchar2 default null
	  ,PC$Blk3   in varchar2 default null
	) ;
	
	PROCEDURE Paste_to_block
	(
	   PC$Block    in varchar2
	  ,PC$Bean     in varchar2 
	  ,PB$Header   in boolean default FALSE
	  ,PN$From     in pls_integer default 1
	  ,PC$Items    in varchar2 default null
	  ,PC$FieldSep in varchar2 default CHR(9)
	) ;	
	
	PROCEDURE Copy_From_block
	(
	   PC$Block    in varchar2
	  ,PC$Bean     in varchar2 
	  ,PB$Header   in boolean default FALSE
	  ,PN$From     in pls_integer default 1
	  ,PC$Items    in varchar2 default null
	  ,PC$FieldSep in varchar2 default CHR(9)
	) ;
	
	PROCEDURE highlight_record
	(
	   PC$Block  in varchar2
	) ;
	
	PROCEDURE Get_BigText_Content
	(
	  PC$Item  in varchar2,
	  PL$Clob  in out nocopy CLOB
	) ;
	
    
END;


PACKAGE BODY PKG_TOOLS IS
  
  --
  --  Return any system coordinate given value
  --  to pixels
  --
  
  Function To_Pixel( PN$Coord1  In Number )
  Return Pls_Integer
  Is
     -- Coordinate system --
     LC$Scoord   VARCHAR2(100) := Get_Form_Property( Name_in('system.current_form'), COORDINATE_SYSTEM ) ;
  Begin

    If LC$Scoord = 'PIXELS' Then
    	Return PN$Coord1 ;
    ElsIf LC$Scoord = 'INCHES' Then
      Return round(PN$Coord1 * 96.0024) ;
    ElsIf LC$Scoord = 'POINTS' Then 
      Return round(PN$Coord1 * 1.3333) ;
    ElsIf LC$Scoord = 'CENTIMETERS' Then 
      Return round(PN$Coord1 * 37.7949) ;
    End if ;
    
    Return 0 ;

  End;
  
  ---------------------------------------------------------------
  
  Function To_Pixel
    ( 
       PN$Coord1     In Number,
       PN$Coord2     In Number,
       PC$Separator  In Varchar2 Default '|'
     )
  Return Varchar2
  Is
     -- Coordinate system --
     LC$Scoord   Varchar2(100) := Get_Form_Property( Name_in('system.current_form'), COORDINATE_SYSTEM ) ;
     LC$Val      Varchar2(100);
  Begin

    If LC$Scoord = 'PIXELS' Then
    	Return PN$Coord1 || PC$Separator || PN$Coord2 ;
    ElsIf LC$Scoord = 'INCHES' Then
      Return round(PN$Coord1 * 96.0024) || PC$Separator || round(PN$Coord2 * 96.0024) ;
    ElsIf LC$Scoord = 'POINTS' Then 
      Return round(PN$Coord1 * 1.3333)  || PC$Separator || round(PN$Coord2 * 1.3333) ;
    ElsIf LC$Scoord = 'CENTIMETERS' Then 
      Return round(PN$Coord1 * 37.7949) || PC$Separator || round(PN$Coord2 * 37.7949) ;
    End if ;
    
    Return '0' || PC$Separator || '0' ;

  End;   


  --
  --  Return pixels to current coordinate corresponding value
  --
  
  Function To_Current_Coord( PN$Coord1  In Number )
  Return Number
  Is
     -- Coordinate system --
     LC$Scoord   VARCHAR2(100) := Get_Form_Property( Name_in('system.current_form'), COORDINATE_SYSTEM ) ;
  Begin

      If LC$Scoord = 'INCHES' Then
             Return PN$Coord1 * 0.01042 ;
      ElsIf LC$Scoord = 'POINTS' Then 
             Return PN$Coord1 * .75 ;
      ElsIf LC$Scoord = 'CENTIMETERS' Then 
             Return PN$Coord1 * 0.0264 ;
      ElsIf LC$Scoord = 'PIXELS' Then
    	       Return PN$Coord1 ;
      End if ;
    
    Return 0 ;

  End;
  
  ---------------------------------------------------------------
  
  Function To_Current_Coord
    ( 
       PN$Coord1     In Number,
       PN$Coord2     In Number,
       PC$Separator  In Varchar2 Default '|'
     )
  Return Varchar2
  Is
     -- Coordinate system --
     LC$Scoord   Varchar2(100) := Get_Form_Property( Name_in('system.current_form'), COORDINATE_SYSTEM ) ;
     LC$Val      Varchar2(100);
  Begin

      If LC$Scoord = 'INCHES' Then
             Return PN$Coord1 * 0.01042 || PC$Separator || PN$Coord2 * 0.01042 ;
      ElsIf LC$Scoord = 'POINTS' Then 
             Return PN$Coord1 * .75 || PC$Separator || PN$Coord2 * .75 ;
      ElsIf LC$Scoord = 'CENTIMETERS' Then 
             Return PN$Coord1 * 0.0263 || PC$Separator || PN$Coord2 * 0.0243 ;
      ElsIf LC$Scoord = 'PIXELS' Then
    	       Return PN$Coord1 || PC$Separator || PN$Coord2 ;
      End if ;
    
    Return '0' || PC$Separator || '0' ;

  End;   

  ---------------------------------------------------------------
    
	PROCEDURE Show_In_Rect 
	( 
	   PC$Item  in varchar2
	  ,PC$Strip in varchar2
	  ,PC$Bean  in varchar2
	)  
	IS
	  LN$x  number;
	  LN$y  number;
	  LN$w  number;
	  LN$h  number;      
	  it    item;
	BEGIN
		
		it := Find_Item(PC$Item);
		If not ID_Null(it) Then
			 LN$x := To_Pixel(Get_Item_Property( it, X_POS ));
			 LN$y := To_Pixel(Get_Item_Property( it, Y_POS ));
			 Set_Custom_Property( PC$Bean, 1, 'SHOW_IN_RECT'
			                    , PC$Item || '-' || LN$x || '-' || LN$y || '-' || PC$Strip );
	     If Name_In('System.Cursor_Item') = Upper(PC$Item) Then
	    		Next_item;
	     End if ;
			 Set_Item_Property( PC$Item, VISIBLE, PROPERTY_FALSE );
		End if ;	
	  
	END;  
	
  ---------------------------------------------------------------	
	
	-----------------------------------------------
	--  force display hidden blocks in order to  --
	--  use the Set_Custom_Property() built-in   --
	-----------------------------------------------
	PROCEDURE init_laf_blocks
	(
	   PC$Blk1   in varchar2 default null
	  ,PC$Blk2   in varchar2 default null
	  ,PC$Blk3   in varchar2 default null
	)
	IS
		LC$blockDeb  varchar2(60); -- start block
		LC$block     varchar2(60); -- current block name
		LC$item      varchar2(60); -- current item
		LC$itemdeb   varchar2(60); -- first item
		LC$View      varchar2(60);
		LB$Found     boolean;
		tt           pkg_look_and_feel.TYP_TAB_STRINGS;
	BEGIN
		LC$BlockDeb := get_form_property( NAME_IN('System.Current_Form'), FIRST_BLOCK ) ;
		LC$Block := LC$BlockDeb ;
		Loop -- For each block of the form
			If  LC$Block != Upper( Nvl( PC$Blk1, ' ')) 
			And LC$Block != Upper( Nvl( PC$Blk2, ' '))
			And LC$Block != Upper( Nvl( PC$Blk3, ' '))  Then			  
				LC$itemdeb := get_block_property(LC$BLOCK, FIRST_ITEM) ;
				LC$item := LC$BLOCK || '.' || LC$itemdeb ;
				While LC$itemdeb is not null loop -- For each item
					-- navigable item ? --
					IF GET_ITEM_PROPERTY(LC$Item , ITEM_TYPE) != 'DISPLAY ITEM' 
					And 	GET_ITEM_PROPERTY(LC$Item , NAVIGABLE) = 'TRUE' Then
								LC$View := GET_ITEM_PROPERTY(LC$Item , ITEM_CANVAS);
								If LC$View is not null Then
									 If tt.count = 0 Then
									 	  tt(tt.count+1) := LC$View ;
									 	  Show_View(LC$View);
									 	  Synchronize;
									 Else
									 	  LB$Found := false ;
									 	  For i in 1 .. tt.count loop
									 	  	IF tt(i) = LC$View Then
									 	  		  LB$Found := true ;
									 	  		  Exit ;
									 	  	End if ;	  
									 	  End loop;	
									 	  If Not LB$Found Then
									 	  	tt(tt.count+1) := LC$View ;
									 	  	Show_View(LC$View);
									 	  	Synchronize;
									 	  End if ;	
									 End if ;	
								End if ;	
					END IF;
					LC$itemdeb := get_item_property(LC$item, NEXTITEM );
					LC$item := LC$BLOCK || '.' || LC$itemdeb ;
				End loop ;
			End if ;
			LC$Block := get_block_property( LC$Block, NEXTBLOCK ) ; -- next block
			exit when LC$Block is null ;
		End loop ;
	END init_laf_blocks;

	---------------------------------------------------------------	
	
	--------------------------------
	--  Paste clipboard to block  --
	--------------------------------
	PROCEDURE Paste_to_block
	(
	   PC$Block    in varchar2
	  ,PC$Bean     in varchar2  
	  ,PB$Header   in boolean default FALSE
	  ,PN$From     in pls_integer default 1
	  ,PC$Items    in varchar2 default null
	  ,PC$FieldSep in varchar2 default CHR(9)
	)
	IS
		LC$item      varchar2(60); -- current item
		LC$itemdeb   varchar2(60); -- first item
	  LC$Line      Varchar2(32700);
	  LL$Text      clob;
	  LC$Col       Varchar2(2000);
	  LN$i         pls_integer := 1 ;	
	  LN$Insert    pls_integer := PN$From ;
	  Type         TYP_CHARS is table of varchar2(100) index by BINARY_INTEGER;
	  Items        TYP_CHARS;	
	BEGIN			  
    go_block(PC$Block);
    dbms_lob.createtemporary( LL$Text, TRUE ) ;  
    -- item to loop through --
    If PC$Items Is Not Null Then
    	 Loop
    	 	  LC$Item := PKG_Look_And_Feel.Split(PC$Items, LN$i);
    	 	  Exit when LC$Item Is Null;
    	 	  Items(LN$i) := PC$BLOCK || '.' ||LC$Item;
    	 	  LN$i := LN$i + 1 ;
    	 End loop;	
    Else	 
			LC$itemdeb := get_block_property(PC$BLOCK, FIRST_ITEM) ;
			LC$item := PC$BLOCK || '.' || LC$itemdeb ;
			While LC$itemdeb is not null loop -- For each item
				-- updatable and visible item ? --
				IF  GET_ITEM_PROPERTY(LC$Item , VISIBLE) = 'TRUE' 
				And GET_ITEM_PROPERTY(LC$Item , UPDATE_ALLOWED) = 'TRUE' 	Then
					 Items(LN$i) := LC$Item ;
				END IF;
				LC$itemdeb := get_item_property(LC$item, NEXTITEM );
				LC$item := PC$BLOCK || '.' || LC$itemdeb ;
				LN$i := LN$i + 1 ;
			End loop ;
		End if ;
		LN$i := 1 ;
		-- get text to paste --
		Loop
			 LC$Line := Get_Custom_Property(PC$Bean, 1, 'GET_CLIPBOARD');
			 Exit when LC$Line = '[END_DATA]' ;
			 dbms_lob.writeappend(LL$Text, Length(LC$Line), LC$Line);
		End loop;	
    -- real job --
		If Items.count > 0 Then 
			  -- paste the tokens --
			  Loop
			  	LC$Line := pkg_look_and_feel.split(LL$Text, LN$i, chr(10));
			  	exit when LC$Line is null;
			  	If LN$i = 1 and PB$Header Then
			  		 goto suite;
			  	End if ;	 
			  	If Name_in('system.record_status') != 'NEW' Then
			  		create_record;
			  	End if ;
			  	LN$Insert := PN$From ;
			  	For i in 1  .. Items.last Loop
			  		LC$Col := pkg_look_and_feel.split(LC$Line, i, PC$FieldSep);
			  		exit when LC$Col is null;			  		
			  		If Items.exists(LN$Insert) Then
			  		  --And LC$Col != '+|null|-'	Then
			  		  copy(LC$Col, Items(LN$Insert));
			  		End if ;
			  		LN$Insert := LN$Insert + 1 ;
			  	End loop;	
<<suite>>
			  	LN$i := LN$i + 1 ;
			  End loop;				 
		End if ;	
		dbms_lob.trim(LL$Text, 0);
				
    END Paste_to_block;
    
    ---------------------------------------------------------------	
	
	-------------------------------
	--  Copy block to clipboard  --
	-------------------------------
	PROCEDURE Copy_From_block
	(
	   PC$Block    in varchar2
    ,PC$Bean     in varchar2 	  
    ,PB$Header   in boolean default FALSE 
	  ,PN$From     in pls_integer default 1
	  ,PC$Items    in varchar2 default null
	  ,PC$FieldSep in varchar2 default CHR(9)
	)
	Is
		LC$item      varchar2(60); -- current item
		LC$itemdeb   varchar2(60); -- first item
	  LC$TotLine   Varchar2(32000);
	  LC$Line      Varchar2(32000);
	  LC$Col       Varchar2(2000);
	  LN$i         pls_integer := 1 ;	
	  Type         TYP_CHARS is table of varchar2(100) index by BINARY_INTEGER;
	  Items        TYP_CHARS;	
	BEGIN			  
    go_block(PC$Block);

    If PC$Items Is Not Null Then
    	 Loop
    	 	  LC$Item := PKG_Look_And_Feel.Split(PC$Items, LN$i);
    	 	  Exit when LC$Item Is Null;
    	 	  Items(LN$i) := LC$Item;
    	 	  LN$i := LN$i + 1 ;
    	 End loop;	
    Else	 
			LC$itemdeb := get_block_property(PC$BLOCK, FIRST_ITEM) ;
			LC$item := PC$BLOCK || '.' || LC$itemdeb ;
			While LC$itemdeb is not null loop -- For each item
				-- updatable and visible item ? --
				IF  GET_ITEM_PROPERTY(LC$Item , VISIBLE) = 'TRUE' 
				And GET_ITEM_PROPERTY(LC$Item , UPDATE_ALLOWED) = 'TRUE' 	Then
					 Items(LN$i) := LC$Item ;
				END IF;
				LC$itemdeb := get_item_property(LC$item, NEXTITEM );
				LC$item := PC$BLOCK || '.' || LC$itemdeb ;
				LN$i := LN$i + 1 ;
			End loop ;
    End if ;
		LN$i := 1 ;
		First_Record ;
		If Items.count > 0 Then 
		    -- export header ? --
		    If PB$Header Then
		    	 For i in 1  .. Items.last Loop
		    	 	 If i > 1 Then
		    	 	 	LC$Line := LC$Line  || PC$FieldSep ;
		    	 	 End if;
		    	 	 LC$Line := LC$Line || Items(i) ;
		    	 End loop;
		    	 LC$Line := LC$Line || CHR(10) ;
		    	 Set_Custom_Property( PC$BEAN, 1, 'COPY_TO_CLIPBOARD', LC$Line);
		    End if ;	
			  -- paste the data --
			  Loop
			  	If Name_in('system.record_status') != 'NEW' Then
				  	LC$Line := null ;
				  	For i in 1  .. Items.last Loop
				  		If i >= PN$From Then
					  		--LC$Col := Nvl(Name_In(Items(i)),'+|null|-');
					  		LC$Col := Nvl(Name_In(Items(i)),'');
					  		If LC$Line Is not Null Then
					  			 LC$Line := LC$Line || PC$FieldSep ;
					  		End if ;	 
					  		LC$Line := LC$Line || LC$Col ;
				  		End if ;
				  	End loop;	
				  	If LN$i > 1 Then
				  		 LC$TotLine := LC$TotLine || CHR(10) ;
				  	End if ;	 
				  	LC$TotLine := LC$TotLine || LC$Line ;
				  	If Length(LC$TotLine) > 4000 Then
				  		Set_Custom_Property( PC$BEAN, 1, 'COPY_TO_CLIPBOARD', LC$TotLine);
				  		LC$TotLine := null ;
				  	End if ;
					  exit when name_in('system.last_record') = 'TRUE' ;	
					  next_record ;		  					  	
			  	End if ;
			  	LN$i := LN$i + 1 ;
			  End loop;	
			  If Length(LC$TotLine) <= 4000 Then
			  	 Set_Custom_Property( PC$BEAN, 1, 'COPY_TO_CLIPBOARD', LC$TotLine);
			  End if ;			  
			  Set_Custom_Property( PC$BEAN, 1, 'COPY_TO_CLIPBOARD', '[END_DATA]');
			  Synchronize;
			  First_record;
		End if ;	
	End Copy_From_block;
	
  ---------------------------------------------------------------		
	
	-------------------------------------------
	--  highlight the current record         --
	--  ----------------------------------   --
	--  use only with Items that have        --
	--  oracle.forms.fd.LAF_XP_TextField or  --
	--  oracle.forms.fd.LAF_XP_TextField     --
	--  Implementation Class and have a      --
	--  gradient background                  --
	-------------------------------------------
	PROCEDURE highlight_record
	(
	   PC$Block  in varchar2
	)
	Is
		LN$Pos  pls_integer ;
		LN$Rec  pls_integer := Get_Block_Property( PC$Block, CURRENT_RECORD) ;
		LC$item      varchar2(60); -- current item
		LC$itemdeb   varchar2(60); -- first item
	  LN$i         pls_integer := 1 ;	
	  Type         TYP_CHARS is table of varchar2(100) index by BINARY_INTEGER;
	  Items        TYP_CHARS;			
	Begin
	  -- find the current block visible items  --
		LC$itemdeb := get_block_property(PC$BLOCK, FIRST_ITEM) ;
		LC$item := PC$BLOCK || '.' || LC$itemdeb ;
		While LC$itemdeb is not null loop -- For each item
			-- visible item ? --
			IF  GET_ITEM_PROPERTY(LC$Item , VISIBLE) = 'TRUE' Then
				 Items(LN$i) := LC$Item ;
			END IF;
			LC$itemdeb := get_item_property(LC$item, NEXTITEM );
			LC$item := PC$BLOCK || '.' || LC$itemdeb ;
			LN$i := LN$i + 1 ;
		End loop ;	  
	  ----------------------------------
	  -- highlight the current record --
	  ----------------------------------
	  If get_block_property(PC$BLOCK,TOP_RECORD) > 1 Then 
	  	LN$Pos := LN$Rec - get_block_property(PC$Block,TOP_RECORD) + 1 ;
	  Else
	  	LN$Pos := LN$Rec ;
	  End if;
	
	  If Items.count > 0 Then
		  For i IN 1 .. Items.last Loop
		  	Set_Custom_Property(Items(i) , ALL_ROWS, 'SET_CURRENT', 'false');
		  	Set_Custom_Property(Items(i) , LN$Pos,   'SET_CURRENT', 'true');
		  End loop;
	  End if ;
	  
	End highlight_record;	
	
  ---------------------------------------------------------------		
	
  ---------------------------------------
  --  Returns a BIG TEXT Clob content  --
  ---------------------------------------
	PROCEDURE Get_BigText_Content
	(
	   PC$Item  in varchar2
	  ,PL$Clob  in out nocopy CLOB
	) 
	Is
		LC$Chunk varchar2(32767);	
	Begin
		-- get the updated CLOB content --
		Loop
			LC$Chunk := Get_Custom_Property(PC$Item, 1, 'BIG_GET_TEXT') ;
			Exit When LC$Chunk Is Null ;
			dbms_lob.writeappend(PL$Clob, Length(LC$Chunk), LC$Chunk);
		End loop;		
	End Get_BigText_Content; 	    
	
  ---------------------------------------------------------------		
    
END;


