/********************************************************/
/*Modifica valorizzazione campo poste_ismaster 23/10/2017 Angelo Piergallini*/
/********************************************************/

/********************************************************/
/*  SETTING GESTIONE ERRORI                             */
/********************************************************/
.SET ERROROUT STDOUT
.SET WIDTH 4096;  
                                
.SET ERRORLEVEL 3803 SEVERITY 10; 
.SET ERRORLEVEL 3807 SEVERITY 10;

INSERT INTO BIC_ODS_SA.SFA_ATTRIBTIPB_DELTA_LOAD_PREC
SELECT *
FROM BIC_ODS_SA.SFA_ATTRIBTIPB_DELTA_LOAD;
.IF ERRORLEVEL > 0 THEN .QUIT 16;

DEL FROM BIC_ODS_SA.SFA_ATTRIBTIPB_DELTA_LOAD;
.IF ERRORLEVEL > 0 THEN .QUIT 16;

/********************************************************/
/*  INSERISCO IN  SFA_ATTRIBTIPB_DELTA_LOAD              */
/********************************************************/

/*  CLIENTE BUSINESS */
INSERT INTO BIC_ODS_SA.SFA_ATTRIBTIPB_DELTA_LOAD
SEL 	
		 C.ID_CLIENTE_BIC,
		 C.ATECO_2002 AS POSTE_ATECOCODE,
		 DT_ISCRIZIONE_CCIAA,
		 CCIAA_PROVINCIA,
		 NULL AS POSTE_REGISTRATION,
     NULL AS POSTE_CLOSUREDATE,
     NULL AS NUMBEROFEMPLOYEES,
     NULL AS POSTE_CORPORATIONSTOCK,
     NULL AS POSTE_COMPANYAGE,
     NULL AS POSTE_LEGALACTION,
     NULL AS POSTE_PRODUCTCATEGORYCODE,
     NULL AS POSTE_SAPCUSTOMERCODE,
     NULL AS POSTE_CIAECODE,
     MBPA.ID_CLIENTE_BIC_CAPOGRUPPO AS PARENTCUSTOMERBIC,
     NULL AS POSTE_CRMOCODE,
     	CAST(CASE WHEN TRIM(MBPA.FLAG_CAPOGRUPPO) = 'NO' THEN 0
          WHEN TRIM(MBPA.FLAG_CAPOGRUPPO) = 'SI' THEN 1
     ELSE TRIM(MBPA.FLAG_CAPOGRUPPO)
     END AS INTEGER) AS POSTE_ISMASTER,
     NULL AS POSTE_CRMOCODE_2,
     ATECO.MACROINDUSTRY AS CODICE_MACROINDUSTRY,
     ATECO.INDUSTRY AS CODICE_INDUSTRY,
     'MBPA' AS CODICE_CANALE,  --DA DEFINIRE IN TIPOLOGICA PER SVILUPPI FUTURI
     MBPA.ID_SEGMENTO AS CODICE_SEGMENTO 
FROM 
BIC_ODS_V.CLIENTE_BUSINESS   C
   LEFT OUTER JOIN EBIL_ANAG.AN_CLIENTE_MBPA MBPA
   ON CAST(C.ID_CLIENTE_BIC AS VARCHAR(255)) = MBPA.ID_CLIENTE_BIC
   AND MBPA.VERSIONE_CORRENTE = 1
   LEFT JOIN EBIL_ANAG.TPL_ATECO_MBPA ATECO
   ON MBPA.ID_ATECO = ATECO.ID_ATECO
   AND ATECO.VERSIONE_CORRENTE = 1
WHERE CAST(C.data_FINE_VALIDITA AS DATE)  = '2999-12-31'
   and (C.FLAG_CERTIFICAZIONE='V'   --clienti certificati
   OR (C.COD_NAZIONE_PIVA<>'IT' AND C.IDS_COD_PARTITA_IVA ='V'));




.IF ERRORLEVEL > 0 THEN .QUIT 16;

/********************************************************/
/*  GESTIONE STATISTICHE                                */
/********************************************************/

COLLECT STATISTICS BIC_ODS_SA.SFA_ATTRIBTIPB_DELTA_LOAD  COLUMN ID_CLIENTE_BIC;
.IF ERRORLEVEL > 0 THEN .QUIT 16;

.LOGOFF; 
.QUIT;
