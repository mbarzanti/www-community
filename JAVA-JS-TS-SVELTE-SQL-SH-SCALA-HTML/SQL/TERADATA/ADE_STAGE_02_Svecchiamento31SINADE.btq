.SET ERROROUT STDOUT
.SET WIDTH 240;

-- PARAMETRI: CLIENTE = 31, SISTEMA = 'SIN', SISINP = 'ADE'

/* CREA TABELLA SIN_LOTTI_3_CHIUSI -- SI ACCETTANO ANCHE ATTI CHIUSI */
/*
DELETE FROM EDWAE_LCR_SA.MS_SP_SIN_LOTTI_3_CHIUSI_TMP
WHERE STA_CLI_ID = 31;

 .IF ERRORLEVEL > 0 THEN .QUIT 16;

INSERT INTO EDWAE_LCR_SA.MS_SP_SIN_LOTTI_3_CHIUSI_TMP
SELECT STA_CLI_ID, STA_CLI_NOME,STA_MAC_NOME,STA_LOT_NOME_OR,STA_LOT_DATA_INVIO_CLI  
FROM
(
SELECT STA_CLI_ID,A.STA_CLI_NOME,A.STA_MAC_NOME,A.STA_LOT_NOME_OR,A.STA_LOT_DATA_INVIO_CLI,C.ANM_CAMPO_DATA_CHIUSURA, 
SUM(CASE WHEN C.ANM_CAMPO_DATA_CHIUSURA= 'STA_DATA_REND_ESITO'  THEN
         1-(CASE WHEN A.STA_DATA_REND_ESITO IS NOT NULL THEN 1 ELSE 0 END) 
             ELSE
         1-(CASE WHEN A.STA_DATA_PUBBL_IMMAGINI IS NOT NULL THEN 1 ELSE 0 END) END)  AS NUM_APERTI, 
MAX(CASE WHEN C.ANM_CAMPO_DATA_CHIUSURA= 'STA_DATA_REND_ESITO'THEN A.STA_DATA_REND_ESITO
         ELSE A.STA_DATA_PUBBL_IMMAGINI END) AS DATA_MAX_LOTTO
  FROM EDWAE_LCR_SA.MS_SP_SIN_STAGE_TMP A,
      EDWAE_LCR_DW.ANAGR_SP_TRASC_1 B,
      EDWAE_LCR_DW.ANAGR_SP_MACROSERVIZIO C 
  WHERE A.STA_MAC_NOME = B.TR1_MAC_NOME_STA
        AND B.TR1_MAC_ID   = C.ANM_MAC_ID
        AND B.TR1_SISTEMA = 'SIN' AND A.STA_CLI_ID = 31
 GROUP BY  STA_CLI_ID,STA_CLI_NOME,STA_MAC_NOME,STA_LOT_NOME_OR,STA_LOT_DATA_INVIO_CLI,ANM_CAMPO_DATA_CHIUSURA 
)A WHERE NUM_APERTI = 0;

 .IF ERRORLEVEL > 0 THEN .QUIT 16;

-- COLLECT STATISTICS on EDWAE_LCR_SA.MS_SP_SIN_LOTTI_3_CHIUSI_TMP;

 .IF ERRORLEVEL > 0 THEN .QUIT 16;
-- FINE RICERCA ATTI CHIUSI -- ELIMINATA  */ 
/* CARICA TABELLA SIN_STAGE_ATTI */

DELETE  FROM EDWAE_LCR_DW.MS_SP_SIN_STAGE_ATTI
WHERE STA_CLI_ID = 31;

 .IF ERRORLEVEL > 0 THEN .QUIT 16;

INSERT INTO EDWAE_LCR_DW.MS_SP_SIN_STAGE_ATTI
SELECT *
FROM EDWAE_LCR_SA.MS_SP_SIN_STAGE_TMP 
WHERE STA_CLI_ID = 31
--###### ELIMINA FILTRO ##########
--AND STA_ID <10000
--###### ELIMINA FILTRO ##########
;

/* -- ELIMINA SCARTO ATTI CHIUSI
WHERE NOT EXISTS
(SELECT 1 FROM 	EDWAE_LCR_SA.MS_SP_SIN_LOTTI_3_CHIUSI_TMP B
 WHERE A.STA_CLI_ID = 31   
   AND A.STA_CLI_NOME = B.STA_CLI_NOME
   AND A.STA_MAC_NOME = B.STA_MAC_NOME
   AND A.STA_LOT_NOME_OR = B.STA_LOT_NOME_OR
   AND A.STA_LOT_DATA_INVIO_CLI = B.STA_LOT_DATA_INVIO_CLI);
 FINE ELIMINA SCARTO ATTI CHIUSI */
 
.IF ERRORLEVEL > 0 THEN .QUIT 16;
 
-- COLLECT STATISTICS on EDWAE_LCR_DW.MS_SP_SIN_STAGE_ATTI;
CALL EDWH.COLLECTSTATS( 'EDWAE_LCR_DW', 'MS_SP_SIN_STAGE_ATTI', S, C, ST );

.IF ERRORLEVEL > 0 THEN .QUIT 16;
 
/* CARICA TABELLA SIN_STAGE_ATTI_INDIR */
  
DELETE FROM EDWAE_LCR_DW.MS_SP_SIN_STAGE_ATTI_INDIR
WHERE STA_CLI_ID = 31;  

.IF ERRORLEVEL > 0 THEN .QUIT 16;

INSERT INTO  EDWAE_LCR_DW.MS_SP_SIN_STAGE_ATTI_INDIR 
SELECT
 STA_SISTEMA
,STA_CLI_ID
,STA_ID
,STA_INDIRIZZO_DEST_ORIG
,TOPONIMO || ' ' || VIA || ' ' || NUMERO || ' ' ||  COMUNE || ' ' || PROVINCIA AS STA_INDIRIZZO
,TOPONIMO
, VIA
, NUMERO
, TOPONIMO || ' ' || VIA || ' ' || NUMERO AS INDIR_REP
,COMUNE
,CAP
,PROVINCIA
FROM
(
SELECT
 STA_SISTEMA
,STA_CLI_ID 
,STA_ID
,STA_INDIRIZZO_DEST_ORIG
,SUBSTRING('00000' || TRIM(BOTH FROM CAP) FROM CHARACTER_LENGTH('00000' ||  TRIM(BOTH FROM CAP))-5+1,5) AS  CAP 
,TOPONIMO 
,VIA 
,NUMERO 
,CASE WHEN CHARACTER_LENGTH(COMUNE) <= 4 THEN '' ELSE TRIM(BOTH FROM SUBSTRING(COMUNE FROM 1, INDEX(COMUNE,'§' )-4)) END AS COMUNE 
,CASE WHEN CHARACTER_LENGTH(PROVINCIA) <= 2 THEN '' ELSE TRIM(BOTH FROM SUBSTRING(PROVINCIA FROM INDEX(COMUNE,'§' )-2,2)) END AS PROVINCIA
FROM
(
SELECT
 STA_SISTEMA
,STA_CLI_ID
,STA_ID
,STA_INDIRIZZO_DEST_ORIG
,CAP  
,TRIM(BOTH FROM TOPONIMO ) AS TOPONIMO 
,TRIM(BOTH FROM VIA ) AS VIA 
,TRIM(BOTH FROM SUBSTRING(NUMERO FROM 1 FOR INDEX(NUMERO,'§' )-1)) AS NUMERO 
,TRIM(BOTH FROM SUBSTRING(COMUNE FROM INDEX(COMUNE,'§' )+1,255)) AS COMUNE 
,TRIM(BOTH FROM SUBSTRING(PROVINCIA FROM INDEX(COMUNE,'§' )+1,255)) AS PROVINCIA
FROM
( SELECT
 STA_SISTEMA
,STA_CLI_ID
,STA_ID
,STA_INDIRIZZO_DEST_ORIG
,CAP
,TOPONIMO
, SUBSTRING(VIA FROM 1,  INDEX(VIA,'§' )-1) AS VIA
, SUBSTRING(NUMERO FROM INDEX(VIA,'§' )+1, 255) AS NUMERO
,SUBSTRING(COMUNE FROM INDEX(VIA,'§' )+1, 255) AS COMUNE
,SUBSTRING(COMUNE FROM INDEX(VIA,'§' )+1, 255) AS PROVINCIA
FROM
(
SELECT 
 STA_SISTEMA
,STA_CLI_ID
,STA_ID
,STA_INDIRIZZO_DEST AS STA_INDIRIZZO_DEST_ORIG
,STA_CAP_DEST AS CAP
,SUBSTRING(STA_INDIRIZZO_DEST FROM 1,INDEX(STA_INDIRIZZO_DEST,'§')-1) AS TOPONIMO
,SUBSTRING(STA_INDIRIZZO_DEST FROM INDEX(STA_INDIRIZZO_DEST,'§')+1 FOR 255) AS VIA
,SUBSTRING(STA_INDIRIZZO_DEST FROM INDEX(STA_INDIRIZZO_DEST,'§')+1 FOR 255) AS NUMERO
,SUBSTRING(STA_INDIRIZZO_DEST FROM INDEX(STA_INDIRIZZO_DEST,'§')+1 FOR 255) AS COMUNE
,SUBSTRING(STA_INDIRIZZO_DEST FROM INDEX(STA_INDIRIZZO_DEST,'§')+1 FOR 255) AS PROVINCIA
 FROM 
 EDWAE_LCR_DW.MS_SP_SIN_STAGE_ATTI 
WHERE STA_CLI_ID = 31 AND STA_INDIRIZZO_DEST<> '' AND INDEX(STA_INDIRIZZO_DEST,'§') > 0
 ) A
 ) B
 ) C
 )D;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

-- COLLECT STATISTICS on EDWAE_LCR_DW.MS_SP_SIN_STAGE_ATTI_INDIR;
CALL EDWH.COLLECTSTATS( 'EDWAE_LCR_DW', 'MS_SP_SIN_STAGE_ATTI_INDIR', S, C, ST );

 .IF ERRORLEVEL > 0 THEN .QUIT 16;

/* CARICA TABELLA SIN_STAGE_ATTI_STORICO  -- ELIMINATO

INSERT INTO EDWAE_LCR_DW.MS_SP_SIN_STAGE_ATTI_ST
SELECT *
FROM EDWAE_LCR_SA.MS_SP_SIN_STAGE_TMP A
WHERE EXISTS
(SELECT 1 FROM 	EDWAE_LCR_SA.MS_SP_SIN_LOTTI_3_CHIUSI_TMP B
 WHERE A.STA_CLI_ID = 31 AND A.STA_CLI_NOME = B.STA_CLI_NOME
   AND A.STA_MAC_NOME = B.STA_MAC_NOME
   AND A.STA_LOT_NOME_OR = B.STA_LOT_NOME_OR
   AND A.STA_LOT_DATA_INVIO_CLI = B.STA_LOT_DATA_INVIO_CLI) 
 AND NOT EXISTS
 (SELECT 1 FROM   EDWAE_LCR_DW.MS_SP_SIN_STAGE_ATTI_ST C
  WHERE A.STA_CLI_ID = 31 AND A.STA_CLI_NOME = C.STA_CLI_NOME
   AND A.STA_MAC_NOME = C.STA_MAC_NOME
   AND A.STA_LOT_NOME_OR = C.STA_LOT_NOME_OR
   AND A.STA_LOT_DATA_INVIO_CLI = C.STA_LOT_DATA_INVIO_CLI); 

.IF ERRORLEVEL > 0 THEN .QUIT 16;


DELETE FROM EDWAE_LCR_SA.MS_SP_SIN_LOTTI_3_CHIUSI_TMP
WHERE STA_CLI_ID = 31;

.IF ERRORLEVEL > 0 THEN .QUIT 16;
 FINE ELIMINA ATTI CHIUSI  */
 
/*################# CARICAMENTO T&T ########################*/

DELETE FROM EDWAE_LCR_DW.MS_SP_TT_STAGE
WHERE STA_CLI_ID = 31 AND STA_SISTEMA = 'SIN';

.IF ERRORLEVEL > 0 THEN .QUIT 16;

INSERT INTO EDWAE_LCR_DW.MS_SP_TT_STAGE
SELECT
      B.STA_ID AS STA_ID,
      B.STA_SISTEMA AS STA_SISTEMA,
      B.STA_CLI_ID AS STA_CLI_ID,
      B.STA_CLI_NOME AS STA_CLI_NOME,
      B.STA_MAC_NOME AS STA_MAC_NOME,
      B.STA_ATT_COD AS STA_ATT_COD,
      B.STA_LOT_NOME_OR AS STA_LOT_NOME_OR,      
      B.STA_RACCOMANDATA_COD AS STA_RACCOMANDATA_COD,
      TRIM(LEADING FROM B.STA_RACCOMANDATA_COD_F) AS STA_RACCOMANDATA_COD_F,
      'M' AS STA_TIPO_RACCOMANDATA,
      COALESCE(A.TS_TRKDATE, CURRENT_TIMESTAMP(0)) AS STA_DATA_GENERAZIONE,
      COALESCE(A.TS_ARRIVE_TIME,CURRENT_TIMESTAMP(0)) AS STA_DATA_SCRITTURA,
      COALESCE(A.TS_DATE_OTH,CURRENT_TIMESTAMP(0)) AS STA_DATA_TRASFERIMENTO,
	  CASE WHEN A.CD_CAUNOTIF IS NULL THEN 'NA' ELSE A.CD_CAUNOTIF END AS STA_OPERAZIONE,
      A.CD_CAUSAL AS STA_SERVIZIO_TT,
      CASE WHEN A.CD_MSGTYPE IS NULL THEN 'NA' ELSE A.CD_MSGTYPE END AS STA_MSG,
      CASE WHEN A.CD_CAUNOTIF IS NULL THEN 'NON TROVATO'
	       WHEN D.STATO IS NULL OR D.STATO ='' THEN 'IN LAVORAZIONE'  
           ELSE D.STATO END AS STA_STATO,
      A.CD_TRKOFFICE AS STA_FRAZ_ORIG,
      C.CAP AS STA_FRAZ_ORIG_CAP,
      C.PROV AS STA_FRAZ_ORIG_PROV,
      C.DESCRIZIONE AS STA_FRAZ_ORIG_DENOM,     
      A.CD_TRKOFFICE_OTH AS STA_FRAZ_DEST,            
      A.CD_FASE AS STA_FASE, 
      B.ANM_SERVIZIO AS STA_SERVIZIO,
      ROW_NUMBER() OVER (PARTITION BY STA_ID,STA_SISTEMA, STA_CLI_ID, STA_RACCOMANDATA_COD, STA_RACCOMANDATA_COD_F, STA_STATO
                    	   ORDER BY STA_DATA_GENERAZIONE)  	 AS STA_NUM_REC  
     FROM EDW_VM_LOGISTICA.EDW_LCR_VDG_TT_TRACCE  A  RIGHT OUTER JOIN 
      				(
                    SELECT X.*, M.ANM_SERVIZIO,M.ANM_ADDENDO,
      				      SUBSTR(STA_RACCOMANDATA_COD, 1,11) AS RACC_BASE,
      				      CAST(RACC_BASE AS BIGINT) + COALESCE(ANM_ADDENDO,0) AS RACC_BASE_F, 
      				      CAST(SUBSTR(RACC_BASE_F, 1, 1) AS BIGINT) + CAST(SUBSTR(RACC_BASE_F, 3, 1) AS BIGINT) + CAST(SUBSTR(RACC_BASE_F, 5, 1) AS BIGINT) + CAST(SUBSTR(RACC_BASE_F, 7, 1) AS BIGINT) + CAST(SUBSTR(RACC_BASE_F, 9, 1) AS BIGINT) + CAST(SUBSTR(RACC_BASE_F, 11, 1) AS BIGINT) AS SOMMA_DISPARI,
      				      CAST(SUBSTR(RACC_BASE_F, 2, 1) AS BIGINT) + CAST(SUBSTR(RACC_BASE_F, 4, 1) AS BIGINT) + CAST(SUBSTR(RACC_BASE_F, 6, 1) AS BIGINT) + CAST(SUBSTR(RACC_BASE_F, 8, 1) AS BIGINT) + CAST(SUBSTR(RACC_BASE_F, 10, 1) AS BIGINT) AS SOMMA_PARI,
      				      CAST((SOMMA_DISPARI + 11 * SOMMA_PARI) AS VARCHAR(12)) AS SOMMA_TOTALE, 
      				      CAST(SUBSTR(SOMMA_TOTALE, 1, 1) AS BIGINT) + CAST(SUBSTR(SOMMA_TOTALE, 2, 1) AS BIGINT) + CAST(SUBSTR(SOMMA_TOTALE, 3, 1) AS BIGINT) AS SOMMA_CIFRA_TOTALE, 
      				      RACC_BASE_F || CAST (CAST(SOMMA_CIFRA_TOTALE  AS BIGINT) MOD 10 AS CHAR(1)) AS STA_RACCOMANDATA_COD_F 
      	/* ###  MODIFICATA JOIN
            		FROM 
      				 EDWAE_LCR_DW.MS_SP_SIN_STAGE_ATTI X, 
      				 EDWAE_LCR_DW.ANAGR_SP_TRASC_1 T,
      				 EDWAE_LCR_DW.ANAGR_SP_MACROSERVIZIO M
      				 WHERE X.STA_RACCOMANDATA_COD IS NOT NULL AND X.STA_RACCOMANDATA_COD > '' AND X.STA_CLI_ID = 31 AND X.STA_SISTEMA = 'SIN'
      				 AND   T.TR1_MAC_NOME_STA = X.STA_MAC_NOME  
      				 AND   T.TR1_SISTEMA = X.STA_SISTEMA
      				 AND   T.TR1_CLI_ID = X.STA_CLI_ID
      				 AND   T.TR1_MAC_ID = M.ANM_MAC_ID
	                 AND   X.STA_SISTEMA = M.ANM_SISTEMA
	                 AND   X.STA_CLI_ID = M.ANM_CLI_ID  */
					FROM 
      				  ( select * from EDWAE_LCR_DW.MS_SP_SIN_STAGE_ATTI  
      				  WHERE STA_RACCOMANDATA_COD IS NOT NULL AND STA_RACCOMANDATA_COD > '' AND STA_CLI_ID = 31 AND STA_SISTEMA = 'SIN') X JOIN 
      				 EDWAE_LCR_DW.ANAGR_SP_TRASC_1 T ON
					 T.TR1_MAC_NOME_STA = X.STA_MAC_NOME  
      				 AND   T.TR1_SISTEMA = X.STA_SISTEMA
      				 AND   T.TR1_CLI_ID = X.STA_CLI_ID
					 JOIN
					 EDWAE_LCR_DW.ANAGR_SP_MACROSERVIZIO M ON
					 T.TR1_MAC_ID = M.ANM_MAC_ID
	                 AND   X.STA_SISTEMA = M.ANM_SISTEMA
	                 AND   X.STA_CLI_ID = M.ANM_CLI_ID 
      		--		 WHERE X.STA_RACCOMANDATA_COD IS NOT NULL AND X.STA_RACCOMANDATA_COD > '' AND X.STA_CLI_ID = 31 AND X.STA_SISTEMA = 'SIN'
					) B 
     ON      A.CD_BARCODE = B.STA_RACCOMANDATA_COD 
     LEFT OUTER JOIN	 
      			 EDWAE_LCR_DW.ANAGR_SP_IMP_LAV_TT C
     ON     A.CD_TRKOFFICE = C.FRAZIONARIO 
     LEFT OUTER JOIN 
    		   EDWAE_LCR_DW.ANAGR_SP_TT D 
     ON    A.CD_MSGTYPE = D.MSG AND A.CD_CAUNOTIF = D.OPERAZIONE;	

.IF ERRORLEVEL > 0 THEN .QUIT 16;

/* INSERIMENTO MOVIMENTI DI RACCOMANDATA FIGLIA */

INSERT INTO  EDWAE_LCR_DW.MS_SP_TT_STAGE
SELECT
      B.STA_ID AS STA_ID,
      B.STA_SISTEMA AS STA_SISTEMA,
      B.STA_CLI_ID AS STA_CLI_ID,
      B.STA_CLI_NOME AS STA_CLI_NOME,
      B.STA_MAC_NOME AS STA_MAC_NOME,
      B.STA_ATT_COD AS STA_ATT_COD,
      B.STA_LOT_NOME_OR AS STA_LOT_NOME_OR,      
      B.STA_RACCOMANDATA_COD AS STA_RACCOMANDATA_COD,
      B.STA_RACCOMANDATA_COD_F AS STA_RACCOMANDATA_COD_F,
      'F' AS STA_TIPO_RACCOMANDATA,
      A.TS_TRKDATE AS STA_DATA_GENERAZIONE,
      A.TS_ARRIVE_TIME AS STA_DATA_SCRITTURA,
      A.TS_DATE_OTH AS STA_DATA_TRASFERIMENTO,
      A.CD_CAUNOTIF AS STA_OPERAZIONE,
      A.CD_CAUSAL AS STA_SERVIZIO_TT,
      A.CD_MSGTYPE AS STA_MSG,
      'IN LAVORAZIONE FIGLIA' AS STA_STATO,
      A.CD_TRKOFFICE AS STA_FRAZ_ORIG,
      C.CAP AS STA_FRAZ_ORIG_CAP,
      C.PROV AS STA_FRAZ_ORIG_PROV,
      C.DESCRIZIONE AS STA_FRAZ_ORIG_DENOM,     
      A.CD_TRKOFFICE_OTH AS STA_FRAZ_DEST,            
      A.CD_FASE AS STA_FASE,   
      B.STA_SERVIZIO AS STA_SERVIZIO,
      ROW_NUMBER() OVER (PARTITION BY STA_ID,STA_SISTEMA, STA_CLI_ID, STA_RACCOMANDATA_COD, STA_RACCOMANDATA_COD_F, STA_STATO
                        ORDER BY STA_DATA_GENERAZIONE)    AS STA_NUM_REC     
     FROM EDW_VM_LOGISTICA.EDW_LCR_VDG_TT_TRACCE A 
	     JOIN 
		 (
		  SELECT STA_ID,
				STA_SISTEMA ,
				STA_CLI_ID,
				STA_CLI_NOME,
				STA_MAC_NOME,
				STA_ATT_COD,
				STA_LOT_NOME_OR,   
				STA_RACCOMANDATA_COD,
				STA_RACCOMANDATA_COD_F, 
				STA_SERVIZIO
         FROM   EDWAE_LCR_DW.MS_SP_TT_STAGE B
		 WHERE B.STA_CLI_ID = 31 AND B.STA_SISTEMA = 'SIN'
		 GROUP BY STA_ID,
				STA_SISTEMA,
				STA_CLI_ID,
				STA_CLI_NOME,
				STA_MAC_NOME,
				STA_ATT_COD,
				STA_LOT_NOME_OR,    
				STA_RACCOMANDATA_COD,
				STA_RACCOMANDATA_COD_F,
				STA_SERVIZIO
		 ) B		
         ON   A.CD_BARCODE = B.STA_RACCOMANDATA_COD_F 
         LEFT OUTER JOIN EDWAE_LCR_DW.ANAGR_SP_IMP_LAV_TT C 
         ON   A.CD_TRKOFFICE = C.FRAZIONARIO
            LEFT OUTER JOIN EDWAE_LCR_DW.ANAGR_SP_TT D     
         ON   A.CD_MSGTYPE = D.MSG AND A.CD_CAUNOTIF = D.OPERAZIONE 
         WHERE(A.CD_TRKOFFICE IN (SELECT FRAZIONARIO FROM EDWAE_LCR_DW.ANAGR_SP_CSIN_TT_PR)   ---### rivedere  LA TABELLA ANAGR_SP_CSIN_TT
           OR CD_TRKOFFICE_OTH IS NOT NULL);		 

.IF ERRORLEVEL > 0 THEN .QUIT 16;								  

-- COLLECT STATISTICS on EDWAE_LCR_DW.MS_SP_TT_STAGE;
CALL EDWH.COLLECTSTATS( 'EDWAE_LCR_DW', 'MS_SP_TT_STAGE', S, C, ST );

 .IF ERRORLEVEL > 0 THEN .QUIT 16;
 

--############### SIN_STAGE_02C_TT ######################
 
 DELETE FROM EDWAE_LCR_SA.MS_SP_SIN_STAGE_ATTI_TT_A_TMP
 WHERE STA_SISTEMA = 'SIN' AND STA_CLI_ID = 31;

 .IF ERRORLEVEL > 0 THEN .QUIT 16;
 
 /* CREA TABELLE TT_A    DOVE SI GENERANO LE DATE DI OGNI STATO PER OGNI RACCOMANDATA */ 
 
 INSERT INTO EDWAE_LCR_SA.MS_SP_SIN_STAGE_ATTI_TT_A_TMP
 SELECT STA_ID,STA_SISTEMA,STA_CLI_ID,STA_RACCOMANDATA_COD,
		STA_TIPO_RACCOMANDATA, STA_RACCOMANDATA_COD_F,STA_SERVIZIO, 
		MAX(COALESCE(DATA_NOTIFICA_TT_CONS,CAST ('2001-01-01 00:00:00' AS TIMESTAMP(0)))) AS DATA_NOTIFICA_TT_CONS, 
		MAX(COALESCE(DATA_NOTIFICA_TT_INES,CAST ('2001-01-01 00:00:00' AS TIMESTAMP(0)))) AS DATA_NOTIFICA_TT_INES, 
		MAX(COALESCE(DATA_NOTIFICA_TT_RINV,CAST ('2001-01-01 00:00:00' AS TIMESTAMP(0)))) AS DATA_NOTIFICA_TT_RINV,
		MAX(COALESCE(DATA_NOTIFICA_TT_NONTR,CAST ('2001-01-01 00:00:00' AS TIMESTAMP(0)))) AS DATA_NOTIFICA_TT_NONTR,
		MAX(COALESCE(DATA_NOTIFICA_TT_INLAV,CAST ('2001-01-01 00:00:00' AS TIMESTAMP(0)))) AS DATA_NOTIFICA_TT_INLAV,
        MAX(COALESCE(DATA_NOTIFICA_TT_ALTRO, CAST ('2001-01-01 00:00:00' AS TIMESTAMP(0)))) AS DATA_NOTIFICA_TT_ALTRO, 
        SUM(COUNT_NOTIFICA_TT_CONS) AS COUNT_NOTIFICA_TT_CONS, 
        SUM(COUNT_NOTIFICA_TT_INES) AS COUNT_NOTIFICA_TT_INES, 
        SUM(COUNT_NOTIFICA_TT_RINV) AS COUNT_NOTIFICA_TT_RINV,
		SUM(COUNT_NOTIFICA_TT_NONTR) AS COUNT_NOTIFICA_TT_NONTR,
		SUM(COUNT_NOTIFICA_TT_INLAV) AS COUNT_NOTIFICA_TT_INLAV,
        SUM(COUNT_NOTIFICA_TT_ALTRO) AS COUNT_NOTIFICA_TT_ALTRO
		FROM
(	
SELECT	STA_ID, STA_SISTEMA, STA_CLI_ID, 
		STA_RACCOMANDATA_COD,
		STA_TIPO_RACCOMANDATA, STA_RACCOMANDATA_COD_F,STA_SERVIZIO,
		CASE WHEN STA_STATO = 'CONSEGNATO' THEN MAX(STA_DATA_GENERAZIONE) END AS DATA_NOTIFICA_TT_CONS, 
		CASE WHEN STA_STATO = 'INESITATO' THEN MAX(STA_DATA_GENERAZIONE) END AS DATA_NOTIFICA_TT_INES, 
		CASE WHEN STA_STATO = 'RINVIATO' THEN MAX(STA_DATA_GENERAZIONE) END AS DATA_NOTIFICA_TT_RINV,
		CASE WHEN STA_STATO = 'NON TROVATO' THEN MAX(STA_DATA_GENERAZIONE) END AS DATA_NOTIFICA_TT_NONTR,	
        CASE WHEN STA_STATO = 'IN LAVORAZIONE' THEN MAX(STA_DATA_GENERAZIONE) END AS DATA_NOTIFICA_TT_INLAV,		
		CASE WHEN STA_STATO NOT IN ('CONSEGNATO', 'INESITATO','NON TROVATO','RINVIATO','IN LAVORAZIONE') THEN MAX(STA_DATA_GENERAZIONE) END AS DATA_NOTIFICA_TT_ALTRO,
		CASE WHEN STA_STATO = 'CONSEGNATO' THEN COUNT(STA_DATA_GENERAZIONE) ELSE 0  END AS COUNT_NOTIFICA_TT_CONS, 
		CASE WHEN STA_STATO = 'INESITATO' THEN COUNT(STA_DATA_GENERAZIONE) ELSE 0 END AS COUNT_NOTIFICA_TT_INES, 
		CASE WHEN STA_STATO = 'RINVIATO' THEN COUNT(STA_DATA_GENERAZIONE) ELSE 0 END AS COUNT_NOTIFICA_TT_RINV, 
		CASE WHEN STA_STATO = 'NON TROVATO' THEN COUNT(STA_DATA_GENERAZIONE) ELSE 0 END AS COUNT_NOTIFICA_TT_NONTR, 
		CASE WHEN STA_STATO = 'IN LAVORAZIONE' THEN COUNT(STA_DATA_GENERAZIONE) ELSE 0 END AS COUNT_NOTIFICA_TT_INLAV,
		CASE WHEN STA_STATO NOT IN ('CONSEGNATO', 'INESITATO','NON TROVATO','RINVIATO','IN LAVORAZIONE') THEN COUNT(STA_DATA_GENERAZIONE) ELSE 0 END AS COUNT_NOTIFICA_TT_ALTRO	
FROM	EDWAE_LCR_DW.MS_SP_TT_STAGE
WHERE STA_TIPO_RACCOMANDATA = 'M' AND STA_SISTEMA = 'SIN' AND STA_CLI_ID = 31
GROUP BY STA_ID, STA_SISTEMA, STA_CLI_ID, 	STA_RACCOMANDATA_COD, STA_TIPO_RACCOMANDATA, STA_SERVIZIO,STA_STATO,STA_RACCOMANDATA_COD_F
) A 
GROUP BY STA_ID, STA_SISTEMA, STA_CLI_ID, 	STA_RACCOMANDATA_COD, STA_TIPO_RACCOMANDATA, STA_SERVIZIO, STA_RACCOMANDATA_COD_F;
 
 .IF ERRORLEVEL > 0 THEN .QUIT 16;
 
  -- COLLECT STATISTICS on EDWAE_LCR_SA.MS_SP_SIN_STAGE_ATTI_TT_A_TMP;
CALL EDWH.COLLECTSTATS( 'EDWAE_LCR_SA', 'MS_SP_SIN_STAGE_ATTI_TT_A_TMP', S, C, ST );
  
.IF ERRORLEVEL > 0 THEN .QUIT 16;

DELETE FROM  EDWAE_LCR_SA.MS_SP_SIN_STAGE_ATTI_TT_B_TMP
WHERE STA_SISTEMA = 'SIN' AND STA_CLI_ID = 31;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

 /* CREA TABELLE TT_B    DOVE SI DETERMINANO LE DATE DI AVVIO AL SIN E RIENTRO AL SIN */ 

INSERT INTO EDWAE_LCR_SA.MS_SP_SIN_STAGE_ATTI_TT_B_TMP
SELECT 	STA_ID, STA_SISTEMA, STA_CLI_ID,STA_RACCOMANDATA_COD, STA_TIPO_RACCOMANDATA,
		STA_RACCOMANDATA_COD_F,STA_SERVIZIO, DATA_NOTIFICA_TT_CONS,
		DATA_NOTIFICA_TT_INES, DATA_NOTIFICA_TT_RINV, DATA_NOTIFICA_TT_ALTRO,
		MIN(DATA_AVVIO_SIN_TT) AS DATA_AVVIO_SIN_TT, MIN(DATA_RIENTRO_SIN_TT) AS DATA_RIENTRO_SIN_TT,
        CASE WHEN DATA_NOTIFICA_TT_INES <> CAST ('2001-01-01 00:00:00' AS TIMESTAMP(0))  THEN DATA_NOTIFICA_TT_INES + INTERVAL '10' DAY  ELSE DATA_NOTIFICA_TT_INES END  AS DATA_NOTIFICA_TT_INES10,  
        SUBSTRING(MIN(FRAZ_DEST_MAX) FROM 20 FOR 5) AS STA_FRAZ_DEST, 
        SUBSTRING(MIN(FRAZ_ORIG_MAX) FROM 20 FOR 5) AS STA_FRAZ_ORIG 
FROM
(
SELECT	A.STA_ID, A.STA_SISTEMA, A.STA_CLI_ID, A.STA_RACCOMANDATA_COD, STA_TIPO_RACCOMANDATA_XX AS STA_TIPO_RACCOMANDATA,
		A.STA_RACCOMANDATA_COD_F, A.STA_SERVIZIO, A.DATA_NOTIFICA_TT_CONS,
		A.DATA_NOTIFICA_TT_INES, A.DATA_NOTIFICA_TT_RINV, A.DATA_NOTIFICA_TT_ALTRO,
		CASE WHEN A.DATA_NOTIFICA_TT_RINV <> CAST ('2001-01-01 00:00:00' AS TIMESTAMP(0))  THEN 'M'
		     WHEN A.STA_SERVIZIO = 'RACC' THEN  'R'
		     WHEN A.DATA_NOTIFICA_TT_CONS <> CAST ('2001-01-01 00:00:00' AS TIMESTAMP(0))  THEN 'F'
		     WHEN A.DATA_NOTIFICA_TT_INES <> CAST ('2001-01-01 00:00:00' AS TIMESTAMP(0))  THEN 'F'
		     ELSE  'X' END AS STA_TIPO_RACCOMANDATA_XX,
		CASE WHEN A.DATA_NOTIFICA_TT_CONS > A.DATA_NOTIFICA_TT_INES THEN A.DATA_NOTIFICA_TT_CONS ELSE A.DATA_NOTIFICA_TT_INES END AS DATA_CONF_1,
		CASE WHEN A.DATA_NOTIFICA_TT_RINV > DATA_CONF_1 THEN A.DATA_NOTIFICA_TT_RINV ELSE DATA_CONF_1 END AS DATA_CONF_2,
		CASE WHEN  STA_TIPO_RACCOMANDATA_XX = 'F'  OR STA_TIPO_RACCOMANDATA_XX  ='X'
		            THEN CAST ('2001-01-01 00:00:00' AS TIMESTAMP(0))  ELSE  DATA_CONF_2 END AS DATA_CONFRONTO_XX,
		CASE WHEN B.STA_FRAZ_DEST IS NOT NULL THEN B.STA_DATA_GENERAZIONE 
	                        ELSE CAST('2001-01-01 00:00:00' AS TIMESTAMP(0))END  AS DATA_AVVIO_SIN_TT,             
		CASE WHEN B.DESCRIZIONE IS NOT NULL THEN B.STA_DATA_GENERAZIONE 
		             ELSE CAST('2001-01-01 00:00:00' AS TIMESTAMP(0))END  AS DATA_RIENTRO_SIN_TT,
		 CASE WHEN  DATA_AVVIO_SIN_TT =  CAST('2001-01-01 00:00:00' AS TIMESTAMP(0)) THEN NULL ELSE CAST(DATA_AVVIO_SIN_TT AS CHAR(19)) || COALESCE(B.STA_FRAZ_DEST,'00000')  END AS FRAZ_DEST_MAX,      
		 CASE WHEN  DATA_RIENTRO_SIN_TT  =  CAST('2001-01-01 00:00:00' AS TIMESTAMP(0))  THEN NULL ELSE CAST(DATA_RIENTRO_SIN_TT AS CHAR(19)) || COALESCE(B.STA_FRAZ_ORIG,'00000') END AS FRAZ_ORIG_MAX    
		                       
FROM	EDWAE_LCR_SA.MS_SP_SIN_STAGE_ATTI_TT_A_TMP A LEFT OUTER JOIN
            (
            SELECT X.*,Y.DESCRIZIONE
            FROM EDWAE_LCR_DW.MS_SP_TT_STAGE X LEFT OUTER JOIN EDWAE_LCR_DW.ANAGR_SP_CSIN_TT_PR Y
            ON  X.STA_FRAZ_ORIG = Y.FRAZIONARIO
            WHERE  (Y.DESCRIZIONE IS NOT NULL  OR( X.STA_FRAZ_DEST IS NOT NULL AND X.STA_FRAZ_DEST <>'') )
             AND  X.STA_STATO <> 'NON TROVATO' 
             AND  X.STA_SISTEMA = 'SIN' AND X.STA_CLI_ID =  31		 
            ) B
            ON    A.STA_ID = B.STA_ID
            AND A.STA_SISTEMA = B.STA_SISTEMA
            AND A.STA_CLI_ID = B.STA_CLI_ID
            AND STA_TIPO_RACCOMANDATA_XX = B.STA_TIPO_RACCOMANDATA
            AND A.STA_RACCOMANDATA_COD = B.STA_RACCOMANDATA_COD
            AND A.STA_RACCOMANDATA_COD_F = B.STA_RACCOMANDATA_COD_F
            AND DATA_CONFRONTO_XX < B.STA_DATA_GENERAZIONE
            WHERE A.STA_SISTEMA = 'SIN' AND A.STA_CLI_ID = 31
                ) Z
GROUP BY                        
STA_ID, STA_SISTEMA, STA_CLI_ID,STA_RACCOMANDATA_COD, STA_TIPO_RACCOMANDATA,
		STA_RACCOMANDATA_COD_F,STA_SERVIZIO, DATA_NOTIFICA_TT_CONS,
		DATA_NOTIFICA_TT_INES, DATA_NOTIFICA_TT_RINV, DATA_NOTIFICA_TT_ALTRO  ;       
		
.IF ERRORLEVEL > 0 THEN .QUIT 16;
		
  -- COLLECT STATISTICS on EDWAE_LCR_SA.MS_SP_SIN_STAGE_ATTI_TT_B_TMP;
CALL EDWH.COLLECTSTATS( 'EDWAE_LCR_SA', 'MS_SP_SIN_STAGE_ATTI_TT_B_TMP', S, C, ST );
  
.IF ERRORLEVEL > 0 THEN .QUIT 16;	

DELETE FROM  EDWAE_LCR_DW.MS_SP_SIN_STAGE_ATTI_TT
WHERE STA_SISTEMA = 'SIN' AND STA_CLI_ID = 31;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

/* POPOLA STAGE_ATTI_TT  CON I DATI DELLE 3 FASI DI T&T */

INSERT INTO EDWAE_LCR_DW.MS_SP_SIN_STAGE_ATTI_TT 
SELECT	STA_ID, STA_SISTEMA, STA_CLI_ID, STA_SERVIZIO, STA_TIPO_RACCOMANDATA,
--#############
CASE WHEN DATA_NOTIFICA_TT_CONS <> CAST ('2001-01-01 00:00:00' AS TIMESTAMP(0))
            AND     DATA_NOTIFICA_TT_CONS >  DATA_NOTIFICA_TT_INES
            AND     DATA_NOTIFICA_TT_CONS >  DATA_NOTIFICA_TT_RINV
            --AND     DATA_NOTIFICA_TT_CONS >  DATA_NOTIFICA_TT_ALTRO
            THEN  'CONSEGNATO'
            WHEN DATA_NOTIFICA_TT_INES <> CAST ('2001-01-01 00:00:00' AS TIMESTAMP(0))
            AND     DATA_NOTIFICA_TT_INES >  DATA_NOTIFICA_TT_CONS
            AND     DATA_NOTIFICA_TT_INES >  DATA_NOTIFICA_TT_RINV
            --AND     DATA_NOTIFICA_TT_INES >  DATA_NOTIFICA_TT_ALTRO
            THEN  'INESITATO'
            WHEN DATA_NOTIFICA_TT_RINV <> CAST ('2001-01-01 00:00:00' AS TIMESTAMP(0))
            AND     DATA_NOTIFICA_TT_RINV >  DATA_NOTIFICA_TT_CONS
            AND     DATA_NOTIFICA_TT_RINV >  DATA_NOTIFICA_TT_INES
            --AND     DATA_NOTIFICA_TT_RINV >  DATA_NOTIFICA_TT_ALTRO
            THEN  'RINVIATO'
            ELSE  CAST(NULL AS VARCHAR(50)) END AS STA_STATO_TT,
            CASE WHEN STA_STATO_TT = 'CONSEGNATO' THEN DATA_NOTIFICA_TT_CONS
                        WHEN STA_STATO_TT = 'INESITATO' THEN  DATA_NOTIFICA_TT_INES
                        WHEN STA_STATO_TT = 'RINVIATO' THEN  DATA_NOTIFICA_TT_RINV
             ELSE    CAST( NULL AS TIMESTAMP(0)) END AS STA_DATA_NOTIFICA_TT ,

--#############
    
    CASE WHEN DATA_AVVIO_SIN_TT = CAST ('2001-01-01 00:00:00' AS TIMESTAMP(0)) 
	                    THEN (CASE WHEN STA_STATO_TT = 'CONSEGNATO' THEN DATA_NOTIFICA_TT_CONS
						           WHEN STA_STATO_TT = 'INESITATO'  THEN DATA_NOTIFICA_TT_INES
                                   ELSE CAST( NULL AS TIMESTAMP(0)) END) ELSE DATA_AVVIO_SIN_TT END AS STA_DATA_AVVIO_SIN_TT,
    CASE WHEN DATA_RIENTRO_SIN_TT = CAST ('2001-01-01 00:00:00' AS TIMESTAMP(0)) 
	                    THEN (CASE WHEN STA_STATO_TT = 'CONSEGNATO' THEN DATA_NOTIFICA_TT_CONS
						           WHEN STA_STATO_TT = 'INESITATO'  THEN DATA_NOTIFICA_TT_INES
                                   ELSE CAST( NULL AS TIMESTAMP(0)) END) ELSE DATA_RIENTRO_SIN_TT END AS STA_DATA_RIENTRO_SIN_TT,								   
	STA_RACCOMANDATA_COD,
    STA_RACCOMANDATA_COD_F,
    CASE WHEN DATA_AVVIO_SIN_TT IS NULL THEN NULL ELSE STA_FRAZ_DEST END AS STA_FRAZ_DEST,
    CASE WHEN DATA_RIENTRO_SIN_TT IS NULL THEN NULL ELSE STA_FRAZ_ORIG END AS STA_FRAZ_ORIG 
	
    FROM  EDWAE_LCR_SA.MS_SP_SIN_STAGE_ATTI_TT_B_TMP   
    WHERE STA_SERVIZIO = 'RACC'
	AND STA_SISTEMA = 'SIN' AND STA_CLI_ID = 31
UNION
SELECT	STA_ID, STA_SISTEMA, STA_CLI_ID, STA_SERVIZIO, STA_TIPO_RACCOMANDATA,
--#############
CASE WHEN DATA_NOTIFICA_TT_CONS <> CAST ('2001-01-01 00:00:00' AS TIMESTAMP(0))
            AND     DATA_NOTIFICA_TT_CONS >  DATA_NOTIFICA_TT_INES
            AND     DATA_NOTIFICA_TT_CONS >  DATA_NOTIFICA_TT_RINV
            --AND     DATA_NOTIFICA_TT_CONS >  DATA_NOTIFICA_TT_ALTRO
            THEN  'CONSEGNATO'
            WHEN DATA_NOTIFICA_TT_INES <> CAST ('2001-01-01 00:00:00' AS TIMESTAMP(0))
            AND     DATA_NOTIFICA_TT_INES >  DATA_NOTIFICA_TT_CONS
            AND     DATA_NOTIFICA_TT_INES >  DATA_NOTIFICA_TT_RINV
            --AND     DATA_NOTIFICA_TT_INES >  DATA_NOTIFICA_TT_ALTRO
            THEN  'INESITATO'
            WHEN DATA_NOTIFICA_TT_RINV <> CAST ('2001-01-01 00:00:00' AS TIMESTAMP(0))
            AND     DATA_NOTIFICA_TT_RINV >  DATA_NOTIFICA_TT_CONS
            AND     DATA_NOTIFICA_TT_RINV >  DATA_NOTIFICA_TT_INES
            --AND     DATA_NOTIFICA_TT_RINV >  DATA_NOTIFICA_TT_ALTRO
            THEN  'RINVIATO'
            ELSE  CAST(NULL AS VARCHAR(50)) END AS STA_STATO_TT,
            CASE WHEN STA_STATO_TT = 'CONSEGNATO' THEN DATA_NOTIFICA_TT_CONS
                        WHEN STA_STATO_TT = 'INESITATO' THEN  DATA_NOTIFICA_TT_INES
                        WHEN STA_STATO_TT = 'RINVIATO' THEN  DATA_NOTIFICA_TT_RINV
             ELSE    CAST( NULL AS TIMESTAMP(0)) END AS STA_DATA_NOTIFICA_TT ,

--#############
    CASE WHEN DATA_AVVIO_SIN_TT = CAST ('2001-01-01 00:00:00' AS TIMESTAMP(0)) THEN NULL ELSE DATA_AVVIO_SIN_TT END AS DATA_AVVIO_SIN_TT,                    
    CASE WHEN DATA_RIENTRO_SIN_TT = CAST ('2001-01-01 00:00:00' AS TIMESTAMP(0)) THEN NULL ELSE DATA_RIENTRO_SIN_TT END AS DATA_RIENTRO_SIN_TT,
	STA_RACCOMANDATA_COD,
    STA_RACCOMANDATA_COD_F,
    CASE WHEN DATA_AVVIO_SIN_TT IS NULL THEN NULL ELSE STA_FRAZ_DEST END AS STA_FRAZ_DEST,
    CASE WHEN DATA_RIENTRO_SIN_TT IS NULL THEN NULL ELSE STA_FRAZ_ORIG END AS STA_FRAZ_ORIG 
	
    FROM  EDWAE_LCR_SA.MS_SP_SIN_STAGE_ATTI_TT_B_TMP   
    WHERE STA_SERVIZIO <> 'ATTI' AND STA_SERVIZIO <> 'RACC'
	AND STA_SISTEMA = 'SIN' AND STA_CLI_ID = 31
UNION
SELECT	STA_ID, STA_SISTEMA, STA_CLI_ID, STA_SERVIZIO, STA_TIPO_RACCOMANDATA,
--###
        CASE WHEN DATA_NOTIFICA_TT_CONS <> CAST ('2001-01-01 00:00:00' AS TIMESTAMP(0))
            AND     DATA_NOTIFICA_TT_INES <> CAST ('2001-01-01 00:00:00' AS TIMESTAMP(0))
            AND     DATA_NOTIFICA_TT_CONS >  DATA_NOTIFICA_TT_INES
            AND     DATA_NOTIFICA_TT_CONS >  DATA_NOTIFICA_TT_RINV
            --AND     DATA_NOTIFICA_TT_CONS >  DATA_NOTIFICA_TT_ALTRO
            AND    CAST( DATA_NOTIFICA_TT_CONS AS DATE)  > CAST(DATA_NOTIFICA_TT_INES10 AS DATE)
                         THEN  'INESITATO CONS. > 10 GG' 
           WHEN DATA_NOTIFICA_TT_CONS <> CAST ('2001-01-01 00:00:00' AS TIMESTAMP(0))
            AND     DATA_NOTIFICA_TT_INES <> CAST ('2001-01-01 00:00:00' AS TIMESTAMP(0))
            AND     DATA_NOTIFICA_TT_CONS >  DATA_NOTIFICA_TT_INES
            AND     DATA_NOTIFICA_TT_CONS >  DATA_NOTIFICA_TT_RINV
            --AND     DATA_NOTIFICA_TT_CONS >  DATA_NOTIFICA_TT_ALTRO
            AND    CAST( DATA_NOTIFICA_TT_CONS AS DATE)  <=  CAST(DATA_NOTIFICA_TT_INES10 AS DATE)
            THEN 'CONSEGNATO  <=  10 GG'     
             WHEN DATA_NOTIFICA_TT_CONS <> CAST ('2001-01-01 00:00:00' AS TIMESTAMP(0))
            AND     DATA_NOTIFICA_TT_INES = CAST ('2001-01-01 00:00:00' AS TIMESTAMP(0))
            AND     DATA_NOTIFICA_TT_CONS >  DATA_NOTIFICA_TT_RINV
            --AND     DATA_NOTIFICA_TT_CONS >  DATA_NOTIFICA_TT_ALTRO
            THEN  'CONSEGNATO' 
            WHEN DATA_NOTIFICA_TT_CONS = CAST ('2001-01-01 00:00:00' AS TIMESTAMP(0))
            AND     DATA_NOTIFICA_TT_INES <> CAST ('2001-01-01 00:00:00' AS TIMESTAMP(0))
            AND     DATA_NOTIFICA_TT_INES >  DATA_NOTIFICA_TT_RINV
            --AND     DATA_NOTIFICA_TT_INES >  DATA_NOTIFICA_TT_ALTRO
            AND CURRENT_DATE >= CAST(DATA_NOTIFICA_TT_INES10 AS DATE)
            THEN  'INESITATO  >= 10 GG'    
            WHEN DATA_NOTIFICA_TT_CONS = CAST ('2001-01-01 00:00:00' AS TIMESTAMP(0))
            AND     DATA_NOTIFICA_TT_INES <> CAST ('2001-01-01 00:00:00' AS TIMESTAMP(0))
            AND     DATA_NOTIFICA_TT_INES >  DATA_NOTIFICA_TT_RINV
            --AND     DATA_NOTIFICA_TT_INES >  DATA_NOTIFICA_TT_ALTRO
            AND CURRENT_DATE < CAST(DATA_NOTIFICA_TT_INES10 AS DATE)
            THEN  'INESITATO < 10 GG'  
            WHEN DATA_NOTIFICA_TT_RINV <> CAST ('2001-01-01 00:00:00' AS TIMESTAMP(0))
            AND     DATA_NOTIFICA_TT_RINV >  DATA_NOTIFICA_TT_CONS
            AND     DATA_NOTIFICA_TT_RINV >  DATA_NOTIFICA_TT_INES			
            --AND     DATA_NOTIFICA_TT_RINV >  DATA_NOTIFICA_TT_ALTRO
            THEN  'RINVIATO'
            ELSE CAST( NULL AS VARCHAR(50)) END AS STA_STATO_TT,
            CASE WHEN STA_STATO_TT = 'INESITATO CONS. > 10 GG' THEN DATA_NOTIFICA_TT_INES10 
                        WHEN STA_STATO_TT = 'CONSEGNATO  <=  10 GG'      THEN DATA_NOTIFICA_TT_CONS
                        WHEN STA_STATO_TT = 'CONSEGNATO'                      THEN DATA_NOTIFICA_TT_CONS
                        WHEN STA_STATO_TT =  'INESITATO  >= 10 GG'           THEN DATA_NOTIFICA_TT_INES10
                         WHEN STA_STATO_TT =  'INESITATO < 10 GG'           THEN DATA_NOTIFICA_TT_INES10
                         WHEN STA_STATO_TT = 'RINVIATO' THEN  DATA_NOTIFICA_TT_RINV
             ELSE    CAST( NULL AS TIMESTAMP(0)) END AS STA_DATA_NOTIFICA_TT ,
            
--###
    CASE WHEN DATA_AVVIO_SIN_TT = CAST ('2001-01-01 00:00:00' AS TIMESTAMP(0)) THEN NULL ELSE DATA_AVVIO_SIN_TT END AS DATA_AVVIO_SIN_TT,                    
    CASE WHEN DATA_RIENTRO_SIN_TT = CAST ('2001-01-01 00:00:00' AS TIMESTAMP(0)) THEN NULL ELSE DATA_RIENTRO_SIN_TT END AS DATA_RIENTRO_SIN_TT,
	STA_RACCOMANDATA_COD,
    STA_RACCOMANDATA_COD_F,
    CASE WHEN DATA_AVVIO_SIN_TT IS NULL THEN NULL ELSE STA_FRAZ_DEST END AS STA_FRAZ_DEST,
    CASE WHEN DATA_RIENTRO_SIN_TT IS NULL THEN NULL ELSE STA_FRAZ_ORIG END AS STA_FRAZ_ORIG  
	
    FROM  EDWAE_LCR_SA.MS_SP_SIN_STAGE_ATTI_TT_B_TMP         
    WHERE STA_SERVIZIO =  'ATTI'
    AND STA_SISTEMA = 'SIN' AND STA_CLI_ID = 31;
   
	.IF ERRORLEVEL > 0 THEN .QUIT 16;
		
  -- COLLECT STATISTICS on EDWAE_LCR_DW.MS_SP_SIN_STAGE_ATTI_TT;
 CALL EDWH.COLLECTSTATS( 'EDWAE_LCR_SA', 'MS_SP_SIN_STAGE_ATTI_TT', S, C, ST );
  
    .IF ERRORLEVEL > 0 THEN .QUIT 16;	
	
--######## AGGREGA TT_STAGE ################################ 	

