drop table VAL_FORM_TEC1_INFORTUNI_TMP;
.IF ERRORCODE > 0 THEN .QUIT 16;

collect statistics on VAL_FORM_TEC1_INFORTUNI column(VAL_FORM_TEC1);
collect statistics on TDD_TBGIOPPER_VC column(VAL_FORM_TEC2);
collect statistics on TDD_TBGIOPPER_VC column(CD_OPER);


create volatile table VAL_JOIN as (
	select A.*
	from TDD_TBGIOPPER_VC as A		
	join VAL_FORM_TEC1_INFORTUNI as B on A.VAL_FORM_TEC1=B.VAL_FORM_TEC1
	where CD_OPER = 'VCYL') with data on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;
	
create volatile table TMP_SDP_BOLL_INF as(
	select 
		A.*
		, B.CD_OPER as CD_OPER2
		, B.VAL_FORM_TEC2 as CF
	from VAL_JOIN as A	
	left join 
		(select * from TDD_TBGIOPPER_VC
		where CD_OPER = 'IDPR') as B
		on a.CD_FRAZ = b.CD_FRAZ and a.DT_CONT = b.DT_CONT and a.NR_PRG_REL = b.NR_PRG_REL and a.CD_TERM = b.CD_TERM and a.CD_OPERAT = b.CD_OPERAT
) with data on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;
	
drop table VAL_JOIN;
.IF ERRORCODE > 0 THEN .QUIT 16;


-- UPDATE CON SDP_OPER_CARTE 
update TMP_SDP_BOLL_INF from TMP_SDP_OPER_CARTE as A
set CF = A.CF, CD_OPER2 = A.CD_OPER
where TMP_SDP_BOLL_INF.CF is null 
	and TMP_SDP_BOLL_INF.CD_FRAZ = A.CD_FRAZ 
	and TMP_SDP_BOLL_INF.DT_CONT = A.DT_CONT
	and TMP_SDP_BOLL_INF.NR_PRG_REL = A.NR_PRG_REL 
	and TMP_SDP_BOLL_INF.CD_TERM = A.CD_TERM 
	and TMP_SDP_BOLL_INF.CD_OPERAT = A.CD_OPERAT;
.IF ERRORCODE > 0 THEN .QUIT 16;

-- UPDATE CON SDP
update TMP_BOLL_INF from (
	sel A.*
		, right('000000000000'||A.VAL_FORM_TEC1, 12) as NR_RAPPORTO
		, extract(hour from A.TS_VAR_STS) as ORA
		, extract(minute from A.TS_VAR_STS) as MINUTO
		, cast(A.CD_TERM as int) as CD_TERM_INT
	from TMP_SDP_BOLL_INF as A
	where CF is not null
	qualify row_number () over(partition by NR_RAPPORTO, DT_CONT, CD_FRAZ, CD_TERM_INT, ORA, MINUTO, IM_TOT order by TS_VAR_STS desc) = 1
) as a
	set CF = a.CF, FONTE = 'SDP'
	where a.NR_RAPPORTO = TMP_BOLL_INF.NR_RAPPORTO
		and a.DT_CONT = TMP_BOLL_INF.DT_ACCETTAZIONE
		and a.CD_FRAZ = TMP_BOLL_INF.CD_FRAZ
		and a.CD_TERM_INT = cast(TMP_BOLL_INF.SEZ_PDL as int)
		and a.ORA = extract(hour from TMP_BOLL_INF.ORA_ACCETTAZIONE) 
		and a.MINUTO = extract(minute from TMP_BOLL_INF.ORA_ACCETTAZIONE)
		and a.IM_TOT = TMP_BOLL_INF.IMP_BOLLETTINO;
.IF ERRORCODE > 0 THEN .QUIT 16;

--UPDATE BIC
update TMP_BOLL_INF from (
	sel COD_FISCALE, ID_CLIENTE_BIC from EDWAE_VM.CLIENTE
	where VERSIONE_CORRENTE = 1 and COD_FISCALE is not null	and ID_CLIENTE_BIC is not null
	qualify row_number () over(partition by COD_FISCALE order by ID_CLIENTE_BIC desc) = 1) as a
set ID_CLIENTE_BIC = a.ID_CLIENTE_BIC
where TMP_BOLL_INF.CF = a.COD_FISCALE;
.IF ERRORCODE > 0 THEN .QUIT 16;

delete from TMP_BOLL_INF where ID_CLIENTE_BIC is null;
.IF ERRORCODE > 0 THEN .QUIT 16;

------------------------------------------------------------------------------------------------------------------------------

create VOLATILE table CLIENTI_BOLLETTINI as (
	select A.ID_CLIENTE_BIC
	    , A.ID_PERIODO_TEMPORALE
		, max(case when B.ID_CLIENTE_BIC is not Null then 1 else 0 end) as FL_BOLLETTINI_PRESTITI
		, max(case when C.ID_CLIENTE_BIC is not Null then 1 else 0 end) as FL_BOLLETTINI_INFORTUNI
	from EBIL_AREE.CT_PERIMETRO as A	
	left join TMP_BOLL_PRESTITI as B
		on A.ID_CLIENTE_BIC=B.ID_CLIENTE_BIC
	left join TMP_BOLL_INF as C
		on A.ID_CLIENTE_BIC=C.ID_CLIENTE_BIC
	group by 1,2
)with data ON COMMIT PRESERVE ROWS;
.IF ERRORCODE > 0 THEN .QUIT 16;

--cancella tabelle precedenti
drop table TMP_BOLL_INF;
.IF ERRORCODE > 0 THEN .QUIT 16;

drop table VAL_FORM_TEC1_INFORTUNI;
.IF ERRORCODE > 0 THEN .QUIT 16;

drop table TMP_SDP_BOLL_INF;
.IF ERRORCODE > 0 THEN .QUIT 16;

drop table TMP_SDP_OPER_CARTE;
.IF ERRORCODE > 0 THEN .QUIT 16;

drop table TDD_TBGIOPPER_VC;
.IF ERRORCODE > 0 THEN .QUIT 16;

drop table TMP_BOLL_PRESTITI;
.IF ERRORCODE > 0 THEN .QUIT 16;


---------------------------------------------------------------------------------
-------INFORMAZIONI COMUNI SIA A PRESTITI CHE A INFORTUNI-------
---------------------------------------------------------------------------------
-------MANDATI-------
create volatile table MANDATI as (
	select
		ID_MANDATO
		, TIPO_MANDATO
		, ID_CREDITORE
		, IBAN_DEBITORE
		, RAG_SOC_CREDITORE
		, RAG_SOC_DEBITORE
		, TIPOLOGIA_RAPPORTO_DEBITORE
		, EVENTO
		, DT_EVENTO
		, ORA_EVENTO
		, OWNER_EVENTO
		, case when IBAN_CREDITORE is not null 
				and IBAN_CREDITORE not in ('*ND', ' ' ) 
				and substr(IBAN_CREDITORE, 6,5) = '07601' then substr(IBAN_CREDITORE, 16,12)
			else ' ' end as NR_RAPP
	from V_EDW_DW_BP.SDD_MANDATI_ST
) with data primary index(ID_MANDATO, TIPO_MANDATO, ID_CREDITORE, IBAN_DEBITORE, RAG_SOC_CREDITORE, RAG_SOC_DEBITORE, TIPOLOGIA_RAPPORTO_DEBITORE, EVENTO, DT_EVENTO, ORA_EVENTO, OWNER_EVENTO) 
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;

-------------------------------------------------------------------------------------------------------------
-------MAND_UTIMO_RECORD_PRESTITI-------
