-------MAND_UTIMO_RECORD_INFORTUNI-------
--N.B.: Gli ID_CREDITORI relativi ai mandati Infortuni sono estratti dalla tabella V_EDW_DW_BP.SDD_AZI_CRED_ST
create volatile table CREDITORI as
	(select
		distinct ID_CREDITORE,
		DENOM_RAG_SOC,
		case when DENOM_RAG_SOC like 'GENERALI ITALIA%' then 1 else 0 end as GENERALI,
		case when DENOM_RAG_SOC like any ('UNIPOL SAI%', 'UNIPOLSAI%') then 1 else 0 end as UNIPOL,
		case when DENOM_RAG_SOC like 'ALLIANZ%' then 1 else 0 end as ALLIANZ,
		case when DENOM_RAG_SOC like 'REALE MUTUA%' then 1 else 0 end as REALE_MUTUA,
		case when DENOM_RAG_SOC like 'CATTOLICA%' then 1 else 0 end as CATTOLICA,
		case when DENOM_RAG_SOC like 'AXA%' then 1 else 0 end as AXA,
		case when DENOM_RAG_SOC like 'ZURICH INSURANCE%' then 1 else 0 end as ZURICH	
	from V_EDW_DW_BP.SDD_AZI_CRED_ST
	where GENERALI=1 or UNIPOL=1 or ALLIANZ=1 or REALE_MUTUA=1 or CATTOLICA=1 or AXA=1 or ZURICH=1
) with data primary index (ID_CREDITORE)
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;

create volatile table MAND_ULTIMO_RECORD_INFORTUNI as
	(select A.ID_MANDATO
		, A.ID_CREDITORE
		, max(A.DT_EVENTO) as ULT_AGG
	from MANDATI as A
	where A.TIPO_MANDATO ='R'
	and A.ID_CREDITORE in 
		(select ID_CREDITORE from CREDITORI) 
	group by 1,2
) with data unique primary index (ID_MANDATO, ID_CREDITORE)
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;

-------------------------------------------------------------------------------------------------------------
-------MANDATO ULTIMO RECORD PRESTITI-------
create volatile table MAND_ULTIMO_RECORD_ORA_PRESTITI as (
	select 
		ID_MANDATO
		, ID_CREDITORE
		, DT_EVENTO
		, max(ORA_EVENTO) as ORA_EVENTO
	from MANDATI
	where (ID_MANDATO,ID_CREDITORE,DT_EVENTO) in 
		(select ID_MANDATO, ID_CREDITORE, ULT_AGG from MAND_ULTIMO_RECORD_PRESTITI)
	group by 1,2,3
	) with data unique primary index(ID_MANDATO,ID_CREDITORE)
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


-------MANDATO ULTIMO RECORD INFORTUNI-------
create volatile table MAND_ULTIMO_RECORD_ORA_INFORTUNI as (
	select 
		ID_MANDATO
		, ID_CREDITORE
		, DT_EVENTO
		, max(ORA_EVENTO) as ORA_EVENTO
	from MANDATI
	where (ID_MANDATO,ID_CREDITORE,DT_EVENTO) in 
		(select ID_MANDATO, ID_CREDITORE, ULT_AGG from MAND_ULTIMO_RECORD_INFORTUNI)
	group by 1,2,3
	) with data unique primary index(ID_MANDATO,ID_CREDITORE)
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


-------MAND_ATTI PRESTITI-------
create volatile table MAND_ATTI_PRESTITI as (
	select TIPOLOGIA_RAPPORTO_DEBITORE, IBAN_DEBITORE, RAG_SOC_CREDITORE, ID_MANDATO, ID_CREDITORE, NR_RAPP, RAG_SOC_DEBITORE
	from
		(select IBAN_DEBITORE, RAG_SOC_CREDITORE, ID_MANDATO, ID_CREDITORE, OWNER_EVENTO, TIPOLOGIA_RAPPORTO_DEBITORE, RAG_SOC_DEBITORE, NR_RAPP
		from MANDATI
		join EBIL_AREE.CT_PARAMETRI  as P on 1=1
		where EVENTO in ('A','C','Z','S') 
			and DT_EVENTO between ADD_MONTHS (P.DATA_AGGIORNAMENTO +1, -1 ) and P.DATA_AGGIORNAMENTO
			and (ID_MANDATO, ID_CREDITORE, DT_EVENTO, ORA_EVENTO) in 
				(select ID_MANDATO, ID_CREDITORE, DT_EVENTO, ORA_EVENTO from MAND_ULTIMO_RECORD_ORA_PRESTITI)
			and (ID_MANDATO, ID_CREDITORE) in 
				(select ID_MANDATO,ID_CREDITORE
				from V_EDW_DW_BP.SDD_DISPOSIZIONI_ST,EBIL_AREE.CT_PARAMETRI as P
				where DT_SCADENZA between ADD_MONTHS (P.DATA_AGGIORNAMENTO +1, -1 ) and P.DATA_AGGIORNAMENTO
					and EVENTO IN ('PG','AU','AS','IN','IA','RI','RJ','RV') 
					and TIPOLOGIA_INCASSO <> 'C'
					and CAUSALE_DI_ADDEBITO in ('151F','151FI')
					and TIPOLOGIA_RAPPORTO_DEBITORE='CC'
				group by 1,2) 
		) a
	group by 1,2,3,4,5,6,7
) with data unique primary index( ID_MANDATO, ID_CREDITORE,IBAN_DEBITORE,TIPOLOGIA_RAPPORTO_DEBITORE,RAG_SOC_CREDITORE,NR_RAPP,RAG_SOC_DEBITORE)
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


-------MAND_ATTI INFORTUNI-------
create volatile table MAND_ATTI_INFORTUNI as (
	select TIPOLOGIA_RAPPORTO_DEBITORE, IBAN_DEBITORE, RAG_SOC_CREDITORE, ID_MANDATO, ID_CREDITORE, NR_RAPP, RAG_SOC_DEBITORE
	from
		(select IBAN_DEBITORE, RAG_SOC_CREDITORE, ID_MANDATO, ID_CREDITORE, OWNER_EVENTO, TIPOLOGIA_RAPPORTO_DEBITORE,RAG_SOC_DEBITORE, NR_RAPP
		from MANDATI
		join EBIL_AREE.CT_PARAMETRI  as P on 1=1
		where EVENTO in ('A','C','Z','S') 
			and DT_EVENTO between ADD_MONTHS (P.DATA_AGGIORNAMENTO +1, -1 ) and P.DATA_AGGIORNAMENTO
			and (ID_MANDATO, ID_CREDITORE, DT_EVENTO, ORA_EVENTO) in 
				(select ID_MANDATO, ID_CREDITORE, DT_EVENTO, ORA_EVENTO from MAND_ULTIMO_RECORD_ORA_INFORTUNI)
			and (ID_MANDATO, ID_CREDITORE) in 
				(select ID_MANDATO,ID_CREDITORE
				from V_EDW_DW_BP.SDD_DISPOSIZIONI_ST, EBIL_AREE.CT_PARAMETRI as P
				where DT_SCADENZA between ADD_MONTHS (P.DATA_AGGIORNAMENTO +1, -1 ) and P.DATA_AGGIORNAMENTO
					and EVENTO IN ('PG','AU','AS','IN','IA','RI','RJ','RV') 
					and TIPOLOGIA_INCASSO <> 'C'
					and CAUSALE_DI_ADDEBITO in ('151F','151FI')
					and TIPOLOGIA_RAPPORTO_DEBITORE='CC'
				group by 1,2) 
		) a
	group by 1,2,3,4,5,6,7
) with data unique primary index( ID_MANDATO, ID_CREDITORE,IBAN_DEBITORE,TIPOLOGIA_RAPPORTO_DEBITORE,RAG_SOC_CREDITORE,NR_RAPP,RAG_SOC_DEBITORE)
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;

-------------------------------------------------------------------------------------------------------------
-------Elimina ricorrenze doppie PRESTITI-------
create volatile table MAND_ATTI_UNICI_PRESTITI as (
	select 
		ID_MANDATO
		, ID_CREDITORE
		, max(TIPOLOGIA_RAPPORTO_DEBITORE) as TIPOLOGIA_RAPPORTO_DEBITORE
		, max(IBAN_DEBITORE) as IBAN_DEBITORE
		, max(RAG_SOC_CREDITORE) as RAG_SOC_CREDITORE
		, max(RAG_SOC_DEBITORE) as RAG_SOC_DEBITORE
	from MAND_ATTI_PRESTITI
	group by 1,2
	)with data unique primary index(ID_MANDATO, ID_CREDITORE)
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;

-------Elimina ricorrenze doppie INFORTUNI-------
create volatile table MAND_ATTI_UNICI_INFORTUNI as (
	select 
		ID_MANDATO
		, ID_CREDITORE
		, max(TIPOLOGIA_RAPPORTO_DEBITORE) as TIPOLOGIA_RAPPORTO_DEBITORE
		, max(IBAN_DEBITORE) as IBAN_DEBITORE
		, max(RAG_SOC_CREDITORE) as RAG_SOC_CREDITORE
		, max(RAG_SOC_DEBITORE) as RAG_SOC_DEBITORE
	from MAND_ATTI_INFORTUNI
	group by 1,2
	)with data unique primary index(ID_MANDATO, ID_CREDITORE)
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;

-------------------------------------------------------------------------------------------------------------
create volatile table ASSOC_CLIENTE as (
	select A.ID_CLIENTE_BIC
		, A.ID_RAPPORTO
		, trim(B.NOME) || ' ' || trim (B.COGNOME) as NOME_COMPLETO
	from EDWAE_VM.ASSOC_RAPPORTO_CLIENTE as A	
	inner join EDWAE_VM.CLIENTE as B
		on A.ID_CLIENTE_BIC=B.ID_CLIENTE_BIC
	where A.CD_FLUSSO = '001' and A.ID_CLIENTE_CRM = 0
		and B.VERSIONE_CORRENTE = 1 and B.ID_CLIENTE_CRM = 0
)with data primary index(ID_CLIENTE_BIC)
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;

-------SDD PRESTITI-------
create volatile table SDD_PRESTITI as (
	select 
		ID_MANDATO
		, A.ID_RAPPORTO
		, CL.ID_CLIENTE_BIC
		, CL.NOME_COMPLETO
		, RAG_SOC_DEBITORE
		, SYSLIB.LEVENSHTEIN
			(trim(coalesce(RAG_SOC_DEBITORE , '' )) 
				,trim(coalesce(NOME_COMPLETO, '' ))
				, 1 
				, '''$%&()*+/\|-"1234567890'
				, 'dott,geol,ing,arch,prof,mme,geom,mr,mrs,miss,d.ssa') as score
	from
		(sel ID_MANDATO, '001' || right ( IBAN_DEBITORE, 12) as ID_RAPPORTO , RAG_SOC_DEBITORE
		   from MAND_ATTI_UNICI_PRESTITI
		) A
	left join ASSOC_CLIENTE as CL
		on A.ID_RAPPORTO = CL.ID_RAPPORTO
	qualify row_number () over ( partition by ID_MANDATO order by SCORE desc ) = 1
	) with data primary index (ID_CLIENTE_BIC)
on commit preserve rows ;
.IF ERRORCODE > 0 THEN .QUIT 16;


-------SDD INFORTUNI-------
create volatile table SDD_INFORTUNI as (
	select 
		ID_MANDATO
		, A.ID_RAPPORTO
		, CL.ID_CLIENTE_BIC
		, CL.NOME_COMPLETO
		, RAG_SOC_DEBITORE
		, SYSLIB.LEVENSHTEIN
			(trim(coalesce(RAG_SOC_DEBITORE , '' )) 
				,trim(coalesce(NOME_COMPLETO, '' ))
				, 1 
				, '''$%&()*+/\|-"1234567890'
				, 'dott,geol,ing,arch,prof,mme,geom,mr,mrs,miss,d.ssa') as score
	from
		(sel ID_MANDATO, '001' || right ( IBAN_DEBITORE, 12) as ID_RAPPORTO , RAG_SOC_DEBITORE
		   from MAND_ATTI_UNICI_INFORTUNI
		) a
	left join ASSOC_CLIENTE as CL
		on A.ID_RAPPORTO = CL.ID_RAPPORTO
	qualify row_number () over ( partition by ID_MANDATO order by SCORE desc ) = 1
	) with data primary index (ID_CLIENTE_BIC)
on commit preserve rows ;
.IF ERRORCODE > 0 THEN .QUIT 16;


-------FLAG SDD PRESTITI E INFORTUNI-------
create volatile table CLIENTI_SDD as (
	select A.ID_CLIENTE_BIC
		, max(case when B.ID_CLIENTE_BIC is not Null then 1 else 0 end) as FL_SDD_PRESTITI
		, max(case when C.ID_CLIENTE_BIC is not Null then 1 else 0 end) as FL_SDD_INFORTUNI
	from EBIL_AREE.V_CT_PERIMETRO as A
	left join SDD_PRESTITI as B
		on A.ID_CLIENTE_BIC=B.ID_CLIENTE_BIC
	left join SDD_INFORTUNI as C
		on A.ID_CLIENTE_BIC=C.ID_CLIENTE_BIC
	group by 1
)with data primary index(ID_CLIENTE_BIC) 
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;	


-------CT SDD BOLLETTINI PRESTITI E INFORTUNI-------

BT

;DELETE EBIL_AREE.CT_SDD_BOLL
WHERE ID_PERIODO_TEMPORALE= (SELECT ID_PERIODO_TEMPORALE FROM EBIL_AREE.CT_PARAMETRI)

;INSERT INTO EBIL_AREE.CT_SDD_BOLL 
	select A.ID_CLIENTE_BIC
	    , PARAM.ID_PERIODO_TEMPORALE
		, B.FL_BOLLETTINI_PRESTITI
		, B.FL_BOLLETTINI_INFORTUNI
		, C.FL_SDD_PRESTITI
		, C.FL_SDD_INFORTUNI
	from EBIL_AREE.V_CT_PERIMETRO as A
	left join CLIENTI_BOLLETTINI as B
		on A.ID_CLIENTE_BIC=B.ID_CLIENTE_BIC	
	left join CLIENTI_SDD as C
		on A.ID_CLIENTE_BIC=C.ID_CLIENTE_BIC
	INNER JOIN EBIL_AREE.CT_PARAMETRI AS PARAM
	    ON A.ID_PERIODO_TEMPORALE=PARAM.ID_PERIODO_TEMPORALE
	
		
;ET;		
.IF ERRORCODE > 0 THEN .QUIT 16;


CREATE VOLATILE TABLE VTB_SDD_BOLL_SV AS
(SELECT ID_PERIODO_TEMPORALE, ROW_NUMBER () over ( ORDER BY ID_PERIODO_TEMPORALE  DESC) AS ORDINAMENTO
FROM  EBIL_AREE.CT_SDD_BOLL
GROUP BY 1)
WITH DATA PRIMARY INDEX (ID_PERIODO_TEMPORALE) ON COMMIT PRESERVE ROWS;
.IF ERRORCODE > 0 THEN .QUIT 16;

DELETE EBIL_AREE.CT_SDD_BOLL
WHERE ID_PERIODO_TEMPORALE IN ( SELECT ID_PERIODO_TEMPORALE 
FROM VTB_SDD_BOLL_SV
WHERE ORDINAMENTO >25);
.IF ERRORCODE > 0 THEN .QUIT 16;

