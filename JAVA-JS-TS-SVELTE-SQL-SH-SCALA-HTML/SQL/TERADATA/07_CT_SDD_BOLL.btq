-----------------------------------------------
--------------CT SDD e BOLLETTINI--------------
-------------PRESTITI E INFORTUNI--------------
-----------------------------------------------

/*
  Tabella: EBIL_AREE.CT_SDD_BOLL
  Regime: Delta Mensile
  Gdl: Teradata
  Progetto: Operazionalizzazione CT
  */  
  
.SET WIDTH 240;
.SET ERROROUT STDOUT;

-------SDP-------
--seleziono solo i dati necessari dalla tdd_tbgiopper 

create volatile table TDD_TBGIOPPER_CD_P as(
	select
		A.CD_FRAZ
		, A.CD_OPER
		, A.CD_OPERAT
		, A.CD_TERM
		, A.DT_CONT
		, A.NR_PRG_REL
		, A.TS_VAR_STS
		, A.VAL_FORM_TEC1
		, A.VAL_FORM_TEC2
		, sum(A.IM_TOT) as IM_TOT
	from V_EDW_DW_SDP.EDW_TDD_TBGIOOPER as A
	join EBIL_AREE.CT_PARAMETRI  as P on 1=1
	where A.DT_CONT between ADD_MONTHS (P.DATA_AGGIORNAMENTO +1, -1 ) and P.DATA_AGGIORNAMENTO
		and A.NR_PRG_REL>0 and A.CD_OPER in ('PMCP', 'PMPE', 'PMPT', 'PLPT', 'PLCP', 'PLPE')
	group by 1,2,3,4,5,6,7,8,9
)with data primary index(CD_FRAZ, CD_OPER, CD_OPERAT, CD_TERM, DT_CONT, IM_TOT, NR_PRG_REL, TS_VAR_STS, VAL_FORM_TEC1, VAL_FORM_TEC2)
on commit preserve rows;

create volatile table TDD_TBGIOPPER as(
	select A.*, right('0000000000000000'||VAL_FORM_TEC1, 16) as NR_CARTA_TEC1 
	from TDD_TBGIOPPER_CD_P as A
)with data primary index(CD_FRAZ, CD_OPER, CD_OPERAT, CD_TERM, DT_CONT, IM_TOT, NR_PRG_REL, TS_VAR_STS, VAL_FORM_TEC1, VAL_FORM_TEC2)
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;

--ANAGRAFICA CARTE
create volatile table ANAG_CARTA as (
	select 
		A.NR_CARTA
		, A.CD_FISCALE as CF
	from V_EDW_DW_BP.MON_ANAGRCARTA_ST as A
	join EBIL_AREE.CT_PARAMETRI  as P on 1=1
	join TDD_TBGIOPPER as B 
		on A.NR_CARTA=B.NR_CARTA_TEC1
	where A.CD_FISCALE is not null and characters(trim(A.CD_FISCALE)) = 16 
		and P.DATA_AGGIORNAMENTO between A.DT_INI_VAL and A.DT_FIN_VAL
	) with data on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;
	
--ASSOCIAZIONE SDP CON ANAGRAFICA CARTE
create volatile table TMP_SDP_OPER_CARTE as (
	select A.*, B.CF
	from TDD_TBGIOPPER as A
	join ANAG_CARTA as B
		on A.NR_CARTA_TEC1 = B.NR_CARTA
	qualify row_number () over(partition by A.CD_FRAZ, A.DT_CONT, A.NR_PRG_REL, A.CD_TERM, A.CD_OPERAT order by B.CF desc) = 1
) with data on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;

--cancello tabelle temporanee
drop table TDD_TBGIOPPER_CD_P;
.IF ERRORCODE > 0 THEN .QUIT 16;

drop table TDD_TBGIOPPER;
.IF ERRORCODE > 0 THEN .QUIT 16;

drop table ANAG_CARTA;
.IF ERRORCODE > 0 THEN .QUIT 16;

------------------------------------------------------------------------------------------------------------------------------
---seleziono solo i dati necessari dalla tdd_tbgiopper

create volatile table TDD_TBGIOPPER_VC as(
	select
		A.CD_FRAZ
		, A.CD_OPER
		, A.CD_OPERAT
		, A.CD_TERM
		, A.DT_CONT
		, A.NR_PRG_REL
		, A.TS_VAR_STS
		, A.VAL_FORM_TEC1
		, A.VAL_FORM_TEC2
		, sum(A.IM_TOT) as IM_TOT
	from V_EDW_DW_SDP.EDW_TDD_TBGIOOPER as A
	join EBIL_AREE.CT_PARAMETRI  as P on 1=1
	where A.DT_CONT between ADD_MONTHS (P.DATA_AGGIORNAMENTO +1, -1 ) and P.DATA_AGGIORNAMENTO and 
		A.NR_PRG_REL>0 and A.CD_OPER in ('VCYL', 'IDPR')
	group by 1,2,3,4,5,6,7,8,9
)with data primary index(CD_FRAZ, CD_OPER, CD_OPERAT, CD_TERM, DT_CONT, IM_TOT, NR_PRG_REL, TS_VAR_STS, VAL_FORM_TEC1, VAL_FORM_TEC2)
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;

------------------------------------------------------------------------------------------------------------------------------
-------PRESTITI-------
------------------------------------------------------------------------------------------------------------------------------

create volatile table TMP_BOLL_PRESTITI as (
	select 
		PAG.CD_FRAZ                       
		, PAG.DT_ACCETTAZIONE                             
		, PAG.IMP_BOLLETTINO                
		, PAG.NR_RAPPORTO                   
		, PAG.ORA_ACCETTAZIONE              
		, PAG.PGR_PDL                       
		, PAG.SEZ_PDL
		, cast(null as varchar(20)) as CF
		, cast(null as integer) as ID_CLIENTE_BIC
		, cast(null as char(3)) as FONTE 
	from V_EDW_DW_BP.PAG_BOL_ACCETTATI_ST as PAG
	join EBIL_AREE.CT_PARAMETRI  as P on 1=1	
	where PAG.DT_ACCETTAZIONE between ADD_MONTHS (P.DATA_AGGIORNAMENTO +1, -1 ) and P.DATA_AGGIORNAMENTO
		and P.DATA_AGGIORNAMENTO between PAG.DT_INI_VAL and PAG.DT_FIN_VAL
		and PAG.FL_FITTIZIO = 0
		and PAG.TIPO_RAPPORTO = 'BOLL' 
		and (PAG.FLG_RETTIFICA is null or PAG.FLG_RETTIFICA in ('1', '*') ) 

		-- i NR_RAPPORTO estratti si riferiscono ai conti relativi a competitor sui finanziamenti, come indicato da ACGD
		and PAG.NR_RAPPORTO in ('000000003509', '000000009449', '000000162610', '000000235200', '000000238204', '000000261107', '000000504100', 
			'000000525550', '000000766402', '000000808204', '000000822106', '000000859207', '000004088793', '000007897822',	'000010266559', 
			'000011169554', '000011201282', '000011668530', '000011927001', '000012151551', '000012430104', '000012915534', '000013467287', 
			'000018607804', '000019350206', '000019443100', '000021479407', '000021586201', '000022207500', '000024192502', '000024450389', 
			'000027191105', '000030914683', '000031043508', '000031444201', '000032056277', '000032057200', '000039535687', '000040214207', 
			'000040755209', '000041922204', '000054507462', '000054666110', '000054832696', '000054943550', '000061238200', '000069526465', 
			'000071076228', '000071863070', '000073425167', '000075913855', '000077249530', '000080750102', '000084415306', '000085542330', 
			'000088362835', '000090047457', '000096322763', '001001227451', '001011431440', '001015941931', '001016780734', '001021223456', '001031505447')
	)with data primary index (CD_FRAZ, DT_ACCETTAZIONE, IMP_BOLLETTINO, NR_RAPPORTO, ORA_ACCETTAZIONE, PGR_PDL, SEZ_PDL) 
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;

-- UPDATE CON MDP ( è stata sostituita la vecchia procedura che partiva dalla tab SRV_SPSS.GM_MDP_V non più presente)
update TMP_BOLL_PRESTITI from (
	sel A.* 
	from V_EDW_DW_BP.MDP001_MOVIM_ST as A, EBIL_AREE.CT_PARAMETRI  AS P
	where substr(A.RIFERIMENTO_OPERAZIONE,1,3)= 'BOL'
			and cast(A.DATA_OPERAZIONE as date) between ADD_MONTHS(P.DATA_AGGIORNAMENTO +1, -1) and P.DATA_AGGIORNAMENTO) A
set CF = A.CF_USER, FONTE = 'MDP'
	where cast(A.DATA_OPERAZIONE as date) = TMP_BOLL_PRESTITI.DT_ACCETTAZIONE 
	and cast(substr(A.RIFERIMENTO_OPERAZIONE,9,2) as INT) = cast(TMP_BOLL_PRESTITI.SEZ_PDL as INT)
	and cast(trim(substr(A.RIFERIMENTO_OPERAZIONE,11,20)) as BIGINT) = cast(TMP_BOLL_PRESTITI.PGR_PDL as BIGINT) 
	and substr(A.RIFERIMENTO_OPERAZIONE,4,5)  = TMP_BOLL_PRESTITI.CD_FRAZ;
	.IF ERRORCODE > 0 THEN .QUIT 16;

----------------------------------------------------------------------------------------------------------------------
create volatile table TMP_SDP_BOLL_PRESTITI as (
	select 
		A.*
		, b.CD_OPER as CD_OPER2
		, b.VAL_FORM_TEC2 as CF
	from 
		(select * from TDD_TBGIOPPER_VC
		-- i VAL_FORM_TEC1 estratti si riferiscono ai conti relativi a competitor sui finanziamenti, come indicato da ACGD
		where VAL_FORM_TEC1 in ('4088793','12151551', '31043508','39535687','30914683','13467287',
			'85542330','11169554','32056277','32057200','96322763', '525550','10266559','40755209','41922204',
			'859207','80750102','54507462','54666110','69526465','1016780734','7897822','61238200','77249530',
			'1031505447','21479407','54832696','9449','1011431440','75913855','766402','54943550','71076228',
			'90047457','11927001','11668530','261107','235200','162610','1015941931','19443100','84415306',
			'1021223456','1001227451','11201282','21586201','12915534','3509','22207500','24450389','24192502',
			'18607804','71863070','27191105','238204','19350206','40214207','31444201','808204','88362835',
			'504100','12430104','73425167','822106')
		and CD_OPER = 'VCYL') as A 
		left join 
			(select * from TDD_TBGIOPPER_VC
			where CD_OPER = 'IDPR' ) as B
			on A.CD_FRAZ = B.CD_FRAZ and A.CD_OPER=B.CD_OPER and A.CD_OPERAT = B.CD_OPERAT and A.CD_TERM = B.CD_TERM 
				and A.DT_CONT = B.DT_CONT and A.NR_PRG_REL = B.NR_PRG_REL and A.TS_VAR_STS=B.TS_VAR_STS 
				and A.VAL_FORM_TEC1=B.VAL_FORM_TEC1 and A.VAL_FORM_TEC2=B.VAL_FORM_TEC2
) with data primary index(CD_FRAZ, CD_OPER, CD_OPERAT, CD_TERM, DT_CONT, IM_TOT, NR_PRG_REL, TS_VAR_STS, VAL_FORM_TEC1, VAL_FORM_TEC2, CD_OPER2, CF) 
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


-- UPDATE CON SDP_OPER_CARTE
update TMP_SDP_BOLL_PRESTITI from TMP_SDP_OPER_CARTE as A
set CF = A.CF, CD_OPER2 = A.CD_OPER
where TMP_SDP_BOLL_PRESTITI.CF is null 
	and TMP_SDP_BOLL_PRESTITI.CD_FRAZ = A.CD_FRAZ 
	and TMP_SDP_BOLL_PRESTITI.DT_CONT = A.DT_CONT
	and TMP_SDP_BOLL_PRESTITI.NR_PRG_REL = A.NR_PRG_REL 
	and TMP_SDP_BOLL_PRESTITI.CD_TERM = A.CD_TERM 
	and TMP_SDP_BOLL_PRESTITI.CD_OPERAT = A.CD_OPERAT;
.IF ERRORCODE > 0 THEN .QUIT 16;

-- UPDATE CON SDP
update TMP_BOLL_PRESTITI from (
	sel A.*
		, right('000000000000'||A.VAL_FORM_TEC1, 12) as NR_RAPPORTO
		, extract(hour from A.TS_VAR_STS) as ORA
		, extract(minute from A.TS_VAR_STS) as MINUTO
		, cast(A.CD_TERM as int) as CD_TERM_INT
	from TMP_SDP_BOLL_PRESTITI as A
	where CF is not null
	qualify row_number () over(partition by NR_RAPPORTO, DT_CONT, CD_FRAZ, CD_TERM_INT, ORA, MINUTO, IM_TOT order by TS_VAR_STS desc) = 1
) as a
	set CF = a.CF, FONTE = 'SDP'
	where a.NR_RAPPORTO = TMP_BOLL_PRESTITI.NR_RAPPORTO
		and a.DT_CONT = TMP_BOLL_PRESTITI.DT_ACCETTAZIONE
		and a.CD_FRAZ = TMP_BOLL_PRESTITI.CD_FRAZ
		and a.CD_TERM_INT = cast(TMP_BOLL_PRESTITI.SEZ_PDL as int)
		and a.ORA = extract(hour from TMP_BOLL_PRESTITI.ORA_ACCETTAZIONE) 
		and a.MINUTO = extract(minute from TMP_BOLL_PRESTITI.ORA_ACCETTAZIONE)
		and a.IM_TOT = TMP_BOLL_PRESTITI.IMP_BOLLETTINO;
.IF ERRORCODE > 0 THEN .QUIT 16;

--UPDATE BIC

update TMP_BOLL_PRESTITI from (
	sel COD_FISCALE, ID_CLIENTE_BIC from EDWAE_VM.CLIENTE
	where VERSIONE_CORRENTE = 1 and COD_FISCALE is not null and ID_CLIENTE_BIC is not null
	qualify row_number () over(partition by COD_FISCALE order by ID_CLIENTE_BIC desc) = 1) as a
set ID_CLIENTE_BIC = a.ID_CLIENTE_BIC
where TMP_BOLL_PRESTITI.CF = a.COD_FISCALE;
delete from TMP_BOLL_PRESTITI where ID_CLIENTE_BIC is null;
.IF ERRORCODE > 0 THEN .QUIT 16;

---creazione tabella fisica 
drop table TMP_SDP_BOLL_PRESTITI;
.IF ERRORCODE > 0 THEN .QUIT 16;






------------------------------------------------------------------------------------------------------------------------------
-------INFORTUNI-------------------------------------------------------------------------------------------------------------------------------------

--N.B.: Per identificare i codici NR_RAPPORTO relativi ai Bollettini Infortuni si estraggono i codici dall'anagrafica rapporto
create volatile table COMPETITOR as (
	select distinct A.NDG, B.NR_RAPPORTO
	from BIC_ODS_SA_V.BP_CLIENTE as A
	join EBIL_AREE.CT_PARAMETRI  as P on 1=1 
	left join V_EDW_DW_BP.ANA_RAPPORTO_BP_ST as B
		on A.NDG=B.NDG_RAPP
	where upper(trim(A.RAGIONE_SOCIALE)) like any ('GENERALI ITALIA%', 'UNIPOL SAI%', 'UNIPOLSAI%',
			'ALLIANZ%', 'REALE MUTUA%', 'CATTOLICA PREV%', 'AXA %', 'ZURICH INSURANCE%')
		and (A.DATA_CHIUSURA>P.DATA_AGGIORNAMENTO or A.DATA_CHIUSURA is null)
		and P.DATA_AGGIORNAMENTO between A.DATA_INIZIO_VALIDITA and A.DATA_FINE_VALIDITA
		and P.DATA_AGGIORNAMENTO between B.DT_INI_VAL and B.DT_FIN_VAL
		and B.TIPO_RAPPORTO='CC'
) with data on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16; 

create volatile table TMP_BOLL_INF_0 as (
select 
		PAG.CD_FRAZ                       
		, PAG.DT_ACCETTAZIONE                             
		, PAG.IMP_BOLLETTINO                
		, PAG.NR_RAPPORTO                   
		, PAG.ORA_ACCETTAZIONE              
		, PAG.PGR_PDL                       
		, PAG.SEZ_PDL
		, cast(null as varchar(20)) as CF
		, cast(null as integer) as ID_CLIENTE_BIC
		, cast(null as char(3)) as FONTE 
	from V_EDW_DW_BP.PAG_BOL_ACCETTATI_ST as PAG	
	join EBIL_AREE.CT_PARAMETRI  as P on 1=1
	where PAG.DT_ACCETTAZIONE between ADD_MONTHS (P.DATA_AGGIORNAMENTO +1, -1 ) and P.DATA_AGGIORNAMENTO
		and P.DATA_AGGIORNAMENTO between PAG.DT_INI_VAL and PAG.DT_FIN_VAL
		and PAG.FL_FITTIZIO = 0
		and PAG.TIPO_RAPPORTO = 'BOLL' 
		and (PAG.FLG_RETTIFICA is null or PAG.FLG_RETTIFICA in ('1', '*') ) 
	)with data primary index (CD_FRAZ, DT_ACCETTAZIONE, IMP_BOLLETTINO, NR_RAPPORTO, ORA_ACCETTAZIONE, PGR_PDL, SEZ_PDL) 
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;

create volatile table TMP_BOLL_INF as (
	select A.*
	from TMP_BOLL_INF_0 as A
	join COMPETITOR as B
		on A.NR_RAPPORTO=B.NR_RAPPORTO
	)with data primary index (CD_FRAZ, DT_ACCETTAZIONE, IMP_BOLLETTINO, NR_RAPPORTO, ORA_ACCETTAZIONE, PGR_PDL, SEZ_PDL)  
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;

---cancella tabelle temporanee
drop table TMP_BOLL_INF_0;
.IF ERRORCODE > 0 THEN .QUIT 16;

drop table COMPETITOR;
.IF ERRORCODE > 0 THEN .QUIT 16;

collect statistics on TMP_BOLL_INF column(DT_ACCETTAZIONE);
collect statistics on TMP_BOLL_INF column(SEZ_PDL);
collect statistics on TMP_BOLL_INF column(PGR_PDL);
collect statistics on TMP_BOLL_INF column(CD_FRAZ);
collect statistics on TMP_BOLL_INF column(NR_RAPPORTO);
collect statistics on TMP_BOLL_INF column(ORA_ACCETTAZIONE);


create volatile table GM_MDP_V as (
	select A.* from V_EDW_DW_BP.MDP001_MOVIM_ST as A, EBIL_AREE.CT_PARAMETRI  as P
where substr(A.RIFERIMENTO_OPERAZIONE,1,3)= 'BOL' 
	and cast(A.DATA_OPERAZIONE as date) between ADD_MONTHS(P.DATA_AGGIORNAMENTO, -12)+1 and P.DATA_AGGIORNAMENTO
) with data primary index(CF_USER) on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;

collect statistics on GM_MDP_V column(CF_USER);
collect statistics on GM_MDP_V column(DATA_OPERAZIONE);
collect statistics on GM_MDP_V column(RIFERIMENTO_OPERAZIONE);

-- UPDATE CON MDP
update TMP_BOLL_INF from (
	sel * from GM_MDP_V) a
set CF = A.CF_USER, FONTE = 'MDP'
	where cast(A.DATA_OPERAZIONE as date) = TMP_BOLL_INF.DT_ACCETTAZIONE 
	and cast(substr(A.RIFERIMENTO_OPERAZIONE,9,2) as INT) = cast(TMP_BOLL_INF.SEZ_PDL as INT)
	and cast(trim(substr(A.RIFERIMENTO_OPERAZIONE,11,20)) as BIGINT) = cast(TMP_BOLL_INF.PGR_PDL as BIGINT) 
	and substr(A.RIFERIMENTO_OPERAZIONE,4,5)  = TMP_BOLL_INF.CD_FRAZ;
.IF ERRORCODE > 0 THEN .QUIT 16;

--cancella tabelle temporanee
drop table GM_MDP_V;
.IF ERRORCODE > 0 THEN .QUIT 16;
