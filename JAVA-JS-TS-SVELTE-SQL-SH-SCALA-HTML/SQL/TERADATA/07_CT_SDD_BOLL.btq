-------SDP INFORTUNI-------
create volatile table VAL_FORM_TEC1_INFORTUNI_TMP as (
	select distinct VAL_FORM_TEC1 from TDD_TBGIOPPER_VC
	)with data primary index(VAL_FORM_TEC1)
on commit preserve rows;
collect statistics on VAL_FORM_TEC1_INFORTUNI_TMP column(VAL_FORM_TEC1);
.IF ERRORCODE > 0 THEN .QUIT 16;

