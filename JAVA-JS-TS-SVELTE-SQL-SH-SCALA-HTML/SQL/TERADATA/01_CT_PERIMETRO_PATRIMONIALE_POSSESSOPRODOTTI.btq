-------------------------------------------------------------------------
--------CT PERIMETRO, PATRIMONIALE e POSSESSO PRODOTTI (Tempo T0)--------
-------------------------------------------------------------------------

/*
  Tabelle: EBIL_AREE.CT_PATRIMONIALE - CT_POSSESSO_PRODOTTI - CT_PERIMETRO
  Regime: Delta Mensile
  Gdl: Teradata
  Progetto: Operazionalizzazione CT
  */ 

.SET WIDTH 240;
.SET ERROROUT STDOUT;
--------------------------------------------------------PRODOTTI PATRIMONIALI------------------------------------------------------------
create volatile/*drop/**/table prepatr as(
	sel
		patr.id_cliente_bic
		,case
			when patr.ds_macroprodotto = 'CONTI' then 'CC'
			when patr.ds_macroprodotto = 'LIBRETTI' then 'LIB'
			when patr.ds_macroprodotto = 'CARTACEO' then 'BC'
			when patr.ds_macroprodotto = 'DEMATERIALIZZATO' then 'BD'
			when patr.ds_macroprodotto = 'POSTEPAY' then 'PPAY'
			when patr.ds_macroprodotto = 'EVOLUTION' then 'EVO'
			when patr.ds_macroprodotto = 'TITOLI' and patr.ds_sottoprodotto = 'AZIONI' then 'AZ'
			when patr.ds_macroprodotto = 'TITOLI' and patr.ds_sottoprodotto like '%OBBLIGAZIONI%' then 'OB'
			when patr.ds_macroprodotto = 'TITOLI' and patr.ds_sottoprodotto like '%CERTIFICATES%' then 'CE'
			when patr.ds_macroprodotto = 'TITOLI' and patr.ds_sottoprodotto like '%TITOLI DI STATO%' then 'TDS'
			when patr.ds_macroprodotto = 'TITOLI' then 'Al_T'
			when patr.ds_macroprodotto = 'VITA' and patr.ds_sottoprodotto like '%PREVIDENZA%'  then 'PREV'
			when patr.ds_macroprodotto = 'VITA' and patr.ds_sottoprodotto like '%GARANZIA ALLA PERSONA%'  then 'PERS'
			when patr.ds_macroprodotto = 'VITA' and patr.ds_sottoprodotto like '%RAMO III%'  then 'RIII'
			when patr.ds_macroprodotto = 'VITA' and patr.ds_sottoprodotto like '%RAMO IV%'  then 'RIV'
			when patr.ds_macroprodotto = 'VITA' and patr.ds_sottoprodotto like '%RAMO I%'  then 'RI'
			when patr.ds_macroprodotto = 'VITA' and patr.ds_sottoprodotto like '%MULTIRAMO%'  then 'MR'
			--when patr.ds_macroprodotto = 'VITA' and patr.ds_sottoprodotto = 'NON DEFINITO' then 'Al_P' --FIX:Eliminare riga
			when patr.ds_macroprodotto = 'VITA' then 'RI'--FIX: Forzati i NON DEFINITI/NULL dentro RAMO I, come da accordi con R. Inverno
			when patr.ds_macroprodotto = 'FONDI' then 'F'
			else 'ND'
		end as prodotto
		,case when prodotto = 'LIB' and patr.ds_sottoprodotto in ('LIBRETTO SMART CARTACEO','LIBRETTO SMART DEMATERIALIZZATO') then 1 else 0 end as fl_lib_smart
		,count(*) as n
		,sum(case when patr.cd_tipo_intestatario = 'U' then patr.im_importo else 0 end) as patr_u
		,sum(case when patr.cd_tipo_intestatario = 'P' then patr.im_importo else 0 end) as patr_p
		,sum(case when patr.cd_tipo_intestatario = 'S' then patr.im_importo else 0 end) as patr_s
	from ebil_aree_v.v_pl_patrimoniale patr  
	join EBIL_AREE.CT_PARAMETRI as p ON 1=1
	where patr.cd_natura_giuridica in ('PF', 'COI', '1') and patr.cd_tipo_intestatario in ('P', 'U', 'S')
		and (patr.ds_macroprodotto <> 'CONTI' or (patr.ds_macroprodotto = 'CONTI' and /*patr.ds_sottoprodotto in ('CONTO CORRENTE CONTO PIU',
			'CONTO CORRENTE CONTO RETAIL','CONTO CORRENTE CONTO CLICK','CONTO CORRENTE CONTO RETAIL GRUPPO POSTE',
			'CONTO CORRENTE RETAIL CONVENZIONE BASE','CONTO CORRENTE CONTO BANCOPOSTA GRUPPO POSTE',
			'CONTO CORRENTE CONTO BANCOPOSTA BASE','CONTO CORRENTE CC BASE BP PENSIONATI2',
			'CONTO CORRENTE CC BASE BP PENSIONATI1','CONTO CORRENTE CC BASE BP STANDARD')))*/
			--FIX 2019/10/24:sostituire il filtro per DS_SOTTOPRODOTTO con uno su SK_SOTTOPRODOTTO, recependo anche il nuovo conto CCBP-CONSNEW
			patr.sk_sottoprodotto in ('007602','007619','007646','007641','007616','007600','007630','007631','007639','035933','035932','069640','069641'
				,'069642','069643','069644','069645')))
		and patr.id_cliente_bic is not null   --Patch BP 20191005
		and patr.id_periodotemporale = (extract(year from p.data_aggiornamento))*100 + extract(month from p.data_aggiornamento)
	group by 1,2,3
) with data primary index(id_cliente_bic) on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


create volatile table patrimoniale as(
	sel patr.id_cliente_bic
		
		--FLAG
		,max(case when patr.prodotto = 'CC' then 1 else 0 end) as fl_ccbp
		,max(case when patr.prodotto = 'LIB' then 1 else 0 end) as fl_lib
		,max(patr.fl_lib_smart) as fl_lib_smart
		,max(case when patr.prodotto = 'BC' then 1 else 0 end) as fl_bpf_cart
		,max(case when patr.prodotto = 'BD' then 1 else 0 end) as fl_bpf_dem
		,greatest(fl_bpf_cart, fl_bpf_dem) as fl_bpf
		,max(case when patr.prodotto = 'PPAY' then 1 else 0 end) as fl_ppay
		,max(case when patr.prodotto = 'EVO' then 1 else 0 end) as fl_evo
		,max(case when patr.prodotto = 'AZ' then 1 else 0 end) as fl_az
		,max(case when patr.prodotto = 'OB' then 1 else 0 end) as fl_ob
		,max(case when patr.prodotto = 'CE' then 1 else 0 end) as fl_ce
		,max(case when patr.prodotto = 'TDS' then 1 else 0 end) as fl_tds
		,max(case when patr.prodotto = 'Al_T' then 1 else 0 end) as fl_altro_tit
		,max(case when patr.prodotto = 'PREV' then 1 else 0 end) as fl_previdenza
		,max(case when patr.prodotto = 'PERS' then 1 else 0 end) as fl_persona
		,max(case when patr.prodotto = 'RI' then 1 else 0 end) as fl_ramo_i
		,max(case when patr.prodotto = 'RIII' then 1 else 0 end) as fl_ramo_iii
		,max(case when patr.prodotto = 'RIV' then 1 else 0 end) as fl_ramo_iv
		,max(case when patr.prodotto = 'MR' then 1 else 0 end) as fl_multiramo
		,max(case when patr.prodotto = 'Al_P' then 1 else 0 end) as fl_altre_polizze
		,max(case when patr.prodotto = 'F' then 1 else 0 end) as fl_fondi

		--FASCIA
		,sum(patr.patr_u + patr.patr_p + patr.patr_s) as fascia
		
		--CONTO
		,sum(case when patr.prodotto = 'CC' then patr.patr_u else 0 end) as cc_u
		,sum(case when patr.prodotto = 'CC' then patr.patr_p else 0 end) as cc_p
		,sum(case when patr.prodotto = 'CC' then patr.patr_s else 0 end) as cc_s
		--LIBRETTO
		,sum(case when patr.prodotto = 'LIB' then patr.patr_u else 0 end) as lib_u
		,sum(case when patr.prodotto = 'LIB' then patr.patr_p else 0 end) as lib_p
		,sum(case when patr.prodotto = 'LIB' then patr.patr_s else 0 end) as lib_s
		--BPF CART
		,sum(case when patr.prodotto = 'BC' then patr.patr_u else 0 end) as bpf_cart_u
		,sum(case when patr.prodotto = 'BC' then patr.patr_p else 0 end) as bpf_cart_p
		,sum(case when patr.prodotto = 'BC' then patr.patr_s else 0 end) as bpf_cart_s
		--BPF_DEM
		,sum(case when patr.prodotto = 'BD' then patr.patr_u else 0 end) as bpf_dem_u
		,sum(case when patr.prodotto = 'BD' then patr.patr_p else 0 end) as bpf_dem_p
		,sum(case when patr.prodotto = 'BD' then patr.patr_s else 0 end) as bpf_dem_s
		--PPAY
		,sum(case when patr.prodotto = 'PPAY' then patr.patr_u else 0 end) as ppay_u
		--EVO
		,sum(case when patr.prodotto = 'EVO' then patr.patr_u else 0 end) as evo_u
		--AZIONI
		,sum(case when patr.prodotto = 'AZ' then patr.patr_u else 0 end) as az_u
		,sum(case when patr.prodotto = 'AZ' then patr.patr_p else 0 end) as az_p
		,sum(case when patr.prodotto = 'AZ' then patr.patr_s else 0 end) as az_s
		--OBBLIGAZIONI
		,sum(case when patr.prodotto = 'OB' then patr.patr_u else 0 end) as ob_u
		,sum(case when patr.prodotto = 'OB' then patr.patr_p else 0 end) as ob_p
		,sum(case when patr.prodotto = 'OB' then patr.patr_s else 0 end) as ob_s
		--CERTIFICATES
		,sum(case when patr.prodotto = 'CE' then patr.patr_u else 0 end) as ce_u
		,sum(case when patr.prodotto = 'CE' then patr.patr_p else 0 end) as ce_p
		,sum(case when patr.prodotto = 'CE' then patr.patr_s else 0 end) as ce_s
		--TDS
		,sum(case when patr.prodotto = 'TDS' then patr.patr_u else 0 end) as tds_u
		,sum(case when patr.prodotto = 'TDS' then patr.patr_p else 0 end) as tds_p
		,sum(case when patr.prodotto = 'TDS' then patr.patr_s else 0 end) as tds_s
		--ALTRI TITOLI
		,sum(case when patr.prodotto = 'Al_T' then patr.patr_u else 0 end) as altro_u
		,sum(case when patr.prodotto = 'Al_T' then patr.patr_p else 0 end) as altro_p
		,sum(case when patr.prodotto = 'Al_T' then patr.patr_s else 0 end) as altro_s
		--PREVIDENZA
		,sum(case when patr.prodotto = 'PREV' then patr.patr_u else 0 end) as prev_u
		--PERSONA
		,sum(case when patr.prodotto = 'PERS' then patr.patr_u else 0 end) as persona_u
		--RAMO_I
		,sum(case when patr.prodotto = 'RI' then patr.patr_u else 0 end) as ramo_i_u
		--RAMO_III
		,sum(case when patr.prodotto = 'RIII' then patr.patr_u else 0 end) as ramo_iii_u
		--RAMO_IV
		,sum(case when patr.prodotto = 'RIV' then patr.patr_u else 0 end) as ramo_iv_u
		--MULTIRAMO
		,sum(case when patr.prodotto = 'MR' then patr.patr_u else 0 end) as multiramo_u
		--ALTRE POLIZZE
		,sum(case when patr.prodotto = 'Al_P' then patr.patr_u else 0 end) as altre_polizze_u
		--FONDI
		,sum(case when patr.prodotto = 'F' then patr.patr_u else 0 end) as f_u -- PATCH come da mail Brunelli del 2/5/2019: cambiato fondi_u in f_u
		,sum(case when patr.prodotto = 'F' then patr.patr_p else 0 end) as f_p -- PATCH come da mail Brunelli del 2/5/2019: cambiato fondi_p in f_p
		,sum(case when patr.prodotto = 'F' then patr.patr_s else 0 end) as f_s -- PATCH come da mail Brunelli del 2/5/2019: cambiato fondi_s in f_s

		--NUMERO PEZZI
		,sum(case when patr.prodotto = 'CC' then patr.n else 0 end) as n_conto
		,sum(case when patr.prodotto = 'LIB' then patr.n else 0 end) as n_libretto
		,sum(case when patr.fl_lib_smart = 1 then patr.n else 0 end) as n_lib_smart
		,sum(case when patr.prodotto = 'BC' then patr.n else 0 end) as n_bpf_cart
		,sum(case when patr.prodotto = 'BD' then patr.n else 0 end) as n_bpf_dem
		,n_bpf_cart + n_bpf_dem as n_bpf
		,sum(case when patr.prodotto = 'PPAY' then patr.n else 0 end) as n_ppay
		,sum(case when patr.prodotto = 'EVO' then patr.n else 0 end) as n_evo
		,sum(case when patr.prodotto = 'AZ' then patr.n else 0 end) as n_az
		,sum(case when patr.prodotto = 'OB' then patr.n else 0 end) as n_ob
		,sum(case when patr.prodotto = 'CE' then patr.n else 0 end) as n_ce
		,sum(case when patr.prodotto = 'TDS' then patr.n else 0 end) as n_tds
		,sum(case when patr.prodotto = 'Al_T' then patr.n else 0 end) as n_altro_tit
		,sum(case when patr.prodotto = 'PREV' then patr.n else 0 end) as n_previdenza
		,sum(case when patr.prodotto = 'PERS' then patr.n else 0 end) as n_persona
		,sum(case when patr.prodotto = 'RI' then patr.n else 0 end) as n_ramo_i
		,sum(case when patr.prodotto = 'RIII' then patr.n else 0 end) as n_ramo_iii
		,sum(case when patr.prodotto = 'RIV' then patr.n else 0 end) as n_ramo_iv
		,sum(case when patr.prodotto = 'MR' then patr.n else 0 end) as n_multiramo
		,sum(case when patr.prodotto = 'Al_P' then patr.n else 0 end) as n_altre_polizze
		,sum(case when patr.prodotto = 'F' then patr.n else 0 end) as n_fondi

	from prepatr as patr
	group by 1
) with data unique primary index(id_cliente_bic) on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


drop table prepatr;
.IF ERRORCODE > 0 THEN .QUIT 16;


--------------------------------------------------------PRODOTTI NON PATRIMONIALI------------------------------------------------------------
----------POSTAMAT----------
create volatile table POSTAMAT as (
	select   
		C.ID_CLIENTE_BIC,
		1 as FL_POSTAMAT_RICHIESTA, 
		COUNT(DISTINCT NR_CARTA) as NR_POSTAMAT_RICHIESTA
	from
		(select 
			NR_CARTA, CD_TIPO_CARTA, CD_SOTTOTIPO_CARTA, CD_PRODOTTO, DT_RICHIESTA, FLG_RINNOVO, CD_FISCALE 
		from V_EDW_DW_BP.MON_ANAGRCARTA_ST		
		join EBIL_AREE.CT_PARAMETRI on 1=1					
		where DATA_AGGIORNAMENTO between DT_INI_VAL and DT_FIN_VAL
			and DT_RICHIESTA <=  DATA_AGGIORNAMENTO and DT_SCADENZA >  DATA_AGGIORNAMENTO
			and (DT_ESTINZIONE >  DATA_AGGIORNAMENTO or DT_ESTINZIONE IS NULL)
			and (CD_STATO_CARTA <>'B' or CD_STATO_CARTA IS NULL)
			and FL_FITTIZIO = 0
			and CD_TIPO_CARTA = '01' 
			and CD_SOTTOTIPO_CARTA NOT IN ('58', '40', '09', '87')
		) as A 					
	inner join
		(sel 
			ID_CLIENTE_BIC, COD_FISCALE
		from EDWAE_VM.CLIENTE
		where VERSIONE_CORRENTE=1
		group by 1,2
		) as C
		on A.CD_FISCALE=C.COD_FISCALE
	inner join
		(sel ID_CLIENTE_BIC 
		from PATRIMONIALE
		where FL_CCBP>0) as D
		on C.ID_CLIENTE_BIC=D.ID_CLIENTE_BIC
	group by 1
	)with data primary index (ID_CLIENTE_BIC)
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


----------CARTA DI CREDITO----------
create volatile table CARTA_DI_CREDITO as (
	select 
		C.ID_CLIENTE_BIC, 
		1 as FL_CARTA_DI_CREDITO,
		COUNT(DISTINCT NR_CARTA) as NR_CARTE_CREDITO
	from 
		(select  
			CD_CC||NDG_TITOLARE||CD_PRODOTTO as NR_CARTA, CD_FISCALE
		from V_EDW_DW_BP.MON_ANAGRCARTA_ST  as G 		
		join EBIL_AREE.CT_PARAMETRI on 1=1		
		where G.CD_TIPO_CARTA in ('09','25') 
			and DATA_AGGIORNAMENTO between DT_INI_VAL and DT_FIN_VAL 
			and DT_RICHIESTA<=  DATA_AGGIORNAMENTO
			and DT_SCADENZA>  DATA_AGGIORNAMENTO
			and (DT_ESTINZIONE>  DATA_AGGIORNAMENTO or DT_ESTINZIONE is NULL)
			and CD_STATO_CARTA<>'B'
		) A			
	inner join		
		(select 
			ID_CLIENTE_BIC, COD_FISCALE
		from EDWAE_VM.CLIENTE
		where VERSIONE_CORRENTE=1
		group by 1,2
		) C
		on A.CD_FISCALE=C.COD_FISCALE
	inner join
		(sel ID_CLIENTE_BIC 
		from PATRIMONIALE
		where FL_CCBP>0) as D
		on C.ID_CLIENTE_BIC=D.ID_CLIENTE_BIC
	group by 1
	)with data primary index (ID_CLIENTE_BIC,NR_CARTE_CREDITO)
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


----------CARTA LIBRETTO----------
create volatile table CARTA_LIBRETTO as (
	select 
		C.ID_CLIENTE_BIC, 
		1 as FL_CARTA_LIBRETTO,
		COUNT(DISTINCT NR_CARTA) as NR_CARTE_LIBRETTO
	from
		(select 
			NR_CARTA, CD_TIPO_CARTA, CD_SOTTOTIPO_CARTA, CD_PRODOTTO, DT_RICHIESTA, FLG_RINNOVO, CD_FISCALE 
		from V_EDW_DW_BP.MON_ANAGRCARTA_ST
		join EBIL_AREE.CT_PARAMETRI on 1=1 		
		where DATA_AGGIORNAMENTO between DT_INI_VAL and DT_FIN_VAL
			and DT_RICHIESTA <=  DATA_AGGIORNAMENTO  and DT_SCADENZA >  DATA_AGGIORNAMENTO
			and (DT_ESTINZIONE >  DATA_AGGIORNAMENTO or DT_ESTINZIONE is NULL)
			and (CD_STATO_CARTA <>'B' or CD_STATO_CARTA is NULL)
			and DT_ATTIVAZIONE is NOT NULL 
			and DT_ATTIVAZIONE <= DATA_AGGIORNAMENTO
			and FL_FITTIZIO = 0
			and CD_TIPO_CARTA = '01' 
			and CD_SOTTOTIPO_CARTA IN ('58', '40', '09')
		) A	
	inner join
		(sel ID_CLIENTE_BIC, COD_FISCALE
		from EDWAE_VM.CLIENTE
		where VERSIONE_CORRENTE=1
		group by 1,2) C
		on A.CD_FISCALE=C.COD_FISCALE
	inner join
		(sel ID_CLIENTE_BIC 
		from PATRIMONIALE
		where FL_LIB>0) as D
		on C.ID_CLIENTE_BIC=D.ID_CLIENTE_BIC
	group by 1
	)with data primary index (ID_CLIENTE_BIC,FL_CARTA_LIBRETTO)
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


----------SCOPERTO----------
create volatile table SCOPERTO as (
	select 
		B.ID_CLIENTE_BIC, 
		1 as FL_SCOPERTO, 
		COUNT(DISTINCT A.ID_RAPPORTO) as NR_SCOPERTO
	from
		(sel ID_RAPPORTO
		from EDWAE_VM.RAPPORTO_FINANZIAMENTI
		join EBIL_AREE.CT_PARAMETRI on 1=1 		
		where DT_INI_VAL <= DATA_AGGIORNAMENTO  and DT_FIN_VAL >= DATA_AGGIORNAMENTO
			and STATO_SINTETICO='1'
			and CD_FLUSSO ='007' 
		) as A				
	inner join	
		(sel ID_RAPPORTO, TIPO_INTESTATARIO, ID_CLIENTE_BIC
		from EDWAE_VM.ASSOC_RAPPORTO_CLIENTE
		where CD_FLUSSO= '007'
			and ID_CLIENTE_CRM = '0') as B
		on A.ID_RAPPORTO= B.ID_RAPPORTO
	inner join
		(select ID_CLIENTE_BIC
		from PATRIMONIALE
		where FL_CCBP>0) as C
		on B.ID_CLIENTE_BIC=C.ID_CLIENTE_BIC
	group by 1
	) with data primary index (ID_CLIENTE_BIC,FL_SCOPERTO)
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


----------DEPOSITO TITOLI----------
create volatile table DEPOSITO_TITOLI as (
	sel 
		ID_CLIENTE_BIC, 
		1 as FL_DEP_TIT, 
		COUNT(DISTINCT A.ID_RAPPORTO) as NR_DEP_TIT
	from  
		(sel ID_RAPPORTO
		from EDWAE_VM.RAPPORTO_INVESTIMENTI
		join EBIL_AREE.CT_PARAMETRI on 1=1
		where DT_INI_VAL <= DATA_AGGIORNAMENTO and DT_FIN_VAL >= DATA_AGGIORNAMENTO
			and STATO_SINTETICO='1'
		) as A
	inner join 
		(sel  ID_CLIENTE_BIC, ID_RAPPORTO
		from EDWAE_VM.ASSOC_RAPPORTO_CLIENTE
		where CD_FLUSSO IN ('012')
		and ID_CLIENTE_CRM = '0' 
		) as B
		on A.ID_RAPPORTO = B.ID_RAPPORTO 		
	group by 1
	) with data primary index (ID_CLIENTE_BIC,FL_DEP_TIT)
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


----------MUTUO----------
create volatile table MUTUO_TMP as (
	select 
		MUTUO_CLI.CODICE_FISCALE, 
		COUNT(DISTINCT MUTUO_POSIDONIA.ID_PRATICA_POSIDONIA) as NR_MUTUI,
		SUM(CASE WHEN  ASSICURAZIONE_IMPORTO>0 THEN 1 ELSE 0 END) AS NR_CPI_MUTUO
	from  V_EDW_DW_BP.FIN_MUTUI_POSID_ST as MUTUO_POSIDONIA
	join EBIL_AREE.CT_PARAMETRI on 1=1
	inner join V_EDW_DW_BP.FIN_MUTUI_CLI_ST as MUTUO_CLI
		on MUTUO_POSIDONIA.ID_PRATICA_POSIDONIA = MUTUO_CLI.ID_PRATICA_POSIDONIA
			and CT_PARAMETRI.DATA_AGGIORNAMENTO between MUTUO_POSIDONIA.DT_INI_VAL and MUTUO_POSIDONIA.DT_FIN_VAL
			and CT_PARAMETRI.DATA_AGGIORNAMENTO between MUTUO_CLI.DT_INI_VAL and MUTUO_CLI.DT_FIN_VAL
			and MUTUO_POSIDONIA.DT_EROGAZIONE <=  CT_PARAMETRI.DATA_AGGIORNAMENTO 
			and (MUTUO_POSIDONIA.DT_ANNULLO > CT_PARAMETRI.DATA_AGGIORNAMENTO or MUTUO_POSIDONIA.DT_ANNULLO is NULL)
			and (MUTUO_POSIDONIA.DT_SCADENZA_MUTUO > CT_PARAMETRI.DATA_AGGIORNAMENTO or MUTUO_POSIDONIA.DT_SCADENZA_MUTUO is NULL)
			and (MUTUO_POSIDONIA.DT_ESTINZIONE_ANTICIPATA > CT_PARAMETRI.DATA_AGGIORNAMENTO or MUTUO_POSIDONIA.DT_ESTINZIONE_ANTICIPATA is NULL)
	group by 1
	) with data primary index(CODICE_FISCALE) 
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


create volatile table MUTUO as (
	sel 
		DISTINCT ID_CLIENTE_BIC, 
		1 as FL_MUTUO
	from MUTUO_TMP as A
	inner join
		(sel 
			ID_CLIENTE_BIC, 
			cod_fiscale_sorgente
		from BIC_ODS_V.KEY_MAP_CLIENTE
		where DT_FINE_VALIDITA is NULL
			and COD_SISTEMA_SORGENTE = 'BP') B 	
		on A.codice_fiscale=B.COD_fiscale_SORGENTE
	) with data primary index(ID_CLIENTE_BIC) 
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


----------PRESTITI----------
