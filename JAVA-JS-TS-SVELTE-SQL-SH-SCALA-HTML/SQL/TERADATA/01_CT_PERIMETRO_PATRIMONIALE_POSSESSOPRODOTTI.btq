CREATE VOLATILE TABLE VTB_POSSESSO_PRODOTTI_SV AS
(SELECT ID_PERIODO_TEMPORALE, ROW_NUMBER () over ( ORDER BY ID_PERIODO_TEMPORALE  DESC) AS ORDINAMENTO
FROM  EBIL_AREE.CT_POSSESSO_PRODOTTI
GROUP BY 1)
WITH DATA PRIMARY INDEX (ID_PERIODO_TEMPORALE) ON COMMIT PRESERVE ROWS;
.IF ERRORCODE > 0 THEN .QUIT 16;

DELETE EBIL_AREE.CT_POSSESSO_PRODOTTI
WHERE ID_PERIODO_TEMPORALE IN ( SELECT ID_PERIODO_TEMPORALE 
FROM VTB_POSSESSO_PRODOTTI_SV
WHERE ORDINAMENTO >25);
.IF ERRORCODE > 0 THEN .QUIT 16;

----------CT PATRIMONIALE ----------

BT

;DELETE EBIL_AREE.CT_PATRIMONIALE
WHERE ID_PERIODO_TEMPORALE= (SELECT ID_PERIODO_TEMPORALE FROM EBIL_AREE.CT_PARAMETRI)

;INSERT INTO EBIL_AREE.CT_PATRIMONIALE 
	select
		P.ID_CLIENTE_BIC,
		P.ID_PERIODO_TEMPORALE,
		coalesce(A.FASCIA,0) as FASCIA,
		coalesce(A.CC_U,0) as CC_U, 
		coalesce(A.CC_P,0) as CC_P, 
		coalesce(A.CC_S,0) as CC_S, 
		coalesce(A.LIB_U,0) as LIB_U,
		coalesce(A.LIB_P,0) as LIB_P,
		coalesce(A.LIB_S,0) as LIB_S,
		coalesce(A.BPF_CART_U,0) as BPF_CART_U, 
		coalesce(A.BPF_CART_P,0) as BPF_CART_P, 
		coalesce(A.BPF_CART_S,0) as BPF_CART_S, 
		coalesce(A.BPF_DEM_U,0) as BPF_DEM_U, 
		coalesce(A.BPF_DEM_P,0) as BPF_DEM_P,
		coalesce(A.BPF_DEM_S,0) as BPF_DEM_S, 
		coalesce(A.F_U,0) as F_U, 
		coalesce(A.F_P,0) as F_P,
		coalesce(A.F_S,0) as F_S,
		coalesce(A.AZ_U,0) as AZ_U, 
		coalesce(A.AZ_P,0) as AZ_P, 
		coalesce(A.AZ_S,0) as AZ_S,
		coalesce(A.OB_U,0) as OB_U,
		coalesce(A.OB_P,0) as OB_P,
		coalesce(A.OB_S,0) as OB_S,
		coalesce(A.TDS_U,0) as TDS_U,
		coalesce(A.TDS_P,0) as TDS_P,
		coalesce(A.TDS_S,0) as TDS_S,
		coalesce(A.CE_U,0) as CE_U,
		coalesce(A.CE_P,0) as CE_P,
		coalesce(A.CE_S,0) as CE_S,
		coalesce(A.ALTRO_U,0) as ALTRO_U,
		coalesce(A.ALTRO_P,0) as ALTRO_P,
		coalesce(A.ALTRO_S,0) as ALTRO_S, 
		coalesce(A.RAMO_I_U,0) as RAMO_I_U, 
		coalesce(A.RAMO_III_U,0) as RAMO_III_U, 
		coalesce(A.RAMO_IV_U,0) as RAMO_IV_U,
		coalesce(A.MULTIRAMO_U,0) as MULTIRAMO_U,
		coalesce(A.PREV_U,0) as PREV_U,
		coalesce(A.PERSONA_U,0) as PERSONA_U,
		coalesce(A.PPAY_U,0) as PPAY_U,
		coalesce(A.EVO_U,0) as EVO_U 
	from EBIL_AREE.V_CT_PERIMETRO as P  
	left join PATRIMONIALE as a on P.ID_CLIENTE_BIC=A.ID_CLIENTE_BIC
	where P.id_periodo_temporale in (SELECT ID_PERIODO_TEMPORALE FROM EBIL_AREE.CT_PARAMETRI)

	;ET;
	
CREATE VOLATILE TABLE VTB_PATRIMONIALE_SV AS
(SELECT ID_PERIODO_TEMPORALE, ROW_NUMBER () over ( ORDER BY ID_PERIODO_TEMPORALE  DESC) AS ORDINAMENTO
FROM  EBIL_AREE.CT_PATRIMONIALE
GROUP BY 1)
WITH DATA PRIMARY INDEX (ID_PERIODO_TEMPORALE) ON COMMIT PRESERVE ROWS;
.IF ERRORCODE > 0 THEN .QUIT 16;

DELETE EBIL_AREE.CT_PATRIMONIALE
WHERE ID_PERIODO_TEMPORALE IN ( SELECT ID_PERIODO_TEMPORALE 
FROM VTB_PATRIMONIALE_SV
WHERE ORDINAMENTO >25);
.IF ERRORCODE > 0 THEN .QUIT 16;


	

