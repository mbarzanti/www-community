-- HH  FIX FLAG PRESTITI E CQ 202003  
create volatile table PERIMETRO_finale as(
select A.ID_CLIENTE_BIC
from (select ID_CLIENTE_BIC from PATRIMONIALE
			where (FL_CCBP>0 or
				FL_LIB>0 or
				FL_BPF_CART>0 or
				FL_BPF_DEM>0 or
				FL_BPF>0 or
				FL_PPAY>0 or
				FL_EVO>0 or
				FL_AZ>0 or
				FL_OB>0 or
				FL_CE>0 or
				FL_TDS>0 or
				FL_ALTRO_TIT>0 or
				FL_PREVIDENZA>0 or
				FL_PERSONA>0 or
				FL_RAMO_I>0 or
				FL_RAMO_III>0 or
				FL_RAMO_IV>0 or
				FL_MULTIRAMO>0 or
				FL_FONDI>0)
	
	union 
		select ID_CLIENTE_BIC from MUTUO	
			where FL_MUTUO>0 	
	union 
		select ID_CLIENTE_BIC from PRODOTTI_PRESTITI
			/*where (FL_PRESTITO_COMPASS>0 or
				FL_CQS_BNL>0 or
				FL_PRESTITO_FINDO>0 or
				FL_PRONTISSIMO>0 or
				FL_SPECIAL_CASH>0 or
				FL_CQS_DB>0 or
				FL_PRESTITO_DB>0 or
				FL_CQS_COMPASS>0)* HH  FIX FLAG PRESTITI E CQ 202003 */
				
				where (FL_PRESTITO>0 or
				FL_CQS>0)
				
	union 
		select ID_CLIENTE_BIC from PATRIMONIALE
			where FL_LIB_SMART>0
	union 
		select ID_CLIENTE_BIC from LIBRETTO_SUPER_SMART
			where FL_LIB_SUPER_SMART>0
	union 
		select ID_CLIENTE_BIC from POSTAMAT
			where FL_POSTAMAT_RICHIESTA>0
	union 
		select ID_CLIENTE_BIC from CARTA_DI_CREDITO
			where FL_CARTA_DI_CREDITO>0
	union 
		select ID_CLIENTE_BIC from CARTA_LIBRETTO
			where FL_CARTA_LIBRETTO>0
	union 
		select ID_CLIENTE_BIC from SCOPERTO
			where FL_SCOPERTO>0
	union 
		select ID_CLIENTE_BIC from DANNI
			where FL_DANNI_PA>0
	union 
		select ID_CLIENTE_BIC from DEPOSITO_TITOLI
			where FL_DEP_TIT>0			
	union 
		select ID_CLIENTE_BIC from FL_BPOL_CLICK
			where FL_BPOL_CLICK>0			
) A 
where ID_CLIENTE_BIC>0)
with data unique primary index (id_cliente_bic) on commit preserve rows
;


BT

;DELETE EBIL_AREE.CT_PERIMETRO
WHERE ID_PERIODO_TEMPORALE= (SELECT ID_PERIODO_TEMPORALE FROM EBIL_AREE.CT_PARAMETRI)

;insert into EBIL_AREE.CT_PERIMETRO 
select per.ID_CLIENTE_BIC, par.id_periodo_temporale, par.data_aggiornamento
from perimetro_finale per
join 
ebil_aree.ct_parametri par on 1=1

;ET;

CREATE VOLATILE TABLE VTB_PERIMETRO_SV AS
(SELECT ID_PERIODO_TEMPORALE, ROW_NUMBER () over ( ORDER BY ID_PERIODO_TEMPORALE  DESC) AS ORDINAMENTO
FROM  EBIL_AREE.CT_PERIMETRO
GROUP BY 1)
WITH DATA PRIMARY INDEX (ID_PERIODO_TEMPORALE) ON COMMIT PRESERVE ROWS;
.IF ERRORCODE > 0 THEN .QUIT 16;

DELETE EBIL_AREE.CT_PERIMETRO
WHERE ID_PERIODO_TEMPORALE IN ( SELECT ID_PERIODO_TEMPORALE 
FROM VTB_PERIMETRO_SV
WHERE ORDINAMENTO >25);
.IF ERRORCODE > 0 THEN .QUIT 16;


----------Tabella POSSESSO PRODOTTI----------
create volatile table CT_POSSESSO_PRODOTTI_1 as (
	select P.ID_CLIENTE_BIC,
           P.ID_PERIODO_TEMPORALE,	
		coalesce(A.FL_CCBP,0) as FL_CCBP,
		coalesce(A.FL_LIB,0) as FL_LIB,
		coalesce(A.FL_BPF_CART,0) as FL_BPF_CART,
		coalesce(A.FL_BPF_DEM,0) as FL_BPF_DEM,
		coalesce(A.FL_BPF,0) as FL_BPF,
		coalesce(A.FL_PPAY,0) as FL_PPAY,
		coalesce(A.FL_EVO,0) as FL_EVO,
		coalesce(A.FL_AZ,0) as FL_AZ,
		coalesce(A.FL_OB,0) as FL_OB,
		coalesce(A.FL_CE,0) as FL_CE,
		coalesce(A.FL_TDS,0) as FL_TDS,
		coalesce(A.FL_ALTRO_TIT,0) as FL_ALTRO_TIT,
		coalesce(A.FL_PREVIDENZA,0) as FL_PREVIDENZA,
		coalesce(A.FL_PERSONA,0) as FL_PERSONA,
		coalesce(A.FL_RAMO_I,0) as FL_RAMO_I,
		coalesce(A.FL_RAMO_III,0) as FL_RAMO_III,
		coalesce(A.FL_RAMO_IV,0) as FL_RAMO_IV,
		coalesce(A.FL_MULTIRAMO,0) as FL_MULTIRAMO,
		coalesce(A.FL_FONDI,0) as FL_FONDI,
		(case when POL.N_BFP_CART_SCADENZA>0 and FL_BPF_CART>0 then 1 else 0 end) as  FL_BFP_CART_SCADENZA,
		(case when POL.N_BFP_DEM_SCADENZA>0 and FL_BPF_DEM>0 then 1 else 0 end) as  FL_BFP_DEM_SCADENZA,
		(case when POL.N_AZ_SCADENZA>0 and FL_AZ>0 then 1 else 0 end) as FL_AZ_SCADENZA,
		(case when POL.N_OB_SCADENZA>0 and FL_OB>0 then 1 else 0 end) as FL_OB_SCADENZA,
		(case when POL.N_CE_SCADENZA>0 and FL_CE>0 then 1 else 0 end) as FL_CE_SCADENZA,
		(case when POL.N_TDS_SCADENZA>0 and FL_TDS>0 then 1 else 0 end) as FL_TDS_SCADENZA,
		(case when POL.N_ALTRO_TIT_SCADENZA>0 and FL_ALTRO_TIT>0 then 1 else 0 end) as FL_ALTRO_TIT_SCADENZA,
		(case when POL.N_PREVIDENZA_SCADENZA>0 and FL_PREVIDENZA>0 then 1 else 0 end) as FL_PREVIDENZA_SCADENZA,
		(case when POL.N_PERSONA_SCADENZA>0 and FL_PERSONA>0 then 1 else 0 end) as FL_PERSONA_SCADENZA,
		(case when POL.N_RAMO_I_SCADENZA>0 and FL_RAMO_I>0 then 1 else 0 end) as FL_RAMO_I_SCADENZA,
		(case when POL.N_RAMO_III_SCADENZA>0 and FL_RAMO_III>0 then 1 else 0 end) as FL_RAMO_III_SCADENZA,
		(case when POL.N_RAMO_IV_SCADENZA>0 and FL_RAMO_IV>0 then 1 else 0 end) as FL_RAMO_IV_SCADENZA,
		(case when POL.N_MULTIRAMO_SCADENZA>0 and FL_MULTIRAMO>0 then 1 else 0 end) as FL_MULTIRAMO_SCADENZA
	from EBIL_AREE.V_CT_PERIMETRO as P 
	left join PATRIMONIALE as A 
		on P.ID_CLIENTE_BIC=A.ID_CLIENTE_BIC
	left join 
		(sel 
			ID_CLIENTE_BIC,
			SUM(case when TIPO_RAPPORTO='03' and CATEGORIA='CARTACEO' and NUMERO_PRODOTTI_SCADENZA>0 then 1 else 0 end) as N_BFP_CART_SCADENZA,
			SUM(case when TIPO_RAPPORTO='03' and CATEGORIA='DEMATERIALIZZATO' and NUMERO_PRODOTTI_SCADENZA>0 then 1 else 0 end) as N_BFP_DEM_SCADENZA,

			SUM(case when TIPO_RAPPORTO='15' and CATEGORIA='AZIONI' and NUMERO_PRODOTTI_SCADENZA>0 then 1 else 0 end) as N_AZ_SCADENZA, 
			SUM(case when TIPO_RAPPORTO='15' and CATEGORIA='OBBLIGAZIONI' and NUMERO_PRODOTTI_SCADENZA>0 then 1 else 0 end) as N_OB_SCADENZA,
			SUM(case when TIPO_RAPPORTO='15' and CATEGORIA='CERTIFICATES' and NUMERO_PRODOTTI_SCADENZA>0 then 1 else 0 end) as N_CE_SCADENZA,
			SUM(case when TIPO_RAPPORTO='15' and CATEGORIA='TITOLI_DI_STATO' and NUMERO_PRODOTTI_SCADENZA>0 then 1 else 0 end) as N_TDS_SCADENZA,
			SUM(case when TIPO_RAPPORTO='15' and CATEGORIA='ALTRO' and NUMERO_PRODOTTI_SCADENZA>0 then 1 else 0 end) as N_ALTRO_TIT_SCADENZA,

			SUM(case when TIPO_RAPPORTO='13' and CATEGORIA='PREVIDENZA' and NUMERO_PRODOTTI_SCADENZA>0 then 1 else 0 end) as N_PREVIDENZA_SCADENZA,
			SUM(case when TIPO_RAPPORTO='13' and CATEGORIA='GARANZIA ALLA PERSONA_VITA' and NUMERO_PRODOTTI_SCADENZA>0 then 1 else 0 end) as N_PERSONA_SCADENZA,
			SUM(case when TIPO_RAPPORTO='13' and CATEGORIA='RAMO I' and NUMERO_PRODOTTI_SCADENZA>0 then 1 else 0 end) as N_RAMO_I_SCADENZA,
			SUM(case when TIPO_RAPPORTO='13' and CATEGORIA='RAMO III' and NUMERO_PRODOTTI_SCADENZA>0 then 1 else 0 end) as N_RAMO_III_SCADENZA,
			SUM(case when TIPO_RAPPORTO='13' and CATEGORIA='RAMO IV' and NUMERO_PRODOTTI_SCADENZA>0 then 1 else 0 end) as N_RAMO_IV_SCADENZA,
			SUM(case when TIPO_RAPPORTO='13' and CATEGORIA='MULTIRAMO' and NUMERO_PRODOTTI_SCADENZA>0 then 1 else 0 end) as N_MULTIRAMO_SCADENZA
		from SCADENZE_3
		group by 1) POL
ON A.ID_CLIENTE_BIC=POL.ID_CLIENTE_BIC
) with data primary index (ID_CLIENTE_BIC) 
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


BT 

;DELETE EBIL_AREE.CT_POSSESSO_PRODOTTI
WHERE ID_PERIODO_TEMPORALE= (SELECT ID_PERIODO_TEMPORALE FROM EBIL_AREE.CT_PARAMETRI)


--HH FIX FLAG PRESTITI E CQ 202003 
;INSERT INTO EBIL_AREE.CT_POSSESSO_PRODOTTI
	select P.*,
		coalesce(B.FL_MUTUO, 0) as FL_MUTUO,
		coalesce(C.FL_PRESTITO, 0) as FL_PRESTITO,
		coalesce(C.FL_CQS, 0) as FL_CQS,
		/*HH FIX FLAG PRESTITI E CQ 202003 
		--coalesce(C.FL_PRESTITO_COMPASS, 0) as FL_PRESTITO_COMPASS,
		--coalesce(C.FL_CQS_BNL, 0) as FL_CQS_BNL,
		--coalesce(C.FL_PRESTITO_FINDO, 0) as FL_PRESTITO_FINDO,
		--coalesce(C.FL_PRONTISSIMO, 0) as FL_PRONTISSIMO,
		--coalesce(C.FL_SPECIAL_CASH, 0) as FL_SPECIAL_CASH,
		--coalesce(C.FL_CQS_DB, 0) as FL_CQS_DB,
		--coalesce(C.FL_PRESTITO_DB, 0) as FL_PRESTITO_DB,
		--coalesce(C.FL_CQS_COMPASS, 0) as FL_CQS_COMPASS,*/
		coalesce(C.FL_PRESTITI_SCADENZA,0) as FL_PRESTITI_SCADENZA,
		coalesce(C.FL_CQS_SCADENZA,0) as FL_CQS_SCADENZA,
		coalesce(D.FL_LIB_SMART, 0) as FL_LIB_SMART,
		coalesce(E.FL_LIB_SUPER_SMART, 0) as FL_LIB_SUPER_SMART,
		coalesce(F.FL_POSTAMAT_RICHIESTA,0) as FL_POSTAMAT_RICHIESTA,
		coalesce(G.FL_CARTA_DI_CREDITO,0) as FL_CARTA_DI_CREDITO,
		coalesce(H.FL_CARTA_LIBRETTO,0) as FL_CARTA_LIBRETTO,
		coalesce(I.FL_SCOPERTO ,0) as FL_SCOPERTO,
		coalesce(L.FL_DANNI_PA,0) as FL_DANNI_PA,
		coalesce(L.FL_PERSONA_PA,0) as FL_PERSONA_PA,
		coalesce(L.FL_BENI_PA,0) as FL_BENI_PA,
		coalesce(L.FL_PAGAMENTI_PA,0) as FL_PAGAMENTI_PA,
		coalesce(L.NR_DANNI_PA,0) as NR_DANNI_PA,
		coalesce(L.NR_PERSONA_PA,0) as NR_PERSONA_PA,
		coalesce(L.NR_BENI_PA,0) as NR_BENI_PA,
		coalesce(L.NR_PAGAMENTI_PA,0) as NR_PAGAMENTI_PA,
		coalesce(M.FL_DEP_TIT,0) as FL_DEP_TIT,
		coalesce(N.FL_BPOL_CLICK,0) as FL_BPOL_CLICK,
		coalesce(R.FL_ACCREDITO_CONTO_EDWAE,0) as FL_ACCREDITO_CONTO_EDWAE
	from CT_POSSESSO_PRODOTTI_1 as P
	left join MUTUO as B on P.ID_CLIENTE_BIC=B.ID_CLIENTE_BIC
	left join PRODOTTI_PRESTITI as C on P.ID_CLIENTE_BIC=C.ID_CLIENTE_BIC
	left join PATRIMONIALE as D on P.ID_CLIENTE_BIC=D.ID_CLIENTE_BIC
	left join LIBRETTO_SUPER_SMART as E on P.ID_CLIENTE_BIC=E.ID_CLIENTE_BIC
	left join POSTAMAT as F on P.ID_CLIENTE_BIC=F.ID_CLIENTE_BIC 
	left join CARTA_DI_CREDITO as G on P.ID_CLIENTE_BIC=G.ID_CLIENTE_BIC
	left join CARTA_LIBRETTO as H on P.ID_CLIENTE_BIC=H.ID_CLIENTE_BIC
	left join SCOPERTO as I on P.ID_CLIENTE_BIC=I.ID_CLIENTE_BIC
	left join DANNI as L on P.ID_CLIENTE_BIC=L.ID_CLIENTE_BIC
	left join DEPOSITO_TITOLI as M on P.ID_CLIENTE_BIC=M.ID_CLIENTE_BIC
	left join FL_BPOL_CLICK as N on P.ID_CLIENTE_BIC=N.ID_CLIENTE_BIC
	left join FL_ACCREDITO_CONTO_EDWAE as R on P.ID_CLIENTE_BIC=R.ID_CLIENTE_BIC
     where P.id_periodo_temporale in (SELECT ID_PERIODO_TEMPORALE FROM EBIL_AREE.CT_PARAMETRI)


		;ET;

.IF ERRORCODE > 0 THEN .QUIT 16;

