	left join PATRIMONIALE as D on P.ID_CLIENTE_BIC=D.ID_CLIENTE_BIC
	left join LIBRETTO_SUPER_SMART as E on P.ID_CLIENTE_BIC=E.ID_CLIENTE_BIC
	left join POSTAMAT as F on P.ID_CLIENTE_BIC=F.ID_CLIENTE_BIC 
