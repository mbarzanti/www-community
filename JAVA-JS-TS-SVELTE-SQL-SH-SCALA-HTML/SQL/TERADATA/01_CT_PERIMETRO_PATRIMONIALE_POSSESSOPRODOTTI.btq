----------PRESTITI----------
--HH  FIX FLAG PRESTITI E CQ 202003 
create volatile table PRESTITI as (
	select 
		CODICE_FISCALE, 
		partner, 
		'PRESTITO' AS PRODOTTO, --HH  FIX FLAG PRESTITI E CQ 202003 
		/*case 
			when prodotto = '000000000000100130' then 'PRONTISSIMO'
			when prodotto in ('000000000000100160', '000000000000100165') then 'SPECIAL CASH'
			when prodotto = '000000000000100500' then 'PRESTITO'
			else prodotto end as Prodotto, HH  FIX FLAG PRESTITI E CQ 202003 */
		SUM(case when A.DT_SCADENZA_PRESTITO between C.DATA_AGGIORNAMENTO+1 and C.DATA_AGGIORNAMENTO+INTERVAL '1' YEAR then 1 else 0 end) as N_PRESTITI_SCADENZA,
		COUNT(DISTINCT A.ID_PRATICA_POSIDONIA) as NR_PRESTITI,
		SUM(CASE WHEN  ASSICURAZIONE_IMPORTO>0 THEN 1 ELSE 0 END) AS NR_CPI_PRESTITI
	from V_EDW_DW_BP.FIN_PRESTITI_POSID_ST A, 
		V_EDW_DW_BP.FIN_PRESTITI_CLI_ST B,
		EBIL_AREE.CT_PARAMETRI C
	where A.ID_PRATICA_POSIDONIA = B.ID_PRATICA_POSIDONIA
		and C.DATA_AGGIORNAMENTO between A.DT_INI_VAL and A.DT_FIN_VAL
		and C.DATA_AGGIORNAMENTO between B.DT_INI_VAL and B.DT_FIN_VAL
		and DT_EROGAZIONE <= C.DATA_AGGIORNAMENTO
		and (DT_ANNULLO >= C.DATA_AGGIORNAMENTO or DT_ANNULLO is NULL)
		and (DT_SCADENZA_PRESTITO > C.DATA_AGGIORNAMENTO or DT_SCADENZA_PRESTITO is NULL)
		and (DT_ESTINZIONE_ANTICIPATA > C.DATA_AGGIORNAMENTO or DT_ESTINZIONE_ANTICIPATA is NULL)
		and CODICE_FISCALE is NOT NULL
		and CODICE_FISCALE <> ' '
		and 1=1 
	group by 1,2,3 
	) with data primary index (CODICE_FISCALE, PARTNER ,PRODOTTO) 
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


----------POLIZZE DANNI----------

create volatile table annullo as (
sel 
	NUMERO_POLIZZA 
FROM v_edw_sa_bp.BP_NP_ANNULLI PRO
join EBIL_AREE.CT_PARAMETRI as P on 1=1
where EFFETTO_ANNULLO_POL<=P.DATA_AGGIORNAMENTO
) WITH DATA UNIQUE PRIMARY INDEX (NUMERO_POLIZZA)
ON COMMIT PRESERVE ROWS;

create volatile table  polizze_emesse as (
sel
	NUMERO_POLIZZA
FROM v_edw_sa_bp.BP_NP_ANNULLI PRO
join EBIL_AREE.CT_PARAMETRI as P on 1=1
where EMISSIONE_POL<=P.DATA_AGGIORNAMENTO
	and numero_polizza not in ( sel numero_polizza from annullo)
group by 1
) WITH DATA UNIQUE PRIMARY INDEX (NUMERO_POLIZZA)
ON COMMIT PRESERVE ROWS;
.IF ERRORCODE > 0 THEN .QUIT 16;

create volatile table  polizze_tot as (
sel 
	NUMERO_POLIZZA,
	CODICE_PRODOTTO,
	max(data_operazione) as dt_operazione
from v_edw_sa_bp.BP_NP_ANNULLI PRO
group by 1,2
) WITH DATA UNIQUE PRIMARY INDEX (NUMERO_POLIZZA)
ON COMMIT PRESERVE ROWS;
.IF ERRORCODE > 0 THEN .QUIT 16;


CREATE VOLATILE TABLE STOCK_DANNI AS (
sel
	e.NUMERO_POLIZZA,
	Linea_Prod,
	Desc_Prod,
	tot.CODICE_PRODOTTO
from polizze_emesse e
left join polizze_tot tot
	on e.numero_polizza=tot.numero_polizza
left join EBIL_AREE.V_ANAG_POSTEASSICURA tip
	on tot.CODICE_PRODOTTO=TIP.CODICE_PRODOTTO
group by 1, 2,3,4
) WITH DATA UNIQUE PRIMARY INDEX (NUMERO_POLIZZA)
ON COMMIT PRESERVE ROWS;
.IF ERRORCODE > 0 THEN .QUIT 16;
 

CREATE VOLATILE TABLE CLIENTE_DANNI_BENI_PERSONA AS (
sel 
	id_cliente_bic, 
	RETAIL, 
	linea_prod, 
	min(cli.ndg) as ndg, 
	COUNT(DISTINCT NUMERO_POLIZZA) AS NR_POLIZZE
from stock_danni pro
join EBIL_AREE.CT_PARAMETRI as P on 1=1
LEFT join V_EDW_DW_BP.POL_RAPPORTO_ST rapp
on SUBSTR(TRIM(pro.numero_polizza), 1,11) =substr(trim(rapp.nr_polizza),2,11)
	and P.DATA_AGGIORNAMENTO between rapp.dt_ini_val and rapp.dt_fin_val
LEFT join (SEL ID_CLIENTE_BIC, NDG, 1 AS RETAIL
	FROM EBIL_AREE.NDG_BIC
	WHERE TIPO_INTESTATARIO='U'
	UNION ALL
	SEL ID_CLIENTE_BIC, NDG, 0 AS RETAIL
	FROM EBIL_AREE.NDG_BIC_PG
	GROUP BY 1,2) cli
on rapp.ndg_cliente=cli.ndg
WHERE LINEA_PROD IN ('BENI', 'PERSONA')
group by 1,2,3
) WITH DATA UNIQUE PRIMARY INDEX ( linea_prod, ID_CLIENTE_BIC)
ON COMMIT PRESERVE ROWS;
.IF ERRORCODE > 0 THEN .QUIT 16;

CREATE VOLATILE TABLE CLIENTE_DANNI_PAGAMENTI AS (
SEL  
	ID_CLIENTE_BIC, 
	SUM(NR_CPI) AS NR_CPI
	--SUM(CASE WHEN TIPO_CPI='MUTUO' THEN NR_CPI ELSE 0 END) AS NR_CPI_MUTUO,
	--SUM(CASE WHEN TIPO_CPI='PREST' THEN NR_CPI ELSE 0 END) AS NR_CPI_PRESTITO
FROM
    (SEL CODICE_FISCALE, 'MUTUO' AS TIPO_CPI, NR_CPI_MUTUO AS NR_CPI
    from MUTUO_TMP
    WHERE NR_CPI_MUTUO>0
    UNION ALL 
    SEL CODICE_FISCALE, 'PRESTITO' AS TIPO_CPI, NR_CPI_PRESTITI AS NR_CPI
    from PRESTITI
    WHERE NR_CPI_PRESTITI>0
    ) A
    LEFT JOIN
    (SEL COD_FISCALE, ID_CLIENTE_BIC
    FROM EDWAE_VM.CLIENTE
    WHERE VERSIONE_CORRENTE=1
    AND NATURA_GIURIDICA='PERSONA FISICA'
    ) B
ON A.CODICE_FISCALE=B.COD_FISCALE
GROUP BY 1
) WITH DATA UNIQUE PRIMARY INDEX (ID_CLIENTE_BIC)
ON COMMIT PRESERVE ROWS;
.IF ERRORCODE > 0 THEN .QUIT 16;


CREATE VOLATILE TABLE DANNI AS (
SEL A.*, 
	CASE WHEN NR_PERSONA_PA>0 THEN 1 ELSE 0 END AS FL_PERSONA_PA,
	CASE WHEN NR_BENI_PA>0 THEN 1 ELSE 0 END AS FL_BENI_PA, 
	CASE WHEN NR_PAGAMENTI_PA>0 THEN 1 ELSE 0 END AS FL_PAGAMENTI_PA, 
	1 AS FL_DANNI_PA 

FROM
(SEL ID_CLIENTE_BIC, SUM(NR_PERSONA) AS NR_PERSONA_PA, SUM(NR_BENI) AS NR_BENI_PA, SUM(NR_PAGAMENTI) AS NR_PAGAMENTI_PA, 
SUM(NR_PAGAMENTI+NR_PERSONA+NR_BENI) AS NR_DANNI_PA
FROM 
	(
	SEL ID_CLIENTE_BIC, 
	SUM(CASE WHEN LINEA_PROD='PERSONA' THEN NR_POLIZZE ELSE 0 END) AS NR_PERSONA,
	SUM(CASE WHEN LINEA_PROD='BENI' THEN NR_POLIZZE ELSE 0 END) AS NR_BENI,
	CAST(0 AS INTEGER) AS NR_PAGAMENTI
	FROM CLIENTE_DANNI_BENI_PERSONA
	GROUP BY 1
	UNION ALL 
	SEL ID_CLIENTE_BIC,
	0 AS NR_PERSONA,
	0 AS NR_BENI,
	NR_CPI AS NR_PAGAMENTI
	FROM CLIENTE_DANNI_PAGAMENTI
	) A
GROUP BY 1
) A
) WITH DATA UNIQUE PRIMARY INDEX (ID_CLIENTE_BIC)
ON COMMIT PRESERVE ROWS;
.IF ERRORCODE > 0 THEN .QUIT 16;


