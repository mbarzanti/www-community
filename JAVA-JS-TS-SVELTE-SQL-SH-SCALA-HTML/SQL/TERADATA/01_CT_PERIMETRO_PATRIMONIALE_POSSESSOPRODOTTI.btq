----------CQS----------
--HH  FIX FLAG PRESTITI E CQ 202003 

create volatile table finanziamenti_cqs as (
	select 
		'CQS' as PRODOTTO,
		PARTNER, --HH  FIX FLAG PRESTITI E CQ 202003 
		/* case 
			when PARTNER = 8 then 'FINDOMESTIC' 
			when PARTNER = 4 then 'COMPASS'
			when PARTNER = 2 then 'DB'
			when PARTNER = 1 then 'BDM'
			when PARTNER = 3 then 'BNL'
			else PARTNER end as PARTNER, HH  FIX FLAG PRESTITI E CQ 202003 */
		CODICE_FISCALE,
		SUM(case when A.DT_SCADENZA_PRESTITO between C.DATA_AGGIORNAMENTO+1 and C.DATA_AGGIORNAMENTO+INTERVAL '1' YEAR then 1 else 0 end) as N_CQS_SCADENZA,
		COUNT(DISTINCT B.ID_PRATICA_POSIDONIA) as NR_CQS
	from V_EDW_DW_BP.FIN_PRATICHE_CQS_ST A,
		V_EDW_DW_BP.FIN_CQS_CLI_ST B,
		EBIL_AREE.CT_PARAMETRI C
	where A.ID_PRATICA_POSIDONIA=B.ID_PRATICA_POSIDONIA
		and C.DATA_AGGIORNAMENTO between A.DT_INI_VAL and A.DT_FIN_VAL
		and C.DATA_AGGIORNAMENTO between B.DT_INI_VAL and B.DT_FIN_VAL
		and DT_EROGAZIONE <= C.DATA_AGGIORNAMENTO
		and (DT_ANNULLO >C.DATA_AGGIORNAMENTO or DT_ANNULLO is NULL)
		and (DT_SCADENZA_PRESTITO >C.DATA_AGGIORNAMENTO or DT_SCADENZA_PRESTITO is NULL)
		and (DT_ESTINZIONE_ANTICIPATA > C.DATA_AGGIORNAMENTO or DT_ESTINZIONE_ANTICIPATA is NULL)
		and 1=1 
	group by 1,2,3  --HH  FIX FLAG PRESTITI E CQ 202003 
	) with data unique primary index (CODICE_FISCALE, PARTNER, PRODOTTO) 
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;



/*create volatile table PRODOTTI_PRESTITI as (
	sel 
		B.ID_CLIENTE_BIC,
		MAX(case when A.TIPO_PRESTITO='PRESTITO_COMPASS' then 1 else 0 end) as FL_PRESTITO_COMPASS,
		MAX(case when A.TIPO_PRESTITO='BNL' then 1 else 0 end) as FL_CQS_BNL,
		MAX(case when A.TIPO_PRESTITO='FINDOMESTIC' then 1 else 0 end) as FL_PRESTITO_FINDO,
		MAX(case when A.TIPO_PRESTITO='PRONTISSIMO' then 1 else 0 end) as FL_PRONTISSIMO,
		MAX(case when A.TIPO_PRESTITO='SPECIAL_CASH' then 1 else 0 end) as FL_SPECIAL_CASH,
		MAX(case when A.TIPO_PRESTITO='CQS_DB' then 1 else 0 end) as FL_CQS_DB,
		MAX(case when A.TIPO_PRESTITO='PRESTITO_DB' then 1 else 0 end) as FL_PRESTITO_DB,
		MAX(case when A.TIPO_PRESTITO='CQS_COMPASS' then 1 else 0 end) as FL_CQS_COMPASS, --la variabile non risulta mai valorizzata.

		case when SUM(A.N_PRESTITI_SCADENZA)>0 then 1 else 0 end as FL_PRESTITI_SCADENZA,
		case when SUM(A.N_CQS_SCADENZA)>0 then 1 else 0 end as FL_CQS_SCADENZA 
	from
		(sel CODICE_FISCALE, N_PRESTITI_SCADENZA, 0 as N_CQS_SCADENZA, 'PRESTITO_COMPASS' as TIPO_PRESTITO
		from PRESTITI
		where PARTNER = 'COMPASS' and PRODOTTO = 'PRESTITO'
		group by 1,2,3,4
		
		union
			sel CODICE_FISCALE, 0 as N_PRESTITI_SCADENZA, N_CQS_SCADENZA, 'BNL' as TIPO_PRESTITO
			from FINANZIAMENTI_CQS
			where TRIM(PARTNER)='BNL'
			group by 1,2,3,4
		
		union
			sel CODICE_FISCALE, N_PRESTITI_SCADENZA, 0 as N_CQS_SCADENZA,'FINDOMESTIC' as TIPO_PRESTITO
			from  PRESTITI
			where  PARTNER = 'FINDOMESTIC' and PRODOTTO = 'PRESTITO'
			group by 1,2,3,4
		
		union
			sel CODICE_FISCALE, N_PRESTITI_SCADENZA, 0 as N_CQS_SCADENZA,'PRONTISSIMO' as TIPO_PRESTITO
			from  PRESTITI
			where  PARTNER = 'COMPASS' and PRODOTTO = 'PRONTISSIMO'
			group by 1,2,3,4
		
		union 
			sel CODICE_FISCALE, N_PRESTITI_SCADENZA, 0 as N_CQS_SCADENZA, 'SPECIAL_CASH' as TIPO_PRESTITO
			from PRESTITI
			where PARTNER = 'COMPASS' and PRODOTTO = 'SPECIAL CASH'
			group by 1,2,3,4
		
		union
			sel CODICE_FISCALE, 0 as N_PRESTITI_SCADENZA, N_CQS_SCADENZA, 'CQS_DB' as TIPO_PRESTITO
			from FINANZIAMENTI_CQS
			where TRIM(PARTNER)='DB'
			group by 1,2,3,4	
		
		union
			sel CODICE_FISCALE, N_PRESTITI_SCADENZA, 0 as N_CQS_SCADENZA, 'PRESTITO_DB' as TIPO_PRESTITO
			from PRESTITI
			where PARTNER = 'DB' and PRODOTTO = 'PRESTITO'
			group by 1,2,3,4

		union
			sel CODICE_FISCALE, 0 as N_PRESTITI_SCADENZA, N_CQS_SCADENZA, 'CQS_COMPASS' as TIPO_PRESTITO 
			from FINANZIAMENTI_CQS
			where TRIM(PARTNER)='COMPASS'
			group by 1,2,3,4
		) A 
	
	inner join
		(sel ID_CLIENTE_BIC, COD_FISCALE_SORGENTE as COD_FISCALE
		from BIC_ODS_V.KEY_MAP_CLIENTE
		where DT_FINE_VALIDITA is NULL
			and COD_SISTEMA_SORGENTE ='BP') B
		on A.CODICE_FISCALE=B.COD_FISCALE
	group by 1
	)with data unique primary index(ID_CLIENTE_BIC)
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;
*/

-- HH  FIX FLAG PRESTITI E CQ 202003 

create volatile table PRODOTTI_PRESTITI as (
	sel 
		B.ID_CLIENTE_BIC,
		MAX(case when A.TIPO_PRESTITO='PRESTITO' then 1 else 0 end) as FL_PRESTITO,
		MAX(case when A.TIPO_PRESTITO='CQ' then 1 else 0 end) as FL_CQS,
		/*
		MAX(case when A.TIPO_PRESTITO='PRESTITO_COMPASS' then 1 else 0 end) as FL_PRESTITO_COMPASS,
		MAX(case when A.TIPO_PRESTITO='BNL' then 1 else 0 end) as FL_CQS_BNL,
		MAX(case when A.TIPO_PRESTITO='FINDOMESTIC' then 1 else 0 end) as FL_PRESTITO_FINDO,
		MAX(case when A.TIPO_PRESTITO='PRONTISSIMO' then 1 else 0 end) as FL_PRONTISSIMO,
		MAX(case when A.TIPO_PRESTITO='SPECIAL_CASH' then 1 else 0 end) as FL_SPECIAL_CASH,
		MAX(case when A.TIPO_PRESTITO='CQS_DB' then 1 else 0 end) as FL_CQS_DB,
		MAX(case when A.TIPO_PRESTITO='PRESTITO_DB' then 1 else 0 end) as FL_PRESTITO_DB,
		MAX(case when A.TIPO_PRESTITO='CQS_COMPASS' then 1 else 0 end) as FL_CQS_COMPASS, --la variabile non risulta mai valorizzata.
*/
		case when SUM(A.N_PRESTITI_SCADENZA)>0 then 1 else 0 end as FL_PRESTITI_SCADENZA,
		case when SUM(A.N_CQS_SCADENZA)>0 then 1 else 0 end as FL_CQS_SCADENZA 
	from
		(sel CODICE_FISCALE, N_PRESTITI_SCADENZA, 0 as N_CQS_SCADENZA, 'PRESTITO' as TIPO_PRESTITO
		from PRESTITI
		group by 1,2,3,4
		
		union
			sel CODICE_FISCALE, 0 as N_PRESTITI_SCADENZA, N_CQS_SCADENZA, 'CQ' as TIPO_PRESTITO
			from FINANZIAMENTI_CQS
			group by 1,2,3,4
		) A 
	
	inner join
		(sel ID_CLIENTE_BIC, COD_FISCALE_SORGENTE as COD_FISCALE
		from BIC_ODS_V.KEY_MAP_CLIENTE
		where DT_FINE_VALIDITA is NULL
			and COD_SISTEMA_SORGENTE ='BP') B
		on A.CODICE_FISCALE=B.COD_FISCALE
	group by 1
	)with data unique primary index(ID_CLIENTE_BIC)
on commit preserve rows;


----------SUPER SMART----------
create volatile table LIBRETTO_SUPER_SMART as (
	sel 
		ID_CLIENTE_BIC,
		1 as FL_LIB_SUPER_SMART,
		COUNT(distinct SK_RAPPORTO) as NR_LIB_SUPER_SMART
	from 
		(sel '002'||ANAG.NR_RAPPORTO as ID_RAPPORTO, SVIN.SK_RAPPORTO 
		from
			(sel *
			from V_EDW_DW_BP.LIB_SUPSMART_RAPP_ST
			JOIN ebil_aree.CT_PARAMETRI on 1=1
			where data_aggiornamento between DT_INI_VAL and DT_FIN_VAL  
			) anag
			join ebil_aree.CT_PARAMETRI  on 1=1
			inner join 
				(sel *
				from V_EDW_DW_BP.LIB_SUPSMART_ATVINC_ST
				where ebil_aree.CT_PARAMETRI.DATA_AGGIORNAMENTO between DT_INI_VAL and DT_FIN_VAL
					and DT_ATT_PVR >='2017-05-29'
					and DT_SCADENZA_PVR > ebil_aree.CT_PARAMETRI.DATA_AGGIORNAMENTO
					and FL_FITTIZIO = 0
				) SVIN 
				on ANAG.NR_RAPPORTO = SVIN.NR_RAPPORTO and ANAG.NR_PGR_PVR = SVIN.NR_PGR_PVR
			where ANAG.DT_ATT_PVR  >='2017-05-29' and SVIN.DT_SCADENZA_PVR>ebil_aree.CT_PARAMETRI.DATA_AGGIORNAMENTO
	group by 1,2
	) A
	inner join
		(sel ID_RAPPORTO
		from EDWAE_VM.RAPPORTO_RISPARMIO_POSTALE
		where CD_FLUSSO='002'
			and DT_INI_VAL<=ebil_aree.CT_PARAMETRI.DATA_AGGIORNAMENTO and DT_FIN_VAL>=ebil_aree.CT_PARAMETRI.DATA_AGGIORNAMENTO 
			and STATO_SINTETICO='1') B
		on A.ID_RAPPORTO=B.ID_RAPPORTO
	inner join
		(sel ID_RAPPORTO, ID_CLIENTE_BIC
		from EDWAE_VM.ASSOC_RAPPORTO_CLIENTE
		where CD_FLUSSO='002'
			and ID_CLIENTE_CRM='0') C
		on B.ID_RAPPORTO=C.ID_RAPPORTO
	join EBIL_AREE.CT_PARAMETRI on 1=1
	group by 1
	)with data unique primary index(ID_CLIENTE_BIC)
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


----------RPOL----------
create volatile table RPOL_TMP as (
	select 
		NDG, 
		MIN(STATO_PRI) as STATO
	from
		(select 
			R.CD_CLI_SRG as NDG, 
			case
				when STATO_SERVIZIO_DISPOSITIVO = 'C' then 1
				when STATO_SERVIZIO_DISPOSITIVO = 'R' then 2
				when STATO_SERVIZIO_DISPOSITIVO = 'N' then 3
				when STATO_SERVIZIO_DISPOSITIVO is NULL or STATO_SERVIZIO_DISPOSITIVO not in ('C','R','N') then 4
				end as STATO_PRI  
		from EDW_VM_DBP_MOV.EDW_TDD_SERV_RPOL R, 
		EDW_VM_DBP_MOV.EDW_MKT_TDD_RAPP_BP RAP
		join EBIL_AREE.CT_PARAMETRI as PAR on 1=1
		where (R.DT_REVOCA is NULL or R.DT_REVOCA > PAR.DATA_AGGIORNAMENTO)
			and R.NR_RAPP = RAP.NR_RAPP
			and R.TIPO_RAPP = RAP.TIPO_RAPP
			and RAP.DT_ESTINZ > PAR.DATA_AGGIORNAMENTO
		)AA
	group by 1
	) with data unique primary index (NDG)
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


create volatile table RPOL as (
	sel 
		H.ID_CLIENTE_BIC, 
		1 as FL_RPOL_INFORMATIVO, 
		(case when H.STATO=1 then 1 else 0 end) as FL_RPOL_DISPOSITIVO
	from
		(sel ID_CLIENTE_BIC, MIN(STATO) as STATO
		from RPOL_TMP as a
		inner join
			(sel
				ID_CLIENTE_BIC,
				COD_CLIENTE_SORGENTE,
				COD_FISCALE_SORGENTE,
				FLAG_CERTIFICAZIONE
			from V_BIC_ODS.KEY_MAP_CLIENTE
			where UPPER(COD_SISTEMA_SORGENTE) = 'BP'
				and DT_FINE_VALIDITA is NULL
				and FLAG_ARCHIVIAZIONE is NULL) b
			on A.NDG=B.COD_CLIENTE_SORGENTE
		group by 1
		) as h
		inner join PATRIMONIALE patr
			on h.id_cliente_bic=patr.id_cliente_bic and patr.FL_LIB_SMART>0
	) with data unique primary index (ID_CLIENTE_BIC)
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


--------------------------------------------------------VARIABILI PER MODELLO DI MULTIBANCARIZZAZIONE------------------------------------------------------------

----------FL_BPOL_CLICK----------

-- FIX HH 15/01/2020: ripristinate modifiche sulla volatile FL_BPOL_CLICK per nuovo conto CCBP-CONSNEW come da script 1_CT_PERIMETRO_PRODOTTI_PATRIMONIALE_4.0_patch_20191024


create volatile table FL_BPOL_CLICK as(
	select distinct assoc.ID_CLIENTE_BIC,1 as FL_BPOL_CLICK
	from EDWAE_VM.ASSOC_RAPPORTO_CLIENTE as assoc
	where assoc.ID_CLIENTE_CRM='0' and assoc.CD_FLUSSO in ('001','020') and assoc.ID_RAPPORTO in(
		select
			case
				when rap_cc.CODICE_PRODOTTO in ('CCBP-CLICK','CCBP-CONSNEW') then rap_cc.ID_RAPPORTO--FIX 2019/10/24: aggiunto CCBP-CONSNEW
				else rap_ser.ID_RAPPORTO
			end as ID_RAPPORTO_ONLINE
		from EBIL_AREE.CT_PARAMETRI as p
		join EDWAE_VM.RAPPORTO_CONTO as rap_cc
			on p.DATA_AGGIORNAMENTO between rap_cc.DT_INI_VAL and rap_cc.DT_FIN_VAL
				and rap_cc.STATO_SINTETICO='1' and rap_cc.CODICE_PRODOTTO in ('CCBP-RETAIL','CCBPCONSUMER','CCBP-CLICK','CCBP-CONSNEW')--FIX 2019/10/24: aggiunto CCBP-CONSNEW
		left join EDWAE_VM.RAPPORTO_SERVIZI_TELEMATICI as rap_ser
			on rap_cc.CODICE_PRODOTTO in ('CCBP-RETAIL','CCBPCONSUMER')
				and p.DATA_AGGIORNAMENTO between rap_ser.DT_INI_VAL and rap_ser.DT_FIN_VAL
				and rap_ser.STATO_NATURALE='Attivo' and rap_ser.CD_FLUSSO='020'
				and rap_cc.ID_RAPPORTO=rap_ser.ID_RAPPORTO_REGOLAMENTO
	) and assoc.ID_CLIENTE_BIC in (select ID_CLIENTE_BIC from PATRIMONIALE where FL_CCBP=1)
)with data unique primary index (ID_CLIENTE_BIC) on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


----------FL_ACCREDITO_CONTO_EDWAE----------
create volatile table FL_ACCREDITO_CONTO_EDWAE as(
	select assoc.ID_CLIENTE_BIC,1 as FL_ACCREDITO_CONTO_EDWAE
	from EDWAE_VM.ASSOC_RAPPORTO_CLIENTE as assoc
	where assoc.CD_FLUSSO='001' and assoc.ID_RAPPORTO in (
		select rap_cc.id_rapporto
		from EBIL_AREE.CT_PARAMETRI as p
		join EDWAE_VM.RAPPORTO_CONTO as rap_cc
			on p.DATA_AGGIORNAMENTO between rap_cc.DT_INI_VAL and rap_cc.DT_FIN_VAL and rap_cc.STATO_SINTETICO='1'and rap_cc.ID_RAPPORTO in (
				select ID_RAPPORTO_REGOLAMENTO
				from EDWAE_VM.RAPPORTO_INCASSI_PAGAMENTI as rap_inc
				where p.DATA_AGGIORNAMENTO between rap_inc.DT_INI_VAL and rap_inc.DT_FIN_VAL and rap_inc.CD_FLUSSO='025'
					and rap_inc.STATO_SINTETICO='1'
			)
	) and assoc.ID_CLIENTE_BIC in (select ID_CLIENTE_BIC from PATRIMONIALE where FL_CCBP=1)
)with data on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


--------------------------------------------------------SCADENZE------------------------------------------------------------
----------POLIZZE----------
create volatile table TMP_RAPP_POL_EBIL as (
	sel 
			POL_RAPP.PK_RAPPORTO as PK_RAPPORTO,																																					
			POL_RAPP.NR_POLIZZA	AS CODICE_RAPPORTO,  
			ASSOC.CD_CLIENTE_SORGENTE as NDG,    
			'13' as TIPO_RAPPORTO,           
			coalesce(cast(cast(POL_RAPP.DT_SCADENZA as DATE format 'YYYYMMDD') as VARCHAR(8)),'19000101') as DATA_SCADENZA,
			case when CD_COMP_ASS='PV' then 'VITA' 
					when CD_COMP_ASS='PA' then 'DANNI' 
					else 'ALTRE_POLIZZE' end  as PRODOTTO,
			DS_RAMO_PROD as CATALOGO
		from  EBIL_ANAG_V.V_AN_RAPPORTO_POLIZZA as POL_RAPP
		join EBIL_AREE.CT_PARAMETRI on 1=1
		inner join  EBIL_ANAG_V.V_ASSOC_RAPP_PROD_CLIENTE ASSOC
			on POL_RAPP.PK_RAPPORTO=ASSOC.FK_RAPPORTO
				and CD_TIPO_RAPP='PZ'
				and CT_PARAMETRI.DATA_AGGIORNAMENTO between ASSOC.DT_INIZIO_VALIDITA and ASSOC.DT_FINE_VALIDITA
				and ASSOC.FL_VALIDITA='1'
				and ASSOC.CD_CLIENTE_SORGENTE<>'000000000000' 
		inner join EBIL_AREE_V.V_F_POLIZZE PG  
			on POL_RAPP.PK_RAPPORTO =  PG.FK_RAPPORTO
				and CT_PARAMETRI.DATA_AGGIORNAMENTO between PG.DT_INI_VAL_SALDO and PG.DT_FIN_VAL_SALDO
				and PG.FL_VALIDITA='1'
		where CT_PARAMETRI.DATA_AGGIORNAMENTO between POL_RAPP.DT_INI_VAL and POL_RAPP.DT_FIN_VAL
		--qualify row_number() over (partition by CODICE_RAPPORTO, NDG, TIPO_RAPPORTO order by CODICE_RAPPORTO desc) = 1
-- FIX HH 15/01/2020: ripristinata qualify per chiave duplicata		
		qualify row_number() over (partition by CODICE_RAPPORTO, NDG, TIPO_RAPPORTO order by DATA_SCADENZA desc) = 1
) with data unique primary index (CODICE_RAPPORTO,NDG,TIPO_RAPPORTO)  
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


----------TITOLI----------
create volatile table TMP_RAPP_TIT_EBIL as(
	sel 		
		DEP_RAPP.PK_RAPPORTO as PK_RAPPORTO,																																		
		TRIM(DEP_RAPP.NR_DEPOSITO) || TRIM(DEP_RAPP.NR_SOTTODEPOSITO) as CODICE_RAPPORTO,  
		ASSOC.CD_CLIENTE_SORGENTE as NDG,
		coalesce(cast(cast(DEP_RAPP.DT_APERTURA as DATE format 'YYYYMMDD') as VARCHAR(8)) ,'19000101') as DT_APERTURA,
		cast(cast(DEP_RAPP.DT_CHIUSURA as DATE format 'YYYYMMDD') as VARCHAR(8)) as DT_ESTINZIONE,
		case when cast(cast(CT_PARAMETRI.DATA_AGGIORNAMENTO as DATE format 'YYYYMMDD') as VARCHAR(8)) >= DT_ESTINZIONE then 'CHIUSO' else 'APERTO' end as STATO,
		'15' as TIPO_RAPPORTO
	from  EBIL_ANAG_V.V_AN_RAPPORTO_DEP_TITOLI DEP_RAPP
	join EBIL_AREE.CT_PARAMETRI on 1=1
	inner join  EBIL_ANAG_V.V_ASSOC_RAPP_PROD_CLIENTE ASSOC
		on DEP_RAPP.PK_RAPPORTO=ASSOC.FK_RAPPORTO
			and CD_TIPO_RAPP='DT'
			and CT_PARAMETRI.DATA_AGGIORNAMENTO between ASSOC.DT_INIZIO_VALIDITA and ASSOC.DT_FINE_VALIDITA
			and ASSOC.FL_VALIDITA='1'
			and ASSOC.CD_CLIENTE_SORGENTE<>'000000000000' 
	where CT_PARAMETRI.DATA_AGGIORNAMENTO between DEP_RAPP.DT_INI_VAL and DEP_RAPP.DT_FIN_VAL
		and DEP_RAPP.FL_VALIDITA='1'
		and DEP_RAPP.FK_RAPPORTO_REGOLAMENTO is not NULL
	--qualify row_number() over (partition by CODICE_RAPPORTO, NDG,TIPO_RAPPORTO order by CODICE_RAPPORTO desc) = 1			
	) with data primary index (CODICE_RAPPORTO,NDG,TIPO_RAPPORTO) 
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


create volatile table CG_TITOLI_1 as (
	select 
		FK_RAPPORTO_DEP_TIT,
		FK_RAPPORTO_TIT
	from EBIL_AREE_V.V_F_TITOLI_G as TIT	
	join EBIL_AREE.CT_PARAMETRI on 1=1
	where CT_PARAMETRI.DATA_AGGIORNAMENTO between TIT.DT_INI_VAL and TIT.DT_FIN_VAL
		and TIT.FL_VALIDITA='1'
		and TIT.IM_CONTROVALORE_MERCATO>0
	) with data primary index (FK_RAPPORTO_DEP_TIT,FK_RAPPORTO_TIT)
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


create volatile table CG_TITOLI_4 as (
	select 
		RAP_TIT.CD_TITOLO_INTERNO as CODICE_INTERNO,
		RAP_TIT.PK_RAPPORTO,
		FK_TIPO_RAPP,
		SK_RAPPORTO
	from  EBIL_ANAG_V.V_AN_RAPPORTO_TITOLI as RAP_TIT
	join EBIL_AREE.CT_PARAMETRI on 1=1
	where CT_PARAMETRI.DATA_AGGIORNAMENTO between RAP_TIT.DT_INI_VAL and RAP_TIT.DT_FIN_VAL
		and RAP_TIT.FL_VALIDITA='1' 
	) with data primary index (CODICE_INTERNO,PK_RAPPORTO)
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


create volatile table CG_TITOLI_3 as (
	select 
		PRIM_RAPP.SK_RAPPORTO,
		PRIM_RAPP.TIPO_RAPPORTO,
		coalesce(cast(cast(PRIM_RAPP.DT_SCADENZA as DATE format 'YYYYMMDD') as VARCHAR(8)),'99991231') as DATA_SCADENZA
	from V_EDW_DW_BP.TIT_RAPPORTO_ST PRIM_RAPP
	join EBIL_AREE.CT_PARAMETRI on 1=1
	where CT_PARAMETRI.DATA_AGGIORNAMENTO between PRIM_RAPP.DT_INI_VAL and PRIM_RAPP.DT_FIN_VAL
		and FL_FITTIZIO ='0'
	)with data primary index (SK_RAPPORTO,TIPO_RAPPORTO,DATA_SCADENZA)
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


create volatile table CG_TITOLI_2 as (
	select
		 RAPP.CODICE_RAPPORTO
		, RAPP.PK_RAPPORTO
		, RAPP.NDG
		, RAPP.TIPO_RAPPORTO as TIPO_RAPPORTO    
		, RAP_TIT.CODICE_INTERNO
		, CT_PARAMETRI.DATA_AGGIORNAMENTO as DATA_SALDO
		, PRIM_RAPP.DATA_SCADENZA
	from TMP_RAPP_TIT_EBIL as RAPP
	join EBIL_AREE.CT_PARAMETRI on 1=1
	join CG_TITOLI_1 as TIT
		on RAPP.PK_RAPPORTO=TIT.FK_RAPPORTO_DEP_TIT
	join CG_TITOLI_4 as RAP_TIT
		on TIT.FK_RAPPORTO_TIT=RAP_TIT.PK_RAPPORTO
	left join  EBIL_ANAG_V.V_TPL_TIPO_RAPPORTO as TIPO_RAPP
		on RAP_TIT.FK_TIPO_RAPP=TIPO_RAPP.PK_TIPO_RAPP
	inner join CG_TITOLI_3 as PRIM_RAPP
		on RAP_TIT.SK_RAPPORTO=PRIM_RAPP.SK_RAPPORTO
			and TIPO_RAPP.CD_TIPO_RAPP=PRIM_RAPP.TIPO_RAPPORTO
	where RAPP.TIPO_RAPPORTO='15'
		and RAPP.STATO='APERTO'
	) with data unique primary index (CODICE_RAPPORTO,CODICE_INTERNO,PK_RAPPORTO,NDG,TIPO_RAPPORTO,DATA_SCADENZA)
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


create volatile table TITOLI as (
	sel 
		CODICE_RAPPORTO, 
		TIPO_RAPPORTO, 
		NDG, 
		DATA_SALDO, 
		CATALOGO, 
		DATA_SCADENZA
	from CG_TITOLI_2 as A
	left join
		(sel CD_TITOLO_INTERNO, DS_PRODOTTO_GESTIONALE, 
			case 
				when DS_PRODOTTO_GESTIONALE like '%CERTIFICATES%' then 'CERTIFICATES'
				when DS_PRODOTTO_GESTIONALE like any ( '%OBBLIGAZIONI%',  '%FONDI IMMOBILIARI%') then 'OBBLIGAZIONI'
				when DS_PRODOTTO_GESTIONALE like '%AZIONI%' and DS_PRODOTTO_GESTIONALE not like '%OBBLIGAZIONI%' then 'AZIONI'
				when DS_PRODOTTO_GESTIONALE like '%TITOLI DI STATO%' then 'TITOLI_DI_STATO'
				else 'ALTRO' end as CATALOGO
			from  EBIL_ANAG_V.V_AN_RAPPORTO_TITOLI
			join EBIL_AREE.CT_PARAMETRI on 1=1
			where CT_PARAMETRI.DATA_AGGIORNAMENTO between DT_INI_VAL and DT_FIN_VAL and FL_VALIDITA='1'
		) B
		on A.CODICE_INTERNO = B.CD_TITOLO_INTERNO
	group by 1,2,3,4,5,6
	) with data unique primary index (CODICE_RAPPORTO, TIPO_RAPPORTO, CATALOGO,DATA_SCADENZA)
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


----------UNIONE TITOLI E POLIZZE----------
create volatile table SCADENZE as (
		sel 
			cast(CODICE_RAPPORTO as VARCHAR(64)) as CODICE_RAPPORTO, 
			NDG, 
			TIPO_RAPPORTO, 
			DATA_SCADENZA,
			cast('TITOLI' as VARCHAR(32)) as PRODOTTO,
			cast(CATALOGO as VARCHAR(32)) as CATEGORIA
		from TITOLI

	union all
		sel 
			cast(CODICE_RAPPORTO as VARCHAR(64)) as CODICE_RAPPORTO, 
			NDG, 
			TIPO_RAPPORTO, 
			DATA_SCADENZA,
			PRODOTTO,
			coalesce(CATALOGO, 'ND') as CATEGORIA
		from TMP_RAPP_POL_EBIL

	) with data unique primary index (CODICE_RAPPORTO, NDG, TIPO_RAPPORTO, CATEGORIA, DATA_SCADENZA)
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;

create volatile table CONVERSIONE_BIC_NDG as (
select 
	distinct ID_CLIENTE_BIC, CD_NDG_RAPPORTO as NDG
from EBIL_AREE_V.V_PL_PATRIMONIALE patr, EBIL_AREE.CT_PARAMETRI P
where patr.CD_NATURA_GIURIDICA in ('PF', 'COI', '1') and patr.CD_TIPO_INTESTATARIO in ('P', 'U', 'S')
	            and (patr.DS_MACROPRODOTTO <> 'CONTI' or (patr.DS_MACROPRODOTTO = 'CONTI' and /*patr.ds_sottoprodotto in ('CONTO CORRENTE CONTO PIU',
			'CONTO CORRENTE CONTO RETAIL','CONTO CORRENTE CONTO CLICK','CONTO CORRENTE CONTO RETAIL GRUPPO POSTE',
			'CONTO CORRENTE RETAIL CONVENZIONE BASE','CONTO CORRENTE CONTO BANCOPOSTA GRUPPO POSTE',
			'CONTO CORRENTE CONTO BANCOPOSTA BASE','CONTO CORRENTE CC BASE BP PENSIONATI2',
			'CONTO CORRENTE CC BASE BP PENSIONATI1','CONTO CORRENTE CC BASE BP STANDARD')))*/
			--FIX 2019/10/24:sostituire il filtro per DS_SOTTOPRODOTTO con uno su SK_SOTTOPRODOTTO, recependo anche il nuovo conto CCBP-CONSNEW
			patr.sk_sottoprodotto in ('007602','007619','007646','007641','007616','007600','007630','007631','007639','035933','035932','069640','069641'
				,'069642','069643','069644','069645')))
	            and patr.ID_CLIENTE_BIC is not null
				and patr.ID_PERIODOTEMPORALE = (extract(year from P.DATA_AGGIORNAMENTO))*100 + extract(month from P.DATA_AGGIORNAMENTO)
				and CD_NDG_RAPPORTO is not null  --PATCH BP 20191025
) with data unique primary index (ID_CLIENTE_BIC, NDG)
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;

create volatile table SCADENZE_2 as (
	sel 
		conv.ID_CLIENTE_BIC,
		A.TIPO_RAPPORTO, 
		A.CODICE_RAPPORTO,
		A.CATEGORIA,
		A.NDG,
		A.DATA_SCADENZA,
		(case when A.DATA_SCADENZA<(coalesce(cast(cast(P.DATA_AGGIORNAMENTO+1 as DATE format 'YYYYMMDD') as VARCHAR(8)),'19000101'))
			or A.DATA_SCADENZA>(coalesce(cast(cast(case when substr(CAST(P.DATA_AGGIORNAMENTO AS DATE FORMAT 'YYYY-MM-DD'), 6,5) = '02-29' then
P.DATA_AGGIORNAMENTO-INTERVAL '1' DAY+INTERVAL '1' YEAR else P.DATA_AGGIORNAMENTO+INTERVAL '1' YEAR end as DATE format 'YYYYMMDD') as VARCHAR(8)),'19000101'))
			 or A.DATA_SCADENZA='00000000' then 0 else 1 end) as FL_DATA_SCADENZA
	from SCADENZE as A
	join EBIL_AREE.CT_PARAMETRI as P on 1=1
	inner join  CONVERSIONE_BIC_NDG as conv
		on A.NDG=conv.NDG 
	)with data primary index (ID_CLIENTE_BIC, TIPO_RAPPORTO, CODICE_RAPPORTO, CATEGORIA, NDG, FL_DATA_SCADENZA)
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;

----------BPF----------
create volatile table COPIA_ANAGRAFICA_BFP as (
	sel *
	from  EBIL_ANAG_V.V_AN_RAPPORTO_BFP AN
	join EBIL_AREE.CT_PARAMETRI on 1=1
	where DATA_AGGIORNAMENTO between AN.DT_INI_VAL and AN.DT_FIN_VAL
	)with data primary index (PK_RAPPORTO)
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


create volatile table COPIA_ASSOCIATIVA_BFP as (
	sel *
	from  EBIL_ANAG_V.V_ASSOC_RAPP_PROD_CLIENTE ASSOC
	join EBIL_AREE.CT_PARAMETRI on 1=1
	where DATA_AGGIORNAMENTO between ASSOC.DT_INIZIO_VALIDITA and ASSOC.DT_FINE_VALIDITA
		and CD_TIPO_RAPP in ( 'BFD', 'BFC') 
	)with data primary index (FK_RAPPORTO)
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


create volatile table COPIA_SALDI_BFP as (
	sel 
		FK_RAPPORTO,
		SAL.DT_RIFERIMENTO,
		SAL.IM_RIMBORSO_LORDO,
		SAL.IM_RIMBORSO_NETTO,
		SAL.FL_LORDISTA
	from EBIL_AREE_V.V_F_BFP_M SAL
	join EBIL_AREE.CT_PARAMETRI on 1=1
	where DT_RIFERIMENTO=cast(DATA_AGGIORNAMENTO as DATE)
		and SAL.IM_RIMBORSO_LORDO is NOT NULL
		and SAL.IM_RIMBORSO_NETTO is NOT NULL
	)with data primary index (FK_RAPPORTO)
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


create volatile table ANAGRAFICA_BFP as (
	sel 
		PK_RAPPORTO, 
		AN.SK_RAPPORTO, 
		CD_SISTEMA_SORGENTE, 
		TIPO_BUONO, 
		FL_COINTESTAZIONE, 
		DT_EMISSIONE, 
		DT_SCADENZA,
		case when SAL.FL_LORDISTA = 'S' then SAL.IM_RIMBORSO_LORDO else SAL.IM_RIMBORSO_NETTO end as VALORE_DI_RIMBORSO,
		MAX(CD_CLIENTE_SORGENTE) as CD_CLIENTE_SORGENTE, 
		MAX(FK_CLIENTE) as FK_CLIENTE
	from
		(sel *
		from COPIA_ANAGRAFICA_BFP) AN
	left join
		(sel *
		from COPIA_ASSOCIATIVA_BFP) ASSOC
		on ASSOC.FK_RAPPORTO = AN.PK_RAPPORTO
			and ASSOC.FK_TIPO_RAPP = AN.FK_TIPO_RAPP
	inner join	
		(sel *
		from COPIA_SALDI_BFP) SAL
		on AN.PK_RAPPORTO=SAL.FK_RAPPORTO
	group by 1,2,3,4,5,6,7,8	
	)with data unique primary index (SK_RAPPORTO, TIPO_BUONO)
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


create volatile table ANAGRAFICA_BFP_1 as (
	sel 
		CD_CLIENTE_SORGENTE as NDG,
		'03' AS TIPO_RAPPORTO,
		SUM(case when TRIM(TIPO_BUONO)='CART' then 1 else 0 end) as N_BFP_CART, 
		SUM(case when TRIM(TIPO_BUONO)='DEMAT' then 1 else 0 end) as N_BFP_DEMAT,
		COUNT(*) as N_BFP,
		SUM(case when TRIM(TIPO_BUONO)='CART' then VALORE_DI_RIMBORSO else 0 end) as VALORE_DI_RIMBORSO_CART, 
		SUM(case when TRIM(TIPO_BUONO)='DEMAT' then VALORE_DI_RIMBORSO else 0 end) as VALORE_DI_RIMBORSO_DEMAT,
		SUM(VALORE_DI_RIMBORSO) as VALORE_DI_RIMBORSO,
		SUM(case when TRIM(TIPO_BUONO)='CART' and DT_SCADENZA between DATA_AGGIORNAMENTO+1 and 
case when substr(CAST(DATA_AGGIORNAMENTO AS DATE FORMAT 'YYYY-MM-DD'), 6,5) = '02-29' then
DATA_AGGIORNAMENTO-INTERVAL '1' DAY+INTERVAL '1' YEAR else DATA_AGGIORNAMENTO+INTERVAL '1' YEAR end		then 1 else 0 end) as N_BFP_CART_SCADENZA,
		SUM(case when TRIM(TIPO_BUONO)='DEMAT' and DT_SCADENZA between DATA_AGGIORNAMENTO+1 and 
case when substr(CAST(DATA_AGGIORNAMENTO AS DATE FORMAT 'YYYY-MM-DD'), 6,5) = '02-29' then
DATA_AGGIORNAMENTO-INTERVAL '1' DAY+INTERVAL '1' YEAR else DATA_AGGIORNAMENTO+INTERVAL '1' YEAR end		then 1 else 0 end) as N_BFP_DEMAT_SCADENZA
	from ANAGRAFICA_BFP
	join EBIL_AREE.CT_PARAMETRI on 1=1
	group by 1
	) with data unique primary index (NDG)
on commit preserve rows;

create volatile table ANAGRAFICA_BFP_2 as(
sel conv.ID_CLIENTE_BIC, A.* 
from  ANAGRAFICA_BFP_1 as A
	join EBIL_AREE.CT_PARAMETRI as P on 1=1
	inner join  CONVERSIONE_BIC_NDG as conv
		on A.NDG=conv.NDG 
	)with data primary index (ID_CLIENTE_BIC)
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


----------UNIONE POLIZZE TITOLI E BPF----------
create volatile table SCADENZE_3 as (
	sel 
		TIPO_RAPPORTO,
		CATEGORIA,
		NDG, 
		ID_CLIENTE_BIC,
		SUM(FL_DATA_SCADENZA) as NUMERO_PRODOTTI_SCADENZA
	from SCADENZE_2
	group by 1,2,3,4

		union all
			sel 
				'03' as TIPO_RAPPORTO, 
				'DEMATERIALIZZATO' as CATEGORIA, 
				NDG,
				ID_CLIENTE_BIC,
				SUM(N_BFP_DEMAT_SCADENZA) as NUMERO_PRODOTTI_SCADENZA
			from 
				(sel ID_CLIENTE_BIC,NDG, N_BFP_CART_SCADENZA, N_BFP_DEMAT_SCADENZA
				from ANAGRAFICA_BFP_2
				where N_BFP_DEMAT>0
				) A
		group by 1,2,3,4
		
		union all
		sel 
			'03' as TIPO_RAPPORTO, 
			'CARTACEO' as CATEGORIA, 
			NDG, 
			ID_CLIENTE_BIC,
			SUM(N_BFP_CART_SCADENZA) as NUMERO_PRODOTTI_SCADENZA
		from 
			(sel  ID_CLIENTE_BIC,NDG, N_BFP_CART_SCADENZA, N_BFP_DEMAT_SCADENZA
			from ANAGRAFICA_BFP_2
			where N_BFP_CART>0
			) A
		group by 1,2,3,4
	) with data unique primary index ( ID_CLIENTE_BIC, NDG, TIPO_RAPPORTO, CATEGORIA)
on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;



