	left join FL_ACCREDITO_CONTO_EDWAE as R on P.ID_CLIENTE_BIC=R.ID_CLIENTE_BIC
     where P.id_periodo_temporale in (SELECT ID_PERIODO_TEMPORALE FROM EBIL_AREE.CT_PARAMETRI)
