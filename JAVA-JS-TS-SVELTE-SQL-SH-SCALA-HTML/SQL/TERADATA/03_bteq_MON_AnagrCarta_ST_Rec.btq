/************************************************************************************************/ 
/*                                                                                              */
/*		    RECUPERO MON_ANAGRCARTA_ST_SCRT_FS (SCARTI FISICI)                                  */
/*						                                                                        */
/*			SE LA DATA DI RIFERIMENTO È DI BUSINESS  SCARTO I PIÙ RECENTI            			*/
/*			SE LA DATA DI RIFERIMENTO NON È DI BUSINESS QUINDI SCARTO I PIÙ VECCHI              */
/*																								*/
/*																								*/
/*		LA DATA DI RIFERIMENTO NON È DI BUSINESS QUINDI SCARTO I PIÙ VECCHI	( I MENO RECENTI)	*/
/*    IL PRIMO FILE DEVE AVERE DT_INI_VAL = '1901-01-01'										*/
/************************************************************************************************/


/* 1 MONITORAGGIO: CALCOLO DEL DELTA STAGING-PRIMARIO */

CALL EDW_DW_MONITORAGGIO.EGBP_SP_DELTA_SA ('bteq_MON_AnagrCarta_ST_Rec.btq','/data/DWH/EGBP/LOADSCRIPT','N',S,S);



.IF ERRORCODE > 0 THEN .GOTO FINE;


CREATE VOLATILE TABLE VTB_ANAGCARTA_SCRT_FS AS (

SELECT NR_CARTA
  FROM EDW_DW_BP.MON_ANAGRCARTA_ST_FS_DEL
GROUP BY 1

) WITH DATA PRIMARY INDEX(NR_CARTA) 
ON COMMIT PRESERVE ROWS;


.IF ERRORLEVEL > 0 THEN .GOTO FINE;  

CREATE VOLATILE TABLE VTB_REC_ANAGCARTA AS (
SELECT A.NR_CARTA,
       A.CD_TIPO_CARTA,
       A.CD_SOTTOTIPO_CARTA,
       A.CD_FRAZ,
       A.CD_FISCALE,
       A.CD_STATO_CARTA,
       A.DT_RICHIESTA,
       A.DT_ASSEGNAZIONE,
       A.DT_ATTIVAZIONE,
       A.DT_ESTINZIONE,
       A.DT_SCADENZA,
       A.DT_BLOCCO ,
       A.DT_SBLOCCO ,
       A.NDG_AZIENDA,
       A.IM_TAGLIO,
       A.FLG_RINNOVO,
       A.FLG_SPEDIZIONE,
       A.NR_VECCHIA_CARTA,
       A.DT_STATO_CARTA,
       A.NR_CARTA_ANONIMA ,
       A.NR_CARTA_NEW_OLD,
       A.FLG_CIRCUITO ,
       A.FLG_TIPO_SOGGETTO ,
       A.CD_IBAN ,
       A.CD_BARRE,
       A.ID_PRATICA ,
       A.DS_AZIENDA ,
       A.UTENTE_ESTINZIONE ,
       A.CD_LOYALTY_ESTERNO,
       A.ID_CLIENTE ,
       A.NDG_TITOLARE,
       A.IM_FIDO,
       A.FLG_ESTINZIONE,
       A.DT_EMISSIONE,
       A.DT_EVOLUZIONE,
       A.FLG_CARTA_AGGIUNTIVA ,
       A.CD_PAN_APPL_POSTAMAT,
       A.CD_PRODOTTO,
       A.RELEASE_PRODOTTO ,
       A.FLG_PIATTAFORMA_APPARTENENZA ,
       A.ID_CARTA,
       A.CD_CC ,
       A.CANALE,
       A.TIPO_RAPPORTO ,
       A.CANALE_ATTIVAZIONE ,
       A.DT_RINNOVO,
       A.DT_SOSTITUZIONE ,
       A.DT_SPEDIZIONE,
       A.CD_TRACC_SPEDIZ ,
       A.ESITO_SPEDIZ ,
       A.VETTORE_SPEDIZ ,
       A.TIPO_SPEDIZ ,
       A.FRAZ_OPERATIVO_UT ,
       A.ID_SOGGETTO ,
       A.CD_PAN_SEC_TRACCIA ,
	   CAST( SUBSTR(C.TESTA_TS_PRODUZIONE_FLUSSO,1,8) AS DATE FORMAT 'YYYYMMDD') AS DT_INI_VAL,
	   TRIM(C.NOME_FILE) AS NOME_FILE,
	   A.ID_FILE
FROM EDW_SA_BP.MON_A001_ANAGRCARTA_ST A
INNER JOIN VTB_ANAGCARTA_SCRT_FS B
ON LPAD(A.NR_CARTA, 16, '0') = B.NR_CARTA
INNER JOIN  EDW_DW_MONITORAGGIO.MONIT_FILE_DATI  C
ON C.ID_FILE = A.ID_FILE
) WITH DATA ON COMMIT PRESERVE ROWS;



.IF ERRORCODE > 0 THEN .GOTO FINE;


/* 2 STEP STANDARD CON VARIAZIONI: VOLATILI CHE INDIVIDUANO I RECORD SULLA STAGING STORICA NON ANCORA CARICATI SUL PRIMARIO */
 
CREATE VOLATILE TABLE VTB_ANAGCARTA_STG AS
(
SELECT
	LPAD(STAGING.NR_CARTA, 16, '0') AS NR_CARTA,               
	RAP_ST.SK_RAPPORTO,   -- SK_RAPPORTO NULL PER I NUOVI RECORD E VALORIZZATO PER RECORD GIÀ ESISTENTI DA STORICIZZARE	
	'CARTA' AS TIPO_RAPPORTO,
   CASE WHEN ROW_NUMBER() OVER (PARTITION BY STAGING.NR_CARTA ORDER BY STAGING.DT_INI_VAL) = 1
                               THEN CASE WHEN STAGING.DT_RICHIESTA = DATE '0001-01-01'
                                         THEN DATE '1901-01-01'
                                         WHEN STAGING.DT_RICHIESTA = DATE '9999-12-31'
                                         THEN DATE '1900-01-01' --'2999-12-31' (PRIMA)
                                         WHEN STAGING.DT_RICHIESTA IS NULL
                                         THEN DATE '1900-01-01'
                                         ELSE STAGING.DT_RICHIESTA END
                               ELSE STAGING.DT_INI_VAL
    END DT_INI_VAL,  -- NEL CASO DI PIU FILE DA CARICARE DURANTE IL PRIMO INSERIMENTO
	STAGING.CD_TIPO_CARTA,						
	STAGING.CD_SOTTOTIPO_CARTA,            
	STAGING.CD_FRAZ,                       
	STAGING.CD_FISCALE,                    
	STAGING.CD_STATO_CARTA,                
	CASE WHEN STAGING.DT_RICHIESTA = DATE '0001-01-01' THEN DATE '1901-01-01' 
		WHEN STAGING.DT_RICHIESTA = DATE '9999-12-31' THEN DATE '2999-12-31' 
        ELSE STAGING.DT_RICHIESTA END AS  DT_RICHIESTA,                  
	CASE WHEN STAGING.DT_ASSEGNAZIONE = DATE '0001-01-01' THEN DATE '1901-01-01' 
		WHEN STAGING.DT_ASSEGNAZIONE = DATE '9999-12-31' THEN DATE '2999-12-31'  
		ELSE STAGING.DT_ASSEGNAZIONE END AS  DT_ASSEGNAZIONE,             
	CASE WHEN STAGING.DT_ATTIVAZIONE = DATE '0001-01-01' THEN DATE '1901-01-01' 
		 WHEN STAGING.DT_ATTIVAZIONE = DATE '9999-12-31' THEN DATE '2999-12-31'  
		ELSE STAGING.DT_ATTIVAZIONE END AS DT_ATTIVAZIONE,              
	CASE WHEN STAGING.DT_ESTINZIONE = DATE '9999-12-31' THEN DATE '2999-12-31' 
	     WHEN STAGING.DT_ESTINZIONE = DATE '0001-01-01' THEN DATE '1901-01-01'  
		ELSE STAGING.DT_ESTINZIONE END AS DT_ESTINZIONE,               
	CASE WHEN STAGING.DT_SCADENZA = DATE '9999-12-31' THEN DATE '2999-12-31' 
		WHEN STAGING.DT_SCADENZA = DATE '0001-01-01' THEN DATE '1901-01-01'  	
	     ELSE STAGING.DT_SCADENZA END DT_SCADENZA,                 
	CASE WHEN STAGING.DT_BLOCCO = DATE '0001-01-01' THEN DATE '1901-01-01' 
		WHEN STAGING.DT_BLOCCO = DATE '9999-12-31' THEN DATE '2999-12-31'
		ELSE STAGING.DT_BLOCCO END AS  DT_BLOCCO,                   
	CASE WHEN STAGING.DT_SBLOCCO = DATE '0001-01-01' THEN DATE '1901-01-01' 
		WHEN STAGING.DT_SBLOCCO = DATE '9999-12-31' THEN DATE '2999-12-31'
		ELSE STAGING.DT_SBLOCCO END AS DT_SBLOCCO,
	STAGING.NDG_AZIENDA,                 
	STAGING.IM_TAGLIO,                   
	STAGING.FLG_RINNOVO,                 
	STAGING.FLG_SPEDIZIONE,              
	STAGING.NR_VECCHIA_CARTA,            
	CASE WHEN STAGING.DT_STATO_CARTA = DATE '0001-01-01' THEN DATE '1901-01-01' ELSE STAGING.DT_STATO_CARTA END  AS DT_STATO_CARTA,    	       
	STAGING.NR_CARTA_ANONIMA,            
	STAGING.NR_CARTA_NEW_OLD ,           
	STAGING.FLG_CIRCUITO,                
	STAGING.FLG_TIPO_SOGGETTO,           
	STAGING.CD_IBAN,                     
	STAGING.CD_BARRE,                    
	STAGING.ID_PRATICA,                  
	STAGING.DS_AZIENDA ,                 
	STAGING.UTENTE_ESTINZIONE,           
	STAGING.CD_LOYALTY_ESTERNO,          
	STAGING.ID_CLIENTE,                  
	STAGING.NDG_TITOLARE,                
	STAGING.IM_FIDO,                     
	STAGING.FLG_ESTINZIONE,              
	CASE WHEN STAGING.DT_EMISSIONE = DATE '0001-01-01' THEN DATE '1901-01-01' 
	     WHEN STAGING.DT_EMISSIONE = DATE '9999-12-31' THEN DATE '2999-12-31' 
		 ELSE STAGING.DT_EMISSIONE END AS DT_EMISSIONE,                
	CASE WHEN STAGING.DT_EVOLUZIONE = DATE '0001-01-01' THEN DATE '1901-01-01' 
	     WHEN STAGING.DT_EVOLUZIONE = DATE '9999-12-31' THEN DATE '2999-12-31' 
		 ELSE STAGING.DT_EVOLUZIONE END AS DT_EVOLUZIONE,               
	STAGING.FLG_CARTA_AGGIUNTIVA,        
	--ALC:AGGIUNTA CAMPI 12022016 - ID_SOGGETTO E NGA
	STAGING.CD_PAN_APPL_POSTAMAT,          
	STAGING.CD_PRODOTTO,                 
	STAGING.RELEASE_PRODOTTO,            
	STAGING.FLG_PIATTAFORMA_APPARTENENZA,
	STAGING.ID_CARTA, 
	STAGING.CD_CC,
	STAGING.CANALE ,
    STAGING.TIPO_RAPPORTO AS TIPO_RAPPORTO_REG,             --IL TIPO_RAPPORTO DI STAGING È QUELLO REGOLAMENTATO, NON DELLA CARTA
    --RDC:AGGIUNTA CAMPI 22052015 - INIZIATIVA 106631
    STAGING.CANALE_ATTIVAZIONE,
    CASE WHEN STAGING.DT_RINNOVO = DATE '0001-01-01' THEN DATE '1901-01-01' 
         WHEN STAGING.DT_RINNOVO =  DATE '9999-12-31' THEN DATE '2999-12-31' 
         ELSE STAGING.DT_RINNOVO END AS DT_RINNOVO,
    CASE WHEN STAGING.DT_SOSTITUZIONE = DATE '0001-01-01' THEN DATE '1901-01-01' 
         WHEN STAGING.DT_SOSTITUZIONE =  DATE '9999-12-31' THEN DATE '2999-12-31' 
         ELSE STAGING.DT_SOSTITUZIONE END AS DT_SOSTITUZIONE,
    CASE WHEN STAGING.DT_SPEDIZIONE = DATE '0001-01-01' THEN DATE '1901-01-01' 
         WHEN STAGING.DT_SPEDIZIONE =  DATE '9999-12-31' THEN DATE '2999-12-31' 
         ELSE STAGING.DT_SPEDIZIONE END AS DT_SPEDIZIONE,
    STAGING.CD_TRACC_SPEDIZ,
    STAGING.ESITO_SPEDIZ,
    STAGING.VETTORE_SPEDIZ,
    STAGING.TIPO_SPEDIZ,
    STAGING.FRAZ_OPERATIVO_UT,
    --RDC:FINE AGGIUNTA CAMPI
    --ALC:AGGIUNTA CAMPI 12022016 - ID_SOGGETTO E NGA
    STAGING.ID_SOGGETTO,
    STAGING.CD_PAN_SEC_TRACCIA,
	STAGING.NOME_FILE,
    --ALC:FINE AGGIUNTA CAMPI
    FLUSSO.ID_PROCESSO,
    0 AS ID_SOTTOPROCESSO,
    CASE WHEN RAP_ST.SK_RAPPORTO IS NOT NULL THEN 0 ELSE 1 END AS FL_NEW,
	STAGING.ID_FILE
                           
FROM VTB_REC_ANAGCARTA STAGING

INNER JOIN EDW_DW_MONITORAGGIO.MONIT_PROCESSO_GTT FLUSSO 
ON 1=1 
            
LEFT JOIN (SELECT NR_CARTA,SK_RAPPORTO FROM EDW_DW_BP.MON_CARTA_ASS_RAPPORTO) RAP_ST
			ON LPAD(STAGING.NR_CARTA, 16, '0') =   LPAD(RAP_ST.NR_CARTA, 16, '0')
WHERE CD_PRODOTTO NOT IN ('EUACQM', 'EUACQ')			
) 
WITH DATA PRIMARY INDEX(NR_CARTA) 
INDEX (SK_RAPPORTO) 
INDEX (DT_INI_VAL) ON COMMIT PRESERVE ROWS;


.IF ERRORLEVEL > 0 THEN .GOTO FINE;  

COLLECT STATISTICS ON VTB_ANAGCARTA_STG INDEX(NR_CARTA);
COLLECT STATISTICS ON VTB_ANAGCARTA_STG INDEX(SK_RAPPORTO);
COLLECT STATISTICS ON VTB_ANAGCARTA_STG COLUMN(FL_NEW);
COLLECT STATISTICS ON VTB_ANAGCARTA_STG INDEX(DT_INI_VAL);

.IF ERRORLEVEL > 0 THEN .GOTO FINE;


/*2A   MONITORAGGIO:STEP DI CONTROLLO PER LA RISALITA DEL DATO */



SELECT 'TROVATO' DELTA
FROM VTB_ANAGCARTA_STG
QUALIFY ROW_NUMBER() OVER (ORDER BY 1)=1;


.IF ACTIVITYCOUNT=0 THEN.GOTO QUALITA;


/* INDIVIDUAZIONE DEI RECORD CON CHIAVE DUPLICATA ESCLUSO IL PIU RECENTE CHE DEVE RISALIRE */
/* INDIVIDUIAMO I RECORD CHE RAPPRESENTANO UNA RETTIFICA (VIOLAZIONE DI CHIAVE) */
/* IN CASO DI STESSA CHIAVE SI SELEZIONANO I PIU' NUOVI */


CREATE VOLATILE TABLE VTB_MON_ANAGCARTA_VIOL_KEY_TMP AS 
(
SELECT
	 NR_CARTA,
	 DT_INI_VAL,
	 MAX(NOME_FILE) AS NOME_FILE
	
FROM VTB_ANAGCARTA_STG

GROUP BY 1,2
HAVING COUNT(*)>1
) 
WITH DATA PRIMARY INDEX( NR_CARTA )
ON COMMIT PRESERVE ROWS;

.IF ERRORLEVEL > 0 THEN .GOTO FINE;   

COLLECT STATISTICS ON VTB_MON_ANAGCARTA_VIOL_KEY_TMP INDEX(NR_CARTA);
COLLECT STATISTICS ON VTB_MON_ANAGCARTA_VIOL_KEY_TMP COLUMN(NR_CARTA,DT_INI_VAL);

.IF ERRORLEVEL > 0 THEN .GOTO FINE;

/* RECORD CON LA STESSA CHIAVE PRESENTI SUGLI N FLUSSI DA CARICARE SU PRIMARIO */
CREATE VOLATILE TABLE VTB_MON_ANAGCARTA_VIOL_KEY AS
(

SELECT 
	 ANAGCARTA_STAGING.* ,
	 2 AS CD_SCARTO,
   CAST('DUPKEY' AS VARCHAR(50)) AS DS_CAMPO_SCARTO 
	 
FROM VTB_ANAGCARTA_STG ANAGCARTA_STAGING

INNER JOIN VTB_MON_ANAGCARTA_VIOL_KEY_TMP VIOL_KEY_A
	 ON ANAGCARTA_STAGING.NR_CARTA = VIOL_KEY_A.NR_CARTA
			AND ANAGCARTA_STAGING.DT_INI_VAL = VIOL_KEY_A.DT_INI_VAL
			
LEFT OUTER JOIN VTB_MON_ANAGCARTA_VIOL_KEY_TMP VIOL_KEY_B
	 ON ANAGCARTA_STAGING.NR_CARTA = VIOL_KEY_B.NR_CARTA
	AND ANAGCARTA_STAGING.DT_INI_VAL = VIOL_KEY_B.DT_INI_VAL
	AND ANAGCARTA_STAGING.NOME_FILE = VIOL_KEY_B.NOME_FILE
WHERE VIOL_KEY_B.NR_CARTA IS NULL
) 
WITH DATA PRIMARY INDEX ( NR_CARTA )
ON COMMIT PRESERVE ROWS;

.IF ERRORLEVEL > 0 THEN .GOTO FINE;   

COLLECT STATISTICS ON VTB_MON_ANAGCARTA_VIOL_KEY COLUMN(NR_CARTA,DT_INI_VAL);


.IF ERRORLEVEL > 0 THEN .GOTO FINE;


/* RECORD PRESENTI SULLA STAGING CON LA STESSA CHIAVE DEI RECORD PRESENTI SU PRIMARIO */
	INSERT INTO VTB_MON_ANAGCARTA_VIOL_KEY
	
	SELECT
		 ANAGCARTA_STAGING.*,
		 2 AS CD_SCARTO,
	   CAST('DUPKEY' AS VARCHAR(50)) AS DS_CAMPO_SCARTO 
	
	FROM VTB_ANAGCARTA_STG ANAGCARTA_STAGING
		 
	INNER JOIN EDW_DW_BP.MON_ANAGRCARTA_ST ANAGRCARTA_PRIMARIO
		 ON ANAGRCARTA_PRIMARIO.NR_CARTA = ANAGCARTA_STAGING.NR_CARTA
		AND ANAGCARTA_STAGING.DT_INI_VAL = ANAGRCARTA_PRIMARIO.DT_INI_VAL;
	

CALL EDW_DW_MONITORAGGIO.EGBP_UPD_MONIT_PROCESSO_GTT('20','MON_ANAGRCARTA_ST','EDW_DW_BP','NR_REC_VIOL_KEY','VTB_MON_ANAGCARTA_VIOL_KEY',S,S);
	
.IF ERRORCODE > 0 THEN .GOTO FINE;   



-- INSERIMENTO NELLA VTB_MON_ANAGCARTA_VIOL_KEY DELLE CARTE SCARTATE PER SCARTO 7
-- DT_SCADENZA NEI FLUSSI DA CARICARE DIVERSA DA DT_SCADENZA PRESENTE SUL PRIMARIO
-- 2015-12-04: RDC - LE CARTE 25 E 09 VENGONO ESCLUSE DALLO SCARTO 7

INSERT INTO VTB_MON_ANAGCARTA_VIOL_KEY
SELECT
	ANAGCARTA_STAGING.*,
7 AS CD_SCARTO,
'DT_SCADENZA' AS CD_ERRORE

FROM VTB_ANAGCARTA_STG ANAGCARTA_STAGING 
INNER JOIN EDW_DW_BP.MON_ANAGRCARTA_ST PRIM_ANAGR
		ON ANAGCARTA_STAGING.SK_RAPPORTO = PRIM_ANAGR.SK_RAPPORTO
		AND FL_FITTIZIO = 0 
WHERE 
    COALESCE(ANAGCARTA_STAGING.DT_SCADENZA, DATE '2999-12-31') <> COALESCE(PRIM_ANAGR.DT_SCADENZA,DATE '2999-12-31') 
    AND ANAGCARTA_STAGING.CD_TIPO_CARTA NOT IN('25','09');     

.IF ERRORLEVEL > 0 THEN .GOTO FINE; 


INSERT INTO VTB_MON_ANAGCARTA_VIOL_KEY
SELECT
	ANAGCARTA_STAGING.*,
7 AS CD_SCARTO,
'DT_SCADENZA' AS CD_ERRORE

FROM VTB_ANAGCARTA_STG ANAGCARTA_STAGING 
INNER JOIN VTB_ANAGCARTA_STG ANAGCARTA_STAGING_2
		ON ANAGCARTA_STAGING.SK_RAPPORTO = ANAGCARTA_STAGING_2.SK_RAPPORTO 
        AND ANAGCARTA_STAGING.SK_RAPPORTO IS NOT NULL
        --ON ANAGCARTA_STAGING.NR_CARTA = ANAGCARTA_STAGING_2.NR_CARTA 
WHERE 
    COALESCE(ANAGCARTA_STAGING.DT_SCADENZA, DATE '2999-12-31') <> COALESCE(ANAGCARTA_STAGING_2.DT_SCADENZA,DATE '2999-12-31') 
    AND ANAGCARTA_STAGING.CD_TIPO_CARTA NOT IN('25','09');  


.IF ERRORLEVEL > 0 THEN .GOTO FINE; 

/* ESCLUSIONE DI TUTTI I CASI ANOMALI FIN QUI INDIVIDUATI */

CREATE VOLATILE TABLE VTB_MON_CARTA_STAG_NO_VIOL_KEY AS 
(
SELECT
     ANAGCARTA_STAGING.NR_CARTA ,
     ANAGCARTA_STAGING.SK_RAPPORTO ,
     ANAGCARTA_STAGING.TIPO_RAPPORTO ,
     ANAGCARTA_STAGING.DT_INI_VAL ,
     ANAGCARTA_STAGING.CD_TIPO_CARTA ,
     ANAGCARTA_STAGING.CD_SOTTOTIPO_CARTA ,
     ANAGCARTA_STAGING.CD_FRAZ ,
     ANAGCARTA_STAGING.CD_FISCALE ,
     ANAGCARTA_STAGING.CD_STATO_CARTA ,
     ANAGCARTA_STAGING.DT_RICHIESTA ,
     ANAGCARTA_STAGING.DT_ASSEGNAZIONE ,
     ANAGCARTA_STAGING.DT_ATTIVAZIONE ,
     ANAGCARTA_STAGING.DT_ESTINZIONE ,
     ANAGCARTA_STAGING.DT_SCADENZA ,
     ANAGCARTA_STAGING.DT_BLOCCO ,
     ANAGCARTA_STAGING.DT_SBLOCCO ,
     ANAGCARTA_STAGING.NDG_AZIENDA ,
     ANAGCARTA_STAGING.IM_TAGLIO ,
     ANAGCARTA_STAGING.FLG_RINNOVO ,
     ANAGCARTA_STAGING.FLG_SPEDIZIONE ,
     ANAGCARTA_STAGING.NR_VECCHIA_CARTA ,
     ANAGCARTA_STAGING.DT_STATO_CARTA ,
     ANAGCARTA_STAGING.NR_CARTA_ANONIMA ,
     ANAGCARTA_STAGING.NR_CARTA_NEW_OLD ,
     ANAGCARTA_STAGING.FLG_CIRCUITO ,
     ANAGCARTA_STAGING.FLG_TIPO_SOGGETTO ,
     ANAGCARTA_STAGING.CD_IBAN ,
     ANAGCARTA_STAGING.CD_BARRE ,
     ANAGCARTA_STAGING.ID_PRATICA ,
     ANAGCARTA_STAGING.DS_AZIENDA ,
     ANAGCARTA_STAGING.UTENTE_ESTINZIONE ,
     ANAGCARTA_STAGING.CD_LOYALTY_ESTERNO ,
     ANAGCARTA_STAGING.ID_CLIENTE ,
     ANAGCARTA_STAGING.NDG_TITOLARE ,
     ANAGCARTA_STAGING.IM_FIDO ,
     ANAGCARTA_STAGING.FLG_ESTINZIONE ,
     ANAGCARTA_STAGING.DT_EMISSIONE ,
     ANAGCARTA_STAGING.DT_EVOLUZIONE ,
     ANAGCARTA_STAGING.FLG_CARTA_AGGIUNTIVA ,
     ANAGCARTA_STAGING.CD_PAN_APPL_POSTAMAT ,
     ANAGCARTA_STAGING.CD_PRODOTTO ,
     ANAGCARTA_STAGING.RELEASE_PRODOTTO ,
     ANAGCARTA_STAGING.FLG_PIATTAFORMA_APPARTENENZA ,
     ANAGCARTA_STAGING.ID_CARTA ,
     ANAGCARTA_STAGING.CD_CC ,
     ANAGCARTA_STAGING.CANALE ,
     ANAGCARTA_STAGING.TIPO_RAPPORTO_REG ,
     ANAGCARTA_STAGING.CANALE_ATTIVAZIONE,
     ANAGCARTA_STAGING.DT_RINNOVO,
     ANAGCARTA_STAGING.DT_SOSTITUZIONE,
     ANAGCARTA_STAGING.DT_SPEDIZIONE,
     ANAGCARTA_STAGING.CD_TRACC_SPEDIZ,
     ANAGCARTA_STAGING.ESITO_SPEDIZ,
     ANAGCARTA_STAGING.VETTORE_SPEDIZ,
     ANAGCARTA_STAGING.TIPO_SPEDIZ,
     ANAGCARTA_STAGING.FRAZ_OPERATIVO_UT,
     ANAGCARTA_STAGING.ID_SOGGETTO,
     ANAGCARTA_STAGING.CD_PAN_SEC_TRACCIA,
     ANAGCARTA_STAGING.ID_FILE ,
     ANAGCARTA_STAGING.ID_PROCESSO ,
     ANAGCARTA_STAGING.ID_SOTTOPROCESSO ,
     ANAGCARTA_STAGING.NOME_FILE ,
     ANAGCARTA_STAGING.FL_NEW
  
FROM VTB_ANAGCARTA_STG ANAGCARTA_STAGING         

MINUS

SELECT
     ANAGRCARTA_VIOL_KEY.NR_CARTA ,
     ANAGRCARTA_VIOL_KEY.SK_RAPPORTO ,
     ANAGRCARTA_VIOL_KEY.TIPO_RAPPORTO ,
     ANAGRCARTA_VIOL_KEY.DT_INI_VAL ,
     ANAGRCARTA_VIOL_KEY.CD_TIPO_CARTA ,
     ANAGRCARTA_VIOL_KEY.CD_SOTTOTIPO_CARTA ,
     ANAGRCARTA_VIOL_KEY.CD_FRAZ ,
     ANAGRCARTA_VIOL_KEY.CD_FISCALE ,
     ANAGRCARTA_VIOL_KEY.CD_STATO_CARTA ,
     ANAGRCARTA_VIOL_KEY.DT_RICHIESTA ,
     ANAGRCARTA_VIOL_KEY.DT_ASSEGNAZIONE ,
     ANAGRCARTA_VIOL_KEY.DT_ATTIVAZIONE ,
     ANAGRCARTA_VIOL_KEY.DT_ESTINZIONE ,
     ANAGRCARTA_VIOL_KEY.DT_SCADENZA ,
     ANAGRCARTA_VIOL_KEY.DT_BLOCCO ,
     ANAGRCARTA_VIOL_KEY.DT_SBLOCCO ,
     ANAGRCARTA_VIOL_KEY.NDG_AZIENDA ,
     ANAGRCARTA_VIOL_KEY.IM_TAGLIO ,
     ANAGRCARTA_VIOL_KEY.FLG_RINNOVO ,
     ANAGRCARTA_VIOL_KEY.FLG_SPEDIZIONE ,
     ANAGRCARTA_VIOL_KEY.NR_VECCHIA_CARTA ,
     ANAGRCARTA_VIOL_KEY.DT_STATO_CARTA ,
     ANAGRCARTA_VIOL_KEY.NR_CARTA_ANONIMA ,
     ANAGRCARTA_VIOL_KEY.NR_CARTA_NEW_OLD ,
     ANAGRCARTA_VIOL_KEY.FLG_CIRCUITO ,
     ANAGRCARTA_VIOL_KEY.FLG_TIPO_SOGGETTO ,
     ANAGRCARTA_VIOL_KEY.CD_IBAN ,
     ANAGRCARTA_VIOL_KEY.CD_BARRE ,
     ANAGRCARTA_VIOL_KEY.ID_PRATICA ,
     ANAGRCARTA_VIOL_KEY.DS_AZIENDA ,
     ANAGRCARTA_VIOL_KEY.UTENTE_ESTINZIONE ,
     ANAGRCARTA_VIOL_KEY.CD_LOYALTY_ESTERNO ,
     ANAGRCARTA_VIOL_KEY.ID_CLIENTE ,
     ANAGRCARTA_VIOL_KEY.NDG_TITOLARE ,
     ANAGRCARTA_VIOL_KEY.IM_FIDO ,
     ANAGRCARTA_VIOL_KEY.FLG_ESTINZIONE ,
     ANAGRCARTA_VIOL_KEY.DT_EMISSIONE ,
     ANAGRCARTA_VIOL_KEY.DT_EVOLUZIONE ,
     ANAGRCARTA_VIOL_KEY.FLG_CARTA_AGGIUNTIVA ,
     ANAGRCARTA_VIOL_KEY.CD_PAN_APPL_POSTAMAT ,
     ANAGRCARTA_VIOL_KEY.CD_PRODOTTO ,
     ANAGRCARTA_VIOL_KEY.RELEASE_PRODOTTO ,
     ANAGRCARTA_VIOL_KEY.FLG_PIATTAFORMA_APPARTENENZA ,
     ANAGRCARTA_VIOL_KEY.ID_CARTA ,
     ANAGRCARTA_VIOL_KEY.CD_CC ,
     ANAGRCARTA_VIOL_KEY.CANALE ,
     ANAGRCARTA_VIOL_KEY.TIPO_RAPPORTO_REG ,
     ANAGRCARTA_VIOL_KEY.CANALE_ATTIVAZIONE,
     ANAGRCARTA_VIOL_KEY.DT_RINNOVO,
     ANAGRCARTA_VIOL_KEY.DT_SOSTITUZIONE,
     ANAGRCARTA_VIOL_KEY.DT_SPEDIZIONE,
     ANAGRCARTA_VIOL_KEY.CD_TRACC_SPEDIZ,
     ANAGRCARTA_VIOL_KEY.ESITO_SPEDIZ,
     ANAGRCARTA_VIOL_KEY.VETTORE_SPEDIZ,
     ANAGRCARTA_VIOL_KEY.TIPO_SPEDIZ,
     ANAGRCARTA_VIOL_KEY.FRAZ_OPERATIVO_UT,
     ANAGRCARTA_VIOL_KEY.ID_SOGGETTO,
     ANAGRCARTA_VIOL_KEY.CD_PAN_SEC_TRACCIA,
     ANAGRCARTA_VIOL_KEY.ID_FILE ,
     ANAGRCARTA_VIOL_KEY.ID_PROCESSO ,
     ANAGRCARTA_VIOL_KEY.ID_SOTTOPROCESSO ,
     ANAGRCARTA_VIOL_KEY.NOME_FILE ,
     ANAGRCARTA_VIOL_KEY.FL_NEW
FROM VTB_MON_ANAGCARTA_VIOL_KEY ANAGRCARTA_VIOL_KEY
)
WITH DATA PRIMARY INDEX (NR_CARTA)
ON COMMIT PRESERVE ROWS;

.IF ERRORLEVEL > 0 THEN .GOTO FINE; 


CALL EDW_DW_MONITORAGGIO.EGBP_UPD_MONIT_PROCESSO_GTT('30','MON_ANAGRCARTA_ST','EDW_DW_BP', 'NR_REC_NO_VIOL_KEY','VTB_MON_CARTA_STAG_NO_VIOL_KEY',S,S);

.IF ERRORCODE > 0 THEN .GOTO FINE; 


-- ELENCO CARTE DA SURROGARE PRESE DALLA VOLATILE RIPULITA DELLE VIOLAZIONI DI CHIAVE
-- PER OGNI NR_CARTA SI PRENDE SOLO LA PRIMA CARTA ORDINATA PER DT_INI_VAL
CREATE VOLATILE TABLE VTB_NUOVE_KEY_CARTE AS (
  SELECT NR_CARTA,TIPO_RAPPORTO
  FROM VTB_MON_CARTA_STAG_NO_VIOL_KEY 
  WHERE FL_NEW = 1
  QUALIFY ROW_NUMBER() OVER (PARTITION BY NR_CARTA ORDER BY DT_INI_VAL)=1
  ) WITH DATA
PRIMARY INDEX( NR_CARTA)
ON COMMIT PRESERVE ROWS;

.IF ERRORLEVEL > 0 THEN .GOTO FINE; 


COLLECT STATISTICS ON EDW_DW_BP.MON_CARTA_ASS_RAPPORTO INDEX(NR_CARTA);
COLLECT STATISTICS ON VTB_NUOVE_KEY_CARTE INDEX(NR_CARTA);


.IF ERRORLEVEL > 0 THEN .GOTO FINE;

-- CALCOLO CHIAVI SURROGATE SK_RAPPORTO
INSERT INTO EDW_DW_BP.MON_CARTA_ASS_RAPPORTO(NR_CARTA )  
SELECT NR_CARTA 
FROM VTB_NUOVE_KEY_CARTE A
 ;
		
.IF ERRORLEVEL > 0 THEN .GOTO FINE; 


-- CREAZIONE TABELLA VTB_MON_ANAGCARTA_VIOL_KEY_TMP PIU SK CALCOLATA PRIMA
-- LE VOLATILI NON POSSONO CREARE CAMPI IDENTITY
CREATE VOLATILE TABLE VTB_ANAG_CARTA_STAG_NOVIOL_SK
     (
     SK_RAPPORTO BIGINT NOT NULL,
     TIPO_RAPPORTO CHAR(10) CHARACTER SET LATIN NOT CASESPECIFIC ,
    DT_INI_VAL DATE FORMAT 'YYYY-MM-DD' NOT NULL,
    NR_CARTA CHAR(16) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      CD_TIPO_CARTA CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC ,
      CD_SOTTOTIPO_CARTA CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC ,
      CD_FRAZ CHAR(5) CHARACTER SET LATIN NOT CASESPECIFIC ,
      CD_FISCALE CHAR(16) CHARACTER SET LATIN NOT CASESPECIFIC ,
      CD_STATO_CARTA CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC ,
      DT_RICHIESTA DATE FORMAT 'YYYY-MM-DD' ,
      DT_ASSEGNAZIONE DATE FORMAT 'YYYY-MM-DD' ,
      DT_ATTIVAZIONE DATE FORMAT 'YYYY-MM-DD' ,
      DT_ESTINZIONE DATE FORMAT 'YYYY-MM-DD' ,
      DT_SCADENZA DATE FORMAT 'YYYY-MM-DD' ,
      DT_BLOCCO DATE FORMAT 'YYYY-MM-DD' ,
      DT_SBLOCCO DATE FORMAT 'YYYY-MM-DD' ,
      NDG_AZIENDA CHAR(12) CHARACTER SET LATIN NOT CASESPECIFIC ,
      IM_TAGLIO DECIMAL(10,2) ,
      FLG_RINNOVO CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC ,
      FLG_SPEDIZIONE CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC  ,
      NR_VECCHIA_CARTA CHAR(16) CHARACTER SET LATIN NOT CASESPECIFIC ,
      DT_STATO_CARTA DATE ,
      NR_CARTA_ANONIMA CHAR(16) CHARACTER SET LATIN NOT CASESPECIFIC ,
      NR_CARTA_NEW_OLD CHAR(16) CHARACTER SET LATIN NOT CASESPECIFIC ,
      FLG_CIRCUITO CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC ,
      FLG_TIPO_SOGGETTO CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC ,
      CD_IBAN CHAR(27) CHARACTER SET LATIN NOT CASESPECIFIC ,
      CD_BARRE VARCHAR(13) CHARACTER SET LATIN NOT CASESPECIFIC ,
      ID_PRATICA VARCHAR(10) CHARACTER SET LATIN NOT CASESPECIFIC ,
      DS_AZIENDA VARCHAR(35) CHARACTER SET LATIN NOT CASESPECIFIC ,
      UTENTE_ESTINZIONE VARCHAR(12) CHARACTER SET LATIN NOT CASESPECIFIC ,
      CD_LOYALTY_ESTERNO VARCHAR(30) CHARACTER SET LATIN NOT CASESPECIFIC ,
      ID_CLIENTE VARCHAR(16) CHARACTER SET LATIN NOT CASESPECIFIC ,
      NDG_TITOLARE CHAR(12) CHARACTER SET LATIN NOT CASESPECIFIC ,
      IM_FIDO DECIMAL(7,2) ,
      FLG_ESTINZIONE CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC ,
      DT_EMISSIONE DATE FORMAT 'YYYY-MM-DD' ,
      DT_EVOLUZIONE DATE FORMAT 'YYYY-MM-DD' ,
      FLG_CARTA_AGGIUNTIVA CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC ,
      CD_PAN_APPL_POSTAMAT CHAR(16) CHARACTER SET LATIN NOT CASESPECIFIC,
      CD_PRODOTTO VARCHAR(10) CHARACTER SET LATIN NOT CASESPECIFIC ,
      RELEASE_PRODOTTO INTEGER ,
      FLG_PIATTAFORMA_APPARTENENZA CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC ,
      ID_CARTA VARCHAR(9) CHARACTER SET LATIN NOT CASESPECIFIC ,
      CD_CC CHAR(12) CHARACTER SET LATIN NOT CASESPECIFIC ,
      CANALE CHAR(5) CHARACTER SET LATIN NOT CASESPECIFIC ,
      TIPO_RAPPORTO_REG CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC ,
      CANALE_ATTIVAZIONE CHAR(5)  CHARACTER SET LATIN NOT CASESPECIFIC,
      DT_RINNOVO         DATE FORMAT 'YYYY-MM-DD' ,
      DT_SOSTITUZIONE    DATE FORMAT 'YYYY-MM-DD' ,
      DT_SPEDIZIONE      DATE FORMAT 'YYYY-MM-DD' ,
      CD_TRACC_SPEDIZ    CHAR(30) CHARACTER SET LATIN NOT CASESPECIFIC,
      ESITO_SPEDIZ       CHAR(2)  CHARACTER SET LATIN NOT CASESPECIFIC,
      VETTORE_SPEDIZ     CHAR(10) CHARACTER SET LATIN NOT CASESPECIFIC,
      TIPO_SPEDIZ        CHAR(10) CHARACTER SET LATIN NOT CASESPECIFIC,
      FRAZ_OPERATIVO_UT  CHAR(5)  CHARACTER SET LATIN NOT CASESPECIFIC,
      ID_SOGGETTO 				CHAR(9) CHARACTER SET LATIN NOT CASESPECIFIC,
      CD_PAN_SEC_TRACCIA CHAR(16) CHARACTER SET LATIN NOT CASESPECIFIC ,
      ID_FILE BIGINT NOT NULL,
      ID_PROCESSO BIGINT NOT NULL,
      ID_SOTTOPROCESSO INTEGER NOT NULL,
      NOME_FILE VARCHAR(100) CHARACTER SET LATIN NOT CASESPECIFIC,
      FL_NEW BYTEINT NOT NULL
      )
PRIMARY INDEX ( SK_RAPPORTO )
ON COMMIT PRESERVE ROWS;

.IF ERRORLEVEL > 0 THEN .GOTO FINE; 

COLLECT STATISTICS ON EDW_DW_BP.MON_CARTA_ASS_RAPPORTO COLUMN(NR_CARTA);


.IF ERRORLEVEL > 0 THEN .GOTO FINE;


INSERT INTO VTB_ANAG_CARTA_STAG_NOVIOL_SK
SELECT
 B.SK_RAPPORTO ,
 A.TIPO_RAPPORTO,
 A.DT_INI_VAL ,
 A.NR_CARTA ,
 A.CD_TIPO_CARTA ,
 A.CD_SOTTOTIPO_CARTA ,
 A.CD_FRAZ ,
 A.CD_FISCALE ,
 A.CD_STATO_CARTA ,
 A.DT_RICHIESTA ,
 A.DT_ASSEGNAZIONE  ,
 A.DT_ATTIVAZIONE ,
 A.DT_ESTINZIONE  ,
 A.DT_SCADENZA ,
 A.DT_BLOCCO ,
 A.DT_SBLOCCO ,
 A.NDG_AZIENDA ,
 A.IM_TAGLIO ,
 A.FLG_RINNOVO ,
 A.FLG_SPEDIZIONE ,
 A.NR_VECCHIA_CARTA ,
 A.DT_STATO_CARTA ,
 A.NR_CARTA_ANONIMA ,
 A.NR_CARTA_NEW_OLD ,
 A.FLG_CIRCUITO ,
 A.FLG_TIPO_SOGGETTO ,
 A.CD_IBAN ,
 A.CD_BARRE ,
 A.ID_PRATICA ,
 A.DS_AZIENDA ,
 A.UTENTE_ESTINZIONE ,
 A.CD_LOYALTY_ESTERNO ,
 A.ID_CLIENTE ,
 A.NDG_TITOLARE ,
 A.IM_FIDO ,
 A.FLG_ESTINZIONE ,
 A.DT_EMISSIONE ,
 A.DT_EVOLUZIONE ,
 A.FLG_CARTA_AGGIUNTIVA ,
 CD_PAN_APPL_POSTAMAT ,
 A.CD_PRODOTTO ,
 A.RELEASE_PRODOTTO  ,
 A.FLG_PIATTAFORMA_APPARTENENZA ,
 A.ID_CARTA ,
 A.CD_CC  ,
 A.CANALE ,
 A.TIPO_RAPPORTO_REG ,
 A.CANALE_ATTIVAZIONE,
 A.DT_RINNOVO,
 A.DT_SOSTITUZIONE,
 A.DT_SPEDIZIONE,
 A.CD_TRACC_SPEDIZ,
 A.ESITO_SPEDIZ,
 A.VETTORE_SPEDIZ,
 A.TIPO_SPEDIZ,
 A.FRAZ_OPERATIVO_UT,
 A.ID_SOGGETTO,
 A.CD_PAN_SEC_TRACCIA,
 A.ID_FILE,
 A.ID_PROCESSO,
 A.ID_SOTTOPROCESSO,
 A.NOME_FILE,
 A.FL_NEW 
 -- 1=CARTA NUOVA
 
FROM VTB_MON_CARTA_STAG_NO_VIOL_KEY  A
INNER JOIN  EDW_DW_BP.MON_CARTA_ASS_RAPPORTO B
ON A.NR_CARTA = B.NR_CARTA 
;

.IF ERRORLEVEL > 0 THEN .GOTO FINE; 

COLLECT STATISTICS ON VTB_ANAG_CARTA_STAG_NOVIOL_SK COLUMN(SK_RAPPORTO);
COLLECT STATISTICS ON VTB_ANAG_CARTA_STAG_NOVIOL_SK COLUMN(ID_FILE);
 
.IF ERRORLEVEL > 0 THEN .GOTO FINE;

-- 1 FLUSSO IN ENTRATA DT_INI_VAL = '1901-01-01'
CREATE VOLATILE TABLE VTB_ANAG_CARTA_STAG_1DATA AS
(
SELECT A.SK_RAPPORTO,
DATE '1901-01-01' AS DT_INIZ_VALID,
 A.NR_CARTA ,
 A.ID_FILE,
 A.NOME_FILE
 FROM VTB_ANAG_CARTA_STAG_NOVIOL_SK A
 QUALIFY RANK() OVER(ORDER BY A.DT_INI_VAL) =1
 ) WITH DATA PRIMARY INDEX (SK_RAPPORTO) ON COMMIT PRESERVE ROWS;

.IF ERRORLEVEL > 0 THEN .GOTO FINE; 

 COLLECT STATISTICS ON VTB_ANAG_CARTA_STAG_1DATA INDEX(SK_RAPPORTO);
 COLLECT STATISTICS ON VTB_ANAG_CARTA_STAG_1DATA COLUMN(ID_FILE);

.IF ERRORLEVEL > 0 THEN .GOTO FINE;

-- IL PRIMO FLUSSO IN INGRESSO  HA DT_INI_VAL = 1901-01-01
-- PER I SUCCESSIVI A TABELLA PIENA SI CONTINUA A CONSIDERARE LA DT_INI_VAL DEL FLUSSO
-- I SUCCESSIVI HANNO DT_INI_VAL PRESENTE NEL NOME_FLUSSO O INTESTAZIONE DEL FILE
CREATE VOLATILE TABLE VTB_ANAGCARTA_STG_SK AS
(
SELECT 
    A.SK_RAPPORTO,
    A.TIPO_RAPPORTO,
    CASE WHEN PRIM_ANAG.NUM_REC_PRIMARIO = 0
		THEN COALESCE(B.DT_INIZ_VALID,A.DT_INI_VAL) 
		ELSE A.DT_INI_VAL END AS DT_INI_VAL,
 A.NR_CARTA ,
 A.CD_TIPO_CARTA ,
 A.CD_SOTTOTIPO_CARTA ,
 A.CD_FRAZ ,
 A.CD_FISCALE ,
 A.CD_STATO_CARTA ,
 A.DT_RICHIESTA ,
 A.DT_ASSEGNAZIONE  ,
 A.DT_ATTIVAZIONE ,
 A.DT_ESTINZIONE  ,
 A.DT_SCADENZA ,
 A.DT_BLOCCO ,
 A.DT_SBLOCCO ,
 A.NDG_AZIENDA ,
 A.IM_TAGLIO ,
 A.FLG_RINNOVO ,
 A.FLG_SPEDIZIONE ,
 A.NR_VECCHIA_CARTA ,
 A.DT_STATO_CARTA ,
 A.NR_CARTA_ANONIMA ,
 A.NR_CARTA_NEW_OLD ,
 A.FLG_CIRCUITO ,
 A.FLG_TIPO_SOGGETTO ,
 A.CD_IBAN ,
 A.CD_BARRE ,
 A.ID_PRATICA ,
 A.DS_AZIENDA ,
 A.UTENTE_ESTINZIONE ,
 A.CD_LOYALTY_ESTERNO ,
 A.ID_CLIENTE ,
 A.NDG_TITOLARE ,
 A.IM_FIDO ,
 A.FLG_ESTINZIONE ,
 A.DT_EMISSIONE ,
 A.DT_EVOLUZIONE ,
 A.FLG_CARTA_AGGIUNTIVA ,
 A.CD_PAN_APPL_POSTAMAT ,
 A.CD_PRODOTTO ,
 A.RELEASE_PRODOTTO  ,
 A.FLG_PIATTAFORMA_APPARTENENZA ,
 A.ID_CARTA ,
 A.CD_CC  ,
 A.CANALE ,
 A.TIPO_RAPPORTO_REG ,
 A.CANALE_ATTIVAZIONE,
 A.DT_RINNOVO,
 A.DT_SOSTITUZIONE,
 A.DT_SPEDIZIONE,
 A.CD_TRACC_SPEDIZ,
 A.ESITO_SPEDIZ,
 A.VETTORE_SPEDIZ,
 A.TIPO_SPEDIZ,
 A.FRAZ_OPERATIVO_UT,
 A.ID_SOGGETTO,
 A.CD_PAN_SEC_TRACCIA,
 A.ID_FILE,
 A.ID_PROCESSO,
 A.ID_SOTTOPROCESSO,
 A.NOME_FILE,
 A.FL_NEW 
 FROM  
 	 (SELECT 
        SK_RAPPORTO,
        TIPO_RAPPORTO,
		DT_INI_VAL,
		NR_CARTA ,
		CD_TIPO_CARTA ,
		CD_SOTTOTIPO_CARTA ,
		CD_FRAZ ,
		CD_FISCALE ,
		CD_STATO_CARTA ,
		DT_RICHIESTA ,
		DT_ASSEGNAZIONE  ,
		DT_ATTIVAZIONE ,
		DT_ESTINZIONE  ,
		DT_SCADENZA ,
		DT_BLOCCO ,
		DT_SBLOCCO ,
		NDG_AZIENDA ,
		IM_TAGLIO ,
		FLG_RINNOVO ,
		FLG_SPEDIZIONE ,
		NR_VECCHIA_CARTA ,
		DT_STATO_CARTA ,
		NR_CARTA_ANONIMA ,
		NR_CARTA_NEW_OLD ,
		FLG_CIRCUITO ,
		FLG_TIPO_SOGGETTO ,
		CD_IBAN ,
		CD_BARRE ,
		ID_PRATICA ,
		DS_AZIENDA ,
		UTENTE_ESTINZIONE ,
		CD_LOYALTY_ESTERNO ,
		ID_CLIENTE ,
		NDG_TITOLARE ,
		IM_FIDO ,
		FLG_ESTINZIONE ,
		DT_EMISSIONE ,
		DT_EVOLUZIONE ,
		FLG_CARTA_AGGIUNTIVA ,
		CD_PAN_APPL_POSTAMAT ,
		CD_PRODOTTO ,
		RELEASE_PRODOTTO  ,
		FLG_PIATTAFORMA_APPARTENENZA ,
		ID_CARTA ,
		CD_CC  ,
		CANALE ,		
		TIPO_RAPPORTO_REG ,
    CANALE_ATTIVAZIONE,
    DT_RINNOVO,
    DT_SOSTITUZIONE,
    DT_SPEDIZIONE,
    CD_TRACC_SPEDIZ,
    ESITO_SPEDIZ,
    VETTORE_SPEDIZ,
    TIPO_SPEDIZ,
    FRAZ_OPERATIVO_UT,
    ID_SOGGETTO,
    CD_PAN_SEC_TRACCIA,
		ID_FILE,
		ID_PROCESSO,
 		ID_SOTTOPROCESSO,
		NOME_FILE,
		FL_NEW ,
		0 AS FL_JOIN	
        FROM VTB_ANAG_CARTA_STAG_NOVIOL_SK ) A
					 
 			LEFT JOIN (SELECT CASE WHEN COUNT(*)=0 THEN 0 ELSE 1 END AS NUM_REC_PRIMARIO 
 						FROM EDW_DW_BP.MON_ANAGRCARTA_ST) PRIM_ANAG
                ON	A.FL_JOIN = PRIM_ANAG.NUM_REC_PRIMARIO				
 					
 			LEFT JOIN VTB_ANAG_CARTA_STAG_1DATA  B
 	 			ON  A.SK_RAPPORTO = B.SK_RAPPORTO
 	 			AND A.ID_FILE = B.ID_FILE
) WITH DATA PRIMARY INDEX ( SK_RAPPORTO,DT_INI_VAL )
ON COMMIT PRESERVE ROWS;

.IF ERRORLEVEL > 0 THEN .GOTO FINE; 

COLLECT STATISTICS ON VTB_ANAGCARTA_STG_SK INDEX ( SK_RAPPORTO,DT_INI_VAL ); 	 

.IF ERRORLEVEL > 0 THEN .GOTO FINE;

/* INDIVIDUIAMO GLI SCARTI LOGICI - SCARTI CHE SARANNO COMUNQUE PRESENTI SULLA TABELLA DEL PRIMARIO */

 
CREATE VOLATILE TABLE VTB_CARTE_SCARTI_LOGICI     
	(
      SK_RAPPORTO  BIGINT NOT NULL,                                             --REX 18-03-2015
      TIPO_RAPPORTO CHAR(10) CHARACTER SET LATIN NOT CASESPECIFIC ,              --REX 18-03-2015
      NR_CARTA CHAR(16) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      CD_SOTTOTIPO_CARTA_LG  BYTEINT   ,
      CD_STATO_CARTA_LG BYTEINT   ,
      DT_RICHIESTA_LG BYTEINT   ,
      DT_ESTINZIONE_LG BYTEINT   ,
      DT_SCADENZA_LG BYTEINT   ,
      FLG_RINNOVO_LG BYTEINT   ,
      FLG_SPEDIZIONE_LG BYTEINT   ,
      NR_VECCHIA_CARTA_LG BYTEINT   ,
      DT_STATO_CARTA_LG BYTEINT   ,
      NR_CARTA_ANONIMA_LG BYTEINT   ,
      FLG_CIRCUITO_LG BYTEINT   ,
      FLG_TIPO_SOGGETTO_LG BYTEINT   ,
      ID_PRATICA_LG BYTEINT   ,
      FLG_ESTINZIONE_LG BYTEINT,
      DT_EMISSIONE_LG BYTEINT,
      FLG_CARTA_AGGIUNTIVA_LG BYTEINT,
      RELEASE_PRODOTTO_LG BYTEINT,
      FLG_PIATTAFORMA_APPARTENENZ_LG BYTEINT,
      DT_SOSTITUZIONE_LG BYTEINT,
      ID_PROCESSO BIGINT NOT NULL,
 	ID_SOTTOPROCESSO INTEGER NOT  NULL,
      CD_SCARTO INTEGER NOT NULL 
      )
UNIQUE PRIMARY INDEX ( NR_CARTA,ID_PROCESSO,ID_SOTTOPROCESSO,CD_SCARTO )
ON COMMIT PRESERVE ROWS;


.IF ERRORLEVEL > 0 THEN .GOTO FINE; 



-- SCARTI 5
/*
INSERT INTO VTB_CARTE_SCARTI_LOGICI
(
SK_RAPPORTO,                --REX 18-03-2015
TIPO_RAPPORTO,              --REX 18-03-2015
NR_CARTA ,
 DT_SCADENZA_LG ,
 FLG_RINNOVO_LG ,
 FLG_SPEDIZIONE_LG ,
 FLG_CIRCUITO_LG ,
 FLG_TIPO_SOGGETTO_LG ,
 FLG_ESTINZIONE_LG ,
 FLG_CARTA_AGGIUNTIVA_LG ,
 RELEASE_PRODOTTO_LG,
 FLG_PIATTAFORMA_APPARTENENZ_LG ,
 ID_PROCESSO ,
 ID_SOTTOPROCESSO,
 CD_SCARTO)


SELECT 
    SK_RAPPORTO,                --REX 18-03-2015
    TIPO_RAPPORTO,              --REX 18-03-2015
    NR_CARTA ,
    CASE WHEN DT_SCADENZA IS NULL THEN 1 ELSE 0 END AS DT_SCADENZA_LG , 
    CASE WHEN COALESCE(FLG_RINNOVO,'X') NOT IN ('0','1','2') THEN 1 ELSE 0 END AS FLG_RINNOVO_LG ,
    CASE WHEN COALESCE(FLG_SPEDIZIONE,'X') NOT IN ('0','U','R') THEN 1 ELSE 0 END AS  FLG_SPEDIZIONE_LG,
    CASE WHEN COALESCE(FLG_CIRCUITO,'X') NOT IN ('M','V') THEN 1 ELSE 0  END AS FLG_CIRCUITO_LG ,
    CASE WHEN COALESCE(FLG_TIPO_SOGGETTO,'A') NOT IN ('A','B','C') THEN 1 ELSE 0 END AS FLG_TIPO_SOGGETTO_LG ,
    CASE WHEN COALESCE(FLG_ESTINZIONE,'R') NOT IN ('R','N') THEN 1 ELSE 0 END AS FLG_ESTINZIONE ,
    CASE WHEN COALESCE(FLG_CARTA_AGGIUNTIVA,'N') NOT IN ('S','N') THEN 1 ELSE 0 END AS FLG_CARTA_AGGIUNTIVA ,
    CASE WHEN COALESCE(RELEASE_PRODOTTO,-1) <> 1 THEN 1 ELSE 0 END AS RELEASE_PRODOTTO_LG,
    CASE WHEN COALESCE(FLG_PIATTAFORMA_APPARTENENZA,'N') NOT IN ('N','O') THEN 1 ELSE 0 END AS FLG_PIATTAFORMA_APPARTENENZ_LG ,
    ID_PROCESSO ,
    ID_SOTTOPROCESSO,
    5 CD_SCARTO 
FROM VTB_ANAG_CARTA_STAG_NOVIOL_SK  --VTB_MON_CARTA_STAG_NO_VIOL_KEY
WHERE 
    DT_SCADENZA IS NULL 
   	OR COALESCE(FLG_RINNOVO,'X') NOT IN ('0','1','2')
 	OR COALESCE(FLG_SPEDIZIONE,'X') NOT IN ('0','U','R')
 	OR COALESCE(FLG_CIRCUITO,'X') NOT IN ('M','V')
 	OR COALESCE(FLG_TIPO_SOGGETTO,'A') NOT IN ('A','B','C')
 	OR COALESCE(FLG_ESTINZIONE,'R') NOT IN ('R','N')
 	OR COALESCE(FLG_CARTA_AGGIUNTIVA,'N') NOT IN ('S','N')
 	OR COALESCE(FLG_PIATTAFORMA_APPARTENENZA,'N') NOT IN ('N','O') 
 	OR COALESCE(RELEASE_PRODOTTO,-1) <> 1 
GROUP BY SK_RAPPORTO, TIPO_RAPPORTO, NR_CARTA, DT_SCADENZA_LG, FLG_RINNOVO_LG, FLG_SPEDIZIONE_LG, FLG_CIRCUITO_LG ,
         FLG_TIPO_SOGGETTO_LG, FLG_ESTINZIONE, FLG_CARTA_AGGIUNTIVA, RELEASE_PRODOTTO_LG, FLG_PIATTAFORMA_APPARTENENZ_LG,
         ID_PROCESSO, ID_SOTTOPROCESSO, CD_SCARTO;
*/ 			 
.IF ERRORLEVEL > 0 THEN .GOTO FINE; 


-- SCARTI 6
/*
INSERT INTO VTB_CARTE_SCARTI_LOGICI
(
 SK_RAPPORTO,               --REX 18-03-2015
 TIPO_RAPPORTO,             --REX 18-03-2015
 NR_CARTA ,
 CD_SOTTOTIPO_CARTA_LG,
 CD_STATO_CARTA_LG ,
 DT_RICHIESTA_LG ,
 DT_ESTINZIONE_LG ,
 DT_EMISSIONE_LG,
 NR_CARTA_ANONIMA_LG,
 FLG_RINNOVO_LG ,
 ID_PRATICA_LG,
 DT_STATO_CARTA_LG ,
 NR_VECCHIA_CARTA_LG ,
 DT_SOSTITUZIONE_LG,
 ID_PROCESSO ,
 ID_SOTTOPROCESSO,   
 CD_SCARTO)
 
SELECT 
    SK_RAPPORTO,    --REX 18-03-2015
    TIPO_RAPPORTO,  --REX 18-03-2015
    NR_CARTA ,
    CASE WHEN CD_SOTTOTIPO_CARTA = '33' AND  NR_CARTA_ANONIMA IS NULL THEN 1 
         WHEN CD_SOTTOTIPO_CARTA = '82' AND ID_PRATICA IS NULL THEN 1
         ELSE 0 END AS CD_SOTTOTIPO_CARTA_LG,
    CASE WHEN CD_STATO_CARTA ='E' AND DT_ESTINZIONE IS NULL THEN 1 
 	     WHEN DT_ESTINZIONE IS NOT NULL AND CD_STATO_CARTA  <> 'E' THEN 1
         ELSE 0 END AS CD_STATO_CARTA_LG,
    CASE WHEN DT_STATO_CARTA < DT_RICHIESTA THEN 1
 		 WHEN DT_RICHIESTA > DT_EMISSIONE THEN 1
         ELSE 0 END AS DT_RICHIESTA_LG ,
    CASE WHEN CD_STATO_CARTA ='E' AND DT_ESTINZIONE IS NULL THEN 1 
 		 WHEN DT_ESTINZIONE IS NOT NULL AND CD_STATO_CARTA  <> 'E' THEN 1
         ELSE 0 END AS DT_ESTINZIONE_LG,
    CASE WHEN DT_RICHIESTA > DT_EMISSIONE THEN 1 ELSE 0 END AS DT_EMISSIONE_LG,
    CASE WHEN CD_SOTTOTIPO_CARTA = '33' AND  NR_CARTA_ANONIMA IS NULL THEN 1 ELSE 0 END AS NR_CARTA_ANONIMA_LG,
    CASE WHEN FLG_RINNOVO ='1' AND NR_VECCHIA_CARTA IS NULL THEN 1 
 		 WHEN NR_VECCHIA_CARTA IS NOT NULL AND FLG_RINNOVO ='0' THEN 1 
         ELSE 0 END AS FLG_RINNOVO_LG,
    CASE WHEN CD_SOTTOTIPO_CARTA = '82' AND ID_PRATICA IS NULL THEN 1
 		 ELSE 0 END AS ID_PRATICA_LG,
    CASE WHEN DT_STATO_CARTA < DT_RICHIESTA  THEN 1 ELSE 0 END AS DT_STATO_CARTA_LG ,
    CASE WHEN FLG_RINNOVO ='1' AND NR_VECCHIA_CARTA IS NULL THEN 1 
 		 WHEN NR_VECCHIA_CARTA IS NOT NULL AND FLG_RINNOVO ='0' THEN 1
 		 ELSE 0 END AS NR_VECCHIA_CARTA_LG,
    CASE WHEN DT_SOSTITUZIONE IS NOT NULL AND FLG_RINNOVO <> '2' THEN 1
 		 ELSE 0 END AS DT_SOSTITUZIONE_LG,
 ID_PROCESSO  ,
 ID_SOTTOPROCESSO,
 6 CD_SCARTO 
 FROM VTB_ANAG_CARTA_STAG_NOVIOL_SK  --VTB_MON_CARTA_STAG_NO_VIOL_KEY
 WHERE (CD_STATO_CARTA ='E' AND DT_ESTINZIONE IS NULL)
 		OR (DT_ESTINZIONE IS NOT NULL AND CD_STATO_CARTA  <> 'E') 
 		OR (FLG_RINNOVO ='1' AND NR_VECCHIA_CARTA IS NULL)
 		OR (NR_VECCHIA_CARTA IS NOT NULL AND FLG_RINNOVO ='0') 
 		OR (DT_STATO_CARTA < DT_RICHIESTA )
 		OR (CD_SOTTOTIPO_CARTA = '33' AND  NR_CARTA_ANONIMA IS NULL)
 		OR (CD_SOTTOTIPO_CARTA = '82' AND ID_PRATICA IS NULL)
 		OR (DT_RICHIESTA > DT_EMISSIONE)
        OR (DT_SOSTITUZIONE IS NOT NULL AND FLG_RINNOVO <> '2')
GROUP BY SK_RAPPORTO, TIPO_RAPPORTO,  NR_CARTA, CD_SOTTOTIPO_CARTA_LG, CD_STATO_CARTA_LG, DT_RICHIESTA_LG , DT_ESTINZIONE_LG, 
                       DT_EMISSIONE_LG, NR_CARTA_ANONIMA_LG, FLG_RINNOVO_LG, ID_PRATICA_LG, DT_STATO_CARTA_LG , NR_VECCHIA_CARTA_LG,  DT_SOSTITUZIONE_LG,
                       ID_PROCESSO, ID_SOTTOPROCESSO, CD_SCARTO;
*/ 			 
.IF ERRORLEVEL > 0 THEN .GOTO FINE; 


CALL EDW_DW_MONITORAGGIO.EGBP_UPD_MONIT_PROCESSO_GTT('40','MON_ANAGRCARTA_ST','EDW_DW_BP', 'NR_REC_SCARTO_LOGICO','VTB_CARTE_SCARTI_LOGICI',S,S);


.IF ERRORCODE > 0 THEN .GOTO FINE; 


CREATE VOLATILE TABLE VTB_CARTE_SCARTI_FISICI AS
(SELECT * FROM VTB_MON_ANAGCARTA_VIOL_KEY WHERE CD_SCARTO = 7)
WITH DATA PRIMARY INDEX (NR_CARTA)
ON COMMIT PRESERVE ROWS;

.IF ERRORLEVEL > 0 THEN .GOTO FINE; 

CALL EDW_DW_MONITORAGGIO.EGBP_UPD_MONIT_PROCESSO_GTT('50','MON_ANAGRCARTA_ST','EDW_DW_BP', 'NR_REC_SCARTO_FISICO','VTB_CARTE_SCARTI_FISICI',S,S);

.IF ERRORCODE > 0 THEN .GOTO FINE; 

/* INDIVIDUIAMO TUTTI I RECORD CHE SONO OGGETTO DI STORICIZZAZIONE PER APPLICARE L'ALGORITMO AD UN SOLO SET DI DATI E AGGIUNGIAMO LA VERSIONE PER AGEVOLARE I CONFRONTI TRA RECORD */

CREATE VOLATILE TABLE VTB_MON_ANAGCARTA_ST_TMP AS
(
SELECT
   ANAGR_CARTA.*,
   ROW_NUMBER() OVER (PARTITION BY ANAGR_CARTA.SK_RAPPORTO  ORDER BY ANAGR_CARTA.DT_INI_VAL) AS VERSIONE

FROM
  (
   SELECT
        ANAGRCARTA_PRIMARIO.SK_RAPPORTO,
        ANAGRCARTA_PRIMARIO.TIPO_RAPPORTO, 
        ANAGRCARTA_PRIMARIO.NR_CARTA,               
	 	ANAGRCARTA_PRIMARIO.DT_INI_VAL,    	       
	 	ANAGRCARTA_PRIMARIO.DT_FIN_VAL,
		ANAGRCARTA_PRIMARIO.CD_TIPO_CARTA,                 
		ANAGRCARTA_PRIMARIO.CD_SOTTOTIPO_CARTA,            
		ANAGRCARTA_PRIMARIO.CD_FRAZ,                       
		ANAGRCARTA_PRIMARIO.CD_FISCALE,                    
		ANAGRCARTA_PRIMARIO.CD_STATO_CARTA,                
		ANAGRCARTA_PRIMARIO.DT_RICHIESTA,                  
		ANAGRCARTA_PRIMARIO.DT_ASSEGNAZIONE,             
		ANAGRCARTA_PRIMARIO.DT_ATTIVAZIONE,              
		ANAGRCARTA_PRIMARIO.DT_ESTINZIONE,               
		ANAGRCARTA_PRIMARIO.DT_SCADENZA,                 
		ANAGRCARTA_PRIMARIO.DT_BLOCCO,                   
		ANAGRCARTA_PRIMARIO.DT_SBLOCCO,                  
		ANAGRCARTA_PRIMARIO.NDG_AZIENDA,                 
		ANAGRCARTA_PRIMARIO.IM_TAGLIO,                   
		ANAGRCARTA_PRIMARIO.FLG_RINNOVO,                 
		ANAGRCARTA_PRIMARIO.FLG_SPEDIZIONE,              
		ANAGRCARTA_PRIMARIO.NR_VECCHIA_CARTA,            
		ANAGRCARTA_PRIMARIO.DT_STATO_CARTA,              
		ANAGRCARTA_PRIMARIO.NR_CARTA_ANONIMA,            
		ANAGRCARTA_PRIMARIO.NR_CARTA_NEW_OLD ,           
		ANAGRCARTA_PRIMARIO.FLG_CIRCUITO,                
		ANAGRCARTA_PRIMARIO.FLG_TIPO_SOGGETTO,           
		ANAGRCARTA_PRIMARIO.CD_IBAN,                     
		ANAGRCARTA_PRIMARIO.CD_BARRE,                    
		ANAGRCARTA_PRIMARIO.ID_PRATICA,                  
		ANAGRCARTA_PRIMARIO.DS_AZIENDA ,                 
		ANAGRCARTA_PRIMARIO.UTENTE_ESTINZIONE,           
		ANAGRCARTA_PRIMARIO.CD_LOYALTY_ESTERNO,          
		ANAGRCARTA_PRIMARIO.ID_CLIENTE,                  
		ANAGRCARTA_PRIMARIO.NDG_TITOLARE,                
		ANAGRCARTA_PRIMARIO.IM_FIDO,                     
		ANAGRCARTA_PRIMARIO.FLG_ESTINZIONE,              
		ANAGRCARTA_PRIMARIO.DT_EMISSIONE,                
		ANAGRCARTA_PRIMARIO.DT_EVOLUZIONE,               
		ANAGRCARTA_PRIMARIO.FLG_CARTA_AGGIUNTIVA,        
		ANAGRCARTA_PRIMARIO.CD_PAN_APPL_POSTAMAT,          
		ANAGRCARTA_PRIMARIO.CD_PRODOTTO,                 
		ANAGRCARTA_PRIMARIO.RELEASE_PRODOTTO,            
		ANAGRCARTA_PRIMARIO.FLG_PIATTAFORMA_APPARTENENZA,
		ANAGRCARTA_PRIMARIO.ID_CARTA,      
		ANAGRCARTA_PRIMARIO.CD_CC,              
		ANAGRCARTA_PRIMARIO.CANALE,
		ANAGRCARTA_PRIMARIO.TIPO_RAPPORTO_REG,
    ANAGRCARTA_PRIMARIO.CANALE_ATTIVAZIONE,
    ANAGRCARTA_PRIMARIO.DT_RINNOVO,
    ANAGRCARTA_PRIMARIO.DT_SOSTITUZIONE,
    ANAGRCARTA_PRIMARIO.DT_SPEDIZIONE,
    ANAGRCARTA_PRIMARIO.CD_TRACC_SPEDIZ,
    ANAGRCARTA_PRIMARIO.ESITO_SPEDIZ,
    ANAGRCARTA_PRIMARIO.VETTORE_SPEDIZ,
    ANAGRCARTA_PRIMARIO.TIPO_SPEDIZ,
    ANAGRCARTA_PRIMARIO.FRAZ_OPERATIVO_UT,
    ANAGRCARTA_PRIMARIO.ID_SOGGETTO,
    ANAGRCARTA_PRIMARIO.CD_PAN_SEC_TRACCIA,
		ANAGRCARTA_PRIMARIO.FL_FITTIZIO AS FL_FITTIZIO,
		ANAGRCARTA_PRIMARIO.ID_PROCESSO ,
		ANAGRCARTA_PRIMARIO.ID_SOTTOPROCESSO,
        --RDC INSERITI UM DEL PRIMARIO
    ANAGRCARTA_PRIMARIO.ID_PROCESSO_UM ,
    ANAGRCARTA_PRIMARIO.ID_SOTTOPROCESSO_UM,
		STAGING.ID_FILE
        
    FROM EDW_DW_BP.MON_ANAGRCARTA_ST ANAGRCARTA_PRIMARIO
    INNER JOIN VTB_ANAGCARTA_STG_SK STAGING
       ON STAGING.SK_RAPPORTO = ANAGRCARTA_PRIMARIO.SK_RAPPORTO
       
    UNION

    SELECT
    	ANAGRCARTA.SK_RAPPORTO,
        ANAGRCARTA.TIPO_RAPPORTO,
        ANAGRCARTA.NR_CARTA,               
        ANAGRCARTA.DT_INI_VAL,    	       
	 	CAST(NULL AS DATE) AS DT_FIN_VAL,
		ANAGRCARTA.CD_TIPO_CARTA,                 
		ANAGRCARTA.CD_SOTTOTIPO_CARTA,            
		ANAGRCARTA.CD_FRAZ,                       
		ANAGRCARTA.CD_FISCALE,                    
		ANAGRCARTA.CD_STATO_CARTA,                
		ANAGRCARTA.DT_RICHIESTA,                  
		ANAGRCARTA.DT_ASSEGNAZIONE,             
		ANAGRCARTA.DT_ATTIVAZIONE,              
		ANAGRCARTA.DT_ESTINZIONE,               
		ANAGRCARTA.DT_SCADENZA,                 
		ANAGRCARTA.DT_BLOCCO,                   
		ANAGRCARTA.DT_SBLOCCO,                  
		ANAGRCARTA.NDG_AZIENDA,                 
		ANAGRCARTA.IM_TAGLIO,                   
		ANAGRCARTA.FLG_RINNOVO,                 
		ANAGRCARTA.FLG_SPEDIZIONE,              
		ANAGRCARTA.NR_VECCHIA_CARTA,            
		ANAGRCARTA.DT_STATO_CARTA,              
		ANAGRCARTA.NR_CARTA_ANONIMA,            
		ANAGRCARTA.NR_CARTA_NEW_OLD ,           
		ANAGRCARTA.FLG_CIRCUITO,                
		ANAGRCARTA.FLG_TIPO_SOGGETTO,           
		ANAGRCARTA.CD_IBAN,                     
		ANAGRCARTA.CD_BARRE,                    
		ANAGRCARTA.ID_PRATICA,                  
		ANAGRCARTA.DS_AZIENDA ,                 
		ANAGRCARTA.UTENTE_ESTINZIONE,           
		ANAGRCARTA.CD_LOYALTY_ESTERNO,          
		ANAGRCARTA.ID_CLIENTE,                  
		ANAGRCARTA.NDG_TITOLARE,                
		ANAGRCARTA.IM_FIDO,                     
		ANAGRCARTA.FLG_ESTINZIONE,              
		ANAGRCARTA.DT_EMISSIONE,                
		ANAGRCARTA.DT_EVOLUZIONE,               
		ANAGRCARTA.FLG_CARTA_AGGIUNTIVA,        
		ANAGRCARTA.CD_PAN_APPL_POSTAMAT,          
		ANAGRCARTA.CD_PRODOTTO,                 
		ANAGRCARTA.RELEASE_PRODOTTO,            
		ANAGRCARTA.FLG_PIATTAFORMA_APPARTENENZA,
		ANAGRCARTA.ID_CARTA,             
		ANAGRCARTA.CD_CC,              
		ANAGRCARTA.CANALE,
		ANAGRCARTA.TIPO_RAPPORTO_REG,
    ANAGRCARTA.CANALE_ATTIVAZIONE,
    ANAGRCARTA.DT_RINNOVO,
    ANAGRCARTA.DT_SOSTITUZIONE,
    ANAGRCARTA.DT_SPEDIZIONE,
    ANAGRCARTA.CD_TRACC_SPEDIZ,
    ANAGRCARTA.ESITO_SPEDIZ,
    ANAGRCARTA.VETTORE_SPEDIZ,
    ANAGRCARTA.TIPO_SPEDIZ,
    ANAGRCARTA.FRAZ_OPERATIVO_UT,     
    ANAGRCARTA.ID_SOGGETTO,
    ANAGRCARTA.CD_PAN_SEC_TRACCIA,
		0 AS FL_FITTIZIO,
		ANAGRCARTA.ID_PROCESSO ,
		ANAGRCARTA.ID_SOTTOPROCESSO,
        --RDC INSERITI CAMPI UM
    ANAGRCARTA.ID_PROCESSO AS ID_PROCESSO_UM ,
    ANAGRCARTA.ID_SOTTOPROCESSO AS ID_SOTTOPROCESSO_UM,
		ANAGRCARTA.ID_FILE
          
    FROM VTB_ANAGCARTA_STG_SK ANAGRCARTA
    		 
   ) ANAGR_CARTA
)
WITH DATA PRIMARY INDEX (SK_RAPPORTO)
ON COMMIT PRESERVE ROWS;


.IF ERRORLEVEL > 0 THEN .GOTO FINE; 

COLLECT STATISTICS ON VTB_MON_ANAGCARTA_ST_TMP INDEX(SK_RAPPORTO);
COLLECT STATISTICS ON VTB_MON_ANAGCARTA_ST_TMP COLUMN(VERSIONE);

.IF ERRORLEVEL > 0 THEN .GOTO FINE; 

/* ALGORITMO DI STORICIZZAZIONE CHE PERMETTE DI VALORIZZARE COERENTEMENTE LE DT_FIN_VAL E DI STORICIZZARE SOLO SE EFFETTIVAMENTE E' VARIATO ALMENO UN ATTRIBUTO */

--CREATE VOLATILE TABLE VTB_ANAGCARTA_ST AS (SEL A.*, CAST(0 AS BIGINT) AS ID_FILE FROM EDW_DW_BP.MON_ANAGRCARTA_ST A) WITH NO DATA ON COMMIT PRESERVE ROWS;
CREATE VOLATILE TABLE VTB_ANAGCARTA_ST AS EDW_DW_BP.MON_ANAGRCARTA_ST WITH NO DATA ON COMMIT PRESERVE ROWS;


.IF ERRORLEVEL > 0 THEN .GOTO FINE; 

INSERT INTO VTB_ANAGCARTA_ST
SELECT 
	ANAGR_CARTA_STAG.SK_RAPPORTO ,
    ANAGR_CARTA_STAG.TIPO_RAPPORTO,
	ANAGR_CARTA_STAG.DT_INI_VAL ,
	CASE WHEN COALESCE(MAX(ANAGR_CARTA_STAG.DT_INI_VAL)  OVER (PARTITION BY ANAGR_CARTA_STAG.SK_RAPPORTO
  	  	  ORDER BY ANAGR_CARTA_STAG.DT_INI_VAL ROWS BETWEEN 1 FOLLOWING AND 1 FOLLOWING) - 1, DATE '2999-12-31') < ANAGR_CARTA_STAG.DT_INI_VAL  THEN ANAGR_CARTA_STAG.DT_INI_VAL 
  	  ELSE COALESCE(MAX(ANAGR_CARTA_STAG.DT_INI_VAL)  OVER (PARTITION BY ANAGR_CARTA_STAG.SK_RAPPORTO
  	    ORDER BY ANAGR_CARTA_STAG.DT_INI_VAL ROWS BETWEEN 1 FOLLOWING AND 1 FOLLOWING) - 1, DATE '2999-12-31') END AS DT_FIN_VAL,
  	ANAGR_CARTA_STAG.NR_CARTA ,
    ANAGR_CARTA_STAG.CD_TIPO_CARTA ,
    ANAGR_CARTA_STAG.CD_SOTTOTIPO_CARTA ,
    ANAGR_CARTA_STAG.TIPO_RAPPORTO_REG ,
    ANAGR_CARTA_STAG.CD_FRAZ ,
    ANAGR_CARTA_STAG.CD_FISCALE ,
    ANAGR_CARTA_STAG.CD_STATO_CARTA ,
    ANAGR_CARTA_STAG.DT_RICHIESTA ,
    ANAGR_CARTA_STAG.DT_ASSEGNAZIONE ,
    ANAGR_CARTA_STAG.DT_ATTIVAZIONE ,
    ANAGR_CARTA_STAG.DT_ESTINZIONE ,
    ANAGR_CARTA_STAG.DT_SCADENZA ,
    ANAGR_CARTA_STAG.DT_BLOCCO ,
    ANAGR_CARTA_STAG.DT_SBLOCCO ,
    ANAGR_CARTA_STAG.NDG_AZIENDA ,
    ANAGR_CARTA_STAG.IM_TAGLIO ,
    ANAGR_CARTA_STAG.FLG_RINNOVO ,
    ANAGR_CARTA_STAG.FLG_SPEDIZIONE ,
    ANAGR_CARTA_STAG.NR_VECCHIA_CARTA ,
    ANAGR_CARTA_STAG.DT_STATO_CARTA ,
    ANAGR_CARTA_STAG.NR_CARTA_ANONIMA ,
    ANAGR_CARTA_STAG.NR_CARTA_NEW_OLD ,
    ANAGR_CARTA_STAG.FLG_CIRCUITO ,
    ANAGR_CARTA_STAG.FLG_TIPO_SOGGETTO ,
    ANAGR_CARTA_STAG.CD_IBAN ,
    ANAGR_CARTA_STAG.CD_BARRE ,
    ANAGR_CARTA_STAG.ID_PRATICA ,
    ANAGR_CARTA_STAG.DS_AZIENDA ,
    ANAGR_CARTA_STAG.UTENTE_ESTINZIONE ,
    ANAGR_CARTA_STAG.CD_LOYALTY_ESTERNO ,
    ANAGR_CARTA_STAG.ID_CLIENTE ,
    ANAGR_CARTA_STAG.NDG_TITOLARE ,
    ANAGR_CARTA_STAG.IM_FIDO ,
    ANAGR_CARTA_STAG.FLG_ESTINZIONE ,
    ANAGR_CARTA_STAG.DT_EMISSIONE ,
    ANAGR_CARTA_STAG.DT_EVOLUZIONE ,
    ANAGR_CARTA_STAG.FLG_CARTA_AGGIUNTIVA ,
    ANAGR_CARTA_STAG.CD_PAN_APPL_POSTAMAT ,
    ANAGR_CARTA_STAG.CD_PRODOTTO ,
    ANAGR_CARTA_STAG.RELEASE_PRODOTTO ,
    ANAGR_CARTA_STAG.FLG_PIATTAFORMA_APPARTENENZA ,
    ANAGR_CARTA_STAG.ID_CARTA ,
    ANAGR_CARTA_STAG.CD_CC ,
    ANAGR_CARTA_STAG.CANALE ,
    ANAGR_CARTA_STAG.CANALE_ATTIVAZIONE,
    ANAGR_CARTA_STAG.DT_RINNOVO,
    ANAGR_CARTA_STAG.DT_SOSTITUZIONE,
    ANAGR_CARTA_STAG.DT_SPEDIZIONE,
    ANAGR_CARTA_STAG.CD_TRACC_SPEDIZ,
    ANAGR_CARTA_STAG.ESITO_SPEDIZ,
    ANAGR_CARTA_STAG.VETTORE_SPEDIZ,
    ANAGR_CARTA_STAG.TIPO_SPEDIZ,
    ANAGR_CARTA_STAG.FRAZ_OPERATIVO_UT,
    ANAGR_CARTA_STAG.ID_SOGGETTO,
    ANAGR_CARTA_STAG.CD_PAN_SEC_TRACCIA,
    ANAGR_CARTA_STAG.FL_FITTIZIO ,
    ANAGR_CARTA_STAG.ID_PROCESSO ,
 	ANAGR_CARTA_STAG.ID_SOTTOPROCESSO ,
 	--RDC
    ANAGR_CARTA_STAG.ID_PROCESSO_UM,
 	ANAGR_CARTA_STAG.ID_SOTTOPROCESSO_UM
    --ANAGR_CARTA_STAG.ID_FILE
  	  	 
FROM VTB_MON_ANAGCARTA_ST_TMP	 ANAGR_CARTA_STAG

LEFT OUTER JOIN VTB_MON_ANAGCARTA_ST_TMP	 ANAGR_CARTA_PREC
	  ON ANAGR_CARTA_STAG.SK_RAPPORTO = ANAGR_CARTA_PREC.SK_RAPPORTO
	AND ANAGR_CARTA_STAG.VERSIONE = ANAGR_CARTA_PREC.VERSIONE + 1

WHERE
         COALESCE(ANAGR_CARTA_STAG.CD_TIPO_CARTA ,'$') <> COALESCE(ANAGR_CARTA_PREC.CD_TIPO_CARTA ,'$')
      OR COALESCE(ANAGR_CARTA_STAG.CD_SOTTOTIPO_CARTA ,'$') <> COALESCE(ANAGR_CARTA_PREC.CD_SOTTOTIPO_CARTA ,'$')
      OR COALESCE(ANAGR_CARTA_STAG.TIPO_RAPPORTO_REG ,'$') <> COALESCE(ANAGR_CARTA_PREC.TIPO_RAPPORTO_REG ,'$') 
      OR COALESCE(ANAGR_CARTA_STAG.CD_FRAZ ,'$') <> COALESCE(ANAGR_CARTA_PREC.CD_FRAZ ,'$')
      OR COALESCE(ANAGR_CARTA_STAG.CD_FISCALE ,'$') <> COALESCE(ANAGR_CARTA_PREC.CD_FISCALE ,'$')
      OR COALESCE(ANAGR_CARTA_STAG.CD_STATO_CARTA ,'$') <> COALESCE(ANAGR_CARTA_PREC.CD_STATO_CARTA,'$')
      OR COALESCE(ANAGR_CARTA_STAG.DT_RICHIESTA,DATE '0001-01-01') <> COALESCE(ANAGR_CARTA_PREC.DT_RICHIESTA,DATE '0001-01-01')
      OR COALESCE(ANAGR_CARTA_STAG.DT_ASSEGNAZIONE,DATE '0001-01-01') <> COALESCE(ANAGR_CARTA_PREC.DT_ASSEGNAZIONE,DATE '0001-01-01')
      OR COALESCE(ANAGR_CARTA_STAG.DT_ATTIVAZIONE,DATE '0001-01-01')  <> COALESCE(ANAGR_CARTA_PREC.DT_ATTIVAZIONE,DATE '0001-01-01')
      OR COALESCE(ANAGR_CARTA_STAG.DT_ESTINZIONE,DATE '0001-01-01') <> COALESCE(ANAGR_CARTA_PREC.DT_ESTINZIONE,DATE '0001-01-01')
      -- OR COALESCE(ANAGR_CARTA_STAG.DT_SCADENZA,DATE '2999-12-31') <> COALESCE(ANAGR_CARTA_PREC.DT_SCADENZA, DATE '2999-12-31') -- SE SI VERIFICA È SCARTO
      OR COALESCE(ANAGR_CARTA_STAG.DT_BLOCCO,DATE '0001-01-01')   <> COALESCE(ANAGR_CARTA_PREC.DT_BLOCCO,DATE '0001-01-01')
      OR COALESCE(ANAGR_CARTA_STAG.DT_SBLOCCO,DATE '0001-01-01')  <> COALESCE(ANAGR_CARTA_PREC.DT_SBLOCCO,DATE '0001-01-01')
      OR COALESCE(ANAGR_CARTA_STAG.NDG_AZIENDA ,'$') <> COALESCE(ANAGR_CARTA_PREC.NDG_AZIENDA ,'$')
      OR COALESCE(ANAGR_CARTA_STAG.IM_TAGLIO ,-1) <> COALESCE(ANAGR_CARTA_PREC.IM_TAGLIO ,-1)
      OR COALESCE(ANAGR_CARTA_STAG.FLG_RINNOVO ,'$') <> COALESCE(ANAGR_CARTA_PREC.FLG_RINNOVO ,'$')
      OR COALESCE(ANAGR_CARTA_STAG.FLG_SPEDIZIONE ,'$') <> COALESCE(ANAGR_CARTA_PREC.FLG_SPEDIZIONE ,'$')
      OR COALESCE(ANAGR_CARTA_STAG.NR_VECCHIA_CARTA ,'$') <> COALESCE(ANAGR_CARTA_PREC.NR_VECCHIA_CARTA ,'$')
      OR COALESCE(ANAGR_CARTA_STAG.DT_STATO_CARTA, DATE '0001-01-01') <> COALESCE(ANAGR_CARTA_PREC.DT_STATO_CARTA, DATE '0001-01-01')
      OR COALESCE(ANAGR_CARTA_STAG.NR_CARTA_ANONIMA ,'$') <> COALESCE(ANAGR_CARTA_PREC.NR_CARTA_ANONIMA ,'$')
      OR COALESCE(ANAGR_CARTA_STAG.NR_CARTA_NEW_OLD ,'$') <> COALESCE(ANAGR_CARTA_PREC.NR_CARTA_NEW_OLD ,'$')
      OR COALESCE(ANAGR_CARTA_STAG.FLG_CIRCUITO ,'$') <> COALESCE(ANAGR_CARTA_PREC.FLG_CIRCUITO ,'$')
      OR COALESCE(ANAGR_CARTA_STAG.FLG_TIPO_SOGGETTO ,'$') <> COALESCE(ANAGR_CARTA_PREC.FLG_TIPO_SOGGETTO ,'$')
      OR COALESCE(ANAGR_CARTA_STAG.CD_IBAN , '$') <> COALESCE(ANAGR_CARTA_PREC.CD_IBAN , '$')
      OR COALESCE(ANAGR_CARTA_STAG.CD_BARRE ,'$') <> COALESCE(ANAGR_CARTA_PREC.CD_BARRE ,'$')
      OR COALESCE(ANAGR_CARTA_STAG.ID_PRATICA ,'$') <> COALESCE(ANAGR_CARTA_PREC.ID_PRATICA ,'$')
      OR COALESCE(ANAGR_CARTA_STAG.DS_AZIENDA ,'$') <> COALESCE(ANAGR_CARTA_PREC.DS_AZIENDA ,'$')
      OR COALESCE(ANAGR_CARTA_STAG.UTENTE_ESTINZIONE ,'$') <> COALESCE(ANAGR_CARTA_PREC.UTENTE_ESTINZIONE ,'$')
      OR COALESCE(ANAGR_CARTA_STAG.CD_LOYALTY_ESTERNO ,'$') <> COALESCE(ANAGR_CARTA_PREC.CD_LOYALTY_ESTERNO ,'$')
      OR COALESCE(ANAGR_CARTA_STAG.ID_CLIENTE ,'$') <> COALESCE(ANAGR_CARTA_PREC.ID_CLIENTE ,'$')
      OR COALESCE(ANAGR_CARTA_STAG.NDG_TITOLARE ,'$') <> COALESCE(ANAGR_CARTA_PREC.NDG_TITOLARE ,'$')
      OR COALESCE(ANAGR_CARTA_STAG.IM_FIDO ,-1) <> COALESCE(ANAGR_CARTA_PREC.IM_FIDO ,-1) 
      OR COALESCE(ANAGR_CARTA_STAG.FLG_ESTINZIONE ,'$') <> COALESCE(ANAGR_CARTA_PREC.FLG_ESTINZIONE ,'$') 
      OR COALESCE(ANAGR_CARTA_STAG.DT_EMISSIONE,DATE '0001-01-01')  <> COALESCE(ANAGR_CARTA_PREC.DT_EMISSIONE,DATE '0001-01-01')
      OR COALESCE(ANAGR_CARTA_STAG.DT_EVOLUZIONE,DATE '0001-01-01') <> COALESCE(ANAGR_CARTA_PREC.DT_EVOLUZIONE,DATE '0001-01-01')
      OR COALESCE(ANAGR_CARTA_STAG.FLG_CARTA_AGGIUNTIVA ,'$') <> COALESCE(ANAGR_CARTA_PREC.FLG_CARTA_AGGIUNTIVA ,'$')
      OR COALESCE(ANAGR_CARTA_STAG.CD_PAN_APPL_POSTAMAT ,'$') <> COALESCE(ANAGR_CARTA_PREC.CD_PAN_APPL_POSTAMAT ,'$')
      OR COALESCE(ANAGR_CARTA_STAG.CD_PRODOTTO ,'$') <> COALESCE(ANAGR_CARTA_PREC.CD_PRODOTTO ,'$')
      OR COALESCE(ANAGR_CARTA_STAG.RELEASE_PRODOTTO ,-99999) <> COALESCE(ANAGR_CARTA_PREC.RELEASE_PRODOTTO ,-99999)
      OR COALESCE(ANAGR_CARTA_STAG.FLG_PIATTAFORMA_APPARTENENZA ,'$') <> COALESCE(ANAGR_CARTA_PREC.FLG_PIATTAFORMA_APPARTENENZA ,'$')
      OR COALESCE(ANAGR_CARTA_STAG.ID_CARTA ,'$') <> COALESCE(ANAGR_CARTA_PREC.ID_CARTA ,'$')
      OR COALESCE(ANAGR_CARTA_STAG.CD_CC ,'$') <> COALESCE(ANAGR_CARTA_PREC.CD_CC ,'$')
      OR COALESCE(ANAGR_CARTA_STAG.CANALE ,'$') <> COALESCE(ANAGR_CARTA_PREC.CANALE ,'$')
      OR COALESCE(ANAGR_CARTA_STAG.NR_CARTA ,'$') <> COALESCE(ANAGR_CARTA_PREC.NR_CARTA ,'$')
      OR COALESCE(ANAGR_CARTA_STAG.CANALE_ATTIVAZIONE ,'$')           <> COALESCE(ANAGR_CARTA_PREC.CANALE_ATTIVAZIONE ,'$')
      OR COALESCE(ANAGR_CARTA_STAG.DT_RINNOVO,DATE '0001-01-01')      <> COALESCE(ANAGR_CARTA_PREC.DT_RINNOVO,DATE '0001-01-01')
      OR COALESCE(ANAGR_CARTA_STAG.DT_SOSTITUZIONE,DATE '0001-01-01') <> COALESCE(ANAGR_CARTA_PREC.DT_SOSTITUZIONE,DATE '0001-01-01')
      OR COALESCE(ANAGR_CARTA_STAG.DT_SPEDIZIONE,DATE '0001-01-01')   <> COALESCE(ANAGR_CARTA_PREC.DT_SPEDIZIONE,DATE '0001-01-01')
      OR COALESCE(ANAGR_CARTA_STAG.CD_TRACC_SPEDIZ ,'$')              <> COALESCE(ANAGR_CARTA_PREC.CD_TRACC_SPEDIZ ,'$')
      OR COALESCE(ANAGR_CARTA_STAG.ESITO_SPEDIZ ,'$')                 <> COALESCE(ANAGR_CARTA_PREC.ESITO_SPEDIZ ,'$')
      OR COALESCE(ANAGR_CARTA_STAG.VETTORE_SPEDIZ ,'$')               <> COALESCE(ANAGR_CARTA_PREC.VETTORE_SPEDIZ ,'$')
      OR COALESCE(ANAGR_CARTA_STAG.TIPO_SPEDIZ ,'$')                  <> COALESCE(ANAGR_CARTA_PREC.TIPO_SPEDIZ ,'$')
      OR COALESCE(ANAGR_CARTA_STAG.FRAZ_OPERATIVO_UT ,'$')            <> COALESCE(ANAGR_CARTA_PREC.FRAZ_OPERATIVO_UT ,'$')
      OR COALESCE(ANAGR_CARTA_STAG.ID_SOGGETTO ,'$') <> COALESCE(ANAGR_CARTA_PREC.ID_SOGGETTO ,'$')
      OR COALESCE(ANAGR_CARTA_STAG.CD_PAN_SEC_TRACCIA ,'$') <> COALESCE(ANAGR_CARTA_PREC.CD_PAN_SEC_TRACCIA ,'$')
      ;

.IF ERRORLEVEL > 0 THEN .GOTO FINE; 


-- CREO LA VOLATILE PER EFFETTUARE OPPORTUNAMENTE LE STORICIZZAZIONI SULLA TABELLA EDW_DW_BP.MON_ANAG_CARTA_RAPPORTO

CREATE VOLATILE TABLE VTB_MON_RAPPCARTA_ST_TMP AS
(
SELECT
   ANAGR_CARTA.*,
   ROW_NUMBER() OVER (PARTITION BY ANAGR_CARTA.SK_RAPPORTO  ORDER BY ANAGR_CARTA.DT_INI_VAL) AS VERSIONE

FROM
  (
   SELECT
        CARTA_RAPP_PRIMARIO.NR_CARTA,
        CARTA_RAPP_PRIMARIO.DT_INI_VAL,    	       
	 	CARTA_RAPP_PRIMARIO.DT_FIN_VAL,
	 	CARTA_RAPP_PRIMARIO.SK_RAPPORTO,
		CARTA_RAPP_PRIMARIO.TIPO_RAPPORTO,
		CARTA_RAPP_PRIMARIO.CD_TIPO_CARTA,
		CARTA_RAPP_PRIMARIO.CD_PRODOTTO,
		CARTA_RAPP_PRIMARIO.RELEASE_PRODOTTO,
		CARTA_RAPP_PRIMARIO.FL_FITTIZIO ,
		CARTA_RAPP_PRIMARIO.ID_PROCESSO ,
		CARTA_RAPP_PRIMARIO.ID_SOTTOPROCESSO,
        --RDC INSERITI _UM DEL PRIMARIO
        CARTA_RAPP_PRIMARIO.ID_PROCESSO_UM ,
        CARTA_RAPP_PRIMARIO.ID_SOTTOPROCESSO_UM
		   
    FROM EDW_DW_BP.MON_ANAG_CARTA_RAPPORTO CARTA_RAPP_PRIMARIO
    INNER JOIN VTB_ANAGCARTA_STG_SK STAGING
       ON STAGING.SK_RAPPORTO = CARTA_RAPP_PRIMARIO.SK_RAPPORTO
       
    UNION
		
		SELECT
            STAGING.NR_CARTA,
            STAGING.DT_INI_VAL,    	       
	 		CAST(NULL AS DATE) AS DT_FIN_VAL,
	 		STAGING.SK_RAPPORTO,
            STAGING.TIPO_RAPPORTO,
            STAGING.CD_TIPO_CARTA,
            STAGING.CD_PRODOTTO,
            STAGING.RELEASE_PRODOTTO,
            0 AS FL_FITTIZIO,
            STAGING.ID_PROCESSO ,
            STAGING.ID_SOTTOPROCESSO,
            --RDC INSERITI CAMPI UM
            STAGING.ID_PROCESSO AS ID_PROCESSO_UM ,
            STAGING.ID_SOTTOPROCESSO AS ID_SOTTOPROCESSO_UM
        
    FROM VTB_ANAGCARTA_STG_SK STAGING 
    	 
   ) ANAGR_CARTA
)
WITH DATA PRIMARY INDEX (SK_RAPPORTO)
ON COMMIT PRESERVE ROWS;

.IF ERRORLEVEL > 0 THEN .GOTO FINE; 

COLLECT STATISTICS ON VTB_MON_RAPPCARTA_ST_TMP INDEX(SK_RAPPORTO) ;
COLLECT STATISTICS ON VTB_MON_RAPPCARTA_ST_TMP COLUMN(VERSIONE);

CREATE VOLATILE TABLE VTB_RAPPORTO_ST AS EDW_DW_BP.MON_ANAG_CARTA_RAPPORTO WITH NO DATA ON COMMIT PRESERVE ROWS;

.IF ERRORLEVEL > 0 THEN .GOTO FINE;

/*  - ANAG RAPPORTO - STORICIZZAZIONE DELLE SOLE VARIAZIONI DI CIASCUNA VERSIONE CON LA SUCCESSIVA  */
      
INSERT INTO VTB_RAPPORTO_ST
SELECT
        ANAG_STG.SK_RAPPORTO,
        ANAG_STG.TIPO_RAPPORTO,
        ANAG_STG.DT_INI_VAL,
      	CASE WHEN COALESCE(MAX(ANAG_STG.DT_INI_VAL)  OVER (PARTITION BY ANAG_STG.SK_RAPPORTO
  	  	  ORDER BY ANAG_STG.DT_INI_VAL ROWS BETWEEN 1 FOLLOWING AND 1 FOLLOWING) - 1, DATE '2999-12-31') < ANAG_STG.DT_INI_VAL  THEN ANAG_STG.DT_INI_VAL 
  	    ELSE COALESCE(MAX(ANAG_STG.DT_INI_VAL)  OVER (PARTITION BY ANAG_STG.SK_RAPPORTO
  	    ORDER BY ANAG_STG.DT_INI_VAL ROWS BETWEEN 1 FOLLOWING AND 1 FOLLOWING) - 1, DATE '2999-12-31') END AS DT_FIN_VAL,
  	    ANAG_STG.NR_CARTA, 
  	    ANAG_STG.CD_TIPO_CARTA,
		ANAG_STG.CD_PRODOTTO,
        ANAG_STG.RELEASE_PRODOTTO,
      	0 AS FL_FITTIZIO,
      	ANAG_STG.ID_PROCESSO,
      	ANAG_STG.ID_SOTTOPROCESSO,
        --RDC
      	ANAG_STG.ID_PROCESSO_UM,
      	ANAG_STG.ID_SOTTOPROCESSO_UM
  	  				
FROM VTB_MON_RAPPCARTA_ST_TMP ANAG_STG

LEFT OUTER JOIN VTB_MON_RAPPCARTA_ST_TMP ANAG_STG_PREC
   ON  ANAG_STG.SK_RAPPORTO = ANAG_STG_PREC.SK_RAPPORTO 	
   	AND ANAG_STG.VERSIONE = ANAG_STG_PREC.VERSIONE + 1
    
WHERE  
       COALESCE(ANAG_STG.CD_TIPO_CARTA  , '$')	    <> COALESCE(ANAG_STG_PREC.CD_TIPO_CARTA  , '$')    	
	OR COALESCE(ANAG_STG.CD_PRODOTTO  , '$')	    <> COALESCE(ANAG_STG_PREC.CD_PRODOTTO  , '$')    	
	OR COALESCE(ANAG_STG.RELEASE_PRODOTTO  ,-99999)	<> COALESCE(ANAG_STG_PREC.RELEASE_PRODOTTO  ,-99999);

.IF ERRORLEVEL > 0 THEN .GOTO FINE; 

/*
--INSERIMENTO PROCESSI PRINCIPALI E ACCESSORI

INSERT INTO EDW_DW_MONITORAGGIO.MONIT_FONTE_GTT
   (ID_SORGENTE, ID_DT_LINEAGE, ID_SOTTOPROCESSO, ID_PROCESSO) 
SELECT 
    ID_SORGENTE, ID_DT_LINEAGE, ID_SOTTOPROCESSO, ID_PROCESSO
FROM 
    VTB_PROCESSO_ANAGCARTA
UNION ALL
SELECT 
    ID_SORGENTE, ID_DT_LINEAGE, ID_SOTTOPROCESSO, ID_PROCESSO
FROM 
    VTB_CARTARAPPORTO_DELTA;


.IF ERRORLEVEL > 0 THEN .GOTO FINE; 
*/

--*************************************************
--***       FITTIZI PRODOTTO CARTA              ***
--*************************************************

CREATE VOLATILE TABLE VTB_FITTIZI_PROD_CARTA AS
(
    SELECT 
        A.CD_PRODOTTO,
	 	A.CD_TIPO_CARTA,
	 	A.CD_SOTTOTIPO_CARTA,
	 	DATE '1900-01-01' AS DT_INI_VAL,
	 	DATE '2999-12-31' AS DT_FIN_VAL ,
	 	'*ND' AS DS_CARTA,
	 	'*ND' AS DS_PRODOTTO,
	 	A.ID_PROCESSO ,
	 	A.ID_SOTTOPROCESSO ,
	 	1 AS FL_FITTIZIO,
	 	A.ID_PROCESSO AS  ID_PROCESSO_UM,
	 	A.ID_SOTTOPROCESSO AS ID_SOTTOPROCESSO_UM
	FROM   VTB_MON_CARTA_STAG_NO_VIOL_KEY A
	 		
        LEFT JOIN EDW_DW_BP.MON_PRODOTTO_CARTA_ST C
        ON  C.CD_PRODOTTO = A.CD_PRODOTTO
            AND C.CD_TIPO_CARTA = A.CD_TIPO_CARTA
	 		AND C.CD_SOTTOTIPO_CARTA = A.CD_SOTTOTIPO_CARTA
    WHERE C.CD_PRODOTTO IS NULL
	AND A.CD_PRODOTTO IS NOT NULL
	QUALIFY ROW_NUMBER() OVER ( PARTITION BY A.CD_PRODOTTO,A.CD_TIPO_CARTA,A.CD_SOTTOTIPO_CARTA ORDER BY A.NOME_FILE) = 1
)
WITH DATA PRIMARY INDEX(CD_PRODOTTO,CD_TIPO_CARTA,CD_SOTTOTIPO_CARTA)

ON COMMIT PRESERVE ROWS;



.IF ERRORLEVEL > 0 THEN .GOTO FINE; 


--*************************************************
--***   FITTIZI TIPOLOGICA CANALE ATTIVAZIONE   ***
--***   SE <> DAI VALORI DELLA TIPOLOGICA       ***
--***   OPPURE È NULL                           ***
--*************************************************

CREATE VOLATILE TABLE VTB_FITTIZI_CAN_ATTIV AS
(
SELECT 
	A.CANALE_ATTIVAZIONE,
	DATE '1900-01-01' AS DT_INI_VAL,
	DATE '2999-12-31' AS DT_FIN_VAL ,
	A.ID_PROCESSO  ,
	A.ID_SOTTOPROCESSO,  
	1 AS FL_FITTIZIO,
	A.ID_PROCESSO AS ID_PROCESSO_UM,
	A.ID_SOTTOPROCESSO AS ID_SOTTOPROCESSO_UM
	 			
FROM   VTB_MON_CARTA_STAG_NO_VIOL_KEY A
	LEFT JOIN EDW_DW_BP.MON_CANALE_ANAGRCARTA_ST B
	ON COALESCE(A.CANALE_ATTIVAZIONE,'$') = COALESCE(B.CANALE_ATTIVAZIONE,'$')
WHERE B.ID_CANALE_ATTIVAZIONE IS NULL

QUALIFY ROW_NUMBER() OVER ( PARTITION BY A.CANALE_ATTIVAZIONE ORDER BY A.NOME_FILE) = 1 
)
WITH DATA PRIMARY INDEX(CANALE_ATTIVAZIONE)

ON COMMIT PRESERVE ROWS;



.IF ERRORLEVEL > 0 THEN .GOTO FINE; 


--*************************************************
--***    FITTIZI TIPOLOGICA ESITO SPEDIZIONE    ***
--***    IL NULL NON GENERA FITTIZIO            ***
--*************************************************

CREATE VOLATILE TABLE VTB_FITTIZI_ESITO_SPED AS
(
SELECT 
    A.ESITO_SPEDIZ,
    '*ND' AS DS_ESITO_SPEDIZ,
    DATE '1900-01-01' AS DT_INI_VAL,
	DATE '2999-12-31' AS DT_FIN_VAL,
	A.ID_PROCESSO  ,
	A.ID_SOTTOPROCESSO,  
	1 AS FL_FITTIZIO,
	A.ID_PROCESSO AS ID_PROCESSO_UM,
	A.ID_SOTTOPROCESSO AS ID_SOTTOPROCESSO_UM
	 			
FROM   VTB_MON_CARTA_STAG_NO_VIOL_KEY A
	LEFT JOIN EDW_DW_BP.MON_ESITOSPED_ANAGRCARTA_ST B
	ON COALESCE(A.ESITO_SPEDIZ,'$') = COALESCE(B.CD_ESITO_SPEDIZ,'$')
WHERE   B.CD_ESITO_SPEDIZ IS NULL
    AND A.ESITO_SPEDIZ IS NOT NULL
QUALIFY ROW_NUMBER() OVER ( PARTITION BY A.ESITO_SPEDIZ ORDER BY A.NOME_FILE) = 1 

)
WITH DATA PRIMARY INDEX(ESITO_SPEDIZ)
ON COMMIT PRESERVE ROWS;


.IF ERRORLEVEL > 0 THEN .GOTO FINE; 

/* 
**** RDC 23-03-2015 INIZIO UPDATE PER VALORIZZARE CORRETTAMENTE ID_PROCESSO E ID_SOTTOPROCESSO **** 
**** NELLA VTB GLI ID PROCESSO/SOTTOPROCESSO  E RELATIVI _UM SONO RIFERITI AL PRIMARIO (QUINDI ID ORIGINALI)
**** MENTRE I RECORD NUOVI DELLA STAGING HANNO TUTTI E 4 I CAMPI UGUALI CON I NUOVI ID
*/


UPDATE VTB_ANAGCARTA_ST
    FROM (
        SELECT 
            VTB_STORICIZZATA.SK_RAPPORTO            AS SK_RAPPORTO_UPD
           ,(VTB_STORICIZZATA.DT_INI_VAL - 1)       AS DT_FIN_VAL_UPD
           ,VTB_STORICIZZATA.ID_PROCESSO_UM         AS ID_PROCESSO_UM_UPD
		   ,VTB_STORICIZZATA.ID_SOTTOPROCESSO_UM    AS ID_SOTTOPROCESSO_UM_UPD
        FROM 
            VTB_ANAGCARTA_ST VTB_STORICIZZATA
        INNER JOIN (SELECT ID_PROCESSO FROM EDW_DW_MONITORAGGIO.MONIT_PROCESSO_GTT) AS DELTA_GTT ON 
            VTB_STORICIZZATA.ID_PROCESSO = DELTA_GTT.ID_PROCESSO
    ) DELTA
SET 
    ID_PROCESSO_UM          = DELTA.ID_PROCESSO_UM_UPD
	,ID_SOTTOPROCESSO_UM    = DELTA.ID_SOTTOPROCESSO_UM_UPD
WHERE 
    SK_RAPPORTO             = DELTA.SK_RAPPORTO_UPD
    AND DT_FIN_VAL          = DELTA.DT_FIN_VAL_UPD                
;  

.IF ERRORLEVEL > 0 THEN .GOTO FINE; 


UPDATE VTB_RAPPORTO_ST
    FROM (
        SELECT 
            VTB_STORICIZZATA.SK_RAPPORTO            AS SK_RAPPORTO_UPD
           ,(VTB_STORICIZZATA.DT_INI_VAL - 1)       AS DT_FIN_VAL_UPD
           ,VTB_STORICIZZATA.ID_PROCESSO_UM         AS ID_PROCESSO_UM_UPD
		   ,VTB_STORICIZZATA.ID_SOTTOPROCESSO_UM    AS ID_SOTTOPROCESSO_UM_UPD
        FROM 
            VTB_RAPPORTO_ST VTB_STORICIZZATA
        INNER JOIN (SELECT ID_PROCESSO FROM EDW_DW_MONITORAGGIO.MONIT_PROCESSO_GTT) AS DELTA_GTT ON 
            VTB_STORICIZZATA.ID_PROCESSO = DELTA_GTT.ID_PROCESSO
    ) DELTA
SET 
    ID_PROCESSO_UM          = DELTA.ID_PROCESSO_UM_UPD
	,ID_SOTTOPROCESSO_UM    = DELTA.ID_SOTTOPROCESSO_UM_UPD
WHERE 
    SK_RAPPORTO             = DELTA.SK_RAPPORTO_UPD
    AND DT_FIN_VAL          = DELTA.DT_FIN_VAL_UPD                
;  

.IF ERRORLEVEL > 0 THEN .GOTO FINE; 


CALL EDW_DW_MONITORAGGIO.EGBP_UPD_MONIT_PROCESSO_GTT('60','MON_ANAGRCARTA_ST','EDW_DW_BP', 'N','N',S,S);


.IF ERRORCODE > 0 THEN .GOTO FINE; 


