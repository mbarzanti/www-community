	 	DS_CARTA,
	 	DS_PRODOTTO,
	 	ID_PROCESSO ,
	 	ID_SOTTOPROCESSO ,
        FL_FITTIZIO,
	 	ID_PROCESSO_UM,
	 	ID_SOTTOPROCESSO_UM
	 FROM  VTB_FITTIZI_PROD_CARTA

 
 /* 6 INSERIMENTO FITTIZIO PER MON_CANALE_ANAGRCARTA_ST NON PRESENTI */
 
 
 ; INSERT INTO EDW_DW_BP.MON_CANALE_ANAGRCARTA_ST
	(CANALE_ATTIVAZIONE,
	 DT_INI_VAL,
	 DT_FIN_VAL,
	 ID_PROCESSO,
