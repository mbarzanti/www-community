    DT_ESTINZIONE               , DT_SCADENZA       , DT_BLOCCO             ,
    DT_SBLOCCO                  , NDG_AZIENDA       , IM_TAGLIO             ,
    FLG_RINNOVO                 , FLG_SPEDIZIONE    , NR_VECCHIA_CARTA      ,
    DT_STATO_CARTA              , NR_CARTA_ANONIMA  , NR_CARTA_NEW_OLD      ,
    FLG_CIRCUITO                , FLG_TIPO_SOGGETTO , CD_IBAN               ,
    CD_BARRE                    , ID_PRATICA        , DS_AZIENDA            ,
    UTENTE_ESTINZIONE           , CD_LOYALTY_ESTERNO, ID_CLIENTE            ,
    NDG_TITOLARE                , IM_FIDO           , FLG_ESTINZIONE        ,
    DT_EMISSIONE                , DT_EVOLUZIONE     , FLG_CARTA_AGGIUNTIVA  ,
    CD_PAN_APPL_POSTAMAT        , CD_PRODOTTO       , RELEASE_PRODOTTO      ,
    FLG_PIATTAFORMA_APPARTENENZA, ID_CARTA          , CD_CC                 ,
    CANALE                      , TIPO_RAPPORTO_REG , CANALE_ATTIVAZIONE    ,
    DT_RINNOVO                  , DT_SOSTITUZIONE   , DT_SPEDIZIONE         ,
    CD_TRACC_SPEDIZ             , ESITO_SPEDIZ      , VETTORE_SPEDIZ        ,
    TIPO_SPEDIZ                 , FRAZ_OPERATIVO_UT , ID_SOGGETTO						,     
    CD_PAN_SEC_TRACCIA					, ID_PROCESSO       ,
    ID_SOTTOPROCESSO            ,      
    CD_SCARTO                   ,
    DS_CAMPO_SCARTO
      
FROM VTB_MON_ANAGCARTA_VIOL_KEY


/* 4. POPOLAMENTO DELLA TABELLA CONTENENTE GLI SCARTI LOGICI */
; INSERT INTO EDW_DW_BP.MON_ANAGRCARTA_ST_SCRT_LG
 (
     SK_RAPPORTO  ,                                             
     TIPO_RAPPORTO  ,              
     NR_CARTA ,
     CD_SOTTOTIPO_CARTA_LG  ,
     CD_STATO_CARTA_LG   ,
     DT_RICHIESTA_LG    ,
     DT_ESTINZIONE_LG    ,
     DT_SCADENZA_LG  ,
     FLG_RINNOVO_LG  ,
     FLG_SPEDIZIONE_LG  ,
     NR_VECCHIA_CARTA_LG  ,
     DT_STATO_CARTA_LG  ,
     NR_CARTA_ANONIMA_LG  ,
     FLG_CIRCUITO_LG  ,
     FLG_TIPO_SOGGETTO_LG  ,
     ID_PRATICA_LG  ,
     FLG_ESTINZIONE_LG ,
     DT_EMISSIONE_LG ,
     FLG_CARTA_AGGIUNTIVA_LG ,
     RELEASE_PRODOTTO_LG ,
     FLG_PIATTAFORMA_APPARTENENZ_LG ,
     DT_SOSTITUZIONE_LG,
     ID_PROCESSO ,
     ID_SOTTOPROCESSO ,
     CD_SCARTO)
SELECT 
     SK_RAPPORTO  ,                                             
     TIPO_RAPPORTO  ,              
     NR_CARTA ,
     ZEROIFNULL(CD_SOTTOTIPO_CARTA_LG)  ,
     ZEROIFNULL(CD_STATO_CARTA_LG)   ,
     ZEROIFNULL(DT_RICHIESTA_LG)    ,
     ZEROIFNULL(DT_ESTINZIONE_LG)    ,
     ZEROIFNULL(DT_SCADENZA_LG)  ,
     ZEROIFNULL(FLG_RINNOVO_LG)  ,
     ZEROIFNULL(FLG_SPEDIZIONE_LG)  ,
     ZEROIFNULL(NR_VECCHIA_CARTA_LG)  ,
     ZEROIFNULL(DT_STATO_CARTA_LG)  ,
     ZEROIFNULL(NR_CARTA_ANONIMA_LG)  ,
     ZEROIFNULL(FLG_CIRCUITO_LG)  ,
     ZEROIFNULL(FLG_TIPO_SOGGETTO_LG)  ,
     ZEROIFNULL(ID_PRATICA_LG)  ,
     ZEROIFNULL(FLG_ESTINZIONE_LG) ,
     ZEROIFNULL(DT_EMISSIONE_LG) ,
     ZEROIFNULL(FLG_CARTA_AGGIUNTIVA_LG) ,
     ZEROIFNULL(RELEASE_PRODOTTO_LG) ,
     ZEROIFNULL(FLG_PIATTAFORMA_APPARTENENZ_LG) ,
     ZEROIFNULL(DT_SOSTITUZIONE_LG) ,
     ID_PROCESSO ,
     ID_SOTTOPROCESSO ,
     CD_SCARTO 
 FROM VTB_CARTE_SCARTI_LOGICI
 

/* 5 INSERIMENTO FITTIZIO PER MON_PRODOTTO_CARTA_ST NON PRESENTI */

; INSERT INTO EDW_DW_BP.MON_PRODOTTO_CARTA_ST
	(CD_PRODOTTO,
	 CD_TIPO_CARTA,
	 CD_SOTTOTIPO_CARTA,
	 DT_INI_VAL,
	 DT_FIN_VAL,
	 DS_TIPO_CARTA,
	 DS_PRODOTTO,
	 ID_PROCESSO,
	 ID_SOTTOPROCESSO,
	 FL_FITTIZIO,
	 ID_PROCESSO_UM,
	 ID_SOTTOPROCESSO_UM)
	 SELECT
        CD_PRODOTTO,
	 	CD_TIPO_CARTA,
	 	CD_SOTTOTIPO_CARTA,
	 	DT_INI_VAL,
