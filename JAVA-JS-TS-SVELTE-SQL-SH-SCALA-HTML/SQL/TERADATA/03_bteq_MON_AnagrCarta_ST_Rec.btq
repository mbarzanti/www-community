	 FROM  VTB_FITTIZI_ESITO_SPED

 
 
-- INSERIMENTO NELLA TABELLA _GTT
;INSERT INTO EDW_DW_MONITORAGGIO.MONIT_FONTE(ID_SORGENTE,ID_PROCESSO,ID_SOTTOPROCESSO,ID_DT_LINEAGE)
SELECT ID_SORGENTE,ID_PROCESSO,ID_SOTTOPROCESSO,ID_DT_LINEAGE
FROM EDW_DW_MONITORAGGIO.MONIT_FONTE_GTT

;UPDATE EDW_DW_MONITORAGGIO.MONIT_PROCESSO_GTT
SET 
    CD_ESITO='90'
  , NR_REC_SCARTO_FISICO = (SEL COUNT(0) FROM  VTB_MON_ANAGCARTA_VIOL_KEY)
  , NR_REC_SCARTO_LOGICO = (SEL COUNT(0) FROM  VTB_CARTE_SCARTI_LOGICI)
  , NR_REC_FITTIZI       = (SEL SUM(REC_FITTIZI.NR) FROM 
                                (SEL COUNT(0) AS NR FROM VTB_FITTIZI_PROD_CARTA
                                 UNION SEL COUNT(0) AS NR FROM VTB_FITTIZI_CAN_ATTIV
                                 UNION SEL COUNT(0) AS NR FROM VTB_FITTIZI_ESITO_SPED
                                ) REC_FITTIZI
                            )

  , NR_REC_CARICATI      = (SELECT COUNT(0) FROM  EDW_DW_BP.MON_ANAGRCARTA_ST A
                            INNER JOIN
                                (SELECT ID_PROCESSO FROM EDW_DW_MONITORAGGIO.MONIT_DELTA_GTT 
                                WHERE NM_OGGETTO_DEST = 'MON_ANAGRCARTA_ST'
                                AND   NM_POSIZIONE_DEST = 'EDW_DW_BP'
                                GROUP BY 1
                                ) B
                            ON A.ID_PROCESSO = B.ID_PROCESSO
                            )
WHERE NM_OGGETTO_DEST='MON_ANAGRCARTA_ST'
AND NM_POSIZIONE_DEST='EDW_DW_BP'


-- AGGIORNAMENTO FITTZIO
;UPDATE EDW_DW_MONITORAGGIO.MONIT_PROCESSO_GTT
    SET CD_ESITO = '90'
      , NR_REC_CARICATI = (SELECT COUNT(0) 
                             FROM EDW_DW_BP.MON_ANAG_CARTA_RAPPORTO A
                                  INNER JOIN EDW_DW_MONITORAGGIO.MONIT_PROCESSO_GTT  B
                                  ON A.ID_PROCESSO = B.ID_PROCESSO
                                  AND NM_OGGETTO_DEST   = 'MON_ANAG_CARTA_RAPPORTO'
                                  AND NM_POSIZIONE_DEST = 'EDW_DW_BP'
                           )
 WHERE NM_OGGETTO_DEST  = 'MON_ANAG_CARTA_RAPPORTO'
   AND NM_POSIZIONE_DEST='EDW_DW_BP'
   
   
   
;ET
;

.IF ERRORLEVEL > 0 THEN .GOTO FINE;

.LABEL QUALITA


-- STEP FINALI ESTERNI ALLA BTET

/* MONITORAGGIO: AGGIORNAMENTO MONIT_PROCESSO PARAMETRI INPUT: FL_FINE_ELAB  */

CALL EDW_DW_MONITORAGGIO.EGBP_UPD_MONIT_PROCESSO ('S', S, S);

.IF ERRORCODE > 0 THEN .GOTO FINE;

/* STEP STANDARD: COLLEZIONE STATISTICHE */

CALL  EDWH.COLLECTSTATS('EDW_DW_BP','MON_ANAGRCARTA_ST',S, C, ST );
CALL  EDWH.COLLECTSTATS('EDW_DW_BP','MON_ANAG_CARTA_RAPPORTO', S, C, ST );
CALL  EDWH.COLLECTSTATS('EDW_DW_BP','MON_CARTA_ASS_RAPPORTO', S, C, ST );
CALL  EDWH.COLLECTSTATS('EDW_DW_BP','MON_PRODOTTO_CARTA_ST',S, C, ST );
CALL  EDWH.COLLECTSTATS('EDW_DW_BP','MON_CANALE_ANAGRCARTA_ST',S, C, ST );
CALL  EDWH.COLLECTSTATS('EDW_DW_BP','MON_ESITOSPED_ANAGRCARTA_ST',S, C, ST );


.IF ERRORLEVEL > 0 THEN .GOTO FINE;

/* PROCEDURA SOGLIE SCARTO: QUESTA PROCEDURA VA RICHIAMATA  SE ESISTONO SCARTI FISICI/LOGICI */

CALL EDW_DW_MONITORAGGIO.EGBP_GESTIONE_SCARTI('EDW_DW_BP','MON_ANAGRCARTA_ST', S,S);

.IF ERRORCODE > 0 THEN .GOTO FINE;


/* MONITORAGGIO: LE SEGUENTI PROCEDURE TRASVERSALI A COMMENTO VERRANNO RICHIAMATE ALL'INTERNO DELLA PROCEDURA AD HOC 
PER IL CONTROLLO DELLA MEV IN QUESTO CASO VIENE UTILIZZATA UNA PROCEDURA D'ESEMPIO VUOTA (BR_TEST):  

--CALL EDW_DW_MONITORAGGIO.EGBP_BUSINESS_RULE ('BTEQ_MON_ANAGRCARTA_ST.BTQ','EDW_DW_BP','MON_ANAGRCARTA_ST','1','0',S,S);
*/
--CALL EDW_DW_MONITORAGGIO.BR_TEST (S,S);

--.IF ERRORCODE > 0 THEN .GOTO FINE;

/*MONITORAGGIO: AGGIORNAMENTO INDICATORE DI QUALITA ASSOCIATO AL KPI */

CALL EDW_DW_MONITORAGGIO.EGBP_KPI_PROPAGATOR ('EDW_DW_BP','MON_ANAGRCARTA_ST',S,S);
CALL EDW_DW_MONITORAGGIO.EGBP_KPI_PROPAGATOR ('EDW_DW_BP','MON_ANAG_CARTA_RAPPORTO',S,S);

.IF ERRORCODE > 0 THEN .GOTO FINE;


-- ETICHETTA FINE

/* MONITORAGGIO: AGGIORNAMENTO MONIT_PROCESSO

PARAMETRI INPUT: FL_FINE_ELAB  */


.LABEL FINE 

CALL EDW_DW_MONITORAGGIO.EGBP_UPD_MONIT_PROCESSO ('N',S,S);

.IF ERRORCODE > 0 THEN .QUIT 16; 
 

