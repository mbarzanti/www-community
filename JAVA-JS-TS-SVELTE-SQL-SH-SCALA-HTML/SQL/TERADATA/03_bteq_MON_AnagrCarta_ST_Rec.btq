 /* 7 INSERIMENTO FITTIZIO PER MON_ESITOSPED_ANAGRCARTA_ST NON PRESENTI */
 
  ; INSERT INTO EDW_DW_BP.MON_ESITOSPED_ANAGRCARTA_ST
	(CD_ESITO_SPEDIZ,
     DS_ESITO_SPEDIZ,
	 DT_INI_VAL,
	 DT_FIN_VAL,
