;INSERT INTO EDW_DW_BP.MON_ANAGRCARTA_ST_SCRT_FS
SELECT 
    NR_CARTA                    , CD_TIPO_CARTA     , CD_SOTTOTIPO_CARTA    ,
    CD_FRAZ                     , CD_FISCALE        , CD_STATO_CARTA        ,
