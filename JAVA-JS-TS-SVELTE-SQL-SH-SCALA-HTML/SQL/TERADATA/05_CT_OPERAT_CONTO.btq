		---FINANZIAMENTI centro
		, sum(case when a.DES_RICLAS='FINANZIAMENTI' and a.CANALE='CENTRO' then IMP_AVERE else 0 end) as CC_FINANZIAMENTI_CENTRO_IMP_ENTRATA 
