		---BONIFICI centro, up, web, app
		, sum(case when a.DES_RICLAS='BONIFICO' and a.CANALE='CENTRO' then IMP_AVERE else 0 end) as CC_BONIFICO_CENTRO_IMP_ENTRATA 
		, sum(case when a.DES_RICLAS='BONIFICO' and a.CANALE='CENTRO' then NUM_AVERE else 0 end) as CC_BONIFICO_CENTRO_NUM_ENTRATA		
