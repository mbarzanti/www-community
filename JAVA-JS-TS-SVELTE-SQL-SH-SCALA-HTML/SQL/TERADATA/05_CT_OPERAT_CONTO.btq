		---COMMISSIONI centro
		, sum(case when a.DES_RICLAS='COMMISSIONI' and a.CANALE='CENTRO' then IMP_AVERE else 0 end) as CC_COMMISSIONI_CENTRO_IMP_ENTRATA 
