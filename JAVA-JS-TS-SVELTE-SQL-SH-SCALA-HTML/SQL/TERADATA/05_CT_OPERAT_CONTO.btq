		---BFP centro, up, web
		, sum(case when a.DES_RICLAS='BFP' and a.CANALE='CENTRO' then IMP_AVERE else 0 end) as CC_BFP_CENTRO_IMP_ENTRATA 
		, sum(case when a.DES_RICLAS='BFP' and a.CANALE='CENTRO' then NUM_AVERE else 0 end) as CC_BFP_CENTRO_NUM_ENTRATA		
		, sum(case when a.DES_RICLAS='BFP' and a.CANALE='CENTRO' then IMP_DARE else 0 end) as CC_BFP_CENTRO_IMP_USCITA 
		, sum(case when a.DES_RICLAS='BFP' and a.CANALE='CENTRO' then NUM_DARE else 0 end) as CC_BFP_CENTRO_NUM_USCITA
		, sum(case when a.DES_RICLAS='BFP' and a.CANALE='UP' then IMP_AVERE else 0 end) as CC_BFP_UP_IMP_ENTRATA 
		, sum(case when a.DES_RICLAS='BFP' and a.CANALE='UP' then NUM_AVERE else 0 end) as CC_BFP_UP_NUM_ENTRATA		
		, sum(case when a.DES_RICLAS='BFP' and a.CANALE='UP' then IMP_DARE else 0 end) as CC_BFP_UP_IMP_USCITA 
