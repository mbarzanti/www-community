		, sum(case when a.DES_RICLAS='ASSEGNI_POSTALI' and a.CANALE='UP' then IMP_AVERE else 0 end) as CC_ASSEGNI_POSTALI_UP_IMP_ENTRATA 
		, sum(case when a.DES_RICLAS='ASSEGNI_POSTALI' and a.CANALE='UP' then NUM_AVERE else 0 end) as CC_ASSEGNI_POSTALI_UP_NUM_ENTRATA		
		, sum(case when a.DES_RICLAS='ASSEGNI_POSTALI' and a.CANALE='UP' then IMP_DARE else 0 end) as CC_ASSEGNI_POSTALI_UP_IMP_USCITA 
