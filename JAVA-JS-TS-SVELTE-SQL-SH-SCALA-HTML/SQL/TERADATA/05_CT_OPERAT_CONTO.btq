		, sum(case when a.DES_RICLAS='RICARICA_POSTEPAY' and a.CANALE='UP' then IMP_DARE else 0 end) as CC_RICARICA_POSTEPAY_UP_IMP_USCITA 
		, sum(case when a.DES_RICLAS='RICARICA_POSTEPAY' and a.CANALE='UP' then NUM_DARE else 0 end) as CC_RICARICA_POSTEPAY_UP_NUM_USCITA
		, sum(case when a.DES_RICLAS='RICARICA_POSTEPAY' and a.CANALE='APP' then IMP_DARE else 0 end) as CC_RICARICA_POSTEPAY_APP_IMP_USCITA 
		, sum(case when a.DES_RICLAS='RICARICA_POSTEPAY' and a.CANALE='APP' then NUM_DARE else 0 end) as CC_RICARICA_POSTEPAY_APP_NUM_USCITA
		, sum(case when a.DES_RICLAS='RICARICA_POSTEPAY' and a.CANALE='DIGITAL' then IMP_DARE else 0 end) as CC_RICARICA_POSTEPAY_DIGITAL_IMP_USCITA 
		, sum(case when a.DES_RICLAS='RICARICA_POSTEPAY' and a.CANALE='DIGITAL' then NUM_DARE else 0 end) as CC_RICARICA_POSTEPAY_DIGITAL_NUM_USCITA		
		---ricarica telefonica
		, sum(case when a.DES_RICLAS='RICARICA_TELEFONICA' and a.CANALE='CENTRO' then IMP_DARE else 0 end) as CC_RICARICA_TELEFONICA_CENTRO_IMP_USCITA 
		, sum(case when a.DES_RICLAS='RICARICA_TELEFONICA' and a.CANALE='CENTRO' then NUM_DARE else 0 end) as CC_RICARICA_TELEFONICA_CENTRO_NUM_USCITA	
		, sum(case when a.DES_RICLAS='RICARICA_TELEFONICA' and a.CANALE='UP' then IMP_DARE else 0 end) as CC_RICARICA_TELEFONICA_UP_IMP_USCITA 
		, sum(case when a.DES_RICLAS='RICARICA_TELEFONICA' and a.CANALE='UP' then NUM_DARE else 0 end) as CC_RICARICA_TELEFONICA_UP_NUM_USCITA
		, sum(case when a.DES_RICLAS='RICARICA_TELEFONICA' and a.CANALE='DIGITAL' then IMP_DARE else 0 end) as CC_RICARICA_TELEFONICA_DIGITAL_IMP_USCITA 
		, sum(case when a.DES_RICLAS='RICARICA_TELEFONICA' and a.CANALE='DIGITAL' then NUM_DARE else 0 end) as CC_RICARICA_TELEFONICA_DIGITAL_NUM_USCITA
		, sum(case when a.DES_RICLAS='RICARICA_TELEFONICA' and a.CANALE='ATM_POSTE' then IMP_DARE else 0 end) as CC_RICARICA_TELEFONICA_ATM_POSTE_IMP_USCITA 
		, sum(case when a.DES_RICLAS='RICARICA_TELEFONICA' and a.CANALE='ATM_POSTE' then NUM_DARE else 0 end) as CC_RICARICA_TELEFONICA_ATM_POSTE_NUM_USCITA		
		---scoperto conto
		, sum(case when a.DES_RICLAS='SCOPERTO_CONTO' and a.CANALE='CENTRO' then IMP_AVERE else 0 end) as CC_SCOPERTO_CONTO_CENTRO_IMP_ENTRATA 
		, sum(case when a.DES_RICLAS='SCOPERTO_CONTO' and a.CANALE='CENTRO' then NUM_AVERE else 0 end) as CC_SCOPERTO_CONTO_CENTRO_NUM_ENTRATA		
		, sum(case when a.DES_RICLAS='SCOPERTO_CONTO' and a.CANALE='CENTRO' then IMP_DARE else 0 end) as CC_SCOPERTO_CONTO_CENTRO_IMP_USCITA 
		, sum(case when a.DES_RICLAS='SCOPERTO_CONTO' and a.CANALE='CENTRO' then NUM_DARE else 0 end) as CC_SCOPERTO_CONTO_CENTRO_NUM_USCITA
		---sdd
		, sum(case when a.DES_RICLAS='SDD' and a.CANALE='CENTRO' then IMP_AVERE else 0 end) as CC_SDD_CENTRO_IMP_ENTRATA 
		, sum(case when a.DES_RICLAS='SDD' and a.CANALE='CENTRO' then NUM_AVERE else 0 end) as CC_SDD_CENTRO_NUM_ENTRATA		
		, sum(case when a.DES_RICLAS='SDD' and a.CANALE='CENTRO' then IMP_DARE else 0 end) as CC_SDD_CENTRO_IMP_USCITA 
		, sum(case when a.DES_RICLAS='SDD' and a.CANALE='CENTRO' then NUM_DARE else 0 end) as CC_SDD_CENTRO_NUM_USCITA							
		---stipendio pensione
		, sum(case when a.DES_RICLAS='STIPENDIO_PENSIONE' and a.CANALE='CENTRO' then IMP_AVERE else 0 end) as CC_STIPENDIO_PENSIONE_CENTRO_IMP_ENTRATA 
		, sum(case when a.DES_RICLAS='STIPENDIO_PENSIONE' and a.CANALE='CENTRO' then NUM_AVERE else 0 end) as CC_STIPENDIO_PENSIONE_CENTRO_NUM_ENTRATA	
		---storni
		, sum(case when a.DES_RICLAS='STORNI' and a.CANALE='CENTRO' then IMP_AVERE else 0 end) as CC_STORNI_CENTRO_IMP_ENTRATA 
		, sum(case when a.DES_RICLAS='STORNI' and a.CANALE='CENTRO' then NUM_AVERE else 0 end) as CC_STORNI_CENTRO_NUM_ENTRATA		
		, sum(case when a.DES_RICLAS='STORNI' and a.CANALE='CENTRO' then IMP_DARE else 0 end) as CC_STORNI_CENTRO_IMP_USCITA 
		, sum(case when a.DES_RICLAS='STORNI' and a.CANALE='CENTRO' then NUM_DARE else 0 end) as CC_STORNI_CENTRO_NUM_USCITA
		---tenuta conto
		, sum(case when a.DES_RICLAS='TENUTA_CONTO' and a.CANALE='CENTRO' then IMP_AVERE else 0 end) as CC_TENUTA_CONTO_CENTRO_IMP_ENTRATA 
		, sum(case when a.DES_RICLAS='TENUTA_CONTO' and a.CANALE='CENTRO' then NUM_AVERE else 0 end) as CC_TENUTA_CONTO_CENTRO_NUM_ENTRATA		
		, sum(case when a.DES_RICLAS='TENUTA_CONTO' and a.CANALE='CENTRO' then IMP_DARE else 0 end) as CC_TENUTA_CONTO_CENTRO_IMP_USCITA 
		, sum(case when a.DES_RICLAS='TENUTA_CONTO' and a.CANALE='CENTRO' then NUM_DARE else 0 end) as CC_TENUTA_CONTO_CENTRO_NUM_USCITA		
		---titoli
		, sum(case when a.DES_RICLAS='TITOLI' and a.CANALE='CENTRO' then IMP_AVERE else 0 end) as CC_TITOLI_CENTRO_IMP_ENTRATA 
		, sum(case when a.DES_RICLAS='TITOLI' and a.CANALE='CENTRO' then NUM_AVERE else 0 end) as CC_TITOLI_CENTRO_NUM_ENTRATA		
		, sum(case when a.DES_RICLAS='TITOLI' and a.CANALE='CENTRO' then IMP_DARE else 0 end) as CC_TITOLI_CENTRO_IMP_USCITA 
		, sum(case when a.DES_RICLAS='TITOLI' and a.CANALE='CENTRO' then NUM_DARE else 0 end) as CC_TITOLI_CENTRO_NUM_USCITA		
		, sum(case when a.DES_RICLAS='TITOLI' and a.CANALE='UP' then IMP_AVERE else 0 end) as CC_TITOLI_UP_IMP_ENTRATA 
		, sum(case when a.DES_RICLAS='TITOLI' and a.CANALE='UP' then NUM_AVERE else 0 end) as CC_TITOLI_UP_NUM_ENTRATA		
		, sum(case when a.DES_RICLAS='TITOLI' and a.CANALE='UP' then IMP_DARE else 0 end) as CC_TITOLI_UP_IMP_USCITA 
		, sum(case when a.DES_RICLAS='TITOLI' and a.CANALE='UP' then NUM_DARE else 0 end) as CC_TITOLI_UP_NUM_USCITA
		, sum(case when a.DES_RICLAS='TITOLI' and a.CANALE='WEB' then IMP_AVERE else 0 end) as CC_TITOLI_WEB_IMP_ENTRATA 
		, sum(case when a.DES_RICLAS='TITOLI' and a.CANALE='WEB' then NUM_AVERE else 0 end) as CC_TITOLI_WEB_NUM_ENTRATA		
		, sum(case when a.DES_RICLAS='TITOLI' and a.CANALE='WEB' then IMP_DARE else 0 end) as CC_TITOLI_WEB_IMP_USCITA 
		, sum(case when a.DES_RICLAS='TITOLI' and a.CANALE='WEB' then NUM_DARE else 0 end) as CC_TITOLI_WEB_NUM_USCITA
		---varie
		, sum(case when a.DES_RICLAS='VARIE' and a.CANALE='CENTRO' then IMP_AVERE else 0 end) as CC_VARIE_CENTRO_IMP_ENTRATA 
		, sum(case when a.DES_RICLAS='VARIE' and a.CANALE='CENTRO' then NUM_AVERE else 0 end) as CC_VARIE_CENTRO_NUM_ENTRATA		
		, sum(case when a.DES_RICLAS='VARIE' and a.CANALE='CENTRO' then IMP_DARE else 0 end) as CC_VARIE_CENTRO_IMP_USCITA 
		, sum(case when a.DES_RICLAS='VARIE' and a.CANALE='CENTRO' then NUM_DARE else 0 end) as CC_VARIE_CENTRO_NUM_USCITA
		---versamento
		, sum(case when a.DES_RICLAS='VERSAMENTI' and a.CANALE='UP' then IMP_AVERE else 0 end) as CC_VERSAMENTI_UP_IMP_ENTRATA 
		, sum(case when a.DES_RICLAS='VERSAMENTI' and a.CANALE='UP' then NUM_AVERE else 0 end) as CC_VERSAMENTI_UP_NUM_ENTRATA	
		---riclassificazione dei bonifici
		, sum(coalesce(a.BON_ACQUISTO_CASA_ENTRATA,0)) as CC_BON_ACQUISTO_CASA_NUM_ENTRATA
		, sum(coalesce(a.BON_AFFITTO_ENTRATA,0)) as CC_BON_AFFITTO_NUM_ENTRATA
		, sum(coalesce(a.BON_CONDOMINIO_ENTRATA,0)) as CC_BON_CONDOMINIO_NUM_ENTRATA
		, sum(coalesce(a.BON_DISOCCUPAZIONE_ENTRATA,0)) as CC_BON_DISOCCUPAZIONE_NUM_ENTRATA
		, sum(coalesce(a.BON_EREDITA_ENTRATA,0)) as CC_BON_EREDITA_NUM_ENTRATA
		, sum(coalesce(a.BON_ISTRUZIONE_ENTRATA,0)) as CC_BON_ISTRUZIONE_NUM_ENTRATA
		, sum(coalesce(a.BON_LIQUIDAZIONE_POLIZZA_ENTRATA,0)) as CC_BON_LIQUIDAZIONE_POLIZZA_NUM_ENTRATA
		, sum(coalesce(a.BON_MANTENIMENTO_ENTRATA,0)) as CC_BON_MANTENIMENTO_NUM_ENTRATA
		, sum(coalesce(a.BON_MOTORI_ENTRATA,0)) as CC_BON_MOTORI_NUM_ENTRATA
		, sum(coalesce(a.BON_MUTUO_ENTRATA,0)) as CC_BON_MUTUO_NUM_ENTRATA
		, sum(coalesce(a.BON_NOZZE_ENTRATA,0)) as CC_BON_NOZZE_NUM_ENTRATA
		, sum(coalesce(a.BON_NUCLEO_FAMIGLIA_ENTRATA,0)) as CC_BON_NUCLEO_FAMIGLIA_NUM_ENTRATA
		, sum(coalesce(a.BON_PRESTITO_ENTRATA,0)) as CC_BON_PRESTITO_NUM_ENTRATA
		, sum(coalesce(a.BON_RETTA_ENTRATA,0)) as CC_BON_RETTA_NUM_ENTRATA
		, sum(coalesce(a.BON_SPESE_SANITARIE_ENTRATA,0)) as CC_BON_SPESE_SANITARIE_NUM_ENTRATA
		, sum(coalesce(a.BON_STIPENDIO_PENSIONE_ENTRATA,0)) as CC_BON_STIPENDIO_PENSIONE_NUM_ENTRATA
		, sum(coalesce(a.BON_TRIBUTO_ENTRATA,0)) as CC_BON_TRIBUTO_NUM_ENTRATA
		, sum(coalesce(a.BON_UTENZE_ENTRATA,0)) as CC_BON_UTENZE_NUM_ENTRATA
		, sum(coalesce(a.BON_VIAGGI_ENTRATA,0)) as CC_BON_VIAGGI_NUM_ENTRATA
		, sum(coalesce(a.BON_ALTRO_ENTRATA,0)) as CC_BON_ALTRO_NUM_ENTRATA
		, sum(coalesce(a.BON_ACQUISTO_CASA_USCITA,0)) as CC_BON_ACQUISTO_CASA_NUM_USCITA
		, sum(coalesce(a.BON_AFFITTO_USCITA,0)) as CC_BON_AFFITTO_NUM_USCITA
		, sum(coalesce(a.BON_CONDOMINIO_USCITA,0)) as CC_BON_CONDOMINIO_NUM_USCITA
		, sum(coalesce(a.BON_DISOCCUPAZIONE_USCITA,0)) as CC_BON_DISOCCUPAZIONE_NUM_USCITA
		, sum(coalesce(a.BON_EREDITA_USCITA,0)) as CC_BON_EREDITA_NUM_USCITA
		, sum(coalesce(a.BON_ISTRUZIONE_USCITA,0)) as CC_BON_ISTRUZIONE_NUM_USCITA
		, sum(coalesce(a.BON_LIQUIDAZIONE_POLIZZA_USCITA,0)) as CC_BON_LIQUIDAZIONE_POLIZZA_NUM_USCITA
		, sum(coalesce(a.BON_MANTENIMENTO_USCITA,0)) as CC_BON_MANTENIMENTO_NUM_USCITA
		, sum(coalesce(a.BON_MOTORI_USCITA,0)) as CC_BON_MOTORI_NUM_USCITA
		, sum(coalesce(a.BON_MUTUO_USCITA,0)) as CC_BON_MUTUO_NUM_USCITA
		, sum(coalesce(a.BON_NOZZE_USCITA,0)) as CC_BON_NOZZE_NUM_USCITA
		, sum(coalesce(a.BON_NUCLEO_FAMIGLIA_USCITA,0)) as CC_BON_NUCLEO_FAMIGLIA_NUM_USCITA
		, sum(coalesce(a.BON_PRESTITO_USCITA,0)) as CC_BON_PRESTITO_NUM_USCITA
		, sum(coalesce(a.BON_RETTA_USCITA,0)) as CC_BON_RETTA_NUM_USCITA
		, sum(coalesce(a.BON_SPESE_SANITARIE_USCITA,0)) as CC_BON_SPESE_SANITARIE_NUM_USCITA
		, sum(coalesce(a.BON_STIPENDIO_PENSIONE_USCITA,0)) as CC_BON_STIPENDIO_PENSIONE_NUM_USCITA
		, sum(coalesce(a.BON_TRIBUTO_USCITA,0)) as CC_BON_TRIBUTO_NUM_USCITA
		, sum(coalesce(a.BON_UTENZE_USCITA,0)) as CC_BON_UTENZE_NUM_USCITA
		, sum(coalesce(a.BON_VIAGGI_USCITA,0)) as CC_BON_VIAGGI_NUM_USCITA
		, sum(coalesce(a.BON_ALTRO_USCITA,0)) as CC_BON_ALTRO_NUM_USCITA
		-----------------------totali per canali
		---IMPORTO entrata CANALE fisico		
		, (CC_ASSEGNI_BANCARI_UP_IMP_ENTRATA + CC_ASSEGNI_POSTALI_UP_IMP_ENTRATA + CC_BFP_UP_IMP_ENTRATA
			+ CC_FONDI_UP_IMP_ENTRATA + CC_VERSAMENTI_UP_IMP_ENTRATA + CC_TITOLI_UP_IMP_ENTRATA) as CC_TOT_OPER_FISICO_IMP_ENTRATA
		---NUMERO entrata CANALE fisico			
		, (CC_ASSEGNI_BANCARI_UP_NUM_ENTRATA + CC_ASSEGNI_POSTALI_UP_NUM_ENTRATA + CC_BFP_UP_NUM_ENTRATA
			+ CC_FONDI_UP_NUM_ENTRATA + CC_VERSAMENTI_UP_NUM_ENTRATA + CC_TITOLI_UP_NUM_ENTRATA) as CC_TOT_OPER_FISICO_NUM_ENTRATA
		---IMPORTO uscita CANALE fisico
		, (CC_ASSEGNI_POSTALI_UP_IMP_USCITA + CC_BFP_UP_IMP_USCITA	+ CC_BONIFICO_UP_IMP_USCITA + CC_FONDI_UP_IMP_USCITA
			+ CC_PAGAMENTI_UP_IMP_USCITA + CC_POLIZZE_UP_IMP_USCITA + CC_POSTAGIRO_A_CC_UP_IMP_USCITA + CC_POSTAGIRO_A_LIB_UP_IMP_USCITA
			+ CC_POSTAGIRO_A_EVO_UP_IMP_USCITA + CC_PRELIEVO_UP_IMP_USCITA + CC_RICARICA_POSTEPAY_UP_IMP_USCITA + CC_RICARICA_TELEFONICA_UP_IMP_USCITA
			+ CC_TITOLI_UP_IMP_USCITA + CC_PAGAMENTI_ATM_POSTE_IMP_USCITA + CC_PAGAMENTI_POS_ESTERNO_IMP_USCITA + CC_PAGAMENTI_ALTRO_IMP_USCITA
			+ CC_POSTAGIRO_A_LIB_ATM_POSTE_IMP_USCITA + CC_PRELIEVO_ATM_POSTE_IMP_USCITA + CC_PRELIEVO_ATM_BANCARIO_IMP_USCITA
			+ CC_PRELIEVO_POS_ESTERNO_IMP_USCITA + CC_RICARICA_TELEFONICA_ATM_POSTE_IMP_USCITA) as CC_TOT_OPER_FISICO_IMP_USCITA
		---NUMERO uscita CANALE fisico
		, (CC_ASSEGNI_POSTALI_UP_NUM_USCITA + CC_BFP_UP_NUM_USCITA + CC_BONIFICO_UP_NUM_USCITA + CC_FONDI_UP_NUM_USCITA
			+ CC_PAGAMENTI_UP_NUM_USCITA + CC_POLIZZE_UP_NUM_USCITA + CC_POSTAGIRO_A_CC_UP_NUM_USCITA + CC_POSTAGIRO_A_LIB_UP_NUM_USCITA
			+ CC_POSTAGIRO_A_EVO_UP_NUM_USCITA + CC_PRELIEVO_UP_NUM_USCITA + CC_RICARICA_POSTEPAY_UP_NUM_USCITA + CC_RICARICA_TELEFONICA_UP_NUM_USCITA 
			+ CC_TITOLI_UP_NUM_USCITA + CC_PAGAMENTI_ATM_POSTE_NUM_USCITA + CC_PAGAMENTI_POS_ESTERNO_NUM_USCITA + CC_PAGAMENTI_ALTRO_NUM_USCITA
			+ CC_POSTAGIRO_A_LIB_ATM_POSTE_NUM_USCITA + CC_PRELIEVO_ATM_POSTE_NUM_USCITA + CC_PRELIEVO_ATM_BANCARIO_NUM_USCITA
			+ CC_PRELIEVO_POS_ESTERNO_NUM_USCITA + CC_RICARICA_TELEFONICA_ATM_POSTE_NUM_USCITA) as CC_TOT_OPER_FISICO_NUM_USCITA
		---IMPORTO entrata CANALE centro		
		, (CC_ASSEGNI_BANCARI_CENTRO_IMP_ENTRATA + CC_ASSEGNI_POSTALI_CENTRO_IMP_ENTRATA + CC_BFP_CENTRO_IMP_ENTRATA + CC_BONIFICO_CENTRO_IMP_ENTRATA
			+ CC_CARTA_CREDITO_CENTRO_IMP_ENTRATA + CC_COMMISSIONI_CENTRO_IMP_ENTRATA + CC_FINANZIAMENTI_CENTRO_IMP_ENTRATA + CC_FONDI_CENTRO_IMP_ENTRATA
			+ CC_PAGAMENTI_CENTRO_IMP_ENTRATA + CC_POLIZZE_CENTRO_IMP_ENTRATA + CC_POSTAGIRO_DA_CC_CENTRO_IMP_ENTRATA + CC_POSTAGIRO_DA_LIB_CENTRO_IMP_ENTRATA
			+ CC_POSTAGIRO_DA_EVO_CENTRO_IMP_ENTRATA + CC_SCOPERTO_CONTO_CENTRO_IMP_ENTRATA + CC_SDD_CENTRO_IMP_ENTRATA + CC_STIPENDIO_PENSIONE_CENTRO_IMP_ENTRATA
			+ CC_STORNI_CENTRO_IMP_ENTRATA + CC_TENUTA_CONTO_CENTRO_IMP_ENTRATA	+ CC_TITOLI_CENTRO_IMP_ENTRATA + CC_VARIE_CENTRO_IMP_ENTRATA
			) as CC_TOT_OPER_CENTRO_IMP_ENTRATA
		---NUMERO entrata CANALE centro
		, (CC_ASSEGNI_BANCARI_CENTRO_NUM_ENTRATA + CC_ASSEGNI_POSTALI_CENTRO_NUM_ENTRATA + CC_BFP_CENTRO_NUM_ENTRATA + CC_BONIFICO_CENTRO_NUM_ENTRATA
			+ CC_CARTA_CREDITO_CENTRO_NUM_ENTRATA + CC_COMMISSIONI_CENTRO_NUM_ENTRATA + CC_FINANZIAMENTI_CENTRO_NUM_ENTRATA + CC_FONDI_CENTRO_NUM_ENTRATA
			+ CC_PAGAMENTI_CENTRO_NUM_ENTRATA + CC_POLIZZE_CENTRO_NUM_ENTRATA + CC_POSTAGIRO_DA_CC_CENTRO_NUM_ENTRATA + CC_POSTAGIRO_DA_LIB_CENTRO_NUM_ENTRATA
			+ CC_POSTAGIRO_DA_EVO_CENTRO_NUM_ENTRATA + CC_SCOPERTO_CONTO_CENTRO_NUM_ENTRATA + CC_SDD_CENTRO_NUM_ENTRATA + CC_STIPENDIO_PENSIONE_CENTRO_NUM_ENTRATA
			+ CC_STORNI_CENTRO_NUM_ENTRATA + CC_TENUTA_CONTO_CENTRO_NUM_ENTRATA + CC_TITOLI_CENTRO_NUM_ENTRATA + CC_VARIE_CENTRO_NUM_ENTRATA
			) as CC_TOT_OPER_CENTRO_NUM_ENTRATA
		---IMPORTO uscita CANALE centro
		, (CC_ASSEGNI_POSTALI_CENTRO_IMP_USCITA + CC_BFP_CENTRO_IMP_USCITA + CC_BONIFICO_CENTRO_IMP_USCITA + CC_CARTA_CREDITO_CENTRO_IMP_USCITA
			+ CC_COMMISSIONI_CENTRO_IMP_USCITA + CC_FINANZIAMENTI_CENTRO_IMP_USCITA + CC_FONDI_CENTRO_IMP_USCITA + CC_PAGAMENTI_CENTRO_IMP_USCITA
			+ CC_POLIZZE_CENTRO_IMP_USCITA + CC_POSTAGIRO_A_CC_CENTRO_IMP_USCITA + CC_RICARICA_POSTEPAY_CENTRO_IMP_USCITA + CC_RICARICA_TELEFONICA_CENTRO_IMP_USCITA
			+ CC_SCOPERTO_CONTO_CENTRO_IMP_USCITA + CC_SDD_CENTRO_IMP_USCITA + CC_STORNI_CENTRO_IMP_USCITA + CC_TENUTA_CONTO_CENTRO_IMP_USCITA
			+ CC_TITOLI_CENTRO_IMP_USCITA + CC_VARIE_CENTRO_IMP_USCITA
			) as CC_TOT_OPER_CENTRO_IMP_USCITA
		---NUMERO uscita CANALE centro
		, (CC_ASSEGNI_POSTALI_CENTRO_NUM_USCITA + CC_BFP_CENTRO_NUM_USCITA + CC_BONIFICO_CENTRO_NUM_USCITA + CC_CARTA_CREDITO_CENTRO_NUM_USCITA
			+ CC_COMMISSIONI_CENTRO_NUM_USCITA + CC_FINANZIAMENTI_CENTRO_NUM_USCITA + CC_FONDI_CENTRO_NUM_USCITA + CC_PAGAMENTI_CENTRO_NUM_USCITA
			+ CC_POLIZZE_CENTRO_NUM_USCITA + CC_POSTAGIRO_A_CC_CENTRO_NUM_USCITA + CC_RICARICA_POSTEPAY_CENTRO_NUM_USCITA + CC_RICARICA_TELEFONICA_CENTRO_NUM_USCITA
			+ CC_SCOPERTO_CONTO_CENTRO_NUM_USCITA + CC_SDD_CENTRO_NUM_USCITA + CC_STORNI_CENTRO_NUM_USCITA + CC_TENUTA_CONTO_CENTRO_NUM_USCITA
			+ CC_TITOLI_CENTRO_NUM_USCITA + CC_VARIE_CENTRO_NUM_USCITA
			) as CC_TOT_OPER_CENTRO_NUM_USCITA
		---Importo entrata canale digital
		, (CC_ASSEGNI_POSTALI_WEB_IMP_ENTRATA + CC_BFP_WEB_IMP_ENTRATA + CC_TITOLI_WEB_IMP_ENTRATA) as CC_TOT_OPER_DIGITAL_IMP_ENTRATA
		---NUMERO entrata canale digital
		, (CC_ASSEGNI_POSTALI_WEB_NUM_ENTRATA + CC_BFP_WEB_NUM_ENTRATA + CC_TITOLI_WEB_NUM_ENTRATA) as CC_TOT_OPER_DIGITAL_NUM_ENTRATA
		---Importo uscita canale digital
		, (CC_ASSEGNI_POSTALI_WEB_IMP_USCITA + CC_BFP_WEB_IMP_USCITA + CC_BONIFICO_APP_IMP_USCITA + CC_BONIFICO_WEB_IMP_USCITA + CC_BONIFICO_DIGITAL_IMP_USCITA
			+ CC_PAGAMENTI_APP_IMP_USCITA + CC_PAGAMENTI_WEB_IMP_USCITA + CC_PAGAMENTI_DIGITAL_IMP_USCITA + CC_POSTAGIRO_A_CC_APP_IMP_USCITA 
			+ CC_POSTAGIRO_A_CC_WEB_IMP_USCITA + CC_POSTAGIRO_A_LIB_APP_IMP_USCITA + CC_POSTAGIRO_A_LIB_WEB_IMP_USCITA + CC_POSTAGIRO_A_LIB_WEB_NUM_USCITA 
			+ CC_POSTAGIRO_A_EVO_APP_IMP_USCITA + CC_POSTAGIRO_A_EVO_WEB_IMP_USCITA + CC_RICARICA_POSTEPAY_APP_IMP_USCITA + CC_RICARICA_POSTEPAY_DIGITAL_IMP_USCITA
			+ CC_RICARICA_TELEFONICA_DIGITAL_IMP_USCITA + CC_TITOLI_WEB_IMP_USCITA + CC_POSTAGIRO_A_CC_DIGITAL_IMP_USCITA) as CC_TOT_OPER_DIGITAL_IMP_USCITA
		---numero uscita canale digital
		, (CC_ASSEGNI_POSTALI_WEB_NUM_USCITA + CC_BFP_WEB_NUM_USCITA + CC_BONIFICO_APP_NUM_USCITA + CC_BONIFICO_WEB_NUM_USCITA + CC_BONIFICO_DIGITAL_NUM_USCITA
			+ CC_PAGAMENTI_APP_NUM_USCITA + CC_PAGAMENTI_WEB_NUM_USCITA + CC_PAGAMENTI_DIGITAL_NUM_USCITA + CC_RICARICA_POSTEPAY_DIGITAL_NUM_USCITA 
			+ CC_POSTAGIRO_A_CC_APP_NUM_USCITA + CC_POSTAGIRO_A_CC_WEB_NUM_USCITA + CC_POSTAGIRO_A_LIB_APP_NUM_USCITA + CC_POSTAGIRO_A_LIB_WEB_NUM_USCITA
			+ CC_POSTAGIRO_A_EVO_APP_NUM_USCITA + CC_POSTAGIRO_A_EVO_WEB_NUM_USCITA + CC_RICARICA_POSTEPAY_APP_NUM_USCITA + CC_RICARICA_TELEFONICA_DIGITAL_NUM_USCITA 
			+ CC_TITOLI_WEB_NUM_USCITA + CC_POSTAGIRO_A_CC_DIGITAL_NUM_USCITA) as CC_TOT_OPER_DIGITAL_NUM_USCITA		
	from EBIL_AREE.CT_PERIMETRO as b
	left join MOVIM_CC_RAGGR as a
	on a.ID_CLIENTE_BIC=b.ID_CLIENTE_BIC
	group by 1,2
)with data primary index(ID_CLIENTE_BIC, ID_PERIODO_TEMPORALE) on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


