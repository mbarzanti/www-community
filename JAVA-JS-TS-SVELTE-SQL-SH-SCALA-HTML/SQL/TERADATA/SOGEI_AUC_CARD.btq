/****************************************************************************************************************************/
/****************************************************************************************************************************/
/****************************************************************************************************************************/
/****************************************************************************************************************************/
/*                                                                                                                          */
/****************************************************************************************************************************/

.SET ERROROUT STDOUT
.SET WIDTH 240;

.IMPORT VARTEXT '|' FILE=/data/DWH/AUC/SOURCE/CARD/PARAMETRI_CARD_CLIENTE_RETAIL.txt;
USING( p01 VARCHAR(100), p02 VARCHAR(100), p03 VARCHAR(100), p04 VARCHAR(100), p05 VARCHAR(100), p06 VARCHAR(100), p07 VARCHAR(100), p08 VARCHAR(100), p09 VARCHAR(100), p10 VARCHAR(100), p11 VARCHAR(100)) 
exec BIC_ODS_SA.M_GTT_BTEQ_PARAMETER(:p01,:p02,:p03,:p04,:p05,:p06,:p07,:p08,:p09,:p10,:p11);

EXEC BIC_ODS_SA.M_UPD_BTEQ_PARAMETER('SOGEI_CARD.btq', 'CARICAMENTO SOGEI APPOGGIO RETAIL', CURRENT_TIMESTAMP(0),'BIC_ODS_SA.AUC_CARD_CLIENTE_RETAIL');
SEL * FROM BIC_ODS_SA.GTT_BTEQ_PARAMETER;
.IF ACTIVITYCOUNT = 0 THEN .GOTO FINE_SOGEI_AUC_CARD

/*******************************************************************************/
/* Inserisco i Clienti da Certificare relativi a CARD Clienti Persone Giuridiche */
/*******************************************************************************/



CREATE VOLATILE TABLE CARD_SOGEI_APPOGGIO AS (
--- AUC --- TUTTI I CODICI FISCALI NUOVI RETAIL
SELECT C.COD_CLIENTE_SORGENTE AS COD_CLIENTE, 
			 'CARD' AS SORGENTE ,
			 CAST(C.TS_INIZIO_VALIDITA AS DATE) AS DATA_INIZIO, 
			 '2999-12-31'  AS DATA_FINE, 
			 C.CODICE_FISCALE_CLEAR AS ID_FISCALE, 
			 T.TS_INS AS TIMES
FROM  BIC_ODS_SA.AUC_CARD_CLIENTE_RETAIL C
INNER JOIN BIC_ODS_SA.SA_AU_CLIENTE_RETAIL T
ON C.COD_CLIENTE_SORGENTE=T.COD_CLIENTE_SORGENTE
AND C.COD_SISTEMA_SORGENTE=T.COD_SISTEMA_SORGENTE
 WHERE
  C.TS_FINE_VALIDITA = '2999-12-31 23:59:59'
  AND T.COD_SISTEMA_SORGENTE='CARD'
  AND ID_FISCALE IS NOT NULL
  
UNION
---TUTTI I CODICI FISCALI DI CLIENTI RETAIL CHE HANNO VARIATO ALMENO UN ATTRIBUTO ANAGRAFICO DIVERSO DA CF   
   SELECT	
SA.COD_CLIENTE_SORGENTE AS COD_CLIENTE, 
SA.COD_SISTEMA_SORGENTE,
CAST(SA.TS_INS AS DATE) AS DATA_INIZIO,
'2999-12-31' AS DATA_FINE,
SA.COD_FISCALE AS ID_FISCALE,
SA.TS_INS AS TIMES
FROM	
	BIC_ODS_SA.SA_AU_CLIENTE_RETAIL AS SA 
	LEFT OUTER JOIN  
    BIC_ODS_SA.AUC_CARD_CLIENTE_RETAIL AS CARD
	ON	SA.COD_CLIENTE_SORGENTE = CARD.COD_CLIENTE_SORGENTE
	AND SA.COD_SISTEMA_SORGENTE = CARD.COD_SISTEMA_SORGENTE
WHERE CARD.TS_FINE_VALIDITA = '2999-12-31 23:59:59' 
AND SA.COD_SISTEMA_SORGENTE='CARD'
AND SA.COD_FISCALE IS NOT NULL
       AND (
             
 COALESCE(SA.COGNOME, 'ND')<>COALESCE(CARD.COGNOME, 'ND') 
OR COALESCE(SA.NOME, 'ND')<>COALESCE(CARD.NOME, 'ND')
OR COALESCE(SA.DT_NASCITA, CAST('2999-12-31' AS DATE))<>COALESCE(CARD.DT_NASCITA , CAST('2999-12-31' AS DATE)) 
OR COALESCE(SA.COD_COMUNE_NASCITA, 'ND')<>COALESCE(CARD.COD_COMUNE_NASCITA, 'ND')
OR COALESCE(SA.DESC_COMUNE_NASCITA, 'ND')<>COALESCE(CARD.DESC_COMUNE_NASCITA, 'ND')
OR COALESCE(SA.COD_SESSO , 'ND')<>COALESCE(CARD.COD_SESSO, 'ND')
OR COALESCE(SA.ID_NAZIONE_NASCITA , 'ND')<>COALESCE(CARD.ID_NAZIONE_NASCITA, 'ND')
OR COALESCE(SA.DESC_NAZIONE_NASCITA, 'ND')<>COALESCE(CARD.DESC_NAZIONE_NASCITA, 'ND') 
AND COALESCE(SA.COD_FISCALE,'ND') = COALESCE(CARD.COD_FISCALE,'ND')
	          ) 
	   ) WITH DATA
UNIQUE PRIMARY INDEX (COD_CLIENTE,ID_FISCALE)
ON COMMIT PRESERVE ROWS;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

INSERT INTO BIC_ODS_SA.SOGEI_APPOGGIO

SELECT COD_CLIENTE, SORGENTE,  DATA_INIZIO,DATA_FINE, ID_FISCALE,NULL AS CERTIFICAZIONE ,TIMES
FROM  CARD_SOGEI_APPOGGIO
WHERE ID_FISCALE NOT IN ( SEL ID_FISCALE FROM BIC_ODS_SA.SOGEI_APPOGGIO );

.IF ERRORLEVEL > 0 THEN .QUIT 16;
	
/**** MONITORAGGIO  ****/
CALL BIC_ODS_SA.P_TAB_STAT_ELABORAZIONE( 'CARD','SOGEI_APPOGGIO' ) ;
.IF ERRORLEVEL > 0 THEN .QUIT 20;
/**** FINE MONITORAGGIO ****/

/***************************************************************************/
/***************************************************************************/
/*  F   I   N   E                                                          */
/***************************************************************************/
/***************************************************************************/

*/

.label FINE_SOGEI_AUC_CARD

.logoff;

.QUIT;
