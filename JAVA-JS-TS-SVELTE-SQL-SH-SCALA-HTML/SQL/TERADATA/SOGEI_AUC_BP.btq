.SET ERROROUT STDOUT
.SET WIDTH 240;

.IMPORT VARTEXT '|' FILE=/data/DWH/AUC/SOURCE/BP/PARAMETRI_BP_CLIENTE_RETAIL.txt;
USING( p01 VARCHAR(100), p02 VARCHAR(100), p03 VARCHAR(100), p04 VARCHAR(100), p05 VARCHAR(100), p06 VARCHAR(100), p07 VARCHAR(100), p08 VARCHAR(100), p09 VARCHAR(100), p10 VARCHAR(100), p11 VARCHAR(100)) 
exec BIC_ODS_SA.M_GTT_BTEQ_PARAMETER(:p01,:p02,:p03,:p04,:p05,:p06,:p07,:p08,:p09,:p10,:p11);

EXEC BIC_ODS_SA.M_UPD_BTEQ_PARAMETER('SOGEI_BP.btq', 'CARICAMENTO SOGEI APPOGGIO RETAIL', CURRENT_TIMESTAMP(0),'BIC_ODS_SA.AUC_BP_CLIENTE_RETAIL');


.IMPORT VARTEXT '|' FILE=/data/DWH/AUC/SOURCE/BP/PARAMETRI_BP_CLIENTE_BUSINESS.txt;
USING( p01 VARCHAR(100), p02 VARCHAR(100), p03 VARCHAR(100), p04 VARCHAR(100), p05 VARCHAR(100), p06 VARCHAR(100), p07 VARCHAR(100), p08 VARCHAR(100), p09 VARCHAR(100), p10 VARCHAR(100), p11 VARCHAR(100)) 
exec BIC_ODS_SA.M_GTT_BTEQ_PARAMETER(:p01,:p02,:p03,:p04,:p05,:p06,:p07,:p08,:p09,:p10,:p11);
EXEC BIC_ODS_SA.M_UPD_BTEQ_PARAMETER('SOGEI_BP.btq', 'CARICAMENTO SOGEI APPOGGIO BUSINESS', CURRENT_TIMESTAMP(0),'BIC_ODS_SA.AUC_BP_CLIENTE_BUSINESS');

SEL * FROM BIC_ODS_SA.GTT_BTEQ_PARAMETER;
.IF ACTIVITYCOUNT = 0 THEN .GOTO FINE_SOGEI_AUC_BP

/*******************************************************************************/
/* Inserisco i Clienti da Certificare relativi a BP Clienti Persone Giuridiche */
/*******************************************************************************/



CREATE VOLATILE TABLE BP_SOGEI_APPOGGIO AS (
--- AUC --- TUTTI I CODICI FISCALI NUOVI RETAIL
SELECT C.COD_CLIENTE_SORGENTE AS COD_CLIENTE, 
			 'BP' AS SORGENTE ,
			 CAST(C.TS_INIZIO_VALIDITA AS DATE) AS DATA_INIZIO, 
			 '2999-12-31'  AS DATA_FINE, 
			 C.CODICE_FISCALE_CLEAR AS ID_FISCALE, 
			 T.TS_INS AS TIMES
FROM  BIC_ODS_SA.AUC_BP_CLIENTE_RETAIL C
INNER JOIN BIC_ODS_SA.SA_AU_CLIENTE_RETAIL T
ON C.COD_CLIENTE_SORGENTE=T.COD_CLIENTE_SORGENTE
AND C.COD_SISTEMA_SORGENTE=T.COD_SISTEMA_SORGENTE
 WHERE
  C.TS_FINE_VALIDITA = '2999-12-31 23:59:59'
  AND T.COD_SISTEMA_SORGENTE='BP'
  AND ID_FISCALE IS NOT NULL
  
UNION
--- AUC ---TUTTI I CODICI FISCALI NUOVI BUSINESS
SELECT C.COD_CLIENTE_SORGENTE AS COD_CLIENTE, 'BP' AS SORGENTE ,CAST(C.TS_INIZIO_VALIDITA AS DATE) AS DATA_INIZIO, '2999-12-31'  AS DATA_FINE, 
C.CODICE_FISCALE_CLEAR AS ID_FISCALE, T.TS_INS AS TIMES
FROM  BIC_ODS_SA.AUC_BP_CLIENTE_BUSINESS C
INNER JOIN BIC_ODS_SA.SA_AU_CLIENTE_BUSINESS T
ON C.COD_CLIENTE_SORGENTE=T.COD_CLIENTE_SORGENTE
AND C.COD_SISTEMA_SORGENTE=T.COD_SISTEMA_SORGENTE
WHERE C.TS_FINE_VALIDITA = '2999-12-31 23:59:59'
  AND T.COD_SISTEMA_SORGENTE='BP'
  AND ID_FISCALE IS NOT NULL
  
UNION
--- AUC ---TUTTE LE PARTITE IVA NUOVE PROVENIENTI DALLA CLIENTE_BUSINESS 
SELECT C.COD_CLIENTE_SORGENTE AS COD_CLIENTE, 'BP' AS SORGENTE,  CAST(C.TS_INIZIO_VALIDITA AS DATE) AS DATA_INIZIO, '2999-12-31' AS DATA_FINE, 
C.PARTITA_IVA_CLEAR AS ID_FISCALE, T.TS_INS AS TIMES
FROM  BIC_ODS_SA.AUC_BP_CLIENTE_BUSINESS C
INNER JOIN BIC_ODS_SA.SA_AU_CLIENTE_BUSINESS T
ON C.COD_CLIENTE_SORGENTE=T.COD_CLIENTE_SORGENTE
AND C.COD_SISTEMA_SORGENTE=T.COD_SISTEMA_SORGENTE
WHERE C.TS_FINE_VALIDITA = '2999-12-31 23:59:59'
    AND T.COD_SISTEMA_SORGENTE='BP'
    AND ID_FISCALE IS NOT NULL  

UNION
---TUTTI I CODICI FISCALI DI CLIENTI RETAIL CHE HANNO VARIATO ALMENO UN ATTRIBUTO ANAGRAFICO DIVERSO DA CF   
   SELECT	
SA.COD_CLIENTE_SORGENTE AS COD_CLIENTE, 
SA.COD_SISTEMA_SORGENTE,
CAST(SA.TS_INS AS DATE) AS DATA_INIZIO,
'2999-12-31' AS DATA_FINE,
SA.COD_FISCALE AS ID_FISCALE,
SA.TS_INS AS TIMES
FROM	
	BIC_ODS_SA.SA_AU_CLIENTE_RETAIL AS SA 
	LEFT OUTER JOIN  
    BIC_ODS_SA.AUC_BP_CLIENTE_RETAIL AS BP
	ON	SA.COD_CLIENTE_SORGENTE = BP.COD_CLIENTE_SORGENTE
	AND SA.COD_SISTEMA_SORGENTE = BP.COD_SISTEMA_SORGENTE
WHERE BP.TS_FINE_VALIDITA = '2999-12-31 23:59:59' 
AND SA.COD_SISTEMA_SORGENTE='BP'
AND SA.COD_FISCALE IS NOT NULL
       AND (
             
 COALESCE(SA.COGNOME, 'ND')<>COALESCE(BP.COGNOME, 'ND') 
OR COALESCE(SA.NOME, 'ND')<>COALESCE(BP.NOME, 'ND')
OR COALESCE(SA.DT_NASCITA, CAST('2999-12-31' AS DATE))<>COALESCE(BP.DT_NASCITA , CAST('2999-12-31' AS DATE)) 
OR COALESCE(SA.COD_COMUNE_NASCITA, 'ND')<>COALESCE(BP.COD_COMUNE_NASCITA, 'ND')
OR COALESCE(SA.DESC_COMUNE_NASCITA, 'ND')<>COALESCE(BP.DESC_COMUNE_NASCITA, 'ND')
OR COALESCE(SA.COD_SESSO , 'ND')<>COALESCE(BP.COD_SESSO, 'ND')
OR COALESCE(SA.ID_NAZIONE_NASCITA , 'ND')<>COALESCE(BP.ID_NAZIONE_NASCITA, 'ND')
OR COALESCE(SA.DESC_NAZIONE_NASCITA, 'ND')<>COALESCE(BP.DESC_NAZIONE_NASCITA, 'ND') 
AND COALESCE(SA.COD_FISCALE,'ND') = COALESCE(BP.COD_FISCALE,'ND')
	          ) 
---TUTTI I CODICI FISCALI DI CLIENTI BUSINESS CHE HANNO VARIATO ALMENO UN ATTRIBUTO ANAGRAFICO DIVERSO DA CF  	          
UNION
   SELECT	
SA.COD_CLIENTE_SORGENTE AS COD_CLIENTE, 
SA.COD_SISTEMA_SORGENTE,
CAST(SA.TS_INS AS DATE) AS DATA_INIZIO,
'2999-12-31' AS DATA_FINE,
SA.COD_FISCALE AS ID_FISCALE,
SA.TS_INS AS TIMES
FROM	
	BIC_ODS_SA.SA_AU_CLIENTE_BUSINESS AS SA 
	LEFT OUTER JOIN  
  BIC_ODS_SA.AUC_BP_CLIENTE_BUSINESS AS BP
	ON	SA.COD_CLIENTE_SORGENTE = BP.COD_CLIENTE_SORGENTE
	AND SA.COD_SISTEMA_SORGENTE = BP.COD_SISTEMA_SORGENTE
CROSS JOIN BIC_ODS_SA.GTT_BTEQ_PARAMETER T
WHERE BP.TS_FINE_VALIDITA = '2999-12-31 23:59:59' 
AND SA.COD_SISTEMA_SORGENTE='BP'
AND SA.COD_FISCALE IS NOT NULL
       AND (
 COALESCE(SA.COD_PARTITA_IVA, 'ND')<>COALESCE(BP.COD_PARTITA_IVA , 'ND')
OR COALESCE(SA.COD_NAZIONE_PIVA , 'ND')<>COALESCE(BP.COD_NAZIONE_PIVA, 'ND')
OR COALESCE(SA.RAGIONE_SOCIALE , 'ND')<>COALESCE(BP.RAGIONE_SOCIALE, 'ND')
OR COALESCE(SA.ID_FORMA_GIURIDICA, 'ND')<>COALESCE(BP.ID_FORMA_GIURIDICA, 'ND') 
OR COALESCE(SA.FLAG_CESSAZIONE, 'ND')<>COALESCE(BP.FLAG_CESSAZIONE, 'ND') 
AND COALESCE(SA.COD_FISCALE,'ND') = COALESCE(BP.COD_FISCALE,'ND')
	          ) 
UNION
---TUTTI LE PARTITE IVA DEI CLIENTI BUSINESS CHE HANNO VARIATO ALMENO UN ATTRIBUTO ANAGRAFICO DIVERSO DA CF   
   SELECT	
SA.COD_CLIENTE_SORGENTE AS COD_CLIENTE, 
SA.COD_SISTEMA_SORGENTE,
CAST(SA.TS_INS AS DATE) AS DATA_INIZIO,
'2999-12-31' AS DATA_FINE,
SA.COD_PARTITA_IVA AS ID_FISCALE,
T.TS1 AS TIMES
FROM	
	BIC_ODS_SA.SA_AU_CLIENTE_BUSINESS AS SA 
	LEFT OUTER JOIN  
  BIC_ODS_SA.AUC_BP_CLIENTE_BUSINESS AS BP
	ON	SA.COD_CLIENTE_SORGENTE = BP.COD_CLIENTE_SORGENTE
	AND SA.COD_SISTEMA_SORGENTE = BP.COD_SISTEMA_SORGENTE
CROSS JOIN BIC_ODS_SA.GTT_BTEQ_PARAMETER T
WHERE	 BP.TS_FINE_VALIDITA = '2999-12-31 23:59:59' 
AND SA.COD_SISTEMA_SORGENTE='BP'
AND SA.COD_FISCALE IS NOT NULL
       AND (
 COALESCE(SA.COD_PARTITA_IVA, 'ND')<>COALESCE(BP.COD_PARTITA_IVA , 'ND')
OR COALESCE(SA.COD_NAZIONE_PIVA , 'ND')<>COALESCE(BP.COD_NAZIONE_PIVA, 'ND')
OR COALESCE(SA.RAGIONE_SOCIALE , 'ND')<>COALESCE(BP.RAGIONE_SOCIALE, 'ND')
OR COALESCE(SA.ID_FORMA_GIURIDICA, 'ND')<>COALESCE(BP.ID_FORMA_GIURIDICA, 'ND') 
OR COALESCE(SA.FLAG_CESSAZIONE, 'ND')<>COALESCE(BP.FLAG_CESSAZIONE, 'ND') 
AND COALESCE(SA.COD_FISCALE,'ND') = COALESCE(BP.COD_FISCALE,'ND')
	          ) 
	   ) WITH DATA
UNIQUE PRIMARY INDEX (COD_CLIENTE,ID_FISCALE)
ON COMMIT PRESERVE ROWS;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

INSERT INTO BIC_ODS_SA.SOGEI_APPOGGIO

SELECT COD_CLIENTE, SORGENTE,  DATA_INIZIO,DATA_FINE, ID_FISCALE,NULL AS CERTIFICAZIONE ,TIMES
FROM  BP_SOGEI_APPOGGIO
WHERE ID_FISCALE NOT IN ( SEL ID_FISCALE FROM BIC_ODS_SA.SOGEI_APPOGGIO );

.IF ERRORLEVEL > 0 THEN .QUIT 16;
	
/**** MONITORAGGIO  ****/
CALL BIC_ODS_SA.P_TAB_STAT_ELABORAZIONE( 'BP','SOGEI_APPOGGIO' ) ;
.IF ERRORLEVEL > 0 THEN .QUIT 20;
/**** FINE MONITORAGGIO ****/

/***************************************************************************/
/***************************************************************************/
/*  F   I   N   E                                                          */
/***************************************************************************/
/***************************************************************************/

*/

.label FINE_SOGEI_AUC_BP

.logoff;

.QUIT;
