/**************************************************************/
/* STEP 1.27.0 CANCELLO I RECORD CHE VANNO MODIFICATI PER CMS  **/
/**************************************************************/

DEL FROM BIC_ODS.ASSOC_CLI_INDIR
,BIC_ODS_SA.CMS_INDIRIZZO CMS 
WHERE BIC_ODS.ASSOC_CLI_INDIR.COD_CLIENTE_SORGENTE=CMS.ID_CLIENTE_CMS
AND BIC_ODS.ASSOC_CLI_INDIR.COD_SISTEMA_SORGENTE=CMS.COD_SISTEMA_SORGENTE
AND BIC_ODS.ASSOC_CLI_INDIR.ID_TIPO_RIFERIMENTO_INDIRIZZO=12
AND CMS.DATA_FINE_VALIDITA = '2999-12-31'
AND CMS.ID_INDIRIZZO_BIC_CMS <> BIC_ODS.ASSOC_CLI_INDIR.ID_INDIRIZZO_BIC_SRG;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

/********************************************************************************/
/* STEP 1.27.1 INSERISCO I DATI NUOVI O VARIATI NELLA TABELLA ASSOC_CLI_INDIR */
/********************************************************************************/

INSERT INTO BIC_ODS.ASSOC_CLI_INDIR
SELECT
CMS.ID_INDIRIZZO_BIC_CMS AS ID_INDIRIZZO_BIC_SRG,
CMS.COD_SISTEMA_SORGENTE AS COD_SISTEMA_SORGENTE,
CMS.ID_CLIENTE_CMS AS COD_CLIENTE_SORGENTE,
CMS.ID_INDIRIZZO_SAP AS NUMERO_INDIRIZZO,
12 AS ID_TIPO_RIFERIMENTO_INDIRIZZO,
KA.AFFIDABILITA_INDIRIZZO AS PRIORITA ,
CURRENT_TIMESTAMP(0) AS DS_TIMESTAMP
FROM BIC_ODS_SA.CMS_INDIRIZZO CMS
INNER JOIN BIC_ODS.KEY_MAP_AFFIDABILITA KA
ON KA.COD_SISTEMA_SORGENTE=CMS.COD_SISTEMA_SORGENTE
AND KA.TIPO_CLIENTE_DPR=CMS.TIPO_CLIENTE_DPR
LEFT JOIN BIC_ODS.ASSOC_CLI_INDIR K
ON K.COD_CLIENTE_SORGENTE=CMS.ID_CLIENTE_CMS
AND K.COD_SISTEMA_SORGENTE=CMS.COD_SISTEMA_SORGENTE
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO=12
WHERE CMS.DATA_FINE_VALIDITA='2999-12-31'
AND K.COD_CLIENTE_SORGENTE IS NULL 
AND K.COD_SISTEMA_SORGENTE IS NULL 
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO IS NULL 
AND K.NUMERO_INDIRIZZO IS NULL 
;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

/********************************************************/
/********************************************************/
/*                   1.28 PRONA                           */
/********************************************************/
/********************************************************/

.LABEL LEGGI_PRONA

SELECT MAX(TS_ULT_MOD) DATA_MAX 
FROM BIC_ODS_SA.PRONA_INDIRIZZO 
WHERE DATA_FINE_VALIDITA='2999-12-31'
HAVING MAX(TS_ULT_MOD) >(
SELECT COALESCE(MAX(DS_TIMESTAMP ),CAST ( '1900-01-01 00:00:01' AS TIMESTAMP (0)))   FROM BIC_ODS.ASSOC_CLI_INDIR
WHERE COD_SISTEMA_SORGENTE='PRONA');

.IF ACTIVITYCOUNT = 0 THEN .GOTO LEGGI_MICRO

/*****************************************************************************************************/
/* STEP 1.28.0 CANCELLO I RECORD CHE VANNO MODIFICATI PER PRONTISSIMO AFFARI                      **** */
/*****************************************************************************************************/

DEL FROM BIC_ODS.ASSOC_CLI_INDIR
, BIC_ODS_SA.PRONA_INDIRIZZO PRONA
 WHERE BIC_ODS.ASSOC_CLI_INDIR.COD_CLIENTE_SORGENTE=PRONA.NUMERO_PRATICA
   AND BIC_ODS.ASSOC_CLI_INDIR.COD_SISTEMA_SORGENTE=PRONA.COD_SISTEMA_SORGENTE
   AND BIC_ODS.ASSOC_CLI_INDIR.ID_TIPO_RIFERIMENTO_INDIRIZZO=PRONA.TIPO_RIFERIMENTO_INDIRIZZO
   AND PRONA.DATA_FINE_VALIDITA = '2999-12-31'
   AND PRONA.ID_INDIRIZZO_BIC_PRONA <> BIC_ODS.ASSOC_CLI_INDIR.ID_INDIRIZZO_BIC_SRG
;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

/********************************************************************************/
/* STEP 1.28.1 INSERISCO I DATI NUOVI O VARIATI                                 */
/********************************************************************************/

INSERT INTO BIC_ODS.ASSOC_CLI_INDIR
SELECT   PRONA.ID_INDIRIZZO_BIC_PRONA AS ID_INDIRIZZO_BIC_SRG,
       PRONA.COD_SISTEMA_SORGENTE AS COD_SISTEMA_SORGENTE,
       PRONA.NUMERO_PRATICA AS COD_CLIENTE_SORGENTE,
       NULL AS NUMERO_INDIRIZZO,
       PRONA.TIPO_RIFERIMENTO_INDIRIZZO AS ID_TIPO_RIFERIMENTO_INDIRIZZO,
       KA.AFFIDABILITA_INDIRIZZO AS PRIORITA ,
       CURRENT_TIMESTAMP(0) AS DS_TIMESTAMP
  FROM BIC_ODS_SA.PRONA_INDIRIZZO PRONA
  INNER JOIN BIC_ODS.KEY_MAP_AFFIDABILITA KA
ON KA.COD_SISTEMA_SORGENTE=PRONA.COD_SISTEMA_SORGENTE
AND KA.TIPO_CLIENTE_DPR=PRONA.TIPO_CLIENTE_DPR
       LEFT JOIN BIC_ODS.ASSOC_CLI_INDIR K
       ON K.COD_CLIENTE_SORGENTE=PRONA.NUMERO_PRATICA
       AND K.COD_SISTEMA_SORGENTE=PRONA.COD_SISTEMA_SORGENTE
       AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO=PRONA.TIPO_RIFERIMENTO_INDIRIZZO
 WHERE PRONA.DATA_FINE_VALIDITA='2999-12-31'
   AND PRONA.INDIRIZZO_CONCATENATO <> 'ND ND 99999 ND ZZ'
AND K.COD_CLIENTE_SORGENTE IS NULL 
AND K.COD_SISTEMA_SORGENTE IS NULL 
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO IS NULL 
AND K.NUMERO_INDIRIZZO IS NULL 
;

.IF ERRORLEVEL > 0 THEN .QUIT 16;


/********************************************************/
/********************************************************/
/*               1.29 MICRO_CREDITO                     */
/********************************************************/
/********************************************************/

.LABEL LEGGI_MICRO

SEL MAX(TS_ULT_MOD) DATA_MAX FROM BIC_ODS_SA.MICRO_INDIRIZZO 
WHERE DATA_FINE_VALIDITA='2999-12-31'
HAVING MAX(TS_ULT_MOD) >(
SEL COALESCE(MAX(DS_TIMESTAMP ),CAST ( '1900-01-01 00:00:01' AS TIMESTAMP (0))) FROM BIC_ODS.ASSOC_CLI_INDIR
WHERE COD_SISTEMA_SORGENTE='MICRO'  );
   

.IF ACTIVITYCOUNT = 0 THEN .GOTO LEGGI_FINE

/****************************************************************/
/* STEP 1.29.0 CANCELLO I RECORD CHE VANNO MODIFICATI PER MICRO   */
/****************************************************************/

DEL FROM BIC_ODS.ASSOC_CLI_INDIR
, BIC_ODS_SA.MICRO_INDIRIZZO MICRO
WHERE BIC_ODS.ASSOC_CLI_INDIR.COD_CLIENTE_SORGENTE=MICRO.NUMERO_PRATICA
AND BIC_ODS.ASSOC_CLI_INDIR.COD_SISTEMA_SORGENTE=MICRO.COD_SISTEMA_SORGENTE
AND BIC_ODS.ASSOC_CLI_INDIR.ID_TIPO_RIFERIMENTO_INDIRIZZO=MICRO.TIPO_RIFERIMENTO_INDIRIZZO
AND MICRO.DATA_FINE_VALIDITA = '2999-12-31'
AND MICRO.ID_INDIRIZZO_BIC_MICRO <> BIC_ODS.ASSOC_CLI_INDIR.ID_INDIRIZZO_BIC_SRG;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

/******************************************************************************/
/*              STEP 1.29.1 INSERISCO I DATI NUOVI O VARIATI                  */
/******************************************************************************/

INSERT INTO BIC_ODS.ASSOC_CLI_INDIR
SELECT
MICRO.ID_INDIRIZZO_BIC_MICRO AS ID_INDIRIZZO_BIC_SRG,
MICRO.COD_SISTEMA_SORGENTE AS COD_SISTEMA_SORGENTE,
MICRO.NUMERO_PRATICA AS COD_CLIENTE_SORGENTE,
NULL AS NUMERO_INDIRIZZO,
MICRO.TIPO_RIFERIMENTO_INDIRIZZO AS ID_TIPO_RIFERIMENTO_INDIRIZZO,
KA.AFFIDABILITA_INDIRIZZO AS PRIORITA ,
CURRENT_TIMESTAMP(0) AS DS_TIMESTAMP
FROM BIC_ODS_SA.MICRO_INDIRIZZO MICRO
INNER JOIN BIC_ODS.KEY_MAP_AFFIDABILITA KA
ON KA.COD_SISTEMA_SORGENTE=MICRO.COD_SISTEMA_SORGENTE
AND KA.TIPO_CLIENTE_DPR=MICRO.TIPO_CLIENTE_DPR
LEFT JOIN BIC_ODS.ASSOC_CLI_INDIR K
ON K.COD_CLIENTE_SORGENTE=MICRO.NUMERO_PRATICA
AND K.COD_SISTEMA_SORGENTE=MICRO.COD_SISTEMA_SORGENTE
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO=MICRO.TIPO_RIFERIMENTO_INDIRIZZO
WHERE MICRO.DATA_FINE_VALIDITA='2999-12-31'
AND MICRO.INDIRIZZO_CONCATENATO <> 'ND ND 99999 ND ZZ'
AND K.COD_CLIENTE_SORGENTE IS NULL 
AND K.COD_SISTEMA_SORGENTE IS NULL 
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO IS NULL 
AND K.NUMERO_INDIRIZZO IS NULL 
;

.IF ERRORLEVEL > 0 THEN .QUIT 16;


.LABEL LEGGI_FINE
.SET ERRORLEVEL 7595 SEVERITY 10;

.LOGOFF;

.QUIT;