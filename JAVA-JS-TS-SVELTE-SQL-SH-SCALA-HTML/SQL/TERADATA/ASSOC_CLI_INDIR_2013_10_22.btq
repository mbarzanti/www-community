/********************************************************/
/********************************************************/

DEL FROM BIC_ODS.ASSOC_CLI_INDIR
,BIC_ODS_SA.PTITW_INDIRIZZO PTITW
WHERE BIC_ODS.ASSOC_CLI_INDIR.COD_CLIENTE_SORGENTE=CAST(PTITW.UID AS VARCHAR(60))
AND BIC_ODS.ASSOC_CLI_INDIR.COD_SISTEMA_SORGENTE=PTITW.COD_SISTEMA_SORGENTE
AND BIC_ODS.ASSOC_CLI_INDIR.ID_TIPO_RIFERIMENTO_INDIRIZZO=PTITW.TIPO_RIFERIMENTO_INDIRIZZO
AND PTITW.DATA_FINE_VALIDITA = '2999-12-31'
AND PTITW.ID_INDIRIZZO_BIC_PTITW <> BIC_ODS.ASSOC_CLI_INDIR.ID_INDIRIZZO_BIC_SRG;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

/********************************************************************************/
/* STEP 1.24.1 INSERISCO I DATI NUOVI O VARIATI NELLA TABELLA ASSOC_CLI_INDIR */
/********************************************************************************/

INSERT INTO BIC_ODS.ASSOC_CLI_INDIR
SELECT
PTITW.ID_INDIRIZZO_BIC_PTITW AS ID_INDIRIZZO_BIC_SRG,
PTITW.COD_SISTEMA_SORGENTE AS COD_SISTEMA_SORGENTE,
CAST(PTITW.UID AS VARCHAR(60)) AS COD_CLIENTE_SORGENTE,
NULL AS NUMERO_INDIRIZZO ,
PTITW.TIPO_RIFERIMENTO_INDIRIZZO AS ID_TIPO_RIF_INDIRIZZO,
KA.AFFIDABILITA_INDIRIZZO AS PRIORITA ,
CURRENT_TIMESTAMP(0) AS DS_TIMESTAMP
FROM 
BIC_ODS_SA.PTITW_INDIRIZZO PTITW
INNER JOIN BIC_ODS.KEY_MAP_AFFIDABILITA KA
ON KA.COD_SISTEMA_SORGENTE=PTITW.COD_SISTEMA_SORGENTE
AND KA.TIPO_CLIENTE_DPR=PTITW.TIPO_CLIENTE_DPR
LEFT OUTER JOIN BIC_ODS.ASSOC_CLI_INDIR K
ON CAST(PTITW.UID AS VARCHAR(60)) = K.COD_CLIENTE_SORGENTE
AND PTITW.COD_SISTEMA_SORGENTE = K.COD_SISTEMA_SORGENTE
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO= PTITW.TIPO_RIFERIMENTO_INDIRIZZO
WHERE PTITW.DATA_FINE_VALIDITA='2999-12-31'
AND K.COD_CLIENTE_SORGENTE IS NULL 
AND K.COD_SISTEMA_SORGENTE IS NULL 
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO IS NULL 
AND K.NUMERO_INDIRIZZO IS NULL 
;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

/********************************************************/
/********************************************************/
/*                  1.25 PTITO                          */
/********************************************************/
/********************************************************/

.LABEL LEGGI_PTITO

SEL MAX(TS_ULT_MOD) DATA_MAX FROM BIC_ODS_SA.PTITO_INDIRIZZO
WHERE DATA_FINE_VALIDITA='2999-12-31'
HAVING MAX(TS_ULT_MOD) >(
SEL COALESCE(MAX(DS_TIMESTAMP),CAST('1900-01-01 00:00:00' AS TIMESTAMP (0))) FROM BIC_ODS.ASSOC_CLI_INDIR
WHERE COD_SISTEMA_SORGENTE='PTITO' );

.IF ACTIVITYCOUNT = 0 THEN .GOTO LEGGI_GIFT

/********************************************************/
/* STEP 1.25.0 CANCELLO I RECORD CHE VANNO MODIFICATI PER PTITO */
/********************************************************/
/********************************************************/

DEL FROM BIC_ODS.ASSOC_CLI_INDIR
, BIC_ODS_SA.PTITO_INDIRIZZO PTITO
WHERE BIC_ODS.ASSOC_CLI_INDIR.COD_CLIENTE_SORGENTE=CAST(PTITO.UID AS VARCHAR(60))
AND BIC_ODS.ASSOC_CLI_INDIR.COD_SISTEMA_SORGENTE=PTITO.COD_SISTEMA_SORGENTE
AND BIC_ODS.ASSOC_CLI_INDIR.ID_TIPO_RIFERIMENTO_INDIRIZZO=2
AND PTITO.DATA_FINE_VALIDITA = '2999-12-31'
AND PTITO.ID_INDIRIZZO_BIC_PTITO <> BIC_ODS.ASSOC_CLI_INDIR.ID_INDIRIZZO_BIC_SRG;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

/********************************************************************************/
/* STEP 1.25.1 INSERISCO I DATI NUOVI O VARIATI NELLA TABELLA ASSOC_CLI_INDIR */
/********************************************************************************/

INSERT INTO BIC_ODS.ASSOC_CLI_INDIR
SELECT
PTITO.ID_INDIRIZZO_BIC_PTITO AS ID_INDIRIZZO_BIC_SRG,
PTITO.COD_SISTEMA_SORGENTE AS COD_SISTEMA_SORGENTE,
CAST(PTITO.UID AS VARCHAR(60)) AS COD_CLIENTE_SORGENTE,
NULL AS NUMERO_INDIRIZZO ,
2 AS ID_TIPO_RIF_INDIRIZZO,
KA.AFFIDABILITA_INDIRIZZO AS PRIORITA ,
CURRENT_TIMESTAMP(0) AS DS_TIMESTAMP
FROM 
BIC_ODS_SA.PTITO_INDIRIZZO PTITO
INNER JOIN BIC_ODS.KEY_MAP_AFFIDABILITA KA
ON KA.COD_SISTEMA_SORGENTE=PTITO.COD_SISTEMA_SORGENTE
AND KA.TIPO_CLIENTE_DPR=PTITO.TIPO_CLIENTE_DPR
LEFT OUTER JOIN BIC_ODS.ASSOC_CLI_INDIR K
ON CAST(PTITO.UID AS VARCHAR(60)) = K.COD_CLIENTE_SORGENTE
AND PTITO.COD_SISTEMA_SORGENTE = K.COD_SISTEMA_SORGENTE
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO= 2
WHERE PTITO.DATA_FINE_VALIDITA='2999-12-31'
AND K.COD_CLIENTE_SORGENTE IS NULL 
AND K.COD_SISTEMA_SORGENTE IS NULL 
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO IS NULL 
AND K.NUMERO_INDIRIZZO IS NULL 
;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

/********************************************************/
/********************************************************/
/*                   1.14 GIFT                           */
/********************************************************/
/********************************************************/

.LABEL LEGGI_GIFT

SEL MAX(TS_ULT_MOD) DATA_MAX FROM BIC_ODS_SA.GIFT_INDIRIZZO
WHERE DATA_FINE_VALIDITA='2999-12-31'
HAVING MAX(TS_ULT_MOD) >(
SEL COALESCE(MAX(DS_TIMESTAMP),CAST('1900-01-01 00:00:00' AS TIMESTAMP (0))) FROM BIC_ODS.ASSOC_CLI_INDIR
WHERE COD_SISTEMA_SORGENTE='GIFT');

.IF ACTIVITYCOUNT = 0 THEN .GOTO LEGGI_CMS

/*****************************************************************************************************/
/* STEP 1.26.0 CARICAMENTO TABELLA BIC_ODS_SA.ASSOC_CLI_INDIR */
/* 				UPDATE  VARIATI  RELATIVI A GIFT */
/*****************************************************************************************************/

DEL FROM BIC_ODS.ASSOC_CLI_INDIR
, BIC_ODS_SA.GIFT_INDIRIZZO GIFT 
WHERE BIC_ODS.ASSOC_CLI_INDIR.COD_CLIENTE_SORGENTE=GIFT.NUMERO_CARTA
AND BIC_ODS.ASSOC_CLI_INDIR.COD_SISTEMA_SORGENTE=GIFT.COD_SISTEMA_SORGENTE
AND BIC_ODS.ASSOC_CLI_INDIR.ID_TIPO_RIFERIMENTO_INDIRIZZO= 2
AND GIFT.DATA_FINE_VALIDITA = '2999-12-31'
AND GIFT.ID_INDIRIZZO_BIC_GIFT <> BIC_ODS.ASSOC_CLI_INDIR.ID_INDIRIZZO_BIC_SRG;

.IF ERRORLEVEL > 0 THEN .QUIT 16;
/*****************************************************************************************************/
/* STEP 1.26.1 CARICAMENTO TABELLA BIC_ODS_SA.ASSOC_CLI_INDIR */
/* INSERISCO IN TABELLA I NUOVI  RELATIVI A GIFT * /
/****************************************************************************************************/

INSERT INTO BIC_ODS.ASSOC_CLI_INDIR
SELECT
GIFT.ID_INDIRIZZO_BIC_GIFT AS ID_INDIRIZZO_BIC_SRG,
GIFT.COD_SISTEMA_SORGENTE AS  COD_SISTEMA_SORGENTE,
GIFT.NUMERO_CARTA  AS COD_CLIENTE_SORGENTE,
NULL AS NUMERO_INDIRIZZO ,
2 AS ID_TIPO_RIF_INDIRIZZO,
KA.AFFIDABILITA_INDIRIZZO AS PRIORITA ,
CURRENT_TIMESTAMP(0) AS DS_TIMESTAMP
FROM 
BIC_ODS_SA.GIFT_INDIRIZZO GIFT
INNER JOIN BIC_ODS.KEY_MAP_AFFIDABILITA KA
ON KA.COD_SISTEMA_SORGENTE=GIFT.COD_SISTEMA_SORGENTE
AND KA.TIPO_CLIENTE_DPR=GIFT.TIPO_CLIENTE_DPR
LEFT OUTER JOIN BIC_ODS.ASSOC_CLI_INDIR K
ON GIFT.NUMERO_CARTA = K.COD_CLIENTE_SORGENTE
AND GIFT.COD_SISTEMA_SORGENTE = K.COD_SISTEMA_SORGENTE
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO= 2
WHERE GIFT.DATA_FINE_VALIDITA='2999-12-31'
AND K.COD_CLIENTE_SORGENTE IS NULL 
AND K.COD_SISTEMA_SORGENTE IS NULL 
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO IS NULL 
AND K.NUMERO_INDIRIZZO IS NULL 
AND  GIFT.ID_INDIRIZZO_BIC_GIFT  IS NOT NULL
;

.IF ERRORLEVEL > 0 THEN .QUIT 16;
  

/********************************************************/
/********************************************************/
/*                   1.27 CMS                           */
/********************************************************/
/********************************************************/

.LABEL LEGGI_CMS

SEL MAX(TS_ULT_MOD) DATA_MAX FROM BIC_ODS_SA.CMS_INDIRIZZO WHERE DATA_FINE_VALIDITA='2999-12-31'
HAVING MAX(TS_ULT_MOD) >(
SEL COALESCE(MAX(DS_TIMESTAMP),CAST('1900-01-01 00:00:00' AS TIMESTAMP (0))) FROM BIC_ODS.ASSOC_CLI_INDIR
WHERE COD_SISTEMA_SORGENTE='CMS'  );


.IF ACTIVITYCOUNT = 0 THEN .GOTO LEGGI_PRONA

--CREO LA TABELLA VOLATILE DEGLI INDIRIZZO CRM CHIUSI

/*CREATE VOLATILE TABLE CHIUSI_CMS AS (
