
.SET ERROROUT STDOUT
.SET WIDTH 240;

/* CREATO IL 17-07-2013
IL BTEQ CARICA LA TABELLA ASSOC_CLI_INDIR
*/

/***************************************************/
/* CANCELLO PREVENTIVAMENTE LA TABELLA DI APPOGGIO */
/***************************************************/
.SET ERRORLEVEL 7595 SEVERITY 0;


.SET ERRORLEVEL 3803 SEVERITY 10;
.SET ERRORLEVEL 3807 SEVERITY 10;




/********************************************************/
/********************************************************/
/*                   1.1  NDB                            */
/********************************************************/
/********************************************************/
SEL MAX(TS_ULT_MOD) DATA_MAX FROM BIC_ODS_SA.NDB_INDIRIZZO WHERE DATA_FINE_VALIDITA='2999-12-31'
HAVING MAX(TS_ULT_MOD) >(SEL COALESCE(MAX(DS_TIMESTAMP),CAST('1900-01-01 00:00:00' AS TIMESTAMP (0))) FROM BIC_ODS.ASSOC_CLI_INDIR
WHERE COD_SISTEMA_SORGENTE='NDB' );


.IF ACTIVITYCOUNT = 0 THEN .GOTO LEGGI_BP

/*****************************************************************************/
/* STEP 1.3.0 CANCELLO I RECORD CHE VANNO MODIFICATI PER NDB */
/*****************************************************************************/

DEL FROM BIC_ODS.ASSOC_CLI_INDIR
,BIC_ODS_SA.NDB_INDIRIZZO NDB
WHERE BIC_ODS.ASSOC_CLI_INDIR.COD_CLIENTE_SORGENTE=NDB.IDCLIENTE
AND BIC_ODS.ASSOC_CLI_INDIR.COD_SISTEMA_SORGENTE=NDB.COD_SISTEMA_SORGENTE
AND BIC_ODS.ASSOC_CLI_INDIR.ID_TIPO_RIFERIMENTO_INDIRIZZO= NDB.ID_TIPO_RIFERIMENTO_INDIRIZZO 
AND COALESCE(TRIM(NDB.IDRIFERIMENTOCLIENTE)||TRIM(NDB.IDTIPORIFERIMENTO),'ND')=COALESCE(BIC_ODS.ASSOC_CLI_INDIR.NUMERO_INDIRIZZO,'ND')
AND NDB.DATA_FINE_VALIDITA = '2999-12-31'
AND (NDB.ID_INDIRIZZO_BIC_NDB <> BIC_ODS.ASSOC_CLI_INDIR.ID_INDIRIZZO_BIC_SRG ) ;


.IF ERRORLEVEL > 0 THEN .QUIT 16;

/*****************************************************************************/
/* STEP 1.3.1 INSERISCO I DATI NUOVI O VARIATI NDB */
/*****************************************************************************/
INSERT INTO BIC_ODS.ASSOC_CLI_INDIR
SELECT
NDB.ID_INDIRIZZO_BIC_NDB AS ID_INDIRIZZO_BIC_SRG,
NDB.COD_SISTEMA_SORGENTE AS COD_SISTEMA_SORGENTE,
CAST(NDB.IDCLIENTE AS VARCHAR(60)) AS COD_CLIENTE_SORGENTE,
TRIM(NDB.IDRIFERIMENTOCLIENTE)||TRIM(NDB.IDTIPORIFERIMENTO) AS NUMERO_INDIRIZZO,
NDB.ID_TIPO_RIFERIMENTO_INDIRIZZO AS ID_TIPO_RIFERIMENTO_INDIRIZZO,
KA.AFFIDABILITA_INDIRIZZO AS PRIORITA ,
CURRENT_TIMESTAMP(0) AS DS_TIMESTAMP
FROM BIC_ODS_SA.NDB_INDIRIZZO NDB
INNER JOIN BIC_ODS.KEY_MAP_AFFIDABILITA KA
ON NDB.COD_SISTEMA_SORGENTE=NDB.COD_SISTEMA_SORGENTE
AND NDB.TIPO_CLIENTE_DPR=NDB.TIPO_CLIENTE_DPR
LEFT OUTER JOIN BIC_ODS.ASSOC_CLI_INDIR K
ON CAST(NDB.IDCLIENTE AS VARCHAR(60)) = K.COD_CLIENTE_SORGENTE
AND NDB.COD_SISTEMA_SORGENTE = K.COD_SISTEMA_SORGENTE
AND TRIM(NDB.IDRIFERIMENTOCLIENTE)||TRIM(NDB.IDTIPORIFERIMENTO) = K.NUMERO_INDIRIZZO
AND NDB.ID_TIPO_RIFERIMENTO_INDIRIZZO = K.ID_TIPO_RIFERIMENTO_INDIRIZZO
WHERE NDB.DATA_FINE_VALIDITA='2999-12-31'
AND K.COD_CLIENTE_SORGENTE IS NULL 
AND K.COD_SISTEMA_SORGENTE IS NULL 
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO IS NULL 
AND K.NUMERO_INDIRIZZO IS NULL 
;



.IF ERRORLEVEL > 0 THEN .QUIT 16;


.LABEL LEGGI_BP
/********************************************************/
/********************************************************/
/*                   1.2 BP                             */
/********************************************************/
/********************************************************/

SEL MAX(TS_ULT_MOD) DATA_MAX FROM BIC_ODS_SA.BP_INDIRIZZO WHERE DATA_FINE_VALIDITA='2999-12-31'
HAVING MAX(TS_ULT_MOD) >(
SEL COALESCE(MAX(DS_TIMESTAMP),CAST('1900-01-01 00:00:00' AS TIMESTAMP (0))) FROM BIC_ODS.ASSOC_CLI_INDIR
WHERE COD_SISTEMA_SORGENTE='BP'  );

.IF ACTIVITYCOUNT = 0 THEN .GOTO LEGGI_SAP

/**************************************************************/
/*  STEP 1.2.0 CANCELLO I RECORD CHE VANNO MODIFICATI PER BP   **/
/**************************************************************/

LOCKING BIC_ODS_SA.BP_INDIRIZZO FOR ACCESS
LOCKING BIC_ODS.ASSOC_CLI_INDIR FOR ACCESS

DEL FROM BIC_ODS.ASSOC_CLI_INDIR
,BIC_ODS_SA.BP_INDIRIZZO BP 
WHERE  BIC_ODS.ASSOC_CLI_INDIR.COD_CLIENTE_SORGENTE=BP.NDG
AND BIC_ODS.ASSOC_CLI_INDIR.COD_SISTEMA_SORGENTE=BP.COD_SISTEMA_SORGENTE
AND BIC_ODS.ASSOC_CLI_INDIR.ID_TIPO_RIFERIMENTO_INDIRIZZO=BP.TIPO_RIFERIMENTO_INDIRIZZO
AND BP.DATA_FINE_VALIDITA = '2999-12-31'
AND COALESCE(NUMERO_INDIRIZZO,'')=COALESCE(BP.NUMERO_RAPPORTO,'')
AND (BP.ID_INDIRIZZO_BIC_BP <> BIC_ODS.ASSOC_CLI_INDIR.ID_INDIRIZZO_BIC_SRG OR BP.DATA_CHIUSURA_O_ESTINZIONE IS NOT NULL) /*CANCELLO ANCHE GLI INDIRIZZI APPARTENENTI A RAPPORTI ESTINTI O CON DATA CHIUSURA VALORIZZATA*/
AND (NDG,BP.COD_SISTEMA_SORGENTE,ID_INDIRIZZO_BIC_BP)NOT IN (SEL '000038259854','BP','33433282') /*GESTISCO GLI INDIRIZZI UGUALI DEL FONDO UNICO DI GIUSTIZIA*/
AND (NDG,BP.COD_SISTEMA_SORGENTE,ID_INDIRIZZO_BIC_BP)NOT IN (SEL '000038259854','BP','19203583') ;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

/******************************************************************/
/*     STEP 1.2.1 INSERISCO I DATI NUOVI O VARIATI BANCOPOSTA     */
/******************************************************************/

INSERT INTO BIC_ODS.ASSOC_CLI_INDIR
SELECT
BP.ID_INDIRIZZO_BIC_BP AS ID_INDIRIZZO_BIC_SRG,
BP.COD_SISTEMA_SORGENTE AS COD_SISTEMA_SORGENTE,
BP.NDG AS COD_CLIENTE_SORGENTE,
BP.NUMERO_RAPPORTO AS NUMERO_INDIRIZZO,
BP.TIPO_RIFERIMENTO_INDIRIZZO AS ID_TIPO_RIFERIMENTO_INDIRIZZO,
KA.AFFIDABILITA_INDIRIZZO AS PRIORITA ,
CURRENT_TIMESTAMP(0) AS DS_TIMESTAMP
FROM BIC_ODS_SA.BP_INDIRIZZO BP
INNER JOIN BIC_ODS.KEY_MAP_AFFIDABILITA KA
ON KA.COD_SISTEMA_SORGENTE=BP.COD_SISTEMA_SORGENTE
AND KA.TIPO_CLIENTE_DPR=BP.TIPO_CLIENTE_DPR
LEFT JOIN BIC_ODS.ASSOC_CLI_INDIR K
ON K.COD_CLIENTE_SORGENTE=BP.NDG
AND K.COD_SISTEMA_SORGENTE=BP.COD_SISTEMA_SORGENTE
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO=BP.TIPO_RIFERIMENTO_INDIRIZZO
AND COALESCE(K.NUMERO_INDIRIZZO,'')=COALESCE(BP.NUMERO_RAPPORTO,'')
WHERE BP.DATA_FINE_VALIDITA='2999-12-31'
AND  BP.DATA_CHIUSURA_O_ESTINZIONE IS NULL
AND  (NDG,BP.COD_SISTEMA_SORGENTE,ID_INDIRIZZO_BIC_BP)NOT IN (SEL '000038259854','BP','33433282') /*GESTISCO GLI INDIRIZZI UGUALI DEL FONDO UNICO DI GIUSTIZIA*/
AND (NDG,BP.COD_SISTEMA_SORGENTE,ID_INDIRIZZO_BIC_BP)NOT IN (SEL '000038259854','BP','19203583')
AND K.COD_CLIENTE_SORGENTE IS NULL 
AND K.COD_SISTEMA_SORGENTE IS NULL 
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO IS NULL 
AND K.NUMERO_INDIRIZZO IS NULL 
;

.IF ERRORLEVEL > 0 THEN .QUIT 16;


/********************************************************/
/*                   1.3 SAP                            */
/********************************************************/

.LABEL LEGGI_SAP

SEL MAX(TS_ULT_MOD) DATA_MAX FROM BIC_ODS_SA.SAP_INDIRIZZO WHERE DATA_FINE_VALIDITA='2999-12-31'
HAVING MAX(TS_ULT_MOD) >(
SEL COALESCE(MAX(DS_TIMESTAMP),CAST('1900-01-01 00:00:00' AS TIMESTAMP (0))) FROM BIC_ODS.ASSOC_CLI_INDIR
WHERE COD_SISTEMA_SORGENTE='SAP'  );

.IF ACTIVITYCOUNT = 0 THEN .GOTO LEGGI_AGOS


/*****************************************************************************/
/* STEP 1.3.0 CANCELLO I RECORD CHE VANNO MODIFICATI PER SAP */
/*****************************************************************************/

DEL FROM BIC_ODS.ASSOC_CLI_INDIR
,BIC_ODS_SA.SAP_INDIRIZZO SAP
WHERE BIC_ODS.ASSOC_CLI_INDIR.COD_CLIENTE_SORGENTE=SAP.CODICE_CLIENTE
AND BIC_ODS.ASSOC_CLI_INDIR.COD_SISTEMA_SORGENTE=SAP.COD_SISTEMA_SORGENTE
AND BIC_ODS.ASSOC_CLI_INDIR.ID_TIPO_RIFERIMENTO_INDIRIZZO= SAP.ID_TIPO_RIFERIMENTO_INDIRIZZO /*ID_TIPO_RIFERIMENTO_INDIRIZZO IN (7,5)*/
AND COALESCE(SAP.CODICE_INDIRIZZO,'ND')=COALESCE(BIC_ODS.ASSOC_CLI_INDIR.NUMERO_INDIRIZZO,'ND')
AND SAP.DATA_FINE_VALIDITA = '2999-12-31'
AND (SAP.ID_INDIRIZZO_BIC_SAP <> BIC_ODS.ASSOC_CLI_INDIR.ID_INDIRIZZO_BIC_SRG OR SAP.ARCHIVIAZIONE_BP IS NOT NULL) ;



.IF ERRORLEVEL > 0 THEN .QUIT 16;

/*****************************************************************************/
/* STEP 1.3.1 INSERISCO I DATI NUOVI O VARIATI NELLA TABELLA ASSOC_CLI_INDIR */
/*****************************************************************************/
INSERT INTO BIC_ODS.ASSOC_CLI_INDIR
SELECT
SAP.ID_INDIRIZZO_BIC_SAP AS ID_INDIRIZZO_BIC_SRG,
SAP.COD_SISTEMA_SORGENTE AS COD_SISTEMA_SORGENTE,
SAP.CODICE_CLIENTE AS COD_CLIENTE_SORGENTE,
SAP.CODICE_INDIRIZZO AS NUMERO_INDIRIZZO,
SAP.ID_TIPO_RIFERIMENTO_INDIRIZZO AS ID_TIPO_RIFERIMENTO_INDIRIZZO,/*7,5)*/
KA.AFFIDABILITA_INDIRIZZO AS PRIORITA ,
CURRENT_TIMESTAMP(0) AS DS_TIMESTAMP
FROM BIC_ODS_SA.SAP_INDIRIZZO SAP
INNER JOIN BIC_ODS.KEY_MAP_AFFIDABILITA KA
ON KA.COD_SISTEMA_SORGENTE=SAP.COD_SISTEMA_SORGENTE
AND KA.TIPO_CLIENTE_DPR=SAP.TIPO_CLIENTE_DPR
LEFT OUTER JOIN BIC_ODS.ASSOC_CLI_INDIR K
ON SAP.CODICE_CLIENTE = K.COD_CLIENTE_SORGENTE
AND SAP.COD_SISTEMA_SORGENTE = K.COD_SISTEMA_SORGENTE
AND TRIM(COALESCE (SAP.CODICE_INDIRIZZO, 'ND'))=TRIM(COALESCE(K.NUMERO_INDIRIZZO, 'ND'))
AND SAP.ID_TIPO_RIFERIMENTO_INDIRIZZO = K.ID_TIPO_RIFERIMENTO_INDIRIZZO
WHERE SAP.DATA_FINE_VALIDITA='2999-12-31'
AND SAP.ARCHIVIAZIONE_BP IS NULL
AND K.COD_CLIENTE_SORGENTE IS NULL 
AND K.COD_SISTEMA_SORGENTE IS NULL 
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO IS NULL 
AND K.NUMERO_INDIRIZZO IS NULL 
;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

/********************************************************/
/********************************************************/
/*                   1.4 AGOS                           */
/********************************************************/
/********************************************************/

.LABEL LEGGI_AGOS

SEL MAX(TS_ULT_MOD) DATA_MAX FROM BIC_ODS_SA.AGOS_INDIRIZZO WHERE DATA_FINE_VALIDITA = '2999-12-31'
HAVING MAX(TS_ULT_MOD) >(
SEL COALESCE(MAX(DS_TIMESTAMP),CAST('1900-01-01 00:00:00' AS TIMESTAMP (0))) FROM BIC_ODS.ASSOC_CLI_INDIR
WHERE COD_SISTEMA_SORGENTE = 'AGOS');

.IF ACTIVITYCOUNT = 0 THEN .GOTO LEGGI_DUNS

/**************************************************************/
/* STEP 1.4.0 CANCELLO I RECORD CHE VANNO MODIFICATI PER AGOS  **/
/**************************************************************/

DEL FROM BIC_ODS.ASSOC_CLI_INDIR
,BIC_ODS_SA.AGOS_INDIRIZZO AGOS
WHERE BIC_ODS.ASSOC_CLI_INDIR.COD_CLIENTE_SORGENTE=AGOS.COD_CARTA
AND BIC_ODS.ASSOC_CLI_INDIR.COD_SISTEMA_SORGENTE=AGOS.COD_SISTEMA_SORGENTE
AND BIC_ODS.ASSOC_CLI_INDIR.ID_TIPO_RIFERIMENTO_INDIRIZZO = 2
AND AGOS.DATA_FINE_VALIDITA = '2999-12-31'
AND AGOS.ID_INDIRIZZO_BIC_AGOS <> BIC_ODS.ASSOC_CLI_INDIR.ID_INDIRIZZO_BIC_SRG;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

/*********************************************************************/
/* STEP 1.4.1 INSERISCO I DATI NUOVI O VARIATI RELATIVI A CARTE AGOS */
/*********************************************************************/

INSERT INTO BIC_ODS.ASSOC_CLI_INDIR
SELECT
AGOS.ID_INDIRIZZO_BIC_AGOS AS ID_INDIRIZZO_BIC_SRG,
AGOS.COD_SISTEMA_SORGENTE AS COD_SISTEMA_SORGENTE,
AGOS.COD_CARTA AS COD_CLIENTE_SORGENTE,
NULL AS NUMERO_INDIRIZZO,
2 AS ID_TIPO_RIFERIMENTO_INDIRIZZO,
KA.AFFIDABILITA_INDIRIZZO AS PRIORITA ,
CURRENT_TIMESTAMP(0) AS DS_TIMESTAMP
FROM BIC_ODS_SA.AGOS_INDIRIZZO AGOS
INNER JOIN BIC_ODS.KEY_MAP_AFFIDABILITA KA
ON KA.COD_SISTEMA_SORGENTE=AGOS.COD_SISTEMA_SORGENTE
AND KA.TIPO_CLIENTE_DPR=AGOS.TIPO_CLIENTE_DPR
LEFT JOIN BIC_ODS.ASSOC_CLI_INDIR K
 ON K.COD_CLIENTE_SORGENTE=AGOS.COD_CARTA
AND K.COD_SISTEMA_SORGENTE=AGOS.COD_SISTEMA_SORGENTE
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO = 2
WHERE AGOS.DATA_FINE_VALIDITA='2999-12-31'
AND K.COD_CLIENTE_SORGENTE IS NULL 
AND K.COD_SISTEMA_SORGENTE IS NULL 
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO IS NULL 
AND K.NUMERO_INDIRIZZO IS NULL 
;

.IF ERRORLEVEL > 0 THEN .QUIT 16;



.LABEL LEGGI_DUNS

SEL MAX(TS_ULT_MOD) DATA_MAX FROM BIC_ODS_SA.DUNS_INDIRIZZO
HAVING MAX(TS_ULT_MOD) >(
SEL COALESCE(MAX(DS_TIMESTAMP),CAST('1900-01-01 00:00:00' AS TIMESTAMP (0))) FROM BIC_ODS.ASSOC_CLI_INDIR
WHERE COD_SISTEMA_SORGENTE='DUNS') ;

.IF ACTIVITYCOUNT = 0 THEN .GOTO LEGGI_ICON

/********************************************************/
/********************************************************/
/*                   1.6 DUNS                           */
/********************************************************/
/********************************************************/

/**************************************************************/
/* STEP 1.6.0 CANCELLO I RECORD CHE VANNO MODIFICATI PER DUNS **/
/**************************************************************/

DEL FROM  BIC_ODS.ASSOC_CLI_INDIR
,BIC_ODS_SA.DUNS_INDIRIZZO DUNS
WHERE BIC_ODS.ASSOC_CLI_INDIR.COD_CLIENTE_SORGENTE=DUNS.DUNS_NUMBER
AND BIC_ODS.ASSOC_CLI_INDIR.COD_SISTEMA_SORGENTE=DUNS.COD_SISTEMA_SORGENTE
AND BIC_ODS.ASSOC_CLI_INDIR.ID_TIPO_RIFERIMENTO_INDIRIZZO=0
AND DUNS.DATA_FINE_VALIDITA = '2999-12-31'
AND DUNS.ID_INDIRIZZO_BIC_DUNS <> BIC_ODS.ASSOC_CLI_INDIR.ID_INDIRIZZO_BIC_SRG;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

/********************************************************************************/
/* STEP 1.6.1 INSERISCO I DATI NUOVI O VARIATI NELLA TABELLA ASSOC_CLI_INDIR */
/********************************************************************************/

INSERT INTO BIC_ODS.ASSOC_CLI_INDIR
SELECT
DUNS.ID_INDIRIZZO_BIC_DUNS AS ID_INDIRIZZO_BIC_SRG,
DUNS.COD_SISTEMA_SORGENTE AS COD_SISTEMA_SORGENTE,
DUNS.DUNS_NUMBER AS COD_CLIENTE_SORGENTE,
NULL AS NUMERO_INDIRIZZO,
'0' AS ID_TIPO_RIFERIMENTO_INDIRIZZO,
KA.AFFIDABILITA_INDIRIZZO AS PRIORITA ,
CURRENT_TIMESTAMP(0) AS DS_TIMESTAMP
FROM BIC_ODS_SA.DUNS_INDIRIZZO DUNS
INNER JOIN BIC_ODS.KEY_MAP_AFFIDABILITA KA
ON KA.COD_SISTEMA_SORGENTE=DUNS.COD_SISTEMA_SORGENTE
AND KA.TIPO_CLIENTE_DPR=DUNS.TIPO_CLIENTE_DPR
LEFT JOIN BIC_ODS.ASSOC_CLI_INDIR K
ON K.COD_CLIENTE_SORGENTE=DUNS.DUNS_NUMBER
AND K.COD_SISTEMA_SORGENTE=DUNS.COD_SISTEMA_SORGENTE
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO='0'
WHERE DUNS.DATA_FINE_VALIDITA='2999-12-31'
AND K.COD_CLIENTE_SORGENTE IS NULL 
AND K.COD_SISTEMA_SORGENTE IS NULL 
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO IS NULL 
AND K.NUMERO_INDIRIZZO IS NULL 
;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

/********************************************************/
/********************************************************/
/*                   1.7 ICON                           */
/********************************************************/
/********************************************************/

.LABEL LEGGI_ICON

SEL MAX(TS_ULT_MOD) DATA_MAX FROM BIC_ODS_SA.ICON_INDIRIZZO
WHERE DATA_FINE_VALIDITA='2999-12-31'
HAVING MAX(TS_ULT_MOD) >(
SEL COALESCE(MAX(DS_TIMESTAMP),CAST('1900-01-01 00:00:00' AS TIMESTAMP (0))) FROM BIC_ODS.ASSOC_CLI_INDIR
WHERE COD_SISTEMA_SORGENTE='ICON');

.IF ACTIVITYCOUNT = 0 THEN .GOTO LEGGI_LEAS 

/**************************************************************/
/* STEP 1.7.0 CANCELLO I RECORD CHE VANNO MODIFICATI PER ICON **/
/**************************************************************/

DEL FROM  BIC_ODS.ASSOC_CLI_INDIR
,BIC_ODS_SA.ICON_INDIRIZZO ICON
WHERE BIC_ODS.ASSOC_CLI_INDIR.COD_CLIENTE_SORGENTE=ICON.CODICE_FISCALE
AND BIC_ODS.ASSOC_CLI_INDIR.COD_SISTEMA_SORGENTE=ICON.COD_SISTEMA_SORGENTE
AND BIC_ODS.ASSOC_CLI_INDIR.ID_TIPO_RIFERIMENTO_INDIRIZZO=2
AND ICON.DATA_FINE_VALIDITA = '2999-12-31'
AND ICON.ID_INDIRIZZO_BIC_ICON <> BIC_ODS.ASSOC_CLI_INDIR.ID_INDIRIZZO_BIC_SRG;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

/********************************************************************************/
/* STEP 1.7.1 INSERISCO I DATI NUOVI O VARIATI NELLA TABELLA ASSOC_CLI_INDIR */
/********************************************************************************/
INSERT INTO BIC_ODS.ASSOC_CLI_INDIR
SELECT
ICON.ID_INDIRIZZO_BIC_ICON AS ID_INDIRIZZO_SORGENTE,
ICON.COD_SISTEMA_SORGENTE AS COD_SISTEMA_SORGENTE,
ICON.CODICE_FISCALE AS COD_CLIENTE_SORGENTE,
NULL AS NUMERO_INDIRIZZO,
2 AS ID_TIPO_RIFERIMENTO_INDIRIZZO,
KA.AFFIDABILITA_INDIRIZZO AS PRIORITA ,
CURRENT_TIMESTAMP(0) AS DS_TIMESTAMP
FROM BIC_ODS_SA.ICON_INDIRIZZO ICON
INNER JOIN BIC_ODS.KEY_MAP_AFFIDABILITA KA
ON KA.COD_SISTEMA_SORGENTE=ICON.COD_SISTEMA_SORGENTE
AND KA.TIPO_CLIENTE_DPR=ICON.TIPO_CLIENTE_DPR
LEFT JOIN BIC_ODS.ASSOC_CLI_INDIR K
ON K.COD_CLIENTE_SORGENTE=ICON.CODICE_FISCALE
AND K.COD_SISTEMA_SORGENTE=ICON.COD_SISTEMA_SORGENTE
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO=2
WHERE ICON.DATA_FINE_VALIDITA='2999-12-31'
AND K.COD_CLIENTE_SORGENTE IS NULL 
AND K.COD_SISTEMA_SORGENTE IS NULL 
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO IS NULL 
AND K.NUMERO_INDIRIZZO IS NULL 
;

.IF ERRORLEVEL > 0 THEN .QUIT 16;
/********************************************************/
/********************************************************/
/*                   1.8 LEAS                           */
/********************************************************/
/********************************************************/

.LABEL LEGGI_LEAS

SEL MAX(TS_ULT_MOD) DATA_MAX FROM BIC_ODS_SA.LEAS_INDIRIZZO
WHERE DATA_FINE_VALIDITA='2999-12-31' HAVING MAX(TS_ULT_MOD) >(
SEL COALESCE(MAX(DS_TIMESTAMP),CAST('1900-01-01 00:00:00' AS TIMESTAMP (0))) FROM BIC_ODS.ASSOC_CLI_INDIR
WHERE COD_SISTEMA_SORGENTE='LEAS' );

.IF ACTIVITYCOUNT = 0 THEN .GOTO LEGGI_PRONT

/**************************************************************/
/* STEP 1.8.0 CANCELLO I RECORD CHE VANNO MODIFICATI PER LEAS **/
/**************************************************************/

DEL FROM BIC_ODS.ASSOC_CLI_INDIR
,BIC_ODS_SA.LEAS_INDIRIZZO LEAS
WHERE BIC_ODS.ASSOC_CLI_INDIR.COD_CLIENTE_SORGENTE=LEAS.NUMERO_PREVENTIVO
AND BIC_ODS.ASSOC_CLI_INDIR.COD_SISTEMA_SORGENTE=LEAS.COD_SISTEMA_SORGENTE
AND BIC_ODS.ASSOC_CLI_INDIR.ID_TIPO_RIFERIMENTO_INDIRIZZO=5
AND LEAS.DATA_FINE_VALIDITA = '2999-12-31'
AND LEAS.ID_INDIRIZZO_BIC_LEAS <> BIC_ODS.ASSOC_CLI_INDIR.ID_INDIRIZZO_BIC_SRG;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

/********************************************************************************/
/* STEP 1.8.1 INSERISCO I DATI NUOVI O VARIATI NELLA TABELLA ASSOC_CLI_INDIR */
/********************************************************************************/

INSERT INTO BIC_ODS.ASSOC_CLI_INDIR
SELECT
LEAS.ID_INDIRIZZO_BIC_LEAS AS ID_INDIRIZZO_BIC_SRG,
LEAS.COD_SISTEMA_SORGENTE AS COD_SISTEMA_SORGENTE,
LEAS.NUMERO_PREVENTIVO AS COD_CLIENTE_SORGENTE,
NULL AS NUMERO_INDIRIZZO,
5 AS ID_TIPO_RIFERIMENTO_INDIRIZZO,
KA.AFFIDABILITA_INDIRIZZO AS PRIORITA ,
CURRENT_TIMESTAMP(0) AS DS_TIMESTAMP
FROM BIC_ODS_SA.LEAS_INDIRIZZO LEAS
INNER JOIN BIC_ODS.KEY_MAP_AFFIDABILITA KA
ON KA.COD_SISTEMA_SORGENTE=LEAS.COD_SISTEMA_SORGENTE
AND KA.TIPO_CLIENTE_DPR=LEAS.TIPO_CLIENTE_DPR
LEFT JOIN BIC_ODS.ASSOC_CLI_INDIR K
ON K.COD_CLIENTE_SORGENTE=LEAS.NUMERO_PREVENTIVO
AND K.COD_SISTEMA_SORGENTE=LEAS.COD_SISTEMA_SORGENTE
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO=5
WHERE LEAS.DATA_FINE_VALIDITA='2999-12-31'
AND K.COD_CLIENTE_SORGENTE IS NULL 
AND K.COD_SISTEMA_SORGENTE IS NULL 
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO IS NULL 
AND K.NUMERO_INDIRIZZO IS NULL 
;

.IF ERRORLEVEL > 0 THEN .QUIT 16;



/********************************************************/
/********************************************************/
/*                   1.10 PREST                         */
/********************************************************/
/********************************************************/


/********************************************************/
/********************************************************/
/*                   1.11 PRONT                         */
/********************************************************/
/********************************************************/

.LABEL LEGGI_PRONT

SEL MAX(TS_ULT_MOD) DATA_MAX FROM BIC_ODS_SA.PRONT_INDIRIZZO WHERE DATA_FINE_VALIDITA='2999-12-31'
HAVING MAX(TS_ULT_MOD) >(
SEL COALESCE(MAX(DS_TIMESTAMP),CAST('1900-01-01 00:00:00' AS TIMESTAMP (0))) FROM BIC_ODS.ASSOC_CLI_INDIR
WHERE COD_SISTEMA_SORGENTE='PRONT' );

.IF ACTIVITYCOUNT = 0 THEN .GOTO LEGGI_TPAZI

/************************************************************************/
/* STEP 1.11.0 CANCELLO I RECORD CHE VANNO MODIFICATI PER PRONTISSIMO  ****/
/************************************************************************/

DEL FROM  BIC_ODS.ASSOC_CLI_INDIR
, BIC_ODS_SA.PRONT_INDIRIZZO PRONT
 WHERE BIC_ODS.ASSOC_CLI_INDIR.COD_CLIENTE_SORGENTE=PRONT.NUMERO_PRATICA
   AND BIC_ODS.ASSOC_CLI_INDIR.COD_SISTEMA_SORGENTE=PRONT.COD_SISTEMA_SORGENTE
   AND BIC_ODS.ASSOC_CLI_INDIR.ID_TIPO_RIFERIMENTO_INDIRIZZO=PRONT.TIPO_RIFERIMENTO_INDIRIZZO
   AND PRONT.DATA_FINE_VALIDITA = '2999-12-31'
   AND PRONT.ID_INDIRIZZO_BIC_PRONT <> BIC_ODS.ASSOC_CLI_INDIR.ID_INDIRIZZO_BIC_SRG
;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

/********************************************************************************/
/* STEP 1.11.1 INSERISCO I DATI NUOVI O VARIATI                                 */
/********************************************************************************/

INSERT INTO BIC_ODS.ASSOC_CLI_INDIR
SELECT PRONT.ID_INDIRIZZO_BIC_PRONT AS ID_INDIRIZZO_BIC_SRG,
PRONT.COD_SISTEMA_SORGENTE AS COD_SISTEMA_SORGENTE,
PRONT.NUMERO_PRATICA AS COD_CLIENTE_SORGENTE,
NULL AS NUMERO_INDIRIZZO,
PRONT.TIPO_RIFERIMENTO_INDIRIZZO AS ID_TIPO_RIFERIMENTO_INDIRIZZO,
KA.AFFIDABILITA_INDIRIZZO AS PRIORITA ,
CURRENT_TIMESTAMP(0) AS DS_TIMESTAMP
FROM BIC_ODS_SA.PRONT_INDIRIZZO PRONT
INNER JOIN BIC_ODS.KEY_MAP_AFFIDABILITA KA
ON KA.COD_SISTEMA_SORGENTE=PRONT.COD_SISTEMA_SORGENTE
AND KA.TIPO_CLIENTE_DPR=PRONT.TIPO_CLIENTE_DPR
LEFT JOIN BIC_ODS.ASSOC_CLI_INDIR K
ON K.COD_CLIENTE_SORGENTE=PRONT.NUMERO_PRATICA
AND K.COD_SISTEMA_SORGENTE=PRONT.COD_SISTEMA_SORGENTE
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO=PRONT.TIPO_RIFERIMENTO_INDIRIZZO
AND PRONT.INDIRIZZO_CONCATENATO <> 'ND ND 99999 ND ZZ'
AND K.COD_CLIENTE_SORGENTE IS NULL 
AND K.COD_SISTEMA_SORGENTE IS NULL 
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO IS NULL 
AND K.NUMERO_INDIRIZZO IS NULL 
;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

/********************************************************/
/********************************************************/
/*                  1.12 TPAZI                          */
/********************************************************/
/********************************************************/

.LABEL LEGGI_TPAZI

SEL MAX(TS_ULT_MOD) DATA_MAX FROM BIC_ODS_SA.TPAZI_INDIRIZZO
WHERE DATA_FINE_VALIDITA='2999-12-31'
HAVING MAX(TS_ULT_MOD) >(
SEL COALESCE(MAX(DS_TIMESTAMP),CAST('1900-01-01 00:00:00' AS TIMESTAMP (0))) FROM BIC_ODS.ASSOC_CLI_INDIR
WHERE COD_SISTEMA_SORGENTE='TPAZI');

.IF ACTIVITYCOUNT = 0 THEN .GOTO LEGGI_TPPAY

/********************************************************/
/* STEP 1.12.0 CANCELLO I RECORD CHE VANNO MODIFICATI PER TPAZI */
/********************************************************/
/********************************************************/

DEL FROM BIC_ODS.ASSOC_CLI_INDIR
,BIC_ODS_SA.TPAZI_INDIRIZZO TPAZI
WHERE BIC_ODS.ASSOC_CLI_INDIR.COD_CLIENTE_SORGENTE=TPAZI.CODICE_FISCALE
AND BIC_ODS.ASSOC_CLI_INDIR.COD_SISTEMA_SORGENTE=TPAZI.COD_SISTEMA_SORGENTE
AND BIC_ODS.ASSOC_CLI_INDIR.ID_TIPO_RIFERIMENTO_INDIRIZZO=2
AND TPAZI.DATA_FINE_VALIDITA = '2999-12-31'
AND TPAZI.ID_INDIRIZZO_BIC_TPAZI <> BIC_ODS.ASSOC_CLI_INDIR.ID_INDIRIZZO_BIC_SRG;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

/********************************************************************************/
/* STEP 1.12.1 INSERISCO I DATI NUOVI O VARIATI NELLA TABELLA ASSOC_CLI_INDIR */
/********************************************************************************/

INSERT INTO BIC_ODS.ASSOC_CLI_INDIR
SELECT
TPAZI.ID_INDIRIZZO_BIC_TPAZI AS ID_INDIRIZZO_BIC_SRG,
TPAZI.COD_SISTEMA_SORGENTE AS COD_SISTEMA_SORGENTE,
TPAZI.CODICE_FISCALE AS COD_CLIENTE_SORGENTE,
NULL AS NUMERO_INDIRIZZO ,
2 AS ID_TIPO_RIF_INDIRIZZO,
KA.AFFIDABILITA_INDIRIZZO AS PRIORITA ,
CURRENT_TIMESTAMP(0) AS DS_TIMESTAMP
FROM 
BIC_ODS_SA.TPAZI_INDIRIZZO TPAZI
INNER JOIN BIC_ODS.KEY_MAP_AFFIDABILITA KA
ON KA.COD_SISTEMA_SORGENTE=TPAZI.COD_SISTEMA_SORGENTE
AND KA.TIPO_CLIENTE_DPR=TPAZI.TIPO_CLIENTE_DPR
LEFT OUTER JOIN BIC_ODS.ASSOC_CLI_INDIR K
ON TPAZI.CODICE_FISCALE = K.COD_CLIENTE_SORGENTE
AND TPAZI.COD_SISTEMA_SORGENTE = K.COD_SISTEMA_SORGENTE
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO= 2
WHERE TPAZI.DATA_FINE_VALIDITA='2999-12-31'
AND K.COD_CLIENTE_SORGENTE IS NULL 
AND K.COD_SISTEMA_SORGENTE IS NULL 
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO IS NULL 
AND K.NUMERO_INDIRIZZO IS NULL 
;

.IF ERRORLEVEL > 0 THEN .QUIT 16;


/********************************************************/
/********************************************************/
/*                 1.13 TPPAY                           */
/********************************************************/
/********************************************************/

.LABEL LEGGI_TPPAY

SEL MAX(TS_ULT_MOD) DATA_MAX FROM BIC_ODS_SA.TPPAY_INDIRIZZO WHERE DATA_FINE_VALIDITA='2999-12-31'
HAVING MAX(TS_ULT_MOD) >(
SEL COALESCE(MAX(DS_TIMESTAMP),CAST('1900-01-01 00:00:00' AS TIMESTAMP (0))) FROM BIC_ODS.ASSOC_CLI_INDIR
WHERE COD_SISTEMA_SORGENTE='TPPAY' );

.IF ACTIVITYCOUNT = 0 THEN .GOTO LEGGI_ACQ

/****************************************************************/
/* STEP 1.13.0 CANCELLO I RECORD CHE VANNO MODIFICATI PER TPPAY  **/
/****************************************************************/

DEL FROM  BIC_ODS.ASSOC_CLI_INDIR
, BIC_ODS_SA.TPPAY_INDIRIZZO TPPAY
WHERE BIC_ODS.ASSOC_CLI_INDIR.COD_CLIENTE_SORGENTE=TPPAY.CODICE_FISCALE
AND BIC_ODS.ASSOC_CLI_INDIR.COD_SISTEMA_SORGENTE=TPPAY.COD_SISTEMA_SORGENTE
AND BIC_ODS.ASSOC_CLI_INDIR.ID_TIPO_RIFERIMENTO_INDIRIZZO=2
AND TPPAY.DATA_FINE_VALIDITA = '2999-12-31'
AND TPPAY.ID_INDIRIZZO_BIC_TPPAY <> BIC_ODS.ASSOC_CLI_INDIR.ID_INDIRIZZO_BIC_SRG;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

/********************************************************************************/
/* STEP 1.13.1 INSERISCO I DATI NUOVI O VARIATI NELLA TABELLA VOLATILE VT_TPPAY */
/********************************************************************************/

INSERT INTO BIC_ODS.ASSOC_CLI_INDIR
SELECT
TPPAY.ID_INDIRIZZO_BIC_TPPAY AS ID_INDIRIZZO_BIC_SRG,
TPPAY.COD_SISTEMA_SORGENTE AS COD_SISTEMA_SORGENTE,
TPPAY.CODICE_FISCALE AS COD_CLIENTE_SORGENTE,
NULL AS NUMERO_INDIRIZZO,
'2' AS ID_TIPO_RIFERIMENTO_INDIRIZZO,
KA.AFFIDABILITA_INDIRIZZO AS PRIORITA  ,
CURRENT_TIMESTAMP(0) AS DS_TIMESTAMP
FROM BIC_ODS_SA.TPPAY_INDIRIZZO TPPAY
INNER JOIN BIC_ODS.KEY_MAP_AFFIDABILITA KA
ON KA.COD_SISTEMA_SORGENTE=TPPAY.COD_SISTEMA_SORGENTE
AND KA.TIPO_CLIENTE_DPR=TPPAY.TIPO_CLIENTE_DPR
LEFT JOIN BIC_ODS.ASSOC_CLI_INDIR K
ON K.COD_CLIENTE_SORGENTE=TPPAY.CODICE_FISCALE
AND K.COD_SISTEMA_SORGENTE=TPPAY.COD_SISTEMA_SORGENTE
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO=2
WHERE TPPAY.DATA_FINE_VALIDITA='2999-12-31'
AND K.COD_CLIENTE_SORGENTE IS NULL 
AND K.COD_SISTEMA_SORGENTE IS NULL 
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO IS NULL 
AND K.NUMERO_INDIRIZZO IS NULL 
;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

/********************************************************/
/********************************************************/
/*               1.14 CARTA ACQUISTI                    */
/********************************************************/
/********************************************************/

.LABEL LEGGI_ACQ

SEL MAX(TS_ULT_MOD) DATA_MAX FROM BIC_ODS_SA.ACQ_INDIRIZZO WHERE DATA_FINE_VALIDITA='2999-12-31'
HAVING MAX(TS_ULT_MOD) >(
SEL COALESCE(MAX(DS_TIMESTAMP),CAST('1900-01-01 00:00:00' AS TIMESTAMP (0))) FROM BIC_ODS.ASSOC_CLI_INDIR
WHERE COD_SISTEMA_SORGENTE='ACQ' );

.IF ACTIVITYCOUNT = 0 THEN .GOTO LEGGI_CRM

/**************************************************************/
/* STEP 1.14.0 CANCELLO I RECORD CHE VANNO MODIFICATI PER ACQ  **/
/**************************************************************/

DEL FROM BIC_ODS.ASSOC_CLI_INDIR
,BIC_ODS_SA.ACQ_INDIRIZZO ACQ 
WHERE BIC_ODS.ASSOC_CLI_INDIR.COD_CLIENTE_SORGENTE=ACQ.NUMERO_CARTA
AND BIC_ODS.ASSOC_CLI_INDIR.COD_SISTEMA_SORGENTE=ACQ.COD_SISTEMA_SORGENTE
AND BIC_ODS.ASSOC_CLI_INDIR.ID_TIPO_RIFERIMENTO_INDIRIZZO=2
AND ACQ.DATA_FINE_VALIDITA = '2999-12-31'
AND ACQ.ID_INDIRIZZO_BIC_ACQ <> BIC_ODS.ASSOC_CLI_INDIR.ID_INDIRIZZO_BIC_SRG;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

/******************************************************************************/
/* STEP 1.14.1 INSERISCO I DATI NUOVI O VARIATI NELLA TABELLA VOLATILE VT_ACQ */
/******************************************************************************/

INSERT INTO BIC_ODS.ASSOC_CLI_INDIR
SELECT
ACQ.ID_INDIRIZZO_BIC_ACQ AS ID_INDIRIZZO_BIC_SRG,
ACQ.COD_SISTEMA_SORGENTE AS COD_SISTEMA_SORGENTE,
ACQ.NUMERO_CARTA AS COD_CLIENTE_SORGENTE,
NULL AS NUMERO_INDIRIZZO,
2 AS ID_TIPO_RIFERIMENTO_INDIRIZZO,
KA.AFFIDABILITA_INDIRIZZO AS PRIORITA ,
CURRENT_TIMESTAMP(0) AS DS_TIMESTAMP
FROM BIC_ODS_SA.ACQ_INDIRIZZO ACQ
INNER JOIN BIC_ODS.KEY_MAP_AFFIDABILITA KA
ON KA.COD_SISTEMA_SORGENTE=ACQ.COD_SISTEMA_SORGENTE
AND KA.TIPO_CLIENTE_DPR=ACQ.TIPO_CLIENTE_DPR
LEFT JOIN BIC_ODS.ASSOC_CLI_INDIR K
ON K.COD_CLIENTE_SORGENTE=ACQ.NUMERO_CARTA
AND K.COD_SISTEMA_SORGENTE=ACQ.COD_SISTEMA_SORGENTE
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO=2
WHERE ACQ.DATA_FINE_VALIDITA='2999-12-31'
AND K.COD_CLIENTE_SORGENTE IS NULL 
AND K.COD_SISTEMA_SORGENTE IS NULL 
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO IS NULL 
AND K.NUMERO_INDIRIZZO IS NULL 
;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

/********************************************************/
/********************************************************/
/*                   1.15 CRM                           */
/********************************************************/
/********************************************************/

.LABEL LEGGI_CRM

SEL MAX(TS_ULT_MOD) DATA_MAX FROM BIC_ODS_SA.CRM_INDIRIZZO WHERE DATA_FINE_VALIDITA='2999-12-31'
HAVING MAX(TS_ULT_MOD) >(
SEL COALESCE(MAX(DS_TIMESTAMP),CAST('1900-01-01 00:00:00' AS TIMESTAMP (0)))  FROM BIC_ODS.ASSOC_CLI_INDIR
WHERE COD_SISTEMA_SORGENTE='CRM');

.IF ACTIVITYCOUNT = 0 THEN .GOTO LEGGI_PTITB

--CREO LA TABELLA VOLATILE DEGLI INDIRIZZO CRM CHIUSI

CREATE VOLATILE TABLE CHIUSI AS (
SEL BUSINESS_PARTNER,ID_INDIRIZZO_SAP,ID_TIPO_RIFERIMENTO_INDIRIZZO,COD_SISTEMA_SORGENTE,MAX(DATA_FINE_VALIDITA) 
DATA_FINE_VALIDITA FROM BIC_ODS_SA.CRM_INDIRIZZO
HAVING  MAX(DATA_FINE_VALIDITA)<>'2999-12-31'
GROUP BY 1,2,3,4)
WITH DATA 
PRIMARY INDEX (BUSINESS_PARTNER,COD_SISTEMA_SORGENTE)
ON COMMIT PRESERVE ROWS;

--CHIUDI IN ASSOC_CLI_INDIR GLI INDIRIZZI ARCHIVIATI SULLA STAGING

DEL FROM BIC_ODS.ASSOC_CLI_INDIR
,CHIUSI CRM 
WHERE BIC_ODS.ASSOC_CLI_INDIR.COD_CLIENTE_SORGENTE=CRM.BUSINESS_PARTNER
AND BIC_ODS.ASSOC_CLI_INDIR.COD_SISTEMA_SORGENTE=CRM.COD_SISTEMA_SORGENTE
AND BIC_ODS.ASSOC_CLI_INDIR.ID_TIPO_RIFERIMENTO_INDIRIZZO=CRM.ID_TIPO_RIFERIMENTO_INDIRIZZO
AND BIC_ODS.ASSOC_CLI_INDIR.NUMERO_INDIRIZZO=CRM.ID_INDIRIZZO_SAP
;

/****************************************************************/
/* STEP 1.14.0 CARICAMENTO TABELLA BIC_ODS_SA.ASSOC_CLI_INDIR */
/* 				UPDATE  VARIATI  RELATIVI A CRM                       */
/****************************************************************/
 
DEL FROM BIC_ODS.ASSOC_CLI_INDIR
,BIC_ODS_SA.CRM_INDIRIZZO CRM 
WHERE BIC_ODS.ASSOC_CLI_INDIR.COD_CLIENTE_SORGENTE=CRM.BUSINESS_PARTNER
AND BIC_ODS.ASSOC_CLI_INDIR.COD_SISTEMA_SORGENTE=CRM.COD_SISTEMA_SORGENTE
AND BIC_ODS.ASSOC_CLI_INDIR.ID_TIPO_RIFERIMENTO_INDIRIZZO=CRM.ID_TIPO_RIFERIMENTO_INDIRIZZO
AND BIC_ODS.ASSOC_CLI_INDIR.NUMERO_INDIRIZZO=CRM.ID_INDIRIZZO_SAP
AND CRM.DATA_FINE_VALIDITA = '2999-12-31'
AND ( CRM.ID_INDIRIZZO_BIC_CRM <> BIC_ODS.ASSOC_CLI_INDIR.ID_INDIRIZZO_BIC_SRG OR CRM.ARCHIVIAZIONE_BP IS NOT NULL)
;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

/********************************************************/
/* STEP 1.14.3 CARICAMENTO TABELLA BIC_ODS_SA.ASSOC_CLI_INDIR */
/* INSERISCO IN TABELLA I NUOVI  RELATIVI A CRM * /
/********************************************************/
 
INSERT INTO BIC_ODS.ASSOC_CLI_INDIR
SELECT
CRM.ID_INDIRIZZO_BIC_CRM AS ID_INDIRIZZO_BIC_SRG,
CRM.COD_SISTEMA_SORGENTE AS COD_SISTEMA_SORGENTE,
CRM.BUSINESS_PARTNER AS COD_CLIENTE_SORGENTE,
CRM.ID_INDIRIZZO_SAP  AS NUMERO_INDIRIZZO,
CRM.ID_TIPO_RIFERIMENTO_INDIRIZZO AS ID_TIPO_RIFERIMENTO_INDIRIZZO,
KA.AFFIDABILITA_INDIRIZZO AS PRIORITA ,
CURRENT_TIMESTAMP(0) AS DS_TIMESTAMP
FROM BIC_ODS_SA.CRM_INDIRIZZO CRM
INNER JOIN BIC_ODS.KEY_MAP_AFFIDABILITA KA
ON KA.COD_SISTEMA_SORGENTE=CRM.COD_SISTEMA_SORGENTE
AND KA.TIPO_CLIENTE_DPR=CRM.TIPO_CLIENTE_DPR
AND KA.COD_AFFIDABILITA_SORGENTE=COALESCE(CRM.FLAG_AFFIDABILITA,'S')
LEFT JOIN BIC_ODS.ASSOC_CLI_INDIR K
ON K.COD_CLIENTE_SORGENTE=CRM.BUSINESS_PARTNER
AND K.COD_SISTEMA_SORGENTE=CRM.COD_SISTEMA_SORGENTE
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO=CRM.ID_TIPO_RIFERIMENTO_INDIRIZZO
AND COALESCE(K.NUMERO_INDIRIZZO,'')=COALESCE(CRM.ID_INDIRIZZO_SAP,'')
WHERE CRM.DATA_FINE_VALIDITA='2999-12-31'
AND K.COD_CLIENTE_SORGENTE IS NULL 
AND K.COD_SISTEMA_SORGENTE IS NULL 
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO IS NULL 
AND K.NUMERO_INDIRIZZO IS NULL 
;
.IF ERRORLEVEL > 0 THEN .QUIT 16;



/********************************************************/
/********************************************************/
/*                  1.17 PTITB                          */
/********************************************************/
/********************************************************/

.LABEL LEGGI_PTITB

SEL MAX(TS_ULT_MOD) DATA_MAX FROM BIC_ODS_SA.PTITB_INDIRIZZO
WHERE DATA_FINE_VALIDITA='2999-12-31'
HAVING MAX(TS_ULT_MOD) >(
SEL COALESCE(MAX(DS_TIMESTAMP),CAST('1900-01-01 00:00:00' AS TIMESTAMP (0))) FROM BIC_ODS.ASSOC_CLI_INDIR
WHERE COD_SISTEMA_SORGENTE='PTITB' );

.IF ACTIVITYCOUNT = 0 THEN .GOTO LEGGI_PTITL

/********************************************************/
/* STEP 1.17.0 CANCELLO I RECORD CHE VANNO MODIFICATI PER PTITB */
/********************************************************/
/********************************************************/

DEL FROM  BIC_ODS.ASSOC_CLI_INDIR
, BIC_ODS_SA.PTITB_INDIRIZZO PTITB
WHERE BIC_ODS.ASSOC_CLI_INDIR.COD_CLIENTE_SORGENTE=CAST(PTITB.UID AS VARCHAR(60))
AND BIC_ODS.ASSOC_CLI_INDIR.COD_SISTEMA_SORGENTE=PTITB.COD_SISTEMA_SORGENTE
AND BIC_ODS.ASSOC_CLI_INDIR.ID_TIPO_RIFERIMENTO_INDIRIZZO=PTITB.TIPO_RIFERIMENTO_INDIRIZZO
AND PTITB.DATA_FINE_VALIDITA = '2999-12-31'
AND PTITB.ID_INDIRIZZO_BIC_PTITB <> BIC_ODS.ASSOC_CLI_INDIR.ID_INDIRIZZO_BIC_SRG;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

/********************************************************************************/
/* STEP 1.17.1 INSERISCO I DATI NUOVI O VARIATI NELLA TABELLA ASSOC_CLI_INDIR */
/********************************************************************************/

INSERT INTO BIC_ODS.ASSOC_CLI_INDIR
SELECT
PTITB.ID_INDIRIZZO_BIC_PTITB AS ID_INDIRIZZO_BIC_SRG,
PTITB.COD_SISTEMA_SORGENTE AS COD_SISTEMA_SORGENTE,
CAST(PTITB.UID AS VARCHAR(60)) AS COD_CLIENTE_SORGENTE,
NULL AS NUMERO_INDIRIZZO ,
PTITB.TIPO_RIFERIMENTO_INDIRIZZO AS ID_TIPO_RIF_INDIRIZZO,
KA.AFFIDABILITA_INDIRIZZO AS PRIORITA ,
CURRENT_TIMESTAMP(0) AS DS_TIMESTAMP
FROM 
BIC_ODS_SA.PTITB_INDIRIZZO PTITB
INNER JOIN BIC_ODS.KEY_MAP_AFFIDABILITA KA
ON KA.COD_SISTEMA_SORGENTE=PTITB.COD_SISTEMA_SORGENTE
AND KA.TIPO_CLIENTE_DPR=PTITB.TIPO_CLIENTE_DPR
LEFT OUTER JOIN BIC_ODS.ASSOC_CLI_INDIR K
ON CAST(PTITB.UID AS VARCHAR(60)) = K.COD_CLIENTE_SORGENTE
AND PTITB.COD_SISTEMA_SORGENTE = K.COD_SISTEMA_SORGENTE
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO= PTITB.TIPO_RIFERIMENTO_INDIRIZZO
WHERE PTITB.DATA_FINE_VALIDITA='2999-12-31'
AND K.COD_CLIENTE_SORGENTE IS NULL 
AND K.COD_SISTEMA_SORGENTE IS NULL 
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO IS NULL 
AND K.NUMERO_INDIRIZZO IS NULL 
;

.IF ERRORLEVEL > 0 THEN .QUIT 16;


/********************************************************/
/********************************************************/
/*                  1.19 PTITL                          */
/********************************************************/
/********************************************************/

.LABEL LEGGI_PTITL

SEL MAX(TS_ULT_MOD) DATA_MAX FROM BIC_ODS_SA.PTITL_INDIRIZZO
WHERE DATA_FINE_VALIDITA='2999-12-31'
HAVING MAX(TS_ULT_MOD) >(
SEL COALESCE(MAX(DS_TIMESTAMP),CAST('1900-01-01 00:00:00' AS TIMESTAMP (0))) FROM BIC_ODS.ASSOC_CLI_INDIR
WHERE COD_SISTEMA_SORGENTE='PTITL' );

.IF ACTIVITYCOUNT = 0 THEN .GOTO LEGGI_INFOC

/********************************************************/
/* STEP 1.19.0 CANCELLO I RECORD CHE VANNO MODIFICATI PER PTITL */
/********************************************************/
/********************************************************/

DEL FROM  BIC_ODS.ASSOC_CLI_INDIR
,BIC_ODS_SA.PTITL_INDIRIZZO PTITL
WHERE BIC_ODS.ASSOC_CLI_INDIR.COD_CLIENTE_SORGENTE=CAST(PTITL.UID AS VARCHAR(60))
AND BIC_ODS.ASSOC_CLI_INDIR.COD_SISTEMA_SORGENTE=PTITL.COD_SISTEMA_SORGENTE
AND BIC_ODS.ASSOC_CLI_INDIR.ID_TIPO_RIFERIMENTO_INDIRIZZO=2
AND PTITL.DATA_FINE_VALIDITA = '2999-12-31'
AND PTITL.ID_INDIRIZZO_BIC_PTITL <> BIC_ODS.ASSOC_CLI_INDIR.ID_INDIRIZZO_BIC_SRG;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

/********************************************************************************/
/* STEP 1.17.1 INSERISCO I DATI NUOVI O VARIATI NELLA TABELLA ASSOC_CLI_INDIR */
/********************************************************************************/

INSERT INTO BIC_ODS.ASSOC_CLI_INDIR
SELECT
PTITL.ID_INDIRIZZO_BIC_PTITL AS ID_INDIRIZZO_BIC_SRG,
PTITL.COD_SISTEMA_SORGENTE AS COD_SISTEMA_SORGENTE,
CAST(PTITL.UID AS VARCHAR(60)) AS COD_CLIENTE_SORGENTE,
NULL AS NUMERO_INDIRIZZO ,
2 AS ID_TIPO_RIF_INDIRIZZO,
KA.AFFIDABILITA_INDIRIZZO AS PRIORITA ,
CURRENT_TIMESTAMP(0) AS DS_TIMESTAMP
FROM 
BIC_ODS_SA.PTITL_INDIRIZZO PTITL
INNER JOIN BIC_ODS.KEY_MAP_AFFIDABILITA KA
ON KA.COD_SISTEMA_SORGENTE=PTITL.COD_SISTEMA_SORGENTE
AND KA.TIPO_CLIENTE_DPR=PTITL.TIPO_CLIENTE_DPR
LEFT OUTER JOIN BIC_ODS.ASSOC_CLI_INDIR K
ON CAST(PTITL.UID AS VARCHAR(60)) = K.COD_CLIENTE_SORGENTE
AND PTITL.COD_SISTEMA_SORGENTE = K.COD_SISTEMA_SORGENTE
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO= 2
WHERE PTITL.DATA_FINE_VALIDITA='2999-12-31'
AND K.COD_CLIENTE_SORGENTE IS NULL 
AND K.COD_SISTEMA_SORGENTE IS NULL 
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO IS NULL 
AND K.NUMERO_INDIRIZZO IS NULL 
;

.IF ERRORLEVEL > 0 THEN .QUIT 16;



/********************************************************/
/********************************************************/
/*                   1.21 INFOC                         */
/********************************************************/
/********************************************************/

.LABEL LEGGI_INFOC

SEL MAX(TS_ULT_MOD) DATA_MAX FROM BIC_ODS_SA.INFOC_INDIRIZZO
WHERE DATA_FINE_VALIDITA='2999-12-31'
HAVING MAX(TS_ULT_MOD) >(
SEL COALESCE (MAX(DS_TIMESTAMP ),CAST('1900-01-01' AS DATE)) FROM BIC_ODS.ASSOC_CLI_INDIR
WHERE COD_SISTEMA_SORGENTE='INFOC');

.IF ACTIVITYCOUNT = 0 THEN .GOTO LEGGI_KIT

/**************************************************************************************/
/* STEP 1.21.1 INSERISCO I DATI NUOVI O VARIATI                                       */
/**************************************************************************************/

DEL FROM BIC_ODS.ASSOC_CLI_INDIR
,BIC_ODS_SA.INFOC_INDIRIZZO INFOC
WHERE BIC_ODS.ASSOC_CLI_INDIR.COD_CLIENTE_SORGENTE=CAST(INFOC.CODICE_FISCALE AS VARCHAR(60))
AND BIC_ODS.ASSOC_CLI_INDIR.COD_SISTEMA_SORGENTE=INFOC.COD_SISTEMA_SORGENTE
AND BIC_ODS.ASSOC_CLI_INDIR.ID_TIPO_RIFERIMENTO_INDIRIZZO=INFOC.TIPO_RIFERIMENTO_INDIRIZZO
AND INFOC.DATA_FINE_VALIDITA = '2999-12-31'
AND INFOC.ID_INDIRIZZO_BIC_INFOC <> BIC_ODS.ASSOC_CLI_INDIR.ID_INDIRIZZO_BIC_SRG;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

/********************************************************************************/
/* STEP 1.21.2 INSERISCO I DATI NUOVI O VARIATI NELLA TABELLA ASSOC_CLI_INDIR */
/********************************************************************************/

INSERT INTO BIC_ODS.ASSOC_CLI_INDIR
SELECT
INFOC.ID_INDIRIZZO_BIC_INFOC AS ID_INDIRIZZO_BIC_SRG,
INFOC.COD_SISTEMA_SORGENTE AS COD_SISTEMA_SORGENTE,
CAST(INFOC.CODICE_FISCALE AS VARCHAR(60)) AS COD_CLIENTE_SORGENTE,
NULL AS NUMERO_INDIRIZZO ,
INFOC.TIPO_RIFERIMENTO_INDIRIZZO AS ID_TIPO_RIF_INDIRIZZO,
KA.AFFIDABILITA_INDIRIZZO AS PRIORITA ,
CURRENT_TIMESTAMP(0) AS DS_TIMESTAMP
FROM 
BIC_ODS_SA.INFOC_INDIRIZZO INFOC
INNER JOIN BIC_ODS.KEY_MAP_AFFIDABILITA KA
ON KA.COD_SISTEMA_SORGENTE=INFOC.COD_SISTEMA_SORGENTE
AND KA.TIPO_CLIENTE_DPR=INFOC.TIPO_CLIENTE_DPR
LEFT OUTER JOIN BIC_ODS.ASSOC_CLI_INDIR K
ON CAST(INFOC.CODICE_FISCALE AS VARCHAR(60)) = K.COD_CLIENTE_SORGENTE
AND INFOC.COD_SISTEMA_SORGENTE = K.COD_SISTEMA_SORGENTE
AND INFOC.TIPO_RIFERIMENTO_INDIRIZZO = K.ID_TIPO_RIFERIMENTO_INDIRIZZO
WHERE INFOC.DATA_FINE_VALIDITA='2999-12-31'
AND K.COD_CLIENTE_SORGENTE IS NULL 
AND K.COD_SISTEMA_SORGENTE IS NULL 
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO IS NULL 
AND K.NUMERO_INDIRIZZO IS NULL 
;


.IF ERRORLEVEL > 0 THEN .QUIT 16;

/********************************************************/
/********************************************************/
/*                   1.22 KIT                           */
/********************************************************/
/********************************************************/

.LABEL LEGGI_KIT

SEL MAX(TS_ULT_MOD) DATA_MAX FROM BIC_ODS_SA.KIT_INDIRIZZO
WHERE DATA_FINE_VALIDITA='2999-12-31'
HAVING MAX(TS_ULT_MOD) >(
SEL COALESCE (MAX(DS_TIMESTAMP ),CAST('1900-01-01' AS DATE)) FROM BIC_ODS.ASSOC_CLI_INDIR
WHERE COD_SISTEMA_SORGENTE='KIT'  );
.IF ACTIVITYCOUNT = 0 THEN .GOTO LEGGI_PTITW


  
/****************************************************************/
/* STEP 1.22.3 CARICAMENTO TABELLA BIC_ODS_SA.ASSOC_CLI_INDIR */
/*           UPDATE  VARIATI  RELATIVI A KIT                    */
/****************************************************************/
 
DEL FROM BIC_ODS.ASSOC_CLI_INDIR
, BIC_ODS_SA.KIT_INDIRIZZO KIT 
WHERE BIC_ODS.ASSOC_CLI_INDIR.COD_CLIENTE_SORGENTE=KIT.COD_CLI_SRG
AND BIC_ODS.ASSOC_CLI_INDIR.COD_SISTEMA_SORGENTE=KIT.COD_SISTEMA_SORGENTE
AND BIC_ODS.ASSOC_CLI_INDIR.ID_TIPO_RIFERIMENTO_INDIRIZZO=KIT.TIPO_RIFERIMENTO_INDIRIZZO
AND KIT.DATA_FINE_VALIDITA = '2999-12-31'
AND KIT.ID_INDIRIZZO_BIC_KIT <> BIC_ODS.ASSOC_CLI_INDIR.ID_INDIRIZZO_BIC_SRG
;


.IF ERRORLEVEL > 0 THEN .QUIT 16;

/********************************************************/
/* STEP 1.14.3 CARICAMENTO TABELLA BIC_ODS_SA.ASSOC_CLI_INDIR */
/* INSERISCO IN TABELLA I NUOVI  RELATIVI A KIT * /
/********************************************************/
 
INSERT INTO BIC_ODS.ASSOC_CLI_INDIR
SELECT
KIT.ID_INDIRIZZO_BIC_KIT AS ID_INDIRIZZO_BIC_SRG,
KIT.COD_SISTEMA_SORGENTE AS COD_SISTEMA_SORGENTE,
KIT.COD_CLI_SRG AS COD_CLIENTE_SORGENTE,
NULL AS NUMERO_INDIRIZZO,
KIT.TIPO_RIFERIMENTO_INDIRIZZO AS ID_TIPO_RIFERIMENTO_INDIRIZZO,
KA.AFFIDABILITA_INDIRIZZO AS PRIORITA ,
CURRENT_TIMESTAMP(0) AS DS_TIMESTAMP
FROM BIC_ODS_SA.KIT_INDIRIZZO KIT
INNER JOIN BIC_ODS.KEY_MAP_AFFIDABILITA KA
ON KA.COD_SISTEMA_SORGENTE=KIT.COD_SISTEMA_SORGENTE
AND KA.TIPO_CLIENTE_DPR=KIT.TIPO_CLIENTE_DPR
LEFT JOIN BIC_ODS.ASSOC_CLI_INDIR K
ON K.COD_CLIENTE_SORGENTE=KIT.COD_CLI_SRG
AND K.COD_SISTEMA_SORGENTE=KIT.COD_SISTEMA_SORGENTE
WHERE KIT.DATA_FINE_VALIDITA='2999-12-31'
AND K.COD_CLIENTE_SORGENTE IS NULL 
AND K.COD_SISTEMA_SORGENTE IS NULL 
AND K.ID_TIPO_RIFERIMENTO_INDIRIZZO IS NULL 
AND K.NUMERO_INDIRIZZO IS NULL 
;

.IF ERRORLEVEL > 0 THEN .QUIT 16;


/********************************************************/
/********************************************************/
/*                  1.24 PTITW                          */
/********************************************************/
/********************************************************/

.LABEL LEGGI_PTITW

SEL MAX(TS_ULT_MOD) DATA_MAX FROM BIC_ODS_SA.PTITW_INDIRIZZO
WHERE DATA_FINE_VALIDITA='2999-12-31'
HAVING MAX(TS_ULT_MOD) >(
SEL COALESCE(MAX(DS_TIMESTAMP),CAST('1900-01-01 00:00:00' AS TIMESTAMP (0))) FROM BIC_ODS.ASSOC_CLI_INDIR
WHERE COD_SISTEMA_SORGENTE='PTITW' );

.IF ACTIVITYCOUNT = 0 THEN .GOTO LEGGI_PTITO

/********************************************************/
