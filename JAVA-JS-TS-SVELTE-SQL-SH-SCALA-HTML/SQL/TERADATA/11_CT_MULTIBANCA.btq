;DELETE EBIL_AREE.CT_MULTIBANCA
WHERE ID_PERIODO_TEMPORALE= (SELECT ID_PERIODO_TEMPORALE FROM EBIL_AREE.CT_PARAMETRI)


;INSERT INTO EBIL_AREE.CT_MULTIBANCA
	select p.ID_CLIENTE_BIC,
	       p.ID_PERIODO_TEMPORALE,
		coalesce(v.FL_AUTOVAGLIA,0) as FL_AUTO_VAGLIA,
		coalesce(v.N_VAGLIA_CIRCOLARI_VZ_VK,0) as N_VAGLIA_CIRCOLARI_VZ_VK,
		coalesce(abe.FL_AUTOBONIFICO_E,0) as FL_AUTOBONIF_E,
		coalesce(abu.FL_AUTOBONIFICO_U,0) as FL_AUTOBONIF_U,
		coalesce(sdp.SDP,0) as SDP
	from EBIL_AREE.V_CT_PERIMETRO as p
	left join VAGLIA as v
		on p.ID_CLIENTE_BIC=v.ID_CLIENTE_BIC
	left join (select * from FL_AUTOBONIFICO_E) as abe
		on p.ID_CLIENTE_BIC=abe.ID_CLIENTE_BIC
	left join (select * from FL_AUTOBONIFICO_U) as abu
		on p.ID_CLIENTE_BIC=abu.ID_CLIENTE_BIC
	left join gm_00_02_sdp_outbic_tmp as sdp
		on p.ID_CLIENTE_BIC=sdp.ID_CLIENTE_BIC
		WHERE ID_PERIODO_TEMPORALE= (SELECT ID_PERIODO_TEMPORALE FROM EBIL_AREE.CT_PARAMETRI)
;ET;
.IF ERRORCODE > 0 THEN .QUIT 16;

drop table VAGLIA;
drop table FL_AUTOBONIFICO_E;
drop table FL_AUTOBONIFICO_U;
drop table GM_00_02_SDP_FASI;
drop table GM_00_02_SDP_IDPR_1;
drop table GM_00_02_SDP_1TMP;
--drop table GM_00_02_SDP_2TMP;
--drop table GM_00_02_SDP;
drop table GM_00_02_SDP_2;
drop table gm_00_02_sdp_outbic_tmp;
.IF ERRORCODE > 0 THEN .QUIT 16;


CREATE VOLATILE TABLE VTB_MULTIBANCA_SV AS
(SELECT ID_PERIODO_TEMPORALE, ROW_NUMBER () over ( ORDER BY ID_PERIODO_TEMPORALE  DESC) AS ORDINAMENTO
FROM  EBIL_AREE.CT_MULTIBANCA
GROUP BY 1)
WITH DATA PRIMARY INDEX (ID_PERIODO_TEMPORALE) ON COMMIT PRESERVE ROWS;
.IF ERRORCODE > 0 THEN .QUIT 16;

DELETE EBIL_AREE.CT_MULTIBANCA
WHERE ID_PERIODO_TEMPORALE IN ( SELECT ID_PERIODO_TEMPORALE 
FROM VTB_MULTIBANCA_SV
WHERE ORDINAMENTO >25);
.IF ERRORCODE > 0 THEN .QUIT 16;

