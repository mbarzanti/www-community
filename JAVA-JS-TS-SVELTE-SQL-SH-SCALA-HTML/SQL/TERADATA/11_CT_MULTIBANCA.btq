drop table TEMP_SEPAD_LIB_E_3;
drop table TEMP_SEPAD_LIB_E_4;
drop table SEPAD_LIB_E;
drop table TEMP_SEPAD_CC_E_0;
drop table TEMP_SEPAD_CC_E;
drop table TEMP_SEPAD_CC_E_2;
drop table TEMP_SEPAD_CC_E_3;
drop table TEMP_SEPAD_CC_E_4;
