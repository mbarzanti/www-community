drop table SEPAD_CA_E;
.IF ERRORCODE > 0 THEN .QUIT 16;


-- SDP
create volatile table GM_00_02_SDP_FASI as(
	select distinct a.CD_FRAZ,a.DT_CONT,a.NR_PRG_REL,a.CD_TERM,a.CD_OPERAT
	from V_EDW_DW_SDP.EDW_TDD_TBGIOOPER as a, ebil_aree.CT_PARAMETRI as b
	where a.DT_CONT>add_months(b.DATA_AGGIORNAMENTO,-1 ) and a.DT_CONT<=b.DATA_AGGIORNAMENTO -- PATCH come da mail Brunelli del 2/5/2019: cambiati i -6 mesi in -1
	and trim (a.CD_OPER) in ('BYBN','PMBN','PMCT','VEYV') 
	and a.NR_PRG_REL<>0
)with data on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


create volatile table GM_00_02_SDP_IDPR_1 as(
	select *
	from V_EDW_DW_SDP.EDW_TDD_TBGIOOPER as a, ebil_aree.CT_PARAMETRI as b
	where a.DT_CONT>add_months(b.DATA_AGGIORNAMENTO,-1) and a.DT_CONT<=b.DATA_AGGIORNAMENTO -- PATCH come da mail Brunelli del 2/5/2019: cambiati i -3 mesi in -1
	and trim(a.CD_OPER)='IDPR' 
	and a.NR_PRG_REL<>0
) with data on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


collect statistics column(CD_FRAZ) on GM_00_02_SDP_IDPR_1;
collect statistics column(DT_CONT) on GM_00_02_SDP_IDPR_1;
collect statistics column(NR_PRG_REL) on GM_00_02_SDP_IDPR_1;
collect statistics column(CD_TERM) on GM_00_02_SDP_IDPR_1;
collect statistics column(CD_OPERAT) on GM_00_02_SDP_IDPR_1;


collect statistics column(CD_FRAZ) on GM_00_02_SDP_FASI;
collect statistics column(DT_CONT) on GM_00_02_SDP_FASI;
collect statistics column(NR_PRG_REL) on GM_00_02_SDP_FASI;
collect statistics column(CD_TERM) on GM_00_02_SDP_FASI;
collect statistics column(CD_OPERAT) on GM_00_02_SDP_FASI;

create volatile table GM_00_02_SDP_1TMP as(
	select b.VAL_FORM_TEC2 as COD_FISCALE,b.DT_CONT as DATA_CONT
	from GM_00_02_SDP_FASI as a 
	inner join GM_00_02_SDP_IDPR_1 as b
	 on a.CD_FRAZ=b.CD_FRAZ and a.DT_CONT=b.DT_CONT and a.NR_PRG_REL=b.NR_PRG_REL and a.CD_TERM=b.CD_TERM
	 	and a.CD_OPERAT=b.CD_OPERAT
	group by 1, 2
)with data on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;




create volatile table GM_00_02_SDP_2 as(
	select cl.ID_CLIENTE_BIC,cf.DATA_CONT
	from(select a.COD_FISCALE as CF,a.DATA_CONT from GM_00_02_SDP_1TMP as a, ebil_aree.CT_PARAMETRI as b) as cf -- PATCH come da mail Brunelli del 2/5/2019: cambiato GM_00_02_SDP in GM_00_02_SDP_1TMP, perché la union precedente non viene più fatta
	left join(
		select a.ID_CLIENTE_BIC,a.COD_FISCALE
		from EDWAE_VM.CLIENTE as a, ebil_aree.CT_PARAMETRI as b
		where b.DATA_AGGIORNAMENTO between a.DT_INI_VAL and a.DT_FIN_VAL
		group by 1,2
	) as cl on cf.CF=cl.COD_FISCALE
	group by 1 , 2 
)with data on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


create volatile table gm_00_02_sdp_outbic_tmp as(
	select aa.ID_CLIENTE_BIC,1 as SDP,count(*) as N_SDB,min(aa.DATA_CONT) as MIN_DATA_TRAN,
		max(aa.DATA_CONT) as MAX_DATA_TRAN
	from(
		select a.* 
		from(
			select a.ID_CLIENTE_BIC,a.DATA_CONT
			from(select * from GM_00_02_SDP_2) as a
			join(select * from EBIL_AREE.CT_PERIMETRO) as b
				on a.ID_CLIENTE_BIC=b.ID_CLIENTE_BIC
		) as a, ebil_aree.CT_PARAMETRI as b
	) as aa
	group by 1 
)with data on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


