--118196 ESTENSIONE ABILITAZIONE LIGHT PER ESECUZIONE DELLE FUNZIONI DISPOSITIVE DEL LIBRETTO SMART IN APP BP
--Salici Alessandro, Marco Iannella, Daniele Montalbano
--17/02/2020, 16/03/2020


.SET ERROROUT STDOUT
.SET WIDTH 240;
.SET ERRORLEVEL 3803 SEVERITY 10;
.SET ERRORLEVEL 3807 SEVERITY 10;

-----LIBRETTI-----------


	CREATE VOLATILE TABLE VTB_ASSOC_RAPP_PROD_LIB AS (
		SELECT RAPP.FK_RAPPORTO
			  ,RAPP.FK_CLIENTE 
			  ,RAPP.FL_COINTESTAZIONE
			  ,RAPP.CD_CLIENTE_SORGENTE
			  ,RAPP.SK_RAPPORTO 
			  ,SMALIB.DT_APERTURA AS DT_FIN_PERIODO
			  ,CURRENT_DATE AS PK_FIN_PERIODO
			  ,RAPP.SK_SOTTOPRODOTTO
		FROM EBIL_ANAG_V.V_ASSOC_RAPP_PROD_CLIENTE RAPP
		CROSS JOIN LIBRETTO_SMART_APP_BP_DATE SMALIB
		WHERE CURRENT_DATE BETWEEN RAPP.DT_INIZIO_VALIDITA AND RAPP.DT_FINE_VALIDITA
		  AND RAPP.CD_TIPO_RAPP = 'DR'
		  AND RAPP.DT_APERTURA >= SMALIB.DT_APERTURA
		  AND RAPP.DT_CHIUSURA = SMALIB.DT_CHIUSURA
	)WITH DATA
	PRIMARY INDEX(FK_RAPPORTO)
	INDEX(FK_CLIENTE)
	INDEX(CD_CLIENTE_SORGENTE)
	INDEX(SK_RAPPORTO)
	ON COMMIT PRESERVE ROWS;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

CREATE VOLATILE TABLE VTB_LIBRETTI_NR AS (
	SELECT 	ASSOC.PK_FIN_PERIODO,
			CLI.COD_FISCALE_SORGENTE,
			LIB.NR_LIBRETTO,
			CASE WHEN COI.NDG_RAPPORTO IS NULL THEN 'N'
				 ELSE 'Y'
			END AS FL_COINTESTAZIONE,
			SER_RPOL.NR_TELEFONO,
			CLI2.UID AS NOME_UTENTE,
			0 AS FLAG_CONFLITTO_LIB,
			0 AS FLAG_CONFLITTO_PPAY,
			0 AS FLAG_CONFLITTO_CRM,
			0 AS FLAG_CONFLITTO_CRM_PPAY 

	FROM EDW_DW_BP.LIB_SERVIZIO_RPOL_ST SER_RPOL
	CROSS JOIN LIBRETTO_SMART_APP_BP_DATE SMALIB
	INNER JOIN EBIL_ANAG_V.V_AN_RAPPORTO_LIBRETTO LIB
		ON SER_RPOL.NR_RAPPORTO = LIB.NR_LIBRETTO
		AND LIB.DT_ATTIVAZIONE >= SMALIB.DT_APERTURA
		AND Current_Date BETWEEN LIB.DT_INI_VAL AND LIB.DT_FIN_VAL

	INNER JOIN VTB_ASSOC_RAPP_PROD_LIB ASSOC
		ON ASSOC.FK_RAPPORTO = LIB.PK_RAPPORTO

	INNER JOIN BIC_CAT_PROD_SA.CAT_SOTTOPRODOTTO_ULT_VER SPROD
		ON SPROD.SK_SOTTOPRODOTTO = ASSOC.SK_SOTTOPRODOTTO
		AND SPROD.NOME_SOTTOPRODOTTO LIKE 'LIBRETTO SMART%'

	INNER JOIN BIC_ODS_V.KEY_MAP_CLIENTE CLI
		ON CLI.COD_CLIENTE_SORGENTE = SER_RPOL.NDG
		AND CLI.COD_SISTEMA_SORGENTE = 'BP'
		AND CLI.DT_FINE_VALIDITA IS NULL

		INNER JOIN BIC_ODS_V.CLIENTE CLI2
		ON CLI2.ID_CLIENTE_BIC = CLI.ID_CLIENTE_BIC
		
		
	LEFT OUTER JOIN EBIL_ANAG_V.V_ASSOC_COINTESTAZIONE_CLIENTE COI
	   ON SER_RPOL.NDG = COI.NDG_RAPPORTO

	WHERE  Current_Date BETWEEN SER_RPOL.DT_INI_VAL AND SER_RPOL.DT_FIN_VAL
	  AND SER_RPOL.CD_STATO_SERVIZIO_DISP IN ('C', 'R')
	  AND SER_RPOL.DT_REVOCA IS NULL

	) WITH DATA
	PRIMARY INDEX (NR_LIBRETTO)
	INDEX (COD_FISCALE_SORGENTE)
	ON COMMIT PRESERVE ROWS;
	
	
.IF ERRORLEVEL > 0 THEN .QUIT 16;

	COLLECT STATS COLUMN(NR_LIBRETTO)
				  ,COLUMN(COD_FISCALE_SORGENTE)
	ON VTB_LIBRETTI_NR;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

	CREATE VOLATILE TABLE VT_TELEFONI_CONFLITTO_LIB AS (
	SEL A.TELEFONO
	FROM (SEL NR_TELEFONO AS TELEFONO , COUNT(DISTINCT (NDG)) AS TOT 
		  FROM EDW_DW_BP.LIB_SERVIZIO_RPOL_ST 
		  CROSS JOIN LIBRETTO_SMART_APP_BP_DATE SMALIB
		  WHERE DT_FIN_VAL = SMALIB.DT_CHIUSURA
		  GROUP BY 1
		  HAVING TOT > 1) A
	GROUP BY 1)
	WITH DATA
	PRIMARY INDEX (TELEFONO)
	ON COMMIT PRESERVE ROWS;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

	COLLECT STATS COLUMN(TELEFONO)
	ON VT_TELEFONI_CONFLITTO_LIB;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

	UPDATE LIB
	FROM VTB_LIBRETTI_NR LIB,  
		 VT_TELEFONI_CONFLITTO_LIB TEL_LIB
	SET FLAG_CONFLITTO_LIB = 1
	WHERE LIB.NR_TELEFONO = TEL_LIB.TELEFONO;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

	CREATE VOLATILE TABLE VT_TELEFONI_CONFLITTO_PPAY AS (
	SEL A.TELEFONO
	FROM (SEL   SUBSTR (NR_DESTINATARIO,7,16) AS TELEFONO , COUNT (DISTINCT(CD_FISC)) AS TOT 
		  FROM EDW_DW_DBP_MOV.EDW_MKT_TDD_ANAG_SECUR_PPAY_ST
		  CROSS JOIN LIBRETTO_SMART_APP_BP_DATE SMALIB
		  WHERE DT_FIN_VAL = SMALIB.DT_CHIUSURA
		  
	  		AND STATO_SERVIZIO = 'A'
		  GROUP BY 1
		  HAVING TOT > 1) A
	GROUP BY 1)
	WITH DATA
	PRIMARY INDEX (TELEFONO)
	ON COMMIT PRESERVE ROWS;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

	COLLECT STATS COLUMN(TELEFONO)
	ON VT_TELEFONI_CONFLITTO_PPAY;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

	UPDATE LIB
	FROM VTB_LIBRETTI_NR LIB,  
		 VT_TELEFONI_CONFLITTO_PPAY TEL_PPAY
	SET FLAG_CONFLITTO_PPAY = 1
	WHERE LIB.NR_TELEFONO = TEL_PPAY.TELEFONO;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

	CREATE VOLATILE TABLE VT_TELEFONI_CONFLITTO_CRM AS (
	SEL TELEFONO
	FROM (SEL '+39' || RIFERIMENTO AS TELEFONO, ID_TIPO_RIFERIMENTO, COUNT(*) AS TOT
	      FROM (SEL RIFERIMENTO, ID_CLIENTE_BIC, ID_TIPO_RIFERIMENTO
		  		FROM BIC_ODS_SA.RIFERIMENTO_ID_BIC RIF
		  		WHERE ((ID_TIPO_RIFERIMENTO=6 AND CERTIFICATO='X') OR (ID_TIPO_RIFERIMENTO=3 AND CERTIFICATO='X' AND SUBSTR(RIFERIMENTO, 1,1)=3))
		  			 AND NON_USATO IS NULL
					AND COD_SISTEMA_SORGENTE = 'CRM'
		  		QUALIFY ROW_NUMBER() OVER(PARTITION BY RIFERIMENTO, ID_CLIENTE_BIC, ID_TIPO_RIFERIMENTO ORDER BY TS_ULT_MOD DESC) = 1) A
		  GROUP BY 1, 2
		  HAVING TOT > 1) B)
	WITH DATA
	PRIMARY INDEX (TELEFONO)
	ON COMMIT PRESERVE ROWS;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

	UPDATE LIB
	FROM VTB_LIBRETTI_NR LIB,  
		 VT_TELEFONI_CONFLITTO_CRM TEL_CRM
	SET FLAG_CONFLITTO_CRM = 1
	WHERE LIB.NR_TELEFONO = TEL_CRM.TELEFONO;


.IF ERRORLEVEL > 0 THEN .QUIT 16;

	COLLECT STATS COLUMN(TELEFONO)
	ON VT_TELEFONI_CONFLITTO_PPAY;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

CREATE VOLATILE TABLE VT_TELEFONO_OVERLAP AS (
	
	SEL telefono FROM(
		SEL '+39' || Substr (trim(NR_DESTINATARIO),7,16) AS TELEFONO 
		FROM EDW_DW_DBP_MOV.EDW_MKT_TDD_ANAG_SECUR_PPAY_ST
		CROSS JOIN LIBRETTO_SMART_APP_BP_DATE SMALIB
		WHERE DT_FIN_VAL = SMALIB.DT_CHIUSURA
	  	AND STATO_SERVIZIO = 'A'
		
	INTERSECT 

	SEL '+39' || trim(RIFERIMENTO) AS telefono
		FROM BIC_ODS_SA.RIFERIMENTO_ID_BIC RIF
		WHERE ((ID_TIPO_RIFERIMENTO=6 AND CERTIFICATO='X') OR (ID_TIPO_RIFERIMENTO=3 AND CERTIFICATO='X' AND Substr(RIFERIMENTO, 1,1)=3))
		AND NON_USATO IS NULL
		AND COD_SISTEMA_SORGENTE = 'CRM') phone_overlap	
)
	WITH DATA
	PRIMARY INDEX (TELEFONO)
	ON COMMIT PRESERVE ROWS;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

	UPDATE LIB
	FROM VTB_LIBRETTI_NR AS LIB,
		 VT_TELEFONO_OVERLAP VT_OVERLAP
	SET FLAG_CONFLITTO_CRM_PPAY = 1
	WHERE LIB.NR_TELEFONO = VT_OVERLAP.TELEFONO;

.IF ERRORLEVEL > 0 THEN .QUIT 16;
	
	CREATE VOLATILE TABLE VTB_LIBRETTI_SENZA_CONFLITTO AS (
	SELECT 	PK_FIN_PERIODO AS PERIODO_TEMPORALE,
			COD_FISCALE_SORGENTE AS COD_FISCALE,
			NR_LIBRETTO,
			FL_COINTESTAZIONE,
			NR_TELEFONO,
			NOME_UTENTE
	FROM VTB_LIBRETTI_NR
	WHERE FLAG_CONFLITTO_LIB = 0
	  AND FLAG_CONFLITTO_PPAY = 0
	  AND FLAG_CONFLITTO_CRM = 0
	  AND FLAG_CONFLITTO_CRM_PPAY = 0 
	) WITH DATA
	PRIMARY INDEX (NR_LIBRETTO)
	INDEX (COD_FISCALE)
	ON COMMIT PRESERVE ROWS;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

DELETE FROM EDW_DW_BP.LIBRETTO_SMART_APP_BP_118196;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

INSERT INTO EDW_DW_BP.LIBRETTO_SMART_APP_BP_118196
SEL * FROM VTB_LIBRETTI_SENZA_CONFLITTO;

.IF ERRORLEVEL > 0 THEN .QUIT 16;
