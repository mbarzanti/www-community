.SET ERROROUT STDOUT
.SET WIDTH 4096;  
                                
.SET ERRORLEVEL 3803 SEVERITY 10; 
.SET ERRORLEVEL 3807 SEVERITY 10;


/* AGGIUNTA DELLE INFO ARRIVATE DA NFEA */ 
CREATE VOLATILE TABLE VTB_ALL_NFEA_CONT AS
(
	SELECT	
		 CAST('I' AS VARCHAR(1)) AS TIPO_ELABORAZIONE 
		,RIB.COD_CLIENTE_SORGENTE
		,RIB.COD_SISTEMA_SORGENTE
		,RIB.COD_CONTATTO_SORGENTE               
		,RIB.ID_CLIENTE_BIC                
		,RIB.ID_TIPO_RIFERIMENTO      
		,RIB.RIFERIMENTO 
		,RIB.TIPO_CLIENTE_DPR  AS TIPO_CLI_FONTE
		,RIB.TS_ULT_MOD   AS DS_TIMESTAMP	
		,CURRENT_TIMESTAMP(0) AS TS_AGG_RECORD
	FROM  V_BIC_ODS_SA.RIFERIMENTO_ID_BIC_BP		RIB	
	WHERE RIB.COD_SISTEMA_SORGENTE='NFEA'
)
WITH DATA PRIMARY INDEX(COD_CLIENTE_SORGENTE, COD_SISTEMA_SORGENTE, ID_TIPO_RIFERIMENTO)
ON COMMIT PRESERVE ROWS
;
.IF ERRORLEVEL > 0 THEN .QUIT 16;

DELETE FROM BIC_ODS_SA.AUC_NFEA_CONTATTO_BK 
WHERE (	COD_CLIENTE_SORGENTE, COD_SISTEMA_SORGENTE, ID_TIPO_RIFERIMENTO) IN
( SELECT 
     COD_CLIENTE_SORGENTE, COD_SISTEMA_SORGENTE, ID_TIPO_RIFERIMENTO
	 FROM VTB_ALL_NFEA_CONT
)
;
.IF ERRORLEVEL > 0 THEN .QUIT 16;

INSERT INTO BIC_ODS_SA.AUC_NFEA_CONTATTO_BK 
	SELECT *
	FROM VTB_ALL_NFEA_CONT
;
.IF ERRORLEVEL > 0 THEN .QUIT 16;


DEL   BIC_ODS_SA.NFEA_CONTATTO_DELTA_LOAD  ALL;

INSERT INTO 
BIC_ODS_SA.NFEA_CONTATTO_DELTA_LOAD  

SEL 	'I' AS TIPO_ELABORAZIONE
						,RIB.COD_CLIENTE_SORGENTE AS COD_CLIENTE_SORGENTE
						,RIB.COD_SISTEMA_SORGENTE AS   COD_SISTEMA_SORGENTE          
						,RIB.COD_CONTATTO_SORGENTE AS COD_CONTATTO_SORGENTE                
						,CR.ID_CLIENTE_BIC                
						,RIB.ID_TIPO_RIFERIMENTO      
						,RIB.RIFERIMENTO 
						,'R'  AS TIPO_CLI_FONTE
						,RIB.TS_ULT_MOD   AS DS_TIMESTAMP		
			FROM   BIC_ODS_SA.NFEA_CLIENTE_R_FILE   			CR
			INNER JOIN    V_BIC_ODS_SA.RIFERIMENTO_ID_BIC_BP		RIB
			ON CAST(CR.ID_CLIENTE_BIC AS INTEGER)=RIB.ID_CLIENTE_BIC
			AND CR.TIPO_ELABORAZIONE='I';

INSERT INTO 
BIC_ODS_SA.NFEA_CONTATTO_DELTA_LOAD  

SEL 	'I' AS TIPO_ELABORAZIONE
						,RIB.COD_CLIENTE_SORGENTE AS COD_CLIENTE_SORGENTE
						,RIB.COD_SISTEMA_SORGENTE AS   COD_SISTEMA_SORGENTE          
						,RIB.COD_CONTATTO_SORGENTE AS COD_CONTATTO_SORGENTE                
						,CR.ID_CLIENTE_BIC                
						,RIB.ID_TIPO_RIFERIMENTO      
						,RIB.RIFERIMENTO 
						,'B'  AS TIPO_CLI_FONTE
						,RIB.TS_ULT_MOD   AS DS_TIMESTAMP	
			FROM  BIC_ODS_SA.NFEA_CLIENTE_B_FILE   			CR
			INNER JOIN  V_BIC_ODS_SA.RIFERIMENTO_ID_BIC_BP		RIB
			ON CAST(CR.ID_CLIENTE_BIC AS INTEGER)=RIB.ID_CLIENTE_BIC
			AND CR.TIPO_ELABORAZIONE='I';

INSERT INTO 
BIC_ODS_SA.NFEA_CONTATTO_DELTA_LOAD  

SEL 	'I' AS TIPO_ELABORAZIONE
						,RIB.COD_CLIENTE_SORGENTE
						,RIB.COD_SISTEMA_SORGENTE
						,RIB.COD_CONTATTO_SORGENTE               
						,RIB.ID_CLIENTE_BIC                
						,RIB.ID_TIPO_RIFERIMENTO      
						,RIB.RIFERIMENTO 
						,'R'  AS TIPO_CLI_FONTE
						,RIB.TS_ULT_MOD   AS DS_TIMESTAMP	
			FROM  V_BIC_ODS_SA.RIFERIMENTO_ID_BIC_BP		RIB
				LEFT JOIN  BIC_ODS_SA.AUC_NFEA_CONTATTO_BK CR
					ON  RIB.ID_CLIENTE_BIC=CAST(CR.ID_CLIENTE_BIC AS INTEGER)
					AND COALESCE(RIB.ID_TIPO_RIFERIMENTO,0) =COALESCE(CR.ID_TIPO_RIFERIMENTO,0) 
					AND COALESCE(RIB.COD_CLIENTE_SORGENTE,'ND') =COALESCE(CR.COD_CLIENTE_SORGENTE,'ND') 
					AND RIB.COD_SISTEMA_SORGENTE = CR.COD_SISTEMA_SORGENTE
					AND COALESCE(RIB.RIFERIMENTO,'ND') = COALESCE(CR.RIFERIMENTO,'ND') 					
--					AND (CR.ID_TIPO_RIFERIMENTO IS NULL OR RIB.RIFERIMENTO<>CR.RIFERIMENTO)			
			WHERE 
			CR.ID_CLIENTE_BIC IS NULL AND
			RIB.COD_SISTEMA_SORGENTE<>'NFEA'
			AND CAST(RIB.ID_CLIENTE_BIC AS INTEGER) NOT IN (SELECT  CAST(ID_CLIENTE_BIC AS INTEGER) FROM BIC_ODS_SA.NFEA_CONTATTO_DELTA_LOAD );
			
.IF ERRORLEVEL > 0 THEN .QUIT 16;

COLLECT STATISTICS BIC_ODS_SA.NFEA_CONTATTO_DELTA_LOAD  COLUMN ID_CLIENTE_BIC;
.IF ERRORLEVEL > 0 THEN .QUIT 16;

.LOGOFF; 
.QUIT;
