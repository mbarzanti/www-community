/*btq di storicizzazione per tutte le tabelle che fanno capo al cod_sistema_sorgente 'BP'*/ /************   Data              : Ottobre 2015   Descrizione       : Acquisizione flusso BP                       Linee guida v1.0                       con restartabilita , statistiche e monitoraggio di elaborazione.************/.set errorout stdout.set width 4096-- Failure 3807 Object does not exist.---.SET ERRORLEVEL 3807 SEVERITY 0;/******************************************************** *                                                      * * Acquisizione dei parametri di elaborazione           * *                                                      * ********************************************************//* Parametri di StoricizzazioneData_Day        = D1 Timestamp_run   = TS1prog_padre      ts_inizio_padre nome_prog       fase            flusso_originalenum_rec_flusso  database_dest   database_err    dt_rif          */.IMPORT VARTEXT '|' FILE=/data/DWH/AUC/SOURCE/BP/PARAMETRI_BP_CLIENTE_RETAIL.txt;USING( p01 VARCHAR(100), p02 VARCHAR(100), p03 VARCHAR(100), p04 VARCHAR(100), p05 VARCHAR(100), p06 VARCHAR(100), p07 VARCHAR(100), p08 VARCHAR(100), p09 VARCHAR(100), p10 VARCHAR(100), p11 VARCHAR(100)) exec BIC_ODS_SA.M_GTT_BTEQ_PARAMETER(:p01,:p02,:p03,:p04,:p05,:p06,:p07,:p08,:p09,:p10,:p11);/******************************************************** *                                                      * * INIZIO METADATI BTEQ                                 * *                                                      * ********************************************************/EXEC BIC_ODS_SA.RUNJOB_METADATA_START('STORICIZZA_AUC_BP.btq');.IF ERRORLEVEL > 0 THEN .QUIT 16;/******************************************************** *                                                      * * INIZIO BTEQ                                          * *                                                      * ********************************************************/database BIC_ODS_SA;/*------------------------------------------------------*/* INIZIO TRANSAZIONE*/SEL * FROM BIC_ODS_SA.RUNJOB_STEP_METADATA_CHECK WHERE STEP='AUC_BP_CLIENTE_RETAIL';.IF ACTIVITYCOUNT > 0 THEN .GOTO FINE_AUC_BP_CLIENTE_RETAILSEL * FROM BIC_ODS_SA.GTT_BTEQ_PARAMETER;.IF ACTIVITYCOUNT = 0 THEN .GOTO FINE_AUC_BP_CLIENTE_RETAILSEL TOP 1 * FROM BIC_ODS_SA.SA_AU_CLIENTE_RETAIL WHERE COD_SISTEMA_SORGENTE='BP';.IF ACTIVITYCOUNT = 0 THEN .GOTO MONIT_AUC_BP_CLIENTE_RETAILEXEC BIC_ODS_SA.RUNJOB_STEP_METADATA_START('AUC_BP_CLIENTE_RETAIL');.IF ERRORLEVEL > 0 THEN .QUIT 16;/* INIZIO logica di business */BT /*************************************************//*  BIC_ODS_SA.AUC_BP_CLIENTE_RETAIL   *//*************************************************/;UPDATE BIC_ODS_SA.AUC_BP_CLIENTE_RETAILFROM(SELECTSA.COD_CLIENTE_SORGENTE,SA.COD_SISTEMA_SORGENTE,SA.TS_INSFROMBIC_ODS_SA.SA_AU_CLIENTE_RETAIL SALEFT OUTER JOIN BIC_ODS_SA.AUC_BP_CLIENTE_RETAIL BIC	ON	SA.COD_CLIENTE_SORGENTE=BIC.COD_CLIENTE_SORGENTE	AND SA.COD_SISTEMA_SORGENTE = BIC.COD_SISTEMA_SORGENTEWHERE SA.COD_SISTEMA_SORGENTE='BP' ANDBIC.TS_FINE_VALIDITA = '2999-12-31 23:59:59'AND (COALESCE(SA.COD_FISCALE,'ND')<>COALESCE(BIC.COD_FISCALE,'ND') ORCOALESCE(SA.NOME,'ND')<>COALESCE(BIC.NOME,'ND') ORCOALESCE(SA.COGNOME,'ND')<>COALESCE(BIC.COGNOME,'ND') ORCOALESCE(SA.DT_NASCITA,( DATE '9999-12-31'))<>COALESCE(BIC.DT_NASCITA,( DATE '9999-12-31')) ORCOALESCE(SA.COD_SESSO,'Z')<>COALESCE(BIC.COD_SESSO,'Z') ORCOALESCE(SA.COD_COMUNE_NASCITA,'ND')<>COALESCE(BIC.COD_COMUNE_NASCITA,'ND') ORCOALESCE(SA.DESC_COMUNE_NASCITA,'ND')<>COALESCE(BIC.DESC_COMUNE_NASCITA,'ND') ORCOALESCE(SA.COD_PROVINCIA_NASCITA,'ND')<>COALESCE(BIC.COD_PROVINCIA_NASCITA,'ND') ORCOALESCE(SA.DESC_PROVINCIA_NASCITA,'ND')<>COALESCE(BIC.DESC_PROVINCIA_NASCITA,'ND') ORCOALESCE(SA.ID_NAZIONE_NASCITA,'ND')<>COALESCE(BIC.ID_NAZIONE_NASCITA,'ND') ORCOALESCE(SA.DESC_NAZIONE_NASCITA,'ND')<>COALESCE(BIC.DESC_NAZIONE_NASCITA,'ND') ORCOALESCE(SA.FLAG_CERTIFICAZIONE,'Z')<>COALESCE(BIC.FLAG_CERTIFICAZIONE,'Z') ORCOALESCE(SA.TIPO_ELAB,'Z')<>COALESCE(BIC.TIPO_ELAB,'Z') ORCOALESCE(SA.COMUNE_STATO_ESTERO_NASCITA,'ND')<>COALESCE(BIC.COMUNE_STATO_ESTERO_NASCITA,'ND') ORCOALESCE(SA.COD_NAZIONE_FISCALE,'ND')<>COALESCE(BIC.COD_NAZIONE_FISCALE,'ND') ORCOALESCE(SA.TIPO_PERS,'ND')<>COALESCE(BIC.TIPO_PERS,'ND') ORCOALESCE(SA.PROFESSIONE,'ND')<>COALESCE(BIC.PROFESSIONE,'ND') ORCOALESCE(SA.TITOLO_DI_STUDIO,'ND')<>COALESCE(BIC.TITOLO_DI_STUDIO,'ND') ORCOALESCE(SA.CLIENTE_PROSPECT,'ND')<>COALESCE(BIC.CLIENTE_PROSPECT,'ND') ORCOALESCE(SA.FLAG_DECESSO,'Z')<>COALESCE(BIC.FLAG_DECESSO,'Z') ORCOALESCE(SA.DT_DECESSO,( DATE '9999-12-31'))<>COALESCE(BIC.DT_DECESSO,( DATE '9999-12-31')) ORCOALESCE(SA.USERID,'ND')<>COALESCE(BIC.USERID,'ND') ORCOALESCE(SA.ID_CLIENTE_BIC,'ND')<>COALESCE(BIC.ID_CLIENTE_BIC,'ND') ORCOALESCE(SA.TIPO_CLIENTE_FONTE,'Z')<>COALESCE(BIC.TIPO_CLIENTE_FONTE,'Z') ORCOALESCE(SA.FLAG_IDENT_DIGIT,'Z')<>COALESCE(BIC.FLAG_IDENT_DIGIT,'Z')) ) TABSET TS_FINE_VALIDITA=TAB.TS_INS - interval '1' second WHERE BIC_ODS_SA.AUC_BP_CLIENTE_RETAIL.COD_CLIENTE_SORGENTE=TAB.COD_CLIENTE_SORGENTEAND BIC_ODS_SA.AUC_BP_CLIENTE_RETAIL.COD_SISTEMA_SORGENTE = TAB.COD_SISTEMA_SORGENTEAND BIC_ODS_SA.AUC_BP_CLIENTE_RETAIL.TS_FINE_VALIDITA = '2999-12-31 23:59:59'                            --       C L I E N T E      ---- INSERIMENTO DEL RECORD FITTIZIO A FRONTE DI UNA NAZIONE NON PRESENTE NELLE TIPOLOGICHE;INSERT INTO EDW_DW_TIPOLOGICHE.EDW_DW_TDD_KEY_MAP_NAZ(ID_NAZ, CD_NAZ_SRG, CD_SIS_SRG, DS_NAZ_SRG, FLAG, ID_KEYMAP, DT_INI_VAL,		DT_FIN_VAL, TS_ULT_MOD)SELECT X.ID_NAZ, X.COD_COMUNE_NASCITA, X.COD_SISTEMA_SORGENTE, X.DESC_NAZ_SRG, X.FLAG,Y.ID_KEYMAP+ROW_NUMBER () OVER (ORDER BY X.COD_COMUNE_NASCITA),X.DATA_INIZIO, X.DATA_FINE, X.TS_TIMESTAMP FROM (SEL 0 AS ID_NAZ, COD_COMUNE_NASCITA ,'BP' AS COD_SISTEMA_SORGENTE, 	DESC_COMUNE_NASCITA  AS DESC_NAZ_SRG ,'F' AS FLAG , CURRENT_DATE AS DATA_INIZIO, '2999-12-31' AS DATA_FINE, CURRENT_TIMESTAMP (0) AS TS_TIMESTAMPFROM BIC_ODS_SA.SA_AU_CLIENTE_RETAIL BPLEFT JOIN EDW_DW_TIPOLOGICHE.EDW_DW_TDD_KEY_MAP_NAZ KM       ON COALESCE(BP.COD_COMUNE_NASCITA,'') = CD_NAZ_SRGAND CD_SIS_SRG = BP.COD_SISTEMA_SORGENTEWHERE KM.CD_NAZ_SRG IS NULLAND BP.COD_SISTEMA_SORGENTE='BP'AND SUBSTR(COD_COMUNE_NASCITA,1,1)='Z'GROUP BY 1,2,3,4,5,6,7,8) XCROSS JOIN (SEL MAX(ID_KEYMAP) ID_KEYMAP FROM EDW_DW_TIPOLOGICHE.EDW_DW_TDD_KEY_MAP_NAZ) Y/** INSERT BIC_ODS_SA.AUC_BP_CLIENTE_RETAIL DEI CLIENTI NUOVI**/;INSERT INTO BIC_ODS_SA.AUC_BP_CLIENTE_RETAILSELECTSA.COD_FISCALE,SA.NOME,SA.COGNOME,SA.DT_NASCITA,SA.COD_SESSO,SA.COD_COMUNE_NASCITA,SA.DESC_COMUNE_NASCITA,SA.COD_PROVINCIA_NASCITA,SA.DESC_PROVINCIA_NASCITA,SA.ID_NAZIONE_NASCITA,SA.DESC_NAZIONE_NASCITA,SA.FLAG_CERTIFICAZIONE,SA.TIPO_ELAB,SA.COD_CLIENTE_SORGENTE,SA.COMUNE_STATO_ESTERO_NASCITA,SA.COD_NAZIONE_FISCALE,SA.TIPO_PERS,SA.PROFESSIONE,SA.TITOLO_DI_STUDIO,SA.CLIENTE_PROSPECT,SA.FLAG_DECESSO,SA.DT_DECESSO,SA.USERID,SA.ID_CLIENTE_BIC,SA.COD_SISTEMA_SORGENTE,SA.TIPO_CLIENTE_FONTE,SA.FLAG_IDENT_DIGIT,SA.DS_TIMESTAMP,BP_CIAE.DESC_CIAE DESC_PROFESSIONE,TDD_NAZ.CD_NAZ,CASE    WHEN SUBSTR(SA.COD_FISCALE,1,1)<='9'     THEN LPAD_OLD(SA.COD_FISCALE,11)    ELSE SA.COD_FISCALEENDAS CODICE_FISCALE_CLEAR,CASE WHEN SUBSTR(SA.COD_FISCALE,1,1)>'9' 	THEN CASE WHEN CFVALIDO(SA.COD_FISCALE)>0 			  THEN 'V'			  ELSE 'E'		 END	ELSE CASE WHEN SA.COD_FISCALE IS NULL THEN 'E'			  WHEN PIVAVALIDA(LPAD_OLD(SA.COD_FISCALE,11))>0 THEN 'V'		 ELSE 'E'	ENDENDAS IDS_COD_FISC,CASE WHEN BP.TS_FINE_VALIDITA IS NULL THEN 0     WHEN COALESCE(SA.COD_FISCALE,'') <> COALESCE(BP.COD_FISCALE,'') THEN 1      ELSE 0END AS FLAG_VAR_CF,CASE   WHEN SUBSTR(SA.COD_FISCALE, 1,1) > '9' AND IDS_COD_FISC = 'V'  THEN 'R'  WHEN SUBSTR(SA.COD_FISCALE, 1,1) <= '9' AND IDS_COD_FISC = 'V'  THEN 'B'  ELSE 'A'END AS TIPO_CLIENTE_DPR,SA.TS_INS AS TS_INIZIO_VALIDITA,'2999-12-31 23:59:59' AS TS_FINE_VALIDITA,SA.NOME_FLUSSOFROMBIC_ODS_SA.SA_AU_CLIENTE_RETAIL SALEFT OUTER JOIN BIC_ODS_SA.AUC_BP_CLIENTE_RETAIL BP ON SA.COD_CLIENTE_SORGENTE=BP.COD_CLIENTE_SORGENTE AND SA.COD_SISTEMA_SORGENTE = BP.COD_SISTEMA_SORGENTE LEFT OUTER JOIN BIC_ODS_SA.BP_CIAE ON SA.PROFESSIONE=BP_CIAE.COD_CIAE AND BP_CIAE.DATA_FINE_VALIDITA='2999-12-31'LEFT JOIN EDW_DW_TIPOLOGICHE.EDW_DW_TDD_KEY_MAP_NAZ KEY_MAP_NAZ	ON  COALESCE(SA.COD_COMUNE_NASCITA,'') = KEY_MAP_NAZ.CD_NAZ_SRG	AND KEY_MAP_NAZ.CD_SIS_SRG = 'BP'INNER JOIN EDW_DW_TIPOLOGICHE.EDW_DW_TDD_NAZ TDD_NAZ	ON TDD_NAZ.ID_NAZ = KEY_MAP_NAZ.ID_NAZWHERE  (BP.TS_FINE_VALIDITA =(SA.TS_INS - interval '1' second) OR (BP.TS_FINE_VALIDITA IS NULL AND SA.TIPO_ELAB <> 'C')) AND SA.COD_SISTEMA_SORGENTE = 'BP';ET;.IF ERRORLEVEL > 0 THEN .GOTO RUNJOB_STEP_ERROR;/* FINE logica di business */EXEC BIC_ODS_SA.RUNJOB_STEP_METADATA_END;.IF ERRORLEVEL > 0 THEN .QUIT 16;CALL EDWH.COLLECTSTATS( 'BIC_ODS_SA', 'AUC_BP_CLIENTE_RETAIL', S, C, ST );.IF ERRORLEVEL > 0 THEN .QUIT 21;/**** MONITORAGGIO  ****/.label MONIT_AUC_BP_CLIENTE_RETAILCALL BIC_ODS_SA.P_AUC_STAT_STORICIZZAZIONE( 'SA_AU_CLIENTE_RETAIL','AUC_BP_CLIENTE_RETAIL' ) ;.IF ERRORLEVEL > 0 THEN .QUIT 20;/**** FINE MONITORAGGIO ****/.label FINE_AUC_BP_CLIENTE_RETAIL/* * FINE TRANSAZIONE *------------------------------------------------------*/DEL FROM BIC_ODS_SA.GTT_BTEQ_PARAMETER;.IMPORT VARTEXT '|' FILE=/data/DWH/AUC/SOURCE/BP/PARAMETRI_BP_CLIENTE_BUSINESS.txt;USING( p01 VARCHAR(100), p02 VARCHAR(100), p03 VARCHAR(100), p04 VARCHAR(100), p05 VARCHAR(100), p06 VARCHAR(100), p07 VARCHAR(100), p08 VARCHAR(100), p09 VARCHAR(100), p10 VARCHAR(100), p11 VARCHAR(100)) exec BIC_ODS_SA.M_GTT_BTEQ_PARAMETER(:p01,:p02,:p03,:p04,:p05,:p06,:p07,:p08,:p09,:p10,:p11);/*------------------------------------------------------*/* INIZIO TRANSAZIONE*/SEL * FROM BIC_ODS_SA.RUNJOB_STEP_METADATA_CHECK WHERE STEP='AUC_BP_CLIENTE_BUSINESS';.IF ACTIVITYCOUNT > 0 THEN .GOTO FINE_AUC_BP_CLIENTE_BUSINESSSEL * FROM BIC_ODS_SA.GTT_BTEQ_PARAMETER;.IF ACTIVITYCOUNT = 0 THEN .GOTO FINE_AUC_BP_CLIENTE_BUSINESSSEL TOP 1 * FROM BIC_ODS_SA.SA_AU_CLIENTE_BUSINESS WHERE COD_SISTEMA_SORGENTE='BP';.IF ACTIVITYCOUNT = 0 THEN .GOTO MONIT_AUC_BP_CLIENTE_BUSINESSEXEC BIC_ODS_SA.RUNJOB_STEP_METADATA_START('AUC_BP_CLIENTE_BUSINESS');.IF ERRORLEVEL > 0 THEN .QUIT 16;/* INIZIO logica di business */ BT/*************************************************//*  BIC_ODS_SA.AUC_BP_CLIENTE_BUSINESS   *//*************************************************/;UPDATE BIC_ODS_SA.AUC_BP_CLIENTE_BUSINESSFROM(SELECTSA.COD_CLIENTE_SORGENTE,SA.COD_SISTEMA_SORGENTE,SA.TS_INSFROMBIC_ODS_SA.SA_AU_CLIENTE_BUSINESS SALEFT OUTER JOIN BIC_ODS_SA.AUC_BP_CLIENTE_BUSINESS BIC	ON	SA.COD_CLIENTE_SORGENTE=BIC.COD_CLIENTE_SORGENTE	AND SA.COD_SISTEMA_SORGENTE = BIC.COD_SISTEMA_SORGENTEWHERE SA.COD_SISTEMA_SORGENTE='BP' ANDBIC.TS_FINE_VALIDITA = '2999-12-31 23:59:59'AND (COALESCE(SA.RAGIONE_SOCIALE,'ND')<>COALESCE(BIC.RAGIONE_SOCIALE,'ND') ORCOALESCE(SA.ID_FORMA_GIURIDICA,'ND')<>COALESCE(BIC.ID_FORMA_GIURIDICA,'ND') ORCOALESCE(SA.COD_FISCALE,'ND')<>COALESCE(BIC.COD_FISCALE,'ND') ORCOALESCE(SA.COD_PARTITA_IVA,'ND')<>COALESCE(BIC.COD_PARTITA_IVA,'ND') ORCOALESCE(SA.FLAG_CERTIF,'Z')<>COALESCE(BIC.FLAG_CERTIF,'Z') ORCOALESCE(SA.TIPO_ELAB,'Z')<>COALESCE(BIC.TIPO_ELAB,'Z') ORCOALESCE(SA.COD_NAZIONE_FISCALE,'ND')<>COALESCE(BIC.COD_NAZIONE_FISCALE,'ND') ORCOALESCE(SA.COD_NAZIONE_PIVA,'ND')<>COALESCE(BIC.COD_NAZIONE_PIVA,'ND') ORCOALESCE(SA.COD_ISCR_REG_PROV_IMPRES,'ND')<>COALESCE(BIC.COD_ISCR_REG_PROV_IMPRES,'ND') ORCOALESCE(SA.COD_ISCRIZ_REG_CONSORZI,'ND')<>COALESCE(BIC.COD_ISCRIZ_REG_CONSORZI,'ND') ORCOALESCE(SA.CLIENTE_PROSPECT,'ND')<>COALESCE(BIC.CLIENTE_PROSPECT,'ND') ORCOALESCE(SA.ID_SETTORE_1,'ND')<>COALESCE(BIC.ID_SETTORE_1,'ND') ORCOALESCE(SA.ID_SETTORE_2,'ND')<>COALESCE(BIC.ID_SETTORE_2,'ND') ORCOALESCE(SA.ID_SETTORE_3,'ND')<>COALESCE(BIC.ID_SETTORE_3,'ND') ORCOALESCE(SA.FLAG_CESSAZIONE,'Z')<>COALESCE(BIC.FLAG_CESSAZIONE,'Z') ORCOALESCE(SA.TIPO_PERS,'ND')<>COALESCE(BIC.TIPO_PERS,'ND') ORCOALESCE(SA.ID_CLIENTE_BIC,'ND')<>COALESCE(BIC.ID_CLIENTE_BIC,'ND') ORCOALESCE(SA.TIPO_CLIENTE_FONTE,'Z')<>COALESCE(BIC.TIPO_CLIENTE_FONTE,'Z') ORCOALESCE(SA.FLAG_IDENT_DIGIT,'Z')<>COALESCE(BIC.FLAG_IDENT_DIGIT,'Z')) ) TABSET TS_FINE_VALIDITA=TAB.TS_INS - interval '1' second WHERE BIC_ODS_SA.AUC_BP_CLIENTE_BUSINESS.COD_CLIENTE_SORGENTE=TAB.COD_CLIENTE_SORGENTEAND BIC_ODS_SA.AUC_BP_CLIENTE_BUSINESS.COD_SISTEMA_SORGENTE = TAB.COD_SISTEMA_SORGENTEAND BIC_ODS_SA.AUC_BP_CLIENTE_BUSINESS.TS_FINE_VALIDITA = '2999-12-31 23:59:59'                            --       C L I E N T E      ---- INSERIMENTO DEL RECORD FITTIZIO A FRONTE DI UNA NAZIONE NON PRESENTE NELLE TIPOLOGICHE;INSERT INTO EDW_DW_TIPOLOGICHE.EDW_DW_TDD_KEY_MAP_NAZ(ID_NAZ, CD_NAZ_SRG, CD_SIS_SRG, DS_NAZ_SRG, FLAG, ID_KEYMAP, DT_INI_VAL,		DT_FIN_VAL, TS_ULT_MOD)SEL X.ID_NAZ, X.COD_NAZIONE_PIVA, X.COD_SISTEMA_SORGENTE, X.DESC_NAZ_SRG, X.FLAG,Y.ID_KEYMAP+ROW_NUMBER () OVER (ORDER BY X.COD_NAZIONE_PIVA),X.DATA_INIZIO, X.DATA_FINE, X.TS_TIMESTAMP FROM (SEL 0 AS ID_NAZ, COD_NAZIONE_PIVA ,'BP' AS COD_SISTEMA_SORGENTE, 	'' AS DESC_NAZ_SRG ,'F' AS FLAG , CURRENT_DATE AS DATA_INIZIO, '2999-12-31' AS DATA_FINE, CURRENT_TIMESTAMP (0) AS TS_TIMESTAMPFROM BIC_ODS_SA.SA_AU_CLIENTE_BUSINESS BPLEFT JOIN EDW_DW_TIPOLOGICHE.EDW_DW_TDD_KEY_MAP_NAZ KM       ON COALESCE(BP.COD_NAZIONE_PIVA,'') = CD_NAZ_SRGAND CD_SIS_SRG = BP.COD_SISTEMA_SORGENTEWHERE KM.CD_NAZ_SRG IS NULLAND BP.COD_SISTEMA_SORGENTE='BP'GROUP BY 1,2,3,4,5,6,7,8) XCROSS JOIN (SEL MAX(ID_KEYMAP) ID_KEYMAP FROM EDW_DW_TIPOLOGICHE.EDW_DW_TDD_KEY_MAP_NAZ) Y/** INSERT BIC_ODS_SA.AUC_BP_CLIENTE_BUSINESS DEI CLIENTI NUOVI**/;INSERT INTO BIC_ODS_SA.AUC_BP_CLIENTE_BUSINESSSELECTSA.RAGIONE_SOCIALE,SA.ID_FORMA_GIURIDICA,SA.COD_FISCALE,SA.COD_PARTITA_IVA,SA.FLAG_CERTIF,SA.TIPO_ELAB,SA.COD_NAZIONE_FISCALE,SA.COD_NAZIONE_PIVA,SA.COD_ISCR_REG_PROV_IMPRES,SA.COD_ISCRIZ_REG_CONSORZI,SA.CLIENTE_PROSPECT,SA.ID_SETTORE_1,SA.ID_SETTORE_2,SA.ID_SETTORE_3,SA.FLAG_CESSAZIONE,SA.TIPO_PERS,SA.ID_CLIENTE_BIC,SA.COD_CLIENTE_SORGENTE,SA.COD_SISTEMA_SORGENTE,SA.TIPO_CLIENTE_FONTE,SA.FLAG_IDENT_DIGIT,SA.DS_TIMESTAMP,TDD_NAZ.CD_NAZ,CASE    WHEN COALESCE(SA.COD_NAZIONE_PIVA ,'IT')<>'IT' AND SA.COD_NAZIONE_PIVA<>'ITA' THEN SA.COD_FISCALE    WHEN SUBSTR(SA.COD_FISCALE,1,1)<='9' THEN LPAD_OLD(SA.COD_FISCALE,11)    ELSE SA.COD_FISCALEENDAS CODICE_FISCALE_CLEAR,CASE WHEN SUBSTR(SA.COD_FISCALE,1,1)>'9' 	THEN CASE WHEN CFVALIDO(SA.COD_FISCALE)>0 			  THEN 'V'			  ELSE 'E'		 END	ELSE CASE WHEN SA.COD_FISCALE IS NULL THEN 'E'			  WHEN PIVAVALIDA(LPAD_OLD(SA.COD_FISCALE,11))>0 THEN 'V'		 ELSE 'E'	ENDENDAS IDS_COD_FISC,CASE WHEN BP.TS_FINE_VALIDITA IS NULL THEN 0     WHEN COALESCE(SA.COD_FISCALE,'') <> COALESCE(BP.COD_FISCALE,'') THEN 1      ELSE 0END AS FLAG_VAR_CF,TRIM(CAST(CASE WHEN COALESCE(SA.COD_PARTITA_IVA,'') = '' THEN NULL        WHEN (SA.COD_NAZIONE_PIVA= 'IT' OR SA.COD_NAZIONE_PIVA= 'ITA') AND substr (SA.COD_PARTITA_IVA,1,1) <= '9' THEN                LPAD_OLD (SA.COD_PARTITA_IVA,11)                 WHEN S.NAZIONE IS NOT NULL THEN SA.COD_PARTITA_IVA           ELSE NULL END  as varchar (20)))AS PARTITA_IVA_CLEAR,      CASE WHEN SA.COD_PARTITA_IVA IS NULL THEN 'E'            WHEN PIVAVALIDA (TRIM(SA.COD_PARTITA_IVA)) >0 THEN 'V'  WHEN (SA.COD_NAZIONE_PIVA  <>'IT' AND SA.COD_NAZIONE_PIVA  <>'ITA') THEN 'V'     ELSE 'E'END AS IDS_PIVA,CASE WHEN BP.TS_FINE_VALIDITA IS NULL THEN 0     WHEN COALESCE(SA.COD_PARTITA_IVA, 'ND')<>COALESCE(BP.COD_PARTITA_IVA,'ND') THEN 1     ELSE 0ENDAS FLAG_VAR_PIVA,CASE   WHEN (COALESCE(SA.COD_NAZIONE_PIVA ,'IT')<>'IT' AND SA.COD_NAZIONE_PIVA <>'ITA' ) THEN 'B'  WHEN SUBSTR(CODICE_FISCALE_CLEAR, 1,1) > '9' AND IDS_COD_FISC = 'V' AND IDS_PIVA='E'  THEN 'R'  WHEN (SUBSTR(CODICE_FISCALE_CLEAR, 1,1) <= '9' AND IDS_COD_FISC = 'V') OR IDS_PIVA='V'  THEN 'B'  ELSE 'A'END AS TIPO_CLIENTE_DPR,SA.TS_INS AS TS_INIZIO_VALIDITA,'2999-12-31 23:59:59' AS TS_FINE_VALIDITA,SA.NOME_FLUSSOFROMBIC_ODS_SA.SA_AU_CLIENTE_BUSINESS SALEFT OUTER JOIN BIC_ODS_SA.AUC_BP_CLIENTE_BUSINESS BP ON SA.COD_CLIENTE_SORGENTE=BP.COD_CLIENTE_SORGENTE AND SA.COD_SISTEMA_SORGENTE = BP.COD_SISTEMA_SORGENTELEFT JOIN BIC_ODS_SA.STR_PARTITA_IVA SON SA.COD_NAZIONE_PIVA=S.SIGLA_PAESEAND CHARACTER_LENGTH(SA.COD_PARTITA_IVA)=CHARACTER_LENGTH(S.STRUTTURA)AND S.SIGLA_PAESE<>'IT'LEFT JOIN EDW_DW_TIPOLOGICHE.EDW_DW_TDD_KEY_MAP_NAZ KEY_MAP_NAZ	ON  COALESCE(SA.COD_NAZIONE_PIVA,'') = KEY_MAP_NAZ.CD_NAZ_SRG	AND KEY_MAP_NAZ.CD_SIS_SRG = 'BP'INNER JOIN EDW_DW_TIPOLOGICHE.EDW_DW_TDD_NAZ TDD_NAZ	ON TDD_NAZ.ID_NAZ = KEY_MAP_NAZ.ID_NAZWHERE  (BP.TS_FINE_VALIDITA =(SA.TS_INS - interval '1' second) OR (BP.TS_FINE_VALIDITA IS NULL AND SA.TIPO_ELAB<>'C')) AND SA.COD_SISTEMA_SORGENTE = 'BP';ET;.IF ERRORLEVEL > 0 THEN .GOTO RUNJOB_STEP_ERROR;/* FINE logica di business */EXEC BIC_ODS_SA.RUNJOB_STEP_METADATA_END;.IF ERRORLEVEL > 0 THEN .QUIT 16;/**** MONITORAGGIO  ****/.label MONIT_AUC_BP_CLIENTE_BUSINESSCALL BIC_ODS_SA.P_AUC_STAT_STORICIZZAZIONE('SA_AU_CLIENTE_BUSINESS', 'AUC_BP_CLIENTE_BUSINESS' ) ;.IF ERRORLEVEL > 0 THEN .QUIT 20;/**** FINE MONITORAGGIO ****/.label FINE_AUC_BP_CLIENTE_BUSINESS/* * FINE TRANSAZIONE *------------------------------------------------------*/DEL FROM BIC_ODS_SA.GTT_BTEQ_PARAMETER;.IMPORT VARTEXT '|' FILE=/data/DWH/AUC/SOURCE/BP/PARAMETRI_BP_INDIRIZZI.txt;USING( p01 VARCHAR(100), p02 VARCHAR(100), p03 VARCHAR(100), p04 VARCHAR(100), p05 VARCHAR(100), p06 VARCHAR(100), p07 VARCHAR(100), p08 VARCHAR(100), p09 VARCHAR(100), p10 VARCHAR(100), p11 VARCHAR(100)) exec BIC_ODS_SA.M_GTT_BTEQ_PARAMETER(:p01,:p02,:p03,:p04,:p05,:p06,:p07,:p08,:p09,:p10,:p11);/*------------------------------------------------------* * INIZIO TRANSAZIONE */SEL * FROM BIC_ODS_SA.RUNJOB_STEP_METADATA_CHECK WHERE STEP='AUC_BP_INDIRIZZO';.IF ACTIVITYCOUNT > 0 THEN .GOTO FINE_AUC_BP_INDIRIZZOSEL * FROM BIC_ODS_SA.GTT_BTEQ_PARAMETER;.IF ACTIVITYCOUNT = 0 THEN .GOTO FINE_AUC_BP_INDIRIZZOSEL TOP 1 * FROM BIC_ODS_SA.SA_AU_INDIRIZZO WHERE COD_SISTEMA_SORGENTE='BP';.IF ACTIVITYCOUNT = 0 THEN .GOTO MONIT_AUC_BP_INDIRIZZOEXEC BIC_ODS_SA.RUNJOB_STEP_METADATA_START('AUC_BP_INDIRIZZO');.IF ERRORLEVEL > 0 THEN .QUIT 16;             --    I N D I R I Z Z O     ---- CREO LA TABELLA VOLATILE DEGLI INDIRIZZI CHIUSI --CREATE VOLATILE TABLE INDIRIZZI_CHIUSI AS (SEL COD_CLIENTE_SORGENTE,ID_TIPO_RIFER_INDIRIZZO,MAX(TS_FINE_VALIDITA) TS_FINE_VALIDITA FROM BIC_ODS_SA.AUC_BP_INDIRIZZOHAVING  MAX(TS_FINE_VALIDITA)<>'2999-12-31 23:59:59'GROUP BY 1,2)WITH DATA PRIMARY INDEX (COD_CLIENTE_SORGENTE,ID_TIPO_RIFER_INDIRIZZO)ON COMMIT PRESERVE ROWS;--CREO UNA TABELLA VOLATILE CON TUTTE LE COPPIE ESISTENTI INDIRIZZO_CONCATENATO, ID_INDIRIZZO_BIC_BPCREATE VOLATILE TABLE ANA_IND_BP AS(SEL ID_INDIRIZZO_BIC_BP,INDIRIZZO_CONCATENATO FROM BIC_ODS_SA.AUC_BP_INDIRIZZO WHERE ID_INDIRIZZO_BIC_BP IS NOT NULL GROUP BY 1,2 UNION SEL ID_INDIRIZZO_BIC_BP,INDIRIZZO_CONCATENATO FROM BIC_ODS_SA.BP_INDIRIZZO WHERE ID_INDIRIZZO_BIC_BP IS NOT NULL GROUP BY 1,2)WITH DATAPRIMARY INDEX (INDIRIZZO_CONCATENATO)ON COMMIT PRESERVE ROWS;/* INIZIO logica di business */BT             --    I N D I R I Z Z O     ---- CHIUDO I RECORD DA STORICIZZARE CHE SONO STATI MODIFICATI --;UPDATE  BIC_ODS_SA.AUC_BP_INDIRIZZOFROM(SELECTSA.COD_CLIENTE_SORGENTE AS COD_CLIENTE_SORGENTE,SA.COD_INDIRIZZO_SORGENTE AS COD_INDIRIZZO_SORGENTE,BP.TS_INIZIO_VALIDITA AS TS_INIZIO_VALIDITA,(SA.TS_INS - interval '1' second) AS TS_RIF_DATE,SA.ID_TIPO_RIFER_INDIRIZZO AS ID_TIPO_RIFER_INDIRIZZOFROM BIC_ODS_SA.SA_AU_INDIRIZZO AS SALEFT OUTER JOIN BIC_ODS_SA.AUC_BP_INDIRIZZO AS BP  ON SA.COD_CLIENTE_SORGENTE=BP.COD_CLIENTE_SORGENTE  AND COALESCE(SA.COD_INDIRIZZO_SORGENTE,'ND')=COALESCE(BP.COD_INDIRIZZO_SORGENTE,'ND')  AND SA.ID_TIPO_RIFER_INDIRIZZO = BP.ID_TIPO_RIFER_INDIRIZZOWHERE  SA.COD_SISTEMA_SORGENTE = 'BP'  AND BP.TS_FINE_VALIDITA = '2999-12-31 23:59:59'  AND BP.COD_CLIENTE_SORGENTE IS NOT NULL  AND(  COALESCE(SA.TIPO_STRADA,'ND')<>COALESCE(BP.TIPO_STRADA,'ND') OR  COALESCE(SA.NOME_STRADA,'ND')<>COALESCE(BP.NOME_STRADA,'ND') OR  COALESCE(SA.NUMERO_CIVICO,'ND')<>COALESCE(BP.NUMERO_CIVICO,'ND') OR  COALESCE(SA.FABBRICATO,'ND')<>COALESCE(BP.FABBRICATO,'ND') OR  COALESCE(SA.PRESSO,'ND')<>COALESCE(BP.PRESSO,'ND') OR  COALESCE(SA.INDIR_COMPL,'ND')<>COALESCE(BP.INDIR_COMPL,'ND') OR  COALESCE(SA.COD_COMUNE_MIN_FIN,'ND')<>COALESCE(BP.COD_COMUNE_MIN_FIN,'ND') OR  COALESCE(SA.DESC_COMUNE_CLI,'ND')<>COALESCE(BP.DESC_COMUNE_CLI,'ND') OR  COALESCE(SA.FRAZIONE,'ND')<>COALESCE(BP.FRAZIONE,'ND') OR  COALESCE(SA.CAP,'ND')<>COALESCE(BP.CAP,'ND') OR  COALESCE(SA.SIGLA_PROVINCIA_CLI,'ND')<>COALESCE(BP.SIGLA_PROVINCIA_CLI,'ND') OR  COALESCE(SA.DESC_PROVINCIA_CLI,'ND')<>COALESCE(BP.DESC_PROVINCIA_CLI,'ND') OR  COALESCE(SA.COD_NAZIONE_CLI,'ND')<>COALESCE(BP.COD_NAZIONE_CLI,'ND') OR  COALESCE(SA.DES_NAZIONE_CLI,'ND')<>COALESCE(BP.DES_NAZIONE_CLI,'ND') OR  COALESCE(SA.FLAG_NORM,'Z')<>COALESCE(BP.FLAG_NORM,'Z') OR  COALESCE(SA.TIPO_ELAB,'Z')<>COALESCE(BP.TIPO_ELAB,'Z') OR  COALESCE(SA.ID_INDIRIZZO,'ND')<>COALESCE(BP.ID_INDIRIZZO,'ND') OR  COALESCE(SA.CIVICOALTRO,'ND')<>COALESCE(BP.CIVICOALTRO,'ND') OR  COALESCE(SA.ID_CLIENTE_BIC,'ND')<>COALESCE(BP.ID_CLIENTE_BIC,'ND') ) GROUP BY 1,2,3,4,5 ) TABSET TS_FINE_VALIDITA=TAB.TS_RIF_DATEWHERE BIC_ODS_SA.AUC_BP_INDIRIZZO.COD_CLIENTE_SORGENTE=TAB.COD_CLIENTE_SORGENTEAND COALESCE(BIC_ODS_SA.AUC_BP_INDIRIZZO.COD_INDIRIZZO_SORGENTE,'ND') = COALESCE(TAB.COD_INDIRIZZO_SORGENTE,'ND')AND BIC_ODS_SA.AUC_BP_INDIRIZZO.ID_TIPO_RIFER_INDIRIZZO=TAB.ID_TIPO_RIFER_INDIRIZZOAND BIC_ODS_SA.AUC_BP_INDIRIZZO.TS_INIZIO_VALIDITA=TAB.TS_INIZIO_VALIDITA--                                    I N D I R I Z Z O                                ---- INSERIMENTO DEL RECORD FITTIZIO A FRONTE DI UNA NAZIONE NON PRESENTE NELLE TIPOLOGICHE;INSERT INTO EDW_DW_TIPOLOGICHE.EDW_DW_TDD_KEY_MAP_NAZ(ID_NAZ, CD_NAZ_SRG, CD_SIS_SRG, DS_NAZ_SRG, FLAG, ID_KEYMAP, DT_INI_VAL,    DT_FIN_VAL, TS_ULT_MOD)SEL X.ID_NAZ, X.COD_NAZIONE_CLI, X.COD_SISTEMA_SORGENTE, X.DESC_NAZ_SRG, X.FLAG,Y.ID_KEYMAP+ROW_NUMBER () OVER (ORDER BY X.COD_NAZIONE_CLI),X.DATA_INIZIO, X.DATA_FINE, X.TS_TIMESTAMP FROM (SEL 0 AS ID_NAZ, COD_NAZIONE_CLI,'BP' AS COD_SISTEMA_SORGENTE, '' AS DESC_NAZ_SRG ,'F' AS FLAG , CURRENT_DATE AS DATA_INIZIO, '2999-12-31' AS DATA_FINE, CURRENT_TIMESTAMP (0) AS TS_TIMESTAMPFROM BIC_ODS_SA.SA_AU_INDIRIZZOLEFT JOIN EDW_DW_TIPOLOGICHE.EDW_DW_TDD_KEY_MAP_NAZ KM                ON COALESCE(COD_NAZIONE_CLI,'') = CD_NAZ_SRGAND CD_SIS_SRG = 'BP'WHERE KM.CD_NAZ_SRG IS NULLAND SA_AU_INDIRIZZO.COD_SISTEMA_SORGENTE='BP'GROUP BY 1,2,3,4,5,6,7,8) XCROSS JOIN (SEL MAX(ID_KEYMAP) ID_KEYMAP FROM EDW_DW_TIPOLOGICHE.EDW_DW_TDD_KEY_MAP_NAZ) Y--     I N D I R I Z Z O    ---- INSERISCO I RECORD NUOVI --;INSERT INTO BIC_ODS_SA.AUC_BP_INDIRIZZOSELECT	ID_TIPO_RIFER_INDIRIZZO, TIPO_STRADA, NOME_STRADA,	NUMERO_CIVICO, FABBRICATO, PRESSO, INDIR_COMPL, COD_COMUNE_MIN_FIN,	DESC_COM, FRAZIONE, CAP_CLEAR, SIGLA_PROVINCIA_CLI, DESC_PROVINCIA_CLI,	COD_NAZIONE_CLI, DES_NAZIONE_CLI, FLAG_NORM, TIPO_ELAB,	ID_INDIRIZZO, CIVICOALTRO, ID_CLIENTE_BIC, COD_INDIRIZZO_SORGENTE,	COD_CLIENTE_SORGENTE, COD_SISTEMA_SORGENTE, DS_TIMESTAMP, CD_NAZ,	TS_INIZIO_VALIDITA, TS_FINE_VALIDITA, NOME_FLUSSO,VIA_COMPLETA, INDIRIZZO_CONCATENATO,	ID_INDIRIZZO_BIC_BP, TIPO_CLIENTE_FONTE, TIPO_CLIENTE_DPR, TS_UPDATE_DPRFROM( SELECTSA.ID_TIPO_RIFER_INDIRIZZO,SA.TIPO_STRADA,SA.NOME_STRADA,SA.NUMERO_CIVICO,COALESCE(TRIM(SUBSTR(SA.TIPO_STRADA,FINDFIRSTALPHANUM(SA.TIPO_STRADA),CHARACTER_LENGTH(SA.TIPO_STRADA))),'ND') COD_TOPONIMO,COALESCE(TRIM(SUBSTR(SA.NOME_STRADA,FINDFIRSTALPHANUM(SA.NOME_STRADA),CHARACTER_LENGTH(SA.NOME_STRADA))),'ND') NOM_STRADA,COALESCE(TRIM(SUBSTR(SA.NUMERO_CIVICO,FINDFIRSTALPHANUM(SA.NUMERO_CIVICO),CHARACTER_LENGTH(SA.NUMERO_CIVICO))),'ND') NUM_CIV,SA.FABBRICATO,SA.PRESSO,SA.INDIR_COMPL,SA.COD_COMUNE_MIN_FIN,COALESCE(TRIM(SUBSTR(SA.DESC_COMUNE_CLI,FINDFIRSTALPHANUM(SA.DESC_COMUNE_CLI),CHARACTER_LENGTH(SA.DESC_COMUNE_CLI))),'ND') DESC_COM,SA.FRAZIONE,TRIM(SUBSTR(SA.CAP,FINDFIRSTALPHANUM(SA.CAP),CHARACTER_LENGTH(SA.CAP))) AS CAP_CLEAR,SA.SIGLA_PROVINCIA_CLI,SA.DESC_PROVINCIA_CLI,SA.COD_NAZIONE_CLI,SA.DES_NAZIONE_CLI,SA.FLAG_NORM,SA.TIPO_ELAB,SA.ID_INDIRIZZO,SA.CIVICOALTRO,SA.ID_CLIENTE_BIC,SA.COD_INDIRIZZO_SORGENTE,SA.COD_CLIENTE_SORGENTE,SA.COD_SISTEMA_SORGENTE,SA.DS_TIMESTAMP,TDD_NAZ.CD_NAZ,SA.TS_INS AS TS_INIZIO_VALIDITA,'2999-12-31 23:59:59' AS TS_FINE_VALIDITA,SA.NOME_FLUSSO,NULL AS ID_INDIRIZZO_BIC_BP,NULL AS TIPO_CLIENTE_FONTE,NULL AS TIPO_CLIENTE_DPR,NULL AS TS_UPDATE_DPR,TRIM(SUBSTR(SA.COD_NAZIONE_CLI,FINDFIRSTALPHANUM(SA.COD_NAZIONE_CLI),CHARACTER_LENGTH(SA.COD_NAZIONE_CLI))) AS COD_NAZIONE_CLI_CLEAR,TRIM(SUBSTR(SA.SIGLA_PROVINCIA_CLI,FINDFIRSTALPHANUM(SA.SIGLA_PROVINCIA_CLI),CHARACTER_LENGTH(SA.SIGLA_PROVINCIA_CLI))) AS SIGLA_PROVINCIA_CLI_CLEAR,CASE  WHEN COD_NAZIONE_CLI_CLEAR ='IT' THEN    CASE WHEN IS_INTEGER(CAST(STRREPLACE (CAP_CLEAR,'O','0') AS VARCHAR(5)))=1 AND CHARACTER_LENGTH(CAP_CLEAR)=5    THEN CAST(STRREPLACE (CAP_CLEAR,'O','0') AS VARCHAR(5))    ELSE '99999' END  ELSE    COALESCE(CAP_CLEAR,'99999')END AS CAP_NEW,CASE  WHEN COD_NAZIONE_CLI_CLEAR ='IT' THEN    CASE WHEN ISALPHA(SIGLA_PROVINCIA_CLI_CLEAR)=1 AND CHARACTER_LENGTH(SIGLA_PROVINCIA_CLI_CLEAR)=2    THEN SIGLA_PROVINCIA_CLI_CLEAR    ELSE 'ND' END  ELSE    CASE WHEN SA.SIGLA_PROVINCIA_CLI IS NOT NULL    THEN SIGLA_PROVINCIA_CLI_CLEAR    ELSE 'ND' ENDEND AS PROV_NEW,TDD_NAZ.CD_NAZ AS NAZ_NEW,COD_TOPONIMO||' '||NOM_STRADA||' '||NUM_CIV AS VIA_COMPLETA,CASE WHEN COD_TOPONIMO||' '||NOM_STRADA||' '||NUM_CIV='ND ND ND' THENSA.INDIR_COMPL||' '||DESC_COM||' '||CAP_NEW ||' '||PROV_NEW||' '||NAZ_NEW ELSECOD_TOPONIMO||' '||NOM_STRADA||' '||NUM_CIV||' '||DESC_COM||' '||CAP_NEW ||' '||PROV_NEW||' '||NAZ_NEW END AS INDIRIZZO_CONCATENATOFROM	BIC_ODS_SA.SA_AU_INDIRIZZO SA  LEFT OUTER JOIN        BIC_ODS_SA.AUC_BP_INDIRIZZO AS BP  ON  SA.COD_CLIENTE_SORGENTE = BP.COD_CLIENTE_SORGENTE    AND  COALESCE(SA.COD_INDIRIZZO_SORGENTE,'ND') = COALESCE(BP.COD_INDIRIZZO_SORGENTE  ,'ND')  AND SA.ID_TIPO_RIFER_INDIRIZZO = BP.ID_TIPO_RIFER_INDIRIZZO	LEFT JOIN ( EDW_DW_TIPOLOGICHE.EDW_DW_TDD_KEY_MAP_NAZ KEY_MAP_NAZ						INNER JOIN EDW_DW_TIPOLOGICHE.EDW_DW_TDD_NAZ TDD_NAZ						ON TDD_NAZ.ID_NAZ = KEY_MAP_NAZ.ID_NAZ )	    ON COALESCE(SA.COD_NAZIONE_CLI,'') = CD_NAZ_SRG     AND CD_SIS_SRG = 'BP'WHERE  SA.COD_SISTEMA_SORGENTE='BP' AND (BP.TS_FINE_VALIDITA= SA.TS_INS - INTERVAL '1' SECONDOR (BP.TS_FINE_VALIDITA IS NULL AND SA.TIPO_ELAB<>'C')OR (SA.COD_CLIENTE_SORGENTE,SA.ID_TIPO_RIFER_INDIRIZZO) IN (SELECT COD_CLIENTE_SORGENTE,ID_TIPO_RIFER_INDIRIZZO FROM INDIRIZZI_CHIUSI)))X/* -INDIRIZZO TIPO_CLIENTE_FONTE RETAIL--------------------------------------------------------- */;UPDATE BIC_ODS_SA.AUC_BP_INDIRIZZOFROM BIC_ODS_SA.AUC_BP_CLIENTE_RETAIL ASET TIPO_CLIENTE_FONTE=A.TIPO_CLIENTE_FONTEWHERE BIC_ODS_SA.AUC_BP_INDIRIZZO.COD_SISTEMA_SORGENTE=A.COD_SISTEMA_SORGENTEAND BIC_ODS_SA.AUC_BP_INDIRIZZO.COD_CLIENTE_SORGENTE=A.COD_CLIENTE_SORGENTEAND BIC_ODS_SA.AUC_BP_INDIRIZZO.TS_FINE_VALIDITA='2999-12-31 23:59:59'AND A.TS_FINE_VALIDITA='2999-12-31 23:59:59'AND COALESCE(BIC_ODS_SA.AUC_BP_INDIRIZZO.TIPO_CLIENTE_FONTE,'')<>COALESCE(A.TIPO_CLIENTE_FONTE,'')/* -INDIRIZZO TIPO_CLIENTE_FONTE BUSINESS--------------------------------------------------------- */;UPDATE BIC_ODS_SA.AUC_BP_INDIRIZZOFROM BIC_ODS_SA.AUC_BP_CLIENTE_BUSINESS ASET TIPO_CLIENTE_FONTE=A.TIPO_CLIENTE_FONTEWHERE BIC_ODS_SA.AUC_BP_INDIRIZZO.COD_SISTEMA_SORGENTE=A.COD_SISTEMA_SORGENTEAND BIC_ODS_SA.AUC_BP_INDIRIZZO.COD_CLIENTE_SORGENTE=A.COD_CLIENTE_SORGENTEAND BIC_ODS_SA.AUC_BP_INDIRIZZO.TS_FINE_VALIDITA='2999-12-31 23:59:59'AND A.TS_FINE_VALIDITA='2999-12-31 23:59:59'AND COALESCE(BIC_ODS_SA.AUC_BP_INDIRIZZO.TIPO_CLIENTE_FONTE,'')<>COALESCE(A.TIPO_CLIENTE_FONTE,'')/* -INDIRIZZO TIPO_CLIENTE_FONTE_DPR RETAIL--------------------------------------------------------- */;UPDATE BIC_ODS_SA.AUC_BP_INDIRIZZOFROM BIC_ODS_SA.AUC_BP_CLIENTE_RETAIL ASET TIPO_CLIENTE_DPR=A.TIPO_CLIENTE_DPR,TS_UPDATE_DPR=A.DS_TIMESTAMPWHERE BIC_ODS_SA.AUC_BP_INDIRIZZO.COD_SISTEMA_SORGENTE=A.COD_SISTEMA_SORGENTEAND BIC_ODS_SA.AUC_BP_INDIRIZZO.COD_CLIENTE_SORGENTE=A.COD_CLIENTE_SORGENTEAND BIC_ODS_SA.AUC_BP_INDIRIZZO.TS_FINE_VALIDITA='2999-12-31 23:59:59'AND A.TS_FINE_VALIDITA='2999-12-31 23:59:59'AND COALESCE(BIC_ODS_SA.AUC_BP_INDIRIZZO.TIPO_CLIENTE_DPR,'')<>COALESCE(A.TIPO_CLIENTE_DPR,'')/* -INDIRIZZO TIPO_CLIENTE_FONTE_DPR BUSINESS-------------------------------------------------------- */;UPDATE BIC_ODS_SA.AUC_BP_INDIRIZZOFROM BIC_ODS_SA.AUC_BP_CLIENTE_BUSINESS ASET TIPO_CLIENTE_DPR=A.TIPO_CLIENTE_DPR,TS_UPDATE_DPR=CURRENT_TIMESTAMP(0)WHERE BIC_ODS_SA.AUC_BP_INDIRIZZO.COD_SISTEMA_SORGENTE=A.COD_SISTEMA_SORGENTEAND BIC_ODS_SA.AUC_BP_INDIRIZZO.COD_CLIENTE_SORGENTE=A.COD_CLIENTE_SORGENTEAND BIC_ODS_SA.AUC_BP_INDIRIZZO.TS_FINE_VALIDITA='2999-12-31 23:59:59'AND A.TS_FINE_VALIDITA='2999-12-31 23:59:59'AND COALESCE(BIC_ODS_SA.AUC_BP_INDIRIZZO.TIPO_CLIENTE_DPR,'')<>COALESCE(A.TIPO_CLIENTE_DPR,'')--AGGIORNO CON GLI ID_INDIRIZZO_BIC_BP ESISTENTI;UPDATE BIC_ODS_SA.AUC_BP_INDIRIZZOFROM  ANA_IND_BP TABSET ID_INDIRIZZO_BIC_BP=TAB.ID_INDIRIZZO_BIC_BPWHERE TS_FINE_VALIDITA='2999-12-31 23:59:59'AND BIC_ODS_SA.AUC_BP_INDIRIZZO.INDIRIZZO_CONCATENATO=TAB.INDIRIZZO_CONCATENATOAND BIC_ODS_SA.AUC_BP_INDIRIZZO.ID_INDIRIZZO_BIC_BP IS NULL--AGGIORNO CREANDO ID_INDIRIZZO_BIC_BP NUOVI;UPDATE BIC_ODS_SA.AUC_BP_INDIRIZZOFROM (SEL MASSIMO+ROW_NUMBER() OVER (ORDER BY INDIRIZZO_CONCATENATO)ID_NEW,INDIRIZZO_CONCATENATO FROM BIC_ODS_SA.AUC_BP_INDIRIZZOCROSS JOIN (SEL COALESCE(MAX(ID_INDIRIZZO_BIC_BP),0) MASSIMO FROM ANA_IND_BP) MWHERE TS_FINE_VALIDITA='2999-12-31 23:59:59'AND ID_INDIRIZZO_BIC_BP IS NULLGROUP BY 2) TABSET ID_INDIRIZZO_BIC_BP=TAB.ID_NEWWHERE TS_FINE_VALIDITA='2999-12-31 23:59:59'AND BIC_ODS_SA.AUC_BP_INDIRIZZO.INDIRIZZO_CONCATENATO=TAB.INDIRIZZO_CONCATENATOAND BIC_ODS_SA.AUC_BP_INDIRIZZO.ID_INDIRIZZO_BIC_BP IS NULL--INSERISCO NUOVI E VARIATI SULLA SA_GEO_INDIRIZZO_OUT;INSERT INTO  BIC_ODS_SA.SA_GEO_INDIRIZZO_OUTSELECT AUC.ID_INDIRIZZO_BIC_BP,AUC.COD_SISTEMA_SORGENTE,AUC.INDIRIZZO_CONCATENATO,CASE WHEN AUC.TIPO_STRADA<> 'ND' THEN COALESCE(AUC.TIPO_STRADA,'')||COALESCE((' '||AUC.NOME_STRADA),'')ELSE AUC.NOME_STRADA END AS VIA_COMPLETA,AUC.NUMERO_CIVICO,AUC.DESC_COMUNE_CLI,AUC.CAP,AUC.SIGLA_PROVINCIA_CLI,AUC.CD_NAZ,NULL,CURRENT_TIMESTAMP(0)FROM BIC_ODS_SA.AUC_BP_INDIRIZZO AUCINNER JOINBIC_ODS_SA.SA_AU_INDIRIZZO SAON    COALESCE(AUC.COD_INDIRIZZO_SORGENTE,'ND')=COALESCE(SA.COD_INDIRIZZO_SORGENTE,'ND')AND AUC.COD_CLIENTE_SORGENTE=SA.COD_CLIENTE_SORGENTEAND AUC.COD_SISTEMA_SORGENTE=SA.COD_SISTEMA_SORGENTEWHERE SA.COD_SISTEMA_SORGENTE='BP' ANDAUC.TS_FINE_VALIDITA='2999-12-31 23:59:59';ET;.IF ERRORLEVEL > 0 THEN .GOTO RUNJOB_STEP_ERROR;EXEC BIC_ODS_SA.RUNJOB_STEP_METADATA_END;.IF ERRORLEVEL > 0 THEN .QUIT 16;CALL EDWH.COLLECTSTATS( 'BIC_ODS_SA', 'AUC_BP_INDIRIZZO', S, C, ST );.IF ERRORLEVEL > 0 THEN .QUIT 21;/**** CANCELLAZIONE STAGING ONLINE ****/DELETE FROM BIC_ODS_SA.SA_AU_INDIRIZZO WHERE COD_SISTEMA_SORGENTE = 'BP';/**** MONITORAGGIO  ****/.label MONIT_AUC_BP_INDIRIZZOCALL BIC_ODS_SA.P_AUC_STAT_STORICIZZAZIONE( 'SA_AU_INDIRIZZO', 'AUC_BP_INDIRIZZO' ) ;.IF ERRORLEVEL > 0 THEN .QUIT 20;/**** FINE MONITORAGGIO ****/.label FINE_AUC_BP_INDIRIZZO--RD/* Controllo univocità RETAIL-BUSINESS, chiusura duplicato*/CREATE MULTISET VOLATILE  TABLE "RET-BUS" AS(sel   A.COD_CLIENTE_SORGENTE  AS "COD_CLI_BUS-RET", A.COD_SISTEMA_SORGENTE AS "COD_SISTE_SORG_BUS", A.TS_FINE_VALIDITA AS "FIN_VAL_BUS"  ,A.TS_INIZIO_VALIDITA  AS "INI_VAL_BUS",B.COD_SISTEMA_SORGENTE AS "COD_SISTE_SORG_RET", B.TS_FINE_VALIDITA AS "FIN_VAL_RET"  ,B.TS_INIZIO_VALIDITA  AS "INI_VAL_RET"from BIC_ODS_SA.AUC_BP_CLIENTE_BUSINESS A,BIC_ODS_SA.AUC_BP_CLIENTE_RETAIL Bwhere A.COD_CLIENTE_SORGENTE = B.COD_CLIENTE_SORGENTE  ANDA.COD_SISTEMA_SORGENTE = B.COD_SISTEMA_SORGENTE ANDA.TS_FINE_VALIDITA = B.TS_FINE_VALIDITA  ANDA.TS_FINE_VALIDITA='2999-12-31 23:59:59') WITH DATA NO PRIMARY INDEX ON COMMIT PRESERVE ROWS ;SELECT * FROM "RET-BUS";.IF ACTIVITYCOUNT = 0 THEN .GOTO NOT_EQUALS_TUPLEselect "INI_VAL_RET"from "RET-BUS" AS RBwhere RB."INI_VAL_BUS" = RB."INI_VAL_RET";.IF ACTIVITYCOUNT > 0 THEN .QUIT 16;update BIC_ODS_SA.AUC_BP_CLIENTE_BUSINESSfrom( select unique "INI_VAL_BUS","INI_VAL_RET","COD_CLI_BUS-RET","COD_SISTE_SORG_BUS","FIN_VAL_BUS","COD_SISTE_SORG_RET","FIN_VAL_RET"from "RET-BUS" AS RBwhere RB."INI_VAL_BUS" < RB."INI_VAL_RET") RBset TS_FINE_VALIDITA = RB."INI_VAL_RET"  - interval '1' secondwhere COD_CLIENTE_SORGENTE = RB."COD_CLI_BUS-RET"  ANDCOD_SISTEMA_SORGENTE = RB."COD_SISTE_SORG_RET" ANDTS_FINE_VALIDITA = RB."FIN_VAL_RET" ;.IF ERRORCODE > 0 THEN .QUIT 16;update BIC_ODS_SA.AUC_BP_CLIENTE_RETAILfrom( select unique "INI_VAL_BUS","INI_VAL_RET","COD_CLI_BUS-RET","COD_SISTE_SORG_BUS","FIN_VAL_BUS","COD_SISTE_SORG_RET","FIN_VAL_RET"from "RET-BUS" AS RBwhere RB."INI_VAL_BUS" > RB."INI_VAL_RET") RBset TS_FINE_VALIDITA = RB."INI_VAL_BUS"  - interval '1' secondwhere COD_CLIENTE_SORGENTE = RB."COD_CLI_BUS-RET"  ANDCOD_SISTEMA_SORGENTE = RB."COD_SISTE_SORG_BUS" ANDTS_FINE_VALIDITA = RB."FIN_VAL_BUS" ;.IF ERRORCODE > 0 THEN .QUIT 16;.label  NOT_EQUALS_TUPLECALL EDWH.COLLECTSTATS( 'BIC_ODS_SA', 'AUC_BP_CLIENTE_RETAIL', S, C, ST );.IF ERRORLEVEL > 0 THEN .QUIT 21;CALL EDWH.COLLECTSTATS( 'BIC_ODS_SA', 'AUC_BP_CLIENTE_BUSINESS', S, C, ST );.IF ERRORLEVEL > 0 THEN .QUIT 21;/* * FINE TRANSAZIONE *------------------------------------------------------*/DEL FROM BIC_ODS_SA.GTT_BTEQ_PARAMETER;  .IMPORT VARTEXT '|' FILE=/data/DWH/AUC/SOURCE/BP/PARAMETRI_BP_CONTATTI.txt;USING( p01 VARCHAR(100), p02 VARCHAR(100), p03 VARCHAR(100), p04 VARCHAR(100), p05 VARCHAR(100), p06 VARCHAR(100), p07 VARCHAR(100), p08 VARCHAR(100), p09 VARCHAR(100), p10 VARCHAR(100), p11 VARCHAR(100)) exec BIC_ODS_SA.M_GTT_BTEQ_PARAMETER(:p01,:p02,:p03,:p04,:p05,:p06,:p07,:p08,:p09,:p10,:p11);/*------------------------------------------------------* /*-----------------------------------------------------------------------------------------------------------------------------------------------------*--          C O N T A T T O          ----          C O N T A T T O         ----          C O N T A T T O         ----          C O N T A T T O      ----/*-----------------------------------------------------------------------------------------------------------------------------------------------------* * INIZIO TRANSAZIONE */SEL * FROM BIC_ODS_SA.RUNJOB_STEP_METADATA_CHECK WHERE STEP='AUC_BP_CONTATTO';.IF ACTIVITYCOUNT > 0 THEN .GOTO FINE_AUC_BP_CONTATTOSEL * FROM BIC_ODS_SA.GTT_BTEQ_PARAMETER;.IF ACTIVITYCOUNT = 0 THEN .GOTO FINE_AUC_BP_CONTATTOSEL TOP 1 * FROM BIC_ODS_SA.SA_AU_CONTATTO WHERE COD_SISTEMA_SORGENTE='BP';.IF ACTIVITYCOUNT = 0 THEN .GOTO MONIT_AUC_BP_CONTATTOEXEC BIC_ODS_SA.RUNJOB_STEP_METADATA_START('AUC_BP_CONTATTO');.IF ERRORLEVEL > 0 THEN .QUIT 16;/* INIZIO logica di business */BT                --    C O N T A T T O       ---- CHIUDO I RECORD DA STORICIZZARE CHE SONO STATI MODIFICATI --;UPDATE BIC_ODS_SA.AUC_BP_CONTATTOFROM(SELECT	SA.COD_CLIENTE_SORGENTE,SA.COD_CONTATTO_SORGENTE, SA.TS_INS AS TS_INS,SA.COD_SISTEMA_SORGENTE,SA.ID_TIPO_RIFERIMENTOFROM		BIC_ODS_SA.SA_AU_CONTATTO AS SA 	LEFT OUTER JOIN    BIC_ODS_SA.AUC_BP_CONTATTO AS BP	ON	SA.COD_CLIENTE_SORGENTE = BP.COD_CLIENTE_SORGENTE	AND COALESCE(SA.COD_CONTATTO_SORGENTE,'ND') = COALESCE(BP.COD_CONTATTO_SORGENTE,'ND')	AND SA.COD_SISTEMA_SORGENTE = BP.COD_SISTEMA_SORGENTE	AND COALESCE(SA.ID_TIPO_RIFERIMENTO, 'ND') = COALESCE(BP.ID_TIPO_RIFERIMENTO,'ND')WHERE    SA.COD_SISTEMA_SORGENTE='BP'	     AND BP.TS_FINE_VALIDITA='2999-12-31 23:59:59'	AND	(		COALESCE(SA.TIPO_ELAB,'Z')<>COALESCE(BP.TIPO_ELAB,'Z') OR		COALESCE(SA.ID_CLIENTE_BIC,'ND')<>COALESCE(BP.ID_CLIENTE_BIC,'ND') OR		COALESCE(SA.ID_TIPO_RIFERIMENTO,'ND')<>COALESCE(BP.ID_TIPO_RIFERIMENTO,'ND') OR		COALESCE(SA.RIFERIMENTO,'ND')<>COALESCE(BP.RIFERIMENTO,'ND') OR		COALESCE(SA.TIPO_CLIENTE_FONTE,'Z')<>COALESCE(BP.TIPO_CLIENTE_FONTE,'Z')	)  ) TAB	SET TS_FINE_VALIDITA=TAB.TS_INS - INTERVAL '1' SECONDWHERE BIC_ODS_SA.AUC_BP_CONTATTO.COD_CLIENTE_SORGENTE=TAB.COD_CLIENTE_SORGENTEAND COALESCE(BIC_ODS_SA.AUC_BP_CONTATTO.COD_CONTATTO_SORGENTE,'ND') = COALESCE(TAB.COD_CONTATTO_SORGENTE,'ND')AND BIC_ODS_SA.AUC_BP_CONTATTO.COD_SISTEMA_SORGENTE = TAB.COD_SISTEMA_SORGENTEAND COALESCE(BIC_ODS_SA.AUC_BP_CONTATTO.ID_TIPO_RIFERIMENTO,'ND') = COALESCE(TAB.ID_TIPO_RIFERIMENTO,'ND')AND BIC_ODS_SA.AUC_BP_CONTATTO.TS_FINE_VALIDITA='2999-12-31 23:59:59'--     C O N T A T T O     ---- INSERISCO I RECORD NUOVI --;INSERT INTO BIC_ODS_SA.AUC_BP_CONTATTOSELECTSA.TIPO_ELAB,SA.COD_CLIENTE_SORGENTE,'BP' COD_SISTEMA_SORGENTE,SA.COD_CONTATTO_SORGENTE,SA.ID_CLIENTE_BIC,SA.ID_TIPO_RIFERIMENTO,SA.RIFERIMENTO,SA.TIPO_CLIENTE_FONTE AS TIPO_CLIENTE_FONTE,SA.DS_TIMESTAMP,CASE  WHEN SA.ID_TIPO_RIFERIMENTO=2 OR  SA.ID_TIPO_RIFERIMENTO=7 THEN      ---  EMAIL  ---           CASE WHEN CHARACTER_LENGTH(SA.RIFERIMENTO)<6 THEN NULL          ELSE  CAST(STRREPLACE(SA.RIFERIMENTO,' ','') AS VARCHAR(160))           END           WHEN SA.ID_TIPO_RIFERIMENTO=3 OR  SA.ID_TIPO_RIFERIMENTO=5 THEN     ---  TELEFONO  ---             CASE WHEN CHARACTER_LENGTH(SA.RIFERIMENTO)<7 THEN NULL             ELSE                 CAST(CASE WHEN SUBSTR(TRIM(SA.RIFERIMENTO),1,5)='00390' THEN CLEANNUMBER(SUBSTR(TRIM(SA.RIFERIMENTO),5))                        WHEN SUBSTR(TRIM(SA.RIFERIMENTO),1,4)='0039'  THEN CLEANNUMBER(SUBSTR(TRIM(SA.RIFERIMENTO),2))                        WHEN SUBSTR(TRIM(SA.RIFERIMENTO),1,3)='+39'   THEN CLEANNUMBER(SUBSTR(TRIM(SA.RIFERIMENTO),4))                              WHEN SUBSTR(TRIM(SA.RIFERIMENTO),1,1) ='+'    THEN '00'||CLEANNUMBER(SUBSTR(TRIM(SA.RIFERIMENTO),2))                              WHEN SUBSTR(TRIM(SA.RIFERIMENTO),1,1)='0' AND                  (SELECT COUNT(0) FROM BIC_ODS_SA.PREFISSI_CELLULARE WHERE PREFISSO=SUBSTR(TRIM(SA.RIFERIMENTO),2,3))=1 THEN CLEANNUMBER(SUBSTR(TRIM(SA.RIFERIMENTO),2))                  WHEN SUBSTR(TRIM(SA.RIFERIMENTO),1,2)='00'     THEN '0'||CLEANNUMBER(TRIM(LEADING '0' FROM SA.RIFERIMENTO) )                               ELSE CLEANNUMBER(SA.RIFERIMENTO)                               END AS VARCHAR(160))                   END            WHEN SA.ID_TIPO_RIFERIMENTO=4 THEN      ---  FAX  ---             CASE WHEN CHARACTER_LENGTH(SA.RIFERIMENTO)<7 THEN NULL             ELSE                  CAST(CASE WHEN SUBSTR(TRIM(SA.RIFERIMENTO),1,5)='00390' THEN CLEANNUMBER(SUBSTR(TRIM(SA.RIFERIMENTO),5))                      WHEN SUBSTR(TRIM(SA.RIFERIMENTO),1,4)='0039'  THEN CLEANNUMBER(SUBSTR(TRIM(SA.RIFERIMENTO),2))                        WHEN SUBSTR(TRIM(SA.RIFERIMENTO),1,3)='+39'   THEN CLEANNUMBER(SUBSTR(TRIM(SA.RIFERIMENTO),4))                      WHEN SUBSTR(TRIM(SA.RIFERIMENTO),1,1) ='+'    THEN '00'||CLEANNUMBER(SUBSTR(TRIM(SA.RIFERIMENTO),2))                       WHEN SUBSTR(TRIM(SA.RIFERIMENTO),1,1)='0' AND (SELECT COUNT(0) FROM BIC_ODS_SA.PREFISSI_CELLULARE WHERE PREFISSO=SUBSTR(TRIM(SA.RIFERIMENTO),2,3))=1                      THEN CLEANNUMBER(SUBSTR(TRIM(SA.RIFERIMENTO),2))               WHEN SUBSTR(TRIM(SA.RIFERIMENTO),1,2)='00'    THEN '0'||CLEANNUMBER(TRIM(LEADING '0' FROM SA.RIFERIMENTO))                       ELSE CLEANNUMBER(SA.RIFERIMENTO)                     END AS VARCHAR(160))               END         WHEN SA.ID_TIPO_RIFERIMENTO=6 THEN     ---  CELLULARE  ---         CASE WHEN CHARACTER_LENGTH(SA.RIFERIMENTO)<9 THEN NULL                ELSE                CAST(CASE WHEN SUBSTR(TRIM(SA.RIFERIMENTO),1,3)='003' AND                        (SELECT COUNT(0) FROM BIC_ODS_SA.PREFISSI_CELLULARE WHERE PREFISSO=SUBSTR(TRIM(SA.RIFERIMENTO),2,3))=1 THEN CLEANNUMBER(SUBSTR(TRIM(SA.RIFERIMENTO),3))                       WHEN SUBSTR(TRIM(SA.RIFERIMENTO),1,4 )='0039' THEN CLEANNUMBER(SUBSTR(TRIM(SA.RIFERIMENTO),5))                       WHEN SUBSTR(TRIM(SA.RIFERIMENTO),1,4)='0003' AND                        (SELECT COUNT(0) FROM BIC_ODS_SA.PREFISSI_CELLULARE WHERE PREFISSO=SUBSTR(TRIM(SA.RIFERIMENTO),4,3))=1 THEN CLEANNUMBER(SUBSTR(TRIM(SA.RIFERIMENTO),4))                           WHEN SUBSTR(TRIM(SA.RIFERIMENTO),1,3 )='+39'  THEN CLEANNUMBER(SUBSTR(TRIM(SA.RIFERIMENTO),4))                           WHEN SUBSTR(TRIM(SA.RIFERIMENTO),1,1) ='+'    THEN '00'||CLEANNUMBER(SUBSTR(TRIM(SA.RIFERIMENTO),2))                           WHEN SUBSTR(TRIM(SA.RIFERIMENTO),1,1)='0' AND                           (SELECT COUNT(0) FROM BIC_ODS_SA.PREFISSI_CELLULARE WHERE PREFISSO=SUBSTR(TRIM(SA.RIFERIMENTO),2,3))=1 THEN CLEANNUMBER(SUBSTR(TRIM(SA.RIFERIMENTO),2))               WHEN SUBSTR(TRIM(SA.RIFERIMENTO),1,3)='000'   THEN CLEANNUMBER(TRIM(LEADING '0' FROM SA.RIFERIMENTO)) -- goF1                 ELSE CLEANNUMBER(SA.RIFERIMENTO)            END AS VARCHAR(160))            END      ELSE NULLEND AS RIFERIMENTO_CLEAR,NULL AS TIPO_CLIENTE_DPR,NULL AS TS_UPDATE_DPR,SA.TS_INS AS TS_INIZIO_VALIDITA,'2999-12-31 23:59:59' AS TS_FINE_VALIDITA,SA.NOME_FLUSSOFROM	BIC_ODS_SA.SA_AU_CONTATTO AS SA 	LEFT OUTER JOIN          BIC_ODS_SA.AUC_BP_CONTATTO AS BP	ON SA.COD_CLIENTE_SORGENTE = BP.COD_CLIENTE_SORGENTE	AND COALESCE(SA.COD_CONTATTO_SORGENTE,'ND') = COALESCE(BP.COD_CONTATTO_SORGENTE,'ND')	AND COALESCE(SA.ID_TIPO_RIFERIMENTO,'ND') = COALESCE(BP.ID_TIPO_RIFERIMENTO,'ND')CROSS JOIN BIC_ODS_SA.GTT_BTEQ_PARAMETER TWHERE	 SA.COD_SISTEMA_SORGENTE='BP' AND(BP.TS_FINE_VALIDITA= SA.TS_INS -  INTERVAL '1' SECOND	OR	(BP.TS_FINE_VALIDITA IS NULL AND SA.TIPO_ELAB<>'C'))/* -CONTATTO TIPO_CLIENTE_DPR RETAIL--------------------------------------------------------- */;UPDATE BIC_ODS_SA.AUC_BP_CONTATTOFROM (SELECT COD_CLIENTE_SORGENTE, TIPO_CLIENTE_DPR , DS_TIMESTAMP, COD_SISTEMA_SORGENTEFROM BIC_ODS_SA.AUC_BP_CLIENTE_RETAILWHERE TS_FINE_VALIDITA='2999-12-31 23:59:59') TABSET TIPO_CLIENTE_DPR = TAB.TIPO_CLIENTE_DPR		,TS_UPDATE_DPR = TAB.DS_TIMESTAMPWHERE BIC_ODS_SA.AUC_BP_CONTATTO.COD_CLIENTE_SORGENTE = TAB.COD_CLIENTE_SORGENTEAND BIC_ODS_SA.AUC_BP_CONTATTO.COD_SISTEMA_SORGENTE = TAB.COD_SISTEMA_SORGENTEAND BIC_ODS_SA.AUC_BP_CONTATTO.TS_FINE_VALIDITA='2999-12-31 23:59:59'AND COALESCE(BIC_ODS_SA.AUC_BP_CONTATTO.TIPO_CLIENTE_DPR,'') <> COALESCE(TAB.TIPO_CLIENTE_DPR,'')/* -CONTATTO TIPO_CLIENTE_DPR BUSINESS--------------------------------------------------------- */;UPDATE BIC_ODS_SA.AUC_BP_CONTATTOFROM (SELECT COD_CLIENTE_SORGENTE, TIPO_CLIENTE_DPR , DS_TIMESTAMP, COD_SISTEMA_SORGENTEFROM BIC_ODS_SA.AUC_BP_CLIENTE_BUSINESSWHERE TS_FINE_VALIDITA='2999-12-31 23:59:59') TABSET TIPO_CLIENTE_DPR = TAB.TIPO_CLIENTE_DPR		,TS_UPDATE_DPR = TAB.DS_TIMESTAMPWHERE BIC_ODS_SA.AUC_BP_CONTATTO.COD_CLIENTE_SORGENTE = TAB.COD_CLIENTE_SORGENTEAND BIC_ODS_SA.AUC_BP_CONTATTO.COD_SISTEMA_SORGENTE = TAB.COD_SISTEMA_SORGENTEAND BIC_ODS_SA.AUC_BP_CONTATTO.TS_FINE_VALIDITA='2999-12-31 23:59:59'AND COALESCE(BIC_ODS_SA.AUC_BP_CONTATTO.TIPO_CLIENTE_DPR,'') <> COALESCE(TAB.TIPO_CLIENTE_DPR,'');ET;.IF ERRORLEVEL > 0 THEN .GOTO RUNJOB_STEP_ERROR;/* FINE logica di business */EXEC BIC_ODS_SA.RUNJOB_STEP_METADATA_END;.IF ERRORLEVEL > 0 THEN .QUIT 16;CALL EDWH.COLLECTSTATS( 'BIC_ODS_SA', 'AUC_BP_CONTATTO', S, C, ST );.IF ERRORLEVEL > 0 THEN .QUIT 21;/**** CANCELLAZIONE STAGING ONLINE ****/DELETE FROM BIC_ODS_SA.SA_AU_CONTATTO WHERE COD_SISTEMA_SORGENTE = 'BP';/**** MONITORAGGIO  ****/.label MONIT_AUC_BP_CONTATTOCALL BIC_ODS_SA.P_AUC_STAT_STORICIZZAZIONE( 'SA_AU_CONTATTO','AUC_BP_CONTATTO' ) ;.IF ERRORLEVEL > 0 THEN .QUIT 20;/**** FINE MONITORAGGIO ****/.label FINE_AUC_BP_CONTATTO/* * FINE TRANSAZIONE *------------------------------------------------------*/DEL FROM BIC_ODS_SA.GTT_BTEQ_PARAMETER;  .IMPORT VARTEXT '|' FILE=/data/DWH/AUC/SOURCE/BP/PARAMETRI_BP_FIGURECORRELATE.txt;USING( p01 VARCHAR(100), p02 VARCHAR(100), p03 VARCHAR(100), p04 VARCHAR(100), p05 VARCHAR(100), p06 VARCHAR(100), p07 VARCHAR(100), p08 VARCHAR(100), p09 VARCHAR(100), p10 VARCHAR(100), p11 VARCHAR(100)) exec BIC_ODS_SA.M_GTT_BTEQ_PARAMETER(:p01,:p02,:p03,:p04,:p05,:p06,:p07,:p08,:p09,:p10,:p11);/*------------------------------------------------------*/*-----------------------------------------------------------------------------------------------------------------------------------------------------*--          F I G U R E  C O R R E L A T E         ----          F I G U R E  C O R R E L A T E         ----          F I G U R E  C O R R E L A T E   -/*-----------------------------------------------------------------------------------------------------------------------------------------------------* * INIZIO TRANSAZIONE */SEL * FROM BIC_ODS_SA.RUNJOB_STEP_METADATA_CHECK WHERE STEP='AUC_BP_FIG_CORR_BUSINESS';.IF ACTIVITYCOUNT > 0 THEN .GOTO FINE_AUC_BP_FIG_CORR_BUSINESSSEL * FROM BIC_ODS_SA.GTT_BTEQ_PARAMETER;.IF ACTIVITYCOUNT = 0 THEN .GOTO FINE_AUC_BP_FIG_CORR_BUSINESSSEL TOP 1 * FROM BIC_ODS_SA.SA_AU_FIG_CORR_BUSINESS WHERE COD_SISTEMA_SORGENTE='BP';.IF ACTIVITYCOUNT = 0 THEN .GOTO MONIT_AUC_BP_FIG_CORR_BUSINESSEXEC BIC_ODS_SA.RUNJOB_STEP_METADATA_START('AUC_BP_FIG_CORR_BUSINESS');.IF ERRORLEVEL > 0 THEN .QUIT 16;/* INIZIO logica di business */BT        --    F I G U R E  C O R R E L A T E       ---- CHIUDO I RECORD DA STORICIZZARE CHE SONO STATI MODIFICATI --;UPDATE BIC_ODS_SA.AUC_BP_FIG_CORR_BUSINESSFROM(SELECT	SA.COD_CLIENTE_SORGENTE,SA.COD_CLIENTE_SORG_FIG_CORR, SA.TS_INS AS TS_INS,SA.COD_SISTEMA_SORGENTE,SA.COD_TIPOLOGIA_RELFROM		BIC_ODS_SA.SA_AU_FIG_CORR_BUSINESS AS SA 	LEFT OUTER JOIN    BIC_ODS_SA.AUC_BP_FIG_CORR_BUSINESS AS BP	ON	SA.COD_CLIENTE_SORGENTE = BP.COD_CLIENTE_SORGENTE	AND COALESCE(SA.COD_CLIENTE_SORG_FIG_CORR,'ND') = COALESCE(BP.COD_CLIENTE_SORG_FIG_CORR,'ND')	AND COALESCE(SA.COD_TIPOLOGIA_REL,'ND') = COALESCE(BP.COD_TIPOLOGIA_REL,'ND')	AND SA.COD_SISTEMA_SORGENTE = BP.COD_SISTEMA_SORGENTEWHERE    SA.COD_SISTEMA_SORGENTE='BP'	     AND BP.TS_FINE_VALIDITA='2999-12-31 23:59:59'	AND	(		COALESCE(SA.COD_FISCALE,'ND')<>COALESCE(BP.COD_FISCALE,'ND') OR		COALESCE(SA.TIPO_ELAB,'Z')<>COALESCE(BP.TIPO_ELAB,'Z') OR		COALESCE(SA.ID_CLIENTE_BIC,'ND')<>COALESCE(BP.ID_CLIENTE_BIC,'ND') OR		COALESCE(SA.ID_FIG_CORRELATA,'ND')<>COALESCE(BP.ID_FIG_CORRELATA,'ND') OR		COALESCE(SA.DT_INIZIO_RELAZIONE,(DATE '9999-12-31'))<>COALESCE(BP.DT_INIZIO_RELAZIONE,(DATE '9999-12-31')) OR		COALESCE(SA.DT_FINE_RELAZIONE,(DATE '9999-12-31'))<>COALESCE(BP.DT_FINE_RELAZIONE,(DATE '9999-12-31')) 	)  ) TAB	SET TS_FINE_VALIDITA=TAB.TS_INS - INTERVAL '1' SECONDWHERE BIC_ODS_SA.AUC_BP_FIG_CORR_BUSINESS.COD_CLIENTE_SORGENTE=TAB.COD_CLIENTE_SORGENTEAND COALESCE(BIC_ODS_SA.AUC_BP_FIG_CORR_BUSINESS.COD_CLIENTE_SORG_FIG_CORR,'ND') = COALESCE(TAB.COD_CLIENTE_SORG_FIG_CORR,'ND')AND BIC_ODS_SA.AUC_BP_FIG_CORR_BUSINESS.COD_SISTEMA_SORGENTE = TAB.COD_SISTEMA_SORGENTEAND BIC_ODS_SA.AUC_BP_FIG_CORR_BUSINESS.COD_TIPOLOGIA_REL = TAB.COD_TIPOLOGIA_RELAND BIC_ODS_SA.AUC_BP_FIG_CORR_BUSINESS.TS_FINE_VALIDITA='2999-12-31 23:59:59'--    F I G U R E  C O R R E L A T E       ---- INSERISCO I RECORD NUOVI --;INSERT INTO BIC_ODS_SA.AUC_BP_FIG_CORR_BUSINESSSELECTSA.COD_FISCALE,SA.TIPO_ELAB,SA.COD_CLIENTE_SORGENTE,SA.ID_CLIENTE_BIC,SA.ID_FIG_CORRELATA,SA.COD_CLIENTE_SORG_FIG_CORR,SA.DT_INIZIO_RELAZIONE,SA.DT_FINE_RELAZIONE,SA.COD_TIPOLOGIA_REL,'BP' COD_SISTEMA_SORGENTE,SA.DS_TIMESTAMP,NULL AS TIPO_CLIENTE_FONTE,NULL AS TIPO_CLIENTE_DPR,NULL AS TS_UPDATE_DPR,SA.TS_INS AS TS_INIZIO_VALIDITA,'2999-12-31 23:59:59' AS TS_FINE_VALIDITA,SA.NOME_FLUSSOFROM	BIC_ODS_SA.SA_AU_FIG_CORR_BUSINESS AS SA 	LEFT OUTER JOIN          BIC_ODS_SA.AUC_BP_FIG_CORR_BUSINESS AS BP	ON SA.COD_CLIENTE_SORGENTE = BP.COD_CLIENTE_SORGENTE	AND COALESCE(SA.COD_CLIENTE_SORG_FIG_CORR,'ND') = COALESCE(BP.COD_CLIENTE_SORG_FIG_CORR,'ND')	AND COALESCE(SA.COD_TIPOLOGIA_REL,'ND') = COALESCE(BP.COD_TIPOLOGIA_REL,'ND')CROSS JOIN BIC_ODS_SA.GTT_BTEQ_PARAMETER TWHERE	 SA.COD_SISTEMA_SORGENTE='BP' AND(BP.TS_FINE_VALIDITA= SA.TS_INS -  INTERVAL '1' SECOND	OR	(BP.TS_FINE_VALIDITA IS NULL AND SA.TIPO_ELAB<>'C'))/* -FIGURE CORRELATE TIPO_CLIENTE_DPR RETAIL--------------------------------------------------------- */;UPDATE BIC_ODS_SA.AUC_BP_FIG_CORR_BUSINESSFROM (SELECT COD_CLIENTE_SORGENTE, TIPO_CLIENTE_DPR , DS_TIMESTAMP, COD_SISTEMA_SORGENTEFROM BIC_ODS_SA.AUC_BP_CLIENTE_RETAILWHERE TS_FINE_VALIDITA='2999-12-31 23:59:59') TABSET TIPO_CLIENTE_DPR = TAB.TIPO_CLIENTE_DPR		,TS_UPDATE_DPR = TAB.DS_TIMESTAMPWHERE BIC_ODS_SA.AUC_BP_FIG_CORR_BUSINESS.COD_CLIENTE_SORGENTE = TAB.COD_CLIENTE_SORGENTEAND BIC_ODS_SA.AUC_BP_FIG_CORR_BUSINESS.COD_SISTEMA_SORGENTE = TAB.COD_SISTEMA_SORGENTEAND BIC_ODS_SA.AUC_BP_FIG_CORR_BUSINESS.TS_FINE_VALIDITA='2999-12-31 23:59:59'AND COALESCE(BIC_ODS_SA.AUC_BP_FIG_CORR_BUSINESS.TIPO_CLIENTE_DPR,'') <> COALESCE(TAB.TIPO_CLIENTE_DPR,'')/* -FIGURE CORRELATE TIPO_CLIENTE_DPR BUSINESS--------------------------------------------------------- */;UPDATE BIC_ODS_SA.AUC_BP_FIG_CORR_BUSINESSFROM (SELECT COD_CLIENTE_SORGENTE, TIPO_CLIENTE_DPR , DS_TIMESTAMP, COD_SISTEMA_SORGENTEFROM BIC_ODS_SA.AUC_BP_CLIENTE_BUSINESSWHERE TS_FINE_VALIDITA='2999-12-31 23:59:59') TABSET TIPO_CLIENTE_DPR = TAB.TIPO_CLIENTE_DPR		,TS_UPDATE_DPR = TAB.DS_TIMESTAMPWHERE BIC_ODS_SA.AUC_BP_FIG_CORR_BUSINESS.COD_CLIENTE_SORGENTE = TAB.COD_CLIENTE_SORGENTEAND BIC_ODS_SA.AUC_BP_FIG_CORR_BUSINESS.COD_SISTEMA_SORGENTE = TAB.COD_SISTEMA_SORGENTEAND BIC_ODS_SA.AUC_BP_FIG_CORR_BUSINESS.TS_FINE_VALIDITA='2999-12-31 23:59:59'AND COALESCE(BIC_ODS_SA.AUC_BP_FIG_CORR_BUSINESS.TIPO_CLIENTE_DPR,'') <> COALESCE(TAB.TIPO_CLIENTE_DPR,'')/* -FIGURE CORRELATE TIPO_CLIENTE_FONTE RETAIL--------------------------------------------------------- */;UPDATE BIC_ODS_SA.AUC_BP_FIG_CORR_BUSINESSFROM (SELECT COD_CLIENTE_SORGENTE,TIPO_CLIENTE_FONTE,COD_SISTEMA_SORGENTEFROM BIC_ODS_SA.AUC_BP_CLIENTE_RETAILWHERE COD_SISTEMA_SORGENTE='BP'AND TS_FINE_VALIDITA='2999-12-31 23:59:59') TABSET TIPO_CLIENTE_FONTE = TAB.TIPO_CLIENTE_FONTEWHERE BIC_ODS_SA.AUC_BP_FIG_CORR_BUSINESS.COD_CLIENTE_SORGENTE = TAB.COD_CLIENTE_SORGENTEAND BIC_ODS_SA.AUC_BP_FIG_CORR_BUSINESS.COD_SISTEMA_SORGENTE = TAB.COD_SISTEMA_SORGENTEAND BIC_ODS_SA.AUC_BP_FIG_CORR_BUSINESS.TS_FINE_VALIDITA='2999-12-31 23:59:59'AND COALESCE(BIC_ODS_SA.AUC_BP_FIG_CORR_BUSINESS.TIPO_CLIENTE_FONTE,'') <> COALESCE(TAB.TIPO_CLIENTE_FONTE,'')/* -FIGURE CORRELATE TIPO_CLIENTE_FONTE BUSINESS--------------------------------------------------------- */;UPDATE BIC_ODS_SA.AUC_BP_FIG_CORR_BUSINESSFROM (SELECT COD_CLIENTE_SORGENTE,TIPO_CLIENTE_FONTE,COD_SISTEMA_SORGENTEFROM BIC_ODS_SA.AUC_BP_CLIENTE_BUSINESSWHERE COD_SISTEMA_SORGENTE='BP'AND TS_FINE_VALIDITA='2999-12-31 23:59:59') TABSET TIPO_CLIENTE_FONTE = TAB.TIPO_CLIENTE_FONTEWHERE BIC_ODS_SA.AUC_BP_FIG_CORR_BUSINESS.COD_CLIENTE_SORGENTE = TAB.COD_CLIENTE_SORGENTEAND BIC_ODS_SA.AUC_BP_FIG_CORR_BUSINESS.COD_SISTEMA_SORGENTE = TAB.COD_SISTEMA_SORGENTEAND BIC_ODS_SA.AUC_BP_FIG_CORR_BUSINESS.TS_FINE_VALIDITA='2999-12-31 23:59:59'AND COALESCE(BIC_ODS_SA.AUC_BP_FIG_CORR_BUSINESS.TIPO_CLIENTE_FONTE,'') <> COALESCE(TAB.TIPO_CLIENTE_FONTE,'');ET;.IF ERRORLEVEL > 0 THEN .GOTO RUNJOB_STEP_ERROR;/* FINE logica di business */EXEC BIC_ODS_SA.RUNJOB_STEP_METADATA_END;.IF ERRORLEVEL > 0 THEN .QUIT 16;CALL EDWH.COLLECTSTATS( 'BIC_ODS_SA', 'AUC_BP_FIG_CORR_BUSINESS', S, C, ST );.IF ERRORLEVEL > 0 THEN .QUIT 21;/**** CANCELLAZIONE STAGING ONLINE FIGURE CORRELATE ****/DELETE FROM BIC_ODS_SA.SA_AU_FIG_CORR_BUSINESS WHERE COD_SISTEMA_SORGENTE = 'BP';/**** MONITORAGGIO  ****/.label MONIT_AUC_BP_FIG_CORR_BUSINESSCALL BIC_ODS_SA.P_AUC_STAT_STORICIZZAZIONE('SA_AU_FIG_CORR_BUSINESS', 'AUC_BP_FIG_CORR_BUSINESS' ) ;.IF ERRORLEVEL > 0 THEN .QUIT 20;/**** FINE MONITORAGGIO ****/.label FINE_AUC_BP_FIG_CORR_BUSINESS/* * FINE TRANSAZIONE *------------------------------------------------------*/DEL FROM BIC_ODS_SA.GTT_BTEQ_PARAMETER;.IMPORT VARTEXT '|' FILE=/data/DWH/AUC/SOURCE/BP/PARAMETRI_BP_DOC_RETAIL.txt;USING( p01 VARCHAR(100), p02 VARCHAR(100), p03 VARCHAR(100), p04 VARCHAR(100), p05 VARCHAR(100), p06 VARCHAR(100), p07 VARCHAR(100), p08 VARCHAR(100), p09 VARCHAR(100), p10 VARCHAR(100), p11 VARCHAR(100)) exec BIC_ODS_SA.M_GTT_BTEQ_PARAMETER(:p01,:p02,:p03,:p04,:p05,:p06,:p07,:p08,:p09,:p10,:p11);/*------------------------------------------------------* /*---------------------------------------------------------------------------------------------------------------------------------------------------*--          D O C  R E T A I L          ----          D O C  R E T A I L         ----       D O C  R E T A I L     ----     D O C  R E T A I L     ----/*----------------------------------------------------------------------------------------------------------------------------------------------------*/* INIZIO TRANSAZIONE*/SEL * FROM BIC_ODS_SA.RUNJOB_STEP_METADATA_CHECK WHERE STEP='AUC_BP_DOC_RETAIL';.IF ACTIVITYCOUNT > 0 THEN .GOTO FINE_AUC_BP_DOC_RETAILSEL * FROM BIC_ODS_SA.GTT_BTEQ_PARAMETER;.IF ACTIVITYCOUNT = 0 THEN .GOTO FINE_AUC_BP_DOC_RETAILSEL TOP 1 * FROM BIC_ODS_SA.SA_AU_DOC_RETAIL WHERE COD_SISTEMA_SORGENTE='BP';.IF ACTIVITYCOUNT = 0 THEN .GOTO MONIT_AUC_BP_DOC_RETAILEXEC BIC_ODS_SA.RUNJOB_STEP_METADATA_START('AUC_BP_DOC_RETAIL');.IF ERRORLEVEL > 0 THEN .QUIT 16;/* INIZIO logica di business *//*************************************************//*  BIC_ODS_SA.AUC_BP_DOC_RETAIL   *//*************************************************/CREATE VOLATILE TABLE BP_AUC_DOCUMENTO_COMPLETO AS (SELECTTIPO_DOC,DESC_DOC,ID_ENTE_RILASCIO,DESC_ENTE_RILASCIO,DATA_RILASCIO_DOC,DATA_SCADENZA_DOC,CAST(DESCR_COMUNE AS VARCHAR(30))AS LUOGO_RILASCIO_DOC,PROV_RILASCIO_DOC,NUM_DOC,FLAG_INDIRIZZO_DOC,FLAG_CERTIF_ORACOLO,NOME,COGNOME,DATA_NASCITA,LUOGO_NASCITA,ID_CITTADINANZA,STATO_CIVILE,COD_CLIENTE_SORGENTE,COD_SISTEMA_SORGENTE,ID_CLIENTE_BIC,DS_TIMESTAMP,CASE WHEN( DESC_ENTE_RILASCIO NOT LIKE 'COMANDO%' AND DESC_ENTE_RILASCIO NOT LIKE 'COMM%' AND ( DESC_ENTE_RILASCIO LIKE 'C%M%U%N%' OR DESC_ENTE_RILASCIO LIKE '%SINDACO%' OR DESC_ENTE_RILASCIO LIKE '%OMUNE %' OR DESC_ENTE_RILASCIO LIKE 'CO%U%NE%' OR DESC_ENTE_RILASCIO LIKE '%MUN%' OR DESC_ENTE_RILASCIO LIKE '%CITTA%' OR DESC_ENTE_RILASCIO LIKE '%M%PIO%'  OR DESC_ENTE_RILASCIO LIKE 'COM%E%' OR DESC_ENTE_RILASCIO LIKE '%BURGEMEESTER%' OR DESC_ENTE_RILASCIO LIKE '%ANAG%'OR DESC_ENTE_RILASCIO LIKE '%CONUME%' )) OR BP_CLIENTE.TIPO_DOC = 'CIP' THEN 'COMUNE'WHEN DESC_ENTE_RILASCIO LIKE '%AMB%' OR DESC_ENTE_RILASCIO LIKE '%AMB.%' OR DESC_ENTE_RILASCIO LIKE '%A%CIATA%' OR DESC_ENTE_RILASCIO LIKE '%EMBASSY.%'THEN 'AMBASCIATA'WHEN DESC_ENTE_RILASCIO LIKE '%MOTO%' OR DESC_ENTE_RILASCIO LIKE '%M%C%T%'  OR DESC_ENTE_RILASCIO LIKE '%M%T%C%'  OR DESC_ENTE_RILASCIO LIKE '%MO%ZIONE%'  OR DESC_ENTE_RILASCIO LIKE '%M%ZIONE%'  OR DESC_ENTE_RILASCIO LIKE '%ZZAZIONE%'  OR DESC_ENTE_RILASCIO LIKE '%MOT.%' OR DESC_ENTE_RILASCIO LIKE '%MOT %'THEN 'MOTORIZZAZIONE'WHEN DESC_ENTE_RILASCIO LIKE '%INPS%' OR DESC_ENTE_RILASCIO LIKE '%I.N.P.S%' OR DESC_ENTE_RILASCIO LIKE '%IST%PRE%' OR DESC_ENTE_RILASCIO LIKE '%IN%S %' OR DESC_ENTE_RILASCIO LIKE '%IMPS%' OR DESC_ENTE_RILASCIO LIKE '%PREV%SOC%' OR DESC_ENTE_RILASCIO LIKE '%PREVIDENZA%'OR DESC_ENTE_RILASCIO LIKE '%PENSIONE%'THEN 'INPS'WHEN DESC_ENTE_RILASCIO LIKE '%CONS%' THEN 'CONSOLATO'WHEN DESC_ENTE_RILASCIO LIKE '%ENTE%' THEN 'ENTE'WHEN DESC_ENTE_RILASCIO LIKE '%FINANZA%' THEN 'GUARDIA DI FINANZA'WHEN DESC_ENTE_RILASCIO LIKE '%INPDAP%' THEN 'INPDAP'WHEN DESC_ENTE_RILASCIO LIKE '%PREF%' OR DESC_ENTE_RILASCIO LIKE '%PRE%TT%' OR DESC_ENTE_RILASCIO LIKE '%FETT%'THEN 'PREFETTURA'WHEN DESC_ENTE_RILASCIO LIKE '%QUES%' OR DESC_ENTE_RILASCIO LIKE '%QUET%'OR DESC_ENTE_RILASCIO LIKE '%Q%URA%'  OR DESC_ENTE_RILASCIO LIKE '%QUAES%' THEN 'QUESTURA'WHEN DESC_ENTE_RILASCIO LIKE '%AUT%' THEN 'AUTORITA'''WHEN DESC_ENTE_RILASCIO LIKE '%PROVV%' THEN 'PROVVEDITORATO'WHEN DESC_ENTE_RILASCIO LIKE '%POLIZ%' OR DESC_ENTE_RILASCIO LIKE '%POLIC%' OR DESC_ENTE_RILASCIO LIKE '%POLISMYNDIGHETEN%' THEN 'POLIZIA'WHEN DESC_ENTE_RILASCIO LIKE '%LEGI%' THEN 'LEGIONE'WHEN DESC_ENTE_RILASCIO LIKE '%COMM%' THEN 'COMMISSARIATO'WHEN DESC_ENTE_RILASCIO LIKE '%GOV%' OR DESC_ENTE_RILASCIO LIKE '%WOJEWODA%'  THEN 'GOVERNO'WHEN DESC_ENTE_RILASCIO LIKE '%UFF%' OR DESC_ENTE_RILASCIO LIKE '%BUREAU%' THEN 'UFFICIO'WHEN DESC_ENTE_RILASCIO LIKE '%ASL%' OR DESC_ENTE_RILASCIO LIKE '%USL%' OR DESC_ENTE_RILASCIO LIKE '%OSPE%' OR DESC_ENTE_RILASCIO LIKE '%AZIENDA O%'  OR DESC_ENTE_RILASCIO LIKE '%OSP.%' OR  DESC_ENTE_RILASCIO LIKE '%OSP %' OR DESC_ENTE_RILASCIO LIKE '%AZIENDA SAN%'  THEN 'AZIENDA SANITARIA'WHEN DESC_ENTE_RILASCIO LIKE '%CONS%'OR DESC_ENTE_RILASCIO LIKE '%CO%ATO%'THEN 'CONSOLATO'WHEN DESC_ENTE_RILASCIO LIKE '%REPUB%' OR DESC_ENTE_RILASCIO LIKE '%REP%'OR DESC_ENTE_RILASCIO LIKE '%RZECZPOSPOLITA%'THEN 'REPUBBLICA'WHEN DESC_ENTE_RILASCIO LIKE '%MIN%' THEN 'MINISTERO'WHEN DESC_ENTE_RILASCIO LIKE '%STATO%' THEN 'STATO'WHEN DESC_ENTE_RILASCIO LIKE '%CARABINIERI%' THEN 'CARABINIERI'WHEN DESC_ENTE_RILASCIO LIKE '%DIP%' OR DESC_ENTE_RILASCIO LIKE '%DEP%' THEN 'DIPARTIMENTO'WHEN DESC_ENTE_RILASCIO LIKE '%AUTOR%' THEN 'AUTORITA'''WHEN DESC_ENTE_RILASCIO LIKE '%UFFICIO%CENTRALE%' OR DESC_ENTE_RILASCIO LIKE '%UCO%' OR DESC_ENTE_RILASCIO LIKE '%U%.%C%.%O%' OR DESC_ENTE_RILASCIO LIKE '%U C O%'OR DESC_ENTE_RILASCIO LIKE '%U.C.%O%' THEN 'U.C.O'WHEN DESC_ENTE_RILASCIO LIKE '%UFFICIO%' THEN 'UFFICIO'WHEN DESC_ENTE_RILASCIO LIKE '%UNIVERS%' THEN 'UNIVERSITA'WHEN DESC_ENTE_RILASCIO LIKE '%POSTE ITALIANE%' THEN 'POSTE ITALIANE SPA'ELSE DESC_ENTE_RILASCIO END AS ENTE_LOCALITA_EMISSIONE,TIPO_CLIENTE_FONTE,TS_INS,NOME_FLUSSOFROM BIC_ODS_SA.SA_AU_DOC_RETAIL AS BP_CLIENTELEFT JOIN  BIC_AD_UP.DIP_COMUNE BON ' '||DESC_ENTE_RILASCIO LIKE '% '||DESCR_COMUNEAND DATA_FINE IS NULL WHERECOD_SISTEMA_SORGENTE='BP'QUALIFY ROW_NUMBER() OVER (PARTITION BY TIPO_DOC,COD_CLIENTE_SORGENTE ORDER BY CHARACTER_LENGTH (DESCR_COMUNE) DESC)=1)WITH DATAUNIQUE PRIMARY INDEX (TIPO_DOC,COD_CLIENTE_SORGENTE)ON COMMIT PRESERVE ROWS;.IF ERRORLEVEL > 0 THEN .GOTO RUNJOB_STEP_ERROR; BT                 --    D O C U M E N T O      ---- CHIUDO I RECORD DA STORICIZZARE CHE SONO STATI MODIFICATI --;UPDATE BIC_ODS_SA.AUC_BP_DOC_RETAILFROM(SELECTSA.COD_CLIENTE_SORGENTE,SA.COD_SISTEMA_SORGENTE,SA.TIPO_DOC,SA.TS_INSFROMBIC_ODS_SA.SA_AU_DOC_RETAIL SALEFT OUTER JOIN BIC_ODS_SA.AUC_BP_DOC_RETAIL BIC	ON	SA.COD_CLIENTE_SORGENTE=BIC.COD_CLIENTE_SORGENTE	AND SA.COD_SISTEMA_SORGENTE = BIC.COD_SISTEMA_SORGENTE	AND COALESCE(SA.TIPO_DOC,'ND') = COALESCE(BIC.TIPO_DOC,'ND')WHERE SA.COD_SISTEMA_SORGENTE='BP' ANDBIC.TS_FINE_VALIDITA = '2999-12-31 23:59:59'AND (COALESCE(SA.DESC_DOC,'ND')<>COALESCE(BIC.DESC_DOC,'ND') ORCOALESCE(SA.ID_ENTE_RILASCIO,'ND')<>COALESCE(BIC.ID_ENTE_RILASCIO,'ND') ORCOALESCE(SA.DESC_ENTE_RILASCIO,'ND')<>COALESCE(BIC.DESC_ENTE_RILASCIO,'ND') ORCOALESCE(SA.DATA_RILASCIO_DOC,( DATE '9999-12-31'))<>COALESCE(BIC.DATA_RILASCIO_DOC,( DATE '9999-12-31')) ORCOALESCE(SA.DATA_SCADENZA_DOC,( DATE '9999-12-31'))<>COALESCE(BIC.DATA_SCADENZA_DOC,( DATE '9999-12-31')) ORCOALESCE(SA.LUOGO_RILASCIO_DOC,'ND')<>COALESCE(BIC.LUOGO_RILASCIO_DOC,'ND') ORCOALESCE(SA.PROV_RILASCIO_DOC,'ND')<>COALESCE(BIC.PROV_RILASCIO_DOC,'ND') ORCOALESCE(SA.NUM_DOC,'ND')<>COALESCE(BIC.NUM_DOC,'ND') ORCOALESCE(SA.FLAG_INDIRIZZO_DOC,'Z')<>COALESCE(BIC.FLAG_INDIRIZZO_DOC,'Z') ORCOALESCE(SA.FLAG_CERTIF_ORACOLO,'Z')<>COALESCE(BIC.FLAG_CERTIF_ORACOLO,'Z') ORCOALESCE(SA.NOME,'ND')<>COALESCE(BIC.NOME,'ND') ORCOALESCE(SA.COGNOME,'ND')<>COALESCE(BIC.COGNOME,'ND') ORCOALESCE(SA.DATA_NASCITA,( DATE '9999-12-31'))<>COALESCE(BIC.DATA_NASCITA,( DATE '9999-12-31')) ORCOALESCE(SA.LUOGO_NASCITA,'ND')<>COALESCE(BIC.LUOGO_NASCITA,'ND') ORCOALESCE(SA.ID_CITTADINANZA,'ND')<>COALESCE(BIC.ID_CITTADINANZA,'ND') ORCOALESCE(SA.STATO_CIVILE,'Z')<>COALESCE(BIC.STATO_CIVILE,'Z') ORCOALESCE(SA.ID_CLIENTE_BIC,'ND')<>COALESCE(BIC.ID_CLIENTE_BIC,'ND') ORCOALESCE(SA.TIPO_CLIENTE_FONTE,'Z')<>COALESCE(BIC.TIPO_CLIENTE_FONTE,'Z')) ) TABSET TS_FINE_VALIDITA=TAB.TS_INS - interval '1' second WHERE BIC_ODS_SA.AUC_BP_DOC_RETAIL.COD_CLIENTE_SORGENTE=TAB.COD_CLIENTE_SORGENTEAND BIC_ODS_SA.AUC_BP_DOC_RETAIL.COD_SISTEMA_SORGENTE = TAB.COD_SISTEMA_SORGENTEAND COALESCE(BIC_ODS_SA.AUC_BP_DOC_RETAIL.TIPO_DOC,'ND') = COALESCE(TAB.TIPO_DOC,'ND')AND BIC_ODS_SA.AUC_BP_DOC_RETAIL.TS_FINE_VALIDITA = '2999-12-31 23:59:59'              	           --       D O C U M E N T O      ---- INSERIMENTO DEL RECORD FITTIZIO A FRONTE DI UN TIPO DOCUMENTO O DI UN ENTE NON PRESENTI NELLE TIPOLOGICHE/* COMMENTATO PERCHE' GESTITO IN PRESTAGINGINSERT INTO BIC_ODS.KEY_MAP_TIPO_DOCUMENTO(ID_DOCUMENTO, CD_DOC_SRG, CD_SIS_SRG, DS_DOC_SRG, FLAG, ID_KEYMAP, DT_INI_VAL,    DT_FIN_VAL, TS_ULT_MOD)SEL X.ID_DOCUMENTO, X.COD_DOCUMENTO, X.COD_SISTEMA_SORGENTE, X.DS_DOC_SRG, X.FLAG,Y.ID_KEYMAP+ROW_NUMBER () OVER (ORDER BY X.COD_DOCUMENTO),X.DATA_INIZIO, X.DATA_FINE, X.TS_TIMESTAMPFROM (SEL 0 AS ID_DOCUMENTO, COALESCE(TIPO_DOC,'ND') AS COD_DOCUMENTO ,'BP' AS COD_SISTEMA_SORGENTE, COALESCE(DESC_DOC,'ND') AS DS_DOC_SRG ,'F' AS FLAG , CURRENT_DATE AS DATA_INIZIO, '2999-12-31' AS DATA_FINE, TS_INS AS TS_TIMESTAMPFROM BIC_ODS_SA.SA_AU_DOC_RETAILLEFT JOIN BIC_ODS.KEY_MAP_TIPO_DOCUMENTO KM                ON COALESCE(TRIM(COD_DOCUMENTO),'ND') = TRIM(CD_DOC_SRG)AND CD_SIS_SRG = 'BP'WHERE KM.CD_DOC_SRG IS NULLAND COD_SISTEMA_SORGENTE='BP'GROUP BY 1,2,3,4,5,6,7,8) XCROSS JOIN(SEL MAX(ID_KEYMAP) ID_KEYMAP FROM BIC_ODS.KEY_MAP_TIPO_DOCUMENTO) Y;*/--ENTE RILASCIO;INSERT INTO BIC_ODS.KEY_MAP_TIPO_ENTE_RIL(ID_ENTE, CD_ENTE_SRG, CD_SIS_SRG,DS_ENTE_SRG, FLAG, ID_KEYMAP, DT_INI_VAL,    DT_FIN_VAL, TS_ULT_MOD)SEL X.ID_ENTE, X.ENTE_RIL_DOC, X.COD_SISTEMA_SORGENTE, X.DS_ENTE_SRG, X.FLAG,Y.ID_KEYMAP+ROW_NUMBER () OVER (ORDER BY X.ENTE_RIL_DOC),X.DATA_INIZIO, X.DATA_FINE, X.TS_TIMESTAMPFROM (SEL 0 AS ID_ENTE, COALESCE(ENTE_LOCALITA_EMISSIONE,'00') ENTE_RIL_DOC ,'BP' AS COD_SISTEMA_SORGENTE, COALESCE(UPPER(DS_ENTE_SRG),'ND') AS DS_ENTE_SRG ,'F' AS FLAG , CURRENT_DATE AS DATA_INIZIO, '2999-12-31' AS DATA_FINE, TS_INS AS TS_TIMESTAMPFROM BP_AUC_DOCUMENTO_COMPLETOLEFT JOIN BIC_ODS.KEY_MAP_TIPO_ENTE_RIL KM                ON COALESCE(ENTE_LOCALITA_EMISSIONE,'00') =CD_ENTE_SRGAND CD_SIS_SRG = 'BP'WHERE KM.CD_ENTE_SRG IS NULLGROUP BY 1,2,3,4,5,6,7,8) XCROSS JOIN(SEL MAX(ID_KEYMAP) ID_KEYMAP FROM BIC_ODS.KEY_MAP_TIPO_ENTE_RIL) Y/** INSERT BIC_ODS_SA.AUC_BP_DOC_RETAIL DEI CLIENTI NUOVI**/;INSERT INTO BIC_ODS_SA.AUC_BP_DOC_RETAILSELECTSA.TIPO_DOC,--A.DS_DOC_SRG DESC_DOC,SA.DESC_DOC,SA.ID_ENTE_RILASCIO,SA.DESC_ENTE_RILASCIO,SA.DATA_RILASCIO_DOC,SA.DATA_SCADENZA_DOC,SA.LUOGO_RILASCIO_DOC,SA.PROV_RILASCIO_DOC,SA.NUM_DOC,SA.FLAG_INDIRIZZO_DOC,SA.FLAG_CERTIF_ORACOLO,SA.NOME,SA.COGNOME,SA.DATA_NASCITA,SA.LUOGO_NASCITA,SA.ID_CITTADINANZA,SA.STATO_CIVILE,SA.COD_CLIENTE_SORGENTE,SA.COD_SISTEMA_SORGENTE,SA.ID_CLIENTE_BIC,SA.DS_TIMESTAMP,SA.ENTE_LOCALITA_EMISSIONE,--A.ID_DOCUMENTO ID_DOC_BIC,SA.TIPO_DOC ID_DOC_BIC,B.ID_ENTE ID_ENTE_BIC,SA.TIPO_CLIENTE_FONTE,NULL TIPO_CLIENTE_DPR,NULL TS_UPDATE_DPR,TS_INS TS_INIZIO_VALIDITA,'2999-12-31 23:59:59' TS_FINE_VALIDITA,SA.NOME_FLUSSOFROM	BP_AUC_DOCUMENTO_COMPLETO AS SA 	LEFT OUTER JOIN          BIC_ODS_SA.AUC_BP_DOC_RETAIL AS BP	ON SA.COD_CLIENTE_SORGENTE = BP.COD_CLIENTE_SORGENTE	AND SA.COD_SISTEMA_SORGENTE=BP.COD_SISTEMA_SORGENTE	AND COALESCE(SA.TIPO_DOC,'ND') = COALESCE(BP.TIPO_DOC,'ND')LEFT OUTER JOIN BIC_ODS_SA.AUC_BP_CLIENTE_RETAIL BP_TE ON BP.COD_CLIENTE_SORGENTE=BP_TE.COD_CLIENTE_SORGENTE AND BP.COD_SISTEMA_SORGENTE = BP_TE.COD_SISTEMA_SORGENTE/*  LEFT JOIN (SEL KM1.*,DS_DOCUMENTOFROM  BIC_ODS.KEY_MAP_TIPO_DOCUMENTO KM1INNER JOIN BIC_ODS.TIPO_DOCUMENTO TDA  ON  TDA.ID_DOCUMENTO=KM1.ID_DOCUMENTO) A  ON  SA.TIPO_DOC=A.CD_DOC_SRG  AND A.CD_SIS_SRG='BP'*/LEFT JOIN (SEL KM2.*,DS_ENTEFROM  BIC_ODS.KEY_MAP_TIPO_ENTE_RIL KM2INNER JOIN BIC_ODS.ENTE_RILASCIO ER  ON  ER.ID_ENTE=KM2.ID_ENTE) B  ON  COALESCE(SA.ENTE_LOCALITA_EMISSIONE,'00')=B.CD_ENTE_SRG  AND B.CD_SIS_SRG='BP'WHERE	 SA.COD_SISTEMA_SORGENTE='BP' AND(BP.TS_FINE_VALIDITA= SA.TS_INS -  INTERVAL '1' SECOND	OR	(BP.TS_FINE_VALIDITA IS NULL AND coalesce(BP_TE.TIPO_ELAB,'')<>'C'))	/* -TIPO_CLIENTE_DPR RETAIL--------------------------------------------------------- */;UPDATE BIC_ODS_SA.AUC_BP_DOC_RETAILFROM (SELECT COD_CLIENTE_SORGENTE, TIPO_CLIENTE_DPR , DS_TIMESTAMP, COD_SISTEMA_SORGENTEFROM BIC_ODS_SA.AUC_BP_CLIENTE_RETAILWHERE TS_FINE_VALIDITA='2999-12-31 23:59:59') TABSET TIPO_CLIENTE_DPR = TAB.TIPO_CLIENTE_DPR		,TS_UPDATE_DPR = TAB.DS_TIMESTAMPWHERE BIC_ODS_SA.AUC_BP_DOC_RETAIL.COD_CLIENTE_SORGENTE = TAB.COD_CLIENTE_SORGENTEAND BIC_ODS_SA.AUC_BP_DOC_RETAIL.COD_SISTEMA_SORGENTE = TAB.COD_SISTEMA_SORGENTEAND BIC_ODS_SA.AUC_BP_DOC_RETAIL.TS_FINE_VALIDITA='2999-12-31 23:59:59'AND COALESCE(BIC_ODS_SA.AUC_BP_DOC_RETAIL.TIPO_CLIENTE_DPR,'') <> COALESCE(TAB.TIPO_CLIENTE_DPR,'');ET;.IF ERRORLEVEL > 0 THEN .GOTO RUNJOB_STEP_ERROR;/* FINE logica di business */EXEC BIC_ODS_SA.RUNJOB_STEP_METADATA_END;.IF ERRORLEVEL > 0 THEN .QUIT 16;CALL EDWH.COLLECTSTATS( 'BIC_ODS_SA', 'AUC_BP_DOC_RETAIL', S, C, ST );.IF ERRORLEVEL > 0 THEN .QUIT 21;/**** CANCELLAZIONE STAGING ONLINE DOC RETAIL ****/DELETE FROM BIC_ODS_SA.SA_AU_DOC_RETAIL WHERE COD_SISTEMA_SORGENTE = 'BP';/**** MONITORAGGIO  ****/.label MONIT_AUC_BP_DOC_RETAILCALL BIC_ODS_SA.P_AUC_STAT_STORICIZZAZIONE('SA_AU_DOC_RETAIL', 'AUC_BP_DOC_RETAIL' ) ;.IF ERRORLEVEL > 0 THEN .QUIT 20;/**** FINE MONITORAGGIO ****/.label FINE_AUC_BP_DOC_RETAIL/* * FINE TRANSAZIONE *------------------------------------------------------*/DEL FROM BIC_ODS_SA.GTT_BTEQ_PARAMETER;.IMPORT VARTEXT '|' FILE=/data/DWH/AUC/SOURCE/BP/PARAMETRI_BP_DOC_RIC_BUSINESS.txt;USING( p01 VARCHAR(100), p02 VARCHAR(100), p03 VARCHAR(100), p04 VARCHAR(100), p05 VARCHAR(100), p06 VARCHAR(100), p07 VARCHAR(100), p08 VARCHAR(100), p09 VARCHAR(100), p10 VARCHAR(100), p11 VARCHAR(100)) exec BIC_ODS_SA.M_GTT_BTEQ_PARAMETER(:p01,:p02,:p03,:p04,:p05,:p06,:p07,:p08,:p09,:p10,:p11);/*------------------------------------------------------* /*---------------------------------------------------------------------------------------------------------------------------------------------------*--             D O C  B U S I N E S S             ----            D O C  B U S I N E S S           ----              D O C  B U S I N E S S           -/*----------------------------------------------------------------------------------------------------------------------------------------------------*/* INIZIO TRANSAZIONE*/SEL * FROM BIC_ODS_SA.RUNJOB_STEP_METADATA_CHECK WHERE STEP='AUC_BP_DOC_RIC_BUSINESS';.IF ACTIVITYCOUNT > 0 THEN .GOTO FINE_AUC_BP_DOC_RIC_BUSINESSSEL * FROM BIC_ODS_SA.GTT_BTEQ_PARAMETER;.IF ACTIVITYCOUNT = 0 THEN .GOTO FINE_AUC_BP_DOC_RIC_BUSINESSSEL TOP 1 * FROM BIC_ODS_SA.SA_AU_DOC_RIC_BUSINESS WHERE COD_SISTEMA_SORGENTE='BP';.IF ACTIVITYCOUNT = 0 THEN .GOTO MONIT_AUC_BP_DOC_RIC_BUSINESSEXEC BIC_ODS_SA.RUNJOB_STEP_METADATA_START('AUC_BP_DOC_RIC_BUSINESS');.IF ERRORLEVEL > 0 THEN .QUIT 16;/* INIZIO logica di business */ BT/*************************************************//*  BIC_ODS_SA.AUC_BP_DOC_RIC_BUSINESS   *//*************************************************/;UPDATE BIC_ODS_SA.AUC_BP_DOC_RIC_BUSINESSFROM(SELECTSA.COD_CLIENTE_SORGENTE,SA.COD_SISTEMA_SORGENTE,SA.TS_INSFROMBIC_ODS_SA.SA_AU_DOC_RIC_BUSINESS SALEFT OUTER JOIN BIC_ODS_SA.AUC_BP_DOC_RIC_BUSINESS BIC	ON	SA.COD_CLIENTE_SORGENTE=BIC.COD_CLIENTE_SORGENTE	AND SA.COD_SISTEMA_SORGENTE = BIC.COD_SISTEMA_SORGENTEWHERE SA.COD_SISTEMA_SORGENTE='BP' ANDBIC.TS_FINE_VALIDITA = '2999-12-31 23:59:59'AND (COALESCE(SA.CCIAA,'ND')<>COALESCE(BIC.CCIAA,'ND') ORCOALESCE(SA.REA,'ND')<>COALESCE(BIC.REA,'ND') ORCOALESCE(SA.TIPO_CLIENTE_FONTE,'Z')<>COALESCE(BIC.TIPO_CLIENTE_FONTE,'Z')) ) TABSET TS_FINE_VALIDITA=TAB.TS_INS - interval '1' second WHERE BIC_ODS_SA.AUC_BP_DOC_RIC_BUSINESS.COD_CLIENTE_SORGENTE=TAB.COD_CLIENTE_SORGENTEAND BIC_ODS_SA.AUC_BP_DOC_RIC_BUSINESS.COD_SISTEMA_SORGENTE = TAB.COD_SISTEMA_SORGENTEAND BIC_ODS_SA.AUC_BP_DOC_RIC_BUSINESS.TS_FINE_VALIDITA = '2999-12-31 23:59:59'    /** INSERT BIC_ODS_SA.AUC_BP_DOC_RIC_BUSINESS DEI CLIENTI NUOVI**/;INSERT INTO BIC_ODS_SA.AUC_BP_DOC_RIC_BUSINESSSELECTSA.CCIAA,SA.REA,SA.COD_CLIENTE_SORGENTE,'BP' COD_SISTEMA_SORGENTE,SA.ID_CLIENTE_BIC,SA.DS_TIMESTAMP,SA.TIPO_CLIENTE_FONTE,NULL AS TIPO_CLIENTE_DPR,NULL AS TS_UPDATE_DPR,SA.TS_INS AS TS_INIZIO_VALIDITA,'2999-12-31 23:59:59' AS TS_FINE_VALIDITA,SA.NOME_FLUSSOFROM	BIC_ODS_SA.SA_AU_DOC_RIC_BUSINESS AS SA 	LEFT OUTER JOIN          BIC_ODS_SA.AUC_BP_DOC_RIC_BUSINESS AS BP	ON SA.COD_CLIENTE_SORGENTE = BP.COD_CLIENTE_SORGENTE	AND SA.COD_SISTEMA_SORGENTE=BP.COD_SISTEMA_SORGENTELEFT OUTER JOIN BIC_ODS_SA.AUC_BP_CLIENTE_BUSINESS BP_TE ON BP_TE.COD_CLIENTE_SORGENTE=BP.COD_CLIENTE_SORGENTE AND BP_TE.COD_SISTEMA_SORGENTE = BP.COD_SISTEMA_SORGENTEWHERE	 SA.COD_SISTEMA_SORGENTE='BP' AND(BP.TS_FINE_VALIDITA= SA.TS_INS -  INTERVAL '1' SECOND	OR	(BP.TS_FINE_VALIDITA IS NULL AND coalesce(BP_TE.TIPO_ELAB,'')<>'C'))/* -TIPO_CLIENTE_DPR BUSINESS--------------------------------------------------------- */;UPDATE BIC_ODS_SA.AUC_BP_DOC_RIC_BUSINESSFROM (SELECT COD_CLIENTE_SORGENTE, TIPO_CLIENTE_DPR , DS_TIMESTAMP, COD_SISTEMA_SORGENTEFROM BIC_ODS_SA.AUC_BP_CLIENTE_BUSINESSWHERE TS_FINE_VALIDITA='2999-12-31 23:59:59') TABSET TIPO_CLIENTE_DPR = TAB.TIPO_CLIENTE_DPR		,TS_UPDATE_DPR = TAB.DS_TIMESTAMPWHERE BIC_ODS_SA.AUC_BP_DOC_RIC_BUSINESS.COD_CLIENTE_SORGENTE = TAB.COD_CLIENTE_SORGENTEAND BIC_ODS_SA.AUC_BP_DOC_RIC_BUSINESS.COD_SISTEMA_SORGENTE = TAB.COD_SISTEMA_SORGENTEAND BIC_ODS_SA.AUC_BP_DOC_RIC_BUSINESS.TS_FINE_VALIDITA='2999-12-31 23:59:59'AND COALESCE(BIC_ODS_SA.AUC_BP_DOC_RIC_BUSINESS.TIPO_CLIENTE_DPR,'') <> COALESCE(TAB.TIPO_CLIENTE_DPR,'');ET;.IF ERRORLEVEL > 0 THEN .GOTO RUNJOB_STEP_ERROR;/* FINE logica di business */EXEC BIC_ODS_SA.RUNJOB_STEP_METADATA_END;.IF ERRORLEVEL > 0 THEN .QUIT 16;CALL EDWH.COLLECTSTATS( 'BIC_ODS_SA', 'AUC_BP_DOC_RIC_BUSINESS', S, C, ST );.IF ERRORLEVEL > 0 THEN .QUIT 21;/**** CANCELLAZIONE STAGING ONLINE DOC BUSINESS ****/DELETE FROM BIC_ODS_SA.SA_AU_DOC_RIC_BUSINESS WHERE COD_SISTEMA_SORGENTE = 'BP';/**** MONITORAGGIO  ****/.label MONIT_AUC_BP_DOC_RIC_BUSINESSCALL BIC_ODS_SA.P_AUC_STAT_STORICIZZAZIONE('SA_AU_DOC_RIC_BUSINESS', 'AUC_BP_DOC_RIC_BUSINESS' ) ;.IF ERRORLEVEL > 0 THEN .QUIT 20;/**** FINE MONITORAGGIO ****/.label FINE_AUC_BP_DOC_RIC_BUSINESS/* * FINE TRANSAZIONE *------------------------------------------------------*/ /******************************************************** *                                                      * * FINE METADATI BTEQ                                   * *                                                      * ********************************************************/EXEC BIC_ODS_SA.RUNJOB_METADATA_END;.IF ERRORLEVEL > 0 THEN .QUIT 16;.logoff.quit/******************************************************** *                                                      * * GESTIONE STEP ERRORE                                 * *                                                      * ********************************************************/.label RUNJOB_STEP_ERROREXEC BIC_ODS_SA.RUNJOB_STEP_METADATA_ERROR;.IF ERRORLEVEL > 0 THEN .QUIT 16;.logoff.quit