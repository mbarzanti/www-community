		, sum(coalesce(a.BON_TRIBUTO_ENTRATA,0)) as EVO_BON_TRIBUTO_ENTRATA
		, sum(coalesce(a.BON_CONDOMINIO_ENTRATA,0)) as EVO_BON_CONDOMINIO_ENTRATA
		, sum(coalesce(a.BON_ACQUISTO_CASA_ENTRATA,0)) as EVO_BON_ACQUISTO_CASA_ENTRATA
		, sum(coalesce(a.BON_UTENZE_ENTRATA,0)) as EVO_BON_UTENZE_ENTRATA
		, sum(coalesce(a.BON_SPESE_SANITARIE_ENTRATA,0)) as EVO_BON_SPESE_SANITARIE_ENTRATA
		, sum(coalesce(a.BON_MOTORI_ENTRATA,0)) as EVO_BON_MOTORI_ENTRATA
		, sum(coalesce(a.BON_DISOCCUPAZIONE_ENTRATA,0)) as EVO_BON_DISOCCUPAZIONE_ENTRATA
		, sum(coalesce(a.BON_NOZZE_ENTRATA,0)) as EVO_BON_NOZZE_ENTRATA
		, sum(coalesce(a.BON_MANTENIMENTO_ENTRATA,0)) as EVO_BON_MANTENIMENTO_ENTRATA
		, sum(coalesce(a.BON_NUCLEO_FAMIGLIA_ENTRATA,0)) as EVO_BON_NUCLEO_FAMIGLIA_ENTRATA
		, sum(coalesce(a.BON_VIAGGI_ENTRATA,0)) as EVO_BON_VIAGGI_ENTRATA
		, sum(coalesce(a.BON_ISTRUZIONE_ENTRATA,0)) as EVO_BON_ISTRUZIONE_ENTRATA
		, sum(coalesce(a.BON_EREDITA_ENTRATA,0)) as EVO_BON_EREDITA_ENTRATA
		, sum(coalesce(a.BON_LIQUIDAZIONE_POLIZZA_ENTRATA,0)) as EVO_BON_LIQUIDAZIONE_POLIZZA_ENTRATA
		, sum(coalesce(a.BON_ALTRO_ENTRATA,0)) as EVO_BON_ALTRO_ENTRATA
		, sum(coalesce(a.BON_STIPENDIO_PENSIONE_USCITA,0)) as EVO_BON_STIPENDIO_PENSIONE_USCITA
		, sum(coalesce(a.BON_AFFITTO_USCITA,0)) as EVO_BON_AFFITTO_USCITA
		, sum(coalesce(a.BON_MUTUO_USCITA,0)) as EVO_BON_MUTUO_USCITA
		, sum(coalesce(a.BON_RETTA_USCITA,0)) as EVO_BON_RETTA_USCITA
		, sum(coalesce(a.BON_PRESTITO_USCITA,0)) as EVO_BON_PRESTITO_USCITA
		, sum(coalesce(a.BON_TRIBUTO_USCITA,0)) as EVO_BON_TRIBUTO_USCITA
		, sum(coalesce(a.BON_CONDOMINIO_USCITA,0)) as EVO_BON_CONDOMINIO_USCITA
		, sum(coalesce(a.BON_ACQUISTO_CASA_USCITA,0)) as EVO_BON_ACQUISTO_CASA_USCITA
		, sum(coalesce(a.BON_UTENZE_USCITA,0)) as EVO_BON_UTENZE_USCITA
		, sum(coalesce(a.BON_SPESE_SANITARIE_USCITA,0)) as EVO_BON_SPESE_SANITARIE_USCITA
		, sum(coalesce(a.BON_MOTORI_USCITA,0)) as EVO_BON_MOTORI_USCITA
		, sum(coalesce(a.BON_DISOCCUPAZIONE_USCITA,0)) as EVO_BON_DISOCCUPAZIONE_USCITA
		, sum(coalesce(a.BON_NOZZE_USCITA,0)) as EVO_BON_NOZZE_USCITA
		, sum(coalesce(a.BON_MANTENIMENTO_USCITA,0)) as EVO_BON_MANTENIMENTO_USCITA
		, sum(coalesce(a.BON_NUCLEO_FAMIGLIA_USCITA,0)) as EVO_BON_NUCLEO_FAMIGLIA_USCITA
		, sum(coalesce(a.BON_VIAGGI_USCITA,0)) as EVO_BON_VIAGGI_USCITA
		, sum(coalesce(a.BON_ISTRUZIONE_USCITA,0)) as EVO_BON_ISTRUZIONE_USCITA
		, sum(coalesce(a.BON_EREDITA_USCITA,0)) as EVO_BON_EREDITA_USCITA
		, sum(coalesce(a.BON_LIQUIDAZIONE_POLIZZA_USCITA,0)) as EVO_BON_LIQUIDAZIONE_POLIZZA_USCITA
		, sum(coalesce(a.BON_ALTRO_USCITA,0)) as EVO_BON_ALTRO_USCITA
		
		, (EVO_RICARICA_POSTEPAY_ATMPOSTE_IMP_ENTRATA + EVO_RICARICA_POSTEPAY_POSESTERNO_IMP_ENTRATA + EVO_RICARICA_POSTEPAY_UP_IMP_ENTRATA
			) as EVO_TOT_OPER_FISICO_IMP_ENTRATA
		
		, (EVO_RICARICA_POSTEPAY_ATMPOSTE_NUM_ENTRATA + EVO_RICARICA_POSTEPAY_POSESTERNO_NUM_ENTRATA + EVO_RICARICA_POSTEPAY_UP_NUM_ENTRATA
			) as EVO_TOT_OPER_FISICO_NUM_ENTRATA
		
		, (EVO_BONIFICO_UP_IMP_USCITA + EVO_BANCA_FIN_IMPOSTE_POSESTERNO_IMP_USCITA + EVO_BAR_RISTORANTI_POSESTERNO_IMP_USCITA
			+ EVO_CASA_POSESTERNO_IMP_USCITA + EVO_CASA_UP_IMP_USCITA + EVO_CIBO_SPESA_POSESTERNO_IMP_USCITA
			+ EVO_GIOCO_POSESTERNO_IMP_USCITA + EVO_ISTRUZIONE_POSESTERNO_IMP_USCITA + EVO_MOTORI_TRASPORTI_POSESTERNO_IMP_USCITA
			+ EVO_SALUTE_CURA_POSESTERNO_IMP_USCITA + EVO_SHOPPING_SERVIZI_POSESTERNO_IMP_USCITA + EVO_TEMPOLIBERO_VIAGGIO_POSESTERNO_IMP_USCITA
			+ EVO_PAG_VARIE_MCC_POSESTERNO_IMP_USCITA + EVO_PAG_ALTREMCC_ATMPOSTE_IMP_USCITA + EVO_PAG_ALTREMCC_POSESTERNO_IMP_USCITA
			+ EVO_PAG_ALTREMCC_ALTRO_IMP_USCITA + EVO_POSTAGIRO_A_CONTO_UP_IMP_USCITA + EVO_POSTAGIRO_A_EVO_UP_IMP_USCITA + EVO_PRELIEVO_ATMPOSTE_IMP_USCITA 
			+ EVO_PRELIEVO_ATMBANCARIO_IMP_USCITA + EVO_PRELIEVO_POSESTERNO_IMP_USCITA + EVO_PRELIEVO_UP_IMP_USCITA + EVO_RICARICA_POSTEPAY_ATMPOSTE_IMP_USCITA
			+ EVO_RICARICA_TELEFONICA_ATMPOSTE_IMP_USCITA + EVO_RICARICA_TELEFONICA_POSESTERNO_IMP_USCITA) as EVO_TOT_OPER_FISICO_IMP_USCITA
		
		, (EVO_BONIFICO_UP_NUM_USCITA + EVO_BANCA_FIN_IMPOSTE_POSESTERNO_NUM_USCITA + EVO_BAR_RISTORANTI_POSESTERNO_NUM_USCITA
			+ EVO_CASA_POSESTERNO_NUM_USCITA + EVO_CASA_UP_NUM_USCITA + EVO_CIBO_SPESA_POSESTERNO_NUM_USCITA
			+ EVO_GIOCO_POSESTERNO_NUM_USCITA + EVO_ISTRUZIONE_POSESTERNO_NUM_USCITA + EVO_MOTORI_TRASPORTI_POSESTERNO_NUM_USCITA
			+ EVO_SALUTE_CURA_POSESTERNO_NUM_USCITA + EVO_SHOPPING_SERVIZI_POSESTERNO_NUM_USCITA + EVO_TEMPOLIBERO_VIAGGIO_POSESTERNO_NUM_USCITA
			+ EVO_PAG_VARIE_MCC_POSESTERNO_NUM_USCITA + EVO_PAG_ALTREMCC_ATMPOSTE_NUM_USCITA + EVO_PAG_ALTREMCC_POSESTERNO_NUM_USCITA
			+ EVO_PAG_ALTREMCC_ALTRO_NUM_USCITA + EVO_POSTAGIRO_A_CONTO_UP_NUM_USCITA + EVO_POSTAGIRO_A_EVO_UP_NUM_USCITA + EVO_PRELIEVO_ATMPOSTE_NUM_USCITA 
			+ EVO_PRELIEVO_ATMBANCARIO_NUM_USCITA + EVO_PRELIEVO_POSESTERNO_NUM_USCITA + EVO_PRELIEVO_UP_NUM_USCITA + EVO_RICARICA_POSTEPAY_ATMPOSTE_NUM_USCITA
			+ EVO_RICARICA_TELEFONICA_ATMPOSTE_NUM_USCITA + EVO_RICARICA_TELEFONICA_POSESTERNO_NUM_USCITA) as EVO_TOT_OPER_FISICO_NUM_USCITA
		
		, (EVO_BONIFICO_CENTRO_IMP_ENTRATA + EVO_COMMISSIONI_CENTRO_IMP_ENTRATA + EVO_PAGAMENTI_CENTRO_IMP_ENTRATA
			 + EVO_POSTAGIRO_DA_CONTO_CENTRO_IMP_ENTRATA + EVO_POSTAGIRO_DA_EVO_CENTRO_IMP_ENTRATA + EVO_RICARICA_POSTEPAY_CENTRO_IMP_ENTRATA
			 + EVO_SDD_CENTRO_IMP_ENTRATA + EVO_STIPENDIO_PENSIONE_CENTRO_IMP_ENTRATA
			 + EVO_STORNO_CENTRO_IMP_ENTRATA + EVO_VARIE_CENTRO_IMP_ENTRATA) as EVO_TOT_OPER_CENTRO_IMP_ENTRATA
		
		, (EVO_BONIFICO_CENTRO_NUM_ENTRATA + EVO_COMMISSIONI_CENTRO_NUM_ENTRATA + EVO_PAGAMENTI_CENTRO_NUM_ENTRATA
			 + EVO_POSTAGIRO_DA_CONTO_CENTRO_NUM_ENTRATA + EVO_POSTAGIRO_DA_EVO_CENTRO_NUM_ENTRATA + EVO_RICARICA_POSTEPAY_CENTRO_NUM_ENTRATA
			 + EVO_SDD_CENTRO_NUM_ENTRATA + EVO_STIPENDIO_PENSIONE_CENTRO_NUM_ENTRATA
			 + EVO_STORNO_CENTRO_NUM_ENTRATA + EVO_VARIE_CENTRO_NUM_ENTRATA) as EVO_TOT_OPER_CENTRO_NUM_ENTRATA
		
		, (EVO_BONIFICO_CENTRO_IMP_USCITA + EVO_COMMISSIONI_CENTRO_IMP_USCITA + EVO_PAG_ALTREMCC_CENTRO_IMP_USCITA
			+ EVO_SDD_CENTRO_IMP_USCITA + EVO_STORNO_CENTRO_IMP_USCITA) as EVO_TOT_OPER_CENTRO_IMP_USCITA
		
		, (EVO_BONIFICO_CENTRO_NUM_USCITA + EVO_COMMISSIONI_CENTRO_NUM_USCITA + EVO_PAG_ALTREMCC_CENTRO_NUM_USCITA
			+ EVO_SDD_CENTRO_NUM_USCITA + EVO_STORNO_CENTRO_NUM_USCITA) as EVO_TOT_OPER_CENTRO_NUM_USCITA
				
		, (EVO_RICARICA_POSTEPAY_APP_IMP_ENTRATA + EVO_RICARICA_POSTEPAY_WEBPOSTE_IMP_ENTRATA) as EVO_TOT_OPER_DIGITAL_IMP_ENTRATA
		
		, (EVO_RICARICA_POSTEPAY_APP_NUM_ENTRATA + EVO_RICARICA_POSTEPAY_WEBPOSTE_NUM_ENTRATA) as EVO_TOT_OPER_DIGITAL_NUM_ENTRATA
		
		, (EVO_BONIFICO_APP_IMP_USCITA + EVO_BANCA_FIN_IMPOSTE_APP_IMP_USCITA + EVO_CASA_APP_IMP_USCITA + EVO_CIBO_SPESA_APP_IMP_USCITA
			+ EVO_MOTORI_TRASPORTI_APP_IMP_USCITA + EVO_SHOPPING_SERVIZI_APP_IMP_USCITA + EVO_PAG_ALTREMCC_APP_IMP_USCITA
			+ EVO_POSTAGIRO_A_CONTO_APP_IMP_USCITA + EVO_POSTAGIRO_A_EVO_APP_IMP_USCITA + EVO_RICARICA_POSTEPAY_APP_IMP_USCITA
			+ EVO_BONIFICO_WEBPOSTE_IMP_USCITA + EVO_BANCA_FIN_IMPOSTE_WEBESTERNO_IMP_USCITA + EVO_BANCA_FIN_IMPOSTE_WEBPOSTE_IMP_USCITA
			+ EVO_BAR_RISTORANTI_WEBESTERNO_IMP_USCITA + EVO_CASA_WEBESTERNO_IMP_USCITA + EVO_CIBO_SPESA_WEBESTERNO_IMP_USCITA
			+ EVO_GIOCO_WEBESTERNO_IMP_USCITA + EVO_ISTRUZIONE_WEBESTERNO_IMP_USCITA + EVO_MOTORI_TRASPORTI_WEBESTERNO_IMP_USCITA
			+ EVO_SALUTE_CURA_WEBESTERNO_IMP_USCITA + EVO_SHOPPING_SERVIZI_WEBESTERNO_IMP_USCITA + EVO_TEMPOLIBERO_VIAGGIO_WEBESTERNO_IMP_USCITA
			+ EVO_PAG_VARIE_MCC_WEBESTERNO_IMP_USCITA + EVO_PAG_VARIE_MCC_WEBPOSTE_IMP_USCITA + EVO_PAG_ALTREMCC_WEBESTERNO_IMP_USCITA
			+ EVO_PAG_ALTREMCC_WEBPOSTE_IMP_USCITA + EVO_POSTAGIRO_A_CONTO_WEBPOSTE_IMP_USCITA + EVO_POSTAGIRO_A_EVO_WEBPOSTE_IMP_USCITA
			+ EVO_RICARICA_POSTEPAY_WEBPOSTE_IMP_USCITA + EVO_RICARICA_TELEFONICA_WEBPOSTE_IMP_USCITA + EVO_RICARICA_TELEFONICA_DIGITAL_IMP_USCITA
		) as EVO_TOT_OPER_DIGITAL_IMP_USCITA		
		
		, (EVO_BONIFICO_APP_NUM_USCITA + EVO_BANCA_FIN_IMPOSTE_APP_NUM_USCITA + EVO_CASA_APP_NUM_USCITA + EVO_CIBO_SPESA_APP_NUM_USCITA
			+ EVO_MOTORI_TRASPORTI_APP_NUM_USCITA + EVO_SHOPPING_SERVIZI_APP_NUM_USCITA + EVO_PAG_ALTREMCC_APP_NUM_USCITA
			+ EVO_POSTAGIRO_A_CONTO_APP_NUM_USCITA + EVO_POSTAGIRO_A_EVO_APP_NUM_USCITA + EVO_RICARICA_POSTEPAY_APP_NUM_USCITA
			+ EVO_BONIFICO_WEBPOSTE_NUM_USCITA + EVO_BANCA_FIN_IMPOSTE_WEBESTERNO_NUM_USCITA + EVO_BANCA_FIN_IMPOSTE_WEBPOSTE_NUM_USCITA
			+ EVO_BAR_RISTORANTI_WEBESTERNO_NUM_USCITA + EVO_CASA_WEBESTERNO_NUM_USCITA + EVO_CIBO_SPESA_WEBESTERNO_NUM_USCITA
			+ EVO_GIOCO_WEBESTERNO_NUM_USCITA + EVO_ISTRUZIONE_WEBESTERNO_NUM_USCITA + EVO_MOTORI_TRASPORTI_WEBESTERNO_NUM_USCITA
			+ EVO_SALUTE_CURA_WEBESTERNO_NUM_USCITA + EVO_SHOPPING_SERVIZI_WEBESTERNO_NUM_USCITA + EVO_TEMPOLIBERO_VIAGGIO_WEBESTERNO_NUM_USCITA
			+ EVO_PAG_VARIE_MCC_WEBESTERNO_NUM_USCITA + EVO_PAG_VARIE_MCC_WEBPOSTE_NUM_USCITA + EVO_PAG_ALTREMCC_WEBESTERNO_NUM_USCITA
			+ EVO_PAG_ALTREMCC_WEBPOSTE_NUM_USCITA + EVO_POSTAGIRO_A_CONTO_WEBPOSTE_NUM_USCITA + EVO_POSTAGIRO_A_EVO_WEBPOSTE_NUM_USCITA
			+ EVO_RICARICA_POSTEPAY_WEBPOSTE_NUM_USCITA + EVO_RICARICA_TELEFONICA_WEBPOSTE_NUM_USCITA + EVO_RICARICA_TELEFONICA_DIGITAL_NUM_USCITA
		) as EVO_TOT_OPER_DIGITAL_NUM_USCITA
	from EBIL_AREE.V_CT_PERIMETRO as b
	left join MONETICA_MCC_RAGGR as a
		on a.ID_CLIENTE_BIC=b.ID_CLIENTE_BIC and a.TIPO_CARTA='EVOLUTION' 
	group by 1,2
)with data primary index(ID_CLIENTE_BIC) on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;

BT

;DELETE EBIL_AREE.CT_OPERAT_POSTEPAY_EVOLUTION
WHERE ID_PERIODO_TEMPORALE= (SELECT ID_PERIODO_TEMPORALE FROM EBIL_AREE.CT_PARAMETRI)

;INSERT INTO  EBIL_AREE.CT_OPERAT_POSTEPAY_EVOLUTION 
	select * from CT_OPERAT_EVOLUTION
WHERE ID_PERIODO_TEMPORALE= (SELECT ID_PERIODO_TEMPORALE FROM EBIL_AREE.CT_PARAMETRI)

;ET;

.IF ERRORCODE > 0 THEN .QUIT 16;

CREATE VOLATILE TABLE VTB_OPERAT_POSTEPAY_EVOLUTION_SV AS
(SELECT ID_PERIODO_TEMPORALE, ROW_NUMBER () over ( ORDER BY ID_PERIODO_TEMPORALE  DESC) AS ORDINAMENTO
FROM  EBIL_AREE.CT_OPERAT_POSTEPAY_EVOLUTION
GROUP BY 1)
WITH DATA PRIMARY INDEX (ID_PERIODO_TEMPORALE) ON COMMIT PRESERVE ROWS;
.IF ERRORCODE > 0 THEN .QUIT 16;

DELETE EBIL_AREE.CT_OPERAT_POSTEPAY_EVOLUTION
WHERE ID_PERIODO_TEMPORALE IN ( SELECT ID_PERIODO_TEMPORALE 
FROM VTB_OPERAT_POSTEPAY_EVOLUTION_SV
WHERE ORDINAMENTO >25);
.IF ERRORCODE > 0 THEN .QUIT 16;

