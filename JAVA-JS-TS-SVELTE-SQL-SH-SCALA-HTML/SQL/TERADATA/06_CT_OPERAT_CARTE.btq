.IF ERRORCODE > 0 THEN .QUIT 16;

drop table BONIFICI;
.IF ERRORCODE > 0 THEN .QUIT 16;

drop table CAUSALI_BONIFICI;
.IF ERRORCODE > 0 THEN .QUIT 16;

drop table BONIFICI_ENTRATA;
.IF ERRORCODE > 0 THEN .QUIT 16; 

drop table BONIFICI_USCITA;
.IF ERRORCODE > 0 THEN .QUIT 16;

drop table MONETICA;
.IF ERRORCODE > 0 THEN .QUIT 16;

drop table MON_CAUSMOV;
.IF ERRORCODE > 0 THEN .QUIT 16;

drop table MOVIMENTAZIONI;
.IF ERRORCODE > 0 THEN .QUIT 16; 

drop table MOVIMENTAZIONI_BIC;
.IF ERRORCODE > 0 THEN .QUIT 16; 

drop table MOVIMENTAZIONI_BON_ENTRATA;
.IF ERRORCODE > 0 THEN .QUIT 16;

drop table MOVIMENTAZIONI_BON_USCITA;
.IF ERRORCODE > 0 THEN .QUIT 16;

drop table CLASSI_MCC;
.IF ERRORCODE > 0 THEN .QUIT 16;


create volatile table CT_OPERAT_POSTAMAT as (
	select
		b.ID_CLIENTE_BIC,
		b.ID_PERIODO_TEMPORALE
		
		, sum(case when a.DES_RICLAS='BANCA_FINANZA_IMPOSTE' and a.CANALE in ('POS_ESTERNO') then a.IMPORTO_DARE else 0 end) as PMAT_BANCA_FIN_IMPOSTE_POSESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='BANCA_FINANZA_IMPOSTE' and a.CANALE in ('POS_ESTERNO') then a.NUMERO_DARE else 0 end) as PMAT_BANCA_FIN_IMPOSTE_POSESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='BANCA_FINANZA_IMPOSTE' and a.CANALE in ('WEB_ESTERNO') then a.IMPORTO_DARE else 0 end) as PMAT_BANCA_FIN_IMPOSTE_WEBESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='BANCA_FINANZA_IMPOSTE' and a.CANALE in ('WEB_ESTERNO') then a.NUMERO_DARE else 0 end) as PMAT_BANCA_FIN_IMPOSTE_WEBESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='BAR_RISTORANTI' and a.CANALE in ('POS_ESTERNO') then a.IMPORTO_DARE else 0 end) as PMAT_BAR_RISTORANTI_POSESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='BAR_RISTORANTI' and a.CANALE in ('POS_ESTERNO') then a.NUMERO_DARE else 0 end) as PMAT_BAR_RISTORANTI_POSESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='CASA' and a.CANALE in ('POS_ESTERNO') then a.IMPORTO_DARE else 0 end) as PMAT_CASA_POSESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='CASA' and a.CANALE in ('POS_ESTERNO') then a.NUMERO_DARE else 0 end) as PMAT_CASA_POSESTERNO_NUM_USCITA		
		, sum(case when a.DES_RICLAS='CASA' and a.CANALE in ('UP') then a.IMPORTO_DARE else 0 end) as PMAT_CASA_UP_IMP_USCITA
		, sum(case when a.DES_RICLAS='CASA' and a.CANALE in ('UP') then a.NUMERO_DARE else 0 end) as PMAT_CASA_UP_NUM_USCITA	
		, sum(case when a.DES_RICLAS='CASA' and a.CANALE in ('WEB_ESTERNO') then a.IMPORTO_DARE else 0 end) as PMAT_CASA_WEBESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='CASA' and a.CANALE in ('WEB_ESTERNO') then a.NUMERO_DARE else 0 end) as PMAT_CASA_WEBESTERNO_NUM_USCITA	
		, sum(case when a.DES_RICLAS='CIBO_SPESA' and a.CANALE in ('POS_ESTERNO') then a.IMPORTO_DARE else 0 end) as PMAT_CIBO_SPESA_POSESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='CIBO_SPESA' and a.CANALE in ('POS_ESTERNO') then a.NUMERO_DARE else 0 end) as PMAT_CIBO_SPESA_POSESTERNO_NUM_USCITA	
		, sum(case when a.DES_RICLAS='GIOCO' and a.CANALE in ('POS_ESTERNO') then a.IMPORTO_DARE else 0 end) as PMAT_GIOCO_POSESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='GIOCO' and a.CANALE in ('POS_ESTERNO') then a.NUMERO_DARE else 0 end) as PMAT_GIOCO_POSESTERNO_NUM_USCITA	
		, sum(case when a.DES_RICLAS='ISTRUZIONE' and a.CANALE in ('POS_ESTERNO') then a.IMPORTO_DARE else 0 end) as PMAT_ISTRUZIONE_POSESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='ISTRUZIONE' and a.CANALE in ('POS_ESTERNO') then a.NUMERO_DARE else 0 end) as PMAT_ISTRUZIONE_POSESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='MOTORI_TRASPORTI' and a.CANALE in ('POS_ESTERNO') then a.IMPORTO_DARE else 0 end) as PMAT_MOTORI_TRASPORTI_POSESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='MOTORI_TRASPORTI' and a.CANALE in ('POS_ESTERNO') then a.NUMERO_DARE else 0 end) as PMAT_MOTORI_TRASPORTI_POSESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='SALUTE_CURA' and a.CANALE in ('POS_ESTERNO') then a.IMPORTO_DARE else 0 end) as PMAT_SALUTE_CURA_POSESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='SALUTE_CURA' and a.CANALE in ('POS_ESTERNO') then a.NUMERO_DARE else 0 end) as PMAT_SALUTE_CURA_POSESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='SHOPPING_SERVIZI' and a.CANALE in ('POS_ESTERNO') then a.IMPORTO_DARE else 0 end) as PMAT_SHOPPING_SERVIZI_POSESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='SHOPPING_SERVIZI' and a.CANALE in ('POS_ESTERNO') then a.NUMERO_DARE else 0 end) as PMAT_SHOPPING_SERVIZI_POSESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='SHOPPING_SERVIZI' and a.CANALE in ('WEB_ESTERNO') then a.IMPORTO_DARE else 0 end) as PMAT_SHOPPING_SERVIZI_WEBESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='SHOPPING_SERVIZI' and a.CANALE in ('WEB_ESTERNO') then a.NUMERO_DARE else 0 end) as PMAT_SHOPPING_SERVIZI_WEBESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='TEMPOLIBERO_VIAGGIO' and a.CANALE in ('POS_ESTERNO') then a.IMPORTO_DARE else 0 end) as PMAT_TEMPOLIBERO_VIAGGIO_POSESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='TEMPOLIBERO_VIAGGIO' and a.CANALE in ('POS_ESTERNO') then a.NUMERO_DARE else 0 end) as PMAT_TEMPOLIBERO_VIAGGIO_POSESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='VARIE_MCC' and a.CANALE in ('POS_ESTERNO') then a.IMPORTO_DARE else 0 end) as PMAT_PAG_VARIE_MCC_POSESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='VARIE_MCC' and a.CANALE in ('POS_ESTERNO') then a.NUMERO_DARE else 0 end) as PMAT_PAG_VARIE_MCC_POSESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='ALTRE_MCC' and a.CANALE not in ('ATM_POSTE','POS_ESTERNO') then a.IMPORTO_DARE else 0 end) as PMAT_PAG_ALTREMCC_ALTRO_IMP_USCITA
		, sum(case when a.DES_RICLAS='ALTRE_MCC' and a.CANALE not in ('ATM_POSTE','POS_ESTERNO') then a.NUMERO_DARE else 0 end) as PMAT_PAG_ALTREMCC_ALTRO_NUM_USCITA
		, sum(case when a.DES_RICLAS='ALTRE_MCC' and a.CANALE in ('ATM_POSTE') then a.IMPORTO_DARE else 0 end) as PMAT_PAG_ALTREMCC_ATMPOSTE_IMP_USCITA
		, sum(case when a.DES_RICLAS='ALTRE_MCC' and a.CANALE in ('ATM_POSTE') then a.NUMERO_DARE else 0 end) as PMAT_PAG_ALTREMCC_ATMPOSTE_NUM_USCITA
		, sum(case when a.DES_RICLAS='ALTRE_MCC' and a.CANALE in ('POS_ESTERNO') then a.IMPORTO_DARE else 0 end) as PMAT_PAG_ALTREMCC_POSESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='ALTRE_MCC' and a.CANALE in ('POS_ESTERNO') then a.NUMERO_DARE else 0 end) as PMAT_PAG_ALTREMCC_POSESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='PAGAMENTI' then a.IMPORTO_AVERE else 0 end) as PMAT_PAGAMENTI_CENTRO_IMP_ENTRATA
		, sum(case when a.DES_RICLAS='PAGAMENTI' then a.NUMERO_AVERE else 0 end) as PMAT_PAGAMENTI_CENTRO_NUM_ENTRATA
		
		, sum(case when a.DES_RICLAS='POSTAGIRO_DA_A_LIBRETTO' and a.CANALE in ('ATM_POSTE') then a.IMPORTO_DARE else 0 end) as PMAT_POSTAGIRO_A_LIBRETTO_ATMPOSTE_IMP_USCITA
		, sum(case when a.DES_RICLAS='POSTAGIRO_DA_A_LIBRETTO' and a.CANALE in ('ATM_POSTE') then a.NUMERO_DARE else 0 end) as PMAT_POSTAGIRO_A_LIBRETTO_ATMPOSTE_NUM_USCITA		
		
		, sum(case when a.DES_RICLAS='PRELIEVO' and a.CANALE in ('ATM_POSTE') then a.IMPORTO_DARE else 0 end) as PMAT_PRELIEVO_ATMPOSTE_IMP_USCITA
		, sum(case when a.DES_RICLAS='PRELIEVO' and a.CANALE in ('ATM_POSTE') then a.NUMERO_DARE else 0 end) as PMAT_PRELIEVO_ATMPOSTE_NUM_USCITA
		, sum(case when a.DES_RICLAS='PRELIEVO' and a.CANALE in ('ATM_BANCARIO') then a.IMPORTO_DARE else 0 end) as PMAT_PRELIEVO_ATMBANCARIO_IMP_USCITA
		, sum(case when a.DES_RICLAS='PRELIEVO' and a.CANALE in ('ATM_BANCARIO') then a.NUMERO_DARE else 0 end) as PMAT_PRELIEVO_ATMBANCARIO_NUM_USCITA
		, sum(case when a.DES_RICLAS='PRELIEVO' and a.CANALE in ('POS_ESTERNO') then a.IMPORTO_DARE else 0 end) as PMAT_PRELIEVO_POSESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='PRELIEVO' and a.CANALE in ('POS_ESTERNO') then a.NUMERO_DARE else 0 end) as PMAT_PRELIEVO_POSESTERNO_NUM_USCITA	
		, sum(case when a.DES_RICLAS='PRELIEVO' and a.CANALE in ('UP') then a.IMPORTO_DARE else 0 end) as PMAT_PRELIEVO_UP_IMP_USCITA
		, sum(case when a.DES_RICLAS='PRELIEVO' and a.CANALE in ('UP') then a.NUMERO_DARE else 0 end) as PMAT_PRELIEVO_UP_NUM_USCITA	
		
		, sum(case when a.DES_RICLAS='RICARICA_POSTEPAY' and a.CANALE in ('ATM_POSTE') then a.IMPORTO_DARE else 0 end) as PMAT_RICARICA_POSTEPAY_ATMPOSTE_IMP_USCITA
		, sum(case when a.DES_RICLAS='RICARICA_POSTEPAY' and a.CANALE in ('ATM_POSTE') then a.NUMERO_DARE else 0 end) as PMAT_RICARICA_POSTEPAY_ATMPOSTE_NUM_USCITA		
		
		, sum(case when a.DES_RICLAS='RICARICA_TELEFONICA' and a.CANALE in ('ATM_POSTE') then a.IMPORTO_DARE else 0 end) as PMAT_RICARICA_TELEFONICA_ATMPOSTE_IMP_USCITA
		, sum(case when a.DES_RICLAS='RICARICA_TELEFONICA' and a.CANALE in ('ATM_POSTE') then a.NUMERO_DARE else 0 end) as PMAT_RICARICA_TELEFONICA_ATMPOSTE_NUM_USCITA	
		, sum(case when a.DES_RICLAS='RICARICA_TELEFONICA' and a.CANALE in ('POS_ESTERNO') then a.IMPORTO_DARE else 0 end) as PMAT_RICARICA_TELEFONICA_POSESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='RICARICA_TELEFONICA' and a.CANALE in ('POS_ESTERNO') then a.NUMERO_DARE else 0 end) as PMAT_RICARICA_TELEFONICA_POSESTERNO_NUM_USCITA
		
		, sum(case when a.DES_RICLAS='STORNO' then a.IMPORTO_AVERE else 0 end) as PMAT_STORNO_CENTRO_IMP_ENTRATA
		, sum(case when a.DES_RICLAS='STORNO' then a.NUMERO_AVERE else 0 end) as PMAT_STORNO_CENTRO_NUM_ENTRATA		
		
		, sum(case when a.DES_RICLAS='VARIE' then a.IMPORTO_AVERE else 0 end) as PMAT_VARIE_CENTRO_IMP_ENTRATA
		, sum(case when a.DES_RICLAS='VARIE' then a.NUMERO_AVERE else 0 end) as PMAT_VARIE_CENTRO_NUM_ENTRATA	
		
		, (PMAT_BANCA_FIN_IMPOSTE_POSESTERNO_IMP_USCITA + PMAT_BAR_RISTORANTI_POSESTERNO_IMP_USCITA + PMAT_CASA_POSESTERNO_IMP_USCITA + PMAT_CASA_UP_IMP_USCITA
			+ PMAT_CIBO_SPESA_POSESTERNO_IMP_USCITA + PMAT_GIOCO_POSESTERNO_IMP_USCITA + PMAT_ISTRUZIONE_POSESTERNO_IMP_USCITA + PMAT_MOTORI_TRASPORTI_POSESTERNO_IMP_USCITA
			+ PMAT_SALUTE_CURA_POSESTERNO_IMP_USCITA + PMAT_SHOPPING_SERVIZI_POSESTERNO_IMP_USCITA + PMAT_TEMPOLIBERO_VIAGGIO_POSESTERNO_IMP_USCITA
			+ PMAT_PAG_VARIE_MCC_POSESTERNO_IMP_USCITA + PMAT_PAG_ALTREMCC_ALTRO_IMP_USCITA + PMAT_PAG_ALTREMCC_ATMPOSTE_IMP_USCITA + PMAT_PAG_ALTREMCC_POSESTERNO_IMP_USCITA
			+ PMAT_POSTAGIRO_A_LIBRETTO_ATMPOSTE_IMP_USCITA + PMAT_PRELIEVO_ATMPOSTE_IMP_USCITA + PMAT_PRELIEVO_ATMBANCARIO_IMP_USCITA + PMAT_PRELIEVO_POSESTERNO_IMP_USCITA
			+ PMAT_PRELIEVO_UP_IMP_USCITA + PMAT_RICARICA_POSTEPAY_ATMPOSTE_IMP_USCITA + PMAT_RICARICA_TELEFONICA_ATMPOSTE_IMP_USCITA + PMAT_RICARICA_TELEFONICA_POSESTERNO_IMP_USCITA
			) as PMAT_TOT_OPER_FISICO_IMP_USCITA
		
		, (PMAT_BANCA_FIN_IMPOSTE_POSESTERNO_NUM_USCITA + PMAT_BAR_RISTORANTI_POSESTERNO_NUM_USCITA + PMAT_CASA_POSESTERNO_NUM_USCITA + PMAT_CASA_UP_NUM_USCITA
			+ PMAT_CIBO_SPESA_POSESTERNO_NUM_USCITA + PMAT_GIOCO_POSESTERNO_NUM_USCITA + PMAT_ISTRUZIONE_POSESTERNO_NUM_USCITA + PMAT_MOTORI_TRASPORTI_POSESTERNO_NUM_USCITA
			+ PMAT_SALUTE_CURA_POSESTERNO_NUM_USCITA + PMAT_SHOPPING_SERVIZI_POSESTERNO_NUM_USCITA + PMAT_TEMPOLIBERO_VIAGGIO_POSESTERNO_NUM_USCITA
			+ PMAT_PAG_VARIE_MCC_POSESTERNO_NUM_USCITA + PMAT_PAG_ALTREMCC_ALTRO_NUM_USCITA + PMAT_PAG_ALTREMCC_ATMPOSTE_NUM_USCITA + PMAT_PAG_ALTREMCC_POSESTERNO_NUM_USCITA
			+ PMAT_POSTAGIRO_A_LIBRETTO_ATMPOSTE_NUM_USCITA + PMAT_PRELIEVO_ATMPOSTE_NUM_USCITA + PMAT_PRELIEVO_ATMBANCARIO_NUM_USCITA + PMAT_PRELIEVO_POSESTERNO_NUM_USCITA
			+ PMAT_PRELIEVO_UP_NUM_USCITA + PMAT_RICARICA_POSTEPAY_ATMPOSTE_NUM_USCITA + PMAT_RICARICA_TELEFONICA_ATMPOSTE_NUM_USCITA + PMAT_RICARICA_TELEFONICA_POSESTERNO_NUM_USCITA
			) as PMAT_TOT_OPER_FISICO_NUM_USCITA
		
		, (PMAT_PAGAMENTI_CENTRO_IMP_ENTRATA + PMAT_STORNO_CENTRO_IMP_ENTRATA + PMAT_VARIE_CENTRO_IMP_ENTRATA) as PMAT_TOT_OPER_CENTRO_IMP_ENTRATA
		
		, (PMAT_PAGAMENTI_CENTRO_NUM_ENTRATA + PMAT_STORNO_CENTRO_NUM_ENTRATA + PMAT_VARIE_CENTRO_NUM_ENTRATA) as PMAT_TOT_OPER_CENTRO_NUM_ENTRATA
		
		, (PMAT_BANCA_FIN_IMPOSTE_WEBESTERNO_IMP_USCITA + PMAT_CASA_WEBESTERNO_IMP_USCITA + PMAT_SHOPPING_SERVIZI_WEBESTERNO_IMP_USCITA) as PMAT_TOT_OPER_DIGITAL_IMP_USCITA
		
		, (PMAT_BANCA_FIN_IMPOSTE_WEBESTERNO_NUM_USCITA + PMAT_CASA_WEBESTERNO_NUM_USCITA + PMAT_SHOPPING_SERVIZI_WEBESTERNO_NUM_USCITA) as PMAT_TOT_OPER_DIGITAL_NUM_USCITA
	from EBIL_AREE.V_CT_PERIMETRO as b
	left join MONETICA_MCC_RAGGR as a
		on a.ID_CLIENTE_BIC=b.ID_CLIENTE_BIC and a.TIPO_CARTA='CARTA_DEBITO' 
	group by 1,2
)with data primary index(ID_CLIENTE_BIC, ID_PERIODO_TEMPORALE) on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;



BT

;DELETE EBIL_AREE.CT_OPERAT_POSTAMAT
WHERE ID_PERIODO_TEMPORALE= (SELECT ID_PERIODO_TEMPORALE FROM EBIL_AREE.CT_PARAMETRI)

;INSERT INTO EBIL_AREE.CT_OPERAT_POSTAMAT 
	select * from CT_OPERAT_POSTAMAT
WHERE ID_PERIODO_TEMPORALE= (SELECT ID_PERIODO_TEMPORALE FROM EBIL_AREE.CT_PARAMETRI)

;ET;
.IF ERRORCODE > 0 THEN .QUIT 16;

CREATE VOLATILE TABLE VTB_OPERAT_POSTAMAT_SV AS
(SELECT ID_PERIODO_TEMPORALE, ROW_NUMBER () over ( ORDER BY ID_PERIODO_TEMPORALE  DESC) AS ORDINAMENTO
FROM  EBIL_AREE.CT_OPERAT_POSTAMAT
GROUP BY 1)
WITH DATA PRIMARY INDEX (ID_PERIODO_TEMPORALE) ON COMMIT PRESERVE ROWS;
.IF ERRORCODE > 0 THEN .QUIT 16;

DELETE EBIL_AREE.CT_OPERAT_POSTAMAT
WHERE ID_PERIODO_TEMPORALE IN ( SELECT ID_PERIODO_TEMPORALE 
FROM VTB_OPERAT_POSTAMAT_SV
WHERE ORDINAMENTO >25);
.IF ERRORCODE > 0 THEN .QUIT 16;



create volatile table CT_OPERAT_POSTEPAY as (
	select
		b.ID_CLIENTE_BIC,
		b.ID_PERIODO_TEMPORALE
		
		, sum(case when a.DES_RICLAS='COMMISSIONI' then a.IMPORTO_DARE else 0 end) as PPAY_COMMISSIONI_CENTRO_IMP_USCITA
		, sum(case when a.DES_RICLAS='COMMISSIONI' then a.NUMERO_DARE else 0 end) as PPAY_COMMISSIONI_CENTRO_NUM_USCITA		
		, sum(case when a.DES_RICLAS='COMMISSIONI' then a.IMPORTO_AVERE else 0 end) as PPAY_COMMISSIONI_CENTRO_IMP_ENTRATA
		, sum(case when a.DES_RICLAS='COMMISSIONI' then a.NUMERO_AVERE else 0 end) as PPAY_COMMISSIONI_CENTRO_NUM_ENTRATA
		
		, sum(case when a.DES_RICLAS='BANCA_FINANZA_IMPOSTE' and a.CANALE in ('APP') then a.IMPORTO_DARE else 0 end) as PPAY_BANCA_FIN_IMPOSTE_APP_IMP_USCITA
		, sum(case when a.DES_RICLAS='BANCA_FINANZA_IMPOSTE' and a.CANALE in ('APP') then a.NUMERO_DARE else 0 end) as PPAY_BANCA_FIN_IMPOSTE_APP_NUM_USCITA
		, sum(case when a.DES_RICLAS='BANCA_FINANZA_IMPOSTE' and a.CANALE in ('POS_ESTERNO') then a.IMPORTO_DARE else 0 end) as PPAY_BANCA_FIN_IMPOSTE_POSESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='BANCA_FINANZA_IMPOSTE' and a.CANALE in ('POS_ESTERNO') then a.NUMERO_DARE else 0 end) as PPAY_BANCA_FIN_IMPOSTE_POSESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='BANCA_FINANZA_IMPOSTE' and a.CANALE in ('WEB_ESTERNO') then a.IMPORTO_DARE else 0 end) as PPAY_BANCA_FIN_IMPOSTE_WEBESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='BANCA_FINANZA_IMPOSTE' and a.CANALE in ('WEB_ESTERNO') then a.NUMERO_DARE else 0 end) as PPAY_BANCA_FIN_IMPOSTE_WEBESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='BANCA_FINANZA_IMPOSTE' and a.CANALE in ('WEB_POSTE') then a.IMPORTO_DARE else 0 end) as PPAY_BANCA_FIN_IMPOSTE_WEBPOSTE_IMP_USCITA
		, sum(case when a.DES_RICLAS='BANCA_FINANZA_IMPOSTE' and a.CANALE in ('WEB_POSTE') then a.NUMERO_DARE else 0 end) as PPAY_BANCA_FIN_IMPOSTE_WEBPOSTE_NUM_USCITA		
		, sum(case when a.DES_RICLAS='BAR_RISTORANTI' and a.CANALE in ('POS_ESTERNO') then a.IMPORTO_DARE else 0 end) as PPAY_BAR_RISTORANTI_POSESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='BAR_RISTORANTI' and a.CANALE in ('POS_ESTERNO') then a.NUMERO_DARE else 0 end) as PPAY_BAR_RISTORANTI_POSESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='BAR_RISTORANTI' and a.CANALE in ('WEB_ESTERNO') then a.IMPORTO_DARE else 0 end) as PPAY_BAR_RISTORANTI_WEBESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='BAR_RISTORANTI' and a.CANALE in ('WEB_ESTERNO') then a.NUMERO_DARE else 0 end) as PPAY_BAR_RISTORANTI_WEBESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='CASA' and a.CANALE in ('APP') then a.IMPORTO_DARE else 0 end) as PPAY_CASA_APP_IMP_USCITA
		, sum(case when a.DES_RICLAS='CASA' and a.CANALE in ('APP') then a.NUMERO_DARE else 0 end) as PPAY_CASA_APP_NUM_USCITA
		, sum(case when a.DES_RICLAS='CASA' and a.CANALE in ('POS_ESTERNO') then a.IMPORTO_DARE else 0 end) as PPAY_CASA_POSESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='CASA' and a.CANALE in ('POS_ESTERNO') then a.NUMERO_DARE else 0 end) as PPAY_CASA_POSESTERNO_NUM_USCITA		
		, sum(case when a.DES_RICLAS='CASA' and a.CANALE in ('UP') then a.IMPORTO_DARE else 0 end) as PPAY_CASA_UP_IMP_USCITA
		, sum(case when a.DES_RICLAS='CASA' and a.CANALE in ('UP') then a.NUMERO_DARE else 0 end) as PPAY_CASA_UP_NUM_USCITA	
		, sum(case when a.DES_RICLAS='CASA' and a.CANALE in ('WEB_ESTERNO') then a.IMPORTO_DARE else 0 end) as PPAY_CASA_WEBESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='CASA' and a.CANALE in ('WEB_ESTERNO') then a.NUMERO_DARE else 0 end) as PPAY_CASA_WEBESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='CIBO_SPESA' and a.CANALE in ('APP') then a.IMPORTO_DARE else 0 end) as PPAY_CIBO_SPESA_APP_IMP_USCITA
		, sum(case when a.DES_RICLAS='CIBO_SPESA' and a.CANALE in ('APP') then a.NUMERO_DARE else 0 end) as PPAY_CIBO_SPESA_APP_NUM_USCITA		
		, sum(case when a.DES_RICLAS='CIBO_SPESA' and a.CANALE in ('POS_ESTERNO') then a.IMPORTO_DARE else 0 end) as PPAY_CIBO_SPESA_POSESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='CIBO_SPESA' and a.CANALE in ('POS_ESTERNO') then a.NUMERO_DARE else 0 end) as PPAY_CIBO_SPESA_POSESTERNO_NUM_USCITA	
		, sum(case when a.DES_RICLAS='CIBO_SPESA' and a.CANALE in ('WEB_ESTERNO') then a.IMPORTO_DARE else 0 end) as PPAY_CIBO_SPESA_WEBESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='CIBO_SPESA' and a.CANALE in ('WEB_ESTERNO') then a.NUMERO_DARE else 0 end) as PPAY_CIBO_SPESA_WEBESTERNO_NUM_USCITA	
		, sum(case when a.DES_RICLAS='GIOCO' and a.CANALE in ('POS_ESTERNO') then a.IMPORTO_DARE else 0 end) as PPAY_GIOCO_POSESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='GIOCO' and a.CANALE in ('POS_ESTERNO') then a.NUMERO_DARE else 0 end) as PPAY_GIOCO_POSESTERNO_NUM_USCITA	
		, sum(case when a.DES_RICLAS='GIOCO' and a.CANALE in ('WEB_ESTERNO') then a.IMPORTO_DARE else 0 end) as PPAY_GIOCO_WEBESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='GIOCO' and a.CANALE in ('WEB_ESTERNO') then a.NUMERO_DARE else 0 end) as PPAY_GIOCO_WEBESTERNO_NUM_USCITA	
		, sum(case when a.DES_RICLAS='ISTRUZIONE' and a.CANALE in ('POS_ESTERNO') then a.IMPORTO_DARE else 0 end) as PPAY_ISTRUZIONE_POSESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='ISTRUZIONE' and a.CANALE in ('POS_ESTERNO') then a.NUMERO_DARE else 0 end) as PPAY_ISTRUZIONE_POSESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='ISTRUZIONE' and a.CANALE in ('WEB_ESTERNO') then a.IMPORTO_DARE else 0 end) as PPAY_ISTRUZIONE_WEBESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='ISTRUZIONE' and a.CANALE in ('WEB_ESTERNO') then a.NUMERO_DARE else 0 end) as PPAY_ISTRUZIONE_WEBESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='MOTORI_TRASPORTI' and a.CANALE in ('APP') then a.IMPORTO_DARE else 0 end) as PPAY_MOTORI_TRASPORTI_APP_IMP_USCITA
		, sum(case when a.DES_RICLAS='MOTORI_TRASPORTI' and a.CANALE in ('APP') then a.NUMERO_DARE else 0 end) as PPAY_MOTORI_TRASPORTI_APP_NUM_USCITA
		, sum(case when a.DES_RICLAS='MOTORI_TRASPORTI' and a.CANALE in ('POS_ESTERNO') then a.IMPORTO_DARE else 0 end) as PPAY_MOTORI_TRASPORTI_POSESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='MOTORI_TRASPORTI' and a.CANALE in ('POS_ESTERNO') then a.NUMERO_DARE else 0 end) as PPAY_MOTORI_TRASPORTI_POSESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='MOTORI_TRASPORTI' and a.CANALE in ('WEB_ESTERNO') then a.IMPORTO_DARE else 0 end) as PPAY_MOTORI_TRASPORTI_WEBESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='MOTORI_TRASPORTI' and a.CANALE in ('WEB_ESTERNO') then a.NUMERO_DARE else 0 end) as PPAY_MOTORI_TRASPORTI_WEBESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='SALUTE_CURA' and a.CANALE in ('POS_ESTERNO') then a.IMPORTO_DARE else 0 end) as PPAY_SALUTE_CURA_POSESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='SALUTE_CURA' and a.CANALE in ('POS_ESTERNO') then a.NUMERO_DARE else 0 end) as PPAY_SALUTE_CURA_POSESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='SALUTE_CURA' and a.CANALE in ('WEB_ESTERNO') then a.IMPORTO_DARE else 0 end) as PPAY_SALUTE_CURA_WEBESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='SALUTE_CURA' and a.CANALE in ('WEB_ESTERNO') then a.NUMERO_DARE else 0 end) as PPAY_SALUTE_CURA_WEBESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='SHOPPING_SERVIZI' and a.CANALE in ('APP') then a.IMPORTO_DARE else 0 end) as PPAY_SHOPPING_SERVIZI_APP_IMP_USCITA
		, sum(case when a.DES_RICLAS='SHOPPING_SERVIZI' and a.CANALE in ('APP') then a.NUMERO_DARE else 0 end) as PPAY_SHOPPING_SERVIZI_APP_NUM_USCITA
		, sum(case when a.DES_RICLAS='SHOPPING_SERVIZI' and a.CANALE in ('POS_ESTERNO') then a.IMPORTO_DARE else 0 end) as PPAY_SHOPPING_SERVIZI_POSESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='SHOPPING_SERVIZI' and a.CANALE in ('POS_ESTERNO') then a.NUMERO_DARE else 0 end) as PPAY_SHOPPING_SERVIZI_POSESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='SHOPPING_SERVIZI' and a.CANALE in ('WEB_ESTERNO') then a.IMPORTO_DARE else 0 end) as PPAY_SHOPPING_SERVIZI_WEBESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='SHOPPING_SERVIZI' and a.CANALE in ('WEB_ESTERNO') then a.NUMERO_DARE else 0 end) as PPAY_SHOPPING_SERVIZI_WEBESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='TEMPOLIBERO_VIAGGIO' and a.CANALE in ('POS_ESTERNO') then a.IMPORTO_DARE else 0 end) as PPAY_TEMPOLIBERO_VIAGGIO_POSESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='TEMPOLIBERO_VIAGGIO' and a.CANALE in ('POS_ESTERNO') then a.NUMERO_DARE else 0 end) as PPAY_TEMPOLIBERO_VIAGGIO_POSESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='TEMPOLIBERO_VIAGGIO' and a.CANALE in ('WEB_ESTERNO') then a.IMPORTO_DARE else 0 end) as PPAY_TEMPOLIBERO_VIAGGIO_WEBESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='TEMPOLIBERO_VIAGGIO' and a.CANALE in ('WEB_ESTERNO') then a.NUMERO_DARE else 0 end) as PPAY_TEMPOLIBERO_VIAGGIO_WEBESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='VARIE_MCC' and a.CANALE in ('POS_ESTERNO') then a.IMPORTO_DARE else 0 end) as PPAY_PAG_VARIE_MCC_POSESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='VARIE_MCC' and a.CANALE in ('POS_ESTERNO') then a.NUMERO_DARE else 0 end) as PPAY_PAG_VARIE_MCC_POSESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='VARIE_MCC' and a.CANALE in ('WEB_ESTERNO') then a.IMPORTO_DARE else 0 end) as PPAY_PAG_VARIE_MCC_WEBESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='VARIE_MCC' and a.CANALE in ('WEB_ESTERNO') then a.NUMERO_DARE else 0 end) as PPAY_PAG_VARIE_MCC_WEBESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='VARIE_MCC' and a.CANALE in ('WEB_POSTE') then a.IMPORTO_DARE else 0 end) as PPAY_PAG_VARIE_MCC_WEBPOSTE_IMP_USCITA
		, sum(case when a.DES_RICLAS='VARIE_MCC' and a.CANALE in ('WEB_POSTE') then a.NUMERO_DARE else 0 end) as PPAY_PAG_VARIE_MCC_WEBPOSTE_NUM_USCITA
		, sum(case when a.DES_RICLAS='ALTRE_MCC' and a.CANALE in ('APP') then a.IMPORTO_DARE else 0 end) as PPAY_PAG_ALTREMCC_APP_IMP_USCITA
		, sum(case when a.DES_RICLAS='ALTRE_MCC' and a.CANALE in ('APP') then a.NUMERO_DARE else 0 end) as PPAY_PAG_ALTREMCC_APP_NUM_USCITA
		, sum(case when a.DES_RICLAS='ALTRE_MCC' and a.CANALE in ('ATM_POSTE') then a.IMPORTO_DARE else 0 end) as PPAY_PAG_ALTREMCC_ATMPOSTE_IMP_USCITA
		, sum(case when a.DES_RICLAS='ALTRE_MCC' and a.CANALE in ('ATM_POSTE') then a.NUMERO_DARE else 0 end) as PPAY_PAG_ALTREMCC_ATMPOSTE_NUM_USCITA
		, sum(case when a.DES_RICLAS='ALTRE_MCC' and a.CANALE in ('POS_ESTERNO') then a.IMPORTO_DARE else 0 end) as PPAY_PAG_ALTREMCC_POSESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='ALTRE_MCC' and a.CANALE in ('POS_ESTERNO') then a.NUMERO_DARE else 0 end) as PPAY_PAG_ALTREMCC_POSESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='ALTRE_MCC' and a.CANALE in ('WEB_ESTERNO') then a.IMPORTO_DARE else 0 end) as PPAY_PAG_ALTREMCC_WEBESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='ALTRE_MCC' and a.CANALE in ('WEB_ESTERNO') then a.NUMERO_DARE else 0 end) as PPAY_PAG_ALTREMCC_WEBESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='ALTRE_MCC' and a.CANALE in ('WEB_POSTE') then a.IMPORTO_DARE else 0 end) as PPAY_PAG_ALTREMCC_WEBPOSTE_IMP_USCITA
		, sum(case when a.DES_RICLAS='ALTRE_MCC' and a.CANALE in ('WEB_POSTE') then a.NUMERO_DARE else 0 end) as PPAY_PAG_ALTREMCC_WEBPOSTE_NUM_USCITA
		, sum(case when a.DES_RICLAS='ALTRE_MCC' and a.CANALE not in ('ATM_POSTE','POS_ESTERNO','WEB_ESTERNO','APP','WEB_POSTE') then a.IMPORTO_DARE else 0 end) as PPAY_PAG_ALTREMCC_ALTRO_IMP_USCITA
		, sum(case when a.DES_RICLAS='ALTRE_MCC' and a.CANALE not in ('ATM_POSTE','POS_ESTERNO','WEB_ESTERNO','APP','WEB_POSTE') then a.NUMERO_DARE else 0 end) as PPAY_PAG_ALTREMCC_ALTRO_NUM_USCITA
		, sum(case when a.DES_RICLAS='PAGAMENTI' then a.IMPORTO_AVERE else 0 end) as PPAY_PAGAMENTI_CENTRO_IMP_ENTRATA
		, sum(case when a.DES_RICLAS='PAGAMENTI' then a.NUMERO_AVERE else 0 end) as PPAY_PAGAMENTI_CENTRO_NUM_ENTRATA
		
		, sum(case when a.DES_RICLAS='PRELIEVO' and a.CANALE in ('ATM_POSTE') then a.IMPORTO_DARE else 0 end) as PPAY_PRELIEVO_ATMPOSTE_IMP_USCITA
		, sum(case when a.DES_RICLAS='PRELIEVO' and a.CANALE in ('ATM_POSTE') then a.NUMERO_DARE else 0 end) as PPAY_PRELIEVO_ATMPOSTE_NUM_USCITA
		, sum(case when a.DES_RICLAS='PRELIEVO' and a.CANALE in ('ATM_BANCARIO') then a.IMPORTO_DARE else 0 end) as PPAY_PRELIEVO_ATMBANCARIO_IMP_USCITA
		, sum(case when a.DES_RICLAS='PRELIEVO' and a.CANALE in ('ATM_BANCARIO') then a.NUMERO_DARE else 0 end) as PPAY_PRELIEVO_ATMBANCARIO_NUM_USCITA
		, sum(case when a.DES_RICLAS='PRELIEVO' and a.CANALE in ('POS_ESTERNO') then a.IMPORTO_DARE else 0 end) as PPAY_PRELIEVO_POSESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='PRELIEVO' and a.CANALE in ('POS_ESTERNO') then a.NUMERO_DARE else 0 end) as PPAY_PRELIEVO_POSESTERNO_NUM_USCITA	
		, sum(case when a.DES_RICLAS='PRELIEVO' and a.CANALE in ('UP') then a.IMPORTO_DARE else 0 end) as PPAY_PRELIEVO_UP_IMP_USCITA
		, sum(case when a.DES_RICLAS='PRELIEVO' and a.CANALE in ('UP') then a.NUMERO_DARE else 0 end) as PPAY_PRELIEVO_UP_NUM_USCITA	
		
		, sum(case when a.DES_RICLAS='RICARICA_POSTEPAY' and a.CANALE in ('APP') then a.IMPORTO_AVERE else 0 end) as PPAY_RICARICA_POSTEPAY_APP_IMP_ENTRATA
		, sum(case when a.DES_RICLAS='RICARICA_POSTEPAY' and a.CANALE in ('APP') then a.NUMERO_AVERE else 0 end) as PPAY_RICARICA_POSTEPAY_APP_NUM_ENTRATA
		, sum(case when a.DES_RICLAS='RICARICA_POSTEPAY' and a.CANALE in ('APP') then a.IMPORTO_DARE else 0 end) as PPAY_RICARICA_POSTEPAY_APP_IMP_USCITA
		, sum(case when a.DES_RICLAS='RICARICA_POSTEPAY' and a.CANALE in ('APP') then a.NUMERO_DARE else 0 end) as PPAY_RICARICA_POSTEPAY_APP_NUM_USCITA		
		, sum(case when a.DES_RICLAS='RICARICA_POSTEPAY' and a.CANALE in ('ATM_POSTE') then a.IMPORTO_AVERE else 0 end) as PPAY_RICARICA_POSTEPAY_ATMPOSTE_IMP_ENTRATA
		, sum(case when a.DES_RICLAS='RICARICA_POSTEPAY' and a.CANALE in ('ATM_POSTE') then a.NUMERO_AVERE else 0 end) as PPAY_RICARICA_POSTEPAY_ATMPOSTE_NUM_ENTRATA
		, sum(case when a.DES_RICLAS='RICARICA_POSTEPAY' and a.CANALE in ('ATM_POSTE') then a.IMPORTO_DARE else 0 end) as PPAY_RICARICA_POSTEPAY_ATMPOSTE_IMP_USCITA
		, sum(case when a.DES_RICLAS='RICARICA_POSTEPAY' and a.CANALE in ('ATM_POSTE') then a.NUMERO_DARE else 0 end) as PPAY_RICARICA_POSTEPAY_ATMPOSTE_NUM_USCITA	
		, sum(case when a.DES_RICLAS='RICARICA_POSTEPAY' and a.CANALE in ('POS_ESTERNO') then a.IMPORTO_AVERE else 0 end) as PPAY_RICARICA_POSTEPAY_POSESTERNO_IMP_ENTRATA
		, sum(case when a.DES_RICLAS='RICARICA_POSTEPAY' and a.CANALE in ('POS_ESTERNO') then a.NUMERO_AVERE else 0 end) as PPAY_RICARICA_POSTEPAY_POSESTERNO_NUM_ENTRATA			
		, sum(case when a.DES_RICLAS='RICARICA_POSTEPAY' and a.CANALE in ('UP') then a.IMPORTO_AVERE else 0 end) as PPAY_RICARICA_POSTEPAY_UP_IMP_ENTRATA
		, sum(case when a.DES_RICLAS='RICARICA_POSTEPAY' and a.CANALE in ('UP') then a.NUMERO_AVERE else 0 end) as PPAY_RICARICA_POSTEPAY_UP_NUM_ENTRATA	
		, sum(case when a.DES_RICLAS='RICARICA_POSTEPAY' and a.CANALE in ('CENTRO') then a.IMPORTO_AVERE else 0 end) as PPAY_RICARICA_POSTEPAY_CENTRO_IMP_ENTRATA
		, sum(case when a.DES_RICLAS='RICARICA_POSTEPAY' and a.CANALE in ('CENTRO') then a.NUMERO_AVERE else 0 end) as PPAY_RICARICA_POSTEPAY_CENTRO_NUM_ENTRATA
		, sum(case when a.DES_RICLAS='RICARICA_POSTEPAY' and a.CANALE in ('WEB_POSTE') then a.IMPORTO_AVERE else 0 end) as PPAY_RICARICA_POSTEPAY_WEBPOSTE_IMP_ENTRATA
		, sum(case when a.DES_RICLAS='RICARICA_POSTEPAY' and a.CANALE in ('WEB_POSTE') then a.NUMERO_AVERE else 0 end) as PPAY_RICARICA_POSTEPAY_WEBPOSTE_NUM_ENTRATA
		, sum(case when a.DES_RICLAS='RICARICA_POSTEPAY' and a.CANALE in ('WEB_POSTE') then a.IMPORTO_DARE else 0 end) as PPAY_RICARICA_POSTEPAY_WEBPOSTE_IMP_USCITA
		, sum(case when a.DES_RICLAS='RICARICA_POSTEPAY' and a.CANALE in ('WEB_POSTE') then a.NUMERO_DARE else 0 end) as PPAY_RICARICA_POSTEPAY_WEBPOSTE_NUM_USCITA	
		
		, sum(case when a.DES_RICLAS='RICARICA_TELEFONICA' and a.CANALE in ('ATM_POSTE') then a.IMPORTO_DARE else 0 end) as PPAY_RICARICA_TELEFONICA_ATMPOSTE_IMP_USCITA
		, sum(case when a.DES_RICLAS='RICARICA_TELEFONICA' and a.CANALE in ('ATM_POSTE') then a.NUMERO_DARE else 0 end) as PPAY_RICARICA_TELEFONICA_ATMPOSTE_NUM_USCITA	
		, sum(case when a.DES_RICLAS='RICARICA_TELEFONICA' and a.CANALE in ('POS_ESTERNO') then a.IMPORTO_DARE else 0 end) as PPAY_RICARICA_TELEFONICA_POSESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='RICARICA_TELEFONICA' and a.CANALE in ('POS_ESTERNO') then a.NUMERO_DARE else 0 end) as PPAY_RICARICA_TELEFONICA_POSESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='RICARICA_TELEFONICA' and a.CANALE in ('WEB_POSTE') then a.IMPORTO_DARE else 0 end) as PPAY_RICARICA_TELEFONICA_WEBPOSTE_IMP_USCITA
		, sum(case when a.DES_RICLAS='RICARICA_TELEFONICA' and a.CANALE in ('WEB_POSTE') then a.NUMERO_DARE else 0 end) as PPAY_RICARICA_TELEFONICA_WEBPOSTE_NUM_USCITA			
		
		, sum(case when a.DES_RICLAS='STORNO' then a.IMPORTO_AVERE else 0 end) as PPAY_STORNO_CENTRO_IMP_ENTRATA
		, sum(case when a.DES_RICLAS='STORNO' then a.NUMERO_AVERE else 0 end) as PPAY_STORNO_CENTRO_NUM_ENTRATA	
		, sum(case when a.DES_RICLAS='STORNO' then a.IMPORTO_DARE else 0 end) as PPAY_STORNO_CENTRO_IMP_USCITA
		, sum(case when a.DES_RICLAS='STORNO' then a.NUMERO_DARE else 0 end) as PPAY_STORNO_CENTRO_NUM_USCITA				
		
		, sum(case when a.DES_RICLAS='VARIE' then a.IMPORTO_AVERE else 0 end) as PPAY_VARIE_CENTRO_IMP_ENTRATA
		, sum(case when a.DES_RICLAS='VARIE' then a.NUMERO_AVERE else 0 end) as PPAY_VARIE_CENTRO_NUM_ENTRATA	
		
		, (PPAY_RICARICA_POSTEPAY_UP_IMP_ENTRATA + PPAY_RICARICA_POSTEPAY_ATMPOSTE_IMP_ENTRATA + PPAY_RICARICA_POSTEPAY_POSESTERNO_IMP_ENTRATA
			) as PPAY_TOT_OPER_FISICO_IMP_ENTRATA
		
		, (PPAY_RICARICA_POSTEPAY_UP_NUM_ENTRATA + PPAY_RICARICA_POSTEPAY_ATMPOSTE_NUM_ENTRATA + PPAY_RICARICA_POSTEPAY_POSESTERNO_NUM_ENTRATA
			) as PPAY_TOT_OPER_FISICO_NUM_ENTRATA
		
		, (PPAY_BANCA_FIN_IMPOSTE_POSESTERNO_IMP_USCITA + PPAY_BAR_RISTORANTI_POSESTERNO_IMP_USCITA + PPAY_CASA_POSESTERNO_IMP_USCITA
			 + PPAY_CASA_UP_IMP_USCITA + PPAY_CIBO_SPESA_POSESTERNO_IMP_USCITA + PPAY_GIOCO_POSESTERNO_IMP_USCITA
			 + PPAY_ISTRUZIONE_POSESTERNO_IMP_USCITA + PPAY_MOTORI_TRASPORTI_POSESTERNO_IMP_USCITA + PPAY_SALUTE_CURA_POSESTERNO_IMP_USCITA
			 + PPAY_SHOPPING_SERVIZI_POSESTERNO_IMP_USCITA + PPAY_TEMPOLIBERO_VIAGGIO_POSESTERNO_IMP_USCITA
			 + PPAY_PAG_VARIE_MCC_POSESTERNO_IMP_USCITA + PPAY_PAG_ALTREMCC_ATMPOSTE_IMP_USCITA + PPAY_PAG_ALTREMCC_POSESTERNO_IMP_USCITA
			 + PPAY_PAG_ALTREMCC_ALTRO_IMP_USCITA + PPAY_PRELIEVO_ATMPOSTE_IMP_USCITA + PPAY_PRELIEVO_ATMBANCARIO_IMP_USCITA
			 + PPAY_PRELIEVO_POSESTERNO_IMP_USCITA + PPAY_PRELIEVO_UP_IMP_USCITA + PPAY_RICARICA_POSTEPAY_ATMPOSTE_IMP_USCITA
			 + PPAY_RICARICA_TELEFONICA_ATMPOSTE_IMP_USCITA + PPAY_RICARICA_TELEFONICA_POSESTERNO_IMP_USCITA) as PPAY_TOT_OPER_FISICO_IMP_USCITA
		
		, (PPAY_BANCA_FIN_IMPOSTE_POSESTERNO_NUM_USCITA + PPAY_BAR_RISTORANTI_POSESTERNO_NUM_USCITA + PPAY_CASA_POSESTERNO_NUM_USCITA
			 + PPAY_CASA_UP_NUM_USCITA + PPAY_CIBO_SPESA_POSESTERNO_NUM_USCITA + PPAY_GIOCO_POSESTERNO_NUM_USCITA
			 + PPAY_ISTRUZIONE_POSESTERNO_NUM_USCITA + PPAY_MOTORI_TRASPORTI_POSESTERNO_NUM_USCITA + PPAY_SALUTE_CURA_POSESTERNO_NUM_USCITA
			 + PPAY_SHOPPING_SERVIZI_POSESTERNO_NUM_USCITA + PPAY_TEMPOLIBERO_VIAGGIO_POSESTERNO_NUM_USCITA + 
			 + PPAY_PAG_VARIE_MCC_POSESTERNO_NUM_USCITA + PPAY_PAG_ALTREMCC_ATMPOSTE_NUM_USCITA + PPAY_PAG_ALTREMCC_POSESTERNO_NUM_USCITA
			 + PPAY_PAG_ALTREMCC_ALTRO_NUM_USCITA + PPAY_PRELIEVO_ATMPOSTE_NUM_USCITA + PPAY_PRELIEVO_ATMBANCARIO_NUM_USCITA
			 + PPAY_PRELIEVO_POSESTERNO_NUM_USCITA + PPAY_PRELIEVO_UP_NUM_USCITA + PPAY_RICARICA_POSTEPAY_ATMPOSTE_NUM_USCITA
			 + PPAY_RICARICA_TELEFONICA_ATMPOSTE_NUM_USCITA + PPAY_RICARICA_TELEFONICA_POSESTERNO_NUM_USCITA) as PPAY_TOT_OPER_FISICO_NUM_USCITA
		
		, (PPAY_COMMISSIONI_CENTRO_IMP_ENTRATA + PPAY_PAGAMENTI_CENTRO_IMP_ENTRATA + PPAY_STORNO_CENTRO_IMP_ENTRATA + PPAY_VARIE_CENTRO_IMP_ENTRATA 
			+ PPAY_RICARICA_POSTEPAY_CENTRO_IMP_ENTRATA) as PPAY_TOT_OPER_CENTRO_IMP_ENTRATA
		
		, (PPAY_COMMISSIONI_CENTRO_NUM_ENTRATA + PPAY_PAGAMENTI_CENTRO_NUM_ENTRATA + PPAY_STORNO_CENTRO_NUM_ENTRATA + PPAY_VARIE_CENTRO_NUM_ENTRATA
			+ PPAY_RICARICA_POSTEPAY_CENTRO_NUM_ENTRATA) as PPAY_TOT_OPER_CENTRO_NUM_ENTRATA
		
		, (PPAY_COMMISSIONI_CENTRO_IMP_USCITA + PPAY_STORNO_CENTRO_IMP_USCITA) as PPAY_TOT_OPER_CENTRO_IMP_USCITA
		
		, (PPAY_COMMISSIONI_CENTRO_NUM_USCITA + PPAY_STORNO_CENTRO_NUM_USCITA) as PPAY_TOT_OPER_CENTRO_NUM_USCITA
		
		, (PPAY_RICARICA_POSTEPAY_APP_IMP_ENTRATA + PPAY_RICARICA_POSTEPAY_WEBPOSTE_IMP_ENTRATA) as PPAY_TOT_OPER_DIGITAL_IMP_ENTRATA
				
		, (PPAY_RICARICA_POSTEPAY_APP_NUM_ENTRATA + PPAY_RICARICA_POSTEPAY_WEBPOSTE_NUM_ENTRATA) as PPAY_TOT_OPER_DIGITAL_NUM_ENTRATA
		
		, (PPAY_BANCA_FIN_IMPOSTE_APP_IMP_USCITA + PPAY_BANCA_FIN_IMPOSTE_WEBESTERNO_IMP_USCITA + PPAY_BANCA_FIN_IMPOSTE_WEBPOSTE_IMP_USCITA
			 + PPAY_BAR_RISTORANTI_WEBESTERNO_IMP_USCITA + PPAY_CASA_APP_IMP_USCITA + PPAY_CASA_WEBESTERNO_IMP_USCITA
			 + PPAY_CIBO_SPESA_APP_IMP_USCITA + PPAY_CIBO_SPESA_WEBESTERNO_IMP_USCITA + PPAY_GIOCO_WEBESTERNO_IMP_USCITA
			 + PPAY_ISTRUZIONE_WEBESTERNO_IMP_USCITA + PPAY_MOTORI_TRASPORTI_APP_IMP_USCITA + PPAY_MOTORI_TRASPORTI_WEBESTERNO_IMP_USCITA
			 + PPAY_SALUTE_CURA_WEBESTERNO_IMP_USCITA + PPAY_SHOPPING_SERVIZI_APP_IMP_USCITA + PPAY_SHOPPING_SERVIZI_WEBESTERNO_IMP_USCITA
			 + PPAY_TEMPOLIBERO_VIAGGIO_WEBESTERNO_IMP_USCITA + PPAY_PAG_VARIE_MCC_WEBESTERNO_IMP_USCITA + PPAY_PAG_VARIE_MCC_WEBPOSTE_IMP_USCITA
			 + PPAY_PAG_ALTREMCC_APP_IMP_USCITA + PPAY_PAG_ALTREMCC_WEBESTERNO_IMP_USCITA + PPAY_PAG_ALTREMCC_WEBPOSTE_IMP_USCITA
			 + PPAY_RICARICA_POSTEPAY_APP_IMP_USCITA + PPAY_RICARICA_POSTEPAY_WEBPOSTE_IMP_USCITA + PPAY_RICARICA_TELEFONICA_WEBPOSTE_IMP_USCITA
			 ) as PPAY_TOT_OPER_DIGITAL_IMP_USCITA
		
		, (PPAY_BANCA_FIN_IMPOSTE_APP_NUM_USCITA + PPAY_BANCA_FIN_IMPOSTE_WEBESTERNO_NUM_USCITA + PPAY_BANCA_FIN_IMPOSTE_WEBPOSTE_NUM_USCITA
			 + PPAY_BAR_RISTORANTI_WEBESTERNO_NUM_USCITA + PPAY_CASA_APP_NUM_USCITA + PPAY_CASA_WEBESTERNO_NUM_USCITA
			 + PPAY_CIBO_SPESA_APP_NUM_USCITA + PPAY_CIBO_SPESA_WEBESTERNO_NUM_USCITA + PPAY_GIOCO_WEBESTERNO_NUM_USCITA
			 + PPAY_ISTRUZIONE_WEBESTERNO_NUM_USCITA + PPAY_MOTORI_TRASPORTI_APP_NUM_USCITA + PPAY_MOTORI_TRASPORTI_WEBESTERNO_NUM_USCITA
			 + PPAY_SALUTE_CURA_WEBESTERNO_NUM_USCITA + PPAY_SHOPPING_SERVIZI_APP_NUM_USCITA + PPAY_SHOPPING_SERVIZI_WEBESTERNO_NUM_USCITA
			 + PPAY_TEMPOLIBERO_VIAGGIO_WEBESTERNO_NUM_USCITA + PPAY_PAG_VARIE_MCC_WEBESTERNO_NUM_USCITA + PPAY_PAG_VARIE_MCC_WEBPOSTE_NUM_USCITA
			 + PPAY_PAG_ALTREMCC_APP_NUM_USCITA + PPAY_PAG_ALTREMCC_WEBESTERNO_NUM_USCITA + PPAY_PAG_ALTREMCC_WEBPOSTE_NUM_USCITA
			 + PPAY_RICARICA_POSTEPAY_APP_NUM_USCITA + PPAY_RICARICA_POSTEPAY_WEBPOSTE_NUM_USCITA + PPAY_RICARICA_TELEFONICA_WEBPOSTE_NUM_USCITA
			 ) as PPAY_TOT_OPER_DIGITAL_NUM_USCITA
	from EBIL_AREE.V_CT_PERIMETRO as b
	left join MONETICA_MCC_RAGGR as a
		on a.ID_CLIENTE_BIC=b.ID_CLIENTE_BIC and a.TIPO_CARTA='CARTA_PREPAGATA' 
	group by 1,2
)with data primary index(ID_CLIENTE_BIC, ID_PERIODO_TEMPORALE) on commit preserve rows;
.IF ERRORCODE > 0 THEN .QUIT 16;


BT

;DELETE EBIL_AREE.CT_OPERAT_POSTEPAY_STANDARD
WHERE ID_PERIODO_TEMPORALE= (SELECT ID_PERIODO_TEMPORALE FROM EBIL_AREE.CT_PARAMETRI)

;INSERT INTO  EBIL_AREE.CT_OPERAT_POSTEPAY_STANDARD 
	select * from CT_OPERAT_POSTEPAY
WHERE ID_PERIODO_TEMPORALE= (SELECT ID_PERIODO_TEMPORALE FROM EBIL_AREE.CT_PARAMETRI)

;ET;
.IF ERRORCODE > 0 THEN .QUIT 16;

CREATE VOLATILE TABLE VTB_OPERAT_POSTEPAY_STANDARD_SV AS
(SELECT ID_PERIODO_TEMPORALE, ROW_NUMBER () over ( ORDER BY ID_PERIODO_TEMPORALE  DESC) AS ORDINAMENTO
FROM  EBIL_AREE.CT_OPERAT_POSTEPAY_STANDARD
GROUP BY 1)
WITH DATA PRIMARY INDEX (ID_PERIODO_TEMPORALE) ON COMMIT PRESERVE ROWS;
.IF ERRORCODE > 0 THEN .QUIT 16;

DELETE EBIL_AREE.CT_OPERAT_POSTEPAY_STANDARD
WHERE ID_PERIODO_TEMPORALE IN ( SELECT ID_PERIODO_TEMPORALE 
FROM VTB_OPERAT_POSTEPAY_STANDARD_SV
WHERE ORDINAMENTO >25);
.IF ERRORCODE > 0 THEN .QUIT 16;

create volatile table CT_OPERAT_EVOLUTION as (
	select
		b.ID_CLIENTE_BIC,
		b.ID_PERIODO_TEMPORALE
		
		, sum(case when a.DES_RICLAS='BONIFICO' then a.IMPORTO_AVERE else 0 end) as EVO_BONIFICO_CENTRO_IMP_ENTRATA
		, sum(case when a.DES_RICLAS='BONIFICO' then a.NUMERO_AVERE else 0 end) as EVO_BONIFICO_CENTRO_NUM_ENTRATA		
		, sum(case when a.DES_RICLAS='BONIFICO' and a.CANALE in ('APP') then a.IMPORTO_DARE else 0 end) as EVO_BONIFICO_APP_IMP_USCITA
		, sum(case when a.DES_RICLAS='BONIFICO' and a.CANALE in ('APP') then a.NUMERO_DARE else 0 end) as EVO_BONIFICO_APP_NUM_USCITA
		, sum(case when a.DES_RICLAS='BONIFICO' and a.CANALE in ('UP') then a.IMPORTO_DARE else 0 end) as EVO_BONIFICO_UP_IMP_USCITA
		, sum(case when a.DES_RICLAS='BONIFICO' and a.CANALE in ('UP') then a.NUMERO_DARE else 0 end) as EVO_BONIFICO_UP_NUM_USCITA
		, sum(case when a.DES_RICLAS='BONIFICO' and a.CANALE in ('WEB_POSTE') then a.IMPORTO_DARE else 0 end) as EVO_BONIFICO_WEBPOSTE_IMP_USCITA
		, sum(case when a.DES_RICLAS='BONIFICO' and a.CANALE in ('WEB_POSTE') then a.NUMERO_DARE else 0 end) as EVO_BONIFICO_WEBPOSTE_NUM_USCITA
		, sum(case when a.DES_RICLAS='BONIFICO' and a.CANALE in ('CENTRO') then a.IMPORTO_DARE else 0 end) as EVO_BONIFICO_CENTRO_IMP_USCITA
		, sum(case when a.DES_RICLAS='BONIFICO' and a.CANALE in ('CENTRO') then a.NUMERO_DARE else 0 end) as EVO_BONIFICO_CENTRO_NUM_USCITA
		
		, sum(case when a.DES_RICLAS='COMMISSIONI' then a.IMPORTO_DARE else 0 end) as EVO_COMMISSIONI_CENTRO_IMP_USCITA
		, sum(case when a.DES_RICLAS='COMMISSIONI' then a.NUMERO_DARE else 0 end) as EVO_COMMISSIONI_CENTRO_NUM_USCITA		
		, sum(case when a.DES_RICLAS='COMMISSIONI' then a.IMPORTO_AVERE else 0 end) as EVO_COMMISSIONI_CENTRO_IMP_ENTRATA
		, sum(case when a.DES_RICLAS='COMMISSIONI' then a.NUMERO_AVERE else 0 end) as EVO_COMMISSIONI_CENTRO_NUM_ENTRATA
		
		, sum(case when a.DES_RICLAS='BANCA_FINANZA_IMPOSTE' and a.CANALE in ('APP') then a.IMPORTO_DARE else 0 end) as EVO_BANCA_FIN_IMPOSTE_APP_IMP_USCITA
		, sum(case when a.DES_RICLAS='BANCA_FINANZA_IMPOSTE' and a.CANALE in ('APP') then a.NUMERO_DARE else 0 end) as EVO_BANCA_FIN_IMPOSTE_APP_NUM_USCITA
		, sum(case when a.DES_RICLAS='BANCA_FINANZA_IMPOSTE' and a.CANALE in ('POS_ESTERNO') then a.IMPORTO_DARE else 0 end) as EVO_BANCA_FIN_IMPOSTE_POSESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='BANCA_FINANZA_IMPOSTE' and a.CANALE in ('POS_ESTERNO') then a.NUMERO_DARE else 0 end) as EVO_BANCA_FIN_IMPOSTE_POSESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='BANCA_FINANZA_IMPOSTE' and a.CANALE in ('WEB_ESTERNO') then a.IMPORTO_DARE else 0 end) as EVO_BANCA_FIN_IMPOSTE_WEBESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='BANCA_FINANZA_IMPOSTE' and a.CANALE in ('WEB_ESTERNO') then a.NUMERO_DARE else 0 end) as EVO_BANCA_FIN_IMPOSTE_WEBESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='BANCA_FINANZA_IMPOSTE' and a.CANALE in ('WEB_POSTE') then a.IMPORTO_DARE else 0 end) as EVO_BANCA_FIN_IMPOSTE_WEBPOSTE_IMP_USCITA
		, sum(case when a.DES_RICLAS='BANCA_FINANZA_IMPOSTE' and a.CANALE in ('WEB_POSTE') then a.NUMERO_DARE else 0 end) as EVO_BANCA_FIN_IMPOSTE_WEBPOSTE_NUM_USCITA		
		, sum(case when a.DES_RICLAS='BAR_RISTORANTI' and a.CANALE in ('POS_ESTERNO') then a.IMPORTO_DARE else 0 end) as EVO_BAR_RISTORANTI_POSESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='BAR_RISTORANTI' and a.CANALE in ('POS_ESTERNO') then a.NUMERO_DARE else 0 end) as EVO_BAR_RISTORANTI_POSESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='BAR_RISTORANTI' and a.CANALE in ('WEB_ESTERNO') then a.IMPORTO_DARE else 0 end) as EVO_BAR_RISTORANTI_WEBESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='BAR_RISTORANTI' and a.CANALE in ('WEB_ESTERNO') then a.NUMERO_DARE else 0 end) as EVO_BAR_RISTORANTI_WEBESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='CASA' and a.CANALE in ('APP') then a.IMPORTO_DARE else 0 end) as EVO_CASA_APP_IMP_USCITA
		, sum(case when a.DES_RICLAS='CASA' and a.CANALE in ('APP') then a.NUMERO_DARE else 0 end) as EVO_CASA_APP_NUM_USCITA
		, sum(case when a.DES_RICLAS='CASA' and a.CANALE in ('POS_ESTERNO') then a.IMPORTO_DARE else 0 end) as EVO_CASA_POSESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='CASA' and a.CANALE in ('POS_ESTERNO') then a.NUMERO_DARE else 0 end) as EVO_CASA_POSESTERNO_NUM_USCITA		
		, sum(case when a.DES_RICLAS='CASA' and a.CANALE in ('UP') then a.IMPORTO_DARE else 0 end) as EVO_CASA_UP_IMP_USCITA
		, sum(case when a.DES_RICLAS='CASA' and a.CANALE in ('UP') then a.NUMERO_DARE else 0 end) as EVO_CASA_UP_NUM_USCITA	
		, sum(case when a.DES_RICLAS='CASA' and a.CANALE in ('WEB_ESTERNO') then a.IMPORTO_DARE else 0 end) as EVO_CASA_WEBESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='CASA' and a.CANALE in ('WEB_ESTERNO') then a.NUMERO_DARE else 0 end) as EVO_CASA_WEBESTERNO_NUM_USCITA
		, sum(case when a.DES_RICLAS='CIBO_SPESA' and a.CANALE in ('APP') then a.IMPORTO_DARE else 0 end) as EVO_CIBO_SPESA_APP_IMP_USCITA
		, sum(case when a.DES_RICLAS='CIBO_SPESA' and a.CANALE in ('APP') then a.NUMERO_DARE else 0 end) as EVO_CIBO_SPESA_APP_NUM_USCITA		
		, sum(case when a.DES_RICLAS='CIBO_SPESA' and a.CANALE in ('POS_ESTERNO') then a.IMPORTO_DARE else 0 end) as EVO_CIBO_SPESA_POSESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='CIBO_SPESA' and a.CANALE in ('POS_ESTERNO') then a.NUMERO_DARE else 0 end) as EVO_CIBO_SPESA_POSESTERNO_NUM_USCITA	
		, sum(case when a.DES_RICLAS='CIBO_SPESA' and a.CANALE in ('WEB_ESTERNO') then a.IMPORTO_DARE else 0 end) as EVO_CIBO_SPESA_WEBESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='CIBO_SPESA' and a.CANALE in ('WEB_ESTERNO') then a.NUMERO_DARE else 0 end) as EVO_CIBO_SPESA_WEBESTERNO_NUM_USCITA	
		, sum(case when a.DES_RICLAS='GIOCO' and a.CANALE in ('POS_ESTERNO') then a.IMPORTO_DARE else 0 end) as EVO_GIOCO_POSESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='GIOCO' and a.CANALE in ('POS_ESTERNO') then a.NUMERO_DARE else 0 end) as EVO_GIOCO_POSESTERNO_NUM_USCITA	
		, sum(case when a.DES_RICLAS='GIOCO' and a.CANALE in ('WEB_ESTERNO') then a.IMPORTO_DARE else 0 end) as EVO_GIOCO_WEBESTERNO_IMP_USCITA
		, sum(case when a.DES_RICLAS='GIOCO' and a.CANALE in ('WEB_ESTERNO') then a.NUMERO_DARE else 0 end) as EVO_GIOCO_WEBESTERNO_NUM_USCITA	
