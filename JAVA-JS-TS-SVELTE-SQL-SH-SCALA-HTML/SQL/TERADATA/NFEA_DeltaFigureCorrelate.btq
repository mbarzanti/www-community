.SET ERROROUT STDOUT
.SET WIDTH 4096;  
                                
.SET ERRORLEVEL 3803 SEVERITY 10; 
.SET ERRORLEVEL 3807 SEVERITY 10;


DEL  BIC_ODS_SA.NFEA_FIG_CORR_DELTA_LOAD ALL;

.IF ERRORLEVEL > 0 THEN .QUIT 16;



INSERT INTO BIC_ODS_SA.NFEA_FIG_CORR_DELTA_LOAD

SEL 	 COD_FISCALE                   
			,'C' AS TIPO_ELABORAZIONE		
			,ID_CLIENTE_BIC AS COD_CLIENTE_SORGENTE		
			,ID_CLIENTE_BIC 
			,ID_FIG_CORRELATA
			,ID_CLIENTE_BIC AS COD_CLIENTE_SORGENTE_FIG_CORR
			,DT_FINE_RELAZIONE      
			,DT_INIZIO_RELAZIONE       
			,COD_TIPOLOGIA_REL                
			,COD_SISTEMA_SORGENTE    
			,TS_ULT_MOD
				FROM (
							 SEL 	B.COD_FISCALE                   
										,B.ID_CLIENTE_BIC AS COD_CLIENTE_SORGENTE		
										,B.ID_CLIENTE_BIC 
										,ID_FIG_CORRELATA
										,DT_FINE_RELAZIONE      
										,DT_INIZIO_RELAZIONE       
										,COD_TIPOLOGIA_REL                
										,'AUC' AS COD_SISTEMA_SORGENTE    
										,TS_ULT_MOD
								FROM BIC_ODS_SA.NFEA_FIG_CORR_DELTA_LOAD_BK B
								
				MINUS
								SEL	COD_FISCALE                   
										,B.ID_CLIENTE_BIC AS COD_CLIENTE_SORGENTE		
										,B.ID_CLIENTE_BIC 
										,ID_FIG_CORRELATA
										,DT_FINE_RELAZIONE      
										,DT_INIZIO_RELAZIONE       
										,COD_TIPOLOGIA_REL                             
										,'AUC' AS COD_SISTEMA_SORGENTE    
										,B.TS_INIZIO_VALIDITA as TS_ULT_MOD
								FROM BIC_ODS_V.FIGURE_CORRELATE_BUSINESS B
								INNER JOIN   BIC_ODS_V.CLIENTE_RETAIL R
								ON R.ID_CLIENTE_BIC = B.ID_FIG_CORRELATA    
								WHERE CAST(B.TS_FINE_VALIDITA AS DATE) = '2999-12-31'
								AND CAST(R.DATA_FINE_VALIDITA AS DATE) = '2999-12-31'
								) A;
								
.IF ERRORLEVEL > 0 THEN .QUIT 16;								
								
								
INSERT INTO BIC_ODS_SA.NFEA_FIG_CORR_DELTA_LOAD

SEL 	 COD_FISCALE                   
			,'I' AS TIPO_ELABORAZIONE		
			,ID_CLIENTE_BIC AS COD_CLIENTE_SORGENTE		
			,ID_CLIENTE_BIC 
			,ID_FIG_CORRELATA
			,ID_CLIENTE_BIC AS COD_CLIENTE_SORGENTE_FIG_CORR
			,DT_FINE_RELAZIONE      
			,DT_INIZIO_RELAZIONE       
			,COD_TIPOLOGIA_REL                
			,COD_SISTEMA_SORGENTE  
			,TS_ULT_MOD			
				FROM (
							 SEL 	 COD_FISCALE                   
										,B.ID_CLIENTE_BIC AS COD_CLIENTE_SORGENTE		
										,B.ID_CLIENTE_BIC 
										,ID_FIG_CORRELATA
										,DT_FINE_RELAZIONE      
										,DT_INIZIO_RELAZIONE       
										,COD_TIPOLOGIA_REL                
										,'AUC' AS COD_SISTEMA_SORGENTE 
										,B.TS_INIZIO_VALIDITA as TS_ULT_MOD
								FROM BIC_ODS_V.FIGURE_CORRELATE_BUSINESS B
								INNER JOIN   BIC_ODS_V.CLIENTE_RETAIL R
								ON R.ID_CLIENTE_BIC = B.ID_FIG_CORRELATA 
								WHERE CAST(B.TS_FINE_VALIDITA AS DATE) = '2999-12-31'
								AND CAST(R.DATA_FINE_VALIDITA AS DATE) = '2999-12-31'
								
				MINUS
								SEL	B.COD_FISCALE                   
									    ,B.ID_CLIENTE_BIC AS COD_CLIENTE_SORGENTE		
										,B.ID_CLIENTE_BIC 
										,ID_FIG_CORRELATA
										,DT_FINE_RELAZIONE      
										,DT_INIZIO_RELAZIONE       
										,COD_TIPOLOGIA_REL                
										,'AUC' AS COD_SISTEMA_SORGENTE 
										,TS_ULT_MOD
								FROM  BIC_ODS_SA.NFEA_FIG_CORR_DELTA_LOAD_BK B
								
								) A;
.IF ERRORLEVEL > 0 THEN .QUIT 16;


DEL BK
FROM 
BIC_ODS_SA.NFEA_FIG_CORR_DELTA_LOAD_BK BK,
BIC_ODS_SA.NFEA_FIG_CORR_DELTA_LOAD L
WHERE L.ID_CLIENTE_BIC = BK.ID_CLIENTE_BIC
AND L.ID_FIG_CORRELATA=BK.ID_FIG_CORRELATA
AND L.COD_TIPOLOGIA_REL=BK.COD_TIPOLOGIA_REL
AND L.TIPO_ELABORAZIONE	 = 'C' ;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

INSERT INTO 
BIC_ODS_SA.NFEA_FIG_CORR_DELTA_LOAD_BK
SEL * FROM 
BIC_ODS_SA.NFEA_FIG_CORR_DELTA_LOAD L
WHERE  L.TIPO_ELABORAZIONE	 = 'I' ;

.IF ERRORLEVEL > 0 THEN .QUIT 16;

.LOGOFF; 
.QUIT;
