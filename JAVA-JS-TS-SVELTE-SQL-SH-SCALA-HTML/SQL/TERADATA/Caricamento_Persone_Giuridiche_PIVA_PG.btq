.SET ERROROUT STDOUT
.SET WIDTH 240;



/* PULIZIA DEI CLIENTI ENTRATI ERRONEAMENTE CAUSA INITIAL LOAD */
CREATE VOLATILE TABLE SOGEI_PG_ST_DOPPI AS(
SEL * FROM CACHESOGEI.SOGEI_PERSONE_GIURIDICHE_ST 
WHERE 
TS_FIN_VAL='2999-12-31 23:59:59' AND 
FL_CERTIFICAZIONE ='V' AND
(CD_FISCALE, PARTITA_IVA) IN
(
 SEL
  CD_FISCALE,
  PARTITA_IVA
  FROM CACHESOGEI.SOGEI_PERSONE_GIURIDICHE_ST
  WHERE TS_FIN_VAL='2999-12-31 23:59:59'
  AND FL_CERTIFICAZIONE ='V'
  GROUP BY 1,2
  HAVING COUNT(*)>1
 )
)
WITH DATA
PRIMARY INDEX(CD_FISCALE,PARTITA_IVA)
ON COMMIT PRESERVE ROWS;



DEL FROM CACHESOGEI.SOGEI_PERSONE_GIURIDICHE_ST
WHERE 
TS_FIN_VAL='2999-12-31 23:59:59' AND 
FL_CERTIFICAZIONE ='V' AND
(CD_FISCALE, PARTITA_IVA) IN
(
 SEL
  CD_FISCALE,
  PARTITA_IVA
  FROM SOGEI_PG_ST_DOPPI
  GROUP BY 1,2
  HAVING COUNT(*)>1
);


INSERT INTO CACHESOGEI.SOGEI_PERSONE_GIURIDICHE_ST  
SEL * FROM SOGEI_PG_ST_DOPPI
WHERE 
TS_FIN_VAL='2999-12-31 23:59:59' AND 
FL_CERTIFICAZIONE ='V' 
QUALIFY ROW_NUMBER() OVER (PARTITION BY CD_FISCALE,PARTITA_IVA,FL_CERTIFICAZIONE ORDER BY TS_INI_VAL)=1;


DROP TABLE SOGEI_PG_ST_DOPPI;




INSERT INTO CACHESOGEI.APPO_SOGEI_PIVA_PG_STATO_A 
SELECT * FROM CACHESOGEI.APPO_SOGEI_PERSONE_GIURIDICHE
WHERE
STATO_PARTITA_IVA='A';


DEL FROM CACHESOGEI.APPO_SOGEI_PERSONE_GIURIDICHE
WHERE
STATO_PARTITA_IVA='A';



/* ELABORO SOLO I RECORD CHE HANNO STATO PARTITA IVA=C */
CREATE VOLATILE TABLE APPO_SPG AS(
SELECT 
ASPG.CF_INPUT, 
ASPG.PIVA_INPUT, 
ASPG.CF_OUTPUT, 
ASPG.PIVA_OUTPUT, 
ASPG.TIPO_SOGGETTO,
ASPG.DENOMINAZIONE, 
ASPG.SIGLA, 
ASPG.NATURA_GIURIDICA, 
ASPG.FL_ESTINZIONE_CD_FISCALE,
ASPG.DT_ESTINZIONE_CD_FISCALE, 
ASPG.STATO_PARTITA_IVA, 
ASPG.DT_INI_ATTIVITA, 
ASPG.DT_FIN_ATTIVITA,
ASPG.CD_ESITO, 
ASPG.NOME_FILE,
PG_ST.CD_FISCALE
FROM CACHESOGEI.APPO_SOGEI_PERSONE_GIURIDICHE AS ASPG
INNER JOIN CACHESOGEI.SOGEI_PERSONE_GIURIDICHE_ST PG_ST
ON 
ASPG.PIVA_OUTPUT = PG_ST.PARTITA_IVA
WHERE
ASPG.PIVA_OUTPUT<>'' AND
PG_ST.PARTITA_IVA<>'' AND
ASPG.STATO_PARTITA_IVA='C' AND
PG_ST.TS_FIN_VAL='2999-12-31 23:59:59' AND
PG_ST.FL_CERTIFICAZIONE='V'
AND ASPG.CD_ESITO=0
)
WITH DATA
PRIMARY INDEX (CD_FISCALE)
ON COMMIT PRESERVE ROWS;




CREATE VOLATILE TABLE APPO_SPG_RES AS (
SELECT 
ASPG.CF_INPUT,
ASPG.PIVA_INPUT,
ASPG.CF_OUTPUT,
ASPG.PIVA_OUTPUT,
ASPG.TIPO_SOGGETTO,
ASPG.DENOMINAZIONE,
ASPG.SIGLA,
ASPG.NATURA_GIURIDICA,
ASPG.FL_ESTINZIONE_CD_FISCALE,
ASPG.DT_ESTINZIONE_CD_FISCALE,
ASPG.STATO_PARTITA_IVA,
ASPG.DT_INI_ATTIVITA,
ASPG.DT_FIN_ATTIVITA,
ASPG.CD_ESITO,
ASPG.NOME_FILE,
ASPG.CD_FISCALE,
PG_ST.TS_INI_VAL  - INTERVAL '1' SECOND AS TS_INI_VAL_NEW
FROM APPO_SPG AS ASPG
INNER JOIN CACHESOGEI.SOGEI_PERSONE_GIURIDICHE_ST PG_ST
ON 
ASPG.CD_FISCALE = PG_ST.PARTITA_IVA
WHERE
ASPG.CD_FISCALE<>'' AND
PG_ST.PARTITA_IVA<>'' AND
ASPG.STATO_PARTITA_IVA='C' AND
PG_ST.TS_FIN_VAL='2999-12-31 23:59:59' AND
PG_ST.FL_CERTIFICAZIONE='V'
)
WITH DATA
PRIMARY INDEX(CD_FISCALE)
ON COMMIT PRESERVE ROWS;


--INSERIMENTO AUC PG_VAR COPPIA VARIATA CERTIFICATA 
INSERT INTO AUC.SOGEI_CERTIFICAZIONE_PG_VAR
(ID_CLIENTE, CD_FISCALE, PARTITA_IVA,CD_FISCALE_NEW,PARTITA_IVA_NEW,TIPO_SOGGETTO, DENOMINAZIONE,
SIGLA, NATURA_GIURIDICA, FL_ESTINZIONE_CD_FISCALE, DT_ESTINZIONE_CD_FISCALE,
STATO_PARTITA_IVA, DT_INI_ATTIVITA, DT_FIN_ATTIVITA,FL_CONTROLLO,TS_CARICAMENTO)
SELECT
ID_CLIENTE,
B.CF_INPUT,
B.PIVA_INPUT,
B.CF_OUTPUT,
B.PIVA_OUTPUT,
B.TIPO_SOGGETTO,
B.DENOMINAZIONE,
B.SIGLA,
B.NATURA_GIURIDICA, 
B.FL_ESTINZIONE_CD_FISCALE, 
B.DT_ESTINZIONE_CD_FISCALE,
B.STATO_PARTITA_IVA, 
B.DT_INI_ATTIVITA, 
B.DT_FIN_ATTIVITA,
 'V' AS FL_CONTROLLO,
CURRENT_TIMESTAMP(0) AS TS_CARICAMENTO
FROM CACHESOGEI.SOGEI_PERSONE_GIURIDICHE_ST A
INNER JOIN  APPO_SPG_RES B
 ON 
 B.CD_FISCALE = A.CD_FISCALE AND
 B.PIVA_OUTPUT = A.PARTITA_IVA AND 
 A.TS_FIN_VAL = '2999-12-31 23:59:59' AND
 A.FL_CERTIFICAZIONE = 'V'AND
 COALESCE(A.STATO_PARTITA_IVA,'ND') <> COALESCE(B.STATO_PARTITA_IVA,'ND') AND
 COALESCE(CAST(A.DT_INI_ATTIVITA AS VARCHAR(10)),'ND') <> COALESCE(CAST(B.DT_INI_ATTIVITA AS VARCHAR(10)),'ND') AND
 COALESCE(CAST(A.DT_FIN_ATTIVITA AS VARCHAR(10)),'ND') <> COALESCE(CAST(B.DT_FIN_ATTIVITA AS VARCHAR(10)),'ND') ;
 
 
 
UPDATE SOG_PG_ST FROM CACHESOGEI.SOGEI_PERSONE_GIURIDICHE_ST SOG_PG_ST,
 (SELECT 
   CF_INPUT, 
   PIVA_INPUT, 
   CF_OUTPUT, 
   PIVA_OUTPUT, 
   TIPO_SOGGETTO,
   DENOMINAZIONE, 
   SIGLA, 
   NATURA_GIURIDICA, 
   FL_ESTINZIONE_CD_FISCALE,
   DT_ESTINZIONE_CD_FISCALE, 
   STATO_PARTITA_IVA, 
   DT_INI_ATTIVITA, 
   DT_FIN_ATTIVITA,
   CD_ESITO, 
   NOME_FILE,
   CD_FISCALE,
   TS_INI_VAL_NEW
  FROM APPO_SPG_RES
 ) APPO
SET
 TS_FIN_VAL= APPO.TS_INI_VAL_NEW,
 TIPO_SOGGETTO = APPO.TIPO_SOGGETTO,
 DENOMINAZIONE = APPO.DENOMINAZIONE, 
 PARTITA_IVA = APPO.PIVA_OUTPUT,
 -- SIGLA = APPO.SIGLA, 
 --NATURA_GIURIDICA = APPO.NATURA_GIURIDICA, 
 --FL_ESTINZIONE_CD_FISCALE = APPO.FL_ESTINZIONE_CD_FISCALE,
 --DT_ESTINZIONE_CD_FISCALE = APPO.DT_ESTINZIONE_CD_FISCALE, 
 STATO_PARTITA_IVA = APPO.STATO_PARTITA_IVA, 
 DT_INI_ATTIVITA = APPO.DT_INI_ATTIVITA,
 DT_FIN_ATTIVITA = APPO.DT_FIN_ATTIVITA
WHERE
 APPO.CD_FISCALE = SOG_PG_ST.CD_FISCALE AND
 APPO.PIVA_OUTPUT = SOG_PG_ST.PARTITA_IVA AND 
 SOG_PG_ST.TS_FIN_VAL = '2999-12-31 23:59:59' AND
 SOG_PG_ST.FL_CERTIFICAZIONE = 'V' AND
 COALESCE(SOG_PG_ST.STATO_PARTITA_IVA,'ND') <> COALESCE(APPO.STATO_PARTITA_IVA,'ND') AND
 COALESCE(CAST(SOG_PG_ST.DT_INI_ATTIVITA AS VARCHAR(10)),'ND') <> COALESCE(CAST(APPO.DT_INI_ATTIVITA AS VARCHAR(10)),'ND') AND
 COALESCE(CAST(SOG_PG_ST.DT_FIN_ATTIVITA AS VARCHAR(10)),'ND') <> COALESCE(CAST(APPO.DT_FIN_ATTIVITA AS VARCHAR(10)),'ND') ;



--RIBALTAMENTO IN CACHE ONLINE E CERTIFICAZIONE PG

DELETE FROM CacheSOGEI.SOGEI_PERSONE_GIURIDICHE;

INSERT INTO CacheSOGEI.SOGEI_PERSONE_GIURIDICHE
(ID_CLIENTE, CD_FISCALE, PARTITA_IVA, TIPO_SOGGETTO, DENOMINAZIONE,
    SIGLA, NATURA_GIURIDICA, FL_ESTINZIONE_CD_FISCALE, DT_ESTINZIONE_CD_FISCALE,
    STATO_PARTITA_IVA, DT_INI_ATTIVITA, DT_FIN_ATTIVITA, FL_CERTIFICAZIONE)
SELECT ID_CLIENTE, CD_FISCALE, PARTITA_IVA, TIPO_SOGGETTO, DENOMINAZIONE,
    SIGLA,NATURA_GIURIDICA, FL_ESTINZIONE_CD_FISCALE, DT_ESTINZIONE_CD_FISCALE,
    STATO_PARTITA_IVA, DT_INI_ATTIVITA, DT_FIN_ATTIVITA, FL_CERTIFICAZIONE AS FL_CERTIFICAZIONE 
FROM CacheSOGEI.V_SOGEI_PERSONE_GIURIDICHE_ST
WHERE TS_FIN_VAL='2999-12-31 23:59:59';



DELETE FROM CacheSOGEI.SOGEI_CERTIFICAZIONE_PG;


INSERT INTO CACHESOGEI.SOGEI_CERTIFICAZIONE_PG
(ID_CLIENTE, CD_FISCALE, PARTITA_IVA, TIPO_SOGGETTO, DENOMINAZIONE,
    SIGLA, NATURA_GIURIDICA, FL_ESTINZIONE_CD_FISCALE, DT_ESTINZIONE_CD_FISCALE,
    STATO_PARTITA_IVA, DT_INI_ATTIVITA, DT_FIN_ATTIVITA, FL_CERTIFICAZIONE)
SELECT ID_CLIENTE, CD_FISCALE, PARTITA_IVA, TIPO_SOGGETTO, DENOMINAZIONE,
    SIGLA,NATURA_GIURIDICA, FL_ESTINZIONE_CD_FISCALE, DT_ESTINZIONE_CD_FISCALE,
    STATO_PARTITA_IVA, DT_INI_ATTIVITA, DT_FIN_ATTIVITA, FL_CERTIFICAZIONE AS FL_CERTIFICAZIONE
FROM CacheSOGEI.SOGEI_PERSONE_GIURIDICHE
WHERE FL_CERTIFICAZIONE='V';


--CANCELLAZIONE APPO PG PER GIRO SUCCESSIVO

DELETE CacheSOGEI.APPO_SOGEI_PERSONE_GIURIDICHE;



.LOGOFF;

.QUIT;






















